language 0.9

// The music's own bars are the shell's (`ui/viz.plm`, the same component the bar and the player draw),
// fed from the scene's sixteen facts vb0…vb15.
import "ui/viz.plm" as viz

// mooi's lock screen (D160): the session's own lock, through Pleamar's `kind: lock`, which is
// ext-session-lock — the compositor keeps everything else off the screen and the keyboard until
// this scene gives the lock up. The password is checked by PAM in the logic (`sys.ask("auth.check")`),
// so nothing is painted over a running session by this program; the only thing that can show it is
// the lock itself.
//
// Lock with `mooi lock` (it starts this scene if it is not running), open it with the password. There
// is no way out but the password: Esc clears the field and does nothing else. A scene that dies with
// the lock held leaves the session locked, and `mooi unlock` is the way out of that, from a tty or
// another machine. The foot of the screen powers off or reboots the machine: one press arms it, a
// second does it.

scene MooiLock {
    permissions {
        services: "files", "auth", "clock", "clock.seconds", "env", "media", "media.*", "battery", "notification_history"
        run: "systemctl"
    }

    service clock.seconds as tick { time: text; date: text }

    // The scene needs a surface of its own; the lock surface below is the one that matters.
    surface { size: 1, 1; anchor: top_left; level: background }

    // ── The colours: the logic paints these from palette.json (lib/ferro), as every program of
    //    the shell does. These are Ferrolume's own, so a lock with no palette on disk still comes
    //    up in mooi's colours rather than a stranger's. ──
    fact lk_ground_r = 0.000000
    fact lk_ground_g = 0.000000
    fact lk_ground_b = 0.000000
    fact lk_hull_r = 0.015686
    fact lk_hull_g = 0.035294
    fact lk_hull_b = 0.031373
    fact lk_steel_900_r = 0.082353
    fact lk_steel_900_g = 0.098039
    fact lk_steel_900_b = 0.105882
    fact lk_trace_dim_r = 0.121569
    fact lk_trace_dim_g = 0.219608
    fact lk_trace_dim_b = 0.200000
    fact lk_trace_r = 0.239216
    fact lk_trace_g = 0.415686
    fact lk_trace_b = 0.376471
    fact lk_phos_r = 0.498039
    fact lk_phos_g = 0.811765
    fact lk_phos_b = 0.713725
    fact lk_ember_r = 0.878431
    fact lk_ember_g = 0.482353
    fact lk_ember_b = 0.180392
    fact lk_muted_r = 0.352941
    fact lk_muted_g = 0.541176
    fact lk_muted_b = 0.494118
    fact lk_ink_r = 0.015686
    fact lk_ink_g = 0.129412
    fact lk_ink_b = 0.113725

    let lk_ground = rgb(lk_ground_r, lk_ground_g, lk_ground_b)
    let lk_hull = rgb(lk_hull_r, lk_hull_g, lk_hull_b)
    let lk_steel_900 = rgb(lk_steel_900_r, lk_steel_900_g, lk_steel_900_b)
    let lk_trace_dim = rgb(lk_trace_dim_r, lk_trace_dim_g, lk_trace_dim_b)
    let lk_trace = rgb(lk_trace_r, lk_trace_g, lk_trace_b)
    let lk_phos = rgb(lk_phos_r, lk_phos_g, lk_phos_b)
    let lk_ember = rgb(lk_ember_r, lk_ember_g, lk_ember_b)
    let lk_muted = rgb(lk_muted_r, lk_muted_g, lk_muted_b)
    let lk_ink = rgb(lk_ink_r, lk_ink_g, lk_ink_b)

    // ── What the logic says ──────────────────────────────────────────────────
    fact locked = false          // `mooi lock`: the feature is on
    fact wrong = false           // the last password was not it
    fact right = false           // it was: on the way out
    fact authing = false         // PAM is thinking (a wrong one takes seconds on purpose)
    fact armed = 0               // a power button pressed once: 1 power off, 2 reboot
    fact has_wall = false
    fact has_pic = false          // there is a profile picture to draw
    fact has_ban = false          // there is a banner strip to draw
    fact lk_pic_on = true         // Settings → Lock: wear them at all (the logic's own lock.picture)
    text password = ""
    text status = ""            // VERIFYING… · INCORRECT · UNLOCKED; empty is the quiet state
    text tries = ""              // how many attempts PAM has left before it locks the login
    text who = ""                // whose screen this is: the name the session runs as
    text picpath = ""            // the profile picture `mooi lock` copied beside this scene…
    text banpath = ""            // …and its banner, each named by its whole path
    text pwr_label = "POWER OFF"
    text rbt_label = "REBOOT"
    text pwr_note = ""
    text wp = ""                 // the wallpaper, for the backdrop
    // ── What the glass says about the session (D160) ──
    fact lk_playing = false       // it is playing (the transport shows ▶ or ⏸ by it)
    fact lk_track_on = false      // a player has something on it, playing or not
    text lk_track = ""            // "Artist · Title", as the media service has it
    fact lk_batt = false
    fact lk_batt_pct = 0
    fact lk_charging = false
    fact lk_notes = 0             // notices waiting (notification_history)
    // The backdrop's own two settings (Settings → Lock): blur in pleamar's units, dim as a share.
    fact lk_blur = 54
    fact lk_dim = 0.72
    // The visualiser's bands (lib/vizfeed's line, thinned to sixteen by the logic): 0…1, left to right.
    fact vb0 = 0
    fact vb1 = 0
    fact vb2 = 0
    fact vb3 = 0
    fact vb4 = 0
    fact vb5 = 0
    fact vb6 = 0
    fact vb7 = 0
    fact vb8 = 0
    fact vb9 = 0
    fact vb10 = 0
    fact vb11 = 0
    fact vb12 = 0
    fact vb13 = 0
    fact vb14 = 0
    fact vb15 = 0
    event tryauth ->             // to the logic: check what is typed
    event clear ->               // to the logic: forget what was typed
    event pwr_off ->             // to the logic: the power off button
    event rbt ->                 // to the logic: the reboot button
    event lk_prev ->             // to the logic: the transport's back, play/pause and next
    event lk_toggle ->
    event lk_next ->

    // ── Springs of the small things ──────────────────────────────────────────
    spring wobble = 520, 11
    prop shake = 0 ~wobble
    prop appear = 0 ~200ms
    follow appear = lock.held

    on change wrong while wrong { impulse shake 520 }
    // The field has the keys as soon as the compositor confirms the lock: `locked` alone is set
    // before the lock surface exists, and a focus taken then is taken by nothing.
    on change locked while locked { focus password }
    on change lock.held while lock.held { focus password }
    // Escape empties the field and nothing more: there is no way out of a lock but the password.
    on key Escape { emit clear }
    on submit password { emit tryauth }
    // Enter with nothing focused still asks: the lock surface holds the keys, and a lock whose
    // password can only be sent by one path is a lock that can refuse the one that matters.
    on key Return { emit tryauth }

    image wall = from wp, 1920, 1080
    image lockpic = from picpath, 1920, 1200
    image lockban = from banpath, 1920, 1080

    surface lk {
        kind: lock
        size: full, full
        open: locked
        keyboard: exclusive

        // A lock surface's box is centred on each monitor, and everything in it is placed from that
        // centre — not from a corner. The area around the box is painted too (`lk.width` and
        // `lk.height` are the largest box across monitors), so the backdrop is the thing that has to
        // reach the monitor's edges, and the rail and the clock sit where the centre puts them.
        let w = lk.width
        let h = lk.height
        let ox = floor(-w / 2 + 0.5)
        let oy = floor(-h / 2 + 0.5)

        // The backdrop: mooi's black, the wallpaper blurred under it when there is one. It is
        // painted from the top left of the box, so it covers a monitor of any shape, and the
        // largest box across monitors is what `lk.width` and `lk.height` measure.
        box { from: ox, oy; size: w, h; color: lk_ground }
        group {
            show: has_wall
            opacity: 42%
            blur: lk_blur
            image wall { at: ox - 80, oy - 80; size: w + 160, h + 160 }
        }
        box { from: ox, oy; size: w, h; color: lk_ground; opacity: lk_dim }

        // ── The pictures (D161): the Nexus's banner across the top and its profile picture above
        //    the clock — both, when both are set, because they are two things: the strip is the
        //    place, the plate is the person. `mooi lock` copies each beside this scene and names it
        //    by its whole path; an image fact draws a path as it stands, never a bare name.
        //
        //    The strip is a band, not a slice: `fit: cover` takes its height out of the picture, so a
        //    208 px band off a 16:9 banner is the photo's own middle at full width, never stretched.
        //    (The avatar is 1920×1200 in the Nexus's folder and the banner 1920×1080; each is declared
        //    at what it is, so cover crops rather than squeezes.)
        let ban_h = 208
        group {
            show: has_ban and lk_pic_on
            image lockban { at: ox, oy; size: w, ban_h; fit: cover; opacity: 94% }
            // a scrim over it, so the rail and the clock's ceiling stay readable over any picture
            box { from: ox, oy; size: w, ban_h; color: lk_ground; opacity: 46% }
            // and a fade into the backdrop at its foot, so the band ends in the dark, not on a line
            repeat f in 0..6 {
                box { from: ox, oy + ban_h - 56 + f * 8; size: w, 8; color: lk_ground; opacity: 0.06 + f * 0.11 }
            }
            box { from: ox, oy + ban_h; size: w, 1; color: lk_trace_dim; opacity: 45% }
        }
        group {
            show: has_pic and lk_pic_on
            box { at: 0, -222; size: 72, 72; corner: 3; color: lk_trace_dim; opacity: 50% }
            box { at: 0, -222; size: 70, 70; corner: 3; color: lk_steel_900; opacity: 88% }
            image lockpic { at: -33, -255; size: 66, 66; fit: cover }
        }

        // The rail: mooi's drawn line, its name, and who is holding the screen.
        box { from: ox, oy; size: w, 1; color: lk_trace_dim; opacity: 40% }
        text "MOOI" { at: ox + 28, oy + 24; anchor: left center; size: 10; weight: 700; family: "Share Tech Mono"; color: lk_muted; outline: 2, lk_ground }
        text "SECURE" {
            at: ox + w - 28, oy + 24; anchor: right center; size: 10; weight: 700; family: "Share Tech Mono"
            color: lk_trace_dim; outline: 2, lk_ground
        }
        // the battery, and what waits for you: the two things worth knowing before you type it in
        text "{round(lk_batt_pct), 0}%" {
            at: ox + w - 96, oy + 24; anchor: right center; size: 10; weight: 700; family: "Share Tech Mono"
            color: mix(lk_muted, lk_ember, if(lk_batt_pct < 15 and not lk_charging, 1, 0)); outline: 2, lk_ground
            show: lk_batt and not lk_charging
        }
        text "{round(lk_batt_pct), 0}% · CHARGING" {
            at: ox + w - 96, oy + 24; anchor: right center; size: 10; weight: 700; family: "Share Tech Mono"
            color: lk_muted; outline: 2, lk_ground
            show: lk_batt and lk_charging
        }
        text "{lk_notes, 0} WAITING" {
            at: ox + w - 208, oy + 24; anchor: right center; size: 10; weight: 700; family: "Share Tech Mono"
            color: lk_ember; outline: 2, lk_ground
            show: lk_notes > 0
        }

        // The clock: the shell's instrument, not a poster.
        group {
            glow: 22, 45%, lk_phos
            opacity: appear
            text tick.time { at: 0, -136; anchor: center; size: 96; weight: 700; family: "Share Tech Mono"; color: lk_phos }
            text tick.date { at: 0, -70; anchor: center; size: 12; weight: 700; family: "Share Tech Mono"; color: lk_muted }
            // what was playing when the screen went dark: one line, quietly, above the name
            text lk_track {
                at: 0, -44; anchor: center; size: 11; family: "Share Tech Mono"
                color: lk_trace; width: 660; lines: 1; align: center
                show: lk_track_on
            }
            // the music's bands, under the track: what is playing, moving, rather than a word for it
            group {
                show: lk_track_on
                opacity: appear * 0.9
                viz.Spectrum(-160, -32, 320, 26, lk_trace_dim, lk_phos, not lk_playing)
            }
        }

        // Whose screen this is, above the plate: the name the session runs as, so the password
        // being asked for has an owner.
        text who {
            at: 0, 16; anchor: center; size: 11; weight: 700; family: "Share Tech Mono"
            color: lk_muted
        }

        // The password: a plate cut like the shell's, and the field itself, never the password.
        group {
            move: shake, 0
            opacity: appear
            // a one-pixel frame, drawn as a box a size larger: a box takes one colour, and mooi's
            // plates are a dark fill inside a faint trace, not a filled border
            box { at: 0, 56; size: 380, 48; corner: 2; color: lk_trace_dim; opacity: 45% }
            box { at: 0, 56; size: 378, 46; corner: 2; color: lk_steel_900; opacity: 88% }
            input password {
                at: -172, 47; width: 344; size: 14; weight: 700
                family: "Share Tech Mono"; color: lk_phos; selection: lk_hull
                placeholder: "PASSWORD"; secret: true
            }
        }

        // What it is doing, under the plate.
        text status {
            at: 0, 96; anchor: center; size: 11; weight: 700; family: "Share Tech Mono"
            color: mix(mix(lk_muted, lk_ember, wrong), lk_phos, right)
        }
        text "TRY AGAIN" {
            at: 0, 116; anchor: center; size: 10; family: "Share Tech Mono"
            color: lk_ember; opacity: 70%; show: wrong
        }
        // How many attempts are left before PAM locks the login: the system's count, said plainly,
        // because a lock that refuses a good password without a word looks broken (it did).
        text tries {
            at: 0, 134; anchor: center; size: 9; family: "Share Tech Mono"
            color: lk_ember; opacity: 55%
        }

        // ── The transport: the song changes hands without the password ───────
        // Three keys on the glass for whatever is playing (`media.*`): a locked door does not have to
        // stop the music. They are drawn only while a player has something on it, and only while the
        // compositor holds the lock, like the power buttons below.
        group {
            show: lk_track_on and lock.held
            opacity: appear
            box { at: -60, 190; size: 40, 30; corner: 2; color: lk_trace_dim; opacity: 35% }
            box { at: -60, 190; size: 38, 28; corner: 2; color: lk_steel_900; opacity: 85% }
            text "◀◀" { at: -60, 190; anchor: center; size: 10; weight: 700; family: "Share Tech Mono"; color: lk_muted; outline: 2, lk_ground }
            box { at: 0, 190; size: 40, 30; corner: 2; color: lk_trace_dim; opacity: 45% }
            box { at: 0, 190; size: 38, 28; corner: 2; color: lk_steel_900; opacity: 85% }
            text pick(lk_playing, "⏸", "▶") { at: 0, 190; anchor: center; size: 13; weight: 700; family: "Share Tech Mono"; color: lk_phos; outline: 2, lk_ground }
            box { at: 60, 190; size: 40, 30; corner: 2; color: lk_trace_dim; opacity: 35% }
            box { at: 60, 190; size: 38, 28; corner: 2; color: lk_steel_900; opacity: 85% }
            text "▶▶" { at: 60, 190; anchor: center; size: 10; weight: 700; family: "Share Tech Mono"; color: lk_muted; outline: 2, lk_ground }
            zone box tp_prev { from: -80, 175; size: 40, 30; cursor: pointer; role: button; label: "PREVIOUS TRACK"; show: lock.held }
            on press tp_prev { emit lk_prev }
            zone box tp_play { from: -20, 175; size: 40, 30; cursor: pointer; role: button; label: "PLAY OR PAUSE"; show: lock.held }
            on press tp_play { emit lk_toggle }
            zone box tp_next { from: 40, 175; size: 40, 30; cursor: pointer; role: button; label: "NEXT TRACK"; show: lock.held }
            on press tp_next { emit lk_next }
        }

        // ── Power, at the foot: one press arms, the second does it ───────────
        // A slipped click on the last row of pixels should not end the session, and nothing here
        // can be undone. The buttons exist only while the compositor is holding the lock, so a
        // press before it does nothing.
        let by = floor(h / 2) - 46
        group {
            opacity: appear
            box { at: -76, by; size: 122, 34; corner: 2; color: lk_trace_dim; opacity: 40% }
            box { at: -76, by; size: 120, 32; corner: 2; color: lk_steel_900; opacity: 88% }
            text pwr_label {
                at: -76, by; anchor: center; size: 10; weight: 700; family: "Share Tech Mono"
                color: mix(lk_muted, lk_ember, armed == 1)
            }
            box { at: 76, by; size: 122, 34; corner: 2; color: lk_trace_dim; opacity: 40% }
            box { at: 76, by; size: 120, 32; corner: 2; color: lk_steel_900; opacity: 88% }
            text rbt_label {
                at: 76, by; anchor: center; size: 10; weight: 700; family: "Share Tech Mono"
                color: mix(lk_muted, lk_ember, armed == 2)
            }
            text pwr_note {
                at: 0, by - 34; anchor: center; size: 10; weight: 700; family: "Share Tech Mono"
                color: lk_ember
            }
            zone box pwr { from: -136, by - 16; size: 120, 32; cursor: pointer; role: button; label: "POWER OFF: press twice"; show: lock.held }
            on press pwr { emit pwr_off }
            zone box rbt { from: 16, by - 16; size: 120, 32; cursor: pointer; role: button; label: "REBOOT: press twice"; show: lock.held }
            on press rbt { emit rbt }
        }
        text "LOCKING" {
            at: 0, 0; anchor: center; size: 12; weight: 700; family: "Share Tech Mono"
            color: lk_trace_dim; opacity: 1 - appear
        }
    }
}
