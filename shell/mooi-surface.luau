-- The Sigil's logic (D207, docs/superpowers/specs/2026-11-07-sigil-design.md). mooi starts it while the
-- Sigil has a host (shell/mooi.luau, surface_sync). It reads where it may live (sigil-hosts.json, from the
-- bar), what is happening (Pleamar's services; the bar's sigil-feed.json; nexus-feed.json for notices —
-- never the notification service itself, which only signals.luau may hold), asks the director what each
-- host shows, and writes each host's 64 targets, words and colour for the scene (shell/mooi-surface.plm,
-- generated by tools/gen-surface.py) to spring and draw. A press opens the module's existing panel.

local config = require("lib/config")
local hypr = require("lib/hypr")
local reveal = require("lib/surface/reveal")
local below = require("lib/surface/below")          -- D209
local opening = require("lib/surface/opening")
local music = require("lib/surface/music")      -- D223: Music in the picture's places
local peer = require("lib/surface/peer")        -- D224: peering and burying

local NOTICES = "nexus-feed.json"
-- (found live: passing an empty kind made Pleamar answer nothing, so settings.json and surface.json read as empty;
-- the frame's reader always did it this way)
local function read(name, kind)
    local ok, v
    if kind then ok, v = pcall(sys.ask, "files.read", name, kind) else ok, v = pcall(sys.ask, "files.read", name) end
    if ok then return v end
end

local S = {
    settings = config.parse(read("settings.json"), json.decode),
    r = {},                -- the readings the push up and the light need (music, notices, workspaces, windows)
    notice_seen = nil,
    -- D209/D215: what lives below the wallpaper is mooi-widgets'; this keeps their boxes for snapping
    widget_list = {},
    bmo_box = nil,         -- D214: where BMO stands, as he reports it (op_bx / op_bs)
}

local ship_set
local SF
local SK                   -- D217: push up from below (lib/surface/light), once the opening exists
local peek_update, end_peek, read_clients   -- D224: the peek, as the pointer moves while Super is held

-- ── the readings, from the services and the feeds ──
local function notices()
    local n = read(NOTICES, "json")
    if type(n) ~= "table" then return end
    local items = type(n.items) == "table" and n.items or {}
    local first = items[1]
    S.r.notifications = { count = tonumber(n.count) or 0, title = first and first.title or "", app = first and first.app or "" }
    -- a fresh notice: the newest one changed since the last reading (the first reading is not news)
    local stamp = first and (tostring(first.time or "") .. "|" .. tostring(first.title or "")) or ""
    local fresh = S.notice_seen ~= nil and stamp ~= "" and stamp ~= S.notice_seen
    S.notice_seen = stamp
    if SK then SK.news(S.r.notifications.count) end
    if fresh then
        if SK then SK.notice(first) end
        -- D210: the notification's ping — a light at the Notices widget while the opening is open
        fact.sf_ping = 1
        SF.ping = 1
    end
end

-- ── the opening's look (D210): every fact of Settings → The Subsurface (D226: the Sigil's hosts are gone) ──
local update
update = function()
    local s = S.settings
    local su = type(s.surface) == "table" and s.surface or {}
    local function num(v, d) return tonumber(v) or d end
    local function pct(v, d) return math.max(0, math.min(1, num(v, d) / 100)) end
    local order = { "tear", "aperture", "membrane", "ripple", "fold", "dissolve", "glass", "glow" }
    local fx = 1
    for i, e in ipairs(order) do if su.effect == e then fx = i end end
    fact.sf_fx = fx
    local pc = math.floor(math.max(20, math.min(100, num(su.intensity, 85))) + 0.5)
    local ec = math.floor(math.max(20, math.min(100, num(su.edge, 50))) + 0.5)
    local ci = su.colour == "plain" and 1 or (su.colour == "warm" and 2 or 0)
    fact.sf_param = pc * 1000 + ec * 10 + ci
    fact.sf_int, fact.sf_edge, fact.sf_col = pc / 100, ec / 100, ci
    fact.sf_wall = su.wall ~= false
    fact.sf_dim = pct(su.dim, 35)
    fact.sf_tint = pct(su.tint, 18)
    fact.sf_fit = su.fit == "contain" and 1 or 0
    fact.sf_grid = pct(su.grid, 45)
    fact.sf_labels = su.labels ~= false
    fact.sf_glow = su.glow == "off" and 0 or (su.glow == "bright" and 2 or 1)
    if su.ping == false then fact.sf_ping = 0 end
    fact.sf_ovm = math.floor(math.max(0, math.min(40, num(su.overview, 16))) + 0.5)
    opening.CORNER = math.floor(math.max(8, math.min(40, num(su.radius, 18))) + 0.5)
    reveal.OPEN_MS = math.floor(math.max(100, math.min(600, num(su.speed, 220))) + 0.5)
end

-- ── the services ──
pcall(sys.watch, "media", function(m)
    if type(m) ~= "table" then return end
    S.r.music = { title = m.title or "", artist = m.artist or "", playing = m.playing == true }
    update()
    if SK then SK.song(S.r.music) end
end)
pcall(sys.watch, "workspaces", function(w)
    if type(w) ~= "table" then return end
    local was_active = S.r.workspaces and S.r.workspaces.active
    S.r.workspaces = { active = tonumber(w.active), count = type(w.list) == "table" and #w.list or nil }
    -- D208: a Super shortcut that changed workspace closes a reveal (review I3: only a change of workspace —
    -- the service also fires when windows come and go)
    if was_active ~= nil and was_active ~= S.r.workspaces.active and SF_guard then SF_guard("workspace") end
    -- D219: the windows changed (Live wallpaper's whole picture rests under them)
    if SK then SK.window(w) end
    update()
end)
pcall(sys.watch, "window", function(w)
    if type(w) ~= "table" then return end
    local was_class = S.r.windows and S.r.windows.class
    S.r.windows = { title = w.title, class = w.class }
    if SK then SK.window(w) end
    -- D208: and so does one that moved the focus to another app (the service also fires on every title change)
    if was_class ~= nil and was_class ~= w.class and SF_guard then SF_guard("focus") end
end)
pcall(sys.watch, "clock", function(c)
    if type(c) ~= "table" then return end
    S.r.clock = { time = c.time, date = c.date }
    if SK then SK.clock(c.time) end
    S.r.calendar = { date = c.date, weekday = c.weekday }
    update()
end)
S.r.bmo = { say = "" }

-- ── the files ──
pcall(sys.watch, "files:" .. NOTICES, function() notices(); update() end)
pcall(sys.watch, "files:palette.json", function() if SF_wall then SF_wall() end end)
pcall(sys.watch, "files:settings.json", function()
    S.settings = config.parse(read("settings.json"), json.decode)
    update()
    if ship_set then ship_set() end
    if SK then SK.refresh() end
end)
-- the boxes the opening snaps to include the widgets living under the wallpaper (Task 8 keeps them in step)
local surface_file          -- below: surface.json, kept (D215: without the Presences once they are widgets)
local function widgets_file()
    local w = read("widgets.json", "json")
    S.widget_list = type(w) == "table" and type(w.widgets) == "table" and w.widgets or {}
    S.widgets_migrated = type(w) == "table" and w.migrated_presences == true
    if surface_file then surface_file() end
    if SK then SK.refresh() end
end
pcall(sys.watch, "files:widgets.json", widgets_file)
widgets_file()

-- ── Surface (D208, D209, D215): hold Super and the wallpaper opens; what lives below is mooi-widgets' ──
-- One table for all of it (the reveal's state, the opening, the screen and the pointer).
SF = { rv = reveal.state(), op = opening.state(), sent = nil, opened = false, dragging = nil,
       scr = { w = 1920, h = 1080 }, clock = 0, ptr = { x = 960, y = 540 }, ticking = nil,
       ping = 0, wbar = nil, monitor = nil, snap_code = 0, rise = -1, editing = false, typed = false, broken = false }
local SFILE = "surface.json"
local CITIZENS = { "mooi-widgets", "mooi-viz", "bmo" }
-- the bar's strip: what mooi-widgets reports its surface starts below (op_wbar), else the bar's own settings
local function bar_h()
    if SF.wbar then return SF.wbar end
    local b = type(S.settings.bar) == "table" and S.settings.bar or {}
    return (tonumber(b.offset) or 0) + (tonumber(b.height) or 30)
end

-- light through the skin (D210): the glow sits at the Now Playing and the Notices widgets, on the screen
local function aura_points()
    local mx, my, nx, ny = -9999, -9999, -9999, -9999
    for _, w in ipairs(S.widget_list) do
        if type(w) == "table" and tonumber(w.x) and tonumber(w.y) and tonumber(w.w) and tonumber(w.h) then
            local cx, cy = w.x + w.w / 2, w.y + w.h / 2 + bar_h()
            if w.kind == "nowplaying" and mx == -9999 then mx, my = cx, cy end
            if w.kind == "notices" and nx == -9999 then nx, ny = cx, cy end
        end
    end
    fact.au_mx, fact.au_my, fact.au_nx, fact.au_ny = mx, my, nx, ny
end

-- surface.json: what is left of it is the monitor the opening was made on. Its Presences (D208) became widgets
-- kept above (mooi-widgets migrates them, D215); once widgets.json says so, they and D209's places are dropped.
-- (review I6: the last good file is kept as surface.json.bak; a file that could not be read is never written)
surface_file = function()
    aura_points()
    if SF.broken or not S.widgets_migrated then return end
    local raw = read(SFILE)
    if type(raw) ~= "string" or not raw:match("%S") then return end
    local ok, d = pcall(json.decode, raw)
    if not ok or type(d) ~= "table" then SF.broken = true; log("surface · surface.json could not be read; not overwriting it"); return end
    if d.presences == nil and d.places == nil and d.usage == nil then return end
    pcall(sys.call, "files.write", "surface.json.bak", raw)
    pcall(sys.call, "files.write", SFILE, { version = 3, monitor = SF.monitor, music = S.music, buried = S.buried })
    log("surface · the Presences are widgets now; surface.json keeps only its monitor")
end

-- ── the opening (D209): what mooi-surface owns and every program under the wallpaper mirrors ──
local function surface_on() return type(S.settings.surface) == "table" and S.settings.surface.on == true end
local function tap() run("mooi", { "pill" }) end      -- today's Super tap (D226: the node's wake, when it runs)

local function bmo_below() return not (type(S.settings.surface) == "table" and S.settings.surface.bmo_below == false) end
local function boxes()
    local list = below.boxes(nil, S.widget_list, bar_h(), bmo_below() and S.bmo_box or nil)
    -- D224: a buried window's tile is a thing to hug too
    for _, t in ipairs(S.buried or {}) do list[#list + 1] = { id = "t:" .. t.address, x = t.x, y = t.y, w = t.w, h = t.h } end
    return list
end

-- what the opening hugs, as the scene's sf_snap: BMO 20, a widget 30, none 0
local function snap_code(b)
    if not b then return 0 end
    if b.id == "bmo" then return 20 end
    if type(b.id) == "string" and string.sub(b.id, 1, 2) == "w:" then return 30 end
    return 0
end

-- three packed numbers (lib/surface/opening `pack`), and the programs that mirror the hole
local function current()
    return opening.pack(SF.op, opening.hole(SF.op, SF.ptr, SF.scr))
end
local function ship(a, b, c)
    -- one pleamar per program, not three (D210)
    for _, cname in ipairs(CITIZENS) do
        run("pleamar", { "--say", cname, "emit op_a " .. a, "emit op_b " .. b, "emit op_c " .. c })
    end
end
local function widgets_say(cmd) run("pleamar", { "--say", "mooi-widgets", cmd }) end
-- The programs follow the pointer themselves in follow mode, so a follow move sends nothing (opening.changed);
-- a change of mode, of faintness or of the rim is sent at once, and once. The Overview (full) is the widgets'
-- edit mode (D215): entering it turns edit mode on, leaving it turns it off.
local function broadcast()
    local a, b, c = current()
    fact.op_ta, fact.op_tb, fact.op_tc = a, b, c
    local shown = opening.shown(SF.op)
    local code = (shown == opening.MODES.snapped or shown == opening.MODES.full) and snap_code(SF.op.snap) or 0
    if code ~= SF.snap_code then
        SF.snap_code = code
        fact.sf_snap = code
        -- opening onto BMO wakes him (the spec §5)
        if code == 20 then run("pleamar", { "--say", "bmo", "emit op_wake" }) end
    end
    -- coming up (D216): the widget the opening snaps to rises (its slot in widgets.json, or -1)
    local rise = (shown == opening.MODES.snapped and SF.op.snap) and below.slot(S.widget_list, SF.op.snap.id) or -1
    if rise ~= SF.rise then
        SF.rise = rise
        widgets_say("emit wg_rise " .. tostring(rise))
    end
    if SK then SK.opening(shown ~= opening.MODES.closed) end
    -- (D223: not while the Overview's Music mode has the picture)
    local full = shown == opening.MODES.full and surface_on() and not SF.mu
    if full ~= SF.editing then
        SF.editing = full
        widgets_say("emit wg_edit " .. (full and 1 or 0))
        if not full and SF.typed then SF.typed = false; widgets_say("emit ln_type 27") end
    end
    if opening.changed(SF.sent, a, b, c) then
        SF.sent = { a = a, b = b, c = c }
        ship(a, b, c)
    end
end

-- Task 1 found live: Hyprland's SUPER + drag never reaches a layer zone, so the drag bind is put down while
-- the opening is open and put back the moment it heals (and on load, and when the bar restarts this program).
local UNBIND = 'hl.unbind("SUPER + mouse:272")'
local BIND = 'hl.bind("SUPER + mouse:272", hl.dsp.window.drag(), { mouse = true })'
local function drag_down() run("hyprctl", { "eval", UNBIND }) end
local function drag_restore() run("hyprctl", { "eval", UNBIND }); run("hyprctl", { "eval", BIND }) end

ship_set = function()
    local bmo = bmo_below()
    local on = surface_on()
    -- switched off while an opening shows: heal it now rather than at the idle close (D214)
    if not on and SF.op.mode ~= opening.MODES.closed then
        reveal.finish(SF.rv)
        if SF.ticking then cancel(SF.ticking); SF.ticking = nil end
        opening.heal(SF.op)
        SF.opened, SF.dragging = false, nil
        drag_restore()
        broadcast()
    end
    fact.sf_on, fact.sf_bmo = on, bmo       -- our own scene's copy of the same two bits
    local v = (on and 1 or 0) + (bmo and 2 or 0)
    for _, cname in ipairs(CITIZENS) do run("pleamar", { "--say", cname, "emit sf_set " .. v }) end
end

local function show_reveal()
    local st = SF.rv
    fact.rv_on = st.stage >= 1
    -- a full opening let go with Super keeps the keyboard: Esc is how it is dismissed
    fact.sf_firm = reveal.firm(st) or (SF.op.mode == opening.MODES.full and SF.opened == true)
end

local function close_reveal()
    reveal.finish(SF.rv)
    if SF.ticking then cancel(SF.ticking); SF.ticking = nil end
    show_reveal()
end

local function heal_opening()
    if end_peek then end_peek() end
    if SF.op.mode == opening.MODES.closed then return end
    if SF.mu then SF.mu = false; fact.sf_mu = false; widgets_say("emit wg_quiet 0") end
    opening.heal(SF.op)
    SF.opened, SF.sent, SF.dragging = false, nil, nil
    drag_restore()
    broadcast()
end

-- SF.clock: a millisecond clock of our own (the reveal needs it fine)
-- (review I7: it advances only inside the reveal's own tick — nothing runs while idle)
-- D218: the pointer, read from Hyprland while Super is held — the scenes' own readings stand still while it is
-- over a window or any surface but theirs, so the hole is moved from here and sent (opening.changed). One read at
-- a time (a read that never answers is given up after half a second); a drag freezes the hole.
local function poll_pointer()
    if SF.dragging then return end
    if SF.polling and SF.clock - SF.poll_at < 500 then return end
    SF.polling, SF.poll_at = true, SF.clock
    run("hyprctl", { "cursorpos" }, function(out)
        SF.polling = nil
        local x, y = tostring(out or ""):match("(%-?%d+),%s*(%-?%d+)")
        if not x then return end
        SF.ptr = { x = tonumber(x) - (SF.mox or 0), y = tonumber(y) - (SF.moy or 0) }
        if SF.op.mode > 0 and not SF.dragging then
            opening.move(SF.op, boxes(), SF.ptr, bar_h(), SF.clock)
            broadcast()
        end
        if peek_update then peek_update() end
    end)
end

local function tick()
    SF.clock = SF.clock + 50
    -- the notification ping fades in about a second while the opening is up
    local ping_on = not (type(S.settings.surface) == "table" and S.settings.surface.ping == false)
    if ping_on then
        SF.ping = SF.ping * 0.90
        if SF.ping < 0.02 then SF.ping = 0 end
    else
        SF.ping = 0
    end
    fact.sf_ping = SF.ping
    reveal.tick(SF.rv, SF.clock, SF.ptr)
    if not SF.rv.down_at then
        close_reveal()
        if SF.op.mode ~= opening.MODES.full then heal_opening() end
        return
    end
    show_reveal()
    if SF.clock % 100 == 0 then poll_pointer() end
    if SF.clock % 500 == 0 and read_clients then read_clients() end
    if SF.rv.stage == 2 and not SF.opened then
        SF.opened = true
        opening.open(SF.op)
        opening.move(SF.op, boxes(), SF.ptr, bar_h(), SF.clock)
        drag_down()
        broadcast()
    end
    -- faint until it is firm (the pointer has really moved) or snapped: then it opens all the way
    if SF.op.faint and reveal.firm(SF.rv) then
        opening.firm(SF.op)
        broadcast()
    end
end

on("rv_down", function()
    if not surface_on() then return end
    reveal.DELAY = tonumber(S.settings.surface and S.settings.surface.delay) or reveal.DELAY
    reveal.down(SF.rv, SF.clock)
    SF.opened, SF.dragging = false, nil
    if read_clients then read_clients() end
    -- where the pointer is now (the scene tells us as it moves once the opening is open)
    run("hyprctl", { "cursorpos" }, function(out)
        local x, y = tostring(out or ""):match("(%-?%d+),%s*(%-?%d+)")
        if x then
            SF.ptr = { x = tonumber(x) - (SF.mox or 0), y = tonumber(y) - (SF.moy or 0) }
            if SF.op.mode > 0 then opening.move(SF.op, boxes(), SF.ptr, bar_h(), SF.clock); broadcast() end
        end
    end)
    if not SF.ticking then SF.ticking = every(50, tick) end
end)
on("rv_move", function(v)
    v = math.floor(tonumber(v) or 0)
    SF.ptr = { x = v // 10000, y = v % 10000 }
    -- while a drag is under way the hole stays where it was: a following hole would always contain the drop
    if SF.op.mode > 0 and not SF.dragging then
        opening.move(SF.op, boxes(), SF.ptr, bar_h(), SF.clock)
        broadcast()
    end
end)
on("rv_up", function()
    if not surface_on() then tap(); return end       -- review I1: off, Super's release is the old tap
    local res = reveal.up(SF.rv, SF.clock)
    -- in the Overview a Super tap is its own close, not the bar's tap
    if res == "tap" and SF.op.mode == opening.MODES.full then
        close_reveal()
        heal_opening()
        return
    end
    if res == "tap" then close_reveal(); tap(); return end
    close_reveal()
    -- full stays until Escape (or `mooi reveal heal`); every other mode heals on release
    if SF.op.mode ~= opening.MODES.full then heal_opening() end
end)

-- the wheel widens and narrows; the bar routes Super + wheel here while the opening shows
on("op_wheel", function(v)
    -- D224: while peeking, the wheel widens (or narrows) the patch
    if SF.peek then
        SF.pr_r = math.max(60, math.min(700, (SF.pr_r or 110) * (((tonumber(v) or 0) > 0) and 1.35 or 1 / 1.35)))
        fact.pr_r = SF.pr_r
        return
    end
    if SF.op.mode == opening.MODES.closed then return end
    if (tonumber(v) or 0) > 0 then
        opening.widen(SF.op, SF.scr, SF.ptr) -- a snapped section stays on the thing; a bare one on the pointer
    else
        opening.narrow(SF.op, SF.scr)
    end
    broadcast()
end)

-- the citizens' reports (the spec §6): BMO's box where he stands, the widgets' bar strip
local bx_pending = nil
on("op_bx", function(v) bx_pending = math.floor(tonumber(v) or 0) end)
on("op_bs", function(v)
    v = math.floor(tonumber(v) or 0)
    if not bx_pending then return end
    local w, h = v // 4096, v % 4096
    S.bmo_box = w > 0 and { x = bx_pending // 4096, y = bx_pending % 4096, w = w, h = h } or nil
    bx_pending = nil
end)
on("op_wbar", function(v)
    local n = tonumber(v)
    if n and n >= 0 and n < 400 then SF.wbar = math.floor(n + 0.5); aura_points() end
end)

-- a program under the wallpaper just came up: send it the hole and the Surface's bits
on("op_want", function()
    local a, b, c = current()
    SF.sent = { a = a, b = b, c = c }
    ship(a, b, c)
    ship_set()
    if SF.editing then widgets_say("emit wg_edit 1") end
    if SF.rise and SF.rise >= 0 then widgets_say("emit wg_rise " .. tostring(SF.rise)) end
end)

-- the keyboard's walk: what lives below in reading order, snapped one by one; Return presses what is snapped
-- (D216: the widget's own main press, BMO woken), or, typed into in the Overview, the grid's first match
local function press_snapped()
    local k = -1
    if SF.op.mode == opening.MODES.full and SF.typed then
        k = below.grid_slot(S.widget_list)
    elseif SF.op.snap and SF.op.snap.id == "bmo" then
        run("pleamar", { "--say", "bmo", "emit op_wake" })
    elseif SF.op.snap then
        k = below.slot(S.widget_list, SF.op.snap.id)
    end
    if k >= 0 then widgets_say("emit wg_press " .. tostring(k)) end
end
on("op_key", function(v)
    v = math.floor(tonumber(v) or 0)
    opening.firm(SF.op)
    if v == 2 then press_snapped(); return end
    local list = boxes()
    if #list == 0 then return end
    table.sort(list, function(p, q)
        if math.abs(p.y - q.y) > 24 then return p.y < q.y end
        return p.x < q.x
    end)
    local at
    if SF.op.snap then
        for i, b in ipairs(list) do if b.id == SF.op.snap.id then at = i end end
    end
    -- from nothing snapped, Tab goes to the first and Shift+Tab to the last
    if not at then at = v > 0 and 1 or #list
    else at = (at + (v > 0 and 1 or -1) - 1) % #list + 1 end
    -- the Overview stays the Overview: the walk only moves the focus there
    if SF.op.mode ~= opening.MODES.full then SF.op.mode = opening.MODES.snapped end
    SF.op.away = false
    SF.op.snap = list[at]
    broadcast()
end)

-- typing in the Overview finds an app in Launch's grid (mooi-widgets keeps what is typed)
on("op_type", function(v)
    if SF.op.mode ~= opening.MODES.full then return end
    SF.typed = true
    widgets_say("emit ln_type " .. tostring(math.floor(tonumber(v) or 0)))
end)

-- the widgets' edit keys while the Overview is open: the edge holds the keyboard, so they are sent on
on("op_wkey", function(v)
    if SF.op.mode ~= opening.MODES.full then return end
    widgets_say("emit wg_key " .. tostring(math.floor(tonumber(v) or 0)))
end)

-- a widget dragged in the opening (mooi-widgets says sb_drag -1): the hole is frozen at the press, so a drop
-- can land outside it — kept above — or inside — buried
on("sb_drag", function()
    SF.dragging = true
    opening.firm(SF.op)
    if SF.op.mode > 0 and SF.op.mode ~= opening.MODES.snapped and SF.op.mode ~= opening.MODES.full then
        local h = opening.hole(SF.op, SF.ptr, SF.scr)
        SF.op.mode = opening.MODES.snapped
        SF.op.snap = { x = h.x + opening.MARGIN, y = h.y + opening.MARGIN,
                       w = h.w - 2 * opening.MARGIN, h = h.h - 2 * opening.MARGIN }
        broadcast()
    end
end)
on("sb_drop", function() SF.dragging = nil end)

-- the safeguards: a Super shortcut never sends Super's "up", so these close any reveal and heal the opening
local function guard(event)
    if SF.rv.down_at and reveal.close_on(event) then
        close_reveal()
        heal_opening()
    end
end
on("rv_esc", function()
    -- Escape clears what has been typed first, then heals
    if SF.typed and SF.op.mode == opening.MODES.full then SF.typed = false; widgets_say("emit ln_type 27"); return end
    guard("escape")
    if SF.op.mode ~= opening.MODES.closed then heal_opening() end
end)
-- (the workspaces and window watchers above call SF_guard: one watcher per service)
SF_guard = guard

-- on load the bind is ours to leave as we found it; and tell the citizens where the Surface stands
drag_restore()
ship_set()

-- the screen and the wallpaper (the effects draw the real picture)
local function wallpaper()
    local home = sys.ask("env", "HOME") or ""
    -- -e: nothing for a missing picture (review I5), so the Aperture draws its plain subsurface
    run("readlink", { "-e", home .. "/.cache/current_wallpaper" }, function(out)
        local path = tostring(out or ""):gsub("%s+$", "")
        if path ~= "" then text.rv_wall = path; S.wall_path = path end
    end)
end
run("hyprctl", { "-j", "monitors" }, function(out)
    local ok, mons = pcall(json.decode, out or "")
    if ok and type(mons) == "table" then
        for _, m in ipairs(mons) do
            if m.focused then
                SF.scr = { w = tonumber(m.width) / (tonumber(m.scale) or 1), h = tonumber(m.height) / (tonumber(m.scale) or 1) }
                SF.monitor = type(m.name) == "string" and m.name or nil
                SF.mox, SF.moy = tonumber(m.x) or 0, tonumber(m.y) or 0
            end
        end
    end
    surface_file()
end)
wallpaper()
SF_wall = wallpaper       -- the palette watcher above calls it: one watcher per file (review M7)

-- ── D223: Music in the picture — its places (surface.json's `music`), the picture's subject, the Music mode ──
local function load_music()
    local raw = read(SFILE)
    local ok, d = pcall(json.decode, type(raw) == "string" and raw or "")
    S.music = music.read(ok and type(d) == "table" and d.music or nil)
    S.buried = peer.read(ok and type(d) == "table" and d.buried or nil)     -- D224
end
local function save_music()
    if SF.broken then return end
    local raw = read(SFILE)
    local ok, d = pcall(json.decode, type(raw) == "string" and raw or "")
    if type(raw) == "string" and raw:match("%S") and not (ok and type(d) == "table") then return end
    d = ok and type(d) == "table" and d or { version = 3 }
    d.monitor = d.monitor or SF.monitor
    d.music = S.music
    d.buried = S.buried                    -- D224: the buried windows' tiles
    pcall(sys.call, "files.write", SFILE, d)
    if SK then SK.refresh() end
end
load_music()
local function cut_now()
    local w = read("wall-map.json", "json")
    S.cut = type(w) == "table" and type(w.cutpath) == "string" and w.cutpath or ""
    text.mu_cutp = S.cut
    if SK then SK.refresh() end
end
pcall(sys.watch, "files:wall-map.json", cut_now)
on("mu_mode", function(v)
    local want = math.floor(tonumber(v) or 0) == 1 and SF.op.mode == opening.MODES.full
    SF.mu = want
    fact.sf_mu = want
    if want then widgets_say("emit wg_quiet 1") else widgets_say("emit wg_quiet 0") end
    broadcast()
end)
on("mu_at", function(v) SF.mu_at = math.floor(tonumber(v) or 0) end)
on("mu_wh", function(v)
    v = math.floor(tonumber(v) or 0)
    local at = SF.mu_at or 0
    S.music = music.add_area(S.music, { x = at // 4096, y = at % 4096, w = v // 4096, h = v % 4096 })
    save_music()
end)
on("mu_pick", function(v)
    v = math.floor(tonumber(v) or 0)
    local ok, c = pcall(sys.ask, "capture.pixel", v // 4096 + (SF.mox or 0), v % 4096 + (SF.moy or 0))
    if ok and type(c) == "string" then S.music = music.add_colour(S.music, c); save_music() end
end)
on("mu_edge", function(v)
    local h = tonumber(SF.scr and SF.scr.h) or 1080
    S.music.edge_at = math.floor((tonumber(v) or h) / h * 100 + 0.5)
    S.music = music.read(S.music)
    if SK then SK.refresh() end
    SF.mu_save = (SF.mu_save or 0) + 1
    local mine = SF.mu_save
    after(400, function() if SF.mu_save == mine then save_music() end end)
end)
on("mu_tog", function(v)
    v = math.floor(tonumber(v) or 0)
    if v == 1 then S.music.edge = not S.music.edge end
    if v == 2 then
        S.music.subject = not S.music.subject
        -- the subject needs mooi's cut-out of the picture; made once per wallpaper (a while, the first time)
        if S.music.subject and (S.cut or "") == "" and S.wall_path then run("mooi", { "wallmap", S.wall_path }, function() end) end
    end
    save_music()
end)
on("mu_clear", function()
    S.music.areas, S.music.colours = {}, {}
    save_music()
end)

-- ── D224: peering and burying (the Subsurface spec §8) ──
-- the windows' live pictures (the thumbnails service lists them; nothing is copied until asked)
S.thumbs = {}
local function thumb_pic(id)
    for _, t in ipairs(S.thumbs) do if t.id == id then return tostring(t.picture or "") end end
    return ""
end
local function show_tiles()
    for i = 1, peer.MAX do
        local t = S.buried[i]
        fact["bt" .. i] = t ~= nil
        if t then
            fact["bt" .. i .. "x"], fact["bt" .. i .. "y"], fact["bt" .. i .. "w"], fact["bt" .. i .. "h"] = t.x, t.y, t.w, t.h
            text["bt" .. i .. "_name"] = (t.class ~= "" and (t.class .. " · ") or "") .. t.title
            text["bt" .. i .. "_pic"] = thumb_pic(peer.thumb_for(S.thumbs, t))
        end
    end
end
-- the buried windows' pictures are copied (as files, when they change); the peek's one live
local function want_tiles()
    local ids = {}
    for _, t in ipairs(S.buried) do local id = peer.thumb_for(S.thumbs, t); if id then ids[#ids + 1] = id end end
    pcall(sys.call, "thumbnails.want", ids)
end
pcall(sys.watch, "thumbnails", function(t)
    if type(t) ~= "table" then return end
    S.thumbs = type(t.list) == "table" and t.list or {}
    show_tiles()
    if SF.peek_id then text.pr_pic = thumb_pic(SF.peek_id) end
end)
-- the windows of the workspace shown, while Super is held (every half second), and the tiles of closed windows let go
read_clients = function()
    run("hyprctl", { "-j", "clients" }, function(out)
        local ok, clients = pcall(json.decode, out or "")
        if not ok or type(clients) ~= "table" then return end
        SF.clients = clients
        SF.ws = S.r.workspaces and S.r.workspaces.active
        local n = #S.buried
        S.buried = peer.prune(S.buried, clients)
        if #S.buried ~= n then save_music(); show_tiles(); want_tiles() end
    end)
end
-- the peek: over a window with another behind it, the one behind live in a round patch at the pointer
peek_update = function()
    if not SF.opened or not SF.clients then return end
    local front, behind = peer.peer(SF.clients, SF.ws, { x = SF.mox or 0, y = SF.moy or 0 }, SF.ptr)
    if not behind then end_peek(); return end
    if SF.peek ~= behind.address then
        SF.peek = behind.address
        local id = peer.thumb_for(S.thumbs, behind)
        SF.peek_id = id
        if id then pcall(sys.call, "thumbnails.live", { id }) end
        text.pr_pic = thumb_pic(id)
        fact.pr_bx, fact.pr_by, fact.pr_bw, fact.pr_bh = behind.x, behind.y, behind.w, behind.h
        fact.pr_r = SF.pr_r or 110
    end
    fact.pr_x, fact.pr_y = SF.ptr.x, SF.ptr.y
    fact.pr_on = true
end
end_peek = function()
    if not SF.peek then return end
    SF.peek, SF.peek_id, SF.pr_r = nil, nil, nil
    fact.pr_on = false
    pcall(sys.call, "thumbnails.live")
end
-- Super+Alt+B: the focused window under the wallpaper, its tile where the pointer is
on("bury", function()
    if not surface_on() then return end
    run("hyprctl", { "-j", "activewindow" }, function(out)
        local ok, c = pcall(json.decode, out or "")
        if not ok or type(c) ~= "table" or type(c.address) ~= "string" then return end
        if type(c.workspace) == "table" and tostring(c.workspace.name or ""):match("^special") then return end
        run("hyprctl", { "cursorpos" }, function(cp)
            local x, y = tostring(cp or ""):match("(%-?%d+),%s*(%-?%d+)")
            local p = { x = (tonumber(x) or SF.scr.w / 2) - (SF.mox or 0), y = (tonumber(y) or SF.scr.h / 2) - (SF.moy or 0) }
            S.buried = peer.bury(S.buried, c, p, SF.scr)
            want_tiles()                       -- its picture copied while it still shows
            after(300, function()
                local cmd = hypr.dispatch("bury", c.address)
                if cmd then run("hyprctl", { "dispatch", cmd }) end
                save_music(); show_tiles()
                log("surface · buried " .. tostring(c.class) .. " under the wallpaper")
            end)
        end)
    end)
end)
-- a tile pressed: its window back on the workspace shown, focused; the tile gone
on("bt_go", function(v)
    local i = math.floor(tonumber(v) or 0)
    local t = S.buried[i]
    if not t then return end
    local ws = S.r.workspaces and S.r.workspaces.active or 1
    local back = hypr.dispatch("bring", t.address, { workspace = ws })
    local focus = hypr.dispatch("focus", t.address)
    if back then run("hyprctl", { "dispatch", back }, function() if focus then run("hyprctl", { "dispatch", focus }) end end) end
    table.remove(S.buried, i)
    save_music(); show_tiles(); want_tiles()
    close_reveal()
    heal_opening()
end)

-- D226: the node (the Pill) had news: the wallpaper ripples under it for a moment (Live wallpaper's ripple)
on("nd_fx", function(v)
    local reduced = type(S.settings.motion) == "table" and S.settings.motion.reduced == true
    if reduced then return end
    fact.nf_x = math.floor(tonumber(v) or 960)
    fact.nf_on, fact.nf_t = true, 1
    SF.nf = (SF.nf or 0) + 1
    local mine = SF.nf
    after(700, function() if SF.nf == mine then fact.nf_t = 0 end end)
    after(1500, function() if SF.nf == mine then fact.nf_on = false end end)
end)

-- D217: push up from below — the glow, the moving wallpaper, the bulge and words, the notice's light
SK = require("lib/surface/light")({
    music = function() return S.music end,
    cut = function() return S.cut or "" end,
    settings = function() return S.settings end,
    widgets = function() return S.widget_list end,
    bar_h = bar_h,
    open = function() return opening.shown(SF.op) ~= opening.MODES.closed end,
    scr = function() return SF.scr end,
})
if S.r.music then SK.song(S.r.music) end
cut_now()
show_tiles()

notices(); update()
widgets_file()
log("surface · up")
