language 0.9

// mooi's desk (D85, D145): the wallpaper, drawn by mooi — every still and animated picture, and a
// video's still until mpvpaper plays it underneath — and the picture's subject laid over the
// desktop widgets. Two surfaces and no zones, so every click goes through to the desk:
//   · `back` on the background layer: the picture, drawn a little larger than the screen when it
//     travels (as the workspaces change and/or as the pointer moves), at the screen's size when not;
//   · `fore` on the bottom layer, over the widgets and under every window: the cutout Lumen made
//     when the picture was applied, travelling with the picture — further, when it has depth.
// shell/mooi-desk.luau decides what is drawn (lib/desk), the scene only moves it.

scene Desk {
    permissions {
        run: "readlink", "pleamar", "mooi", "hyprctl"
        services: "workspaces", "files", "env"
    }

    // The two slots the picture changes through, the cutout, and what each holds.
    text wall_a = ""
    text wall_b = ""
    text cut_path = ""
    image wa = from wall_a, 2112, 1188
    image wb = from wall_b, 2112, 1188
    image cut = from cut_path, 2112, 1188
    fact slot = 0
    fact has_a = false
    fact has_b = false
    fact has_cut = false
    // What moves it: 0 nothing · 1 the workspaces · 2 the pointer · 3 both; how far (the share of
    // the screen the picture is drawn larger by); how much further the subject travels.
    fact mode = 1
    fact over = 0.045
    fact depth = 0.55
    fact moving = true
    fact ws_frac = 0
    // a video's mpvpaper is up (`mooi wall live` says so): the desk's picture fades out over it
    fact live = false
    event live_on ->         // `mooi wall live`: 1 mpvpaper plays the video, 0 it does not
    // how the next picture comes in (D144): 0 fade · 1 grow · 2 wipe · 3 slide, and where a growing
    // circle starts (the notch's edge when it was picked there; the middle otherwise)
    fact tr = 0
    fact tr_x = 960
    fact tr_y = 540
    event from_notch ->      // the notch picked it: the circle grows from its edge (its y)

    // A slow, heavy glide between workspaces; a lighter drift after the pointer.
    spring dk.glide = 90, 19
    spring dk.drift = 140, 24
    spring dk.fade = 300, 40
    prop wsx = 0 ~dk.glide
    follow wsx = ws_frac
    prop cxp = 0 ~dk.drift
    follow cxp = if(mode >= 2 and moving, clamp(cursor.x / max(1, screen.width), 0, 1) - 0.5, 0)
    prop cyp = 0 ~dk.drift
    follow cyp = if(mode >= 2 and moving, clamp(cursor.y / max(1, screen.height), 0, 1) - 0.5, 0)
    // the crossing: `fa` is 1 with slot A shown, 0 with B; a transition takes about a second
    // three paces (walls.speed, D147): a duration is part of a prop, so one prop each, and `pace` picks
    fact pace = 1
    prop fa0 = 1 ~500ms
    follow fa0 = if(slot == 0, 1, 0)
    prop fa1 = 1 ~950ms
    follow fa1 = if(slot == 0, 1, 0)
    prop fa2 = 1 ~1600ms
    follow fa2 = if(slot == 0, 1, 0)
    let fa = if(pace == 0, fa0, if(pace == 2, fa2, fa1))
    prop seen = 1 ~400ms
    follow seen = if(live, 0, 1)

    surface back {
        size: full, full
        anchor: top
        reserve: -1
        level: background
        keyboard: none

        let sw = screen.width
        let sh = screen.height
        // where along its travel the picture is, 0 … 1 each way; with both, the workspaces take
        // 0.6 of it and the pointer 0.4 round that, so neither is cut off at the row's ends
        let px = clamp(if(mode == 1, wsx, if(mode == 2, 0.5 + cxp, if(mode == 3, 0.5 + (wsx - 0.5) * 0.6 + cxp * 0.4, 0.5))), 0, 1)
        let py = clamp(0.5 + if(mode >= 2, cyp * 0.8, 0), 0, 1)
        let ww = sw * (1 + over)
        let wh = sh * (1 + over)
        // the picture coming in (`np` of the way) over the one going: faded, grown as a circle from
        // (tr_x, tr_y), wiped from the left, or slid in pushing the old one out (D144)
        let np = if(slot == 0, fa, 1 - fa)
        let reach = sqrt(sw * sw + sh * sh)
        let rr = if(tr == 1, reach * np, reach * 2)
        group {
            show: (has_a or has_b) and seen > 0.001
            opacity: seen
            box { from: 0, 0; size: sw, sh; color: #000000 }
            // going
            group { show: slot == 1 and has_a
                    move: if(tr == 3, 0 - sw * np, 0), 0
                    image wa { at: -over * sw * px, -over * sh * py; size: ww, wh } }
            group { show: slot == 0 and has_b
                    move: if(tr == 3, 0 - sw * np, 0), 0
                    image wb { at: -over * sw * px, -over * sh * py; size: ww, wh } }
            // coming
            group { show: slot == 0 and has_a
                    opacity: if(tr == 0, np, 1)
                    move: if(tr == 3, sw * (1 - np), 0), 0
                    mask: radial tr_x, tr_y radius max(0, rr - 3) to rr + 0.01
                    clip box { from: 0, 0; size: if(tr == 2, sw * np, sw), sh }
                    image wa { at: -over * sw * px, -over * sh * py; size: ww, wh } }
            group { show: slot == 1 and has_b
                    opacity: if(tr == 0, np, 1)
                    move: if(tr == 3, sw * (1 - np), 0), 0
                    mask: radial tr_x, tr_y radius max(0, rr - 3) to rr + 0.01
                    clip box { from: 0, 0; size: if(tr == 2, sw * np, sw), sh }
                    image wb { at: -over * sw * px, -over * sh * py; size: ww, wh } }
        }
    }

    surface fore {
        size: full, full
        anchor: top
        reserve: -1
        level: bottom
        keyboard: none

        let fw = screen.width
        let fh = screen.height
        let qx = clamp(if(mode == 1, wsx, if(mode == 2, 0.5 + cxp, if(mode == 3, 0.5 + (wsx - 0.5) * 0.6 + cxp * 0.4, 0.5))), 0, 1)
        let qy = clamp(0.5 + if(mode >= 2, cyp * 0.8, 0), 0, 1)
        // the subject travels round the middle of the picture's travel, further by `depth`
        let tx = 0.5 + (qx - 0.5) * (1 + depth)
        let ty = 0.5 + (qy - 0.5) * (1 + depth)
        group {
            show: has_cut and not live
            image cut { at: -over * fw * tx, -over * fh * ty; size: fw * (1 + over), fh * (1 + over) }
        }
    }
}
