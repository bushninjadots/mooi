language 0.9
// mooi design tokens. Components read the semantic names, never the palette.
//
// ── Colour ────────────────────────────────────────────────────
// The brief's palette below is the reference the shell was designed against, and it is
// what the colour facts in the scene are born with (the same values, to the byte). The
// semantic tokens are not literals any more: each one is `rgb(r, g, b)` over three facts
// the logic sets (`shell/lib/theme.luau` decides the values), so a theme can change
// while the scene runs — from the settings, from the user's overrides, or from a palette
// taken off the wallpaper — without rewriting a file and reloading the scene.
//
// Precedence is deterministic and lives in one place (lib/theme): fixed palette →
// wallpaper palette → user overrides → validation (completeness, then contrast). A theme
// that does not pass is refused whole and the last good one stays on screen.
library Theme {
    // ── Palette (provisional, from the brief; colour facts are born with these) ──
    let void = #101416
    let steel = #22292D
    let signal = #A6F3D1
    let heat = #FF925F

    // ── Semantic roles (fg.* are the brief's text.* roles) ────
    // Base semantic tokens from the brief's palette (backward compatible)
    let bg.primary = rgb(c_bg_primary_r, c_bg_primary_g, c_bg_primary_b)
    let surface.primary = rgb(c_surface_primary_r, c_surface_primary_g, c_surface_primary_b)
    let surface.elevated = rgb(c_surface_elevated_r, c_surface_elevated_g, c_surface_elevated_b)
    let border.subtle = rgb(c_border_subtle_r, c_border_subtle_g, c_border_subtle_b)
    let fg.primary = rgb(c_fg_primary_r, c_fg_primary_g, c_fg_primary_b)
    let fg.secondary = rgb(c_fg_secondary_r, c_fg_secondary_g, c_fg_secondary_b)
    let fg.muted = rgb(c_fg_muted_r, c_fg_muted_g, c_fg_muted_b)
    let accent.primary = rgb(c_accent_primary_r, c_accent_primary_g, c_accent_primary_b)
    let accent.secondary = rgb(c_accent_secondary_r, c_accent_secondary_g, c_accent_secondary_b)
    let status.ok = rgb(c_status_ok_r, c_status_ok_g, c_status_ok_b)
    let status.error = rgb(c_status_error_r, c_status_error_g, c_status_error_b)
    let focus.ring = rgb(c_focus_ring_r, c_focus_ring_g, c_focus_ring_b)
    let selection.bg = rgb(c_selection_bg_r, c_selection_bg_g, c_selection_bg_b)
    // The brief also names a `status.warning` role: mooi has no warning state yet
    // (failures and the accent share `status.error` / `accent.secondary`), so it is not
    // declared here rather than declared and unused.

    // Short names the islands use for the roles above.
    let surface = surface.primary
    let accent = accent.primary
    let highlight = accent.primary
    let text = fg.primary
    let outline = border.subtle
    let border = border.subtle
    let hover = fg.muted
    let selected = accent.primary

    // ── Two derived materials ─────
    // Derived from the roles, so a new palette moves them too: `plate` is the ground taken most
    // of the way to black, `metal` the elevated surface lifted toward the text.
    let plate = mix(bg.primary, #000000, 0.55)
    let metal = mix(surface.elevated, fg.secondary, 0.30)

    // ── Motion tokens ─────────────────────────────────────────
    // Critically damped: k = (6.64/T)², c = 2·6.64/T reaches 99 % at T.
    // Measured by tests/scene.sh (`pleamar --record`), not assumed.
    spring m.select = 3062, 111     // 120 ms · selection.change, focus.change
    spring m.enter = 1361, 74       // 180 ms · surface.enter
    spring m.exit = 2249, 95        // 140 ms · surface.exit (leaves faster than it arrives)
    // an island growing out of the frame (D152, after iNiR's emerge): ~420 ms with a slight swell past
    // its size, and back in ~210 ms; the bar and the frame both run it, so body and content agree
    spring m.isl = 230, 26
    spring m.isl_out = 900, 60
    // D188: the Pill becoming its board (and the board taking each room's size): looser than an
    // island's, so it overshoots ~9 %, full size at ~0.3 s, settled by ~0.7 s (measured) — ZenoShell's elastic open, on a spring
    spring m.morph = 26, 6
    spring m.expand = 1102, 66      // 200 ms · surface.expand
    spring m.collapse = 1722, 83    // 160 ms · surface.collapse
    spring m.confirm = 765, 55      // 240 ms · state.confirm feedback
    spring m.reflow = 911, 60       // 220 ms · layout.reflow (lists gaining or losing items)

    // ── Geometry ──────────────────────────────────────────────
    // Corners follow the shell's rounding (bar.radius, in Appearance): islands a step rounder
    // than the bar's modules, tiles inside them as round as the modules.
    let g.radius = st_radius + 2    // legacy alias: islands and panels
    let g.radius.panel = st_radius + 2
    let g.radius.control = st_radius
    let g.radius.item = st_radius   // legacy alias: tiles inside panels

    // ── Shared geometry scale ─────────────────────────────────
    // Baseline values for new reusable components. These are not a mandate that every
    // surface must be rounded or use identical spacing; feature-specific geometry is valid
    // when it is intentional and documented. Values are in logical pixels.
    let g.space.1 = 4
    let g.space.2 = 6
    let g.space.3 = 8
    let g.space.4 = 10
    let g.space.5 = 12
    let g.space.6 = 16
    let g.space.7 = 24
    let g.space.8 = 32

    let g.stroke.hairline = 1
    let g.stroke.default = 1.25
    let g.stroke.strong = 1.75

    // Interactive bounds are independent of the visible icon/mark.
    let g.hit.compact = 24
    let g.hit.standard = 32
    let g.hit.comfortable = 40
}
