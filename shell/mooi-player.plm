language 0.4
import "theme/tokens.plm"
import "theme/ferrolume.plm"
import "ui/loom.plm"
import "ui/viz.plm" as viz
import "ui/playerviews.plm" as views

// mooi's music player (docs/PLAYER.md): a program of its own, opened from the bar's media module.
// Your mpd library first — the queue, seek, volume, shuffle and repeat through mpc — and a remote
// for whatever else plays (MPRIS). Its face is a turntable: the cover is the record's label and
// turns with it, the tonearm's angle is the song's progress (carry it to seek), and cava's bands
// ring the record. shell/mooi-player.luau reads mpd and paints the shell's colours.

scene Player {
    permissions {
        run: "mpc", "matugen", "ffmpeg", "playerctl", "cava", "curl", "pleamar", "magick", "mkdir", "cat", "easyeffects", "pgrep", "cp", "ls", "mpv", "hyprctl", "yt-dlp"
        services: "media", "media.*", "audio", "audio.*", "files", "files.write", "env"
    }

    // The same facts and springs the bar wears: the logic paints them from palette.json.
    fact fr_ground_r = 0.000000
    fact fr_ground_g = 0.000000
    fact fr_ground_b = 0.000000
    fact fr_hull_r = 0.015686
    fact fr_hull_g = 0.035294
    fact fr_hull_b = 0.031373
    fact fr_hull_raised_r = 0.027451
    fact fr_hull_raised_g = 0.074510
    fact fr_hull_raised_b = 0.066667
    fact fr_well_r = 0.019608
    fact fr_well_g = 0.164706
    fact fr_well_b = 0.145098
    fact fr_trace_dim_r = 0.121569
    fact fr_trace_dim_g = 0.219608
    fact fr_trace_dim_b = 0.200000
    fact fr_trace_r = 0.239216
    fact fr_trace_g = 0.415686
    fact fr_trace_b = 0.376471
    fact fr_trace_lit_r = 0.423529
    fact fr_trace_lit_g = 0.788235
    fact fr_trace_lit_b = 0.682353
    fact fr_phos_r = 0.498039
    fact fr_phos_g = 0.811765
    fact fr_phos_b = 0.713725
    fact fr_phos_fill_r = 0.090196
    fact fr_phos_fill_g = 0.603922
    fact fr_phos_fill_b = 0.533333
    fact fr_ember_r = 0.878431
    fact fr_ember_g = 0.482353
    fact fr_ember_b = 0.180392
    fact fr_ember_fill_r = 0.823529
    fact fr_ember_fill_g = 0.411765
    fact fr_ember_fill_b = 0.117647
    fact fr_flare_r = 0.956863
    fact fr_flare_g = 0.713725
    fact fr_flare_b = 0.235294
    fact fr_muted_r = 0.352941
    fact fr_muted_g = 0.541176
    fact fr_muted_b = 0.494118
    fact fr_ink_r = 0.015686
    fact fr_ink_g = 0.129412
    fact fr_ink_b = 0.113725
    fact fr_steel_900_r = 0.082353
    fact fr_steel_900_g = 0.098039
    fact fr_steel_900_b = 0.105882
    fact fr_steel_700_r = 0.164706
    fact fr_steel_700_g = 0.192157
    fact fr_steel_700_b = 0.203922
    fact fr_steel_500_r = 0.290196
    fact fr_steel_500_g = 0.329412
    fact fr_steel_500_b = 0.349020
    fact fr_steel_300_r = 0.545098
    fact fr_steel_300_g = 0.592157
    fact fr_steel_300_b = 0.611765
    fact fr_engrave_r = 0.603922
    fact fr_engrave_g = 0.650980
    fact fr_engrave_b = 0.670588
    prop pr_ground_r = 0.000000 ~fl.relight
    follow pr_ground_r = fr_ground_r
    prop pr_ground_g = 0.000000 ~fl.relight
    follow pr_ground_g = fr_ground_g
    prop pr_ground_b = 0.000000 ~fl.relight
    follow pr_ground_b = fr_ground_b
    prop pr_hull_r = 0.015686 ~fl.relight
    follow pr_hull_r = fr_hull_r
    prop pr_hull_g = 0.035294 ~fl.relight
    follow pr_hull_g = fr_hull_g
    prop pr_hull_b = 0.031373 ~fl.relight
    follow pr_hull_b = fr_hull_b
    prop pr_hull_raised_r = 0.027451 ~fl.relight
    follow pr_hull_raised_r = fr_hull_raised_r
    prop pr_hull_raised_g = 0.074510 ~fl.relight
    follow pr_hull_raised_g = fr_hull_raised_g
    prop pr_hull_raised_b = 0.066667 ~fl.relight
    follow pr_hull_raised_b = fr_hull_raised_b
    prop pr_well_r = 0.019608 ~fl.relight
    follow pr_well_r = fr_well_r
    prop pr_well_g = 0.164706 ~fl.relight
    follow pr_well_g = fr_well_g
    prop pr_well_b = 0.145098 ~fl.relight
    follow pr_well_b = fr_well_b
    prop pr_trace_dim_r = 0.121569 ~fl.relight
    follow pr_trace_dim_r = fr_trace_dim_r
    prop pr_trace_dim_g = 0.219608 ~fl.relight
    follow pr_trace_dim_g = fr_trace_dim_g
    prop pr_trace_dim_b = 0.200000 ~fl.relight
    follow pr_trace_dim_b = fr_trace_dim_b
    prop pr_trace_r = 0.239216 ~fl.relight
    follow pr_trace_r = fr_trace_r
    prop pr_trace_g = 0.415686 ~fl.relight
    follow pr_trace_g = fr_trace_g
    prop pr_trace_b = 0.376471 ~fl.relight
    follow pr_trace_b = fr_trace_b
    prop pr_trace_lit_r = 0.423529 ~fl.relight
    follow pr_trace_lit_r = fr_trace_lit_r
    prop pr_trace_lit_g = 0.788235 ~fl.relight
    follow pr_trace_lit_g = fr_trace_lit_g
    prop pr_trace_lit_b = 0.682353 ~fl.relight
    follow pr_trace_lit_b = fr_trace_lit_b
    prop pr_phos_r = 0.498039 ~fl.relight
    follow pr_phos_r = fr_phos_r
    prop pr_phos_g = 0.811765 ~fl.relight
    follow pr_phos_g = fr_phos_g
    prop pr_phos_b = 0.713725 ~fl.relight
    follow pr_phos_b = fr_phos_b
    prop pr_phos_fill_r = 0.090196 ~fl.relight
    follow pr_phos_fill_r = fr_phos_fill_r
    prop pr_phos_fill_g = 0.603922 ~fl.relight
    follow pr_phos_fill_g = fr_phos_fill_g
    prop pr_phos_fill_b = 0.533333 ~fl.relight
    follow pr_phos_fill_b = fr_phos_fill_b
    prop pr_ember_r = 0.878431 ~fl.relight
    follow pr_ember_r = fr_ember_r
    prop pr_ember_g = 0.482353 ~fl.relight
    follow pr_ember_g = fr_ember_g
    prop pr_ember_b = 0.180392 ~fl.relight
    follow pr_ember_b = fr_ember_b
    prop pr_ember_fill_r = 0.823529 ~fl.relight
    follow pr_ember_fill_r = fr_ember_fill_r
    prop pr_ember_fill_g = 0.411765 ~fl.relight
    follow pr_ember_fill_g = fr_ember_fill_g
    prop pr_ember_fill_b = 0.117647 ~fl.relight
    follow pr_ember_fill_b = fr_ember_fill_b
    prop pr_flare_r = 0.956863 ~fl.relight
    follow pr_flare_r = fr_flare_r
    prop pr_flare_g = 0.713725 ~fl.relight
    follow pr_flare_g = fr_flare_g
    prop pr_flare_b = 0.235294 ~fl.relight
    follow pr_flare_b = fr_flare_b
    prop pr_muted_r = 0.352941 ~fl.relight
    follow pr_muted_r = fr_muted_r
    prop pr_muted_g = 0.541176 ~fl.relight
    follow pr_muted_g = fr_muted_g
    prop pr_muted_b = 0.494118 ~fl.relight
    follow pr_muted_b = fr_muted_b
    prop pr_ink_r = 0.015686 ~fl.relight
    follow pr_ink_r = fr_ink_r
    prop pr_ink_g = 0.129412 ~fl.relight
    follow pr_ink_g = fr_ink_g
    prop pr_ink_b = 0.113725 ~fl.relight
    follow pr_ink_b = fr_ink_b
    prop pr_steel_900_r = 0.082353 ~fl.relight
    follow pr_steel_900_r = fr_steel_900_r
    prop pr_steel_900_g = 0.098039 ~fl.relight
    follow pr_steel_900_g = fr_steel_900_g
    prop pr_steel_900_b = 0.105882 ~fl.relight
    follow pr_steel_900_b = fr_steel_900_b
    prop pr_steel_700_r = 0.164706 ~fl.relight
    follow pr_steel_700_r = fr_steel_700_r
    prop pr_steel_700_g = 0.192157 ~fl.relight
    follow pr_steel_700_g = fr_steel_700_g
    prop pr_steel_700_b = 0.203922 ~fl.relight
    follow pr_steel_700_b = fr_steel_700_b
    prop pr_steel_500_r = 0.290196 ~fl.relight
    follow pr_steel_500_r = fr_steel_500_r
    prop pr_steel_500_g = 0.329412 ~fl.relight
    follow pr_steel_500_g = fr_steel_500_g
    prop pr_steel_500_b = 0.349020 ~fl.relight
    follow pr_steel_500_b = fr_steel_500_b
    prop pr_steel_300_r = 0.545098 ~fl.relight
    follow pr_steel_300_r = fr_steel_300_r
    prop pr_steel_300_g = 0.592157 ~fl.relight
    follow pr_steel_300_g = fr_steel_300_g
    prop pr_steel_300_b = 0.611765 ~fl.relight
    follow pr_steel_300_b = fr_steel_300_b
    prop pr_engrave_r = 0.603922 ~fl.relight
    follow pr_engrave_r = fr_engrave_r
    prop pr_engrave_g = 0.650980 ~fl.relight
    follow pr_engrave_g = fr_engrave_g
    prop pr_engrave_b = 0.670588 ~fl.relight
    follow pr_engrave_b = fr_engrave_b

    // The islands' semantic tokens, which theme/tokens defines over these facts.
    fact c_bg_primary_r = 0.062745
    fact c_bg_primary_g = 0.078431
    fact c_bg_primary_b = 0.086275
    fact c_bg_secondary_r = 0.086275
    fact c_bg_secondary_g = 0.105882
    fact c_bg_secondary_b = 0.117647
    fact c_surface_primary_r = 0.098039
    fact c_surface_primary_g = 0.121569
    fact c_surface_primary_b = 0.133333
    fact c_surface_elevated_r = 0.133333
    fact c_surface_elevated_g = 0.160784
    fact c_surface_elevated_b = 0.176471
    fact c_border_subtle_r = 0.172549
    fact c_border_subtle_g = 0.207843
    fact c_border_subtle_b = 0.223529
    fact c_fg_primary_r = 0.890196
    fact c_fg_primary_g = 0.913725
    fact c_fg_primary_b = 0.921569
    fact c_fg_secondary_r = 0.639216
    fact c_fg_secondary_g = 0.690196
    fact c_fg_secondary_b = 0.709804
    fact c_fg_muted_r = 0.541176
    fact c_fg_muted_g = 0.592157
    fact c_fg_muted_b = 0.611765
    fact c_accent_primary_r = 0.650980
    fact c_accent_primary_g = 0.952941
    fact c_accent_primary_b = 0.819608
    fact c_accent_secondary_r = 1.000000
    fact c_accent_secondary_g = 0.572549
    fact c_accent_secondary_b = 0.372549
    fact c_status_ok_r = 0.650980
    fact c_status_ok_g = 0.952941
    fact c_status_ok_b = 0.819608
    fact c_status_error_r = 1.000000
    fact c_status_error_g = 0.572549
    fact c_status_error_b = 0.372549
    fact c_focus_ring_r = 0.650980
    fact c_focus_ring_g = 0.952941
    fact c_focus_ring_b = 0.819608
    fact c_selection_bg_r = 0.164706
    fact c_selection_bg_g = 0.227451
    fact c_selection_bg_b = 0.211765
    // What theme/ferrolume reads for its geometry; the studio uses the colour, not the bar's
    // strip, so these are only the values the tokens are defined against.
    fact st_offset = 0
    fact st_notch = false
    fact bar_rail = true
    fact st_height = 30
    fact st_radius = 8
    fact st_res = 46
    fact st_glow = 1

    // ── The player (docs/PLAYER.md) ─────────────────────────────
    // What mpd (or another player, in remote) is doing, as the logic reads it with mpc.
    fact pl_open = 0
    fact pl_cx = -1
    fact pl_top = 48
    fact src: library | remote = library
    fact mpd_on = false
    fact has_remote = false
    fact pstate: stopped | playing | paused = stopped
    fact progress = 0
    fact vol = 50
    fact vol_on = true
    fact rnd = false
    fact rpt = false
    fact sgl = false
    fact has_song = false
    fact cover_on = false
    fact cover_tint = false
    text t_title = ""
    text t_artist = ""
    text t_album = ""
    text t_meta = ""
    text t_elapsed = "0:00"
    text t_total = "0:00"
    text t_cover = ""
    text t_remote = ""
    text t_status = ""
    image cover = from t_cover, 480, 480
    // the queue's page: nine rows, the playing one lit
    model queue max 9 { pos: number; title: text; artist: text; time: text; current: bool; n: number }
    fact q_count = 0
    fact q_page = 0
    fact q_pages = 1
    fact pane: queue | library | lyrics | players | eq = queue
    // the library's page: what level it is at (0 artists · 1 albums · 2 songs · 3 a search)
    model librows max 9 { name: text; sub: text; n: number; k: number; song: bool; thumb: bool; has_art: bool; art: image 64, 64; time: text }
    // the grid: albums as covers (a cover with none has the palette's two tones and its initials)
    model albums max 9 { name: text; sub: text; k: number; n: number; has_art: bool; art: image 256, 256; ini: text
                         ar: number; ag: number; ab: number; br: number; bg: number; bb: number }
    fact lib_grid = true
    fact lib_group = 0            // 0 albums · 1 artists · 2 genres · 3 songs
    text lib_sort = "ARTIST"
    fact lib_count = 0
    fact lib_page = 0
    fact lib_pages = 1
    fact lib_level = 0
    text lib_where = "ARTISTS"
    text lib_query = ""
    // the search has the caret: the letter keys stand down (they would take the letters)
    fact typing = false
    // the waveform (a picture ffmpeg makes once per song), and full screen
    text t_wave = ""
    fact wave_on = false
    image wave = from t_wave, 720, 96
    // its size: the mini card under the bar's icon, the panel, or the whole screen (not `full`: a
    // word of the language, which a comparison would not read as the value)
    fact size: mini | panel | cinema = panel
    // the lyrics: the lines round the one being sung (the lit one third from the top)
    model lyr max 9 { text: text; cur: bool; dist: number; t: number; n: number }
    fact lyr_on = false
    fact lyr_synced = false
    text lyr_note = ""
    text lyr_offset = "ON TIME"   // the song's nudge, as the lyrics pane shows it
    // cava's 48 bands (the ring round the record)
    fact nv0 = 0.03
    fact nv1 = 0.03
    fact nv2 = 0.03
    fact nv3 = 0.03
    fact nv4 = 0.03
    fact nv5 = 0.03
    fact nv6 = 0.03
    fact nv7 = 0.03
    fact nv8 = 0.03
    fact nv9 = 0.03
    fact nv10 = 0.03
    fact nv11 = 0.03
    fact nv12 = 0.03
    fact nv13 = 0.03
    fact nv14 = 0.03
    fact nv15 = 0.03
    fact nv16 = 0.03
    fact nv17 = 0.03
    fact nv18 = 0.03
    fact nv19 = 0.03
    fact nv20 = 0.03
    fact nv21 = 0.03
    fact nv22 = 0.03
    fact nv23 = 0.03
    // while the arm is carried, the angle it is at (degrees from its rest)
    fact arm_drag = false
    fact arm_at = 0

    event pl_toggle ->       // to the logic: play / pause
    event pl_next ->
    event pl_prev ->
    event pl_seek ->         // to the logic: the fraction of the song × 1000
    event pl_vol ->          // to the logic: the volume 0 … 100
    event pl_rnd ->
    event pl_rpt ->
    event pl_sgl ->
    event pl_play ->         // to the logic: play the queue's song at this position
    event pl_del ->          // to the logic: take the song at this position out of the queue
    event pl_qpage ->        // to the logic: -1 / 1 a page of the queue
    event pl_clear ->        // to the logic: empty the queue
    event pl_src ->          // to the logic: 0 the library (mpd) · 1 the remote (whatever else plays)
    event pl_close ->
    event pl_pane ->         // to the logic: 0 the queue · 1 the library · 2 the lyrics
    event lib_open ->        // to the logic: go into the row (an artist, an album) or play it (a song)
    event lib_play ->        // to the logic: the row, now (the queue becomes it)
    event lib_add ->         // to the logic: the row, added to the queue
    event lib_back ->        // to the logic: up a level
    event lib_page ->        // to the logic: -1 / 1 a page
    event lib_group ->       // to the logic: 0 albums · 1 artists · 2 genres · 3 songs
    event lib_sort ->        // to the logic: the next sort
    event lyr_seek ->        // to the logic: go to this line (its time × 10)
    event pl_tint ->         // to the logic: colours from the album cover, or the shell's again
    event pl_full ->         // to the logic: full screen, or back to the panel
    event eq_toggle ->       // to the logic: the equaliser on or off
    event eq_band ->         // to the logic: 100 · band + dB + 12
    event eq_pre ->          // to the logic: the preamp's dB + 12
    event eq_knob ->         // to the logic: 100 · knob (1 low · 2 mid · 3 high) + dB + 12
    event eq_preset ->       // to the logic: a preset chip's k
    event video_toggle ->    // to the logic: the song's video in the view's box, or back to the music
    event video_stop ->      // to the logic: the video closes (a new size or view)
    event pl_view ->         // to the logic: 0 the deck · 1 the stage · 2 the rack
    event pl_cue ->          // to the logic: back to the last carried-to point, else the start
    event viz_next ->        // to the logic: the next visualiser style for a place (0 mini · 1 the deck · 2 full screen)
    event pl_size ->         // to the logic: -1 a press outside · -2 Escape · 1 the panel (OPEN PLAYER) · 2 full screen
    event lyr_nudge ->       // to the logic: -1 / 1 the song's lyrics half a second later / earlier
    event lyr_scroll ->      // to the logic: the wheel over plain (unsynced) lyrics

    spring pl.ext = 900, 51
    spring pl.level = 1200, 60
    spring pl.coast = 30, 11      // the record coasting to a stop, and spinning up
    spring pl.arm = 160, 26
    prop pl_a = 0 ~pl.ext
    prop mn_a = 0 ~pl.ext
    follow mn_a = if(pl_open > 0.5 and size == mini, 1, 0)
    on change pl_open while pl_open { pl_a: 1 ~pl.ext }
    on change pl_open while not pl_open { pl_a: 0 ~pl.ext }
    // 33⅓ rpm is 200° a second; paused, the platter slows to a stop rather than freezing
    prop spd = 0 ~pl.coast
    follow spd = if(pstate == playing, 200 * (1 + pitch / 100) * if(rpm45, 1.35, 1), 0)
    prop vang = 0
    spin vang by spd
    // the progress glides between the logic's readings
    prop prg = 0 ~500ms
    follow prg = progress
    // the tonearm: parked while stopped, on the record otherwise, following the song (or the hand)
    prop arm = 0 ~pl.arm
    follow arm = if(arm_drag, arm_at, if(pstate == stopped, 0, 20 + 20 * clamp(progress, 0, 1)))
    // the visualisers' sixteen bands (shell/ui/viz.plm reads vb0…vb15): cava's 24, thinned evenly
    let vb0 = vp0
    let vb1 = vp1
    let vb2 = vp3
    let vb3 = vp4
    let vb4 = vp6
    let vb5 = vp7
    let vb6 = vp9
    let vb7 = vp10
    let vb8 = vp12
    let vb9 = vp13
    let vb10 = vp15
    let vb11 = vp16
    let vb12 = vp18
    let vb13 = vp19
    let vb14 = vp21
    let vb15 = vp23
    // each place's visualiser (lib/vizbands: 0 spectrum · 1 mirror · 2 ring · 3 aurora · 4 led · 5 orbit · 6 off)
    fact viz_mini = 2
    fact viz_deck = 2
    fact viz_full = 2
    fact viz_stage = 3
    fact viz_rack = 4
    // the view (the music player overhaul): the DJ deck, the cover stage, the instrument rack
    fact view: deck | stage | rack = deck
    // the music video (an mpv window under this overlay, in the box the scene leaves undrawn): on,
    // still looking, and its box in screen pixels (set by the press that asks for it)
    fact video_on = false
    fact video_tools = true      // mpv and yt-dlp are there
    text video_why = ""
    fact eq_ok = true            // EasyEffects is there
    fact viz_still = false       // reduced motion or the saver: the visualisers rest
    fact video_busy = false
    fact video_ok = true
    fact vbx = 0
    fact vby = 0
    fact vbw = 640
    fact vbh = 360
    // the deck's own: the record at 33⅓ or 45, its pitch (±8 %: the spin, not the music)
    fact rpm45 = false
    fact pitch = 0
    // the rack's: the file's format, and the EQ's three knobs (the equaliser sets them)
    text t_audio = ""
    fact eq_on = false
    // the equaliser's ten bands and preamp (dB), its preset, and the presets to pick from
    fact eq_b0 = 0
    fact eq_b1 = 0
    fact eq_b2 = 0
    fact eq_b3 = 0
    fact eq_b4 = 0
    fact eq_b5 = 0
    fact eq_b6 = 0
    fact eq_b7 = 0
    fact eq_b8 = 0
    fact eq_b9 = 0
    fact eq_pre = 0
    text eq_name = "FLAT"
    text eq_save = ""
    model eqchips max 12 { name: text; k: number; on: bool; mine: bool; n: number }
    fact eq_lo = 0
    fact eq_mid = 0
    fact eq_hi = 0
    prop vp0 = 0.03 ~pl.level
    follow vp0 = nv0
    prop vp1 = 0.03 ~pl.level
    follow vp1 = nv1
    prop vp2 = 0.03 ~pl.level
    follow vp2 = nv2
    prop vp3 = 0.03 ~pl.level
    follow vp3 = nv3
    prop vp4 = 0.03 ~pl.level
    follow vp4 = nv4
    prop vp5 = 0.03 ~pl.level
    follow vp5 = nv5
    prop vp6 = 0.03 ~pl.level
    follow vp6 = nv6
    prop vp7 = 0.03 ~pl.level
    follow vp7 = nv7
    prop vp8 = 0.03 ~pl.level
    follow vp8 = nv8
    prop vp9 = 0.03 ~pl.level
    follow vp9 = nv9
    prop vp10 = 0.03 ~pl.level
    follow vp10 = nv10
    prop vp11 = 0.03 ~pl.level
    follow vp11 = nv11
    prop vp12 = 0.03 ~pl.level
    follow vp12 = nv12
    prop vp13 = 0.03 ~pl.level
    follow vp13 = nv13
    prop vp14 = 0.03 ~pl.level
    follow vp14 = nv14
    prop vp15 = 0.03 ~pl.level
    follow vp15 = nv15
    prop vp16 = 0.03 ~pl.level
    follow vp16 = nv16
    prop vp17 = 0.03 ~pl.level
    follow vp17 = nv17
    prop vp18 = 0.03 ~pl.level
    follow vp18 = nv18
    prop vp19 = 0.03 ~pl.level
    follow vp19 = nv19
    prop vp20 = 0.03 ~pl.level
    follow vp20 = nv20
    prop vp21 = 0.03 ~pl.level
    follow vp21 = nv21
    prop vp22 = 0.03 ~pl.level
    follow vp22 = nv22
    prop vp23 = 0.03 ~pl.level
    follow vp23 = nv23

    // A round control: a ring, lit while on, a glyph drawn by the caller.
    component PRound(x: number, y: number, r: number, lit: number, tone: color, hot: number) {
        size: r * 2, r * 2
        group {
            glow: 10, 45% * lit, tone
            ellipse { at: x, y; radius: r; color: mix(fl.hull_raised, tone, 0.06 + hot * 0.12 + lit * 0.2) }
        }
        ellipse { at: x, y; radius: r; stroke: 1.3; color: mix(fl.trace, tone, 0.3 + hot * 0.5 + lit * 0.5) }
    }

    // A word that is a switch: lit while on.
    component PChip(x: number, y: number, w: number, word: text, on: bool, hot: number) {
        size: w, 22
        box { from: x, y; size: w, 22; corner: 11; color: mix(fl.hull_raised, fl.phos, if(on, 0.22, 0) + hot * 0.1) }
        box { from: x, y; size: w, 22; corner: 11; stroke: 1; color: if(on, fl.phos, mix(fl.trace, fl.phos, hot * 0.6)) }
        text word { at: x + w / 2, y + 11; anchor: center; size: 7.5; weight: 700; family: "Share Tech Mono"; color: if(on, fl.phos, fl.muted) }
    }

    surface player {
        size: full, full
        anchor: top
        reserve: -1
        level: overlay
        keyboard: exclusive while size != mini

        let sw = screen.width
        let sh = screen.height
        let pw = min(sw - 20, 1200)
        let ph = 624
        let px = clamp(if(pl_cx > 0, pl_cx - pw / 2, (sw - pw) / 2), 10, sw - pw - 10)
        let py = pl_top
        // the turntable's plinth, the record and the tonearm's pivot (lib/player: the arm sets
        // down on the outer groove at 20° and reaches the label at 40°)
        let rcx = 230
        let rcy = 64 + (ph - 84) / 2
        let rr = 162
        let rl = 64
        let apx = rcx + 190
        let apy = rcy - 144
        let alen = 284
        // the middle column and the pane
        let mx = 470
        let mw = 330
        let qx = 830
        let qw = pw - qx - 18

        include "player/mini.plm"

        include "player/panel.plm"

        include "player/full.plm"
    }

    on key Escape while typing { typing = false; blur }
    on key Escape while not typing and video_on { emit video_stop }
    on key Escape while not typing and not video_on { emit pl_size(-2) }
    on change size while video_on { emit video_stop }
    on change view while video_on { emit video_stop }
    on key f while not typing { emit pl_full }
    on key space while not typing { emit pl_toggle }
    on key Left while not typing { emit pl_seek(-5) }
    on key Right while not typing { emit pl_seek(-6) }
    on key Shift+Left while not typing { emit pl_seek(-7) }
    on key Shift+Right while not typing { emit pl_seek(-8) }
    on key Up while not typing { emit pl_vol(clamp(vol + 5, 0, 100)) }
    on key Down while not typing { emit pl_vol(clamp(vol - 5, 0, 100)) }
    on key n while not typing { emit pl_next }
    on key p while not typing { emit pl_prev }
    on key s while not typing { emit pl_rnd }
    on key r while not typing { emit pl_rpt }
    on key q while not typing { emit pl_pane(0) }
    on key l while not typing { emit pl_pane(1) }
    on key y while not typing { emit pl_pane(2) }
    on key slash while not typing { emit pl_pane(1); typing = true; focus lib_query }
    on submit lib_query { typing = false; blur }
}
