language 0.4
import "theme/tokens.plm"
import "theme/ferrolume.plm"
import "ui/loom.plm"
import "ui/board.plm"

// mooi's board — a Kanban board of its own (D52, D64). A program like the settings window and the
// wallpaper studio: a full-screen surface that holds the keyboard for itself, so the bar's scene
// no longer carries its facts, its models, its surface or its key bindings. The board logic is
// still shell/board.luau over lib/board; `mooi-board.luau` starts it, paints the shell's colours
// and puts it away again. `board.json` is mooi's own (bin/mooi links the data folder).
//
// The entrance is the one it had in the bar (a bar across, then the board drops open around it);
// a press outside the board, its × or Escape closes it, and closing gives the keyboard back to
// whatever the compositor puts under it.

scene Board {
    permissions {
        run: "wl-copy", "date", "pleamar"
        services: "files", "files.write"
    }

    // The same facts and springs the bar wears: the logic paints them from palette.json, and
    // the studio re-lights with the desktop when the palette changes after an apply.
    fact fr_ground_r = 0.000000
    fact fr_ground_g = 0.000000
    fact fr_ground_b = 0.000000
    fact fr_hull_r = 0.015686
    fact fr_hull_g = 0.035294
    fact fr_hull_b = 0.031373
    fact fr_hull_raised_r = 0.027451
    fact fr_hull_raised_g = 0.074510
    fact fr_hull_raised_b = 0.066667
    fact fr_well_r = 0.019608
    fact fr_well_g = 0.164706
    fact fr_well_b = 0.145098
    fact fr_trace_dim_r = 0.121569
    fact fr_trace_dim_g = 0.219608
    fact fr_trace_dim_b = 0.200000
    fact fr_trace_r = 0.239216
    fact fr_trace_g = 0.415686
    fact fr_trace_b = 0.376471
    fact fr_trace_lit_r = 0.423529
    fact fr_trace_lit_g = 0.788235
    fact fr_trace_lit_b = 0.682353
    fact fr_phos_r = 0.498039
    fact fr_phos_g = 0.811765
    fact fr_phos_b = 0.713725
    fact fr_phos_fill_r = 0.090196
    fact fr_phos_fill_g = 0.603922
    fact fr_phos_fill_b = 0.533333
    fact fr_ember_r = 0.878431
    fact fr_ember_g = 0.482353
    fact fr_ember_b = 0.180392
    fact fr_ember_fill_r = 0.823529
    fact fr_ember_fill_g = 0.411765
    fact fr_ember_fill_b = 0.117647
    fact fr_flare_r = 0.956863
    fact fr_flare_g = 0.713725
    fact fr_flare_b = 0.235294
    fact fr_muted_r = 0.352941
    fact fr_muted_g = 0.541176
    fact fr_muted_b = 0.494118
    fact fr_ink_r = 0.015686
    fact fr_ink_g = 0.129412
    fact fr_ink_b = 0.113725
    fact fr_steel_900_r = 0.082353
    fact fr_steel_900_g = 0.098039
    fact fr_steel_900_b = 0.105882
    fact fr_steel_700_r = 0.164706
    fact fr_steel_700_g = 0.192157
    fact fr_steel_700_b = 0.203922
    fact fr_steel_500_r = 0.290196
    fact fr_steel_500_g = 0.329412
    fact fr_steel_500_b = 0.349020
    fact fr_steel_300_r = 0.545098
    fact fr_steel_300_g = 0.592157
    fact fr_steel_300_b = 0.611765
    fact fr_engrave_r = 0.603922
    fact fr_engrave_g = 0.650980
    fact fr_engrave_b = 0.670588
    prop pr_ground_r = 0.000000 ~fl.relight
    follow pr_ground_r = fr_ground_r
    prop pr_ground_g = 0.000000 ~fl.relight
    follow pr_ground_g = fr_ground_g
    prop pr_ground_b = 0.000000 ~fl.relight
    follow pr_ground_b = fr_ground_b
    prop pr_hull_r = 0.015686 ~fl.relight
    follow pr_hull_r = fr_hull_r
    prop pr_hull_g = 0.035294 ~fl.relight
    follow pr_hull_g = fr_hull_g
    prop pr_hull_b = 0.031373 ~fl.relight
    follow pr_hull_b = fr_hull_b
    prop pr_hull_raised_r = 0.027451 ~fl.relight
    follow pr_hull_raised_r = fr_hull_raised_r
    prop pr_hull_raised_g = 0.074510 ~fl.relight
    follow pr_hull_raised_g = fr_hull_raised_g
    prop pr_hull_raised_b = 0.066667 ~fl.relight
    follow pr_hull_raised_b = fr_hull_raised_b
    prop pr_well_r = 0.019608 ~fl.relight
    follow pr_well_r = fr_well_r
    prop pr_well_g = 0.164706 ~fl.relight
    follow pr_well_g = fr_well_g
    prop pr_well_b = 0.145098 ~fl.relight
    follow pr_well_b = fr_well_b
    prop pr_trace_dim_r = 0.121569 ~fl.relight
    follow pr_trace_dim_r = fr_trace_dim_r
    prop pr_trace_dim_g = 0.219608 ~fl.relight
    follow pr_trace_dim_g = fr_trace_dim_g
    prop pr_trace_dim_b = 0.200000 ~fl.relight
    follow pr_trace_dim_b = fr_trace_dim_b
    prop pr_trace_r = 0.239216 ~fl.relight
    follow pr_trace_r = fr_trace_r
    prop pr_trace_g = 0.415686 ~fl.relight
    follow pr_trace_g = fr_trace_g
    prop pr_trace_b = 0.376471 ~fl.relight
    follow pr_trace_b = fr_trace_b
    prop pr_trace_lit_r = 0.423529 ~fl.relight
    follow pr_trace_lit_r = fr_trace_lit_r
    prop pr_trace_lit_g = 0.788235 ~fl.relight
    follow pr_trace_lit_g = fr_trace_lit_g
    prop pr_trace_lit_b = 0.682353 ~fl.relight
    follow pr_trace_lit_b = fr_trace_lit_b
    prop pr_phos_r = 0.498039 ~fl.relight
    follow pr_phos_r = fr_phos_r
    prop pr_phos_g = 0.811765 ~fl.relight
    follow pr_phos_g = fr_phos_g
    prop pr_phos_b = 0.713725 ~fl.relight
    follow pr_phos_b = fr_phos_b
    prop pr_phos_fill_r = 0.090196 ~fl.relight
    follow pr_phos_fill_r = fr_phos_fill_r
    prop pr_phos_fill_g = 0.603922 ~fl.relight
    follow pr_phos_fill_g = fr_phos_fill_g
    prop pr_phos_fill_b = 0.533333 ~fl.relight
    follow pr_phos_fill_b = fr_phos_fill_b
    prop pr_ember_r = 0.878431 ~fl.relight
    follow pr_ember_r = fr_ember_r
    prop pr_ember_g = 0.482353 ~fl.relight
    follow pr_ember_g = fr_ember_g
    prop pr_ember_b = 0.180392 ~fl.relight
    follow pr_ember_b = fr_ember_b
    prop pr_ember_fill_r = 0.823529 ~fl.relight
    follow pr_ember_fill_r = fr_ember_fill_r
    prop pr_ember_fill_g = 0.411765 ~fl.relight
    follow pr_ember_fill_g = fr_ember_fill_g
    prop pr_ember_fill_b = 0.117647 ~fl.relight
    follow pr_ember_fill_b = fr_ember_fill_b
    prop pr_flare_r = 0.956863 ~fl.relight
    follow pr_flare_r = fr_flare_r
    prop pr_flare_g = 0.713725 ~fl.relight
    follow pr_flare_g = fr_flare_g
    prop pr_flare_b = 0.235294 ~fl.relight
    follow pr_flare_b = fr_flare_b
    prop pr_muted_r = 0.352941 ~fl.relight
    follow pr_muted_r = fr_muted_r
    prop pr_muted_g = 0.541176 ~fl.relight
    follow pr_muted_g = fr_muted_g
    prop pr_muted_b = 0.494118 ~fl.relight
    follow pr_muted_b = fr_muted_b
    prop pr_ink_r = 0.015686 ~fl.relight
    follow pr_ink_r = fr_ink_r
    prop pr_ink_g = 0.129412 ~fl.relight
    follow pr_ink_g = fr_ink_g
    prop pr_ink_b = 0.113725 ~fl.relight
    follow pr_ink_b = fr_ink_b
    prop pr_steel_900_r = 0.082353 ~fl.relight
    follow pr_steel_900_r = fr_steel_900_r
    prop pr_steel_900_g = 0.098039 ~fl.relight
    follow pr_steel_900_g = fr_steel_900_g
    prop pr_steel_900_b = 0.105882 ~fl.relight
    follow pr_steel_900_b = fr_steel_900_b
    prop pr_steel_700_r = 0.164706 ~fl.relight
    follow pr_steel_700_r = fr_steel_700_r
    prop pr_steel_700_g = 0.192157 ~fl.relight
    follow pr_steel_700_g = fr_steel_700_g
    prop pr_steel_700_b = 0.203922 ~fl.relight
    follow pr_steel_700_b = fr_steel_700_b
    prop pr_steel_500_r = 0.290196 ~fl.relight
    follow pr_steel_500_r = fr_steel_500_r
    prop pr_steel_500_g = 0.329412 ~fl.relight
    follow pr_steel_500_g = fr_steel_500_g
    prop pr_steel_500_b = 0.349020 ~fl.relight
    follow pr_steel_500_b = fr_steel_500_b
    prop pr_steel_300_r = 0.545098 ~fl.relight
    follow pr_steel_300_r = fr_steel_300_r
    prop pr_steel_300_g = 0.592157 ~fl.relight
    follow pr_steel_300_g = fr_steel_300_g
    prop pr_steel_300_b = 0.611765 ~fl.relight
    follow pr_steel_300_b = fr_steel_300_b
    prop pr_engrave_r = 0.603922 ~fl.relight
    follow pr_engrave_r = fr_engrave_r
    prop pr_engrave_g = 0.650980 ~fl.relight
    follow pr_engrave_g = fr_engrave_g
    prop pr_engrave_b = 0.670588 ~fl.relight
    follow pr_engrave_b = fr_engrave_b

    // The islands' semantic tokens, which theme/tokens defines over these facts.
    fact c_bg_primary_r = 0.062745
    fact c_bg_primary_g = 0.078431
    fact c_bg_primary_b = 0.086275
    fact c_bg_secondary_r = 0.086275
    fact c_bg_secondary_g = 0.105882
    fact c_bg_secondary_b = 0.117647
    fact c_surface_primary_r = 0.098039
    fact c_surface_primary_g = 0.121569
    fact c_surface_primary_b = 0.133333
    fact c_surface_elevated_r = 0.133333
    fact c_surface_elevated_g = 0.160784
    fact c_surface_elevated_b = 0.176471
    fact c_border_subtle_r = 0.172549
    fact c_border_subtle_g = 0.207843
    fact c_border_subtle_b = 0.223529
    fact c_fg_primary_r = 0.890196
    fact c_fg_primary_g = 0.913725
    fact c_fg_primary_b = 0.921569
    fact c_fg_secondary_r = 0.639216
    fact c_fg_secondary_g = 0.690196
    fact c_fg_secondary_b = 0.709804
    fact c_fg_muted_r = 0.541176
    fact c_fg_muted_g = 0.592157
    fact c_fg_muted_b = 0.611765
    fact c_accent_primary_r = 0.650980
    fact c_accent_primary_g = 0.952941
    fact c_accent_primary_b = 0.819608
    fact c_accent_secondary_r = 1.000000
    fact c_accent_secondary_g = 0.572549
    fact c_accent_secondary_b = 0.372549
    fact c_status_ok_r = 0.650980
    fact c_status_ok_g = 0.952941
    fact c_status_ok_b = 0.819608
    fact c_status_error_r = 1.000000
    fact c_status_error_g = 0.572549
    fact c_status_error_b = 0.372549
    fact c_focus_ring_r = 0.650980
    fact c_focus_ring_g = 0.952941
    fact c_focus_ring_b = 0.819608
    fact c_selection_bg_r = 0.164706
    fact c_selection_bg_g = 0.227451
    fact c_selection_bg_b = 0.211765
    // What theme/ferrolume reads for its geometry; the studio uses the colour, not the bar's
    // strip, so these are only the values the tokens are defined against.
    fact st_offset = 0
    fact st_notch = false
    fact bar_rail = true
    fact st_height = 30
    fact st_radius = 8
    fact st_res = 46

    // ── The board (D52): a Kanban board (shell/board.luau, lib/board) ────────
    // A program of its own (D64): the columns and cards are laid out here by the same logic, and
    // the scene draws only what is seen. `board_in` is its entrance and the way out.
    fact board_in = 0
    // The columns and the cards in view, as the logic lays them out (content coordinates); the
    // chosen card's details for the pane; what a carried card is over (`kb_g*` beside `kb_over` and
    // `kb_drop`, never packed into one number) and where it would land (`kb_t*`).
    model kcols max 6 { id: number; title: text; x: number; w: number; n: number; wip: number; over: bool; sel: bool; chosen: bool; more_up: bool; more_down: bool; done: bool }
    model kcards max 80 { id: number; col: number; x: number; y: number; w: number; h: number; title: text; note: text; noted: bool; tag: number; due: text; due_st: number; dated: bool; done: bool; sel: bool; age: text }
    fact kb_sel = -1
    fact kb_selcol = -1
    fact kb_d_has = false
    fact kb_d_tag = 0
    fact kb_d_due_st = 0
    fact kb_d_done = false
    fact kb_col_wip = 0
    fact kb_col_empty = false
    fact kb_col_last = false
    fact kb_cols_full = false
    fact kb_count = 0
    fact kb_late = 0
    fact kb_due_today = 0
    fact kb_archived = 0
    fact kb_done_n = 0
    fact kb_tagf = 0
    fact kb_filtering = false
    fact kb_can_undo = false
    fact kb_saying = false
    fact kb_drafting = false
    fact kb_press = -1
    fact kb_drag = -1
    fact kb_dx = 0
    fact kb_dy = 0
    fact kb_gx = 0
    fact kb_gy = 0
    fact kb_tx = 0
    fact kb_tw = 0
    fact kb_ty = -1
    text kb_d_due = ""
    text kb_d_meta = ""
    text kb_col_title = ""
    text kb_said = ""
    text kb_new = ""
    text kb_title = ""
    text kb_note = ""
    text kb_search = ""
    text kb_colname = ""
    fact st_glow = 1                      // the theme's finish (lib/style, set by the logic)
    event close_board ->      // to the logic: put the board away (a press outside, its × or Escape)

    // The entrance: a bar across, then the board drops open around it (as it did in the bar's scene).
    spring bd.ext = 900, 51
    spring bd.unf = 700, 48
    prop bu_a = 0 ~bd.ext
    prop bu_b = 0 ~bd.unf
    on change board_in while board_in { bu_a: 1 ~bd.ext; bu_b: 1 ~bd.unf after 100ms }
    on change board_in while not board_in { bu_a: 0 ~bd.ext; bu_b: 0 ~bd.unf }

    event kb_pick ->           // to the logic: card id chosen
    event kb_pickcol ->        // to the logic: column id chosen
    event kb_nav ->            // to the logic: choose, 1 left · 2 right · 3 up · 4 down
    event kb_step ->           // to the logic: the chosen card moved, 1 left · 2 right · 3 up · 4 down
    event kb_tag ->            // to the logic: the chosen card's tag (0 … 5)
    event kb_due ->            // to the logic: its due day, 0 none · 1 today · 2 tomorrow · 3 a week
    event kb_over ->           // to the logic: card id carried over (kb_gx, kb_gy)
    event kb_drop ->           // to the logic: card id let go (kb_gx, kb_gy)
    event kb_del ->            // to the logic: the chosen card deleted
    event kb_copy ->           // to the logic: the chosen card copied
    event kb_archive ->        // to the logic: what is done, archived
    event kb_undo ->           // to the logic: the last delete or archive taken back
    event kb_addcol ->         // to the logic: a new column
    event kb_wip ->            // to the logic: the chosen column's limit (0 none)
    event kb_colmove ->        // to the logic: the chosen column moved, 0 left · 1 right
    event kb_delcol ->         // to the logic: the chosen column removed (only an empty one)
    event kb_scroll ->         // to the logic: 1000 · column + 10 · wheel + 500
    event kb_filter ->         // to the logic: the tag filter (the same again: none)
    event kb_clearfilter ->    // to the logic: no filter
    event kb_focus_col         // from the logic: the column's name takes the caret
    event kb_plus              // a column's + pressed: it is chosen and the new card's field takes the caret

    // middle — a bar across, then the board drops open around it — and is drawn only while open.
    // Header: how many cards, how many late or due today, search, the tag filter, a new column,
    // archive what is done, undo, close. The columns: each scrolls on its own; a card is chosen
    // with a press and carried with a drag (a line shows where it will land; let go in Done and it
    // is done). The pane on the right: the chosen card (title and note saved as you type, its tag,
    // its due day, a step in any direction, copy, delete) or, with no card chosen, the chosen
    // column (its name, its limit, its place); and always a field for a new card.
    surface board {
        size: full, full
        anchor: top
        reserve: -1
        level: overlay
        // This scene's only surface, so its clause is the scene's: the board has the keyboard for
        // as long as it is up (D64). The bar lets go of its own before it starts this program.
        keyboard: exclusive

        // A press anywhere the board is not closes it (D64): the bar's own outside-press plate is
        // in another program now, so this is the board's.
        zone box baway { from: 0, 0; size: screen.width, screen.height; role: region
                         label: "Close the board"; show: bu_a > 0.004 }
        on press baway { emit close_board }

        let bx = (screen.width - 1240) / 2
        let by = (screen.height - 760) / 2
        let kbl_W = 1220
        let kbl_H = 740
        let kbl_pw = 220 + (kbl_W - 220) * bu_a
        let kbl_ph = 44 + (kbl_H - 44) * bu_b
        let kbl_px = bx + 10 + (kbl_W - kbl_pw) / 2
        let kbl_py = by + 10 + (kbl_H - kbl_ph) / 2
        let kbl_y0 = 60
        let kbl_ch = 636
        let bp_x = 904
        zone box bcatch { from: kbl_px, kbl_py; size: kbl_pw, kbl_ph; show: bu_a > 0.004 }
        group {
            show: bu_a > 0.004
            group {
                glow: 22, 0.35 * st_glow, fl.phos
                Chamfer(kbl_px, kbl_py, kbl_pw, kbl_ph, 16, fl.hull, fl.trace, 0.985, 1.5)
            }
            group {
                clip box { from: kbl_px, kbl_py; size: kbl_pw, kbl_ph }
                group {
                    // The plate is centred on the screen now (D64), so the content goes where the
                    // plate is: a bare 10, 10 drew it at the screen's top-left, and the clip above
                    // cut the head, the column heads and the top cards away.
                    move: kbl_px + 10, kbl_py + 10
                    opacity: min(1, bu_a * 1.3)
                    // ── the head ──
                    text "BOARD" { at: 20, 25; anchor: left center; size: 13; family: "Share Tech Mono"; color: fl.ember }
                    text "{kb_count, 0} CARDS" { at: 86, 25; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.muted }
                    // D86: how much of the board is done, as a meter under the name
                    box { from: 20, 38; size: 140, 3; corner: 1.5; color: fl.ground }
                    group {
                        glow: 5, 0.6 * st_glow, fl.phos
                        box { from: 20, 38; size: 140 * kb_done_n / max(1, kb_count), 3; corner: 1.5; color: fl.phos; show: kb_count > 0 }
                    }
                    text "{kb_done_n * 100 / max(1, kb_count), 0}% DONE" { at: 166, 39; anchor: left center; size: 7; family: "Share Tech Mono"
                                                                           color: fl.trace_lit; show: kb_count > 0 }
                    group {
                        show: kb_late > 0
                        Chamfer(170, 15, 66, 20, 4, fl.ember_fill, fl.ember, 0.9)
                        text "{kb_late, 0} LATE" { at: 203, 25; anchor: center; size: 9; family: "Share Tech Mono"; color: fl.ink }
                    }
                    group {
                        show: kb_due_today > 0
                        Chamfer(if(kb_late > 0, 242, 170), 15, 72, 20, 4, fl.ground, fl.flare, 0.9)
                        text "{kb_due_today, 0} TODAY" { at: if(kb_late > 0, 278, 206), 25; anchor: center; size: 9; family: "Share Tech Mono"; color: fl.flare }
                    }
                    // search
                    Chamfer(330, 11, 230, 28, 6, fl.ground, fl.trace, 1)
                    text "Search cards   Ctrl+F" { at: 342, 25; anchor: left center; size: 11; family: "Exo 2"; color: fl.muted; show: not kb_filtering }
                    input kb_search { at: 342, 17; width: 206; size: 12; family: "Exo 2"; color: fl.phos; selection: fl.well }
                    // the tag filter
                    repeat t in 0..6 {
                        zone box kf.$t { from: 570 + t * 26, 13; size: 24, 24; cursor: pointer; role: toggle; checked: kb_tagf == t and t > 0
                                         label: pick(t > 0, "Every tag", "Only tag {t, 0}") }
                        group { show: t > 0; TagDot(582 + t * 26, 25, t, kb_tagf == t, 6) }
                        on press kf.$t { emit kb_filter(t) }
                    }
                    text "ALL" { at: 582, 25; anchor: center; size: 8; family: "Share Tech Mono"; color: if(kb_tagf == 0, fl.phos, fl.muted) }
                    zone box kclear { from: 732, 13; size: 52, 24; cursor: pointer; role: button; label: "No filter"; show: kb_filtering }
                    text "CLEAR" { at: 758, 25; anchor: center; size: 9; family: "Share Tech Mono"; color: mix(fl.muted, fl.ember, kclear.hover); show: kb_filtering }
                    on press kclear { emit kb_clearfilter }
                    zone box kaddcol { from: 800, 13; size: 96, 24; cursor: pointer; role: button; label: "A new column"; show: not kb_cols_full }
                    group { show: not kb_cols_full; CutButton(800, 15, 96, "+ Column", fl.phos, kaddcol.hover) }
                    on press kaddcol { emit kb_addcol }
                    zone box karch { from: 904, 13; size: 150, 24; cursor: pointer; role: button; label: "Archive the {kb_done_n, 0} done cards"; show: kb_done_n > 0 }
                    group {
                        show: kb_done_n > 0
                        CutButton(904, 15, 150, "Archive done", fl.flare, karch.hover)
                        text "{kb_done_n, 0}" { at: 1046, 25; anchor: right center; size: 9; weight: 700; family: "Exo 2"; color: fl.flare }
                    }
                    on press karch { emit kb_archive }
                    zone box kundo { from: 1062, 13; size: 70, 24; cursor: pointer; role: button; label: "Undo"; show: kb_can_undo }
                    group { show: kb_can_undo; CutButton(1062, 15, 70, "Undo", fl.ember, kundo.hover) }
                    on press kundo { emit kb_undo }
                    zone box kclose { from: 1176, 9; size: 32, 30; cursor: pointer; role: button; label: "Close the board" }
                    line { from: 1185, 17; to: 1199, 31; width: 1.6; color: mix(fl.muted, fl.ember, kclose.hover) }
                    line { from: 1199, 17; to: 1185, 31; width: 1.6; color: mix(fl.muted, fl.ember, kclose.hover) }
                    on press kclose { emit close_board }
                    line { from: 14, 50; to: kbl_W - 14, 50; width: 1; color: fl.trace_dim }

                    group {
                        opacity: bu_b
                        // ── the columns ──
                        for c in kcols { KColumn(c, kbl_y0, kbl_ch, kb_pickcol, kb_plus, kb_scroll) }
                        text "An empty board. Write a card in the pane (Ctrl+N), or send a note from the pad." { at: 452, 340; anchor: center; size: 13; family: "Exo 2"
                             color: fl.muted; show: kb_count < 1 and not kb_filtering }
                        // the cards in view, clipped to the columns' bodies; one being carried is dimmed in place
                        group {
                            clip box { from: 0, kbl_y0 + 44; size: 900, kbl_ch - 46 }
                            for k in kcards {
                                group { opacity: if(kb_drag == k.id, 0.3, 1); KCard(k, 0) }
                                zone box kc { from: k.x, k.y; size: k.w, k.h; cursor: grab; role: item; selected: k.sel; label: "{k.title}" }
                                on press kc { kb_press = k.id; kb_dx = 0; kb_dy = 0 }
                                on drag kc while kb_press == k.id { kb_dx = drag.dx; kb_dy = drag.dy; kb_gx = k.x + k.w / 2 + drag.dx; kb_gy = k.y + 18 + drag.dy
                                                                    kb_drag = if(abs(drag.dx) + abs(drag.dy) > 6, k.id, kb_drag); emit kb_over(k.id) }
                                on release kc while kb_drag == k.id { emit kb_drop(k.id); kb_drag = -1; kb_press = -1 }
                                on release kc while kb_drag != k.id and kb_press == k.id { emit kb_pick(k.id); kb_press = -1 }
                            }
                            // where it will land
                            group {
                                show: kb_drag >= 0 and kb_ty >= 0
                                glow: 8, 0.9 * st_glow, fl.phos
                                box { from: kb_tx + 6, kb_ty - 1.5; size: kb_tw - 12, 3; corner: 1.5; color: fl.phos }
                            }
                        }
                        // the card being carried, lifted, over everything
                        for k in kcards {
                            group { show: kb_drag == k.id; move: kb_dx, kb_dy; KCard(k, 1) }
                        }

                        // ── the pane ──
                        Chamfer(bp_x, kbl_y0, 300, kbl_ch, 10, mix(fl.ground, fl.hull, 0.3), fl.trace_dim, 0.95)
                        // a card
                        group {
                            show: kb_d_has
                            text "CARD" { at: bp_x + 16, kbl_y0 + 20; anchor: left center; size: 11; family: "Share Tech Mono"; color: fl.ember }
                            text "DONE" { at: bp_x + 284, kbl_y0 + 20; anchor: right center; size: 10; family: "Share Tech Mono"; color: fl.phos; show: kb_d_done }
                            text kb_d_meta { at: bp_x + 16, kbl_y0 + 38; anchor: left center; size: 8; family: "Share Tech Mono"; width: 268; lines: 1; color: fl.muted }
                            text "TITLE · F2" { at: bp_x + 16, kbl_y0 + 60; anchor: left center; size: 8; family: "Share Tech Mono"; color: fl.trace_lit }
                            Chamfer(bp_x + 12, kbl_y0 + 68, 276, 30, 6, fl.ground, fl.trace, 1)
                            input kb_title { at: bp_x + 22, kbl_y0 + 75; width: 256; size: 12; family: "Exo 2"; color: fl.phos; selection: fl.well }
                            text "NOTE" { at: bp_x + 16, kbl_y0 + 112; anchor: left center; size: 8; family: "Share Tech Mono"; color: fl.trace_lit }
                            Chamfer(bp_x + 12, kbl_y0 + 120, 276, 30, 6, fl.ground, fl.trace, 1)
                            input kb_note { at: bp_x + 22, kbl_y0 + 127; width: 256; size: 12; family: "Exo 2"; color: fl.trace_lit; selection: fl.well }
                            text "SAVED AS YOU TYPE" { at: bp_x + 284, kbl_y0 + 112; anchor: right center; size: 7; family: "Share Tech Mono"; color: fl.muted }
                            text "TAG · ALT+0–5" { at: bp_x + 16, kbl_y0 + 166; anchor: left center; size: 8; family: "Share Tech Mono"; color: fl.trace_lit }
                            repeat t in 0..6 {
                                zone box kt.$t { from: bp_x + 14 + t * 34, kbl_y0 + 176; size: 28, 28; cursor: pointer; role: toggle; checked: kb_d_tag == t
                                                 label: pick(t > 0, "No tag", "Tag {t, 0}") }
                                TagDot(bp_x + 28 + t * 34, kbl_y0 + 190, t, kb_d_tag == t, 8)
                                on press kt.$t { emit kb_tag(t) }
                            }
                            text "DUE" { at: bp_x + 16, kbl_y0 + 222; anchor: left center; size: 8; family: "Share Tech Mono"; color: fl.trace_lit }
                            text kb_d_due { at: bp_x + 284, kbl_y0 + 222; anchor: right center; size: 9; family: "Share Tech Mono"
                                            color: if(kb_d_due_st > 3.5, fl.ember, if(kb_d_due_st > 2.5, fl.flare, if(kb_d_due_st > 1.5, fl.phos, fl.muted))) }
                            zone box kd0 { from: bp_x + 12, kbl_y0 + 232; size: 64, 20; cursor: pointer; role: button; label: "No due day" }
                            zone box kd1 { from: bp_x + 80, kbl_y0 + 232; size: 64, 20; cursor: pointer; role: button; label: "Due today" }
                            zone box kd2 { from: bp_x + 148, kbl_y0 + 232; size: 70, 20; cursor: pointer; role: button; label: "Due tomorrow" }
                            zone box kd3 { from: bp_x + 222, kbl_y0 + 232; size: 66, 20; cursor: pointer; role: button; label: "Due in a week" }
                            CutButton(bp_x + 12, kbl_y0 + 232, 64, "None", fl.trace_lit, kd0.hover)
                            CutButton(bp_x + 80, kbl_y0 + 232, 64, "Today", fl.flare, kd1.hover)
                            CutButton(bp_x + 148, kbl_y0 + 232, 70, "Tomorrow", fl.phos, kd2.hover)
                            CutButton(bp_x + 222, kbl_y0 + 232, 66, "A week", fl.phos, kd3.hover)
                            on press kd0 { emit kb_due(0) }
                            on press kd1 { emit kb_due(1) }
                            on press kd2 { emit kb_due(2) }
                            on press kd3 { emit kb_due(3) }
                            text "MOVE · ALT+SHIFT+ARROWS" { at: bp_x + 16, kbl_y0 + 272; anchor: left center; size: 8; family: "Share Tech Mono"; color: fl.trace_lit }
                            zone box km1 { from: bp_x + 12, kbl_y0 + 282; size: 64, 20; cursor: pointer; role: button; label: "One column left" }
                            zone box km2 { from: bp_x + 80, kbl_y0 + 282; size: 64, 20; cursor: pointer; role: button; label: "One column right" }
                            zone box km3 { from: bp_x + 148, kbl_y0 + 282; size: 68, 20; cursor: pointer; role: button; label: "One place up" }
                            zone box km4 { from: bp_x + 220, kbl_y0 + 282; size: 68, 20; cursor: pointer; role: button; label: "One place down" }
                            CutButton(bp_x + 12, kbl_y0 + 282, 64, "◀ Left", fl.phos, km1.hover)
                            CutButton(bp_x + 80, kbl_y0 + 282, 64, "Right ▶", fl.phos, km2.hover)
                            CutButton(bp_x + 148, kbl_y0 + 282, 68, "▲ Up", fl.phos, km3.hover)
                            CutButton(bp_x + 220, kbl_y0 + 282, 68, "▼ Down", fl.phos, km4.hover)
                            on press km1 { emit kb_step(1) }
                            on press km2 { emit kb_step(2) }
                            on press km3 { emit kb_step(3) }
                            on press km4 { emit kb_step(4) }
                            zone box kcopy { from: bp_x + 12, kbl_y0 + 322; size: 132, 22; cursor: pointer; role: button; label: "Copy the card" }
                            zone box kdel { from: bp_x + 156, kbl_y0 + 322; size: 132, 22; cursor: pointer; role: button; label: "Delete the card (Undo puts it back)" }
                            CutButton(bp_x + 12, kbl_y0 + 322, 132, "Copy", fl.phos, kcopy.hover)
                            CutButton(bp_x + 156, kbl_y0 + 322, 132, "Delete · Alt+Del", fl.ember, kdel.hover)
                            on press kcopy { emit kb_copy }
                            on press kdel { emit kb_del }
                        }
                        // the column (no card chosen)
                        group {
                            show: not kb_d_has
                            text "COLUMN" { at: bp_x + 16, kbl_y0 + 20; anchor: left center; size: 11; family: "Share Tech Mono"; color: fl.ember }
                            text kb_col_title { at: bp_x + 284, kbl_y0 + 20; anchor: right center; size: 10; family: "Share Tech Mono"; width: 180; lines: 1; color: fl.trace_lit }
                            text "NAME · ENTER RENAMES" { at: bp_x + 16, kbl_y0 + 50; anchor: left center; size: 8; family: "Share Tech Mono"; color: fl.trace_lit }
                            Chamfer(bp_x + 12, kbl_y0 + 58, 276, 30, 6, fl.ground, fl.trace, 1)
                            input kb_colname { at: bp_x + 22, kbl_y0 + 65; width: 256; size: 12; family: "Exo 2"; color: fl.phos; selection: fl.well }
                            text "LIMIT · WORK IN PROGRESS" { at: bp_x + 16, kbl_y0 + 104; anchor: left center; size: 8; family: "Share Tech Mono"; color: fl.trace_lit }
                            repeat w in 0..6 {
                                let wv.$w = pick(w, 0, 2, 3, 4, 5, 8)
                                zone box kw.$w { from: bp_x + 12 + w * 46, kbl_y0 + 114; size: 42, 22; cursor: pointer; role: toggle; checked: kb_col_wip == wv.$w
                                                 label: pick(w > 0, "No limit", "A limit of {wv.$w, 0}") }
                                Chamfer(bp_x + 12 + w * 46, kbl_y0 + 114, 42, 22, 4, if(kb_col_wip == wv.$w, fl.well, fl.hull_raised), if(kb_col_wip == wv.$w, focus.ring, mix(fl.trace, fl.phos, kw.$w.hover)), 0.95)
                                text pick(w > 0, "OFF", "{wv.$w, 0}") { at: bp_x + 33 + w * 46, kbl_y0 + 125; anchor: center; size: 9; family: "Share Tech Mono"
                                                                       color: if(kb_col_wip == wv.$w, fl.phos, fl.trace_lit) }
                                on press kw.$w { emit kb_wip(wv.$w) }
                            }
                            text "Over its limit, a column's head goes ember: a reminder to finish before starting." { at: bp_x + 16, kbl_y0 + 150; anchor: left top; size: 10; family: "Exo 2"
                                 width: 268; lines: 2; color: fl.muted }
                            text "PLACE" { at: bp_x + 16, kbl_y0 + 196; anchor: left center; size: 8; family: "Share Tech Mono"; color: fl.trace_lit }
                            zone box kcl { from: bp_x + 12, kbl_y0 + 206; size: 132, 22; cursor: pointer; role: button; label: "Move the column left" }
                            zone box kcr { from: bp_x + 156, kbl_y0 + 206; size: 132, 22; cursor: pointer; role: button; label: "Move the column right" }
                            CutButton(bp_x + 12, kbl_y0 + 206, 132, "◀ Left", fl.phos, kcl.hover)
                            CutButton(bp_x + 156, kbl_y0 + 206, 132, "Right ▶", fl.phos, kcr.hover)
                            on press kcl { emit kb_colmove(0) }
                            on press kcr { emit kb_colmove(1) }
                            zone box kdc { from: bp_x + 12, kbl_y0 + 246; size: 276, 22; cursor: pointer; role: button; label: "Remove the column"; show: kb_col_empty }
                            group { show: kb_col_empty; CutButton(bp_x + 12, kbl_y0 + 246, 276, "Remove this column", fl.ember, kdc.hover) }
                            text "Move or archive its cards to remove it." { at: bp_x + 16, kbl_y0 + 257; anchor: left center; size: 10; family: "Exo 2"; color: fl.muted; show: not kb_col_empty }
                            text "The last column is where work is done: a card that reaches it is stamped done." { at: bp_x + 16, kbl_y0 + 290; anchor: left top; size: 10
                                 family: "Exo 2"; width: 268; lines: 2; color: fl.muted; show: kb_col_last }
                            on press kdc { emit kb_delcol }
                        }
                        // a new card, always
                        line { from: bp_x + 12, kbl_y0 + 520; to: bp_x + 288, kbl_y0 + 520; width: 1; color: fl.trace_dim }
                        text "NEW CARD → {kb_col_title}" { at: bp_x + 16, kbl_y0 + 538; anchor: left center; size: 8; family: "Share Tech Mono"; width: 268; lines: 1; color: fl.ember }
                        Chamfer(bp_x + 12, kbl_y0 + 548, 276, 32, 6, fl.ground, mix(fl.trace, fl.phos, if(kb_drafting, 1, 0)), 1)
                        text "Write it — Enter adds it   Ctrl+N" { at: bp_x + 22, kbl_y0 + 564; anchor: left center; size: 11; family: "Exo 2"; color: fl.muted; show: not kb_drafting }
                        input kb_new { at: bp_x + 22, kbl_y0 + 556; width: 256; size: 12; family: "Exo 2"; color: fl.phos; selection: fl.well }
                        text "It goes to the top of the chosen column." { at: bp_x + 16, kbl_y0 + 596; anchor: left center; size: 9; family: "Exo 2"; color: fl.muted }

                        // ── the foot: the keys, or what just happened ──
                        text "ALT+ARROWS CHOOSE · ALT+SHIFT+ARROWS MOVE · CTRL+N NEW · CTRL+F FIND · F2 TITLE · ALT+0–5 TAG · ALT+DEL DELETE · CTRL+Z UNDO · ESC CLOSE" {
                             at: 20, 718; anchor: left center; size: 8; family: "Share Tech Mono"; width: 1000; lines: 1; color: fl.muted }
                        text kb_said { at: kbl_W - 20, 718; anchor: right center; size: 10; family: "Share Tech Mono"; color: fl.ember; show: kb_saying }
                    }
                }
            }
        }
    }
    on key Escape { emit close_board }
    on key Alt+Left { emit kb_nav(1) }
    on key Alt+Right { emit kb_nav(2) }
    on key Alt+Up { emit kb_nav(3) }
    on key Alt+Down { emit kb_nav(4) }
    on key Alt+Shift+Left { emit kb_step(1) }
    on key Alt+Shift+Right { emit kb_step(2) }
    on key Alt+Shift+Up { emit kb_step(3) }
    on key Alt+Shift+Down { emit kb_step(4) }
    on key Ctrl+n { focus kb_new }
    on key Ctrl+f { focus kb_search }
    on key F2 while kb_d_has { focus kb_title }
    on key Alt+zero { emit kb_tag(0) }
    on key Alt+one { emit kb_tag(1) }
    on key Alt+two { emit kb_tag(2) }
    on key Alt+three { emit kb_tag(3) }
    on key Alt+four { emit kb_tag(4) }
    on key Alt+five { emit kb_tag(5) }
    on key Alt+Delete { emit kb_del }
    on key Ctrl+z { emit kb_undo }
    on kb_plus(v) { emit kb_pickcol(v); focus kb_new }
    on kb_focus_col { focus kb_colname }

}
