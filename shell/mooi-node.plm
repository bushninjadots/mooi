    follow pr_engrave_g = fr_engrave_g
    prop pr_engrave_b = 0.670588 ~fl.relight
    follow pr_engrave_b = fr_engrave_b
    fact cn_kind = 0
    fact cn_scale = 1
    fact c_bg_primary_r = 0.062745
    fact c_bg_primary_g = 0.078431
    fact c_bg_primary_b = 0.086275
    fact c_bg_secondary_r = 0.086275
    fact c_bg_secondary_g = 0.105882
    fact c_bg_secondary_b = 0.117647
    fact c_surface_primary_r = 0.098039
    fact c_surface_primary_g = 0.121569
    fact c_surface_primary_b = 0.133333
    fact c_surface_elevated_r = 0.133333
    fact c_surface_elevated_g = 0.160784
    fact c_surface_elevated_b = 0.176471
    fact c_border_subtle_r = 0.172549
    fact c_border_subtle_g = 0.207843
    fact c_border_subtle_b = 0.223529
    fact c_fg_primary_r = 0.890196
    fact c_fg_primary_g = 0.913725
    fact c_fg_primary_b = 0.921569
    fact c_fg_secondary_r = 0.639216
    fact c_fg_secondary_g = 0.690196
    fact c_fg_secondary_b = 0.709804
    fact c_fg_muted_r = 0.541176
    fact c_fg_muted_g = 0.592157
    fact c_fg_muted_b = 0.611765
    fact c_accent_primary_r = 0.650980
    fact c_accent_primary_g = 0.952941
    fact c_accent_primary_b = 0.819608
    fact c_accent_secondary_r = 1.000000
    fact c_accent_secondary_g = 0.572549
    fact c_accent_secondary_b = 0.372549
    fact c_status_ok_r = 0.650980
    fact c_status_ok_g = 0.952941
    fact c_status_ok_b = 0.819608
    fact c_status_error_r = 1.000000
    fact c_status_error_g = 0.572549
    fact c_status_error_b = 0.372549
    fact c_focus_ring_r = 0.650980
    fact c_focus_ring_g = 0.952941
    fact c_focus_ring_b = 0.819608
    fact c_selection_bg_r = 0.164706
    fact c_selection_bg_g = 0.227451
    fact c_selection_bg_b = 0.211765
    fact st_offset = 0
    fact st_notch = false
    fact bar_rail = true
    fact st_height = 30
    fact st_radius = 8
    fact st_res = 46
    fact st_glow = 1

    // ── what the node is (the logic, lib/node/state): 0 rest · 1 media · 2 notice · 3 volume · 4 workspaces ·
    //    5 system · 6 launcher · 7 universe · 8 time · 9 something finished ──
    fact nd_kind = 0
    fact nd_breath = true
    fact nd_kb = false
    fact nd_lean = 0       // where the pointer came in: -1 left · 1 right (expansion leans that way)
    // ── its look (lib/node/look, node-look.json; the studio sets it) ──
    fact nd_np = 0     // the character: 0 organic · 1 minimal · 2 technical · 3 cyber
    fact nd_sp = 2     // the body's spring (speed × bounce)
    fact nd_gs = 1     // growth: 0 slow · 1 normal · 2 fast
    fact nd_seed = 0     // 0 line · 1 dot · 2 ring · 3 twin · 4 bar
    fact nd_rnd = 1     // roundness, 0 … 1
    fact nd_tex = 0     // 0 solid · 1 hollow · 2 segmented · 3 scan · 4 dotted
    fact nd_fill = 0.95     // how solid
    fact nd_ol = 1     // the outline, px
    fact nd_gw = 0.7     // the glow, 0 … 1
    fact nd_ac = 0     // its colour: 0 signal · 1 ember · 2 ink · 3 steel
    fact nd_gc = 0     // the glow's colour, the same
    fact nd_stg = 0.5     // stagger, 0 all at once … 1 one after another
    fact nd_bd = 0.35     // how deeply it breathes
    fact nd_mu = 0.6     // how much it moves with the music
    fact nd_viz = 0     // the media's music: 0 bars · 1 wave · 2 dots · 3 off
    fact nd_cov = 0     // the cover: 0 square · 1 round
    fact nd_sst = 0     // satellites: 0 pills · 1 dots · 2 ticks
    fact nd_ldm = 0.28     // the search's dim
    fact nd_ur = 520     // the orbit's width
    fact nd_tx = 949
    fact nd_ty = 8
    fact nd_tw = 22
    fact nd_th = 6
    fact nd_tr = 3
    spring nd.s0 = 240, 31     // soft_none
    spring nd.s1 = 240, 22     // soft_some
    spring nd.s2 = 240, 15     // soft_lots
    spring nd.s3 = 520, 46     // quick_none
    spring nd.s4 = 520, 32     // quick_some
    spring nd.s5 = 520, 23     // quick_lots
    spring nd.s6 = 760, 55     // snap_none
    spring nd.s7 = 760, 39     // snap_some
    spring nd.s8 = 760, 28     // snap_lots
    spring nd.aux = 420, 34     // the parts that slide (the bead, the orbit, the dims)
    spring nd.glit = 760, 26    // the glitch
    prop nbx0 = 949 ~nd.s0
    follow nbx0 = nd_tx
    prop nbx1 = 949 ~nd.s1
    follow nbx1 = nd_tx
    prop nbx2 = 949 ~nd.s2
    follow nbx2 = nd_tx
    prop nbx3 = 949 ~nd.s3
    follow nbx3 = nd_tx
    prop nbx4 = 949 ~nd.s4
    follow nbx4 = nd_tx
    prop nbx5 = 949 ~nd.s5
    follow nbx5 = nd_tx
    prop nbx6 = 949 ~nd.s6
    follow nbx6 = nd_tx
    prop nbx7 = 949 ~nd.s7
    follow nbx7 = nd_tx
    prop nbx8 = 949 ~nd.s8
    follow nbx8 = nd_tx
    let nb_x = pick(nd_sp, nbx0, nbx1, nbx2, nbx3, nbx4, nbx5, nbx6, nbx7, nbx8)
    prop nby0 = 8 ~nd.s0
    follow nby0 = nd_ty
    prop nby1 = 8 ~nd.s1
    follow nby1 = nd_ty
    prop nby2 = 8 ~nd.s2
    follow nby2 = nd_ty
    prop nby3 = 8 ~nd.s3
    follow nby3 = nd_ty
    prop nby4 = 8 ~nd.s4
    follow nby4 = nd_ty
    prop nby5 = 8 ~nd.s5
    follow nby5 = nd_ty
    prop nby6 = 8 ~nd.s6
    follow nby6 = nd_ty
    prop nby7 = 8 ~nd.s7
    follow nby7 = nd_ty
    prop nby8 = 8 ~nd.s8
    follow nby8 = nd_ty
    let nb_y = pick(nd_sp, nby0, nby1, nby2, nby3, nby4, nby5, nby6, nby7, nby8)
    prop nbw0 = 22 ~nd.s0
    follow nbw0 = nd_tw
    prop nbw1 = 22 ~nd.s1
    follow nbw1 = nd_tw
    prop nbw2 = 22 ~nd.s2
    follow nbw2 = nd_tw
    prop nbw3 = 22 ~nd.s3
    follow nbw3 = nd_tw
    prop nbw4 = 22 ~nd.s4
    follow nbw4 = nd_tw
    prop nbw5 = 22 ~nd.s5
    follow nbw5 = nd_tw
    prop nbw6 = 22 ~nd.s6
    follow nbw6 = nd_tw
    prop nbw7 = 22 ~nd.s7
    follow nbw7 = nd_tw
    prop nbw8 = 22 ~nd.s8
    follow nbw8 = nd_tw
    let nb_w = pick(nd_sp, nbw0, nbw1, nbw2, nbw3, nbw4, nbw5, nbw6, nbw7, nbw8)
    prop nbh0 = 6 ~nd.s0
    follow nbh0 = nd_th
    prop nbh1 = 6 ~nd.s1
    follow nbh1 = nd_th
    prop nbh2 = 6 ~nd.s2
    follow nbh2 = nd_th
    prop nbh3 = 6 ~nd.s3
    follow nbh3 = nd_th
    prop nbh4 = 6 ~nd.s4
    follow nbh4 = nd_th
    prop nbh5 = 6 ~nd.s5
    follow nbh5 = nd_th
    prop nbh6 = 6 ~nd.s6
    follow nbh6 = nd_th
    prop nbh7 = 6 ~nd.s7
    follow nbh7 = nd_th
    prop nbh8 = 6 ~nd.s8
    follow nbh8 = nd_th
    let nb_h = pick(nd_sp, nbh0, nbh1, nbh2, nbh3, nbh4, nbh5, nbh6, nbh7, nbh8)
    prop nbr0 = 3 ~nd.s0
    follow nbr0 = nd_tr
    prop nbr1 = 3 ~nd.s1
    follow nbr1 = nd_tr
    prop nbr2 = 3 ~nd.s2
    follow nbr2 = nd_tr
    prop nbr3 = 3 ~nd.s3
    follow nbr3 = nd_tr
    prop nbr4 = 3 ~nd.s4
    follow nbr4 = nd_tr
    prop nbr5 = 3 ~nd.s5
    follow nbr5 = nd_tr
    prop nbr6 = 3 ~nd.s6
    follow nbr6 = nd_tr
    prop nbr7 = 3 ~nd.s7
    follow nbr7 = nd_tr
    prop nbr8 = 3 ~nd.s8
    follow nbr8 = nd_tr
    let nb_r = pick(nd_sp, nbr0, nbr1, nbr2, nbr3, nbr4, nbr5, nbr6, nbr7, nbr8)
    // what is inside appears as the body reaches its size: it grows out of the node, never pops in
    let nd_cf = clamp((nb_w - 0.82 * nd_tw) / max(1, 0.18 * nd_tw), 0, 1) * clamp((nb_h - 0.82 * nd_th) / max(1, 0.18 * nd_th), 0, 1)
    // the seed breathes (2 s), only at rest and only while allowed
    prop nd_ph = 0
    spin nd_ph by if(nd_kind == 0 and nd_breath, 180, 0)
    let nd_br = 0.5 + 0.5 * sin(nd_ph)
    // media
    text nd_title = ""
    text nd_artist = ""
    text nd_art = ""
    image nd_cover = from nd_art, 96, 96
    fact nd_playing = false
    fact nd_prog = 0
    fact nd_arted = false
    prop nd_vph = 0
    spin nd_vph by if(nd_kind == 1 and nd_playing, 240, 0)
    // notices
    model nc max 5 { x: number; y: number; w: number; h: number; app: text; title: text; act: text; hasact: bool }
    fact nd_ncn = 0       // how many cards are shown
    fact nd_more = 0      // how many more wait
    fact nd_ncl = 1       // how much of their time is left (D237)
    prop nd_ncs = 1 ~nd.aux
    follow nd_ncs = nd_ncl
    // volume
    fact nd_vol = 0
    text nd_vlabel = ""
    // workspaces
    model rl max 12 { x: number; n: text; on: bool; used: bool }
    fact nd_beadx = 960
    prop nd_bead = 960 ~nd.aux
    follow nd_bead = nd_beadx
    // system
    model sy max 5 { x: number; y: number; label: text; value: text; hot: bool }
    // launcher
    text nd_q = ""
    fact nd_sel = 0
    model lr max 6 { x: number; y: number; w: number; h: number; name: text; icon: image 28, 28; iconed: bool; letter: text; tag: text }
    // the studio (D229): the node on a stage, the deck of what it may look like
    fact nd_studio = false
    prop nd_stf = 0 ~nd.aux
    follow nd_stf = if(nd_studio, 1, 0)
    fact nd_tab = 0       // 0 Presets · 1 Shape · 2 Surface · 3 Motion · 4 Parts
    fact nd_kr = 0        // the row the keyboard is on
    fact nd_pv = 0        // the preview: 0 Rest · 1 Music · 2 Notice · 3 Volume · 4 Rail · 5 System · 6 Search · 7 Tour
    text nd_lookname = "Organic"
    model sk max 7 { kind: number; label: text; desc: text; value: text; frac: number; sel: number; n: number; o0: text; o1: text; o2: text; o3: text; o4: text; o5: text }
    model ps max 4 { name: text; desc: text; on: bool; sw: number; sh: number; sr: number; seed: number }
    model sl max 3 { label: text; full: bool }
    prop nd_ld = 0 ~nd.aux
    follow nd_ld = if(nd_kind == 6 and not nd_studio, 1, 0)
    // universe
    model un max 12 { i: number; n: text; apps: text; id: number }
    fact nd_un_n = 1      // how many workspaces orbit
    fact nd_rott = 0      // where the orbit turns to (a running count: stepping never wraps back the long way)
    prop nd_rot = 0 ~nd.aux
    follow nd_rot = nd_rott
    prop nd_uf = 0 ~nd.aux
    follow nd_uf = if(nd_kind == 7, 1, 0)
    // growth (D228): a count the logic bumps on every change of shape; springs chase it, and the lag is how far
    // from grown (a bump is an instant reset). One spring per growth speed; the look picks (nd_gs)
    fact nd_gn = 0
    spring nd.g0 = 90, 15     // slow
    prop nd_gp0 = 0 ~nd.g0
    follow nd_gp0 = nd_gn
    spring nd.g1 = 170, 19     // normal
    prop nd_gp1 = 0 ~nd.g1
    follow nd_gp1 = nd_gn
    spring nd.g2 = 320, 30     // fast
    prop nd_gp2 = 0 ~nd.g2
    follow nd_gp2 = nd_gn
    let nd_grow = clamp(1 - (nd_gn - pick(nd_gs, nd_gp0, nd_gp1, nd_gp2)), 0, 1)
    // the stagger: part i of n waits a little more than the one before it, by the look's stagger
    let nd_gk = 1 + 0.8 * nd_stg
    // cyber: a change glitches it for a moment
    fact nd_gl = 0
    prop nd_glf = 0 ~nd.glit
    follow nd_glf = nd_gl
    // the time tools (D231): the panel (a mode on stage, the others on its rail), the seed's capsule while
    // something runs, and the card when something finishes
    fact nd_tmm = 0       // on stage: 0 timer · 1 stopwatch · 2 focus · 3 alarm
    text nd_tmr = "05:00"
    text nd_tms = ""
    fact nd_tmp = 1
    text nd_tmgl = "START"
    text nd_tm2l = "RESET"
    model tc max 4 { label: text; code: number }
    model px max 400 { x: number; y: number }   // the readout's lit cells (lib/node/clockfont)
    fact nd_pxw = 29      // its width, in cells
    model tr max 3 { label: text; value: text; on: bool; m: number }
    fact nd_cap = false
    text nd_capt = ""
    text nd_capm = ""
    fact nd_capf = 1
    fact nd_capu = false
    prop nd_swp = 0
    spin nd_swp by if(nd_cap and nd_kind == 0, if(nd_capu, 300, 120), 0)
    text nd_dnt = ""
    text nd_dnd = ""
    prop nd_dph = 0
    spin nd_dph by if(nd_kind == 9, 260, 0)
    // the player (D236): the media capsule pressed grows into it
    fact nd_shuf = false
    fact nd_loop = 0      // 0 none · 1 the playlist · 2 the track
    text nd_pos = "0:00"
    text nd_len = "0:00"
    fact nd_bri = 0.5
    fact nd_mic = 0.5
    fact nd_micm = false
    fact nd_hasbri = false
    fact nd_mix = false   // the player's other page: one row per app playing (D239)
    model mx max 4 { name: text; vol: number; muted: bool }
    fact nd_lyon = false  // synced words for this song (D240)
    text nd_lyc = ""
    text nd_lyn = ""
    fact nd_sp0 = 0
    fact nd_sp1 = 0
    fact nd_sp2 = 0
    fact nd_sp3 = 0
    fact nd_sp4 = 0
    fact nd_sp5 = 0
    fact nd_sp6 = 0
    fact nd_sp7 = 0
    fact nd_sp8 = 0
    fact nd_sp9 = 0
    fact nd_sp10 = 0
    fact nd_sp11 = 0
    fact nd_sp12 = 0
    fact nd_sp13 = 0
    fact nd_sp14 = 0
    fact nd_sp15 = 0
    fact nd_sp16 = 0
    fact nd_sp17 = 0
    fact nd_sp18 = 0
    fact nd_sp19 = 0
    fact nd_sp20 = 0
    fact nd_sp21 = 0
    fact nd_sp22 = 0
    fact nd_sp23 = 0
    fact nd_sp24 = 0
    fact nd_sp25 = 0
    fact nd_sp26 = 0
    fact nd_sp27 = 0
    fact nd_sp28 = 0
    fact nd_sp29 = 0
    fact nd_sp30 = 0
    fact nd_sp31 = 0
    // privacy (D232): the microphone or the camera started or stopped
    text nd_pvt = ""
    text nd_pvd = ""
    fact nd_pvon = false
    // satellites
    model sa max 6 { x: number; y: number; w: number; h: number; label: text; kind: number }
    prop nd_sf = 0 ~nd.aux
    follow nd_sf = if(nd_kind == 0, 1, 0)

    event nd_hover ->     // the pointer over the node: 1 + x · 0 gone
    event nd_press ->     // the node pressed
    event nd_media ->     // 1 back · 2 play / pause · 3 next
    event nd_nc ->        // a notice: row * 10 + 0 open · 1 its action · 9 dismiss
    event nd_ws ->        // a workspace on the rail
    event nd_lr ->        // a launcher row
    event nd_un ->        // a workspace in the universe
    event nd_sa ->        // a satellite (its kind)
    event nd_key ->       // a key while the node holds the keyboard
    event nd_cmd ->       // from `mooi node …`: 1 wake (Super) · 2 launcher · 3 universe · 4 studio · 5 time
    event nd_tab ->       // the studio: a page
    event nd_sk ->        // the studio: a slider, row * 2000 + where along it (0 … 1000: a stride of 2000, never ambiguous)
    event nd_so ->        // the studio: a choice, row * 10 + which
    event nd_pv ->        // the studio: what the node is shown as
    event nd_ps ->        // the studio: a preset
    event nd_slot ->      // the studio: a saved look, slot * 10 + 0 save · 1 wear · 9 clear
    event nd_stc ->       // the studio: 1 shuffle · 2 done · 3 reset
    event nd_tm ->        // the time tools: 0-3 a mode · 10 go · 11 reset · 12 lap or skip · 2x timer · 3x alarm
    event nd_dn ->        // the finish card answered
    event nd_pl ->        // the player: 1 shuffle · 2 back · 3 play / pause · 4 next · 5 loop · 6 the mic muted
    event nd_seek ->      // the player: where along the song (0 … 1000)
    event nd_mx ->        // the mixer: row * 2000 + its level (0 … 1000)
    event nd_mxm ->       // the mixer: a row muted or not
    event nd_mt ->        // the player: a meter dragged, meter * 2000 + its level (0 … 1000) · 0 volume · 1 light · 2 mic

    surface node {
        size: full, full
        anchor: top
        level: top, overlay while nd_kind == 7 or nd_studio
        reserve: 0
        keyboard: exclusive while nd_kb
        rate: 60, 20 while nd_kind == 0 and nd_grow > 0.99 and not nd_studio
        // the look's colours: its own, and its light's
        let nd_acc = pick(nd_ac, fl.phos, fl.ember, fl.ink, fl.trace_lit)
        let nd_glc = pick(nd_gc, fl.phos, fl.ember, fl.ink, fl.trace_lit)
        // ── the studio (D229): the desktop steps back, the node stands on a stage ──
        let st_x = node.width / 2 - 470
        let st_dy = node.height - 500
        group { show: nd_stf > 0.01; opacity: nd_stf
            box { from: 0, 0; size: node.width, node.height; color: #000000; opacity: 0.6 }
            zone box st_bg { from: 0, 0; size: node.width, node.height; label: "The Pill studio"; show: nd_studio }
            box { from: st_x, 40; size: 940, st_dy - 60; corner: 18; color: fl.well; opacity: 0.55 }
            box { from: st_x, 40; size: 940, st_dy - 60; corner: 18; stroke: 1; color: fl.trace_dim }
            text "THE PILL · STUDIO" { at: st_x + 24, 64; anchor: left center; size: 10; weight: 700; family: "Share Tech Mono"; color: fl.muted }
            text nd_lookname { at: st_x + 916, 64; anchor: right center; align: right; size: 10; weight: 700; family: "Share Tech Mono"; color: nd_acc; width: 400; lines: 1 }
            // what the node is shown as: each state, or a tour of them all
            box { from: st_x + 54, st_dy - 62; size: 96, 26; corner: 26 / 2; color: nd_acc; opacity: if(nd_pv == 0, 0.9, if(stp0.hover, 0.18, 0)) }
            box { from: st_x + 54, st_dy - 62; size: 96, 26; corner: 26 / 2; stroke: 1; color: if(nd_pv == 0, nd_acc, fl.trace_lit) }
            text "REST" { at: st_x + 54 + 96 / 2, st_dy - 62 + 26 / 2; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(nd_pv == 0, fl.ground, fl.engrave) }
            zone box stp0 { from: st_x + 54, st_dy - 62; size: 96, 26; corner: 26 / 2; cursor: pointer; role: button; label: "Rest"; show: nd_studio }
            on press stp0 { emit nd_pv(0) }
            box { from: st_x + 158, st_dy - 62; size: 96, 26; corner: 26 / 2; color: nd_acc; opacity: if(nd_pv == 1, 0.9, if(stp1.hover, 0.18, 0)) }
            box { from: st_x + 158, st_dy - 62; size: 96, 26; corner: 26 / 2; stroke: 1; color: if(nd_pv == 1, nd_acc, fl.trace_lit) }
            text "MUSIC" { at: st_x + 158 + 96 / 2, st_dy - 62 + 26 / 2; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(nd_pv == 1, fl.ground, fl.engrave) }
            zone box stp1 { from: st_x + 158, st_dy - 62; size: 96, 26; corner: 26 / 2; cursor: pointer; role: button; label: "Music"; show: nd_studio }
            on press stp1 { emit nd_pv(1) }
            box { from: st_x + 262, st_dy - 62; size: 96, 26; corner: 26 / 2; color: nd_acc; opacity: if(nd_pv == 2, 0.9, if(stp2.hover, 0.18, 0)) }
            box { from: st_x + 262, st_dy - 62; size: 96, 26; corner: 26 / 2; stroke: 1; color: if(nd_pv == 2, nd_acc, fl.trace_lit) }
            text "NOTICE" { at: st_x + 262 + 96 / 2, st_dy - 62 + 26 / 2; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(nd_pv == 2, fl.ground, fl.engrave) }
            zone box stp2 { from: st_x + 262, st_dy - 62; size: 96, 26; corner: 26 / 2; cursor: pointer; role: button; label: "Notice"; show: nd_studio }
            on press stp2 { emit nd_pv(2) }
            box { from: st_x + 366, st_dy - 62; size: 96, 26; corner: 26 / 2; color: nd_acc; opacity: if(nd_pv == 3, 0.9, if(stp3.hover, 0.18, 0)) }
            box { from: st_x + 366, st_dy - 62; size: 96, 26; corner: 26 / 2; stroke: 1; color: if(nd_pv == 3, nd_acc, fl.trace_lit) }
            text "VOLUME" { at: st_x + 366 + 96 / 2, st_dy - 62 + 26 / 2; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(nd_pv == 3, fl.ground, fl.engrave) }
            zone box stp3 { from: st_x + 366, st_dy - 62; size: 96, 26; corner: 26 / 2; cursor: pointer; role: button; label: "Volume"; show: nd_studio }
            on press stp3 { emit nd_pv(3) }
            box { from: st_x + 470, st_dy - 62; size: 96, 26; corner: 26 / 2; color: nd_acc; opacity: if(nd_pv == 4, 0.9, if(stp4.hover, 0.18, 0)) }
            box { from: st_x + 470, st_dy - 62; size: 96, 26; corner: 26 / 2; stroke: 1; color: if(nd_pv == 4, nd_acc, fl.trace_lit) }
            text "RAIL" { at: st_x + 470 + 96 / 2, st_dy - 62 + 26 / 2; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(nd_pv == 4, fl.ground, fl.engrave) }
            zone box stp4 { from: st_x + 470, st_dy - 62; size: 96, 26; corner: 26 / 2; cursor: pointer; role: button; label: "Rail"; show: nd_studio }
            on press stp4 { emit nd_pv(4) }
            box { from: st_x + 574, st_dy - 62; size: 96, 26; corner: 26 / 2; color: nd_acc; opacity: if(nd_pv == 5, 0.9, if(stp5.hover, 0.18, 0)) }
            box { from: st_x + 574, st_dy - 62; size: 96, 26; corner: 26 / 2; stroke: 1; color: if(nd_pv == 5, nd_acc, fl.trace_lit) }
            text "SYSTEM" { at: st_x + 574 + 96 / 2, st_dy - 62 + 26 / 2; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(nd_pv == 5, fl.ground, fl.engrave) }
            zone box stp5 { from: st_x + 574, st_dy - 62; size: 96, 26; corner: 26 / 2; cursor: pointer; role: button; label: "System"; show: nd_studio }
            on press stp5 { emit nd_pv(5) }
            box { from: st_x + 678, st_dy - 62; size: 96, 26; corner: 26 / 2; color: nd_acc; opacity: if(nd_pv == 6, 0.9, if(stp6.hover, 0.18, 0)) }
            box { from: st_x + 678, st_dy - 62; size: 96, 26; corner: 26 / 2; stroke: 1; color: if(nd_pv == 6, nd_acc, fl.trace_lit) }
            text "SEARCH" { at: st_x + 678 + 96 / 2, st_dy - 62 + 26 / 2; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(nd_pv == 6, fl.ground, fl.engrave) }
            zone box stp6 { from: st_x + 678, st_dy - 62; size: 96, 26; corner: 26 / 2; cursor: pointer; role: button; label: "Search"; show: nd_studio }
            on press stp6 { emit nd_pv(6) }
            box { from: st_x + 782, st_dy - 62; size: 96, 26; corner: 26 / 2; color: nd_acc; opacity: if(nd_pv == 7, 0.9, if(stp7.hover, 0.18, 0)) }
            box { from: st_x + 782, st_dy - 62; size: 96, 26; corner: 26 / 2; stroke: 1; color: if(nd_pv == 7, nd_acc, fl.trace_lit) }
            text "TOUR" { at: st_x + 782 + 96 / 2, st_dy - 62 + 26 / 2; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(nd_pv == 7, fl.ground, fl.engrave) }
            zone box stp7 { from: st_x + 782, st_dy - 62; size: 96, 26; corner: 26 / 2; cursor: pointer; role: button; label: "Tour"; show: nd_studio }
            on press stp7 { emit nd_pv(7) }
        }
        // the launcher: what is round it steps back (the look's dim), the search line in focus
        box { from: 0, 0; size: node.width, node.height; color: #000000; opacity: nd_ldm * nd_ld; show: nd_ld > 0.01 }
        // the universe (Super+Tab): the desktop dims and the workspaces orbit the node; stepping turns the orbit
        box { from: 0, 0; size: node.width, node.height; color: #000000; opacity: 0.62 * nd_uf; show: nd_uf > 0.01 }
        zone box nd_ubz { from: 0, 0; size: node.width, node.height; role: button; label: "Close the workspaces"; show: nd_kind == 7 }
        on press nd_ubz { emit nd_key(27) }
        on scroll nd_ubz { emit nd_key(if(wheel > 0, 37, 39)) }
        // the orbit's ring, faint, round the node
        ellipse { at: node.width / 2, node.height / 2; radius: nd_ur * nd_uf; scale: 1, 0.33; stroke: 1; color: fl.trace_lit; opacity: 0.25 * nd_uf; show: nd_uf > 0.01 }
        for u in un {
            let ua = 90 + (u.i - nd_rot) * 360 / max(1, nd_un_n)
            let ud = (sin(ua) + 1) / 2
            let us = (0.55 + 0.45 * ud) * (0.6 + 0.4 * nd_uf)
            let ux = node.width / 2 + cos(ua) * nd_ur * nd_uf
            let uy = node.height / 2 + sin(ua) * nd_ur * 0.33 * nd_uf
            let tw = 240 * us
            let th = 140 * us
            let front = ud > 0.97
            let ucr = max(3, 12 * us * nd_rnd)
            group { opacity: nd_uf * (0.45 + 0.55 * ud); show: nd_uf > 0.01
                group { glow: 22, if(front, 0.7, 0.15) * nd_gw, nd_glc
                    box { from: ux - tw / 2, uy - th / 2; size: tw, th; corner: ucr; color: fl.hull; opacity: 0.94 } }
                box { from: ux - tw / 2, uy - th / 2; size: tw, th; corner: ucr; stroke: if(front, 2, 1); color: if(front, nd_acc, fl.trace_lit) }
                text u.n { at: ux, uy - th / 2 + 26 * us; anchor: center; align: center; size: 22 * us; weight: 700; family: "Share Tech Mono"; color: if(front, nd_acc, fl.engrave) }
                text u.apps { at: ux, uy + 12 * us; anchor: center; align: center; size: 11 * us; family: "Exo 2"; color: fl.muted; width: tw - 20; lines: 2 }
                zone box ut { from: ux - tw / 2, uy - th / 2; size: tw, th; corner: 12; cursor: pointer; role: button; label: "Workspace {u.n}"; show: nd_kind == 7 }
                on press ut { emit nd_un(u.id) }
            }
        }
        // the body: one shape that is the seed, a capsule, a rail, a search line — its glow by the look, swelling
        // a little with the music as far as the look lets it
        let nd_glow = nd_gw * (1 + 0.4 * lv.level * nd_mu)
        let nd_sw = nb_w + if(nd_kind == 0 and nd_playing, lv.level * 16 * nd_mu, 0)
        let nd_sx = nb_x - (nd_sw - nb_w) / 2
        let nd_sh = nb_h * if(nd_kind == 0, 1 + 0.35 * nd_br * nd_bd, 1)
        let nd_sy = nb_y - (nd_sh - nb_h) / 2
        let nd_sr = min(nb_r, nd_sh / 2)
        // the seed: a line, a bar or a dot (filled), a ring (an outline), twins (two halves breathing in turn)
        group { show: nd_kind == 0 and not nd_cap; glow: 8, (0.35 + 0.35 * nd_br * nd_bd) * nd_gw / 0.7, nd_glc
            box { from: nd_sx, nd_sy; size: nd_sw, nd_sh; corner: nd_sr; color: nd_acc; opacity: (0.55 + 0.35 * nd_br) * nd_fill; show: nd_seed == 0 or nd_seed == 1 or nd_seed == 4 }
            box { from: nd_sx, nd_sy; size: nd_sw, nd_sh; corner: nd_sr; stroke: 1.5; color: nd_acc; opacity: 0.6 + 0.35 * nd_br; show: nd_seed == 2 }
            box { from: nd_sx, nd_sy; size: nd_sw * 0.45, nd_sh; corner: nd_sr; color: nd_acc; opacity: (0.55 + 0.35 * nd_br) * nd_fill; show: nd_seed == 3 }
            box { from: nd_sx + nd_sw * 0.55, nd_sy; size: nd_sw * 0.45, nd_sh; corner: nd_sr; color: nd_acc; opacity: (0.55 + 0.35 * (1 - nd_br)) * nd_fill; show: nd_seed == 3 }
        }
        // grown: the body, of the look's fill (hollow: barely), its texture, its outline
        group { show: nd_kind > 0; glow: 14, nd_glow, nd_glc
            box { from: nb_x, nb_y; size: nb_w, nb_h; corner: nb_r; color: fl.hull; opacity: nd_fill * if(nd_tex == 1, 0.25, 1) } }
        group { show: nd_kind > 0 and nd_tex > 2
            clip box { from: nb_x, nb_y; size: nb_w, nb_h; corner: nb_r }
            repeat sl in 0..16 { box { from: nb_x, nb_y + (sl + 0.5) * nb_h / 16; size: nb_w, 1; color: nd_acc; opacity: 0.08; show: nd_tex == 3 } }
            repeat dr in 0..4 { repeat dc in 0..48 { ellipse { at: nb_x + (dc + 0.5) * nb_w / 48, nb_y + (dr + 0.5) * nb_h / 4; radius: 0.9; color: nd_acc; opacity: 0.18; show: nd_tex == 4 } } }
        }
        box { from: nb_x, nb_y; size: nb_w, nb_h; corner: nb_r; stroke: nd_ol; color: nd_acc; opacity: if(nd_tex == 1, 0.9, 0.55); show: nd_kind > 0 and nd_ol > 0.05 }
        // segmented: the outline breaks in three places; and a cyber node glitches on a change (a shifted ghost and a
        // scan line in the counter-signal)
        box { from: nb_x + nb_w * 0.3, nb_y - 1; size: nb_w * 0.12, nd_ol + 2; color: fl.ground; show: nd_tex == 2 and nd_kind > 0 }
        box { from: nb_x + nb_w * 0.7, nb_y + nb_h - nd_ol - 1; size: nb_w * 0.08, nd_ol + 2; color: fl.ground; show: nd_tex == 2 and nd_kind > 0 }
        box { from: nb_x - 1, nb_y + nb_h * 0.35; size: nd_ol + 2, nb_h * 0.3; color: fl.ground; show: nd_tex == 2 and nd_kind > 0 }
        box { from: nb_x + 4 * sin(nd_ph * 13), nb_y + 2 * cos(nd_ph * 7); size: nb_w, nb_h; corner: nb_r; stroke: 1; color: fl.ember; opacity: 0.7 * nd_glf; show: nd_np == 3 and nd_glf > 0.01 }
        box { from: nb_x + nb_w * 0.15, nb_y + nb_h * 0.4 + 3 * sin(nd_ph * 17); size: nb_w * 0.5, 2; color: fl.ember; opacity: 0.8 * nd_glf; show: nd_np == 3 and nd_glf > 0.01 }
        // technical: ticks along the floor and brackets at the corners
        repeat tk in 0..9 { box { from: nb_x + nb_w * (tk + 0.5) / 9, nb_y + nb_h - 3; size: 1, 3; color: nd_acc; opacity: 0.5; show: nd_np == 2 and nd_kind > 0 and nd_kind < 6 } }
        group { show: nd_np == 2 and nd_kind > 0
            box { from: nb_x - 4, nb_y - 4; size: 8, 1.5; color: nd_acc }
            box { from: nb_x - 4, nb_y - 4; size: 1.5, 8; color: nd_acc }
            box { from: nb_x + nb_w - 4, nb_y - 4; size: 8, 1.5; color: nd_acc }
            box { from: nb_x + nb_w + 2.5, nb_y - 4; size: 1.5, 8; color: nd_acc }
            box { from: nb_x - 4, nb_y + nb_h + 2.5; size: 8, 1.5; color: nd_acc }
            box { from: nb_x - 4, nb_y + nb_h - 4; size: 1.5, 8; color: nd_acc }
            box { from: nb_x + nb_w - 4, nb_y + nb_h + 2.5; size: 8, 1.5; color: nd_acc }
            box { from: nb_x + nb_w + 2.5, nb_y + nb_h - 4; size: 1.5, 8; color: nd_acc }
        }
        // organic: a second, softer skin round the body, there as what is inside appears
        box { from: nb_x - 3, nb_y - 3; size: nb_w + 6, nb_h + 6; corner: nb_r + 3; stroke: 1; color: nd_acc; opacity: 0.18 * nd_cf; show: nd_np == 0 and nd_kind > 0 }
        zone box nd_bz { from: nb_x - 16, nb_y - 8; size: nb_w + 32, nb_h + 16; corner: nb_r; cursor: pointer; role: button; label: "The Pill" }
        let nd_hv = nd_bz.hover
        on change nd_hv { emit nd_hover(if(nd_hv, 1 + round(pointer.x), 0)) }
        on press nd_bz { emit nd_press }
        // media: a lateral capsule — revealed by the body as it grows (its own clip), the music woven into it
        group { show: nd_kind == 1; opacity: nd_cf
            clip box { from: nb_x, nb_y; size: nb_w, nb_h; corner: nb_r }
            // the music, by the look: bars from the floor, a wave through the middle, or dots that swell
            repeat vb in 0..40 { box { from: nb_x + 8 + vb * (nb_w - 16) / 40, nb_y + nb_h - (0.25 + 0.75 * abs(sin(vb * 47 + nd_vph))) * lv.level * nb_h * 0.7; size: (nb_w - 16) / 40 * 0.55, (0.25 + 0.75 * abs(sin(vb * 47 + nd_vph))) * lv.level * nb_h * 0.7 + 1; color: nd_acc; opacity: 0.16; show: nd_viz == 0 } }
            repeat vw in 0..60 { ellipse { at: nb_x + 8 + vw * (nb_w - 16) / 60, nb_y + nb_h / 2 + sin(vw * 14 + nd_vph * 2) * (0.15 + lv.level) * nb_h * 0.32; radius: 1.3; color: nd_acc; opacity: 0.3; show: nd_viz == 1 } }
            repeat vd in 0..24 { ellipse { at: nb_x + 14 + vd * (nb_w - 28) / 23, nb_y + nb_h - 8; radius: 1 + 3 * lv.level * abs(sin(vd * 31 + nd_vph)); color: nd_acc; opacity: 0.3; show: nd_viz == 2 } }
            group { clip box { from: nb_x + 8, nb_y + 8; size: 48, 48; corner: if(nd_cov == 1, 24, max(2, 10 * nd_rnd)) }
                box { from: nb_x + 8, nb_y + 8; size: 48, 48; color: fl.well }
                image nd_cover { at: nb_x + 8, nb_y + 8; size: 48, 48; fit: cover; show: nd_arted } }
            text nd_title { at: nb_x + 68, nb_y + 22; anchor: left center; size: 13; weight: 600; family: "Exo 2"; color: fl.engrave; width: nb_w - 200; lines: 1 }
            text nd_artist { at: nb_x + 68, nb_y + 40; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.muted; width: nb_w - 200; lines: 1 }
            box { from: nb_x + 68, nb_y + nb_h - 12; size: nb_w - 200, 2; corner: 1; color: fl.trace_dim }
            box { from: nb_x + 68, nb_y + nb_h - 12; size: (nb_w - 200) * nd_prog, 2; corner: 1; color: nd_acc }
            text "⏮" { at: nb_x + nb_w - 118 + 0 + 14, nb_y + nb_h / 2; anchor: center; align: center; size: 15; family: "Exo 2"; color: if(nmc1.hover, nd_acc, fl.engrave) }
            zone box nmc1 { from: nb_x + nb_w - 118 + 0, nb_y + nb_h / 2 - 14; size: 28, 28; corner: 14; cursor: pointer; role: button; label: "Back"; show: nd_kind == 1 }
            on press nmc1 { emit nd_media(1) }
            text "⏯" { at: nb_x + nb_w - 118 + 36 + 14, nb_y + nb_h / 2; anchor: center; align: center; size: 15; family: "Exo 2"; color: if(nmc2.hover, nd_acc, fl.engrave) }
            zone box nmc2 { from: nb_x + nb_w - 118 + 36, nb_y + nb_h / 2 - 14; size: 28, 28; corner: 14; cursor: pointer; role: button; label: "Play or pause"; show: nd_kind == 1 }
            on press nmc2 { emit nd_media(2) }
            text "⏭" { at: nb_x + nb_w - 118 + 72 + 14, nb_y + nb_h / 2; anchor: center; align: center; size: 15; family: "Exo 2"; color: if(nmc3.hover, nd_acc, fl.engrave) }
            zone box nmc3 { from: nb_x + nb_w - 118 + 72, nb_y + nb_h / 2 - 14; size: 28, 28; corner: 14; cursor: pointer; role: button; label: "Next"; show: nd_kind == 1 }
            on press nmc3 { emit nd_media(3) }
        }
        // notices: a stem drops from the node, and the cards branch from it one after another (each grows out of
        // the stem's foot: it slides down from it, opening as it comes)
        group { show: nd_kind == 2
            line { from: nb_x + nb_w / 2, nb_y + nb_h; to: nb_x + nb_w / 2, nb_y + nb_h + 22 * nd_grow; width: 1.5; color: nd_acc }
            for n in nc {
                let row = n.index
                let g = clamp(nd_grow * nd_gk - row * 0.32 * nd_stg, 0, 1)
                let rise = (n.y - nb_y - nb_h) * (1 - g)
                let ncr = max(3, 12 * nd_rnd)
                group { opacity: g; move: 0, 0 - rise; pivot: n.x + n.w / 2, n.y; scale: 0.7 + 0.3 * g
                    line { from: nb_x + nb_w / 2, n.y - 8; to: n.x + n.w / 2, n.y; width: 1; color: fl.trace_lit; opacity: 0.6 }
                    group { glow: 16, 0.35, #000000
                        box { from: n.x, n.y; size: n.w, n.h; corner: ncr; color: fl.hull; opacity: 0.96 } }
                    box { from: n.x, n.y; size: n.w, n.h; corner: ncr; stroke: 1; color: fl.trace_lit; opacity: 0.6 }
                    box { from: n.x, n.y + 10; size: 3, n.h - 20; corner: 1; color: nd_acc }
                    // its time, draining along its floor (held while the pointer rests on the node)
                    box { from: n.x + 12, n.y + n.h - 3; size: (n.w - 24) * nd_ncs, 1.5; corner: 1; color: nd_acc; opacity: 0.6; show: row == 0 }
                    text n.app { at: n.x + 14, n.y + 16; anchor: left center; size: 9; weight: 700; family: "Share Tech Mono"; color: nd_acc; width: n.w - 60; lines: 1 }
                    text n.title { at: n.x + 14, n.y + 37; anchor: left center; size: 12; family: "Exo 2"; color: fl.engrave; width: if(n.hasact, n.w - 120, n.w - 40); lines: 1 }
                    group { show: n.hasact
                        box { from: n.x + n.w - 100, n.y + 27; size: 64, 20; corner: 10 * nd_rnd; stroke: 1; color: nd_acc }
                        text n.act { at: n.x + n.w - 68, n.y + 37; anchor: center; align: center; size: 9; family: "Share Tech Mono"; color: nd_acc; width: 58; lines: 1 } }
                    text "×" { at: n.x + n.w - 18, n.y + 16; anchor: center; size: 14; family: "Exo 2"; color: if(ncx.hover, fl.engrave, fl.muted) }
                }
                zone box ncz { from: n.x, n.y; size: n.w, n.h; corner: 12; cursor: pointer; role: button; label: "{n.app}: {n.title}"; show: nd_kind == 2 and g > 0.9 and not nd_studio }
                on press ncz { emit nd_nc(row * 10) }
                zone box nca { from: n.x + n.w - 100, n.y + 27; size: 64, 20; cursor: pointer; role: button; label: "{n.act}"; show: nd_kind == 2 and n.hasact and g > 0.9 and not nd_studio }
                on press nca { emit nd_nc(row * 10 + 1) }
                zone box ncx { from: n.x + n.w - 30, n.y + 4; size: 24, 24; cursor: pointer; role: button; label: "Dismiss"; show: nd_kind == 2 and g > 0.9 and not nd_studio }
                on press ncx { emit nd_nc(row * 10 + 9) }
            }
            // more than fit: how many wait
            text "+{nd_more, 0} MORE" { at: nb_x + nb_w / 2, nb_y + nb_h + 22 + nd_ncn * 66 + 8; anchor: center; align: center; size: 9; weight: 700; family: "Share Tech Mono"; color: fl.muted; opacity: nd_grow; show: nd_more > 0.5 }
        }
        // volume or brightness: the node becomes a gauge
        group { show: nd_kind == 3; opacity: nd_cf
            box { from: nb_x + 3, nb_y + 3; size: max(0, (nb_w - 6) * nd_vol), nb_h - 6; corner: max(0, nb_r - 3); color: nd_acc; opacity: 0.85 }
            text nd_vlabel { at: nb_x + nb_w / 2, nb_y + nb_h + 12; anchor: center; align: center; size: 9; family: "Share Tech Mono"; color: fl.engrave; opacity: nd_grow } }
        // workspaces: a rail drawn out from the middle, the active one a bead that slides along it
        group { show: nd_kind == 4; opacity: nd_cf
            line { from: nb_x + nb_w / 2 - (nb_w / 2 - 18) * nd_grow, nb_y + nb_h / 2; to: nb_x + nb_w / 2 + (nb_w / 2 - 18) * nd_grow, nb_y + nb_h / 2; width: 1; color: fl.trace_lit; opacity: 0.7 }
            for r in rl {
                let rx = nb_x + nb_w / 2 + (r.x - nb_x - nb_w / 2) * nd_grow
                ellipse { at: rx, nb_y + nb_h / 2; radius: if(r.used, 3.5, 2); color: if(r.used, fl.engrave, fl.muted) }
                zone box rz { from: r.x - 20, nb_y; size: 40, nb_h; cursor: pointer; role: button; label: "Workspace {r.n}"; show: nd_kind == 4 and not nd_studio }
                on press rz { emit nd_ws(r.index) }
            }
            group { glow: 12, 0.8 * nd_glow, nd_glc
                ellipse { at: nd_bead, nb_y + nb_h / 2; radius: 10 * nd_grow; color: nd_acc } }
            for r in rl { text r.n { at: r.x, nb_y + nb_h / 2; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: fl.ground; show: r.on and nd_grow > 0.6 } }
        }
        // system: spokes extend from the node and the readings ride out on them, one after another
        group { show: nd_kind == 5
            for p in sy {
                let g = clamp(nd_grow * nd_gk - p.index * 0.2 * nd_stg, 0, 1)
                let px = nb_x + nb_w / 2 + (p.x - nb_x - nb_w / 2) * g
                let py = nb_y + nb_h / 2 + (p.y - nb_y - nb_h / 2) * g
                line { from: nb_x + nb_w / 2, nb_y + nb_h / 2; to: px, py; width: 1; color: fl.trace_lit; opacity: 0.7 }
                group { opacity: g; pivot: px, py; scale: 0.5 + 0.5 * g
                    box { from: px - 46, py - 14; size: 92, 28; corner: 14 * nd_rnd; color: fl.hull; opacity: 0.95 }
                    box { from: px - 46, py - 14; size: 92, 28; corner: 14 * nd_rnd; stroke: 1; color: if(p.hot, fl.ember, nd_acc); opacity: 0.8 }
                    text p.label { at: px - 38, py; anchor: left center; size: 8; family: "Share Tech Mono"; color: fl.muted }
                    text p.value { at: px + 38, py; anchor: right center; size: 11; weight: 700; family: "Share Tech Mono"; color: if(p.hot, fl.ember, fl.engrave) }
                }
            }
            ellipse { at: nb_x + nb_w / 2, nb_y + nb_h / 2; radius: 5; color: nd_acc }
        }
        // the launcher: the node widens into a search line, the results drop out of it one after another
        group { show: nd_kind == 6; opacity: nd_cf
            text "›" { at: nb_x + 18, nb_y + nb_h / 2; anchor: center; size: 18; family: "Exo 2"; color: nd_acc }
            input nd_q { at: nb_x + 34, nb_y + nb_h / 2 - 9; width: nb_w - 50; size: 14; family: "Exo 2"; color: fl.engrave; selection: fl.well; placeholder: "search apps" }
        }
        for r in lr {
            let i = r.index
            let g = clamp(nd_grow * nd_gk - i * 0.18 * nd_stg, 0, 1)
            group { show: nd_kind == 6; opacity: g * nd_cf; move: 0, 0 - (r.y - nb_y - nb_h) * (1 - g)
                box { from: r.x, r.y; size: r.w, r.h; corner: max(2, 10 * nd_rnd); color: if(nd_sel == i, fl.hull_raised, fl.hull); opacity: 0.95 }
                box { from: r.x, r.y; size: 3, r.h; color: nd_acc; show: nd_sel == i }
                image r.icon { at: r.x + 12, r.y + 7; size: 28, 28; show: r.iconed }
                text r.letter { at: r.x + 26, r.y + 21; anchor: center; align: center; size: 13; weight: 700; family: "Share Tech Mono"; color: nd_acc; show: not r.iconed }
                text r.name { at: r.x + 52, r.y + 21; anchor: left center; size: 13; family: "Exo 2"; color: fl.engrave; width: r.w - 140; lines: 1 }
                text r.tag { at: r.x + r.w - 16, r.y + 21; anchor: right center; align: right; size: 8; weight: 700; family: "Share Tech Mono"; color: fl.muted; width: 80; lines: 1 }
            }
            zone box lz { from: r.x, r.y; size: r.w, r.h; cursor: pointer; role: button; label: "Open {r.name}"; show: nd_kind == 6 and not nd_studio }
            on press lz { emit nd_lr(i) }
        }
        on submit nd_q { emit nd_key(13) }
        on change nd_kb while nd_kb and nd_kind == 6 and not nd_studio { focus nd_q }
        // the capsule: while a timer, a focus phase, the stopwatch or a near alarm runs, the seed is a capsule with its
        // value, a line that drains, and a sweep of light (faster, and warm, in the last minute)
        group { show: nd_kind == 0 and nd_cap
            let cw = if(nd_capu, fl.ember, nd_acc)
            group { glow: 10, 0.5 * nd_gw + if(nd_capu, 0.3, 0), if(nd_capu, fl.ember, nd_glc)
                box { from: nb_x, nb_y; size: nb_w, nb_h; corner: nb_r; color: fl.hull; opacity: 0.95 } }
            box { from: nb_x, nb_y; size: nb_w, nb_h; corner: nb_r; stroke: 1; color: cw; opacity: 0.7 }
            group { clip box { from: nb_x, nb_y; size: nb_w, nb_h; corner: nb_r }
                box { from: nb_x - 24 + fract(nd_swp / 360) * (nb_w + 24), nb_y; size: 24, nb_h; color: cw; opacity: 0.18 }
                box { from: nb_x + 8, nb_y + nb_h - 3; size: (nb_w - 16) * nd_capf, 1.5; color: cw; opacity: 0.9 } }
            text nd_capm { at: nb_x + 10, nb_y + nb_h / 2; anchor: left center; size: 8; weight: 700; family: "Share Tech Mono"; color: fl.muted; opacity: nd_cf }
            text nd_capt { at: nb_x + nb_w - 10, nb_y + nb_h / 2; anchor: right center; align: right; size: 11; weight: 700; family: "Share Tech Mono"; color: if(nd_capu, fl.ember, fl.engrave); opacity: nd_cf }
        }
        // the panel: the mode on stage, its readout big, its progress as a strip of cells, its controls; the other
        // three on the rail along the floor, still counting
        group { show: nd_kind == 8; opacity: nd_cf
            clip box { from: nb_x, nb_y; size: nb_w, nb_h; corner: nb_r }
            text "TIMER" { at: nb_x + 20, nb_y + 20; anchor: left center; size: 9; weight: 700; family: "Share Tech Mono"; color: if(nd_tmm == 0, nd_acc, if(tmz0.hover, fl.engrave, fl.muted)) }
            box { from: nb_x + 20, nb_y + 29; size: 24, 1.5; color: nd_acc; show: nd_tmm == 0 }
            zone box tmz0 { from: nb_x + 20 - 6, nb_y + 8; size: 92, 26; cursor: pointer; role: tab; label: "Timer"; selected: nd_tmm == 0; show: nd_kind == 8 }
            on press tmz0 { emit nd_tm(0) }
            text "STOPWATCH" { at: nb_x + 116, nb_y + 20; anchor: left center; size: 9; weight: 700; family: "Share Tech Mono"; color: if(nd_tmm == 1, nd_acc, if(tmz1.hover, fl.engrave, fl.muted)) }
            box { from: nb_x + 116, nb_y + 29; size: 24, 1.5; color: nd_acc; show: nd_tmm == 1 }
            zone box tmz1 { from: nb_x + 116 - 6, nb_y + 8; size: 92, 26; cursor: pointer; role: tab; label: "Stopwatch"; selected: nd_tmm == 1; show: nd_kind == 8 }
            on press tmz1 { emit nd_tm(1) }
            text "FOCUS" { at: nb_x + 212, nb_y + 20; anchor: left center; size: 9; weight: 700; family: "Share Tech Mono"; color: if(nd_tmm == 2, nd_acc, if(tmz2.hover, fl.engrave, fl.muted)) }
            box { from: nb_x + 212, nb_y + 29; size: 24, 1.5; color: nd_acc; show: nd_tmm == 2 }
            zone box tmz2 { from: nb_x + 212 - 6, nb_y + 8; size: 92, 26; cursor: pointer; role: tab; label: "Focus"; selected: nd_tmm == 2; show: nd_kind == 8 }
            on press tmz2 { emit nd_tm(2) }
            text "ALARM" { at: nb_x + 308, nb_y + 20; anchor: left center; size: 9; weight: 700; family: "Share Tech Mono"; color: if(nd_tmm == 3, nd_acc, if(tmz3.hover, fl.engrave, fl.muted)) }
            box { from: nb_x + 308, nb_y + 29; size: 24, 1.5; color: nd_acc; show: nd_tmm == 3 }
            zone box tmz3 { from: nb_x + 308 - 6, nb_y + 8; size: 92, 26; cursor: pointer; role: tab; label: "Alarm"; selected: nd_tmm == 3; show: nd_kind == 8 }
            on press tmz3 { emit nd_tm(3) }
            // the readout: a 5×7 matrix of mooi's own, every cell there and dim, the lit ones in its colour
            repeat gc in 0..48 { repeat gr in 0..7 { box { from: nb_x + 20 + gc * 6, nb_y + 44 + gr * 6; size: 5, 5; corner: 1; color: fl.trace_dim; opacity: 0.35; show: gc < nd_pxw } } }
            group { glow: 8, 0.5 * nd_gw, nd_glc
                for q in px { box { from: nb_x + 20 + q.x * 6, nb_y + 44 + q.y * 6; size: 5, 5; corner: 1; color: nd_acc } } }
            text nd_tms { at: nb_x + 22, nb_y + 94; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.muted; width: 300; lines: 1 }
            repeat cl in 0..30 { box { from: nb_x + 20 + cl * 10, nb_y + 108; size: 7, 5; corner: 1; color: if(cl < nd_tmp * 30, nd_acc, fl.trace_dim); opacity: if(cl < nd_tmp * 30, 0.9, 0.6) } }
            box { from: nb_x + nb_w - 214, nb_y + 46; size: 94, 30; corner: 15 * max(0.3, nd_rnd); color: nd_acc; opacity: if(true, 0.9, if(tmb10.hover, 0.18, 0)) }
            box { from: nb_x + nb_w - 214, nb_y + 46; size: 94, 30; corner: 15 * max(0.3, nd_rnd); stroke: 1; color: if(true, nd_acc, fl.trace_lit) }
            text nd_tmgl { at: nb_x + nb_w - 214 + 47, nb_y + 61; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(true, fl.ground, fl.engrave) }
            zone box tmb10 { from: nb_x + nb_w - 214, nb_y + 46; size: 94, 30; cursor: pointer; role: button; label: "{nd_tmgl}"; show: nd_kind == 8 }
            on press tmb10 { emit nd_tm(10) }
            box { from: nb_x + nb_w - 112, nb_y + 46; size: 94, 30; corner: 15 * max(0.3, nd_rnd); color: nd_acc; opacity: if(false, 0.9, if(tmb11.hover, 0.18, 0)) }
            box { from: nb_x + nb_w - 112, nb_y + 46; size: 94, 30; corner: 15 * max(0.3, nd_rnd); stroke: 1; color: if(false, nd_acc, fl.trace_lit) }
            text nd_tm2l { at: nb_x + nb_w - 112 + 47, nb_y + 61; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(false, fl.ground, fl.engrave) }
            zone box tmb11 { from: nb_x + nb_w - 112, nb_y + 46; size: 94, 30; cursor: pointer; role: button; label: "{nd_tm2l}"; show: nd_kind == 8 }
            on press tmb11 { emit nd_tm(11) }
            for k in tc {
                let kx = nb_x + nb_w - 214 + k.index * 50
                box { from: kx, nb_y + 86; size: 44, 24; corner: 12 * max(0.3, nd_rnd); stroke: 1; color: if(tcz.hover, nd_acc, fl.trace_lit) }
                text k.label { at: kx + 22, nb_y + 98; anchor: center; align: center; size: 9; weight: 700; family: "Share Tech Mono"; color: fl.engrave; width: 42; lines: 1 }
                zone box tcz { from: kx, nb_y + 86; size: 44, 24; cursor: pointer; role: button; label: "{k.label}"; show: nd_kind == 8 }
                on press tcz { emit nd_tm(k.code) }
            }
            line { from: nb_x + 16, nb_y + nb_h - 36; to: nb_x + nb_w - 16, nb_y + nb_h - 36; width: 1; color: fl.trace_dim }
            for r in tr {
                let rx = nb_x + 20 + r.index * ((nb_w - 40) / 3)
                ellipse { at: rx + 3, nb_y + nb_h - 18; radius: 2.5; color: if(r.on, nd_acc, fl.trace_dim) }
                text r.label { at: rx + 12, nb_y + nb_h - 18; anchor: left center; size: 8; weight: 700; family: "Share Tech Mono"; color: fl.muted }
                text r.value { at: rx + 90, nb_y + nb_h - 18; anchor: left center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(r.on, fl.engrave, fl.muted) }
                zone box trz { from: rx, nb_y + nb_h - 30; size: (nb_w - 40) / 3 - 8, 24; cursor: pointer; role: button; label: "{r.label} {r.value}"; show: nd_kind == 8 }
                on press trz { emit nd_tm(r.m) }
            }
        }
        // something finished: the node becomes a card that pulses until it is answered (a click on it, Esc, Space,
        // Return, or OK) — never by the pointer merely resting there, never by folding away
        group { show: nd_kind == 9
            group { glow: 20, 0.45 + 0.35 * sin(nd_dph), fl.ember
                box { from: nb_x, nb_y; size: nb_w, nb_h; corner: nb_r; color: fl.hull; opacity: 0.97 } }
            box { from: nb_x, nb_y; size: nb_w, nb_h; corner: nb_r; stroke: 1.5; color: fl.ember; opacity: 0.6 + 0.3 * sin(nd_dph) }
            group { opacity: nd_cf
                text nd_dnt { at: nb_x + 22, nb_y + 28; anchor: left center; size: 15; weight: 700; family: "Exo 2"; color: fl.engrave; width: nb_w - 140; lines: 1 }
                text nd_dnd { at: nb_x + 22, nb_y + 50; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.muted; width: nb_w - 140; lines: 1 }
                box { from: nb_x + nb_w - 92, nb_y + nb_h / 2 - 15; size: 72, 30; corner: 15 * max(0.3, nd_rnd); color: fl.ember; opacity: 0.9 }
                text "OK" { at: nb_x + nb_w - 56, nb_y + nb_h / 2; anchor: center; align: center; size: 11; weight: 700; family: "Share Tech Mono"; color: fl.ground } }
            zone box dnz { from: nb_x, nb_y; size: nb_w, nb_h; corner: nb_r; cursor: pointer; role: button; label: "{nd_dnt}: OK"; show: nd_kind == 9 }
            on press dnz { emit nd_dn }
        }
        // the player: the cover, the song, where in it (drag to go there), its transport, the music mirrored round
        // the middle along its floor, and three meters on the right — volume, the screen's light, the microphone
        group { show: nd_kind == 11; opacity: nd_cf
            clip box { from: nb_x, nb_y; size: nb_w, nb_h; corner: nb_r }
            let pw = nb_w - 164 - 160
            group { clip box { from: nb_x + 16, nb_y + 16; size: 132, 132; corner: if(nd_cov == 1, 66, max(3, 14 * nd_rnd)) }
                box { from: nb_x + 16, nb_y + 16; size: 132, 132; color: fl.well }
                image nd_cover { at: nb_x + 16, nb_y + 16; size: 132, 132; fit: cover; show: nd_arted } }
            text nd_title { at: nb_x + 164, nb_y + 32; anchor: left center; size: 16; weight: 700; family: "Exo 2"; color: fl.engrave; width: pw - 66; lines: 1 }
            text nd_artist { at: nb_x + 164, nb_y + 54; anchor: left center; size: 11; family: "Share Tech Mono"; color: fl.muted; width: pw; lines: 1 }
            box { from: nb_x + 164, nb_y + 78; size: pw, 3; corner: 1.5; color: fl.trace_dim }
            box { from: nb_x + 164, nb_y + 78; size: pw * nd_prog, 3; corner: 1.5; color: nd_acc }
            ellipse { at: nb_x + 164 + pw * nd_prog, nb_y + 79.5; radius: if(pkz.hover, 7, 5); color: nd_acc }
            text nd_pos { at: nb_x + 164, nb_y + 94; anchor: left center; size: 9; family: "Share Tech Mono"; color: fl.muted }
            text nd_len { at: nb_x + 164 + pw, nb_y + 94; anchor: right center; align: right; size: 9; family: "Share Tech Mono"; color: fl.muted }
            zone box pkz { from: nb_x + 158, nb_y + 68; size: pw + 12, 22; cursor: pointer; role: slider; label: "Where in the song"; value: "{nd_pos}"; show: nd_kind == 11 }
            on press pkz { emit nd_seek(round(clamp((pointer.x - nb_x - 164) / pw, 0, 1) * 1000)) }
            on drag pkz { emit nd_seek(round(clamp((pointer.x - nb_x - 164) / pw, 0, 1) * 1000)) }
            group { show: not nd_mix
                box { from: nb_x + 164 + 0, nb_y + 108; size: 38, 38; corner: 19 * max(0.3, nd_rnd); color: nd_acc; opacity: if(false, 0.9, if(nd_shuf, 0.22, if(pbz1.hover, 0.12, 0))) }
                text "⤮" { at: nb_x + 164 + 0 + 19, nb_y + 127; anchor: center; align: center; size: 15; family: "Exo 2"; color: if(false, fl.ground, if(nd_shuf, nd_acc, fl.engrave)) }
                zone box pbz1 { from: nb_x + 164 + 0, nb_y + 108; size: 38, 38; corner: 19; cursor: pointer; role: button; label: "Shuffle"; show: nd_kind == 11 }
                on press pbz1 { emit nd_pl(1) }
                box { from: nb_x + 164 + 46, nb_y + 108; size: 38, 38; corner: 19 * max(0.3, nd_rnd); color: nd_acc; opacity: if(false, 0.9, if(false, 0.22, if(pbz2.hover, 0.12, 0))) }
                text "⏮" { at: nb_x + 164 + 46 + 19, nb_y + 127; anchor: center; align: center; size: 15; family: "Exo 2"; color: if(false, fl.ground, if(false, nd_acc, fl.engrave)) }
                zone box pbz2 { from: nb_x + 164 + 46, nb_y + 108; size: 38, 38; corner: 19; cursor: pointer; role: button; label: "Back"; show: nd_kind == 11 }
                on press pbz2 { emit nd_pl(2) }
                box { from: nb_x + 164 + 92, nb_y + 108; size: 38, 38; corner: 19 * max(0.3, nd_rnd); color: nd_acc; opacity: if(true, 0.9, if(false, 0.22, if(pbz3.hover, 0.12, 0))) }
                text "⏯" { at: nb_x + 164 + 92 + 19, nb_y + 127; anchor: center; align: center; size: 17; family: "Exo 2"; color: if(true, fl.ground, if(false, nd_acc, fl.engrave)) }
                zone box pbz3 { from: nb_x + 164 + 92, nb_y + 108; size: 38, 38; corner: 19; cursor: pointer; role: button; label: "Play or pause"; show: nd_kind == 11 }
                on press pbz3 { emit nd_pl(3) }
                box { from: nb_x + 164 + 138, nb_y + 108; size: 38, 38; corner: 19 * max(0.3, nd_rnd); color: nd_acc; opacity: if(false, 0.9, if(false, 0.22, if(pbz4.hover, 0.12, 0))) }
                text "⏭" { at: nb_x + 164 + 138 + 19, nb_y + 127; anchor: center; align: center; size: 15; family: "Exo 2"; color: if(false, fl.ground, if(false, nd_acc, fl.engrave)) }
                zone box pbz4 { from: nb_x + 164 + 138, nb_y + 108; size: 38, 38; corner: 19; cursor: pointer; role: button; label: "Next"; show: nd_kind == 11 }
                on press pbz4 { emit nd_pl(4) }
                box { from: nb_x + 164 + 184, nb_y + 108; size: 38, 38; corner: 19 * max(0.3, nd_rnd); color: nd_acc; opacity: if(false, 0.9, if(nd_loop > 0, 0.22, if(pbz5.hover, 0.12, 0))) }
                text "⟲" { at: nb_x + 164 + 184 + 19, nb_y + 127; anchor: center; align: center; size: 15; family: "Exo 2"; color: if(false, fl.ground, if(nd_loop > 0, nd_acc, fl.engrave)) }
                zone box pbz5 { from: nb_x + 164 + 184, nb_y + 108; size: 38, 38; corner: 19; cursor: pointer; role: button; label: "Repeat"; show: nd_kind == 11 }
                on press pbz5 { emit nd_pl(5) }
                text "1" { at: nb_x + 164 + 4 * 46 + 30, nb_y + 116; anchor: center; size: 8; weight: 700; family: "Share Tech Mono"; color: nd_acc; show: nd_loop == 2 }
                // the music, mirrored: the low bands meet in the middle
                group { show: not nd_lyon
                    box { from: nb_x + 164 + 0 * pw / 32 + 1, nb_y + nb_h - 10 - nd_sp0 * 34; size: pw / 32 - 2, nd_sp0 * 34 + 1; corner: 1; color: nd_acc; opacity: 0.35 + 0.4 * nd_sp0 }
                    box { from: nb_x + 164 + 1 * pw / 32 + 1, nb_y + nb_h - 10 - nd_sp1 * 34; size: pw / 32 - 2, nd_sp1 * 34 + 1; corner: 1; color: nd_acc; opacity: 0.35 + 0.4 * nd_sp1 }
                    box { from: nb_x + 164 + 2 * pw / 32 + 1, nb_y + nb_h - 10 - nd_sp2 * 34; size: pw / 32 - 2, nd_sp2 * 34 + 1; corner: 1; color: nd_acc; opacity: 0.35 + 0.4 * nd_sp2 }
                    box { from: nb_x + 164 + 3 * pw / 32 + 1, nb_y + nb_h - 10 - nd_sp3 * 34; size: pw / 32 - 2, nd_sp3 * 34 + 1; corner: 1; color: nd_acc; opacity: 0.35 + 0.4 * nd_sp3 }
                    box { from: nb_x + 164 + 4 * pw / 32 + 1, nb_y + nb_h - 10 - nd_sp4 * 34; size: pw / 32 - 2, nd_sp4 * 34 + 1; corner: 1; color: nd_acc; opacity: 0.35 + 0.4 * nd_sp4 }
