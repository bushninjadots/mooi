                    box { from: nb_x + 164 + 16 * pw / 32 + 1, nb_y + nb_h - 10 - nd_sp16 * 34; size: pw / 32 - 2, nd_sp16 * 34 + 1; corner: 1; color: nd_acc; opacity: 0.35 + 0.4 * nd_sp16 }
                    box { from: nb_x + 164 + 17 * pw / 32 + 1, nb_y + nb_h - 10 - nd_sp17 * 34; size: pw / 32 - 2, nd_sp17 * 34 + 1; corner: 1; color: nd_acc; opacity: 0.35 + 0.4 * nd_sp17 }
                    box { from: nb_x + 164 + 18 * pw / 32 + 1, nb_y + nb_h - 10 - nd_sp18 * 34; size: pw / 32 - 2, nd_sp18 * 34 + 1; corner: 1; color: nd_acc; opacity: 0.35 + 0.4 * nd_sp18 }
                    box { from: nb_x + 164 + 19 * pw / 32 + 1, nb_y + nb_h - 10 - nd_sp19 * 34; size: pw / 32 - 2, nd_sp19 * 34 + 1; corner: 1; color: nd_acc; opacity: 0.35 + 0.4 * nd_sp19 }
                    box { from: nb_x + 164 + 20 * pw / 32 + 1, nb_y + nb_h - 10 - nd_sp20 * 34; size: pw / 32 - 2, nd_sp20 * 34 + 1; corner: 1; color: nd_acc; opacity: 0.35 + 0.4 * nd_sp20 }
                    box { from: nb_x + 164 + 21 * pw / 32 + 1, nb_y + nb_h - 10 - nd_sp21 * 34; size: pw / 32 - 2, nd_sp21 * 34 + 1; corner: 1; color: nd_acc; opacity: 0.35 + 0.4 * nd_sp21 }
                    box { from: nb_x + 164 + 22 * pw / 32 + 1, nb_y + nb_h - 10 - nd_sp22 * 34; size: pw / 32 - 2, nd_sp22 * 34 + 1; corner: 1; color: nd_acc; opacity: 0.35 + 0.4 * nd_sp22 }
                    box { from: nb_x + 164 + 23 * pw / 32 + 1, nb_y + nb_h - 10 - nd_sp23 * 34; size: pw / 32 - 2, nd_sp23 * 34 + 1; corner: 1; color: nd_acc; opacity: 0.35 + 0.4 * nd_sp23 }
                    box { from: nb_x + 164 + 24 * pw / 32 + 1, nb_y + nb_h - 10 - nd_sp24 * 34; size: pw / 32 - 2, nd_sp24 * 34 + 1; corner: 1; color: nd_acc; opacity: 0.35 + 0.4 * nd_sp24 }
                    box { from: nb_x + 164 + 25 * pw / 32 + 1, nb_y + nb_h - 10 - nd_sp25 * 34; size: pw / 32 - 2, nd_sp25 * 34 + 1; corner: 1; color: nd_acc; opacity: 0.35 + 0.4 * nd_sp25 }
                    box { from: nb_x + 164 + 26 * pw / 32 + 1, nb_y + nb_h - 10 - nd_sp26 * 34; size: pw / 32 - 2, nd_sp26 * 34 + 1; corner: 1; color: nd_acc; opacity: 0.35 + 0.4 * nd_sp26 }
                    box { from: nb_x + 164 + 27 * pw / 32 + 1, nb_y + nb_h - 10 - nd_sp27 * 34; size: pw / 32 - 2, nd_sp27 * 34 + 1; corner: 1; color: nd_acc; opacity: 0.35 + 0.4 * nd_sp27 }
                    box { from: nb_x + 164 + 28 * pw / 32 + 1, nb_y + nb_h - 10 - nd_sp28 * 34; size: pw / 32 - 2, nd_sp28 * 34 + 1; corner: 1; color: nd_acc; opacity: 0.35 + 0.4 * nd_sp28 }
                    box { from: nb_x + 164 + 29 * pw / 32 + 1, nb_y + nb_h - 10 - nd_sp29 * 34; size: pw / 32 - 2, nd_sp29 * 34 + 1; corner: 1; color: nd_acc; opacity: 0.35 + 0.4 * nd_sp29 }
                    box { from: nb_x + 164 + 30 * pw / 32 + 1, nb_y + nb_h - 10 - nd_sp30 * 34; size: pw / 32 - 2, nd_sp30 * 34 + 1; corner: 1; color: nd_acc; opacity: 0.35 + 0.4 * nd_sp30 }
                    box { from: nb_x + 164 + 31 * pw / 32 + 1, nb_y + nb_h - 10 - nd_sp31 * 34; size: pw / 32 - 2, nd_sp31 * 34 + 1; corner: 1; color: nd_acc; opacity: 0.35 + 0.4 * nd_sp31 }
                }
                // the words, in time: the line sung now, lit, and the next one under it
                group { show: nd_lyon
                    text nd_lyc { at: nb_x + 164, nb_y + 164; anchor: left center; size: 13; weight: 600; family: "Exo 2"; color: nd_acc; width: pw; lines: 1 }
                    text nd_lyn { at: nb_x + 164, nb_y + 183; anchor: left center; size: 10; family: "Exo 2"; color: fl.muted; width: pw; lines: 1 } }
            }
            group { show: nd_mix
                for a in mx {
                    let my = nb_y + 104 + a.index * 24
                    text a.name { at: nb_x + 164, my + 8; anchor: left center; size: 10; family: "Exo 2"; color: if(a.muted, fl.muted, fl.engrave); width: 110; lines: 1 }
                    box { from: nb_x + 280, my + 6; size: pw - 150, 4; corner: 2; color: fl.trace_dim }
                    box { from: nb_x + 280, my + 6; size: (pw - 150) * a.vol, 4; corner: 2; color: if(a.muted, fl.trace_lit, nd_acc) }
                    zone box mxz { from: nb_x + 274, my - 2; size: pw - 138, 20; cursor: ew_resize; role: slider; label: "{a.name}"; value: a.vol; show: nd_kind == 11 and nd_mix }
                    on press mxz { emit nd_mx(a.index * 2000 + round(clamp((pointer.x - nb_x - 280) / (pw - 150), 0, 1) * 1000)) }
                    on drag mxz { emit nd_mx(a.index * 2000 + round(clamp((pointer.x - nb_x - 280) / (pw - 150), 0, 1) * 1000)) }
                    text if(a.muted, "MUTED", "MUTE") { at: nb_x + 164 + pw, my + 8; anchor: right center; align: right; size: 8; weight: 700; family: "Share Tech Mono"; color: if(a.muted, fl.ember, if(mxmz.hover, fl.engrave, fl.muted)) }
                    zone box mxmz { from: nb_x + 164 + pw - 40, my - 2; size: 42, 20; cursor: pointer; role: toggle; label: "Mute {a.name}"; checked: a.muted; show: nd_kind == 11 and nd_mix }
                    on press mxmz { emit nd_mxm(a.index) }
                }
                text "NOTHING ELSE PLAYS" { at: nb_x + 164, nb_y + 112; anchor: left center; size: 9; family: "Share Tech Mono"; color: fl.muted; show: mx.count == 0 }
            }
            // the page's switch
            text if(nd_mix, "PLAYER", "MIX") { at: nb_x + 164 + pw, nb_y + 32; anchor: right center; align: right; size: 9; weight: 700; family: "Share Tech Mono"; color: if(pmxz.hover or nd_mix, nd_acc, fl.muted) }
            zone box pmxz { from: nb_x + 164 + pw - 56, nb_y + 21; size: 58, 22; cursor: pointer; role: toggle; label: "Each app's volume"; checked: nd_mix; show: nd_kind == 11 }
            on press pmxz { emit nd_pl(7) }
            group { show: true
                box { from: nb_x + nb_w - 136, nb_y + 154; size: 30, 9; corner: 2 * max(0.3, nd_rnd); color: if(0 < round(nd_vol * 12), if(0 == 2 and nd_micm, fl.trace_lit, nd_acc), fl.trace_dim); opacity: if(0 < round(nd_vol * 12), 0.95, 0.5) }
                box { from: nb_x + nb_w - 136, nb_y + 142; size: 30, 9; corner: 2 * max(0.3, nd_rnd); color: if(1 < round(nd_vol * 12), if(0 == 2 and nd_micm, fl.trace_lit, nd_acc), fl.trace_dim); opacity: if(1 < round(nd_vol * 12), 0.95, 0.5) }
                box { from: nb_x + nb_w - 136, nb_y + 130; size: 30, 9; corner: 2 * max(0.3, nd_rnd); color: if(2 < round(nd_vol * 12), if(0 == 2 and nd_micm, fl.trace_lit, nd_acc), fl.trace_dim); opacity: if(2 < round(nd_vol * 12), 0.95, 0.5) }
                box { from: nb_x + nb_w - 136, nb_y + 118; size: 30, 9; corner: 2 * max(0.3, nd_rnd); color: if(3 < round(nd_vol * 12), if(0 == 2 and nd_micm, fl.trace_lit, nd_acc), fl.trace_dim); opacity: if(3 < round(nd_vol * 12), 0.95, 0.5) }
                box { from: nb_x + nb_w - 136, nb_y + 106; size: 30, 9; corner: 2 * max(0.3, nd_rnd); color: if(4 < round(nd_vol * 12), if(0 == 2 and nd_micm, fl.trace_lit, nd_acc), fl.trace_dim); opacity: if(4 < round(nd_vol * 12), 0.95, 0.5) }
                box { from: nb_x + nb_w - 136, nb_y + 94; size: 30, 9; corner: 2 * max(0.3, nd_rnd); color: if(5 < round(nd_vol * 12), if(0 == 2 and nd_micm, fl.trace_lit, nd_acc), fl.trace_dim); opacity: if(5 < round(nd_vol * 12), 0.95, 0.5) }
                box { from: nb_x + nb_w - 136, nb_y + 82; size: 30, 9; corner: 2 * max(0.3, nd_rnd); color: if(6 < round(nd_vol * 12), if(0 == 2 and nd_micm, fl.trace_lit, nd_acc), fl.trace_dim); opacity: if(6 < round(nd_vol * 12), 0.95, 0.5) }
                box { from: nb_x + nb_w - 136, nb_y + 70; size: 30, 9; corner: 2 * max(0.3, nd_rnd); color: if(7 < round(nd_vol * 12), if(0 == 2 and nd_micm, fl.trace_lit, nd_acc), fl.trace_dim); opacity: if(7 < round(nd_vol * 12), 0.95, 0.5) }
                box { from: nb_x + nb_w - 136, nb_y + 58; size: 30, 9; corner: 2 * max(0.3, nd_rnd); color: if(8 < round(nd_vol * 12), if(0 == 2 and nd_micm, fl.trace_lit, nd_acc), fl.trace_dim); opacity: if(8 < round(nd_vol * 12), 0.95, 0.5) }
                box { from: nb_x + nb_w - 136, nb_y + 46; size: 30, 9; corner: 2 * max(0.3, nd_rnd); color: if(9 < round(nd_vol * 12), if(0 == 2 and nd_micm, fl.trace_lit, nd_acc), fl.trace_dim); opacity: if(9 < round(nd_vol * 12), 0.95, 0.5) }
                box { from: nb_x + nb_w - 136, nb_y + 34; size: 30, 9; corner: 2 * max(0.3, nd_rnd); color: if(10 < round(nd_vol * 12), if(0 == 2 and nd_micm, fl.trace_lit, nd_acc), fl.trace_dim); opacity: if(10 < round(nd_vol * 12), 0.95, 0.5) }
                box { from: nb_x + nb_w - 136, nb_y + 22; size: 30, 9; corner: 2 * max(0.3, nd_rnd); color: if(11 < round(nd_vol * 12), if(0 == 2 and nd_micm, fl.trace_lit, nd_acc), fl.trace_dim); opacity: if(11 < round(nd_vol * 12), 0.95, 0.5) }
                text "VOL" { at: nb_x + nb_w - 136 + 15, nb_y + 178; anchor: center; align: center; size: 8; weight: 700; family: "Share Tech Mono"; color: if(0 == 2 and nd_micm, fl.ember, fl.muted) }
                zone box pmz0 { from: nb_x + nb_w - 136 - 4, nb_y + 18; size: 38, 148; cursor: ns_resize; role: slider; label: "Vol"; value: nd_vol; show: nd_kind == 11 }
                on press pmz0 { emit nd_mt(0 * 2000 + round(clamp((nb_y + 163 - pointer.y) / 144, 0, 1) * 1000)) }
                on drag pmz0 { emit nd_mt(0 * 2000 + round(clamp((nb_y + 163 - pointer.y) / 144, 0, 1) * 1000)) }
            }
            group { show: nd_hasbri
                box { from: nb_x + nb_w - 92, nb_y + 154; size: 30, 9; corner: 2 * max(0.3, nd_rnd); color: if(0 < round(nd_bri * 12), if(1 == 2 and nd_micm, fl.trace_lit, nd_acc), fl.trace_dim); opacity: if(0 < round(nd_bri * 12), 0.95, 0.5) }
                box { from: nb_x + nb_w - 92, nb_y + 142; size: 30, 9; corner: 2 * max(0.3, nd_rnd); color: if(1 < round(nd_bri * 12), if(1 == 2 and nd_micm, fl.trace_lit, nd_acc), fl.trace_dim); opacity: if(1 < round(nd_bri * 12), 0.95, 0.5) }
                box { from: nb_x + nb_w - 92, nb_y + 130; size: 30, 9; corner: 2 * max(0.3, nd_rnd); color: if(2 < round(nd_bri * 12), if(1 == 2 and nd_micm, fl.trace_lit, nd_acc), fl.trace_dim); opacity: if(2 < round(nd_bri * 12), 0.95, 0.5) }
                box { from: nb_x + nb_w - 92, nb_y + 118; size: 30, 9; corner: 2 * max(0.3, nd_rnd); color: if(3 < round(nd_bri * 12), if(1 == 2 and nd_micm, fl.trace_lit, nd_acc), fl.trace_dim); opacity: if(3 < round(nd_bri * 12), 0.95, 0.5) }
                box { from: nb_x + nb_w - 92, nb_y + 106; size: 30, 9; corner: 2 * max(0.3, nd_rnd); color: if(4 < round(nd_bri * 12), if(1 == 2 and nd_micm, fl.trace_lit, nd_acc), fl.trace_dim); opacity: if(4 < round(nd_bri * 12), 0.95, 0.5) }
                box { from: nb_x + nb_w - 92, nb_y + 94; size: 30, 9; corner: 2 * max(0.3, nd_rnd); color: if(5 < round(nd_bri * 12), if(1 == 2 and nd_micm, fl.trace_lit, nd_acc), fl.trace_dim); opacity: if(5 < round(nd_bri * 12), 0.95, 0.5) }
                box { from: nb_x + nb_w - 92, nb_y + 82; size: 30, 9; corner: 2 * max(0.3, nd_rnd); color: if(6 < round(nd_bri * 12), if(1 == 2 and nd_micm, fl.trace_lit, nd_acc), fl.trace_dim); opacity: if(6 < round(nd_bri * 12), 0.95, 0.5) }
                box { from: nb_x + nb_w - 92, nb_y + 70; size: 30, 9; corner: 2 * max(0.3, nd_rnd); color: if(7 < round(nd_bri * 12), if(1 == 2 and nd_micm, fl.trace_lit, nd_acc), fl.trace_dim); opacity: if(7 < round(nd_bri * 12), 0.95, 0.5) }
                box { from: nb_x + nb_w - 92, nb_y + 58; size: 30, 9; corner: 2 * max(0.3, nd_rnd); color: if(8 < round(nd_bri * 12), if(1 == 2 and nd_micm, fl.trace_lit, nd_acc), fl.trace_dim); opacity: if(8 < round(nd_bri * 12), 0.95, 0.5) }
                box { from: nb_x + nb_w - 92, nb_y + 46; size: 30, 9; corner: 2 * max(0.3, nd_rnd); color: if(9 < round(nd_bri * 12), if(1 == 2 and nd_micm, fl.trace_lit, nd_acc), fl.trace_dim); opacity: if(9 < round(nd_bri * 12), 0.95, 0.5) }
                box { from: nb_x + nb_w - 92, nb_y + 34; size: 30, 9; corner: 2 * max(0.3, nd_rnd); color: if(10 < round(nd_bri * 12), if(1 == 2 and nd_micm, fl.trace_lit, nd_acc), fl.trace_dim); opacity: if(10 < round(nd_bri * 12), 0.95, 0.5) }
                box { from: nb_x + nb_w - 92, nb_y + 22; size: 30, 9; corner: 2 * max(0.3, nd_rnd); color: if(11 < round(nd_bri * 12), if(1 == 2 and nd_micm, fl.trace_lit, nd_acc), fl.trace_dim); opacity: if(11 < round(nd_bri * 12), 0.95, 0.5) }
                text "LIGHT" { at: nb_x + nb_w - 92 + 15, nb_y + 178; anchor: center; align: center; size: 8; weight: 700; family: "Share Tech Mono"; color: if(1 == 2 and nd_micm, fl.ember, fl.muted) }
                zone box pmz1 { from: nb_x + nb_w - 92 - 4, nb_y + 18; size: 38, 148; cursor: ns_resize; role: slider; label: "Light"; value: nd_bri; show: nd_kind == 11 }
                on press pmz1 { emit nd_mt(1 * 2000 + round(clamp((nb_y + 163 - pointer.y) / 144, 0, 1) * 1000)) }
                on drag pmz1 { emit nd_mt(1 * 2000 + round(clamp((nb_y + 163 - pointer.y) / 144, 0, 1) * 1000)) }
            }
            group { show: true
                box { from: nb_x + nb_w - 48, nb_y + 154; size: 30, 9; corner: 2 * max(0.3, nd_rnd); color: if(0 < round(nd_mic * 12), if(2 == 2 and nd_micm, fl.trace_lit, nd_acc), fl.trace_dim); opacity: if(0 < round(nd_mic * 12), 0.95, 0.5) }
                box { from: nb_x + nb_w - 48, nb_y + 142; size: 30, 9; corner: 2 * max(0.3, nd_rnd); color: if(1 < round(nd_mic * 12), if(2 == 2 and nd_micm, fl.trace_lit, nd_acc), fl.trace_dim); opacity: if(1 < round(nd_mic * 12), 0.95, 0.5) }
                box { from: nb_x + nb_w - 48, nb_y + 130; size: 30, 9; corner: 2 * max(0.3, nd_rnd); color: if(2 < round(nd_mic * 12), if(2 == 2 and nd_micm, fl.trace_lit, nd_acc), fl.trace_dim); opacity: if(2 < round(nd_mic * 12), 0.95, 0.5) }
                box { from: nb_x + nb_w - 48, nb_y + 118; size: 30, 9; corner: 2 * max(0.3, nd_rnd); color: if(3 < round(nd_mic * 12), if(2 == 2 and nd_micm, fl.trace_lit, nd_acc), fl.trace_dim); opacity: if(3 < round(nd_mic * 12), 0.95, 0.5) }
                box { from: nb_x + nb_w - 48, nb_y + 106; size: 30, 9; corner: 2 * max(0.3, nd_rnd); color: if(4 < round(nd_mic * 12), if(2 == 2 and nd_micm, fl.trace_lit, nd_acc), fl.trace_dim); opacity: if(4 < round(nd_mic * 12), 0.95, 0.5) }
                box { from: nb_x + nb_w - 48, nb_y + 94; size: 30, 9; corner: 2 * max(0.3, nd_rnd); color: if(5 < round(nd_mic * 12), if(2 == 2 and nd_micm, fl.trace_lit, nd_acc), fl.trace_dim); opacity: if(5 < round(nd_mic * 12), 0.95, 0.5) }
                box { from: nb_x + nb_w - 48, nb_y + 82; size: 30, 9; corner: 2 * max(0.3, nd_rnd); color: if(6 < round(nd_mic * 12), if(2 == 2 and nd_micm, fl.trace_lit, nd_acc), fl.trace_dim); opacity: if(6 < round(nd_mic * 12), 0.95, 0.5) }
                box { from: nb_x + nb_w - 48, nb_y + 70; size: 30, 9; corner: 2 * max(0.3, nd_rnd); color: if(7 < round(nd_mic * 12), if(2 == 2 and nd_micm, fl.trace_lit, nd_acc), fl.trace_dim); opacity: if(7 < round(nd_mic * 12), 0.95, 0.5) }
                box { from: nb_x + nb_w - 48, nb_y + 58; size: 30, 9; corner: 2 * max(0.3, nd_rnd); color: if(8 < round(nd_mic * 12), if(2 == 2 and nd_micm, fl.trace_lit, nd_acc), fl.trace_dim); opacity: if(8 < round(nd_mic * 12), 0.95, 0.5) }
                box { from: nb_x + nb_w - 48, nb_y + 46; size: 30, 9; corner: 2 * max(0.3, nd_rnd); color: if(9 < round(nd_mic * 12), if(2 == 2 and nd_micm, fl.trace_lit, nd_acc), fl.trace_dim); opacity: if(9 < round(nd_mic * 12), 0.95, 0.5) }
                box { from: nb_x + nb_w - 48, nb_y + 34; size: 30, 9; corner: 2 * max(0.3, nd_rnd); color: if(10 < round(nd_mic * 12), if(2 == 2 and nd_micm, fl.trace_lit, nd_acc), fl.trace_dim); opacity: if(10 < round(nd_mic * 12), 0.95, 0.5) }
                box { from: nb_x + nb_w - 48, nb_y + 22; size: 30, 9; corner: 2 * max(0.3, nd_rnd); color: if(11 < round(nd_mic * 12), if(2 == 2 and nd_micm, fl.trace_lit, nd_acc), fl.trace_dim); opacity: if(11 < round(nd_mic * 12), 0.95, 0.5) }
                text "MIC" { at: nb_x + nb_w - 48 + 15, nb_y + 178; anchor: center; align: center; size: 8; weight: 700; family: "Share Tech Mono"; color: if(2 == 2 and nd_micm, fl.ember, fl.muted) }
                zone box pmz2 { from: nb_x + nb_w - 48 - 4, nb_y + 18; size: 38, 148; cursor: ns_resize; role: slider; label: "Mic"; value: nd_mic; show: nd_kind == 11 }
                on press pmz2 { emit nd_mt(2 * 2000 + round(clamp((nb_y + 163 - pointer.y) / 144, 0, 1) * 1000)) }
                on drag pmz2 { emit nd_mt(2 * 2000 + round(clamp((nb_y + 163 - pointer.y) / 144, 0, 1) * 1000)) }
                zone box pmmz { from: nb_x + nb_w - 48 - 4, nb_y + 170; size: 38, 18; cursor: pointer; role: toggle; label: "Mute the microphone"; checked: nd_micm; show: nd_kind == 11 }
                on press pmmz { emit nd_pl(6) }
            }
        }
        // privacy: the microphone or the camera, the moment it starts or stops, and who has it
        group { show: nd_kind == 10; opacity: nd_cf
            group { glow: 10, if(nd_pvon, 0.8, 0.2), fl.ember
                ellipse { at: nb_x + 22, nb_y + nb_h / 2; radius: 5; color: if(nd_pvon, fl.ember, fl.trace_lit) } }
            text nd_pvt { at: nb_x + 38, nb_y + nb_h / 2 - 7; anchor: left center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(nd_pvon, fl.ember, fl.engrave) }
            text nd_pvd { at: nb_x + 38, nb_y + nb_h / 2 + 8; anchor: left center; size: 10; family: "Exo 2"; color: fl.muted; width: nb_w - 50; lines: 1 }
        }
        // satellites: they leave the seed for their place on the arc and come back into it; organic ones drift.
        // Pills (a word), dots (a point), or ticks (a stroke and a word under it)
        for s in sa {
            let g = clamp(nd_sf * (1 + 0.5 * nd_stg) - s.index * 0.15 * nd_stg, 0, 1)
            let drift = if(nd_np == 0, sin(nd_ph + s.index * 60) * 2, 0)
            let sx = nb_x + nb_w / 2 - s.w / 2 + (s.x - (nb_x + nb_w / 2 - s.w / 2)) * g
            let sy = nb_y + (s.y - nb_y) * g + drift
            let warm = s.kind == 2 or s.kind == 3 or s.kind == 4 or s.kind == 7 or s.kind == 9
            group { opacity: g; show: g > 0.01
                line { from: nb_x + nb_w / 2, nb_y + nb_h; to: sx + s.w / 2, sy; width: 1; color: fl.trace_lit; opacity: 0.35 }
                group { show: nd_sst == 0
                    box { from: sx, sy; size: s.w, s.h; corner: s.h / 2 * max(0.2, nd_rnd); color: fl.hull; opacity: 0.92 }
                    box { from: sx, sy; size: s.w, s.h; corner: s.h / 2 * max(0.2, nd_rnd); stroke: 1; color: if(warm, fl.ember, nd_acc); opacity: 0.8 }
                    text s.label { at: sx + s.w / 2, sy + s.h / 2; anchor: center; align: center; size: 9; weight: 700; family: "Share Tech Mono"; color: fl.engrave; width: s.w - 10; lines: 1 } }
                group { show: nd_sst == 1; glow: 8, 0.6 * nd_gw, if(warm, fl.ember, nd_glc)
                    ellipse { at: sx + s.w / 2, sy + s.h / 2; radius: if(saz.hover, 5, 3.5); color: if(warm, fl.ember, nd_acc) } }
                group { show: nd_sst == 2
                    box { from: sx + s.w / 2 - 1, sy; size: 2, 10; color: if(warm, fl.ember, nd_acc) }
                    text s.label { at: sx + s.w / 2, sy + 18; anchor: center; align: center; size: 8; family: "Share Tech Mono"; color: fl.muted; width: s.w; lines: 1 } }
            }
            zone box saz { from: s.x, s.y; size: s.w, s.h; cursor: pointer; role: button; label: "{s.label}"; show: nd_kind == 0 and g > 0.9 and not nd_studio }
            on press saz { emit nd_sa(s.kind) }
        }
        // the deck: the pages of what the node may look like
        group { show: nd_stf > 0.01; opacity: nd_stf; move: 0, 40 * (1 - nd_stf)
            group { glow: 24, 0.4, #000000
                box { from: st_x, st_dy; size: 940, 470; corner: 18; color: fl.hull; opacity: 0.97 } }
            box { from: st_x, st_dy; size: 940, 470; corner: 18; stroke: 1; color: fl.trace_dim }
            text "Presets" { at: st_x + 20 + 38, st_dy + 36; anchor: center; align: center; size: 13; weight: if(nd_tab == 0, 700, 500); family: "Exo 2"; color: if(nd_tab == 0, fl.engrave, fl.muted) }
            box { from: st_x + 20 + 12, st_dy + 52; size: 52, 2; corner: 1; color: nd_acc; show: nd_tab == 0 }
            zone box stt0 { from: st_x + 20, st_dy + 18; size: 76, 38; cursor: pointer; role: tab; label: "Presets"; selected: nd_tab == 0; show: nd_studio }
            on press stt0 { emit nd_tab(0) }
            text "Shape" { at: st_x + 99 + 38, st_dy + 36; anchor: center; align: center; size: 13; weight: if(nd_tab == 1, 700, 500); family: "Exo 2"; color: if(nd_tab == 1, fl.engrave, fl.muted) }
            box { from: st_x + 99 + 12, st_dy + 52; size: 52, 2; corner: 1; color: nd_acc; show: nd_tab == 1 }
            zone box stt1 { from: st_x + 99, st_dy + 18; size: 76, 38; cursor: pointer; role: tab; label: "Shape"; selected: nd_tab == 1; show: nd_studio }
            on press stt1 { emit nd_tab(1) }
            text "Surface" { at: st_x + 178 + 38, st_dy + 36; anchor: center; align: center; size: 13; weight: if(nd_tab == 2, 700, 500); family: "Exo 2"; color: if(nd_tab == 2, fl.engrave, fl.muted) }
            box { from: st_x + 178 + 12, st_dy + 52; size: 52, 2; corner: 1; color: nd_acc; show: nd_tab == 2 }
            zone box stt2 { from: st_x + 178, st_dy + 18; size: 76, 38; cursor: pointer; role: tab; label: "Surface"; selected: nd_tab == 2; show: nd_studio }
            on press stt2 { emit nd_tab(2) }
            text "Motion" { at: st_x + 257 + 38, st_dy + 36; anchor: center; align: center; size: 13; weight: if(nd_tab == 3, 700, 500); family: "Exo 2"; color: if(nd_tab == 3, fl.engrave, fl.muted) }
            box { from: st_x + 257 + 12, st_dy + 52; size: 52, 2; corner: 1; color: nd_acc; show: nd_tab == 3 }
            zone box stt3 { from: st_x + 257, st_dy + 18; size: 76, 38; cursor: pointer; role: tab; label: "Motion"; selected: nd_tab == 3; show: nd_studio }
            on press stt3 { emit nd_tab(3) }
            text "Music" { at: st_x + 336 + 38, st_dy + 36; anchor: center; align: center; size: 13; weight: if(nd_tab == 4, 700, 500); family: "Exo 2"; color: if(nd_tab == 4, fl.engrave, fl.muted) }
            box { from: st_x + 336 + 12, st_dy + 52; size: 52, 2; corner: 1; color: nd_acc; show: nd_tab == 4 }
            zone box stt4 { from: st_x + 336, st_dy + 18; size: 76, 38; cursor: pointer; role: tab; label: "Music"; selected: nd_tab == 4; show: nd_studio }
            on press stt4 { emit nd_tab(4) }
            text "Parts" { at: st_x + 415 + 38, st_dy + 36; anchor: center; align: center; size: 13; weight: if(nd_tab == 5, 700, 500); family: "Exo 2"; color: if(nd_tab == 5, fl.engrave, fl.muted) }
            box { from: st_x + 415 + 12, st_dy + 52; size: 52, 2; corner: 1; color: nd_acc; show: nd_tab == 5 }
            zone box stt5 { from: st_x + 415, st_dy + 18; size: 76, 38; cursor: pointer; role: tab; label: "Parts"; selected: nd_tab == 5; show: nd_studio }
            on press stt5 { emit nd_tab(5) }
            box { from: st_x + 940 - 24 - 336, st_dy + 22; size: 100, 30; corner: 30 / 2; color: nd_acc; opacity: if(false, 0.9, if(stc3.hover, 0.18, 0)) }
            box { from: st_x + 940 - 24 - 336, st_dy + 22; size: 100, 30; corner: 30 / 2; stroke: 1; color: if(false, nd_acc, fl.trace_lit) }
            text "RESET" { at: st_x + 940 - 24 - 336 + 100 / 2, st_dy + 22 + 30 / 2; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(false, fl.ground, fl.engrave) }
            zone box stc3 { from: st_x + 940 - 24 - 336, st_dy + 22; size: 100, 30; corner: 30 / 2; cursor: pointer; role: button; label: "Reset"; show: nd_studio }
            on press stc3 { emit nd_stc(3) }
            box { from: st_x + 940 - 24 - 224, st_dy + 22; size: 108, 30; corner: 30 / 2; color: nd_acc; opacity: if(false, 0.9, if(stc1.hover, 0.18, 0)) }
            box { from: st_x + 940 - 24 - 224, st_dy + 22; size: 108, 30; corner: 30 / 2; stroke: 1; color: if(false, nd_acc, fl.trace_lit) }
            text "SHUFFLE" { at: st_x + 940 - 24 - 224 + 108 / 2, st_dy + 22 + 30 / 2; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(false, fl.ground, fl.engrave) }
            zone box stc1 { from: st_x + 940 - 24 - 224, st_dy + 22; size: 108, 30; corner: 30 / 2; cursor: pointer; role: button; label: "Shuffle"; show: nd_studio }
            on press stc1 { emit nd_stc(1) }
            box { from: st_x + 940 - 24 - 104, st_dy + 22; size: 104, 30; corner: 30 / 2; color: nd_acc; opacity: if(true, 0.9, if(stc2.hover, 0.18, 0)) }
            box { from: st_x + 940 - 24 - 104, st_dy + 22; size: 104, 30; corner: 30 / 2; stroke: 1; color: if(true, nd_acc, fl.trace_lit) }
            text "DONE" { at: st_x + 940 - 24 - 104 + 104 / 2, st_dy + 22 + 30 / 2; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(true, fl.ground, fl.engrave) }
            zone box stc2 { from: st_x + 940 - 24 - 104, st_dy + 22; size: 104, 30; corner: 30 / 2; cursor: pointer; role: button; label: "Done"; show: nd_studio }
            on press stc2 { emit nd_stc(2) }
            line { from: st_x + 16, st_dy + 64; to: st_x + 924, st_dy + 64; width: 1; color: fl.trace_dim }
            // the presets: four characters to start from (each card draws its own seed, three times its size)
            group { show: nd_tab == 0
                for p in ps {
                    let px = st_x + 24 + p.index * 226
                    let py = st_dy + 80
                    let pr = min(p.sw, p.sh) * 1.5 * p.sr
                    box { from: px, py; size: 214, 126; corner: 14; color: if(p.on, fl.hull_raised, fl.well); opacity: 0.9 }
                    box { from: px, py; size: 214, 126; corner: 14; stroke: if(p.on, 2, 1); color: if(p.on, nd_acc, if(psz.hover, fl.trace_lit, fl.trace_dim)) }
                    group { glow: 10, 0.5, nd_glc
                        box { from: px + 107 - p.sw * 1.5, py + 30 - p.sh * 1.5; size: p.sw * 3, p.sh * 3; corner: pr; color: nd_acc; show: p.seed != 2 and p.seed != 3 }
                        box { from: px + 107 - p.sw * 1.5, py + 30 - p.sh * 1.5; size: p.sw * 1.35, p.sh * 3; corner: pr; color: nd_acc; show: p.seed == 3 }
                        box { from: px + 107 + p.sw * 0.15, py + 30 - p.sh * 1.5; size: p.sw * 1.35, p.sh * 3; corner: pr; color: nd_acc; show: p.seed == 3 } }
                    box { from: px + 107 - p.sw * 1.5, py + 30 - p.sh * 1.5; size: p.sw * 3, p.sh * 3; corner: pr; stroke: 2; color: nd_acc; show: p.seed == 2 }
                    text p.name { at: px + 18, py + 66; anchor: left center; size: 15; weight: 700; family: "Exo 2"; color: fl.engrave }
                    text p.desc { at: px + 18, py + 82; anchor: left top; size: 10; family: "Exo 2"; color: fl.muted; width: 180; lines: 2 }
                    zone box psz { from: px, py; size: 214, 126; corner: 14; cursor: pointer; role: item; label: "Wear {p.name}"; selected: p.on; show: nd_studio and nd_tab == 0 }
                    on press psz { emit nd_ps(p.index) }
                }
                text "YOUR LOOKS" { at: st_x + 24, st_dy + 232; anchor: left center; size: 9; weight: 700; family: "Share Tech Mono"; color: fl.muted }
                for s in sl {
                    let sy0 = st_dy + 246 + s.index * 52
                    box { from: st_x + 24, sy0; size: 892, 44; corner: 12; color: fl.well; opacity: 0.8 }
                    text "{s.index + 1, 0}" { at: st_x + 46, sy0 + 22; anchor: center; align: center; size: 13; weight: 700; family: "Share Tech Mono"; color: if(s.full, nd_acc, fl.muted) }
                    text s.label { at: st_x + 70, sy0 + 22; anchor: left center; size: 12; family: "Exo 2"; color: if(s.full, fl.engrave, fl.muted); width: 500; lines: 1 }
                    box { from: st_x + 916 - 330, sy0 + 8; size: 120, 28; corner: 28 / 2; color: nd_acc; opacity: if(false, 0.9, if(sls.hover, 0.18, 0)) }
                    box { from: st_x + 916 - 330, sy0 + 8; size: 120, 28; corner: 28 / 2; stroke: 1; color: if(false, nd_acc, fl.trace_lit) }
                    text "SAVE HERE" { at: st_x + 916 - 330 + 120 / 2, sy0 + 8 + 28 / 2; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(false, fl.ground, fl.engrave) }
                    zone box sls { from: st_x + 916 - 330, sy0 + 8; size: 120, 28; corner: 28 / 2; cursor: pointer; role: button; label: "Save here"; show: nd_studio }
                    on press sls { emit nd_slot(s.index * 10) }
                    group { show: s.full
                        box { from: st_x + 916 - 202, sy0 + 8; size: 100, 28; corner: 28 / 2; color: nd_acc; opacity: if(false, 0.9, if(slw.hover, 0.18, 0)) }
                        box { from: st_x + 916 - 202, sy0 + 8; size: 100, 28; corner: 28 / 2; stroke: 1; color: if(false, nd_acc, fl.trace_lit) }
                        text "WEAR" { at: st_x + 916 - 202 + 100 / 2, sy0 + 8 + 28 / 2; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(false, fl.ground, fl.engrave) }
                        zone box slw { from: st_x + 916 - 202, sy0 + 8; size: 100, 28; corner: 28 / 2; cursor: pointer; role: button; label: "Wear"; show: nd_studio }
                        on press slw { emit nd_slot(s.index * 10 + 1) }
                        box { from: st_x + 916 - 94, sy0 + 8; size: 94, 28; corner: 28 / 2; color: nd_acc; opacity: if(false, 0.9, if(slx.hover, 0.18, 0)) }
                        box { from: st_x + 916 - 94, sy0 + 8; size: 94, 28; corner: 28 / 2; stroke: 1; color: if(false, nd_acc, fl.trace_lit) }
                        text "CLEAR" { at: st_x + 916 - 94 + 94 / 2, sy0 + 8 + 28 / 2; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(false, fl.ground, fl.engrave) }
                        zone box slx { from: st_x + 916 - 94, sy0 + 8; size: 94, 28; corner: 28 / 2; cursor: pointer; role: button; label: "Clear"; show: nd_studio }
                        on press slx { emit nd_slot(s.index * 10 + 9) }
                    }
                }
            }
            // the modules (D257): what the long pill or the notch holds, in its order — ‹ › to move one, × to take it
            // out; a press on one of the rest adds it at the end
            group { show: nd_tab == 1
                text "IN THE PILL" { at: st_x + 24, st_dy + 196; anchor: left center; size: 9; weight: 700; family: "Share Tech Mono"; color: fl.muted }
                text "EMPTY: ADD ONE BELOW" { at: st_x + 130, st_dy + 196; anchor: left center; size: 9; family: "Share Tech Mono"; color: fl.muted; show: md.count == 0 }
                for m in md {
                    let mx = st_x + 24 + m.index * 148
                    box { from: mx, st_dy + 210; size: 140, 36; corner: 18 * max(0.3, nd_rnd); color: fl.hull_raised }
                    box { from: mx, st_dy + 210; size: 140, 36; corner: 18 * max(0.3, nd_rnd); stroke: 1; color: nd_acc; opacity: 0.8 }
                    text m.label { at: mx + 70, st_dy + 228; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: fl.engrave; width: 84; lines: 1 }
                    text "‹" { at: mx + 14, st_dy + 228; anchor: center; size: 15; family: "Exo 2"; color: if(mdl.hover, nd_acc, fl.muted); show: m.index > 0 }
                    text "›" { at: mx + 126, st_dy + 228; anchor: center; size: 15; family: "Exo 2"; color: if(mdr.hover, nd_acc, fl.muted); show: m.index < md.count - 1 }
                    ellipse { at: mx + 136, st_dy + 212; radius: 8; color: if(mdx.hover, fl.ember, fl.hull) }
                    text "×" { at: mx + 136, st_dy + 212; anchor: center; size: 11; family: "Exo 2"; color: if(mdx.hover, fl.ground, fl.engrave) }
                    zone box mdl { from: mx, st_dy + 210; size: 28, 36; cursor: pointer; role: button; label: "Move {m.label} left"; show: nd_studio and nd_tab == 1 and m.index > 0 }
                    on press mdl { emit nd_md(m.index * 10 + 1) }
                    zone box mdr { from: mx + 112, st_dy + 210; size: 28, 36; cursor: pointer; role: button; label: "Move {m.label} right"; show: nd_studio and nd_tab == 1 and m.index < md.count - 1 }
                    on press mdr { emit nd_md(m.index * 10 + 2) }
                    zone box mdx { from: mx + 127, st_dy + 203; size: 18, 18; corner: 9; cursor: pointer; role: button; label: "Take {m.label} out"; show: nd_studio and nd_tab == 1 }
                    on press mdx { emit nd_md(m.index * 10 + 9) }
                }
                text "ADD" { at: st_x + 24, st_dy + 268; anchor: left center; size: 9; weight: 700; family: "Share Tech Mono"; color: fl.muted }
                text "FULL: SIX AT MOST" { at: st_x + 70, st_dy + 268; anchor: left center; size: 9; family: "Share Tech Mono"; color: fl.muted; show: md.count >= 6 }
                for a in ma {
                    let ax = st_x + 24 + (a.index - floor(a.index / 8) * 8) * 112
                    let ay = st_dy + 282 + floor(a.index / 8) * 40
                    box { from: ax, ay; size: 104, 32; corner: 16 * max(0.3, nd_rnd); color: nd_acc; opacity: if(maz.hover, 0.18, 0) }
                    box { from: ax, ay; size: 104, 32; corner: 16 * max(0.3, nd_rnd); stroke: 1; color: if(maz.hover, nd_acc, fl.trace_lit) }
                    text "+ {a.label}" { at: ax + 52, ay + 16; anchor: center; align: center; size: 9; weight: 700; family: "Share Tech Mono"; color: fl.engrave; width: 98; lines: 1 }
                    zone box maz { from: ax, ay; size: 104, 32; corner: 16; cursor: pointer; role: button; label: "Add {a.label}"; show: nd_studio and nd_tab == 1 and md.count < 6 }
                    on press maz { emit nd_md(100 + a.index) }
                }
            }
            // the other pages: a row each — a slider to drag, or a choice of chips; the arrows move the lit row
            for r in sk {
                let ry = st_dy + 78 + r.index * 52
                let tx = st_x + 430
                group { show: nd_tab > 0
                    box { from: st_x + 12, ry; size: 916, 46; corner: 10; color: fl.well; opacity: if(nd_kr == r.index, 0.85, 0) }
                    box { from: st_x + 12, ry + 10; size: 3, 26; corner: 1; color: nd_acc; show: nd_kr == r.index }
                    text r.label { at: st_x + 32, ry + 16; anchor: left center; size: 13; weight: 600; family: "Exo 2"; color: fl.engrave }
                    text r.desc { at: st_x + 32, ry + 33; anchor: left center; size: 10; family: "Exo 2"; color: fl.muted; width: 380; lines: 1 }
                    group { show: r.kind == 0
                        box { from: tx, ry + 21; size: 380, 4; corner: 2; color: fl.trace_dim }
                        box { from: tx, ry + 21; size: 380 * r.frac, 4; corner: 2; color: nd_acc }
                        group { glow: 10, if(skz.hover or nd_kr == r.index, 0.6, 0.2), nd_glc
                            ellipse { at: tx + 380 * r.frac, ry + 23; radius: if(skz.hover, 9, 7); color: nd_acc } }
                        text r.value { at: st_x + 916, ry + 23; anchor: right center; align: right; size: 11; weight: 700; family: "Share Tech Mono"; color: fl.engrave; width: 90; lines: 1 }
                    }
                    group { show: r.kind == 1 and r.n > 0
                        box { from: tx + 0, ry + 9; size: 72, 28; corner: 14 * max(0.3, nd_rnd); color: nd_acc; opacity: if(r.sel == 0, 0.9, if(sko0.hover, 0.16, 0)) }
                        box { from: tx + 0, ry + 9; size: 72, 28; corner: 14 * max(0.3, nd_rnd); stroke: 1; color: if(r.sel == 0, nd_acc, fl.trace_lit) }
                        text r.o0 { at: tx + 0 + 36, ry + 23; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(r.sel == 0, fl.ground, fl.engrave); width: 68; lines: 1 }
                    }
                    zone box sko0 { from: tx + 0, ry + 9; size: 72, 28; cursor: pointer; role: item; label: "{r.label}: {r.o0}"; selected: r.sel == 0; show: nd_studio and nd_tab > 0 and r.kind == 1 and r.n > 0 }
                    on press sko0 { emit nd_so(r.index * 10 + 0) }
                    group { show: r.kind == 1 and r.n > 1
                        box { from: tx + 78, ry + 9; size: 72, 28; corner: 14 * max(0.3, nd_rnd); color: nd_acc; opacity: if(r.sel == 1, 0.9, if(sko1.hover, 0.16, 0)) }
                        box { from: tx + 78, ry + 9; size: 72, 28; corner: 14 * max(0.3, nd_rnd); stroke: 1; color: if(r.sel == 1, nd_acc, fl.trace_lit) }
                        text r.o1 { at: tx + 78 + 36, ry + 23; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(r.sel == 1, fl.ground, fl.engrave); width: 68; lines: 1 }
                    }
                    zone box sko1 { from: tx + 78, ry + 9; size: 72, 28; cursor: pointer; role: item; label: "{r.label}: {r.o1}"; selected: r.sel == 1; show: nd_studio and nd_tab > 0 and r.kind == 1 and r.n > 1 }
                    on press sko1 { emit nd_so(r.index * 10 + 1) }
                    group { show: r.kind == 1 and r.n > 2
                        box { from: tx + 156, ry + 9; size: 72, 28; corner: 14 * max(0.3, nd_rnd); color: nd_acc; opacity: if(r.sel == 2, 0.9, if(sko2.hover, 0.16, 0)) }
                        box { from: tx + 156, ry + 9; size: 72, 28; corner: 14 * max(0.3, nd_rnd); stroke: 1; color: if(r.sel == 2, nd_acc, fl.trace_lit) }
                        text r.o2 { at: tx + 156 + 36, ry + 23; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(r.sel == 2, fl.ground, fl.engrave); width: 68; lines: 1 }
                    }
                    zone box sko2 { from: tx + 156, ry + 9; size: 72, 28; cursor: pointer; role: item; label: "{r.label}: {r.o2}"; selected: r.sel == 2; show: nd_studio and nd_tab > 0 and r.kind == 1 and r.n > 2 }
                    on press sko2 { emit nd_so(r.index * 10 + 2) }
                    group { show: r.kind == 1 and r.n > 3
                        box { from: tx + 234, ry + 9; size: 72, 28; corner: 14 * max(0.3, nd_rnd); color: nd_acc; opacity: if(r.sel == 3, 0.9, if(sko3.hover, 0.16, 0)) }
                        box { from: tx + 234, ry + 9; size: 72, 28; corner: 14 * max(0.3, nd_rnd); stroke: 1; color: if(r.sel == 3, nd_acc, fl.trace_lit) }
                        text r.o3 { at: tx + 234 + 36, ry + 23; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(r.sel == 3, fl.ground, fl.engrave); width: 68; lines: 1 }
                    }
                    zone box sko3 { from: tx + 234, ry + 9; size: 72, 28; cursor: pointer; role: item; label: "{r.label}: {r.o3}"; selected: r.sel == 3; show: nd_studio and nd_tab > 0 and r.kind == 1 and r.n > 3 }
                    on press sko3 { emit nd_so(r.index * 10 + 3) }
                    group { show: r.kind == 1 and r.n > 4
                        box { from: tx + 312, ry + 9; size: 72, 28; corner: 14 * max(0.3, nd_rnd); color: nd_acc; opacity: if(r.sel == 4, 0.9, if(sko4.hover, 0.16, 0)) }
                        box { from: tx + 312, ry + 9; size: 72, 28; corner: 14 * max(0.3, nd_rnd); stroke: 1; color: if(r.sel == 4, nd_acc, fl.trace_lit) }
                        text r.o4 { at: tx + 312 + 36, ry + 23; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(r.sel == 4, fl.ground, fl.engrave); width: 68; lines: 1 }
                    }
                    zone box sko4 { from: tx + 312, ry + 9; size: 72, 28; cursor: pointer; role: item; label: "{r.label}: {r.o4}"; selected: r.sel == 4; show: nd_studio and nd_tab > 0 and r.kind == 1 and r.n > 4 }
                    on press sko4 { emit nd_so(r.index * 10 + 4) }
                    group { show: r.kind == 1 and r.n > 5
                        box { from: tx + 390, ry + 9; size: 72, 28; corner: 14 * max(0.3, nd_rnd); color: nd_acc; opacity: if(r.sel == 5, 0.9, if(sko5.hover, 0.16, 0)) }
                        box { from: tx + 390, ry + 9; size: 72, 28; corner: 14 * max(0.3, nd_rnd); stroke: 1; color: if(r.sel == 5, nd_acc, fl.trace_lit) }
                        text r.o5 { at: tx + 390 + 36, ry + 23; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(r.sel == 5, fl.ground, fl.engrave); width: 68; lines: 1 }
                    }
                    zone box sko5 { from: tx + 390, ry + 9; size: 72, 28; cursor: pointer; role: item; label: "{r.label}: {r.o5}"; selected: r.sel == 5; show: nd_studio and nd_tab > 0 and r.kind == 1 and r.n > 5 }
                    on press sko5 { emit nd_so(r.index * 10 + 5) }
                }
                zone box skz { from: tx - 12, ry + 4; size: 404, 38; cursor: grab; role: slider; label: "{r.label}"; value: "{r.value}"; show: nd_studio and nd_tab > 0 and r.kind == 0 }
                on press skz { emit nd_sk(r.index * 2000 + round(clamp((pointer.x - tx) / 380, 0, 1) * 1000)) }
                on drag skz { emit nd_sk(r.index * 2000 + round(clamp((pointer.x - tx) / 380, 0, 1) * 1000)) }
            }
            text "↑ ↓  A ROW     ← →  CHANGE IT     TAB  THE NEXT PAGE     ESC  DONE     PRESS THE NODE  THE NEXT STATE" { at: st_x + 470, st_dy + 450; anchor: center; align: center; size: 9; family: "Share Tech Mono"; color: fl.muted }
        }
        // the keyboard, while the node holds it (the launcher, the universe, the studio)
        on key Escape while nd_kb { emit nd_key(27) }
        on key Return while nd_kb { emit nd_key(13) }
        on key Up while nd_kb { emit nd_key(38) }
        on key Down while nd_kb { emit nd_key(40) }
        on key Left while nd_kb { emit nd_key(37) }
        on key Right while nd_kb { emit nd_key(39) }
        on key Tab while nd_kb { emit nd_key(9) }
        on key space while nd_kb { emit nd_key(32) }
    }
}
