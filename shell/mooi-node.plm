    fact c_status_ok_g = 0.952941
    fact c_status_ok_b = 0.819608
    fact c_status_error_r = 1.000000
    fact c_status_error_g = 0.572549
    fact c_status_error_b = 0.372549
    fact c_focus_ring_r = 0.650980
    fact c_focus_ring_g = 0.952941
    fact c_focus_ring_b = 0.819608
    fact c_selection_bg_r = 0.164706
    fact c_selection_bg_g = 0.227451
    fact c_selection_bg_b = 0.211765
    fact st_offset = 0
    fact st_notch = false
    fact bar_rail = true
    fact st_height = 30
    fact st_radius = 8
    fact st_res = 46
    fact st_glow = 1

    // ── what the node is (the logic, lib/node/state): 0 rest · 1 media · 2 notice · 3 volume · 4 workspaces ·
    //    6 launcher · 7 universe · 8 time · 9 something finished · 10 privacy · 11 player · 13 the panel ──
    fact nd_kind = 0
    fact nd_breath = true
    fact nd_kb = false
    fact nd_lean = 0       // where the pointer came in: -1 left · 1 right (expansion leans that way)
    // ── its look (lib/node/look, node-look.json; the studio sets it) ──
    fact nd_np = 0     // the character: 0 organic · 1 minimal · 2 technical · 3 cyber
    fact nd_sp = 2     // the body's spring (speed × bounce)
    fact nd_gs = 1     // growth: 0 slow · 1 normal · 2 fast
    fact nd_seed = 0     // 0 line · 1 dot · 2 ring · 3 twin · 4 bar · 5 clock · 6 BMO
    fact nd_rnd = 1     // roundness, 0 … 1
    fact nd_tex = 0     // 0 solid · 1 hollow · 2 segmented · 3 scan · 4 dotted
    fact nd_fill = 0.95     // how solid
    fact nd_ol = 1     // the outline, px
    fact nd_gw = 0.7     // the glow, 0 … 1
    fact nd_ac = 0     // its colour: 0 signal · 1 ember · 2 ink · 3 steel
    fact nd_gc = 0     // the glow's colour, the same
    fact nd_stg = 0.5     // stagger, 0 all at once … 1 one after another
    fact nd_bd = 0.35     // how deeply it breathes
    fact nd_mu = 0.6     // how much it moves with the music
    fact nd_viz = 0     // the media's music: 0 bars · 1 wave · 2 dots · 3 off
    fact nd_cov = 0     // the cover: 0 square · 1 round
    fact nd_ldm = 0.28     // the search's dim
    fact nd_ur = 520     // the orbit's width
    fact nd_mf = 0     // music as: 0 a capsule · 1 a visualiser · 2 a record
    fact nd_long = 0     // at rest: 0 the seed · 1 the long pill · 2 a notch
    fact nd_cks = 0     // the clock seed: 0 pixel · 1 digits · 2 hands · 3 words · 4 binary · 5 dots
    fact nd_wss = 0     // a workspace switch: 0 bead · 1 slide · 2 flip · 3 pulse · 4 number
    fact nd_rxl = 1     // reactions: 0 off · 1 subtle · 2 lively
    fact nd_smu = 1     // the seed with music: 0 still · 1 a pulse · 2 bars
    fact nd_shm = 0     // D296 shimmer: 0 off · 1 slow · 2 fast
    fact nd_trl = 0     // D296 trail: 0 off · 1 on
    fact nd_tx = 949
    fact nd_ty = 8
    fact nd_tw = 22
    fact nd_th = 6
    fact nd_tr = 3
    spring nd.s0 = 240, 31     // soft_none
    spring nd.s1 = 240, 22     // soft_some
    spring nd.s2 = 240, 15     // soft_lots
    spring nd.s3 = 520, 46     // quick_none
    spring nd.s4 = 520, 32     // quick_some
    spring nd.s5 = 520, 23     // quick_lots
    spring nd.s6 = 760, 55     // snap_none
    spring nd.s7 = 760, 39     // snap_some
    spring nd.s8 = 760, 28     // snap_lots
    spring nd.aux = 420, 34     // the parts that slide (the bead, the orbit, the dims)
    spring nd.glit = 760, 26    // the glitch
    prop nbx0 = 949 ~nd.s0
    follow nbx0 = nd_tx
    prop nbx1 = 949 ~nd.s1
    follow nbx1 = nd_tx
    prop nbx2 = 949 ~nd.s2
    follow nbx2 = nd_tx
    prop nbx3 = 949 ~nd.s3
    follow nbx3 = nd_tx
    prop nbx4 = 949 ~nd.s4
    follow nbx4 = nd_tx
    prop nbx5 = 949 ~nd.s5
    follow nbx5 = nd_tx
    prop nbx6 = 949 ~nd.s6
    follow nbx6 = nd_tx
    prop nbx7 = 949 ~nd.s7
    follow nbx7 = nd_tx
    prop nbx8 = 949 ~nd.s8
    follow nbx8 = nd_tx
    let nb_x = pick(nd_sp, nbx0, nbx1, nbx2, nbx3, nbx4, nbx5, nbx6, nbx7, nbx8)
    prop nby0 = 8 ~nd.s0
    follow nby0 = nd_ty
    prop nby1 = 8 ~nd.s1
    follow nby1 = nd_ty
    prop nby2 = 8 ~nd.s2
    follow nby2 = nd_ty
    prop nby3 = 8 ~nd.s3
    follow nby3 = nd_ty
    prop nby4 = 8 ~nd.s4
    follow nby4 = nd_ty
    prop nby5 = 8 ~nd.s5
    follow nby5 = nd_ty
    prop nby6 = 8 ~nd.s6
    follow nby6 = nd_ty
    prop nby7 = 8 ~nd.s7
    follow nby7 = nd_ty
    prop nby8 = 8 ~nd.s8
    follow nby8 = nd_ty
    let nb_y = pick(nd_sp, nby0, nby1, nby2, nby3, nby4, nby5, nby6, nby7, nby8)
    prop nbw0 = 22 ~nd.s0
    follow nbw0 = nd_tw
    prop nbw1 = 22 ~nd.s1
    follow nbw1 = nd_tw
    prop nbw2 = 22 ~nd.s2
    follow nbw2 = nd_tw
    prop nbw3 = 22 ~nd.s3
    follow nbw3 = nd_tw
    prop nbw4 = 22 ~nd.s4
    follow nbw4 = nd_tw
    prop nbw5 = 22 ~nd.s5
    follow nbw5 = nd_tw
    prop nbw6 = 22 ~nd.s6
    follow nbw6 = nd_tw
    prop nbw7 = 22 ~nd.s7
    follow nbw7 = nd_tw
    prop nbw8 = 22 ~nd.s8
    follow nbw8 = nd_tw
    let nb_w = pick(nd_sp, nbw0, nbw1, nbw2, nbw3, nbw4, nbw5, nbw6, nbw7, nbw8)
    prop nbh0 = 6 ~nd.s0
    follow nbh0 = nd_th
    prop nbh1 = 6 ~nd.s1
    follow nbh1 = nd_th
    prop nbh2 = 6 ~nd.s2
    follow nbh2 = nd_th
    prop nbh3 = 6 ~nd.s3
    follow nbh3 = nd_th
    prop nbh4 = 6 ~nd.s4
    follow nbh4 = nd_th
    prop nbh5 = 6 ~nd.s5
    follow nbh5 = nd_th
    prop nbh6 = 6 ~nd.s6
    follow nbh6 = nd_th
    prop nbh7 = 6 ~nd.s7
    follow nbh7 = nd_th
    prop nbh8 = 6 ~nd.s8
    follow nbh8 = nd_th
    let nb_h = pick(nd_sp, nbh0, nbh1, nbh2, nbh3, nbh4, nbh5, nbh6, nbh7, nbh8)
    prop nbr0 = 3 ~nd.s0
    follow nbr0 = nd_tr
    prop nbr1 = 3 ~nd.s1
    follow nbr1 = nd_tr
    prop nbr2 = 3 ~nd.s2
    follow nbr2 = nd_tr
    prop nbr3 = 3 ~nd.s3
    follow nbr3 = nd_tr
    prop nbr4 = 3 ~nd.s4
    follow nbr4 = nd_tr
    prop nbr5 = 3 ~nd.s5
    follow nbr5 = nd_tr
    prop nbr6 = 3 ~nd.s6
    follow nbr6 = nd_tr
    prop nbr7 = 3 ~nd.s7
    follow nbr7 = nd_tr
    prop nbr8 = 3 ~nd.s8
    follow nbr8 = nd_tr
    let nb_r = pick(nd_sp, nbr0, nbr1, nbr2, nbr3, nbr4, nbr5, nbr6, nbr7, nbr8)
    spring nd.trail = 60, 11
    prop nd_tgx = 949 ~nd.trail
    follow nd_tgx = nd_tx
    prop nd_tgy = 8 ~nd.trail
    follow nd_tgy = nd_ty
    prop nd_tgw = 22 ~nd.trail
    follow nd_tgw = nd_tw
    prop nd_tgh = 6 ~nd.trail
    follow nd_tgh = nd_th
    prop nd_tgr = 3 ~nd.trail
    follow nd_tgr = nd_tr
    // what is inside appears as the body reaches its size: it grows out of the node, never pops in
    let nd_cf = clamp((nb_w - 0.82 * nd_tw) / max(1, 0.18 * nd_tw), 0, 1) * clamp((nb_h - 0.82 * nd_th) / max(1, 0.18 * nd_th), 0, 1)
    // the seed breathes (2 s), only at rest and only while allowed
    // (D252: not at all when the look breathes 0 — a still seed costs no frames)
    prop nd_ph = 0
    spin nd_ph by if(nd_kind == 0 and nd_breath and nd_bd > 0.01, 180, 0)
    let nd_br = 0.5 + 0.5 * sin(nd_ph)
    // media
    text nd_title = ""
    text nd_artist = ""
    text nd_art = ""
    image nd_cover = from nd_art, 96, 96
    fact nd_playing = false
    fact nd_paused = false
    fact nd_prog = 0
    fact nd_arted = false
    prop nd_vph = 0
    spin nd_vph by if(nd_kind == 1 and nd_playing, 240, 0)
    // D296: the aurora's drift and the shimmer's turn spin only while those are worn
    prop nd_aph = 0
    spin nd_aph by if(nd_tex == 7 and nd_kind > 0, 36, 0)
    prop nd_shp = 0
    spin nd_shp by if(nd_shm > 0, if(nd_shm == 2, 300, 120), 0)
    // the record (D246): 33⅓ turns a minute while it plays
    prop nd_vrot = 0
    spin nd_vrot by if(nd_kind == 1 and nd_mf == 2 and nd_playing, 200, 0)
    // notices
    model nc max 5 { x: number; y: number; w: number; h: number; app: text; title: text; body: text; open: bool; act: text; hasact: bool }
    fact nd_ncn = 0       // how many cards are shown
    fact nd_more = 0      // how many more wait
    fact nd_ncl = 1       // how much of their time is left (D237)
    prop nd_ncs = 1 ~nd.aux
    follow nd_ncs = nd_ncl
    // volume
    fact nd_vol = 0
    text nd_vlabel = ""
    // the gauge (D265): any reading — how full, its icon, warm for a warning
    fact nd_gv = 0
    text nd_gicon = ""
    fact nd_gwarm = false
    measure gmw
    // workspaces
    model rl max 12 { x: number; n: text; on: bool; used: bool }
    fact nd_beadx = 960
    prop nd_bead = 960 ~nd.aux
    follow nd_bead = nd_beadx
    // system
    model sy max 7 { x: number; y: number; label: text; value: text; hot: bool; frac: number; deep: bool; h0: number; h1: number; h2: number; h3: number; h4: number; h5: number; h6: number; h7: number; h8: number; h9: number; h10: number; h11: number; h12: number; h13: number; h14: number; h15: number; h16: number; h17: number; h18: number; h19: number }
    // launcher
    text nd_q = ""
    fact nd_sel = 0
    model lr max 6 { x: number; y: number; w: number; h: number; name: text; icon: image 28, 28; iconed: bool; letter: text; tag: text }
    // the studio (D229): the node on a stage, the deck of what it may look like
    fact nd_studio = false
    prop nd_stf = 0 ~nd.aux
    follow nd_stf = if(nd_studio, 1, 0)
    fact nd_tab = 0       // 0 Presets · 1 Pill · 2 Shape · 3 Surface · 4 Motion · 5 Music · 6 Parts
    fact nd_kr = 0        // the row the keyboard is on
    fact nd_pv = 0        // the preview: 0 Rest · 1 Music · 2 Notice · 3 Volume · 4 Rail · 5 Panel · 6 Search · 7 Tour
    text nd_lookname = "Organic"
    model sk max 7 { kind: number; label: text; desc: text; value: text; frac: number; sel: number; n: number; off: bool; why: text; o0: text; o1: text; o2: text; o3: text; o4: text; o5: text; o6: text; o7: text; o8: text }
    model ps max 6 { name: text; desc: text; on: bool; sw: number; sh: number; sr: number; seed: number }
    model sl max 3 { label: text; full: bool }
    model md max 6 { label: text }     // D257: the modules in the pill, in order
    model ma max 12 { label: text }    // …and those that can be added (D308: twelve with the clock face)
    prop nd_ld = 0 ~nd.aux
    follow nd_ld = if(nd_kind == 6 and not nd_studio, 1, 0)
    // universe
    model un max 12 { i: number; n: text; apps: text; id: number; empty: bool }
    // the galaxy's pictures (D294): each workspace's windows, live, inside its tile
    model up max 36 { tile: number; fx: number; fy: number; fw: number; fh: number; img: image 320, 200 }
    fact nd_upic = false
    fact nd_un_n = 1      // how many workspaces orbit
    fact nd_rott = 0      // where the orbit turns to (a running count: stepping never wraps back the long way)
    prop nd_rot = 0 ~nd.aux
    follow nd_rot = nd_rott
    prop nd_uf = 0 ~nd.aux
    follow nd_uf = if(nd_kind == 7, 1, 0)
    // growth (D228): a count the logic bumps on every change of shape; springs chase it, and the lag is how far
    // from grown (a bump is an instant reset). One spring per growth speed; the look picks (nd_gs)
    fact nd_gn = 0
    spring nd.g0 = 90, 15     // slow
    prop nd_gp0 = 0 ~nd.g0
    follow nd_gp0 = nd_gn
    spring nd.g1 = 170, 19     // normal
    prop nd_gp1 = 0 ~nd.g1
    follow nd_gp1 = nd_gn
    spring nd.g2 = 320, 30     // fast
    prop nd_gp2 = 0 ~nd.g2
    follow nd_gp2 = nd_gn
    let nd_grow = clamp(1 - (nd_gn - pick(nd_gs, nd_gp0, nd_gp1, nd_gp2)), 0, 1)
    // the stagger: part i of n waits a little more than the one before it, by the look's stagger
    let nd_gk = 1 + 0.8 * nd_stg
    // cyber: a change glitches it for a moment
    fact nd_gl = 0
    prop nd_glf = 0 ~nd.glit
    follow nd_glf = nd_gl
    // the time tools (D231): the panel (a mode on stage, the others on its rail), the seed's capsule while
    // something runs, and the card when something finishes
    fact nd_tmm = 0       // on stage: 0 timer · 1 stopwatch · 2 focus · 3 alarm
    text nd_tmr = "05:00"
    text nd_tms = ""
    fact nd_tmp = 1
    text nd_tmgl = "START"
    text nd_tm2l = "RESET"
    model tc max 4 { label: text; code: number }
    model px max 400 { x: number; y: number }   // the readout's lit cells (lib/node/clockfont)
    fact nd_pxw = 29      // its width, in cells
    model ck max 120 { x: number; y: number }   // the clock seed's lit cells (D241)
    text nd_ckd = ""
    text nd_ckw = ""
    fact nd_ckh = 0
    fact nd_ckm = 0
    fact nd_ckdh = 0
    fact nd_ckdm = 0
    fact nd_cb0 = false
    fact nd_cb1 = false
    fact nd_cb2 = false
    fact nd_cb3 = false
    fact nd_cb4 = false
    fact nd_cb5 = false
    fact nd_cb6 = false
    fact nd_cb7 = false
    fact nd_cb8 = false
    fact nd_cb9 = false
    fact nd_cb10 = false
    fact nd_cb11 = false
    fact nd_wsoff = 0
    text nd_wsl = ""
    // reactions (D256): a count bumped by the logic; a slow spring chases it and the lag is the ring's life
    fact nd_rn = 0
    fact nd_rk = 0      // 0 its own colour · 1 warm
    spring nd.react = 40, 11
    prop nd_rp = 0 ~nd.react
    follow nd_rp = nd_rn
    let nd_rr = clamp(nd_rn - nd_rp, 0, 1)
    model tr max 3 { label: text; value: text; on: bool; m: number }
    fact nd_cap = false
    text nd_capt = ""
    text nd_capm = ""
    fact nd_capf = 1
    fact nd_capu = false
    prop nd_swp = 0
    spin nd_swp by if(nd_cap and nd_kind == 0, if(nd_capu, 300, 120), 0)
    text nd_dnt = ""
    text nd_dnd = ""
    prop nd_dph = 0
    spin nd_dph by if(nd_kind == 9, 260, 0)
    // the player (D236): the media capsule pressed grows into it
    fact nd_shuf = false
    fact nd_loop = 0      // 0 none · 1 the playlist · 2 the track
    text nd_pos = "0:00"
    text nd_len = "0:00"
    fact nd_bri = 0.5
    fact nd_mic = 0.5
    fact nd_micm = false
    fact nd_hasbri = false
    fact nd_mix = false   // the player's other page: one row per app playing (D239)
    model mx max 4 { name: text; vol: number; muted: bool }
    fact nd_lyon = false  // synced words for this song (D240)
    text nd_lyc = ""
    text nd_lyn = ""
    fact nd_sp0 = 0
    fact nd_sp1 = 0
    fact nd_sp2 = 0
    fact nd_sp3 = 0
    fact nd_sp4 = 0
    fact nd_sp5 = 0
    fact nd_sp6 = 0
    fact nd_sp7 = 0
    fact nd_sp8 = 0
    fact nd_sp9 = 0
    fact nd_sp10 = 0
    fact nd_sp11 = 0
    fact nd_sp12 = 0
    fact nd_sp13 = 0
    fact nd_sp14 = 0
    fact nd_sp15 = 0
    fact nd_sp16 = 0
    fact nd_sp17 = 0
    fact nd_sp18 = 0
    fact nd_sp19 = 0
    fact nd_sp20 = 0
    fact nd_sp21 = 0
    fact nd_sp22 = 0
    fact nd_sp23 = 0
    fact nd_sp24 = 0
    fact nd_sp25 = 0
    fact nd_sp26 = 0
    fact nd_sp27 = 0
    fact nd_sp28 = 0
    fact nd_sp29 = 0
    fact nd_sp30 = 0
    fact nd_sp31 = 0
    // the panel (D260): one body grows straight down out of the pill; every page shares its width and the
    // icon row under it. 0 home · 1 calendar · 2 notes · 3 clipboard · 4 stash · 5 wallpaper · 6 system · 7 power
    fact nd_pgp = 0
    fact nd_sclear = false   // D279: Clear on the Stash page is armed for its second press
    text nd_pgt = ""
    text nd_pgs = ""
    text nd_hompos = "0:00"
    text nd_homlen = "0:00"
    model pn max 3 { icon: text; app: text; title: text; age: text }
    fact nd_wifi = false
    text nd_wifin = "Off"
    fact nd_bt = false
    fact nd_dnd_on = false
    fact nd_tmr_on = false
    // the radios (D263): the network and the Bluetooth adapter, their lists, and a password that only ever
    // goes to the network service
    model nw max 8 { name: text; bars: number; secure: bool; known: bool; on: bool }
    fact nd_won = false
    text nd_wname = "Off"
    fact nd_wbars = 0
    fact nd_wsec = false
    text nd_werr = ""
    text nd_wssid = ""
    fact nd_wsel = 0
    text nd_wpw = ""
    fact nd_werron = false
    model bt max 8 { name: text; detail: text; on: bool; paired: bool }
    fact nd_btp = false
    fact nd_btpw = false
    text nd_bth = "Off"
    fact nd_btbat = -1
    fact nd_btdis = false
    model cal max 42 { d: text; muted: bool; today: bool; weekend: bool }
    model br max 7 { label: text; detail: text; pinned: bool }
    // D279: the Notes board's six cards and the Stash page's six rows
    model ncard max 6 { id: number; title: text; rest: text; more: bool; age: text; pinned: bool; tag: number }
    model stz max 6 { id: number; icon: text; name: text; detail: text }
    // D287: the weather page — the days of the week, their shared temperature range, and today now
    model wkw max 7 { label: text; glyph: text; hi: text; lo: text; lo_v: number; hi_v: number; wet: bool }
    text nd_wtemp = ""
    text nd_wword = ""
    text nd_wglyph = ""
    text nd_wfeels = ""
    text nd_whum = ""
    text nd_wwind = ""
    text nd_wcity = ""
    text nd_wsum = ""
    model wl max 9 { img: image 152, 86; on: bool; name: text; fav: bool }
    fact nd_wlfav = false   // D307: the wallpaper page shows only the favourites
    text nd_nq = ""
    // the shortcut sheet (D267): ten rows of what Hyprland has bound, a filter, how many more below
    model kb max 10 { keys: text; what: text }
    // the Home header (D272): the time, the date, the weather, the battery, four readings, game mode
    text nd_hname = ""
    text nd_hwho = ""
    text nd_hinit = ""
    text nd_face = ""
    image nd_face_img = from nd_face, 96, 96
    fact nd_face_on = false
    text nd_hn = ""
    fact nd_hedit = false
    fact nd_hpick = false
    text nd_hclock = ""
    text nd_hdate = ""
    text nd_hwg = ""
    text nd_hwt = ""
    text nd_hbat = ""
    text nd_hs1 = ""
    text nd_hs2 = ""
    text nd_hs3 = ""
    text nd_hs4 = ""
    fact nd_hf1 = 0
    fact nd_hh1 = false
    fact nd_hf2 = 0
    fact nd_hh2 = false
    fact nd_hf3 = 0
    fact nd_hh3 = false
    fact nd_hf4 = 0
    fact nd_hh4 = false
    fact nd_game = false
    fact nd_hstrip = true
    text nd_hout = ""      // D277: where the sound plays; a press goes to the next output
    text nd_kq = ""
    fact nd_kmore = 0
    // BMO as the seed (D253): the bar's own face (ui/bmoface.plm), his expression from bmo-shared.json
    fact pb_ew = 8
    fact pb_eh = 14
    fact pb_lid = 0
    fact pb_brow = 0
    fact pb_bron = 0
    fact pb_sql = 0
    fact pb_sqr = 0
    fact pb_mc = 0.7
    fact pb_mo = 0.2
    fact pb_mw = 24
    fact pb_bl = 0
    fact pb_tg = 0
    fact pb_sing = false
    fact pb_asleep = false
    prop lv0 = 0 ~nd.aux
    follow lv0 = lv.level
    prop lv1 = 0 ~nd.aux
    follow lv1 = lv.level
    prop lv2 = 0 ~nd.aux
    follow lv2 = lv.level
    prop pb_sqlf = 0 ~nd.aux
    follow pb_sqlf = pb_sql
    prop pb_sqrf = 0 ~nd.aux
    follow pb_sqrf = pb_sqr
    prop pb_browf = 0 ~nd.aux
    follow pb_browf = pb_brow
    prop pb_bronf = 0 ~nd.aux
    follow pb_bronf = pb_bron
    prop pb_blf = 0 ~nd.aux
    follow pb_blf = pb_bl
    prop pb_tgf = 0 ~nd.aux
    follow pb_tgf = pb_tg
    prop pbe_h = 14 ~nd.aux
    follow pbe_h = pb_eh
    prop pbe_w = 8 ~nd.aux
    follow pbe_w = pb_ew
    prop pbm_c = 0.7 ~nd.aux
    follow pbm_c = pb_mc
    prop pbm_o = 0.2 ~nd.aux
    follow pbm_o = pb_mo
    prop pbm_w = 24 ~nd.aux
    follow pbm_w = pb_mw
    prop pb_lidf = 0 ~nd.aux
    follow pb_lidf = pb_lid
    prop pb_lx = 0 ~nd.aux
    follow pb_lx = if(nd_kind == 0 and nd_seed == 6, clamp((cursor.x - nd_tx - nd_tw / 2) / 180, -1, 1) * 9, 0)
    prop pb_ly = 0 ~nd.aux
    follow pb_ly = if(nd_kind == 0 and nd_seed == 6, clamp((cursor.y - nd_ty - nd_th / 2) / 260, -1, 1) * 4, 0)
    prop pb_open = 1
    blink pb_open every 2.2s..7s for 170ms
    prop pk_flow2 = 0
    spin pk_flow2 by if(pb_asleep and nd_kind == 0 and nd_seed == 6, 8, 0)
    // the long pill (D248): what it holds at rest, each a module laid out by the logic
    model lm max 6 { kind: number; x: number; w: number; label: text; lv: number }
    fact nd_fxc = -1   // D308: where the clock face starts in the pill's modules, or -1
    fact nd_fxl = -1
    fact nd_fxr = -1
    // the frame's corner notches (D295): the modules each holds, and how wide (0: none there)
    model lml max 6 { kind: number; x: number; w: number; label: text; lv: number }
    model lmr max 6 { kind: number; x: number; w: number; label: text; lv: number }
    fact nd_lw = 0
    fact nd_rw = 0
    fact nd_mside = 0
    prop nd_lwk = 0 ~nd.aux
    follow nd_lwk = nd_lw
    prop nd_rwk = 0 ~nd.aux
    follow nd_rwk = nd_rw
    fact nd_lmws = 0
    fact nd_lmwa = 0   // the workspaces: how many, which one is on (0-based)
    fact nd_lmbat = 0
    fact nd_nfr = false   // D257: the frame draws the notch (it is a piece of the frame's body)
    // privacy (D232): the microphone or the camera started or stopped
    text nd_pvt = ""
    text nd_pvd = ""
    fact nd_pvon = false

    event nd_hover ->     // the pointer over the node: 1 + x · 0 gone
    event nd_press ->     // the node pressed
    event nd_media ->     // 1 back · 2 play / pause · 3 next
    event nd_nc ->        // a notice: row * 10 + 0 open · 1 its action · 9 dismiss
    event nd_ncx ->       // the pointer over a notice card: its row + 1 · 0 gone (D245: it opens to be read)
    event nd_ws ->        // a workspace on the rail
    event nd_lr ->        // a launcher row
    event nd_un ->        // a workspace in the universe
    event nd_key ->       // a key while the node holds the keyboard
    event nd_cmd ->       // from `mooi node …`: 1 wake (Super) · 2 launcher · 3 universe · 4 studio · 5 time · 6 keys
    event nd_out ->       // D277: the output name on Home pressed: the next output plays
    event nd_osd ->       // from `mooi osd` (D265): a lock key or game mode for the gauge (lib/node/gauge decode)
    event nd_tab ->       // the studio: a page
    event nd_sk ->        // the studio: a slider, row * 2000 + where along it (0 … 1000: a stride of 2000, never ambiguous)
    event nd_so ->        // the studio: a choice, row * 10 + which
    event nd_pv ->        // the studio: what the node is shown as
    event nd_ps ->        // the studio: a preset
    event nd_slot ->      // the studio: a saved look, slot * 10 + 0 save · 1 wear · 9 clear
    event nd_stc ->       // the studio: 1 shuffle · 2 done · 3 reset
    event nd_mside ->     // D295: the module editor edits 0 the pill · 1 the left corner · 2 the right corner
    event nd_md ->        // the module editor: in the pill, i * 10 + 1 left · 2 right · 9 out; 100 + i adds the i-th of the rest
    event nd_tm ->        // the time tools: 0-3 a mode · 10 go · 11 reset · 12 lap or skip · 2x timer · 3x alarm
    event nd_dn ->        // the finish card answered
    event nd_pg ->        // the panel: 0 home · 1 calendar · 2 notes · 3 clipboard · 4 stash · 5 wallpaper · 6 system · 7 Wi-Fi · 8 Bluetooth · 9 settings · 10 Control Nexus · 11 power
    event nd_wn ->        // a network in the Wi-Fi page: its row
    event nd_wf ->        // a saved network forgotten: its row
    event nd_wr ->        // look for networks again
    event nd_wgo ->       // the password given: join the network chosen
    event nd_bd ->        // a device in the Bluetooth page: its row
    event nd_brf ->       // look for devices again
    event nd_ptog ->      // a panel toggle: 1 Wi-Fi · 2 silent · 3 timer · 4 Bluetooth
    event nd_pclear ->    // the panel: clear every notice
    event nd_popen ->     // the panel: open the full player
    event nd_pclose ->    // the panel: a press on its empty body closes it
    event nd_wheel ->     // the wheel over the node: 1 up · -1 down (the volume)
    event nd_sys ->       // a reading of the system cluster pressed (D249: btop, in the owner's terminal)
    event nd_ksc ->       // the shortcut sheet scrolled: -1 up, 1 down (three rows a notch)
    event nd_br ->        // in a branch: 1 back a month / step · 2 on a month / step · 10 + row a row · 30 + row its second press
    event nd_nsw ->      // the notes board: the wheel pages it, -1 up · 1 down
    event nd_npin ->     // the notes board: a note pinned or let go (its id)
    event nd_ndel ->     // the notes board: a note forgotten (its id)
    event nd_sclip ->    // the Stash page: keep what the clipboard holds
    event nd_sdl ->      // the Stash page: keep the newest file in Downloads
    event nd_sclear ->   // the Stash page: clear the box (two presses within three seconds)
    event nd_stdel ->    // the Stash page: forget one item (its id)
    event nd_hopen ->    // the Home profile pressed: edit the name and picture
    event nd_hsave ->    // the profile name submitted
    event nd_hpic ->     // the profile picture chosen
    event nd_hdone ->    // the profile editor checked
    event nd_hweather -> // Home's weather pressed: the week's page
    event nd_pl ->        // the player: 1 shuffle · 2 back · 3 play / pause · 4 next · 5 loop · 6 the mic muted
    event nd_seek ->      // the player: where along the song (0 … 1000)
    event nd_mx ->        // the mixer: row * 2000 + its level (0 … 1000)
    event nd_mxm ->       // the mixer: a row muted or not
    event nd_mt ->        // the player: a meter dragged, meter * 2000 + its level (0 … 1000) · 0 volume · 1 light · 2 mic

    surface node {
        size: full, full
        anchor: top
        open: not nd_hpick
        level: top, overlay while nd_kind == 7 or nd_studio
        // -1: over every other bar's strip, not pushed below it (it sat on the windows' line, D245)
        reserve: -1
        keyboard: exclusive while nd_kb
        // D252: at rest only a slow breath moves, twelve frames a second is plenty (each repaints the whole surface)
        rate: 60, 12 while nd_kind == 0 and nd_grow > 0.99 and not nd_studio and not nd_cap
        // the look's colours: its own, and its light's
        let nd_acc = pick(nd_ac, fl.phos, fl.ember, fl.ink, fl.trace_lit)
        let nd_glc = pick(nd_gc, fl.phos, fl.ember, fl.ink, fl.trace_lit)
        // ── the studio (D229): the desktop steps back, the node stands on a stage ──
        let st_x = node.width / 2 - 470
        let st_dy = node.height - 500
        group { show: nd_stf > 0.01; opacity: nd_stf
            box { from: 0, 0; size: node.width, node.height; color: #000000; opacity: 0.6 }
            zone box st_bg { from: 0, 0; size: node.width, node.height; label: "The Pill studio"; show: nd_studio }
            box { from: st_x, 40; size: 940, st_dy - 60; corner: 18; color: fl.well; opacity: 0.55 }
            box { from: st_x, 40; size: 940, st_dy - 60; corner: 18; stroke: 1; color: fl.trace_dim }
            text "THE PILL · STUDIO" { at: st_x + 24, 64; anchor: left center; size: 10; weight: 700; family: "Share Tech Mono"; color: fl.muted }
            text nd_lookname { at: st_x + 916, 64; anchor: right center; align: right; size: 10; weight: 700; family: "Share Tech Mono"; color: nd_acc; width: 400; lines: 1 }
            // what the node is shown as: each state, or a tour of them all
            box { from: st_x + 54, st_dy - 62; size: 96, 26; corner: 26 / 2; color: nd_acc; opacity: if(nd_pv == 0, 0.9, if(stp0.hover, 0.18, 0)) }
            box { from: st_x + 54, st_dy - 62; size: 96, 26; corner: 26 / 2; stroke: 1; color: if(nd_pv == 0, nd_acc, fl.trace_lit) }
            text "REST" { at: st_x + 54 + 96 / 2, st_dy - 62 + 26 / 2; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(nd_pv == 0, fl.ground, fl.engrave) }
            zone box stp0 { from: st_x + 54, st_dy - 62; size: 96, 26; corner: 26 / 2; cursor: pointer; role: button; label: "Rest"; show: nd_studio }
            on press stp0 { emit nd_pv(0) }
            box { from: st_x + 158, st_dy - 62; size: 96, 26; corner: 26 / 2; color: nd_acc; opacity: if(nd_pv == 1, 0.9, if(stp1.hover, 0.18, 0)) }
            box { from: st_x + 158, st_dy - 62; size: 96, 26; corner: 26 / 2; stroke: 1; color: if(nd_pv == 1, nd_acc, fl.trace_lit) }
            text "MUSIC" { at: st_x + 158 + 96 / 2, st_dy - 62 + 26 / 2; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(nd_pv == 1, fl.ground, fl.engrave) }
            zone box stp1 { from: st_x + 158, st_dy - 62; size: 96, 26; corner: 26 / 2; cursor: pointer; role: button; label: "Music"; show: nd_studio }
            on press stp1 { emit nd_pv(1) }
            box { from: st_x + 262, st_dy - 62; size: 96, 26; corner: 26 / 2; color: nd_acc; opacity: if(nd_pv == 2, 0.9, if(stp2.hover, 0.18, 0)) }
            box { from: st_x + 262, st_dy - 62; size: 96, 26; corner: 26 / 2; stroke: 1; color: if(nd_pv == 2, nd_acc, fl.trace_lit) }
            text "NOTICE" { at: st_x + 262 + 96 / 2, st_dy - 62 + 26 / 2; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(nd_pv == 2, fl.ground, fl.engrave) }
            zone box stp2 { from: st_x + 262, st_dy - 62; size: 96, 26; corner: 26 / 2; cursor: pointer; role: button; label: "Notice"; show: nd_studio }
            on press stp2 { emit nd_pv(2) }
            box { from: st_x + 366, st_dy - 62; size: 96, 26; corner: 26 / 2; color: nd_acc; opacity: if(nd_pv == 3, 0.9, if(stp3.hover, 0.18, 0)) }
            box { from: st_x + 366, st_dy - 62; size: 96, 26; corner: 26 / 2; stroke: 1; color: if(nd_pv == 3, nd_acc, fl.trace_lit) }
            text "VOLUME" { at: st_x + 366 + 96 / 2, st_dy - 62 + 26 / 2; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(nd_pv == 3, fl.ground, fl.engrave) }
            zone box stp3 { from: st_x + 366, st_dy - 62; size: 96, 26; corner: 26 / 2; cursor: pointer; role: button; label: "Volume"; show: nd_studio }
            on press stp3 { emit nd_pv(3) }
            box { from: st_x + 470, st_dy - 62; size: 96, 26; corner: 26 / 2; color: nd_acc; opacity: if(nd_pv == 4, 0.9, if(stp4.hover, 0.18, 0)) }
            box { from: st_x + 470, st_dy - 62; size: 96, 26; corner: 26 / 2; stroke: 1; color: if(nd_pv == 4, nd_acc, fl.trace_lit) }
            text "RAIL" { at: st_x + 470 + 96 / 2, st_dy - 62 + 26 / 2; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(nd_pv == 4, fl.ground, fl.engrave) }
            zone box stp4 { from: st_x + 470, st_dy - 62; size: 96, 26; corner: 26 / 2; cursor: pointer; role: button; label: "Rail"; show: nd_studio }
            on press stp4 { emit nd_pv(4) }
            box { from: st_x + 574, st_dy - 62; size: 96, 26; corner: 26 / 2; color: nd_acc; opacity: if(nd_pv == 5, 0.9, if(stp5.hover, 0.18, 0)) }
            box { from: st_x + 574, st_dy - 62; size: 96, 26; corner: 26 / 2; stroke: 1; color: if(nd_pv == 5, nd_acc, fl.trace_lit) }
            text "PANEL" { at: st_x + 574 + 96 / 2, st_dy - 62 + 26 / 2; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(nd_pv == 5, fl.ground, fl.engrave) }
            zone box stp5 { from: st_x + 574, st_dy - 62; size: 96, 26; corner: 26 / 2; cursor: pointer; role: button; label: "Panel"; show: nd_studio }
            on press stp5 { emit nd_pv(5) }
            box { from: st_x + 678, st_dy - 62; size: 96, 26; corner: 26 / 2; color: nd_acc; opacity: if(nd_pv == 6, 0.9, if(stp6.hover, 0.18, 0)) }
            box { from: st_x + 678, st_dy - 62; size: 96, 26; corner: 26 / 2; stroke: 1; color: if(nd_pv == 6, nd_acc, fl.trace_lit) }
            text "SEARCH" { at: st_x + 678 + 96 / 2, st_dy - 62 + 26 / 2; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(nd_pv == 6, fl.ground, fl.engrave) }
            zone box stp6 { from: st_x + 678, st_dy - 62; size: 96, 26; corner: 26 / 2; cursor: pointer; role: button; label: "Search"; show: nd_studio }
            on press stp6 { emit nd_pv(6) }
            box { from: st_x + 782, st_dy - 62; size: 96, 26; corner: 26 / 2; color: nd_acc; opacity: if(nd_pv == 7, 0.9, if(stp7.hover, 0.18, 0)) }
            box { from: st_x + 782, st_dy - 62; size: 96, 26; corner: 26 / 2; stroke: 1; color: if(nd_pv == 7, nd_acc, fl.trace_lit) }
            text "TOUR" { at: st_x + 782 + 96 / 2, st_dy - 62 + 26 / 2; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(nd_pv == 7, fl.ground, fl.engrave) }
            zone box stp7 { from: st_x + 782, st_dy - 62; size: 96, 26; corner: 26 / 2; cursor: pointer; role: button; label: "Tour"; show: nd_studio }
            on press stp7 { emit nd_pv(7) }
        }
        // a reaction (D256): rings out of the node, its own colour or warm; the lively one rings twice
        group { show: nd_rxl > 0 and nd_rr > 0.01
            let rc = if(nd_rk == 1, fl.ember, nd_acc)
            let r0 = max(nb_w, nb_h) / 2
            ellipse { at: nb_x + nb_w / 2, nb_y + nb_h / 2; radius: r0 + (10 + 24 * nd_rxl) * (1 - nd_rr); scale: 1, min(1, (nb_h + 30) / max(1, nb_w)); stroke: 1.5; color: rc; opacity: 0.75 * nd_rr }
            ellipse { at: nb_x + nb_w / 2, nb_y + nb_h / 2; radius: r0 + 40 * clamp(1.4 - nd_rr * 1.4, 0, 1); scale: 1, min(1, (nb_h + 30) / max(1, nb_w)); stroke: 1; color: rc; opacity: 0.5 * nd_rr; show: nd_rxl == 2 }
            // (D296) sparks: a burst out of it while the reaction is fresh
            group { glow: 6, 0.8, rc; show: nd_rxl == 3
                particles { at: nb_x + nb_w / 2, nb_y + nb_h / 2; area: nb_w, nb_h; count: 90; life: 0.35s .. 0.9s; speed: 90 .. 240; spread: 360deg; gravity: 0, 140; drag: 1.3; size: 2.6, 0.4; opacity: 100%, 0%; shape: spark; emit: nd_rr > 0.72 and nd_rxl == 3 } }
        }
        // the launcher: what is round it steps back (the look's dim), the search line in focus
        box { from: 0, 0; size: node.width, node.height; color: #000000; opacity: nd_ldm * nd_ld; show: nd_ld > 0.01 }
        // the universe (Super+Tab): the desktop dims and the workspaces orbit the node; stepping turns the orbit
        box { from: 0, 0; size: node.width, node.height; color: #000000; opacity: 0.62 * nd_uf; show: nd_uf > 0.01 }
        zone box nd_ubz { from: 0, 0; size: node.width, node.height; role: button; label: "Close the workspaces"; show: nd_kind == 7 }
        on press nd_ubz { emit nd_key(27) }
        on scroll nd_ubz { emit nd_key(if(wheel > 0, 37, 39)) }
        // the orbit's ring, faint, round the node
        ellipse { at: node.width / 2, node.height / 2; radius: nd_ur * nd_uf; scale: 1, 0.33; stroke: 1; color: fl.trace_lit; opacity: 0.25 * nd_uf; show: nd_uf > 0.01 }
        for u in un {
            let ua = 90 + (u.i - nd_rot) * 360 / max(1, nd_un_n)
            let ud = (sin(ua) + 1) / 2
            let us = (0.55 + 0.45 * ud) * (0.6 + 0.4 * nd_uf)
            let ux = node.width / 2 + cos(ua) * nd_ur * nd_uf
            let uy = node.height / 2 + sin(ua) * nd_ur * 0.33 * nd_uf
            let tw = if(nd_upic, 280, 240) * us
            let th = if(nd_upic, 176, 140) * us
            let front = ud > 0.97
            let ucr = max(3, 12 * us * nd_rnd)
            group { opacity: nd_uf * (0.45 + 0.55 * ud); show: nd_uf > 0.01; z: ud * 10
                group { glow: 22, if(front, 0.7, 0.15) * nd_gw, nd_glc
                    box { from: ux - tw / 2, uy - th / 2; size: tw, th; corner: ucr; color: fl.hull; opacity: 0.94 } }
                box { from: ux - tw / 2, uy - th / 2; size: tw, th; corner: ucr; stroke: if(front, 2, 1); color: if(front, nd_acc, fl.trace_lit) }
                text u.n { at: ux, uy - th / 2 + 26 * us; anchor: center; align: center; size: 22 * us; weight: 700; family: "Share Tech Mono"; color: if(front, nd_acc, fl.engrave); show: not nd_upic }
                text u.apps { at: ux, uy + 12 * us; anchor: center; align: center; size: 11 * us; family: "Exo 2"; color: fl.muted; width: tw - 20; lines: 2; show: not nd_upic }
                // (D294) live pictures of its windows under a small number; an empty workspace says so
                group { show: nd_upic
                    text u.n { at: ux - tw / 2 + 12 * us, uy - th / 2 + 14 * us; anchor: left center; size: 13 * us; weight: 700; family: "Share Tech Mono"; color: if(front, nd_acc, fl.engrave) }
                    text u.apps { at: ux - tw / 2 + 30 * us, uy - th / 2 + 14 * us; anchor: left center; size: 9 * us; family: "Exo 2"; color: fl.muted; width: tw - 44 * us; lines: 1 }
                    text "empty" { at: ux, uy + 8 * us; anchor: center; align: center; size: 11 * us; family: "Exo 2"; color: fl.muted; opacity: 0.6; show: u.empty }
                }
                zone box ut { from: ux - tw / 2, uy - th / 2; size: tw, th; corner: 12; cursor: pointer; role: button; label: "Workspace {u.n}"; show: nd_kind == 7 }
                on press ut { emit nd_un(u.id) }
            }
        }
        // (D294) the windows' live pictures, one flat loop placed at their tile by the same orbit, just above it
        for p in up {
            let pa = 90 + (p.tile - nd_rot) * 360 / max(1, nd_un_n)
            let pdp = (sin(pa) + 1) / 2
            let ps = (0.55 + 0.45 * pdp) * (0.6 + 0.4 * nd_uf)
            let pcx = node.width / 2 + cos(pa) * nd_ur * nd_uf
            let pcy = node.height / 2 + sin(pa) * nd_ur * 0.33 * nd_uf
            let ptw = 280 * ps
            let pth = 176 * ps
            let pw = (ptw - 16 * ps) * p.fw
            let ph = (pth - 34 * ps) * p.fh
            let px = pcx - ptw / 2 + 8 * ps + (ptw - 16 * ps) * p.fx
            let py = pcy - pth / 2 + 26 * ps + (pth - 34 * ps) * p.fy
            group { opacity: nd_uf * (0.45 + 0.55 * pdp); show: nd_uf > 0.01; z: pdp * 10 + 0.05
                group { clip box { from: px, py; size: pw, ph; corner: max(2, 6 * ps * nd_rnd) }
                    box { from: px, py; size: pw, ph; color: fl.ground }
                    image p.img { at: px, py; size: pw, ph; fit: cover } }
                box { from: px, py; size: pw, ph; corner: max(2, 6 * ps * nd_rnd); stroke: 1; color: fl.trace_dim } }
        }
        // the body: one shape that is the seed, a capsule, a rail, a search line — its glow by the look, swelling
        // a little with the music as far as the look lets it
        // the left corner notch (D295)
        group { show: nd_lwk > 1 and not nd_studio; opacity: min(1, nd_lwk / 40)
            body { color: fl.ground
                path {
                    move 0, 0
                    line nd_lwk + 12, 0
                    curve nd_lwk, 12 via nd_lwk, 0
                    line nd_lwk, 16
                    curve nd_lwk - 12, 28 via nd_lwk, 28
                    line 12, 28
                    curve 0, 40 via 0, 28
                    close } }
            path { stroke: 1; color: fl.trace; opacity: 0.85
                move 0, 0
                line nd_lwk + 12, 0
                curve nd_lwk, 12 via nd_lwk, 0
                line nd_lwk, 16
                curve nd_lwk - 12, 28 via nd_lwk, 28
                line 12, 28
                curve 0, 40 via 0, 28
            }
            for m in lml {
                let mx = 0 + m.x
                text m.label { at: mx, 14; anchor: left center; size: 11; weight: 700; family: "Share Tech Mono"; color: if(m.kind == 1, nd_acc, fl.engrave); width: m.w; lines: 1; show: m.kind == 1 or m.kind == 4 or m.kind >= 6 }
                text m.label { at: mx + if(m.kind == 5, 10, 0), 14; anchor: left center; size: 10; family: "Exo 2"; color: fl.engrave; width: m.w - if(m.kind == 5, 10, 0); lines: 1; show: m.kind == 2 or m.kind == 5 }
                repeat wsd in 0..10 { ellipse { at: mx + 4 + wsd * 12, 14; radius: if(wsd == nd_lmwa, 3.5, 2); color: if(wsd == nd_lmwa, nd_acc, fl.muted); show: m.kind == 3 and wsd < nd_lmws } }
                box { from: mx + m.w - 3, 9; size: 2, 10 * nd_lmbat; color: if(nd_lmbat < 0.2, fl.ember, nd_acc); show: m.kind == 4 }
                ellipse { at: mx + 3, 14; radius: 2 + 2 * lv.level; color: nd_acc; show: m.kind == 5 }
                // D308: CPU, memory and volume carry a meter under their words
                box { from: mx, 21; size: m.w - 4, 2; corner: 1; color: fl.trace_dim; show: m.lv >= 0 }
                box { from: mx, 21; size: (m.w - 4) * max(0, m.lv), 2; corner: 1; color: if(m.lv > 0.85, fl.ember, nd_acc); show: m.lv >= 0 }
            }
            group { show: nd_fxl >= 0
                for q in ck { box { from: (0 + nd_fxl) + 8 + q.x * 2, 3 + 4 + q.y * 2; size: 1.6, 1.6; color: nd_acc; opacity: 0.75 + 0.25 * nd_br; show: nd_cks == 0 } }
                text nd_ckd { at: (0 + nd_fxl) + pick(nd_cks, 74, 62, 30, 170, 56, 86) / 2, 3 + 11; anchor: center; align: center; size: 13; weight: 700; family: "Share Tech Mono"; color: nd_acc; show: nd_cks == 1 }
                group { show: nd_cks == 2
                    ellipse { at: (0 + nd_fxl) + 15, 3 + 11; radius: 10; stroke: 1; color: nd_acc; opacity: 0.5 }
                    line { from: (0 + nd_fxl) + 15, 3 + 11; to: (0 + nd_fxl) + 15 + sin(nd_ckh) * 5, 3 + 11 - cos(nd_ckh) * 5; width: 2; color: fl.engrave }
                    line { from: (0 + nd_fxl) + 15, 3 + 11; to: (0 + nd_fxl) + 15 + sin(nd_ckm) * 8, 3 + 11 - cos(nd_ckm) * 8; width: 1.4; color: nd_acc } }
                text nd_ckw { at: (0 + nd_fxl) + 85, 3 + 11; anchor: center; align: center; size: 10; family: "Exo 2"; color: fl.engrave; width: 160; lines: 1; show: nd_cks == 3 }
                ellipse { at: (0 + nd_fxl) + 9 + 0 * 7.6, 3 + 7 + 0 * 8; radius: 2.2; color: if(nd_cb0, nd_acc, fl.trace_dim); show: nd_cks == 4 }
                ellipse { at: (0 + nd_fxl) + 9 + 1 * 7.6, 3 + 7 + 0 * 8; radius: 2.2; color: if(nd_cb1, nd_acc, fl.trace_dim); show: nd_cks == 4 }
                ellipse { at: (0 + nd_fxl) + 9 + 2 * 7.6, 3 + 7 + 0 * 8; radius: 2.2; color: if(nd_cb2, nd_acc, fl.trace_dim); show: nd_cks == 4 }
                ellipse { at: (0 + nd_fxl) + 9 + 3 * 7.6, 3 + 7 + 0 * 8; radius: 2.2; color: if(nd_cb3, nd_acc, fl.trace_dim); show: nd_cks == 4 }
                ellipse { at: (0 + nd_fxl) + 9 + 4 * 7.6, 3 + 7 + 0 * 8; radius: 2.2; color: if(nd_cb4, nd_acc, fl.trace_dim); show: nd_cks == 4 }
                ellipse { at: (0 + nd_fxl) + 9 + 5 * 7.6, 3 + 7 + 0 * 8; radius: 2.2; color: if(nd_cb5, nd_acc, fl.trace_dim); show: nd_cks == 4 }
                ellipse { at: (0 + nd_fxl) + 9 + 0 * 7.6, 3 + 7 + 1 * 8; radius: 2.2; color: if(nd_cb6, nd_acc, fl.trace_dim); show: nd_cks == 4 }
                ellipse { at: (0 + nd_fxl) + 9 + 1 * 7.6, 3 + 7 + 1 * 8; radius: 2.2; color: if(nd_cb7, nd_acc, fl.trace_dim); show: nd_cks == 4 }
                ellipse { at: (0 + nd_fxl) + 9 + 2 * 7.6, 3 + 7 + 1 * 8; radius: 2.2; color: if(nd_cb8, nd_acc, fl.trace_dim); show: nd_cks == 4 }
                ellipse { at: (0 + nd_fxl) + 9 + 3 * 7.6, 3 + 7 + 1 * 8; radius: 2.2; color: if(nd_cb9, nd_acc, fl.trace_dim); show: nd_cks == 4 }
                ellipse { at: (0 + nd_fxl) + 9 + 4 * 7.6, 3 + 7 + 1 * 8; radius: 2.2; color: if(nd_cb10, nd_acc, fl.trace_dim); show: nd_cks == 4 }
                ellipse { at: (0 + nd_fxl) + 9 + 5 * 7.6, 3 + 7 + 1 * 8; radius: 2.2; color: if(nd_cb11, nd_acc, fl.trace_dim); show: nd_cks == 4 }
                repeat dh in 0..12 { ellipse { at: (0 + nd_fxl) + 8 + dh * 6.4, 3 + 7; radius: 1.8; color: if(dh < nd_ckdh, nd_acc, fl.trace_dim); show: nd_cks == 5 } }
                repeat dm in 0..12 { ellipse { at: (0 + nd_fxl) + 8 + dm * 6.4, 3 + 15; radius: 1.8; color: if(dm < nd_ckdm, fl.engrave, fl.trace_dim); show: nd_cks == 5 } }
            }
            zone box ndz_lc { from: 0, 0; size: nd_lwk, 28; cursor: pointer; role: button; label: "Open the panel"; show: nd_kind == 0 and nd_lwk > 1 }
            on press ndz_lc { emit nd_cmd(1) }
        }
        // the right corner notch (D295)
        group { show: nd_rwk > 1 and not nd_studio; opacity: min(1, nd_rwk / 40)
            body { color: fl.ground
                path {
                    move node.width - (0), 0
                    line node.width - (nd_rwk + 12), 0
                    curve node.width - (nd_rwk), 12 via node.width - (nd_rwk), 0
                    line node.width - (nd_rwk), 16
                    curve node.width - (nd_rwk - 12), 28 via node.width - (nd_rwk), 28
                    line node.width - (12), 28
                    curve node.width - (0), 40 via node.width - (0), 28
                    close } }
            path { stroke: 1; color: fl.trace; opacity: 0.85
                move node.width - (0), 0
                line node.width - (nd_rwk + 12), 0
                curve node.width - (nd_rwk), 12 via node.width - (nd_rwk), 0
                line node.width - (nd_rwk), 16
                curve node.width - (nd_rwk - 12), 28 via node.width - (nd_rwk), 28
                line node.width - (12), 28
                curve node.width - (0), 40 via node.width - (0), 28
            }
            for m in lmr {
                let mx = node.width - nd_rwk + m.x
                text m.label { at: mx, 14; anchor: left center; size: 11; weight: 700; family: "Share Tech Mono"; color: if(m.kind == 1, nd_acc, fl.engrave); width: m.w; lines: 1; show: m.kind == 1 or m.kind == 4 or m.kind >= 6 }
                text m.label { at: mx + if(m.kind == 5, 10, 0), 14; anchor: left center; size: 10; family: "Exo 2"; color: fl.engrave; width: m.w - if(m.kind == 5, 10, 0); lines: 1; show: m.kind == 2 or m.kind == 5 }
                repeat wsd in 0..10 { ellipse { at: mx + 4 + wsd * 12, 14; radius: if(wsd == nd_lmwa, 3.5, 2); color: if(wsd == nd_lmwa, nd_acc, fl.muted); show: m.kind == 3 and wsd < nd_lmws } }
                box { from: mx + m.w - 3, 9; size: 2, 10 * nd_lmbat; color: if(nd_lmbat < 0.2, fl.ember, nd_acc); show: m.kind == 4 }
                ellipse { at: mx + 3, 14; radius: 2 + 2 * lv.level; color: nd_acc; show: m.kind == 5 }
                // D308: CPU, memory and volume carry a meter under their words
                box { from: mx, 21; size: m.w - 4, 2; corner: 1; color: fl.trace_dim; show: m.lv >= 0 }
                box { from: mx, 21; size: (m.w - 4) * max(0, m.lv), 2; corner: 1; color: if(m.lv > 0.85, fl.ember, nd_acc); show: m.lv >= 0 }
            }
            group { show: nd_fxr >= 0
                for q in ck { box { from: (node.width - nd_rwk + nd_fxr) + 8 + q.x * 2, 3 + 4 + q.y * 2; size: 1.6, 1.6; color: nd_acc; opacity: 0.75 + 0.25 * nd_br; show: nd_cks == 0 } }
                text nd_ckd { at: (node.width - nd_rwk + nd_fxr) + pick(nd_cks, 74, 62, 30, 170, 56, 86) / 2, 3 + 11; anchor: center; align: center; size: 13; weight: 700; family: "Share Tech Mono"; color: nd_acc; show: nd_cks == 1 }
                group { show: nd_cks == 2
                    ellipse { at: (node.width - nd_rwk + nd_fxr) + 15, 3 + 11; radius: 10; stroke: 1; color: nd_acc; opacity: 0.5 }
                    line { from: (node.width - nd_rwk + nd_fxr) + 15, 3 + 11; to: (node.width - nd_rwk + nd_fxr) + 15 + sin(nd_ckh) * 5, 3 + 11 - cos(nd_ckh) * 5; width: 2; color: fl.engrave }
                    line { from: (node.width - nd_rwk + nd_fxr) + 15, 3 + 11; to: (node.width - nd_rwk + nd_fxr) + 15 + sin(nd_ckm) * 8, 3 + 11 - cos(nd_ckm) * 8; width: 1.4; color: nd_acc } }
                text nd_ckw { at: (node.width - nd_rwk + nd_fxr) + 85, 3 + 11; anchor: center; align: center; size: 10; family: "Exo 2"; color: fl.engrave; width: 160; lines: 1; show: nd_cks == 3 }
                ellipse { at: (node.width - nd_rwk + nd_fxr) + 9 + 0 * 7.6, 3 + 7 + 0 * 8; radius: 2.2; color: if(nd_cb0, nd_acc, fl.trace_dim); show: nd_cks == 4 }
                ellipse { at: (node.width - nd_rwk + nd_fxr) + 9 + 1 * 7.6, 3 + 7 + 0 * 8; radius: 2.2; color: if(nd_cb1, nd_acc, fl.trace_dim); show: nd_cks == 4 }
                ellipse { at: (node.width - nd_rwk + nd_fxr) + 9 + 2 * 7.6, 3 + 7 + 0 * 8; radius: 2.2; color: if(nd_cb2, nd_acc, fl.trace_dim); show: nd_cks == 4 }
                ellipse { at: (node.width - nd_rwk + nd_fxr) + 9 + 3 * 7.6, 3 + 7 + 0 * 8; radius: 2.2; color: if(nd_cb3, nd_acc, fl.trace_dim); show: nd_cks == 4 }
                ellipse { at: (node.width - nd_rwk + nd_fxr) + 9 + 4 * 7.6, 3 + 7 + 0 * 8; radius: 2.2; color: if(nd_cb4, nd_acc, fl.trace_dim); show: nd_cks == 4 }
                ellipse { at: (node.width - nd_rwk + nd_fxr) + 9 + 5 * 7.6, 3 + 7 + 0 * 8; radius: 2.2; color: if(nd_cb5, nd_acc, fl.trace_dim); show: nd_cks == 4 }
                ellipse { at: (node.width - nd_rwk + nd_fxr) + 9 + 0 * 7.6, 3 + 7 + 1 * 8; radius: 2.2; color: if(nd_cb6, nd_acc, fl.trace_dim); show: nd_cks == 4 }
                ellipse { at: (node.width - nd_rwk + nd_fxr) + 9 + 1 * 7.6, 3 + 7 + 1 * 8; radius: 2.2; color: if(nd_cb7, nd_acc, fl.trace_dim); show: nd_cks == 4 }
                ellipse { at: (node.width - nd_rwk + nd_fxr) + 9 + 2 * 7.6, 3 + 7 + 1 * 8; radius: 2.2; color: if(nd_cb8, nd_acc, fl.trace_dim); show: nd_cks == 4 }
                ellipse { at: (node.width - nd_rwk + nd_fxr) + 9 + 3 * 7.6, 3 + 7 + 1 * 8; radius: 2.2; color: if(nd_cb9, nd_acc, fl.trace_dim); show: nd_cks == 4 }
                ellipse { at: (node.width - nd_rwk + nd_fxr) + 9 + 4 * 7.6, 3 + 7 + 1 * 8; radius: 2.2; color: if(nd_cb10, nd_acc, fl.trace_dim); show: nd_cks == 4 }
                ellipse { at: (node.width - nd_rwk + nd_fxr) + 9 + 5 * 7.6, 3 + 7 + 1 * 8; radius: 2.2; color: if(nd_cb11, nd_acc, fl.trace_dim); show: nd_cks == 4 }
                repeat dh in 0..12 { ellipse { at: (node.width - nd_rwk + nd_fxr) + 8 + dh * 6.4, 3 + 7; radius: 1.8; color: if(dh < nd_ckdh, nd_acc, fl.trace_dim); show: nd_cks == 5 } }
                repeat dm in 0..12 { ellipse { at: (node.width - nd_rwk + nd_fxr) + 8 + dm * 6.4, 3 + 15; radius: 1.8; color: if(dm < nd_ckdm, fl.engrave, fl.trace_dim); show: nd_cks == 5 } }
            }
            zone box ndz_rc { from: node.width - nd_rwk, 0; size: nd_rwk, 28; cursor: pointer; role: button; label: "Open the panel"; show: nd_kind == 0 and nd_rwk > 1 }
            on press ndz_rc { emit nd_cmd(1) }
        }
        let nd_glow = nd_gw * (1 + 0.4 * lv.level * nd_mu)
        let nd_sw = nb_w + if(nd_kind == 0 and nd_playing and nd_smu == 1, lv.level * 16 * nd_mu, 0)
        let nd_sx = nb_x - (nd_sw - nb_w) / 2
        let nd_sh = nb_h * if(nd_kind == 0, 1 + 0.35 * nd_br * nd_bd, 1)
        let nd_sy = nb_y - (nd_sh - nb_h) / 2
        let nd_sr = min(nb_r, nd_sh / 2)
        // the seed: a line, a bar or a dot (filled), a ring (an outline), twins (two halves breathing in turn)
        group { show: nd_kind == 0 and not nd_cap and nd_seed != 5 and nd_seed != 6 and nd_long == 0; glow: 8, (0.35 + 0.35 * nd_br * nd_bd) * nd_gw / 0.7, nd_glc
            box { from: nd_sx, nd_sy; size: nd_sw, nd_sh; corner: nd_sr; color: nd_acc; opacity: (0.55 + 0.35 * nd_br) * nd_fill; show: nd_seed == 0 or nd_seed == 1 or nd_seed == 4 }
            box { from: nd_sx, nd_sy; size: nd_sw, nd_sh; corner: nd_sr; stroke: 1.5; color: nd_acc; opacity: 0.6 + 0.35 * nd_br; show: nd_seed == 2 }
            box { from: nd_sx, nd_sy; size: nd_sw * 0.45, nd_sh; corner: nd_sr; color: nd_acc; opacity: (0.55 + 0.35 * nd_br) * nd_fill; show: nd_seed == 3 }
            box { from: nd_sx + nd_sw * 0.55, nd_sy; size: nd_sw * 0.45, nd_sh; corner: nd_sr; color: nd_acc; opacity: (0.55 + 0.35 * (1 - nd_br)) * nd_fill; show: nd_seed == 3 }
            // (D296) an orb: a sphere of light, its highlight up and to the left
            group { show: nd_seed == 7
                ellipse { at: nd_sx + nd_sw / 2, nd_sy + nd_sh / 2; radius: nd_sw / 2; color: nd_acc; opacity: (0.45 + 0.3 * nd_br) * nd_fill }
                ellipse { at: nd_sx + nd_sw / 2, nd_sy + nd_sh / 2; radius: nd_sw / 2 * 0.62; color: nd_acc; opacity: 0.55 * nd_fill }
                ellipse { at: nd_sx + nd_sw * 0.36, nd_sy + nd_sh * 0.34; radius: nd_sw * 0.13; color: #ffffff; opacity: 0.55 } }
            // (D296) a comet: a bright head, its tail thinning behind it and swaying as it breathes
            group { show: nd_seed == 8
                ellipse { at: nd_sx + nd_sw - nd_sh / 2 - 0.111 * (nd_sw - nd_sh), nd_sy + nd_sh / 2 + sin(0 + nd_br * 180) * 0.111 * nd_sh * 0.4; radius: nd_sh / 2 * 0.906; color: nd_acc; opacity: 0.622 * nd_fill }
                ellipse { at: nd_sx + nd_sw - nd_sh / 2 - 0.222 * (nd_sw - nd_sh), nd_sy + nd_sh / 2 + sin(40 + nd_br * 180) * 0.222 * nd_sh * 0.4; radius: nd_sh / 2 * 0.811; color: nd_acc; opacity: 0.544 * nd_fill }
                ellipse { at: nd_sx + nd_sw - nd_sh / 2 - 0.333 * (nd_sw - nd_sh), nd_sy + nd_sh / 2 + sin(80 + nd_br * 180) * 0.333 * nd_sh * 0.4; radius: nd_sh / 2 * 0.717; color: nd_acc; opacity: 0.467 * nd_fill }
                ellipse { at: nd_sx + nd_sw - nd_sh / 2 - 0.444 * (nd_sw - nd_sh), nd_sy + nd_sh / 2 + sin(120 + nd_br * 180) * 0.444 * nd_sh * 0.4; radius: nd_sh / 2 * 0.622; color: nd_acc; opacity: 0.389 * nd_fill }
                ellipse { at: nd_sx + nd_sw - nd_sh / 2 - 0.556 * (nd_sw - nd_sh), nd_sy + nd_sh / 2 + sin(160 + nd_br * 180) * 0.556 * nd_sh * 0.4; radius: nd_sh / 2 * 0.528; color: nd_acc; opacity: 0.311 * nd_fill }
                ellipse { at: nd_sx + nd_sw - nd_sh / 2 - 0.667 * (nd_sw - nd_sh), nd_sy + nd_sh / 2 + sin(200 + nd_br * 180) * 0.667 * nd_sh * 0.4; radius: nd_sh / 2 * 0.433; color: nd_acc; opacity: 0.233 * nd_fill }
                ellipse { at: nd_sx + nd_sw - nd_sh / 2 - 0.778 * (nd_sw - nd_sh), nd_sy + nd_sh / 2 + sin(240 + nd_br * 180) * 0.778 * nd_sh * 0.4; radius: nd_sh / 2 * 0.339; color: nd_acc; opacity: 0.156 * nd_fill }
                ellipse { at: nd_sx + nd_sw - nd_sh / 2 - 0.889 * (nd_sw - nd_sh), nd_sy + nd_sh / 2 + sin(280 + nd_br * 180) * 0.889 * nd_sh * 0.4; radius: nd_sh / 2 * 0.244; color: nd_acc; opacity: 0.078 * nd_fill }
                ellipse { at: nd_sx + nd_sw - nd_sh / 2, nd_sy + nd_sh / 2; radius: nd_sh / 2; color: nd_acc; opacity: (0.75 + 0.25 * nd_br) * nd_fill }
                ellipse { at: nd_sx + nd_sw - nd_sh / 2, nd_sy + nd_sh / 2; radius: nd_sh / 4; color: #ffffff; opacity: 0.6 } }
        }
        // the seed with music as bars (D246): five little bars over it while something plays
        group { show: nd_kind == 0 and nd_smu == 2 and nd_playing and not nd_cap and nd_seed != 5 and nd_long == 0
            box { from: nb_x + nb_w / 2 - 14 + 0 * 6, nb_y + nb_h / 2 + 1 - (2 + nd_sp13 * 9 * nd_mu); size: 3.5, 2 * (2 + nd_sp13 * 9 * nd_mu); corner: 1.5; color: nd_acc; opacity: 0.95 }
            box { from: nb_x + nb_w / 2 - 14 + 1 * 6, nb_y + nb_h / 2 + 1 - (2 + nd_sp14 * 9 * nd_mu); size: 3.5, 2 * (2 + nd_sp14 * 9 * nd_mu); corner: 1.5; color: nd_acc; opacity: 0.95 }
            box { from: nb_x + nb_w / 2 - 14 + 2 * 6, nb_y + nb_h / 2 + 1 - (2 + nd_sp15 * 9 * nd_mu); size: 3.5, 2 * (2 + nd_sp15 * 9 * nd_mu); corner: 1.5; color: nd_acc; opacity: 0.95 }
            box { from: nb_x + nb_w / 2 - 14 + 3 * 6, nb_y + nb_h / 2 + 1 - (2 + nd_sp16 * 9 * nd_mu); size: 3.5, 2 * (2 + nd_sp16 * 9 * nd_mu); corner: 1.5; color: nd_acc; opacity: 0.95 }
            box { from: nb_x + nb_w / 2 - 14 + 4 * 6, nb_y + nb_h / 2 + 1 - (2 + nd_sp17 * 9 * nd_mu); size: 3.5, 2 * (2 + nd_sp17 * 9 * nd_mu); corner: 1.5; color: nd_acc; opacity: 0.95 }
        }
        // the long pill (D248): at rest, a pill that holds the modules the look chose — the time, what has the focus,
        // the workspaces, the battery, what plays
        group { show: nd_kind == 0 and nd_long > 0 and not nd_cap
            // the long pill's body
            group { glow: 10, 0.4 * nd_gw, nd_glc; show: nd_long == 1
                box { from: nb_x, nb_y; size: nb_w, nb_h; corner: nb_r; color: fl.hull; opacity: nd_fill } }
            box { from: nb_x, nb_y; size: nb_w, nb_h; corner: nb_r; stroke: nd_ol; color: nd_acc; opacity: 0.4; show: nd_long == 1 and nd_ol > 0.05 }
            // the notch (D251): hanging from the screen's top edge, square where it meets it, rounded below, and curved
            // out into the edge either side, as a notch is
            // (D257: drawn here only without the frame; with it, the frame draws the notch as a piece of its own body)
            group { show: nd_long == 2 and not nd_nfr; glow: 10, 0.3 * nd_gw, nd_glc
                box { from: nb_x, nb_y - 16; size: nb_w, nb_h + 16; corner: min(14, nb_h / 2 + 4) * max(0.3, nd_rnd); color: fl.ground }
                path { at: nb_x, nb_y; move -10, 0; curve 0, 10 via 0, 0; line 0, 0; close; color: fl.ground }
                path { at: nb_x + nb_w, nb_y; move 10, 0; curve 0, 10 via 0, 0; line 0, 0; close; color: fl.ground } }
            box { from: nb_x + 14, nb_y + nb_h - 1.5; size: (nb_w - 28) * (0.3 + 0.7 * lv.level * nd_mu), 1.5; corner: 1; color: nd_acc; opacity: 0.6; show: nd_long == 2 and nd_playing }
            group { opacity: nd_cf
                clip box { from: nb_x, nb_y; size: nb_w, nb_h; corner: nb_r }
                for m in lm {
                    let mx = nb_x + m.x
                    text m.label { at: mx, nb_y + nb_h / 2; anchor: left center; size: 11; weight: 700; family: "Share Tech Mono"; color: if(m.kind == 1, nd_acc, fl.engrave); width: m.w; lines: 1; show: m.kind == 1 or m.kind == 4 or m.kind >= 6 }
                    text m.label { at: mx + if(m.kind == 5, 10, 0), nb_y + nb_h / 2; anchor: left center; size: 10; family: "Exo 2"; color: fl.engrave; width: m.w - if(m.kind == 5, 10, 0); lines: 1; show: m.kind == 2 or m.kind == 5 }
                    repeat wsd in 0..10 { ellipse { at: mx + 4 + wsd * 12, nb_y + nb_h / 2; radius: if(wsd == nd_lmwa, 3.5, 2); color: if(wsd == nd_lmwa, nd_acc, fl.muted); show: m.kind == 3 and wsd < nd_lmws } }
                    box { from: mx + m.w - 3, nb_y + nb_h / 2 - 5; size: 2, 10 * nd_lmbat; color: if(nd_lmbat < 0.2, fl.ember, nd_acc); show: m.kind == 4 }
                    ellipse { at: mx + 3, nb_y + nb_h / 2; radius: 2 + 2 * lv.level; color: nd_acc; show: m.kind == 5 }
                    // D308: CPU, memory and volume carry a meter under their words
                    box { from: mx, nb_y + nb_h / 2 + 8; size: m.w - 4, 2; corner: 1; color: fl.trace_dim; show: m.lv >= 0 }
                    box { from: mx, nb_y + nb_h / 2 + 8; size: (m.w - 4) * max(0, m.lv), 2; corner: 1; color: if(m.lv > 0.85, fl.ember, nd_acc); show: m.lv >= 0 }
                }
                group { show: nd_fxc >= 0
                    for q in ck { box { from: (nb_x + nd_fxc) + 8 + q.x * 2, (nb_y + nb_h / 2 - 11) + 4 + q.y * 2; size: 1.6, 1.6; color: nd_acc; opacity: 0.75 + 0.25 * nd_br; show: nd_cks == 0 } }
                    text nd_ckd { at: (nb_x + nd_fxc) + pick(nd_cks, 74, 62, 30, 170, 56, 86) / 2, (nb_y + nb_h / 2 - 11) + 11; anchor: center; align: center; size: 13; weight: 700; family: "Share Tech Mono"; color: nd_acc; show: nd_cks == 1 }
                    group { show: nd_cks == 2
                        ellipse { at: (nb_x + nd_fxc) + 15, (nb_y + nb_h / 2 - 11) + 11; radius: 10; stroke: 1; color: nd_acc; opacity: 0.5 }
                        line { from: (nb_x + nd_fxc) + 15, (nb_y + nb_h / 2 - 11) + 11; to: (nb_x + nd_fxc) + 15 + sin(nd_ckh) * 5, (nb_y + nb_h / 2 - 11) + 11 - cos(nd_ckh) * 5; width: 2; color: fl.engrave }
                        line { from: (nb_x + nd_fxc) + 15, (nb_y + nb_h / 2 - 11) + 11; to: (nb_x + nd_fxc) + 15 + sin(nd_ckm) * 8, (nb_y + nb_h / 2 - 11) + 11 - cos(nd_ckm) * 8; width: 1.4; color: nd_acc } }
                    text nd_ckw { at: (nb_x + nd_fxc) + 85, (nb_y + nb_h / 2 - 11) + 11; anchor: center; align: center; size: 10; family: "Exo 2"; color: fl.engrave; width: 160; lines: 1; show: nd_cks == 3 }
                    ellipse { at: (nb_x + nd_fxc) + 9 + 0 * 7.6, (nb_y + nb_h / 2 - 11) + 7 + 0 * 8; radius: 2.2; color: if(nd_cb0, nd_acc, fl.trace_dim); show: nd_cks == 4 }
                    ellipse { at: (nb_x + nd_fxc) + 9 + 1 * 7.6, (nb_y + nb_h / 2 - 11) + 7 + 0 * 8; radius: 2.2; color: if(nd_cb1, nd_acc, fl.trace_dim); show: nd_cks == 4 }
                    ellipse { at: (nb_x + nd_fxc) + 9 + 2 * 7.6, (nb_y + nb_h / 2 - 11) + 7 + 0 * 8; radius: 2.2; color: if(nd_cb2, nd_acc, fl.trace_dim); show: nd_cks == 4 }
                    ellipse { at: (nb_x + nd_fxc) + 9 + 3 * 7.6, (nb_y + nb_h / 2 - 11) + 7 + 0 * 8; radius: 2.2; color: if(nd_cb3, nd_acc, fl.trace_dim); show: nd_cks == 4 }
                    ellipse { at: (nb_x + nd_fxc) + 9 + 4 * 7.6, (nb_y + nb_h / 2 - 11) + 7 + 0 * 8; radius: 2.2; color: if(nd_cb4, nd_acc, fl.trace_dim); show: nd_cks == 4 }
                    ellipse { at: (nb_x + nd_fxc) + 9 + 5 * 7.6, (nb_y + nb_h / 2 - 11) + 7 + 0 * 8; radius: 2.2; color: if(nd_cb5, nd_acc, fl.trace_dim); show: nd_cks == 4 }
                    ellipse { at: (nb_x + nd_fxc) + 9 + 0 * 7.6, (nb_y + nb_h / 2 - 11) + 7 + 1 * 8; radius: 2.2; color: if(nd_cb6, nd_acc, fl.trace_dim); show: nd_cks == 4 }
                    ellipse { at: (nb_x + nd_fxc) + 9 + 1 * 7.6, (nb_y + nb_h / 2 - 11) + 7 + 1 * 8; radius: 2.2; color: if(nd_cb7, nd_acc, fl.trace_dim); show: nd_cks == 4 }
                    ellipse { at: (nb_x + nd_fxc) + 9 + 2 * 7.6, (nb_y + nb_h / 2 - 11) + 7 + 1 * 8; radius: 2.2; color: if(nd_cb8, nd_acc, fl.trace_dim); show: nd_cks == 4 }
                    ellipse { at: (nb_x + nd_fxc) + 9 + 3 * 7.6, (nb_y + nb_h / 2 - 11) + 7 + 1 * 8; radius: 2.2; color: if(nd_cb9, nd_acc, fl.trace_dim); show: nd_cks == 4 }
                    ellipse { at: (nb_x + nd_fxc) + 9 + 4 * 7.6, (nb_y + nb_h / 2 - 11) + 7 + 1 * 8; radius: 2.2; color: if(nd_cb10, nd_acc, fl.trace_dim); show: nd_cks == 4 }
                    ellipse { at: (nb_x + nd_fxc) + 9 + 5 * 7.6, (nb_y + nb_h / 2 - 11) + 7 + 1 * 8; radius: 2.2; color: if(nd_cb11, nd_acc, fl.trace_dim); show: nd_cks == 4 }
                    repeat dh in 0..12 { ellipse { at: (nb_x + nd_fxc) + 8 + dh * 6.4, (nb_y + nb_h / 2 - 11) + 7; radius: 1.8; color: if(dh < nd_ckdh, nd_acc, fl.trace_dim); show: nd_cks == 5 } }
                    repeat dm in 0..12 { ellipse { at: (nb_x + nd_fxc) + 8 + dm * 6.4, (nb_y + nb_h / 2 - 11) + 15; radius: 1.8; color: if(dm < nd_ckdm, fl.engrave, fl.trace_dim); show: nd_cks == 5 } }
                }
            }
        }
        // BMO as the seed (D253): his face on a small screen, quiet — no lines, only his expression; he sings to music
        group { show: nd_kind == 0 and nd_seed == 6 and not nd_cap and nd_long == 0; opacity: nd_cf
            BmoFace(nb_x + (nb_w - 50 * 0.6) / 2, nb_y + (nb_h - 34 * 0.6) / 2, true, 0.6, pb_lx, pb_ly)
        }
        // the clock seed: the time in mooi's 5×7 matrix, two pixels a cell, on a small capsule
        group { show: nd_kind == 0 and nd_seed == 5 and not nd_cap and nd_long == 0
            group { glow: 8, 0.4 * nd_gw, nd_glc
                box { from: nb_x, nb_y; size: nb_w, nb_h; corner: nb_r; color: fl.hull; opacity: nd_fill } }
            box { from: nb_x, nb_y; size: nb_w, nb_h; corner: nb_r; stroke: nd_ol; color: nd_acc; opacity: 0.45; show: nd_ol > 0.05 }
            for q in ck { box { from: nb_x + 8 + q.x * 2, nb_y + 4 + q.y * 2; size: 1.6, 1.6; color: nd_acc; opacity: (0.75 + 0.25 * nd_br) * nd_cf; show: nd_cks == 0 } }
            // (D255) the other ways of telling it
            text nd_ckd { at: nb_x + nb_w / 2, nb_y + nb_h / 2; anchor: center; align: center; size: 13; weight: 700; family: "Share Tech Mono"; color: nd_acc; opacity: nd_cf; show: nd_cks == 1 }
            group { show: nd_cks == 2; opacity: nd_cf
                line { from: nb_x + nb_w / 2, nb_y + nb_h / 2; to: nb_x + nb_w / 2 + sin(nd_ckh) * 6, nb_y + nb_h / 2 - cos(nd_ckh) * 6; width: 2; color: fl.engrave }
                line { from: nb_x + nb_w / 2, nb_y + nb_h / 2; to: nb_x + nb_w / 2 + sin(nd_ckm) * 9.5, nb_y + nb_h / 2 - cos(nd_ckm) * 9.5; width: 1.4; color: nd_acc }
                ellipse { at: nb_x + nb_w / 2, nb_y + nb_h / 2; radius: 1.6; color: nd_acc } }
            text nd_ckw { at: nb_x + nb_w / 2, nb_y + nb_h / 2; anchor: center; align: center; size: 10; family: "Exo 2"; color: fl.engrave; width: nb_w - 12; lines: 1; opacity: nd_cf; show: nd_cks == 3 }
            ellipse { at: nb_x + 9 + 0 * 7.6, nb_y + 7 + 0 * 8; radius: 2.2; color: if(nd_cb0, nd_acc, fl.trace_dim); opacity: nd_cf; show: nd_cks == 4 }
            ellipse { at: nb_x + 9 + 1 * 7.6, nb_y + 7 + 0 * 8; radius: 2.2; color: if(nd_cb1, nd_acc, fl.trace_dim); opacity: nd_cf; show: nd_cks == 4 }
            ellipse { at: nb_x + 9 + 2 * 7.6, nb_y + 7 + 0 * 8; radius: 2.2; color: if(nd_cb2, nd_acc, fl.trace_dim); opacity: nd_cf; show: nd_cks == 4 }
            ellipse { at: nb_x + 9 + 3 * 7.6, nb_y + 7 + 0 * 8; radius: 2.2; color: if(nd_cb3, nd_acc, fl.trace_dim); opacity: nd_cf; show: nd_cks == 4 }
            ellipse { at: nb_x + 9 + 4 * 7.6, nb_y + 7 + 0 * 8; radius: 2.2; color: if(nd_cb4, nd_acc, fl.trace_dim); opacity: nd_cf; show: nd_cks == 4 }
            ellipse { at: nb_x + 9 + 5 * 7.6, nb_y + 7 + 0 * 8; radius: 2.2; color: if(nd_cb5, nd_acc, fl.trace_dim); opacity: nd_cf; show: nd_cks == 4 }
            ellipse { at: nb_x + 9 + 0 * 7.6, nb_y + 7 + 1 * 8; radius: 2.2; color: if(nd_cb6, nd_acc, fl.trace_dim); opacity: nd_cf; show: nd_cks == 4 }
            ellipse { at: nb_x + 9 + 1 * 7.6, nb_y + 7 + 1 * 8; radius: 2.2; color: if(nd_cb7, nd_acc, fl.trace_dim); opacity: nd_cf; show: nd_cks == 4 }
            ellipse { at: nb_x + 9 + 2 * 7.6, nb_y + 7 + 1 * 8; radius: 2.2; color: if(nd_cb8, nd_acc, fl.trace_dim); opacity: nd_cf; show: nd_cks == 4 }
            ellipse { at: nb_x + 9 + 3 * 7.6, nb_y + 7 + 1 * 8; radius: 2.2; color: if(nd_cb9, nd_acc, fl.trace_dim); opacity: nd_cf; show: nd_cks == 4 }
            ellipse { at: nb_x + 9 + 4 * 7.6, nb_y + 7 + 1 * 8; radius: 2.2; color: if(nd_cb10, nd_acc, fl.trace_dim); opacity: nd_cf; show: nd_cks == 4 }
            ellipse { at: nb_x + 9 + 5 * 7.6, nb_y + 7 + 1 * 8; radius: 2.2; color: if(nd_cb11, nd_acc, fl.trace_dim); opacity: nd_cf; show: nd_cks == 4 }
            repeat dh in 0..12 { ellipse { at: nb_x + 8 + dh * 6.4, nb_y + 7; radius: 1.8; color: if(dh < nd_ckdh, nd_acc, fl.trace_dim); opacity: nd_cf; show: nd_cks == 5 } }
            repeat dm in 0..12 { ellipse { at: nb_x + 8 + dm * 6.4, nb_y + 15; radius: 1.8; color: if(dm < nd_ckdm, fl.engrave, fl.trace_dim); opacity: nd_cf; show: nd_cks == 5 } }
        }
        // (D296) the trail: a ghost of its outline a slow spring behind it, seen only while they differ
        box { from: nd_tgx, nd_tgy; size: nd_tgw, nd_tgh; corner: min(nb_r, nd_tgh / 2); stroke: 1; color: nd_acc; opacity: 0.35 * clamp((abs(nd_tgw - nb_w) + abs(nd_tgh - nb_h) + abs(nd_tgx - nb_x)) / 60, 0, 1); show: nd_trl == 1 }
        // grown: the body, of the look's fill (hollow: barely), its texture, its outline
        group { show: nd_kind > 0; glow: 14, nd_glow, nd_glc
            box { from: nb_x, nb_y; size: nb_w, nb_h; corner: nb_r; color: fl.hull; opacity: nd_fill * if(nd_tex == 1, 0.25, if(nd_tex == 5, 0.3, 1)) } }
        // (D296) glass: what is behind seen through it, frosted, and a line of light along its top
        box { from: nb_x, nb_y; size: nb_w, nb_h; corner: nb_r; color: fl.hull; glass: 100%; frost: 70%; show: nd_kind > 0 and nd_tex == 5 }
        box { from: nb_x + nb_r * 0.6, nb_y + 1.5; size: max(0, nb_w - nb_r * 1.2), 1.2; corner: 0.6; color: #ffffff; opacity: 0.35; show: nd_kind > 0 and nd_tex == 5 }
        // (D296) neon: a tube of light round a dark body
        group { show: nd_kind > 0 and nd_tex == 6; glow: 18, 0.9 + 0.4 * lv.level * nd_mu, nd_acc
            box { from: nb_x, nb_y; size: nb_w, nb_h; corner: nb_r; stroke: 2; color: nd_acc } }
        // (D296) aurora: two slow clouds of its colours drifting inside it
        group { show: nd_kind > 0 and nd_tex == 7
            clip box { from: nb_x, nb_y; size: nb_w, nb_h; corner: nb_r }
            group { blur: 18
                ellipse { at: nb_x + nb_w * (0.5 + 0.38 * sin(nd_aph)), nb_y + nb_h * (0.5 + 0.3 * cos(nd_aph * 1.3)); radius: max(nb_w, nb_h) * 0.42; color: nd_acc; opacity: 0.32 }
                ellipse { at: nb_x + nb_w * (0.5 + 0.38 * cos(nd_aph * 0.8)), nb_y + nb_h * (0.5 + 0.3 * sin(nd_aph * 1.1)); radius: max(nb_w, nb_h) * 0.36; color: nd_glc; opacity: 0.28 } }
        }
        group { show: nd_kind > 0 and nd_tex > 2 and nd_tex < 5
            clip box { from: nb_x, nb_y; size: nb_w, nb_h; corner: nb_r }
            repeat sl in 0..16 { box { from: nb_x, nb_y + (sl + 0.5) * nb_h / 16; size: nb_w, 1; color: nd_acc; opacity: 0.08; show: nd_tex == 3 } }
            repeat dr in 0..4 { repeat dc in 0..48 { ellipse { at: nb_x + (dc + 0.5) * nb_w / 48, nb_y + (dr + 0.5) * nb_h / 4; radius: 0.9; color: nd_acc; opacity: 0.18; show: nd_tex == 4 } } }
        }
        box { from: nb_x, nb_y; size: nb_w, nb_h; corner: nb_r; stroke: nd_ol; color: nd_acc; opacity: if(nd_tex == 1, 0.9, 0.55); show: nd_kind > 0 and nd_ol > 0.05 }
        // (D296) shimmer: a band of light crossing it, then a rest before the next (half of each turn is off it)
        group { show: nd_shm > 0 and nd_cf > 0.05 and not nd_cap
            clip box { from: nd_sx, nd_sy; size: nd_sw, nd_sh; corner: nd_sr }
            group { blur: 4
                box { from: nd_sx - 24 + (nd_sw + 48) * (mod(nd_shp, 360) / 180), nd_sy - 2; size: 14, nd_sh + 4; color: #ffffff; opacity: 0.28 * nd_cf } }
        }
        // segmented: the outline breaks in three places; and a cyber node glitches on a change (a shifted ghost and a
        // scan line in the counter-signal)
        box { from: nb_x + nb_w * 0.3, nb_y - 1; size: nb_w * 0.12, nd_ol + 2; color: fl.ground; show: nd_tex == 2 and nd_kind > 0 }
        box { from: nb_x + nb_w * 0.7, nb_y + nb_h - nd_ol - 1; size: nb_w * 0.08, nd_ol + 2; color: fl.ground; show: nd_tex == 2 and nd_kind > 0 }
        box { from: nb_x - 1, nb_y + nb_h * 0.35; size: nd_ol + 2, nb_h * 0.3; color: fl.ground; show: nd_tex == 2 and nd_kind > 0 }
        box { from: nb_x + 4 * sin(nd_ph * 13), nb_y + 2 * cos(nd_ph * 7); size: nb_w, nb_h; corner: nb_r; stroke: 1; color: fl.ember; opacity: 0.7 * nd_glf; show: nd_np == 3 and nd_glf > 0.01 }
        box { from: nb_x + nb_w * 0.15, nb_y + nb_h * 0.4 + 3 * sin(nd_ph * 17); size: nb_w * 0.5, 2; color: fl.ember; opacity: 0.8 * nd_glf; show: nd_np == 3 and nd_glf > 0.01 }
        // technical: ticks along the floor and brackets at the corners
        repeat tk in 0..9 { box { from: nb_x + nb_w * (tk + 0.5) / 9, nb_y + nb_h - 3; size: 1, 3; color: nd_acc; opacity: 0.5; show: nd_np == 2 and nd_kind > 0 and nd_kind < 6 } }
        group { show: nd_np == 2 and nd_kind > 0
            box { from: nb_x - 4, nb_y - 4; size: 8, 1.5; color: nd_acc }
            box { from: nb_x - 4, nb_y - 4; size: 1.5, 8; color: nd_acc }
            box { from: nb_x + nb_w - 4, nb_y - 4; size: 8, 1.5; color: nd_acc }
            box { from: nb_x + nb_w + 2.5, nb_y - 4; size: 1.5, 8; color: nd_acc }
            box { from: nb_x - 4, nb_y + nb_h + 2.5; size: 8, 1.5; color: nd_acc }
            box { from: nb_x - 4, nb_y + nb_h - 4; size: 1.5, 8; color: nd_acc }
            box { from: nb_x + nb_w - 4, nb_y + nb_h + 2.5; size: 8, 1.5; color: nd_acc }
            box { from: nb_x + nb_w + 2.5, nb_y + nb_h - 4; size: 1.5, 8; color: nd_acc }
        }
        // organic: a second, softer skin round the body, there as what is inside appears
        box { from: nb_x - 3, nb_y - 3; size: nb_w + 6, nb_h + 6; corner: nb_r + 3; stroke: 1; color: nd_acc; opacity: 0.18 * nd_cf; show: nd_np == 0 and nd_kind > 0 }
        zone box nd_bz { from: nb_x - 16, nb_y - 8; size: nb_w + 32, nb_h + 16; corner: nb_r; cursor: pointer; role: button; label: "The Pill" }
        let nd_hv = nd_bz.hover
        on change nd_hv { emit nd_hover(if(nd_hv, 1 + round(pointer.x), 0)) }
        on press nd_bz { emit nd_press }
        on scroll nd_bz { emit nd_wheel(if(wheel > 0, 1, -1)) }
        // media: a lateral capsule — revealed by the body as it grows (its own clip), the music woven into it
        group { show: nd_kind == 1 and (nd_mf == 0 or nd_mf == 2); opacity: nd_cf
            clip box { from: nb_x, nb_y; size: nb_w, nb_h; corner: nb_r }
            // the music, by the look: bars from the floor, a wave through the middle, or dots that swell
            repeat vb in 0..40 { box { from: nb_x + 8 + vb * (nb_w - 16) / 40, nb_y + nb_h - (0.25 + 0.75 * abs(sin(vb * 47 + nd_vph))) * lv.level * nb_h * 0.7; size: (nb_w - 16) / 40 * 0.55, (0.25 + 0.75 * abs(sin(vb * 47 + nd_vph))) * lv.level * nb_h * 0.7 + 1; color: nd_acc; opacity: 0.16; show: nd_mf == 0 and nd_viz == 0 } }
            repeat vw in 0..60 { ellipse { at: nb_x + 8 + vw * (nb_w - 16) / 60, nb_y + nb_h / 2 + sin(vw * 14 + nd_vph * 2) * (0.15 + lv.level) * nb_h * 0.32; radius: 1.3; color: nd_acc; opacity: 0.3; show: nd_mf == 0 and nd_viz == 1 } }
            repeat vd in 0..24 { ellipse { at: nb_x + 14 + vd * (nb_w - 28) / 23, nb_y + nb_h - 8; radius: 1 + 3 * lv.level * abs(sin(vd * 31 + nd_vph)); color: nd_acc; opacity: 0.3; show: nd_mf == 0 and nd_viz == 2 } }
            group { clip box { from: nb_x + 8, nb_y + 8; size: 48, 48; corner: if(nd_cov == 1, 24, max(2, 10 * nd_rnd)) }
                box { from: nb_x + 8, nb_y + 8; size: 48, 48; color: fl.well }
                image nd_cover { at: nb_x + 8, nb_y + 8; size: 48, 48; fit: cover; show: nd_arted } }
            text nd_title { at: nb_x + 68, nb_y + 22; anchor: left center; size: 13; weight: 600; family: "Exo 2"; color: fl.engrave; width: nb_w - 200; lines: 1 }
            text nd_artist { at: nb_x + 68, nb_y + 40; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.muted; width: nb_w - 200; lines: 1 }
            box { from: nb_x + 68, nb_y + nb_h - 12; size: nb_w - 200, 2; corner: 1; color: fl.trace_dim }
            box { from: nb_x + 68, nb_y + nb_h - 12; size: (nb_w - 200) * nd_prog, 2; corner: 1; color: nd_acc }
            text "⏮" { at: nb_x + nb_w - 118 + 0 + 14, nb_y + nb_h / 2; anchor: center; align: center; size: 15; family: "Exo 2"; color: if(nmc1.hover, nd_acc, fl.engrave) }
            zone box nmc1 { from: nb_x + nb_w - 118 + 0, nb_y + nb_h / 2 - 14; size: 28, 28; corner: 14; cursor: pointer; role: button; label: "Back"; show: nd_kind == 1 and nd_mf == 0 }
            on press nmc1 { emit nd_media(1) }
            text "⏯" { at: nb_x + nb_w - 118 + 36 + 14, nb_y + nb_h / 2; anchor: center; align: center; size: 15; family: "Exo 2"; color: if(nmc2.hover, nd_acc, fl.engrave) }
            zone box nmc2 { from: nb_x + nb_w - 118 + 36, nb_y + nb_h / 2 - 14; size: 28, 28; corner: 14; cursor: pointer; role: button; label: "Play or pause"; show: nd_kind == 1 and nd_mf == 0 }
            on press nmc2 { emit nd_media(2) }
            text "⏭" { at: nb_x + nb_w - 118 + 72 + 14, nb_y + nb_h / 2; anchor: center; align: center; size: 15; family: "Exo 2"; color: if(nmc3.hover, nd_acc, fl.engrave) }
            zone box nmc3 { from: nb_x + nb_w - 118 + 72, nb_y + nb_h / 2 - 14; size: 28, 28; corner: 14; cursor: pointer; role: button; label: "Next"; show: nd_kind == 1 and nd_mf == 0 }
            on press nmc3 { emit nd_media(3) }
        }
        // the music as a visualiser: the node is nothing but its spectrum, mirrored round its middle, glowing
        group { show: nd_kind == 1 and nd_mf == 1; opacity: nd_cf
            group { glow: 12, 0.5 + 0.5 * nd_gw, nd_glc
                box { from: nb_x + 6 + 0 * (nb_w - 12) / 32 + 1, nb_y + nb_h / 2 - (0.08 + nd_sp0 * 0.92) * (nb_h / 2 - 3); size: (nb_w - 12) / 32 - 2, (0.08 + nd_sp0 * 0.92) * (nb_h - 6); corner: max(0.5, ((nb_w - 12) / 32 - 2) / 2 * nd_rnd); color: nd_acc; opacity: 0.55 + 0.45 * nd_sp0 }
                box { from: nb_x + 6 + 1 * (nb_w - 12) / 32 + 1, nb_y + nb_h / 2 - (0.08 + nd_sp1 * 0.92) * (nb_h / 2 - 3); size: (nb_w - 12) / 32 - 2, (0.08 + nd_sp1 * 0.92) * (nb_h - 6); corner: max(0.5, ((nb_w - 12) / 32 - 2) / 2 * nd_rnd); color: nd_acc; opacity: 0.55 + 0.45 * nd_sp1 }
                box { from: nb_x + 6 + 2 * (nb_w - 12) / 32 + 1, nb_y + nb_h / 2 - (0.08 + nd_sp2 * 0.92) * (nb_h / 2 - 3); size: (nb_w - 12) / 32 - 2, (0.08 + nd_sp2 * 0.92) * (nb_h - 6); corner: max(0.5, ((nb_w - 12) / 32 - 2) / 2 * nd_rnd); color: nd_acc; opacity: 0.55 + 0.45 * nd_sp2 }
                box { from: nb_x + 6 + 3 * (nb_w - 12) / 32 + 1, nb_y + nb_h / 2 - (0.08 + nd_sp3 * 0.92) * (nb_h / 2 - 3); size: (nb_w - 12) / 32 - 2, (0.08 + nd_sp3 * 0.92) * (nb_h - 6); corner: max(0.5, ((nb_w - 12) / 32 - 2) / 2 * nd_rnd); color: nd_acc; opacity: 0.55 + 0.45 * nd_sp3 }
                box { from: nb_x + 6 + 4 * (nb_w - 12) / 32 + 1, nb_y + nb_h / 2 - (0.08 + nd_sp4 * 0.92) * (nb_h / 2 - 3); size: (nb_w - 12) / 32 - 2, (0.08 + nd_sp4 * 0.92) * (nb_h - 6); corner: max(0.5, ((nb_w - 12) / 32 - 2) / 2 * nd_rnd); color: nd_acc; opacity: 0.55 + 0.45 * nd_sp4 }
                box { from: nb_x + 6 + 5 * (nb_w - 12) / 32 + 1, nb_y + nb_h / 2 - (0.08 + nd_sp5 * 0.92) * (nb_h / 2 - 3); size: (nb_w - 12) / 32 - 2, (0.08 + nd_sp5 * 0.92) * (nb_h - 6); corner: max(0.5, ((nb_w - 12) / 32 - 2) / 2 * nd_rnd); color: nd_acc; opacity: 0.55 + 0.45 * nd_sp5 }
                box { from: nb_x + 6 + 6 * (nb_w - 12) / 32 + 1, nb_y + nb_h / 2 - (0.08 + nd_sp6 * 0.92) * (nb_h / 2 - 3); size: (nb_w - 12) / 32 - 2, (0.08 + nd_sp6 * 0.92) * (nb_h - 6); corner: max(0.5, ((nb_w - 12) / 32 - 2) / 2 * nd_rnd); color: nd_acc; opacity: 0.55 + 0.45 * nd_sp6 }
                box { from: nb_x + 6 + 7 * (nb_w - 12) / 32 + 1, nb_y + nb_h / 2 - (0.08 + nd_sp7 * 0.92) * (nb_h / 2 - 3); size: (nb_w - 12) / 32 - 2, (0.08 + nd_sp7 * 0.92) * (nb_h - 6); corner: max(0.5, ((nb_w - 12) / 32 - 2) / 2 * nd_rnd); color: nd_acc; opacity: 0.55 + 0.45 * nd_sp7 }
                box { from: nb_x + 6 + 8 * (nb_w - 12) / 32 + 1, nb_y + nb_h / 2 - (0.08 + nd_sp8 * 0.92) * (nb_h / 2 - 3); size: (nb_w - 12) / 32 - 2, (0.08 + nd_sp8 * 0.92) * (nb_h - 6); corner: max(0.5, ((nb_w - 12) / 32 - 2) / 2 * nd_rnd); color: nd_acc; opacity: 0.55 + 0.45 * nd_sp8 }
                box { from: nb_x + 6 + 9 * (nb_w - 12) / 32 + 1, nb_y + nb_h / 2 - (0.08 + nd_sp9 * 0.92) * (nb_h / 2 - 3); size: (nb_w - 12) / 32 - 2, (0.08 + nd_sp9 * 0.92) * (nb_h - 6); corner: max(0.5, ((nb_w - 12) / 32 - 2) / 2 * nd_rnd); color: nd_acc; opacity: 0.55 + 0.45 * nd_sp9 }
                box { from: nb_x + 6 + 10 * (nb_w - 12) / 32 + 1, nb_y + nb_h / 2 - (0.08 + nd_sp10 * 0.92) * (nb_h / 2 - 3); size: (nb_w - 12) / 32 - 2, (0.08 + nd_sp10 * 0.92) * (nb_h - 6); corner: max(0.5, ((nb_w - 12) / 32 - 2) / 2 * nd_rnd); color: nd_acc; opacity: 0.55 + 0.45 * nd_sp10 }
                box { from: nb_x + 6 + 11 * (nb_w - 12) / 32 + 1, nb_y + nb_h / 2 - (0.08 + nd_sp11 * 0.92) * (nb_h / 2 - 3); size: (nb_w - 12) / 32 - 2, (0.08 + nd_sp11 * 0.92) * (nb_h - 6); corner: max(0.5, ((nb_w - 12) / 32 - 2) / 2 * nd_rnd); color: nd_acc; opacity: 0.55 + 0.45 * nd_sp11 }
                box { from: nb_x + 6 + 12 * (nb_w - 12) / 32 + 1, nb_y + nb_h / 2 - (0.08 + nd_sp12 * 0.92) * (nb_h / 2 - 3); size: (nb_w - 12) / 32 - 2, (0.08 + nd_sp12 * 0.92) * (nb_h - 6); corner: max(0.5, ((nb_w - 12) / 32 - 2) / 2 * nd_rnd); color: nd_acc; opacity: 0.55 + 0.45 * nd_sp12 }
                box { from: nb_x + 6 + 13 * (nb_w - 12) / 32 + 1, nb_y + nb_h / 2 - (0.08 + nd_sp13 * 0.92) * (nb_h / 2 - 3); size: (nb_w - 12) / 32 - 2, (0.08 + nd_sp13 * 0.92) * (nb_h - 6); corner: max(0.5, ((nb_w - 12) / 32 - 2) / 2 * nd_rnd); color: nd_acc; opacity: 0.55 + 0.45 * nd_sp13 }
                box { from: nb_x + 6 + 14 * (nb_w - 12) / 32 + 1, nb_y + nb_h / 2 - (0.08 + nd_sp14 * 0.92) * (nb_h / 2 - 3); size: (nb_w - 12) / 32 - 2, (0.08 + nd_sp14 * 0.92) * (nb_h - 6); corner: max(0.5, ((nb_w - 12) / 32 - 2) / 2 * nd_rnd); color: nd_acc; opacity: 0.55 + 0.45 * nd_sp14 }
                box { from: nb_x + 6 + 15 * (nb_w - 12) / 32 + 1, nb_y + nb_h / 2 - (0.08 + nd_sp15 * 0.92) * (nb_h / 2 - 3); size: (nb_w - 12) / 32 - 2, (0.08 + nd_sp15 * 0.92) * (nb_h - 6); corner: max(0.5, ((nb_w - 12) / 32 - 2) / 2 * nd_rnd); color: nd_acc; opacity: 0.55 + 0.45 * nd_sp15 }
                box { from: nb_x + 6 + 16 * (nb_w - 12) / 32 + 1, nb_y + nb_h / 2 - (0.08 + nd_sp16 * 0.92) * (nb_h / 2 - 3); size: (nb_w - 12) / 32 - 2, (0.08 + nd_sp16 * 0.92) * (nb_h - 6); corner: max(0.5, ((nb_w - 12) / 32 - 2) / 2 * nd_rnd); color: nd_acc; opacity: 0.55 + 0.45 * nd_sp16 }
                box { from: nb_x + 6 + 17 * (nb_w - 12) / 32 + 1, nb_y + nb_h / 2 - (0.08 + nd_sp17 * 0.92) * (nb_h / 2 - 3); size: (nb_w - 12) / 32 - 2, (0.08 + nd_sp17 * 0.92) * (nb_h - 6); corner: max(0.5, ((nb_w - 12) / 32 - 2) / 2 * nd_rnd); color: nd_acc; opacity: 0.55 + 0.45 * nd_sp17 }
                box { from: nb_x + 6 + 18 * (nb_w - 12) / 32 + 1, nb_y + nb_h / 2 - (0.08 + nd_sp18 * 0.92) * (nb_h / 2 - 3); size: (nb_w - 12) / 32 - 2, (0.08 + nd_sp18 * 0.92) * (nb_h - 6); corner: max(0.5, ((nb_w - 12) / 32 - 2) / 2 * nd_rnd); color: nd_acc; opacity: 0.55 + 0.45 * nd_sp18 }
                box { from: nb_x + 6 + 19 * (nb_w - 12) / 32 + 1, nb_y + nb_h / 2 - (0.08 + nd_sp19 * 0.92) * (nb_h / 2 - 3); size: (nb_w - 12) / 32 - 2, (0.08 + nd_sp19 * 0.92) * (nb_h - 6); corner: max(0.5, ((nb_w - 12) / 32 - 2) / 2 * nd_rnd); color: nd_acc; opacity: 0.55 + 0.45 * nd_sp19 }
                box { from: nb_x + 6 + 20 * (nb_w - 12) / 32 + 1, nb_y + nb_h / 2 - (0.08 + nd_sp20 * 0.92) * (nb_h / 2 - 3); size: (nb_w - 12) / 32 - 2, (0.08 + nd_sp20 * 0.92) * (nb_h - 6); corner: max(0.5, ((nb_w - 12) / 32 - 2) / 2 * nd_rnd); color: nd_acc; opacity: 0.55 + 0.45 * nd_sp20 }
                box { from: nb_x + 6 + 21 * (nb_w - 12) / 32 + 1, nb_y + nb_h / 2 - (0.08 + nd_sp21 * 0.92) * (nb_h / 2 - 3); size: (nb_w - 12) / 32 - 2, (0.08 + nd_sp21 * 0.92) * (nb_h - 6); corner: max(0.5, ((nb_w - 12) / 32 - 2) / 2 * nd_rnd); color: nd_acc; opacity: 0.55 + 0.45 * nd_sp21 }
                box { from: nb_x + 6 + 22 * (nb_w - 12) / 32 + 1, nb_y + nb_h / 2 - (0.08 + nd_sp22 * 0.92) * (nb_h / 2 - 3); size: (nb_w - 12) / 32 - 2, (0.08 + nd_sp22 * 0.92) * (nb_h - 6); corner: max(0.5, ((nb_w - 12) / 32 - 2) / 2 * nd_rnd); color: nd_acc; opacity: 0.55 + 0.45 * nd_sp22 }
                box { from: nb_x + 6 + 23 * (nb_w - 12) / 32 + 1, nb_y + nb_h / 2 - (0.08 + nd_sp23 * 0.92) * (nb_h / 2 - 3); size: (nb_w - 12) / 32 - 2, (0.08 + nd_sp23 * 0.92) * (nb_h - 6); corner: max(0.5, ((nb_w - 12) / 32 - 2) / 2 * nd_rnd); color: nd_acc; opacity: 0.55 + 0.45 * nd_sp23 }
                box { from: nb_x + 6 + 24 * (nb_w - 12) / 32 + 1, nb_y + nb_h / 2 - (0.08 + nd_sp24 * 0.92) * (nb_h / 2 - 3); size: (nb_w - 12) / 32 - 2, (0.08 + nd_sp24 * 0.92) * (nb_h - 6); corner: max(0.5, ((nb_w - 12) / 32 - 2) / 2 * nd_rnd); color: nd_acc; opacity: 0.55 + 0.45 * nd_sp24 }
                box { from: nb_x + 6 + 25 * (nb_w - 12) / 32 + 1, nb_y + nb_h / 2 - (0.08 + nd_sp25 * 0.92) * (nb_h / 2 - 3); size: (nb_w - 12) / 32 - 2, (0.08 + nd_sp25 * 0.92) * (nb_h - 6); corner: max(0.5, ((nb_w - 12) / 32 - 2) / 2 * nd_rnd); color: nd_acc; opacity: 0.55 + 0.45 * nd_sp25 }
                box { from: nb_x + 6 + 26 * (nb_w - 12) / 32 + 1, nb_y + nb_h / 2 - (0.08 + nd_sp26 * 0.92) * (nb_h / 2 - 3); size: (nb_w - 12) / 32 - 2, (0.08 + nd_sp26 * 0.92) * (nb_h - 6); corner: max(0.5, ((nb_w - 12) / 32 - 2) / 2 * nd_rnd); color: nd_acc; opacity: 0.55 + 0.45 * nd_sp26 }
                box { from: nb_x + 6 + 27 * (nb_w - 12) / 32 + 1, nb_y + nb_h / 2 - (0.08 + nd_sp27 * 0.92) * (nb_h / 2 - 3); size: (nb_w - 12) / 32 - 2, (0.08 + nd_sp27 * 0.92) * (nb_h - 6); corner: max(0.5, ((nb_w - 12) / 32 - 2) / 2 * nd_rnd); color: nd_acc; opacity: 0.55 + 0.45 * nd_sp27 }
                box { from: nb_x + 6 + 28 * (nb_w - 12) / 32 + 1, nb_y + nb_h / 2 - (0.08 + nd_sp28 * 0.92) * (nb_h / 2 - 3); size: (nb_w - 12) / 32 - 2, (0.08 + nd_sp28 * 0.92) * (nb_h - 6); corner: max(0.5, ((nb_w - 12) / 32 - 2) / 2 * nd_rnd); color: nd_acc; opacity: 0.55 + 0.45 * nd_sp28 }
                box { from: nb_x + 6 + 29 * (nb_w - 12) / 32 + 1, nb_y + nb_h / 2 - (0.08 + nd_sp29 * 0.92) * (nb_h / 2 - 3); size: (nb_w - 12) / 32 - 2, (0.08 + nd_sp29 * 0.92) * (nb_h - 6); corner: max(0.5, ((nb_w - 12) / 32 - 2) / 2 * nd_rnd); color: nd_acc; opacity: 0.55 + 0.45 * nd_sp29 }
                box { from: nb_x + 6 + 30 * (nb_w - 12) / 32 + 1, nb_y + nb_h / 2 - (0.08 + nd_sp30 * 0.92) * (nb_h / 2 - 3); size: (nb_w - 12) / 32 - 2, (0.08 + nd_sp30 * 0.92) * (nb_h - 6); corner: max(0.5, ((nb_w - 12) / 32 - 2) / 2 * nd_rnd); color: nd_acc; opacity: 0.55 + 0.45 * nd_sp30 }
                box { from: nb_x + 6 + 31 * (nb_w - 12) / 32 + 1, nb_y + nb_h / 2 - (0.08 + nd_sp31 * 0.92) * (nb_h / 2 - 3); size: (nb_w - 12) / 32 - 2, (0.08 + nd_sp31 * 0.92) * (nb_h - 6); corner: max(0.5, ((nb_w - 12) / 32 - 2) / 2 * nd_rnd); color: nd_acc; opacity: 0.55 + 0.45 * nd_sp31 }
            }
        }
        // the music as a record (D304): the pill carries the song and its controls, and a record rises half out of a
        // slot along its lower edge — turning at 33⅓ while it plays, the cover for its label, grooves and rim in the
        // theme's accent, the spectrum standing out round the half that shows
        group { show: nd_kind == 1 and nd_mf == 2; opacity: nd_cf
            let vr = 82
            let vx = nb_x + nb_w / 2
            let vy = nb_y + nb_h - vr * (1 - nd_cf)
            group {
                clip box { from: vx - vr - 48, nb_y + nb_h; size: vr * 2 + 96, vr + 56 }
                line { from: vx + cos((0 * 180 / 27)) * (vr + 4), vy + sin((0 * 180 / 27)) * (vr + 4); to: vx + cos((0 * 180 / 27)) * (vr + 6 + nd_sp0 * 30), vy + sin((0 * 180 / 27)) * (vr + 6 + nd_sp0 * 30); width: 3; color: nd_acc; opacity: 0.3 + 0.65 * nd_sp0 }
                line { from: vx + cos((1 * 180 / 27)) * (vr + 4), vy + sin((1 * 180 / 27)) * (vr + 4); to: vx + cos((1 * 180 / 27)) * (vr + 6 + nd_sp1 * 30), vy + sin((1 * 180 / 27)) * (vr + 6 + nd_sp1 * 30); width: 3; color: nd_acc; opacity: 0.3 + 0.65 * nd_sp1 }
                line { from: vx + cos((2 * 180 / 27)) * (vr + 4), vy + sin((2 * 180 / 27)) * (vr + 4); to: vx + cos((2 * 180 / 27)) * (vr + 6 + nd_sp2 * 30), vy + sin((2 * 180 / 27)) * (vr + 6 + nd_sp2 * 30); width: 3; color: nd_acc; opacity: 0.3 + 0.65 * nd_sp2 }
                line { from: vx + cos((3 * 180 / 27)) * (vr + 4), vy + sin((3 * 180 / 27)) * (vr + 4); to: vx + cos((3 * 180 / 27)) * (vr + 6 + nd_sp3 * 30), vy + sin((3 * 180 / 27)) * (vr + 6 + nd_sp3 * 30); width: 3; color: nd_acc; opacity: 0.3 + 0.65 * nd_sp3 }
                line { from: vx + cos((4 * 180 / 27)) * (vr + 4), vy + sin((4 * 180 / 27)) * (vr + 4); to: vx + cos((4 * 180 / 27)) * (vr + 6 + nd_sp4 * 30), vy + sin((4 * 180 / 27)) * (vr + 6 + nd_sp4 * 30); width: 3; color: nd_acc; opacity: 0.3 + 0.65 * nd_sp4 }
                line { from: vx + cos((5 * 180 / 27)) * (vr + 4), vy + sin((5 * 180 / 27)) * (vr + 4); to: vx + cos((5 * 180 / 27)) * (vr + 6 + nd_sp5 * 30), vy + sin((5 * 180 / 27)) * (vr + 6 + nd_sp5 * 30); width: 3; color: nd_acc; opacity: 0.3 + 0.65 * nd_sp5 }
                line { from: vx + cos((6 * 180 / 27)) * (vr + 4), vy + sin((6 * 180 / 27)) * (vr + 4); to: vx + cos((6 * 180 / 27)) * (vr + 6 + nd_sp6 * 30), vy + sin((6 * 180 / 27)) * (vr + 6 + nd_sp6 * 30); width: 3; color: nd_acc; opacity: 0.3 + 0.65 * nd_sp6 }
                line { from: vx + cos((7 * 180 / 27)) * (vr + 4), vy + sin((7 * 180 / 27)) * (vr + 4); to: vx + cos((7 * 180 / 27)) * (vr + 6 + nd_sp7 * 30), vy + sin((7 * 180 / 27)) * (vr + 6 + nd_sp7 * 30); width: 3; color: nd_acc; opacity: 0.3 + 0.65 * nd_sp7 }
                line { from: vx + cos((8 * 180 / 27)) * (vr + 4), vy + sin((8 * 180 / 27)) * (vr + 4); to: vx + cos((8 * 180 / 27)) * (vr + 6 + nd_sp8 * 30), vy + sin((8 * 180 / 27)) * (vr + 6 + nd_sp8 * 30); width: 3; color: nd_acc; opacity: 0.3 + 0.65 * nd_sp8 }
                line { from: vx + cos((9 * 180 / 27)) * (vr + 4), vy + sin((9 * 180 / 27)) * (vr + 4); to: vx + cos((9 * 180 / 27)) * (vr + 6 + nd_sp9 * 30), vy + sin((9 * 180 / 27)) * (vr + 6 + nd_sp9 * 30); width: 3; color: nd_acc; opacity: 0.3 + 0.65 * nd_sp9 }
                line { from: vx + cos((10 * 180 / 27)) * (vr + 4), vy + sin((10 * 180 / 27)) * (vr + 4); to: vx + cos((10 * 180 / 27)) * (vr + 6 + nd_sp10 * 30), vy + sin((10 * 180 / 27)) * (vr + 6 + nd_sp10 * 30); width: 3; color: nd_acc; opacity: 0.3 + 0.65 * nd_sp10 }
                line { from: vx + cos((11 * 180 / 27)) * (vr + 4), vy + sin((11 * 180 / 27)) * (vr + 4); to: vx + cos((11 * 180 / 27)) * (vr + 6 + nd_sp11 * 30), vy + sin((11 * 180 / 27)) * (vr + 6 + nd_sp11 * 30); width: 3; color: nd_acc; opacity: 0.3 + 0.65 * nd_sp11 }
                line { from: vx + cos((12 * 180 / 27)) * (vr + 4), vy + sin((12 * 180 / 27)) * (vr + 4); to: vx + cos((12 * 180 / 27)) * (vr + 6 + nd_sp12 * 30), vy + sin((12 * 180 / 27)) * (vr + 6 + nd_sp12 * 30); width: 3; color: nd_acc; opacity: 0.3 + 0.65 * nd_sp12 }
                line { from: vx + cos((13 * 180 / 27)) * (vr + 4), vy + sin((13 * 180 / 27)) * (vr + 4); to: vx + cos((13 * 180 / 27)) * (vr + 6 + nd_sp13 * 30), vy + sin((13 * 180 / 27)) * (vr + 6 + nd_sp13 * 30); width: 3; color: nd_acc; opacity: 0.3 + 0.65 * nd_sp13 }
                line { from: vx + cos((14 * 180 / 27)) * (vr + 4), vy + sin((14 * 180 / 27)) * (vr + 4); to: vx + cos((14 * 180 / 27)) * (vr + 6 + nd_sp14 * 30), vy + sin((14 * 180 / 27)) * (vr + 6 + nd_sp14 * 30); width: 3; color: nd_acc; opacity: 0.3 + 0.65 * nd_sp14 }
                line { from: vx + cos((15 * 180 / 27)) * (vr + 4), vy + sin((15 * 180 / 27)) * (vr + 4); to: vx + cos((15 * 180 / 27)) * (vr + 6 + nd_sp15 * 30), vy + sin((15 * 180 / 27)) * (vr + 6 + nd_sp15 * 30); width: 3; color: nd_acc; opacity: 0.3 + 0.65 * nd_sp15 }
                line { from: vx + cos((16 * 180 / 27)) * (vr + 4), vy + sin((16 * 180 / 27)) * (vr + 4); to: vx + cos((16 * 180 / 27)) * (vr + 6 + nd_sp16 * 30), vy + sin((16 * 180 / 27)) * (vr + 6 + nd_sp16 * 30); width: 3; color: nd_acc; opacity: 0.3 + 0.65 * nd_sp16 }
                line { from: vx + cos((17 * 180 / 27)) * (vr + 4), vy + sin((17 * 180 / 27)) * (vr + 4); to: vx + cos((17 * 180 / 27)) * (vr + 6 + nd_sp17 * 30), vy + sin((17 * 180 / 27)) * (vr + 6 + nd_sp17 * 30); width: 3; color: nd_acc; opacity: 0.3 + 0.65 * nd_sp17 }
                line { from: vx + cos((18 * 180 / 27)) * (vr + 4), vy + sin((18 * 180 / 27)) * (vr + 4); to: vx + cos((18 * 180 / 27)) * (vr + 6 + nd_sp18 * 30), vy + sin((18 * 180 / 27)) * (vr + 6 + nd_sp18 * 30); width: 3; color: nd_acc; opacity: 0.3 + 0.65 * nd_sp18 }
                line { from: vx + cos((19 * 180 / 27)) * (vr + 4), vy + sin((19 * 180 / 27)) * (vr + 4); to: vx + cos((19 * 180 / 27)) * (vr + 6 + nd_sp19 * 30), vy + sin((19 * 180 / 27)) * (vr + 6 + nd_sp19 * 30); width: 3; color: nd_acc; opacity: 0.3 + 0.65 * nd_sp19 }
                line { from: vx + cos((20 * 180 / 27)) * (vr + 4), vy + sin((20 * 180 / 27)) * (vr + 4); to: vx + cos((20 * 180 / 27)) * (vr + 6 + nd_sp20 * 30), vy + sin((20 * 180 / 27)) * (vr + 6 + nd_sp20 * 30); width: 3; color: nd_acc; opacity: 0.3 + 0.65 * nd_sp20 }
                line { from: vx + cos((21 * 180 / 27)) * (vr + 4), vy + sin((21 * 180 / 27)) * (vr + 4); to: vx + cos((21 * 180 / 27)) * (vr + 6 + nd_sp21 * 30), vy + sin((21 * 180 / 27)) * (vr + 6 + nd_sp21 * 30); width: 3; color: nd_acc; opacity: 0.3 + 0.65 * nd_sp21 }
                line { from: vx + cos((22 * 180 / 27)) * (vr + 4), vy + sin((22 * 180 / 27)) * (vr + 4); to: vx + cos((22 * 180 / 27)) * (vr + 6 + nd_sp22 * 30), vy + sin((22 * 180 / 27)) * (vr + 6 + nd_sp22 * 30); width: 3; color: nd_acc; opacity: 0.3 + 0.65 * nd_sp22 }
                line { from: vx + cos((23 * 180 / 27)) * (vr + 4), vy + sin((23 * 180 / 27)) * (vr + 4); to: vx + cos((23 * 180 / 27)) * (vr + 6 + nd_sp23 * 30), vy + sin((23 * 180 / 27)) * (vr + 6 + nd_sp23 * 30); width: 3; color: nd_acc; opacity: 0.3 + 0.65 * nd_sp23 }
                line { from: vx + cos((24 * 180 / 27)) * (vr + 4), vy + sin((24 * 180 / 27)) * (vr + 4); to: vx + cos((24 * 180 / 27)) * (vr + 6 + nd_sp24 * 30), vy + sin((24 * 180 / 27)) * (vr + 6 + nd_sp24 * 30); width: 3; color: nd_acc; opacity: 0.3 + 0.65 * nd_sp24 }
                line { from: vx + cos((25 * 180 / 27)) * (vr + 4), vy + sin((25 * 180 / 27)) * (vr + 4); to: vx + cos((25 * 180 / 27)) * (vr + 6 + nd_sp25 * 30), vy + sin((25 * 180 / 27)) * (vr + 6 + nd_sp25 * 30); width: 3; color: nd_acc; opacity: 0.3 + 0.65 * nd_sp25 }
                line { from: vx + cos((26 * 180 / 27)) * (vr + 4), vy + sin((26 * 180 / 27)) * (vr + 4); to: vx + cos((26 * 180 / 27)) * (vr + 6 + nd_sp26 * 30), vy + sin((26 * 180 / 27)) * (vr + 6 + nd_sp26 * 30); width: 3; color: nd_acc; opacity: 0.3 + 0.65 * nd_sp26 }
                line { from: vx + cos((27 * 180 / 27)) * (vr + 4), vy + sin((27 * 180 / 27)) * (vr + 4); to: vx + cos((27 * 180 / 27)) * (vr + 6 + nd_sp27 * 30), vy + sin((27 * 180 / 27)) * (vr + 6 + nd_sp27 * 30); width: 3; color: nd_acc; opacity: 0.3 + 0.65 * nd_sp27 }
                group { glow: 18, 0.3 + 0.3 * nd_gw, nd_glc
                    ellipse { at: vx, vy; radius: vr; color: mix(#0a0a0c, nd_acc, 0.07) } }
                ellipse { at: vx, vy; radius: vr * 0.950; stroke: 1.1; color: nd_acc; opacity: 0.12 }
                ellipse { at: vx, vy; radius: vr * 0.888; stroke: 0.6; color: nd_acc; opacity: 0.07 }
                ellipse { at: vx, vy; radius: vr * 0.826; stroke: 0.6; color: nd_acc; opacity: 0.07 }
                ellipse { at: vx, vy; radius: vr * 0.764; stroke: 1.1; color: nd_acc; opacity: 0.12 }
                ellipse { at: vx, vy; radius: vr * 0.702; stroke: 0.6; color: nd_acc; opacity: 0.07 }
                ellipse { at: vx, vy; radius: vr * 0.640; stroke: 0.6; color: nd_acc; opacity: 0.07 }
                ellipse { at: vx, vy; radius: vr * 0.578; stroke: 1.1; color: nd_acc; opacity: 0.12 }
                ellipse { at: vx, vy; radius: vr * 0.516; stroke: 0.6; color: nd_acc; opacity: 0.07 }
                ellipse { at: vx, vy; radius: vr * 0.454; stroke: 0.6; color: nd_acc; opacity: 0.07 }
                ellipse { at: vx, vy; radius: vr - 0.5; stroke: 1; color: nd_acc; opacity: 0.45 }
                group { pivot: vx, vy; rotate: nd_vrot
                    // two sheens across the grooves, which is what makes a record read as turning
                    arc { at: vx, vy; radius: vr * 0.68; span: 38deg; rotate: -30deg; width: vr * 0.5; color: #ffffff; opacity: 0.06 }
                    arc { at: vx, vy; radius: vr * 0.68; span: 38deg; rotate: 150deg; width: vr * 0.5; color: #ffffff; opacity: 0.045 }
                    group { clip ellipse { at: vx, vy; radius: vr * 0.36 }
                        ellipse { at: vx, vy; radius: vr * 0.36; color: nd_acc }
                        image nd_cover { at: vx - vr * 0.36, vy - vr * 0.36; size: vr * 0.72, vr * 0.72; fit: cover; show: nd_arted } }
                    ellipse { at: vx, vy; radius: vr * 0.36; stroke: 1.5; color: nd_acc; opacity: 0.8 }
                    ellipse { at: vx + vr * 0.27, vy; radius: 2; color: fl.ground; opacity: 0.7; show: not nd_arted }
                }
                ellipse { at: vx, vy; radius: 3.5; color: fl.ground }
            }
            // the slot it comes out of, lit in the accent
            group { glow: 8, 0.6 * nd_gw, nd_acc
                line { from: vx - vr - 8, nb_y + nb_h; to: vx + vr + 8, nb_y + nb_h; width: 2; color: nd_acc; opacity: 0.7 } }
        }
        // the panel (D260): one rounded body, grown straight down out of the pill
        group { show: nd_kind == 13; opacity: nd_cf
            clip box { from: nb_x, nb_y; size: nb_w, nb_h; corner: nb_r }
            // a press on the body where nothing else is drawn closes it
            zone box pcz { from: nb_x, nb_y; size: nb_w, nb_h; corner: nb_r; cursor: pointer; role: button; label: "Close the panel"; show: nd_kind == 13 }
            on press pcz { emit nd_pclose }
            group { show: nd_pgp == 0
                box { from: nb_x + 14, nb_y + 78; size: nb_w - 28, 58; corner: 14; color: fl.well }
                box { from: nb_x + 14, nb_y + 78; size: nb_w - 28, 58; corner: 14; stroke: 1; color: nd_acc; opacity: if(nd_hedit, 0.9, if(phz.hover, 0.45, 0)) }
                group { clip box { from: nb_x + 27, nb_y + 87; size: 40, 40; corner: 20 }
                    box { from: nb_x + 27, nb_y + 87; size: 40, 40; color: fl.hull_raised }
                    image nd_face_img { at: nb_x + 27, nb_y + 87; size: 40, 40; fit: cover; show: nd_face_on } }
                box { from: nb_x + 27, nb_y + 87; size: 40, 40; corner: 20; stroke: 1; color: nd_acc; opacity: 0.65 }
                text nd_hinit { at: nb_x + 47, nb_y + 107; anchor: center; align: center; size: 15; weight: 700; family: "Exo 2"; color: nd_acc; show: not nd_face_on }
                text nd_hname { at: nb_x + 80, nb_y + 98; anchor: left center; size: 13; weight: 700; family: "Exo 2"; color: fl.engrave; width: nb_w - 150; lines: 1; show: not nd_hedit }
                text nd_hwho { at: nb_x + 80, nb_y + 116; anchor: left center; size: 9; family: "Share Tech Mono"; color: fl.muted; width: nb_w - 150; lines: 1 }
                group { show: nd_hedit
                    input nd_hn { at: nb_x + 78, nb_y + 88; width: nb_w - 175; size: 13; family: "Exo 2"; color: fl.engrave; selection: fl.hull_raised; placeholder: "your name" } }
                text "󰄀" { at: nb_x + 60, nb_y + 120; anchor: center; align: center; size: 10; family: "CaskaydiaCove Nerd Font"; color: nd_acc; show: nd_hedit }
                text "󰄬" { at: nb_x + nb_w - 30, nb_y + 100; anchor: center; align: center; size: 16; family: "CaskaydiaCove Nerd Font"; color: nd_acc; show: nd_hedit }
                text "󰌢" { at: nb_x + nb_w - 30, nb_y + 107; anchor: center; align: center; size: 15; family: "CaskaydiaCove Nerd Font"; color: fl.muted; opacity: 0.7; show: not nd_hedit }
                zone box phz { from: nb_x + 14, nb_y + 78; size: nb_w - 28, 58; corner: 14; cursor: pointer; role: button; label: "Edit your profile"; show: nd_kind == 13 and nd_pgp == 0 and not nd_hedit }
                on press phz { emit nd_hopen }
                zone box phc { from: nb_x + 14, nb_y + 78; size: nb_w - 28, 58; corner: 14; cursor: pointer; role: button; label: "Edit your profile"; show: nd_kind == 13 and nd_pgp == 0 and nd_hedit }
                on press phc { focus nd_hn }
                zone box pha { from: nb_x + 27, nb_y + 87; size: 40, 40; corner: 20; cursor: pointer; role: button; label: "Choose your profile picture"; show: nd_kind == 13 and nd_pgp == 0 and nd_hedit }
                on press pha { emit nd_hpic }
                zone box phd { from: nb_x + nb_w - 44, nb_y + 86; size: 28, 28; corner: 14; cursor: pointer; role: button; label: "Save your profile"; show: nd_kind == 13 and nd_pgp == 0 and nd_hedit }
                on press phd { emit nd_hdone }
            }
            on submit nd_hn { emit nd_hsave }
            on change nd_kb while nd_kb and nd_kind == 13 and nd_pgp == 0 and nd_hedit { focus nd_hn }
            group { show: nd_pgp == 0
                text nd_hclock { at: nb_x + 24, nb_y + 34; anchor: left center; size: 30; weight: 700; family: "Exo 2"; color: fl.engrave }
                text nd_hdate { at: nb_x + 26, nb_y + 60; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.muted; width: 220; lines: 1 }
                text nd_hwg { at: nb_x + nb_w - 24, nb_y + 28; anchor: right center; align: right; size: 18; family: "CaskaydiaCove Nerd Font"; color: nd_acc }
                text nd_hwt { at: nb_x + nb_w - 50, nb_y + 28; anchor: right center; align: right; size: 11; family: "Exo 2"; color: fl.engrave; width: 200; lines: 1 }
                text nd_hbat { at: nb_x + nb_w - 24, nb_y + 58; anchor: right center; align: right; size: 11; family: "CaskaydiaCove Nerd Font"; color: fl.muted; width: 120; lines: 1 }
                zone box pwwz { from: nb_x + nb_w - 214, nb_y + 12; size: 200, 32; corner: 16; cursor: pointer; role: button; label: "This week's weather"; show: nd_kind == 13 and nd_pgp == 0 }
                on press pwwz { emit nd_hweather }
                group { show: nd_hstrip
                box { from: nb_x + 14 + 0 * ((nb_w - 52) / 4 + 8), nb_y + 150; size: (nb_w - 52) / 4, 34; corner: 10; color: fl.well }
                text nd_hs1 { at: nb_x + 14 + 0 * ((nb_w - 52) / 4 + 8) + 10, nb_y + 164; anchor: left center; size: 9; weight: 700; family: "Share Tech Mono"; color: if(nd_hh1, fl.ember, fl.engrave); width: (nb_w - 52) / 4 - 16; lines: 1 }
                box { from: nb_x + 14 + 0 * ((nb_w - 52) / 4 + 8) + 10, nb_y + 175; size: (nb_w - 52) / 4 - 20, 2; corner: 1; color: fl.trace_dim }
                box { from: nb_x + 14 + 0 * ((nb_w - 52) / 4 + 8) + 10, nb_y + 175; size: ((nb_w - 52) / 4 - 20) * nd_hf1, 2; corner: 1; color: if(nd_hh1, fl.ember, nd_acc) } }
                group { show: nd_hstrip
                box { from: nb_x + 14 + 1 * ((nb_w - 52) / 4 + 8), nb_y + 150; size: (nb_w - 52) / 4, 34; corner: 10; color: fl.well }
                text nd_hs2 { at: nb_x + 14 + 1 * ((nb_w - 52) / 4 + 8) + 10, nb_y + 164; anchor: left center; size: 9; weight: 700; family: "Share Tech Mono"; color: if(nd_hh2, fl.ember, fl.engrave); width: (nb_w - 52) / 4 - 16; lines: 1 }
                box { from: nb_x + 14 + 1 * ((nb_w - 52) / 4 + 8) + 10, nb_y + 175; size: (nb_w - 52) / 4 - 20, 2; corner: 1; color: fl.trace_dim }
                box { from: nb_x + 14 + 1 * ((nb_w - 52) / 4 + 8) + 10, nb_y + 175; size: ((nb_w - 52) / 4 - 20) * nd_hf2, 2; corner: 1; color: if(nd_hh2, fl.ember, nd_acc) } }
                group { show: nd_hstrip
                box { from: nb_x + 14 + 2 * ((nb_w - 52) / 4 + 8), nb_y + 150; size: (nb_w - 52) / 4, 34; corner: 10; color: fl.well }
                text nd_hs3 { at: nb_x + 14 + 2 * ((nb_w - 52) / 4 + 8) + 10, nb_y + 164; anchor: left center; size: 9; weight: 700; family: "Share Tech Mono"; color: if(nd_hh3, fl.ember, fl.engrave); width: (nb_w - 52) / 4 - 16; lines: 1 }
                box { from: nb_x + 14 + 2 * ((nb_w - 52) / 4 + 8) + 10, nb_y + 175; size: (nb_w - 52) / 4 - 20, 2; corner: 1; color: fl.trace_dim }
                box { from: nb_x + 14 + 2 * ((nb_w - 52) / 4 + 8) + 10, nb_y + 175; size: ((nb_w - 52) / 4 - 20) * nd_hf3, 2; corner: 1; color: if(nd_hh3, fl.ember, nd_acc) } }
                group { show: nd_hstrip
                box { from: nb_x + 14 + 3 * ((nb_w - 52) / 4 + 8), nb_y + 150; size: (nb_w - 52) / 4, 34; corner: 10; color: fl.well }
                text nd_hs4 { at: nb_x + 14 + 3 * ((nb_w - 52) / 4 + 8) + 10, nb_y + 164; anchor: left center; size: 9; weight: 700; family: "Share Tech Mono"; color: if(nd_hh4, fl.ember, fl.engrave); width: (nb_w - 52) / 4 - 16; lines: 1 }
                box { from: nb_x + 14 + 3 * ((nb_w - 52) / 4 + 8) + 10, nb_y + 175; size: (nb_w - 52) / 4 - 20, 2; corner: 1; color: fl.trace_dim }
                box { from: nb_x + 14 + 3 * ((nb_w - 52) / 4 + 8) + 10, nb_y + 175; size: ((nb_w - 52) / 4 - 20) * nd_hf4, 2; corner: 1; color: if(nd_hh4, fl.ember, nd_acc) } }
            }
            group { show: nd_pgp == 0
                // the media card: a 64 px cover, the song, its transport, and the seek bar along its foot
                box { from: nb_x + 14, nb_y + 196; size: nb_w - 28, 112; corner: 14; color: fl.well }
                group { clip box { from: nb_x + 26, nb_y + 196 + 12; size: 64, 64; corner: 10 }
                    box { from: nb_x + 26, nb_y + 196 + 12; size: 64, 64; color: fl.hull_raised }
                    image nd_cover { at: nb_x + 26, nb_y + 196 + 12; size: 64, 64; fit: cover; show: nd_arted } }
                zone box pcover { from: nb_x + 26, nb_y + 196 + 12; size: 64, 64; corner: 10; cursor: pointer; role: button; label: "Open the player"; show: nd_kind == 13 and nd_pgp == 0 }
                on press pcover { emit nd_popen }
                text nd_title { at: nb_x + 102, nb_y + 196 + 26; anchor: left center; size: 14; weight: 700; family: "Exo 2"; color: fl.engrave; width: nb_w - 320; lines: 1; show: nd_playing or nd_paused }
                text nd_artist { at: nb_x + 102, nb_y + 196 + 46; anchor: left center; size: 11; family: "Exo 2"; color: fl.muted; width: nb_w - 320; lines: 1; show: nd_playing or nd_paused }
                text "Nothing playing" { at: nb_x + 102, nb_y + 196 + 38; anchor: left center; size: 12; family: "Exo 2"; color: fl.muted; show: not (nd_playing or nd_paused) }
                text "󰒮" { at: nb_x + nb_w - 146, nb_y + 196 + 58; anchor: center; align: center; size: 16; family: "CaskaydiaCove Nerd Font"; color: if(pm1.hover, nd_acc, fl.engrave); show: nd_playing or nd_paused }
                zone box pm1 { from: nb_x + nb_w - 146 - 16, nb_y + 196 + 42; size: 32, 32; corner: 16; cursor: pointer; role: button; label: "Back"; show: nd_kind == 13 and nd_pgp == 0 and (nd_playing or nd_paused) }
                on press pm1 { emit nd_media(1) }
                text "󰒭" { at: nb_x + nb_w - 50, nb_y + 196 + 58; anchor: center; align: center; size: 16; family: "CaskaydiaCove Nerd Font"; color: if(pm3.hover, nd_acc, fl.engrave); show: nd_playing or nd_paused }
                zone box pm3 { from: nb_x + nb_w - 50 - 16, nb_y + 196 + 42; size: 32, 32; corner: 16; cursor: pointer; role: button; label: "Next"; show: nd_kind == 13 and nd_pgp == 0 and (nd_playing or nd_paused) }
                on press pm3 { emit nd_media(3) }
                // play, in a filled accent circle
                ellipse { at: nb_x + nb_w - 98, nb_y + 196 + 58; radius: 18; color: nd_acc; opacity: 0.92; show: nd_playing or nd_paused }
                text "󰐊" { at: nb_x + nb_w - 98, nb_y + 196 + 58; anchor: center; align: center; size: 17; family: "CaskaydiaCove Nerd Font"; color: fl.ground; show: nd_paused }
                text "󰏤" { at: nb_x + nb_w - 98, nb_y + 196 + 58; anchor: center; align: center; size: 17; family: "CaskaydiaCove Nerd Font"; color: fl.ground; show: nd_playing }
                zone box pm2 { from: nb_x + nb_w - 116, nb_y + 196 + 40; size: 36, 36; corner: 18; cursor: pointer; role: button; label: "Play or pause"; show: nd_kind == 13 and nd_pgp == 0 and (nd_playing or nd_paused) }
                on press pm2 { emit nd_media(2) }
                // where in it, along the card’s foot, and the two times under it
                box { from: nb_x + 26, nb_y + 196 + 91; size: nb_w - 52, 3; corner: 1.5; color: fl.trace_dim }
                box { from: nb_x + 26, nb_y + 196 + 91; size: (nb_w - 52) * nd_prog, 3; corner: 1.5; color: nd_acc }
                ellipse { at: nb_x + 26 + (nb_w - 52) * nd_prog, nb_y + 196 + 92.5; radius: if(pseek.hover, 6, 4); color: nd_acc }
                text nd_hompos { at: nb_x + 26, nb_y + 196 + 105; anchor: left center; size: 9; family: "Share Tech Mono"; color: fl.muted }
                text nd_homlen { at: nb_x + nb_w - 26, nb_y + 196 + 105; anchor: right center; align: right; size: 9; family: "Share Tech Mono"; color: fl.muted }
                zone box pseek { from: nb_x + 20, nb_y + 196 + 82; size: nb_w - 40, 22; cursor: pointer; role: slider; label: "Where in the song"; value: "{nd_hompos}"; show: nd_kind == 13 and nd_pgp == 0 }
                on press pseek { emit nd_seek(round(clamp((pointer.x - nb_x - 26) / (nb_w - 52), 0, 1) * 1000)) }
                on drag pseek { emit nd_seek(round(clamp((pointer.x - nb_x - 26) / (nb_w - 52), 0, 1) * 1000)) }
            }
            group { show: nd_pgp == 0
                box { from: nb_x + 14 + 0 * ((nb_w - 60) / 5 + 8), nb_y + 320; size: (nb_w - 60) / 5, 40; corner: 12; color: nd_acc; opacity: if(nd_wifi, 0.2, if(pt1.hover, 0.12, 0.05)) }
                box { from: nb_x + 14 + 0 * ((nb_w - 60) / 5 + 8), nb_y + 320; size: (nb_w - 60) / 5, 40; corner: 12; stroke: 1; color: if(nd_wifi, nd_acc, fl.trace_dim); opacity: if(nd_wifi, 0.9, 0.7) }
                text if(nd_wifi, "󰖩", "󰖪") { at: nb_x + 14 + 0 * ((nb_w - 60) / 5 + 8) + (nb_w - 60) / 5 / 2, nb_y + 335; anchor: center; align: center; size: 16; family: "CaskaydiaCove Nerd Font"; color: if(nd_wifi, nd_acc, fl.engrave) }
                text nd_wifin { at: nb_x + 14 + 0 * ((nb_w - 60) / 5 + 8) + (nb_w - 60) / 5 / 2, nb_y + 352; anchor: center; align: center; size: 9; weight: 700; family: "Share Tech Mono"; color: if(nd_wifi, nd_acc, fl.muted); width: (nb_w - 60) / 5 - 8; lines: 1 }
                zone box pt1 { from: nb_x + 14 + 0 * ((nb_w - 60) / 5 + 8), nb_y + 320; size: (nb_w - 60) / 5, 40; corner: 12; cursor: pointer; role: toggle; label: "Wi-Fi"; checked: nd_wifi; show: nd_kind == 13 and nd_pgp == 0 }
                on press pt1 { emit nd_ptog(1) }
                zone box pt1n { from: nb_x + 14 + 0 * ((nb_w - 60) / 5 + 8) + 6, nb_y + 340; size: (nb_w - 60) / 5 - 12, 18; corner: 8; cursor: pointer; role: button; label: "Wi-Fi settings"; show: nd_kind == 13 and nd_pgp == 0 }
                on press pt1n { emit nd_pg(7) }
                box { from: nb_x + 14 + 1 * ((nb_w - 60) / 5 + 8), nb_y + 320; size: (nb_w - 60) / 5, 40; corner: 12; color: nd_acc; opacity: if(nd_dnd_on, 0.2, if(pt2.hover, 0.12, 0.05)) }
                box { from: nb_x + 14 + 1 * ((nb_w - 60) / 5 + 8), nb_y + 320; size: (nb_w - 60) / 5, 40; corner: 12; stroke: 1; color: if(nd_dnd_on, nd_acc, fl.trace_dim); opacity: if(nd_dnd_on, 0.9, 0.7) }
                text if(nd_dnd_on, "󰂛", "󰂚") { at: nb_x + 14 + 1 * ((nb_w - 60) / 5 + 8) + (nb_w - 60) / 5 / 2, nb_y + 335; anchor: center; align: center; size: 16; family: "CaskaydiaCove Nerd Font"; color: if(nd_dnd_on, nd_acc, fl.engrave) }
                text "Silent" { at: nb_x + 14 + 1 * ((nb_w - 60) / 5 + 8) + (nb_w - 60) / 5 / 2, nb_y + 352; anchor: center; align: center; size: 9; weight: 700; family: "Share Tech Mono"; color: if(nd_dnd_on, nd_acc, fl.muted); width: (nb_w - 60) / 5 - 8; lines: 1 }
                zone box pt2 { from: nb_x + 14 + 1 * ((nb_w - 60) / 5 + 8), nb_y + 320; size: (nb_w - 60) / 5, 40; corner: 12; cursor: pointer; role: toggle; label: "Silent"; checked: nd_dnd_on; show: nd_kind == 13 and nd_pgp == 0 }
                on press pt2 { emit nd_ptog(2) }
                box { from: nb_x + 14 + 2 * ((nb_w - 60) / 5 + 8), nb_y + 320; size: (nb_w - 60) / 5, 40; corner: 12; color: nd_acc; opacity: if(nd_tmr_on, 0.2, if(pt3.hover, 0.12, 0.05)) }
                box { from: nb_x + 14 + 2 * ((nb_w - 60) / 5 + 8), nb_y + 320; size: (nb_w - 60) / 5, 40; corner: 12; stroke: 1; color: if(nd_tmr_on, nd_acc, fl.trace_dim); opacity: if(nd_tmr_on, 0.9, 0.7) }
                text "󰔛" { at: nb_x + 14 + 2 * ((nb_w - 60) / 5 + 8) + (nb_w - 60) / 5 / 2, nb_y + 335; anchor: center; align: center; size: 16; family: "CaskaydiaCove Nerd Font"; color: if(nd_tmr_on, nd_acc, fl.engrave) }
                text if(nd_tmr_on, nd_capt, "Timer") { at: nb_x + 14 + 2 * ((nb_w - 60) / 5 + 8) + (nb_w - 60) / 5 / 2, nb_y + 352; anchor: center; align: center; size: 9; weight: 700; family: "Share Tech Mono"; color: if(nd_tmr_on, nd_acc, fl.muted); width: (nb_w - 60) / 5 - 8; lines: 1 }
                zone box pt3 { from: nb_x + 14 + 2 * ((nb_w - 60) / 5 + 8), nb_y + 320; size: (nb_w - 60) / 5, 40; corner: 12; cursor: pointer; role: toggle; label: "Timer"; checked: nd_tmr_on; show: nd_kind == 13 and nd_pgp == 0 }
                on press pt3 { emit nd_ptog(3) }
                box { from: nb_x + 14 + 3 * ((nb_w - 60) / 5 + 8), nb_y + 320; size: (nb_w - 60) / 5, 40; corner: 12; color: nd_acc; opacity: if(nd_bt, 0.2, if(pt4.hover, 0.12, 0.05)) }
                box { from: nb_x + 14 + 3 * ((nb_w - 60) / 5 + 8), nb_y + 320; size: (nb_w - 60) / 5, 40; corner: 12; stroke: 1; color: if(nd_bt, nd_acc, fl.trace_dim); opacity: if(nd_bt, 0.9, 0.7) }
                text if(nd_bt, "󰂯", "󰂲") { at: nb_x + 14 + 3 * ((nb_w - 60) / 5 + 8) + (nb_w - 60) / 5 / 2, nb_y + 335; anchor: center; align: center; size: 16; family: "CaskaydiaCove Nerd Font"; color: if(nd_bt, nd_acc, fl.engrave) }
                text if(nd_bt, "On", "Off") { at: nb_x + 14 + 3 * ((nb_w - 60) / 5 + 8) + (nb_w - 60) / 5 / 2, nb_y + 352; anchor: center; align: center; size: 9; weight: 700; family: "Share Tech Mono"; color: if(nd_bt, nd_acc, fl.muted); width: (nb_w - 60) / 5 - 8; lines: 1 }
                zone box pt4 { from: nb_x + 14 + 3 * ((nb_w - 60) / 5 + 8), nb_y + 320; size: (nb_w - 60) / 5, 40; corner: 12; cursor: pointer; role: toggle; label: "Bluetooth"; checked: nd_bt; show: nd_kind == 13 and nd_pgp == 0 }
                on press pt4 { emit nd_ptog(4) }
                zone box pt4n { from: nb_x + 14 + 3 * ((nb_w - 60) / 5 + 8) + 6, nb_y + 340; size: (nb_w - 60) / 5 - 12, 18; corner: 8; cursor: pointer; role: button; label: "Bluetooth settings"; show: nd_kind == 13 and nd_pgp == 0 }
                on press pt4n { emit nd_pg(8) }
                box { from: nb_x + 14 + 4 * ((nb_w - 60) / 5 + 8), nb_y + 320; size: (nb_w - 60) / 5, 40; corner: 12; color: nd_acc; opacity: if(nd_game, 0.2, if(pt5.hover, 0.12, 0.05)) }
                box { from: nb_x + 14 + 4 * ((nb_w - 60) / 5 + 8), nb_y + 320; size: (nb_w - 60) / 5, 40; corner: 12; stroke: 1; color: if(nd_game, nd_acc, fl.trace_dim); opacity: if(nd_game, 0.9, 0.7) }
                text "󰊴" { at: nb_x + 14 + 4 * ((nb_w - 60) / 5 + 8) + (nb_w - 60) / 5 / 2, nb_y + 335; anchor: center; align: center; size: 16; family: "CaskaydiaCove Nerd Font"; color: if(nd_game, nd_acc, fl.engrave) }
                text if(nd_game, "Game on", "Game") { at: nb_x + 14 + 4 * ((nb_w - 60) / 5 + 8) + (nb_w - 60) / 5 / 2, nb_y + 352; anchor: center; align: center; size: 9; weight: 700; family: "Share Tech Mono"; color: if(nd_game, nd_acc, fl.muted); width: (nb_w - 60) / 5 - 8; lines: 1 }
                zone box pt5 { from: nb_x + 14 + 4 * ((nb_w - 60) / 5 + 8), nb_y + 320; size: (nb_w - 60) / 5, 40; corner: 12; cursor: pointer; role: toggle; label: "Game mode"; checked: nd_game; show: nd_kind == 13 and nd_pgp == 0 }
                on press pt5 { emit nd_ptog(5) }
            }
            group { show: nd_pgp == 0
                text "󰓃 {nd_hout}" { at: nb_x + 104, nb_y + 372 + 4; anchor: left center; size: 9; family: "CaskaydiaCove Nerd Font"; color: if(pouz.hover, nd_acc, fl.muted); width: 220; lines: 1 }
                zone box pouz { from: nb_x + 96, nb_y + 372 - 6; size: 230, 18; cursor: pointer; role: button; label: "Where the sound plays: {nd_hout} (press for the next)"; show: nd_kind == 13 and nd_pgp == 0 }
                on press pouz { emit nd_out }
            }
            group { show: nd_pgp == 0
                text "󰕾" { at: nb_x + 26, nb_y + 372 + 20; anchor: center; align: center; size: 16; family: "CaskaydiaCove Nerd Font"; color: fl.engrave }
                text "Volume" { at: nb_x + 42, nb_y + 372 + 20; anchor: left center; size: 9; weight: 700; family: "Share Tech Mono"; color: fl.muted }
                box { from: nb_x + 104, nb_y + 372 + 19; size: nb_w - 170, 3; corner: 1.5; color: fl.trace_dim }
                box { from: nb_x + 104, nb_y + 372 + 19; size: (nb_w - 170) * nd_vol, 3; corner: 1.5; color: nd_acc }
                ellipse { at: nb_x + 104 + (nb_w - 170) * nd_vol, nb_y + 372 + 20.5; radius: if(pvz.hover, 6, 4); color: nd_acc }
                text "{round(nd_vol * 100)}%" { at: nb_x + nb_w - 26, nb_y + 372 + 20; anchor: right center; align: right; size: 10; weight: 700; family: "Share Tech Mono"; color: fl.engrave }
                zone box pvz { from: nb_x + 90, nb_y + 372 + 4; size: nb_w - 122, 32; cursor: ew_resize; role: slider; label: "Volume"; value: round(nd_vol * 100); show: nd_kind == 13 and nd_pgp == 0 }
                on press pvz { emit nd_mt(0 * 2000 + round(clamp((pointer.x - nb_x - 104) / (nb_w - 170), 0, 1) * 1000)) }
                on drag pvz { emit nd_mt(0 * 2000 + round(clamp((pointer.x - nb_x - 104) / (nb_w - 170), 0, 1) * 1000)) }
            }
            group { show: nd_pgp == 0 and nd_hasbri
                text "󰃟" { at: nb_x + 26, nb_y + 416 + 20; anchor: center; align: center; size: 16; family: "CaskaydiaCove Nerd Font"; color: fl.engrave }
                text "Brightness" { at: nb_x + 42, nb_y + 416 + 20; anchor: left center; size: 9; weight: 700; family: "Share Tech Mono"; color: fl.muted }
                box { from: nb_x + 104, nb_y + 416 + 19; size: nb_w - 170, 3; corner: 1.5; color: fl.trace_dim }
                box { from: nb_x + 104, nb_y + 416 + 19; size: (nb_w - 170) * nd_bri, 3; corner: 1.5; color: nd_acc }
                ellipse { at: nb_x + 104 + (nb_w - 170) * nd_bri, nb_y + 416 + 20.5; radius: if(plz.hover, 6, 4); color: nd_acc }
                text "{round(nd_bri * 100)}%" { at: nb_x + nb_w - 26, nb_y + 416 + 20; anchor: right center; align: right; size: 10; weight: 700; family: "Share Tech Mono"; color: fl.engrave }
                zone box plz { from: nb_x + 90, nb_y + 416 + 4; size: nb_w - 122, 32; cursor: ew_resize; role: slider; label: "Brightness"; value: round(nd_bri * 100); show: nd_kind == 13 and nd_pgp == 0 and nd_hasbri }
                on press plz { emit nd_mt(1 * 2000 + round(clamp((pointer.x - nb_x - 104) / (nb_w - 170), 0, 1) * 1000)) }
                on drag plz { emit nd_mt(1 * 2000 + round(clamp((pointer.x - nb_x - 104) / (nb_w - 170), 0, 1) * 1000)) }
            }
            group { show: nd_pgp == 0
                text "Notifications ({nd_ncn, 0})" { at: nb_x + 26, nb_y + 478; anchor: left center; size: 11; weight: 700; family: "Exo 2"; color: fl.engrave }
                box { from: nb_x + nb_w - 98, nb_y + 468; size: 72, 22; corner: 11; stroke: 1; color: if(pclz.hover, nd_acc, fl.trace_dim); show: nd_ncn > 0 }
                text "Clear all" { at: nb_x + nb_w - 62, nb_y + 479; anchor: center; align: center; size: 9; weight: 700; family: "Share Tech Mono"; color: if(pclz.hover, nd_acc, fl.muted); width: 66; lines: 1; show: nd_ncn > 0 }
                zone box pclz { from: nb_x + nb_w - 98, nb_y + 468; size: 72, 22; corner: 11; cursor: pointer; role: button; label: "Clear all notifications"; show: nd_kind == 13 and nd_pgp == 0 and nd_ncn > 0 }
                on press pclz { emit nd_pclear }
                text "No notifications" { at: nb_x + 26, nb_y + 502; anchor: left center; size: 11; family: "Exo 2"; color: fl.muted; show: pn.count == 0 }
                for n in pn {
                    let ny = nb_y + 493 + n.index * 58
                    box { from: nb_x + 14, ny; size: nb_w - 28, 52; corner: 12; color: fl.well; opacity: if(pnz.hover, 0.95, 0.7) }
                    text n.icon { at: nb_x + 34, ny + 26; anchor: center; align: center; size: 15; family: "CaskaydiaCove Nerd Font"; color: nd_acc }
                    text n.app { at: nb_x + 50, ny + 17; anchor: left center; size: 12; weight: 700; family: "Exo 2"; color: fl.engrave; width: nb_w - 190; lines: 1 }
                    text n.title { at: nb_x + 50, ny + 36; anchor: left center; size: 11; family: "Exo 2"; color: fl.muted; width: nb_w - 190; lines: 1 }
                    text n.age { at: nb_x + nb_w - 54, ny + 17; anchor: right center; align: right; size: 9; family: "Share Tech Mono"; color: fl.muted; width: 60; lines: 1 }
                    text "×" { at: nb_x + nb_w - 32, ny + 36; anchor: center; size: 14; family: "Exo 2"; color: if(pnx.hover, fl.engrave, fl.muted) }
                    zone box pnz { from: nb_x + 14, ny; size: nb_w - 70, 52; corner: 12; cursor: pointer; role: button; label: "{n.app}: {n.title}"; show: nd_kind == 13 and nd_pgp == 0 }
                    on press pnz { emit nd_nc(n.index * 10) }
                    zone box pnx { from: nb_x + nb_w - 54, ny + 24; size: 36, 26; cursor: pointer; role: button; label: "Dismiss"; show: nd_kind == 13 and nd_pgp == 0 }
                    on press pnx { emit nd_nc(n.index * 10 + 9) }
                }
            }
            group { show: nd_pgp == 11
                box { from: nb_x + 14, nb_y + 56; size: nb_w - 28, 104; corner: 14; color: fl.well }
                text "NOW" { at: nb_x + 30, nb_y + 74; anchor: left center; size: 8; weight: 700; family: "Share Tech Mono"; color: fl.muted }
                text nd_wcity { at: nb_x + nb_w - 26, nb_y + 74; anchor: right center; align: right; size: 8; weight: 700; family: "Share Tech Mono"; color: fl.muted; width: 240; lines: 1 }
                text nd_wglyph { at: nb_x + 42, nb_y + 106; anchor: center; align: center; size: 30; family: "CaskaydiaCove Nerd Font"; color: nd_acc }
                text nd_wtemp { at: nb_x + 76, nb_y + 96; anchor: left center; size: 30; weight: 700; family: "Exo 2"; color: fl.engrave }
                text nd_wword { at: nb_x + 76, nb_y + 120; anchor: left center; size: 9; weight: 700; family: "Share Tech Mono"; color: fl.muted; width: 300; lines: 1 }
                text nd_wfeels { at: nb_x + 76, nb_y + 146; anchor: left center; size: 9; family: "Share Tech Mono"; color: fl.muted; width: 110; lines: 1 }
                text nd_whum { at: nb_x + 190, nb_y + 146; anchor: left center; size: 9; family: "Share Tech Mono"; color: fl.muted; width: 110; lines: 1 }
                text nd_wwind { at: nb_x + 310, nb_y + 146; anchor: left center; size: 9; family: "Share Tech Mono"; color: fl.muted; width: 160; lines: 1 }
                text nd_wsum { at: nb_x + 26, nb_y + 176; anchor: left center; size: 9; weight: 700; family: "Share Tech Mono"; color: fl.muted; width: nb_w - 52; lines: 1 }
                for w in wkw {
                    let wy = nb_y + 194 + w.index * 42
                    box { from: nb_x + 14, wy; size: nb_w - 28, 38; corner: 10; color: fl.well; opacity: if(w.wet, 0.75, 0.55) }
                    text w.label { at: nb_x + 28, wy + 19; anchor: left center; size: 9; weight: 700; family: "Share Tech Mono"; color: fl.engrave; width: 44; lines: 1 }
                    text w.glyph { at: nb_x + 78, wy + 19; anchor: center; align: center; size: 14; family: "CaskaydiaCove Nerd Font"; color: nd_acc }
                    line { from: nb_x + 104, wy + 19; to: nb_x + 326, wy + 19; width: 2; color: fl.trace_dim }
                    box { from: nb_x + 104 + w.lo_v * 222, wy + 17; size: max(4, (w.hi_v - w.lo_v) * 222), 4; corner: 2; color: nd_acc }
                    text w.hi { at: nb_x + 384, wy + 19; anchor: right center; align: right; size: 9; weight: 700; family: "Share Tech Mono"; color: fl.engrave; width: 60; lines: 1 }
                    text w.lo { at: nb_x + 432, wy + 19; anchor: right center; align: right; size: 9; family: "Share Tech Mono"; color: fl.muted; width: 60; lines: 1 }
                    ellipse { at: nb_x + 458, wy + 19; radius: 2.5; color: nd_acc; opacity: 0.85; show: w.wet }
                }
                text "󰖐" { at: nb_x + nb_w / 2, nb_y + 250; anchor: center; align: center; size: 30; family: "CaskaydiaCove Nerd Font"; color: fl.muted; show: wkw.count == 0 }
                text "No forecast yet" { at: nb_x + nb_w / 2, nb_y + 282; anchor: center; align: center; size: 12; weight: 700; family: "Exo 2"; color: fl.engrave; show: wkw.count == 0 }
                text "The Nexus's weather will appear here" { at: nb_x + nb_w / 2, nb_y + 304; anchor: center; align: center; size: 10; family: "Exo 2"; color: fl.muted; width: nb_w - 80; lines: 1; show: wkw.count == 0 }
            }
            group { show: nd_pgp > 0
                text "‹" { at: nb_x + 26, nb_y + 27; anchor: center; size: 20; family: "Exo 2"; color: if(pbkz.hover, nd_acc, fl.engrave) }
                text nd_pgt { at: nb_x + 44, nb_y + 27; anchor: left center; size: 12; weight: 700; family: "Exo 2"; color: fl.engrave; width: 240; lines: 1 }
                text nd_pgs { at: nb_x + nb_w - 24, nb_y + 27; anchor: right center; align: right; size: 9; family: "Share Tech Mono"; color: fl.muted; width: 220; lines: 1 }
                line { from: nb_x + 16, nb_y + 44; to: nb_x + nb_w - 16, nb_y + 44; width: 1; color: fl.trace_dim }
                zone box pbkz { from: nb_x + 12, nb_y + 10; size: 32, 32; cursor: pointer; role: button; label: "Back home"; show: nd_kind == 13 and nd_pgp > 0 }
                on press pbkz { emit nd_pg(0) }
                group { show: nd_pgp == 1
                    text "M" { at: nb_x + 20 + 0 * ((nb_w - 40) / 7) + (nb_w - 40) / 14, nb_y + 68; anchor: center; align: center; size: 9; weight: 700; family: "Share Tech Mono"; color: fl.muted }
                    text "T" { at: nb_x + 20 + 1 * ((nb_w - 40) / 7) + (nb_w - 40) / 14, nb_y + 68; anchor: center; align: center; size: 9; weight: 700; family: "Share Tech Mono"; color: fl.muted }
                    text "W" { at: nb_x + 20 + 2 * ((nb_w - 40) / 7) + (nb_w - 40) / 14, nb_y + 68; anchor: center; align: center; size: 9; weight: 700; family: "Share Tech Mono"; color: fl.muted }
                    text "T" { at: nb_x + 20 + 3 * ((nb_w - 40) / 7) + (nb_w - 40) / 14, nb_y + 68; anchor: center; align: center; size: 9; weight: 700; family: "Share Tech Mono"; color: fl.muted }
                    text "F" { at: nb_x + 20 + 4 * ((nb_w - 40) / 7) + (nb_w - 40) / 14, nb_y + 68; anchor: center; align: center; size: 9; weight: 700; family: "Share Tech Mono"; color: fl.muted }
                    text "S" { at: nb_x + 20 + 5 * ((nb_w - 40) / 7) + (nb_w - 40) / 14, nb_y + 68; anchor: center; align: center; size: 9; weight: 700; family: "Share Tech Mono"; color: fl.muted }
                    text "S" { at: nb_x + 20 + 6 * ((nb_w - 40) / 7) + (nb_w - 40) / 14, nb_y + 68; anchor: center; align: center; size: 9; weight: 700; family: "Share Tech Mono"; color: fl.muted }
                    for d in cal {
                        let col = d.index - floor(d.index / 7) * 7
                        let rw = floor(d.index / 7)
                        let cx = nb_x + 20 + col * ((nb_w - 40) / 7) + (nb_w - 40) / 14
                        ellipse { at: cx, nb_y + 94 + rw * 28; radius: 12; color: nd_acc; show: d.today }
                        text d.d { at: cx, nb_y + 94 + rw * 28; anchor: center; align: center; size: 11; weight: if(d.today, 700, 500); family: "Share Tech Mono"; color: if(d.today, fl.ground, if(d.muted, fl.trace_lit, if(d.weekend, nd_acc, fl.engrave))) }
                    }
                }
                text "‹" { at: nb_x + nb_w - 70, nb_y + 27; anchor: center; size: 16; family: "Exo 2"; color: if(prz1.hover, nd_acc, fl.engrave); show: nd_pgp == 1 }
                zone box prz1 { from: nb_x + nb_w - 82, nb_y + 12; size: 24, 30; cursor: pointer; role: button; label: "Back"; show: nd_kind == 13 and nd_pgp == 1 }
                on press prz1 { emit nd_br(1) }
                text "›" { at: nb_x + nb_w - 40, nb_y + 27; anchor: center; size: 16; family: "Exo 2"; color: if(prz2.hover, nd_acc, fl.engrave); show: nd_pgp == 1 }
                zone box prz2 { from: nb_x + nb_w - 52, nb_y + 12; size: 24, 30; cursor: pointer; role: button; label: "On"; show: nd_kind == 13 and nd_pgp == 1 }
                on press prz2 { emit nd_br(2) }
                group { show: nd_pgp == 2
                    box { from: nb_x + 16, nb_y + 58; size: nb_w - 32, 32; corner: 16 * max(0.3, nd_rnd); color: fl.well }
                    text "+" { at: nb_x + 32, nb_y + 74; anchor: center; size: 14; family: "Exo 2"; color: nd_acc }
                    input nd_nq { at: nb_x + 48, nb_y + 64; width: nb_w - 84; size: 12; family: "Exo 2"; color: fl.engrave; selection: fl.hull_raised; placeholder: "write a note, Return keeps it" }
                }
                group { show: nd_pgp == 2
                    zone box pns { from: nb_x + 12, nb_y + 96; size: nb_w - 24, 288; show: nd_kind == 13 and nd_pgp == 2 }
                    on scroll pns { emit nd_nsw(if(wheel > 0, -1, 1)) }
                    for c in ncard {
                        let col = c.index - floor(c.index / 2) * 2
                        let row = floor(c.index / 2)
                        let cw = (nb_w - 40) / 2
                        let cx = nb_x + 16 + col * (cw + 8)
                        let cy = nb_y + 100 + row * 96
                        box { from: cx, cy; size: cw, 88; corner: 14; color: fl.well; opacity: if(pnc.hover, 0.95, 0.7) }
                        box { from: cx, cy + 8; size: 3, 72; corner: 1.5; color: if(c.tag == 1, nd_acc, if(c.tag == 2, fl.flare, if(c.tag == 3, fl.ember, fl.trace_lit))); show: c.tag > 0 }
                        text c.title { at: cx + 14, cy + 20; anchor: left center; size: 12; weight: 700; family: "Exo 2"; color: fl.engrave; width: cw - 44; lines: 1; show: c.more }
                        // a note of one line wraps onto two, so a long one is read rather than cut
                        text c.title { at: cx + 14, cy + 12; anchor: left top; size: 12; weight: 700; family: "Exo 2"; color: fl.engrave; width: cw - 30; lines: 2; line_height: 1.3; show: not c.more }
                        text c.rest { at: cx + 14, cy + 38; anchor: left center; size: 11; family: "Exo 2"; color: fl.muted; width: cw - 30; lines: 1; show: c.more }
                        text c.age { at: cx + 14, cy + 72; anchor: left center; size: 9; family: "Share Tech Mono"; color: fl.muted }
                        text "󰐃" { at: cx + cw - 44, cy + 72; anchor: center; align: center; size: 12; family: "CaskaydiaCove Nerd Font"; color: if(c.pinned, nd_acc, fl.muted); opacity: if(c.pinned, 1, 0.4) }
                        text "×" { at: cx + cw - 18, cy + 17; anchor: center; size: 14; family: "Exo 2"; color: if(pnx.hover, fl.engrave, fl.muted); show: pnc.hover or pnx.hover }
                        zone box pnc { from: cx, cy; size: cw, 88; corner: 14; cursor: pointer; role: item; label: "{c.title}"; show: nd_kind == 13 and nd_pgp == 2 }
                        on press pnc { emit nd_br(10 + c.index) }
                        on scroll pnc { emit nd_nsw(if(wheel > 0, -1, 1)) }
                        zone box pnp { from: cx + cw - 58, cy + 56; size: 28, 28; corner: 14; cursor: pointer; role: button; label: if(c.pinned, "Unpin", "Pin"); show: nd_kind == 13 and nd_pgp == 2 }
                        on press pnp { emit nd_npin(c.id) }
                        zone box pnx { from: cx + cw - 32, cy + 4; size: 28, 26; corner: 8; cursor: pointer; role: button; label: "Forget this note"; show: nd_kind == 13 and nd_pgp == 2 and (pnc.hover or pnx.hover) }
                        on press pnx { emit nd_ndel(c.id) }
                    }
                }
                group { show: nd_pgp == 3 or nd_pgp == 7
                    for r in br {
                        let ry = nb_y + 58 + r.index * if(nd_pgp == 7, 46, 32)
                        box { from: nb_x + 12, ry; size: nb_w - 24, if(nd_pgp == 7, 40, 28); corner: 8 * nd_rnd; color: fl.well; opacity: if(prr.hover, 0.9, 0.35) }
                        ellipse { at: nb_x + 24, ry + if(nd_pgp == 7, 20, 14); radius: 2.5; color: nd_acc; show: r.pinned }
                        text r.label { at: nb_x + 34, ry + if(nd_pgp == 7, 20, 14); anchor: left center; size: 11; family: "Exo 2"; color: fl.engrave; width: nb_w - 170; lines: 1 }
                        text r.detail { at: nb_x + nb_w - 22, ry + if(nd_pgp == 7, 20, 14); anchor: right center; align: right; size: 9; family: "Share Tech Mono"; color: fl.muted; width: 110; lines: 1 }
                        zone box prr { from: nb_x + 12, ry; size: nb_w - 24, if(nd_pgp == 7, 40, 28); cursor: pointer; role: item; label: "{r.label}"; show: nd_kind == 13 and (nd_pgp == 3 or nd_pgp == 7) }
                        on press prr { emit nd_br(10 + r.index) }
                    }
                }
                group { show: nd_pgp == 4
                    let bw = (nb_w - 48) / 3
                    box { from: nb_x + 16 + (1 - 1) * (bw + 8), nb_y + 54; size: bw, 34; corner: 17 * max(0.3, nd_rnd); color: nd_acc; opacity: if(ps1.hover, 0.3, 0.16) }
                    text "󰅌" { at: nb_x + 16 + (1 - 1) * (bw + 8) + 18, nb_y + 71; anchor: center; align: center; size: 13; family: "CaskaydiaCove Nerd Font"; color: nd_acc }
                    text "From clipboard" { at: nb_x + 16 + (1 - 1) * (bw + 8) + 32, nb_y + 71; anchor: left center; size: 9; weight: 700; family: "Share Tech Mono"; color: fl.engrave; width: bw - 38; lines: 1 }
                    zone box ps1 { from: nb_x + 16 + (1 - 1) * (bw + 8), nb_y + 54; size: bw, 34; corner: 17; cursor: pointer; role: button; label: "From clipboard"; show: nd_kind == 13 and nd_pgp == 4 }
                    on press ps1 { emit nd_sclip }
                    box { from: nb_x + 16 + (2 - 1) * (bw + 8), nb_y + 54; size: bw, 34; corner: 17 * max(0.3, nd_rnd); color: nd_acc; opacity: if(ps2.hover, 0.3, 0.16) }
                    text "󰉋" { at: nb_x + 16 + (2 - 1) * (bw + 8) + 18, nb_y + 71; anchor: center; align: center; size: 13; family: "CaskaydiaCove Nerd Font"; color: nd_acc }
                    text "Downloads" { at: nb_x + 16 + (2 - 1) * (bw + 8) + 32, nb_y + 71; anchor: left center; size: 9; weight: 700; family: "Share Tech Mono"; color: fl.engrave; width: bw - 38; lines: 1 }
                    zone box ps2 { from: nb_x + 16 + (2 - 1) * (bw + 8), nb_y + 54; size: bw, 34; corner: 17; cursor: pointer; role: button; label: "Downloads"; show: nd_kind == 13 and nd_pgp == 4 }
                    on press ps2 { emit nd_sdl }
                    box { from: nb_x + 16 + (3 - 1) * (bw + 8), nb_y + 54; size: bw, 34; corner: 17 * max(0.3, nd_rnd); color: if(nd_sclear, fl.ember, nd_acc); opacity: if(ps3.hover, 0.32, if(nd_sclear, 0.24, 0.16)) }
                    text "󰆴" { at: nb_x + 16 + (3 - 1) * (bw + 8) + 18, nb_y + 71; anchor: center; align: center; size: 13; family: "CaskaydiaCove Nerd Font"; color: if(nd_sclear, fl.ember, nd_acc) }
                    text if(nd_sclear, "Press again", "Clear") { at: nb_x + 16 + (3 - 1) * (bw + 8) + 32, nb_y + 71; anchor: left center; size: 9; weight: 700; family: "Share Tech Mono"; color: if(nd_sclear, fl.ember, fl.engrave); width: bw - 38; lines: 1 }
                    zone box ps3 { from: nb_x + 16 + (3 - 1) * (bw + 8), nb_y + 54; size: bw, 34; corner: 17; cursor: pointer; role: button; label: if(nd_sclear, "Press again to clear", "Clear the stash"); show: nd_kind == 13 and nd_pgp == 4 }
                    on press ps3 { emit nd_sclear }
                    for s in stz {
                        let sy = nb_y + 100 + s.index * 44
                        box { from: nb_x + 14, sy; size: nb_w - 28, 40; corner: 10; color: fl.well; opacity: if(psz.hover, 0.95, 0.7) }
                        text s.icon { at: nb_x + 34, sy + 20; anchor: center; align: center; size: 14; family: "CaskaydiaCove Nerd Font"; color: nd_acc }
                        text s.name { at: nb_x + 52, sy + 14; anchor: left center; size: 11; weight: 700; family: "Exo 2"; color: fl.engrave; width: nb_w - 200; lines: 1 }
                        text s.detail { at: nb_x + 52, sy + 28; anchor: left center; size: 9; family: "Share Tech Mono"; color: fl.muted; width: nb_w - 200; lines: 1 }
                        text "×" { at: nb_x + nb_w - 26, sy + 20; anchor: center; size: 14; family: "Exo 2"; color: if(psx.hover, fl.engrave, fl.muted) }
                        zone box psz { from: nb_x + 14, sy; size: nb_w - 70, 40; corner: 10; cursor: pointer; role: item; label: "{s.name}"; show: nd_kind == 13 and nd_pgp == 4 }
                        on press psz { emit nd_br(10 + s.index) }
                        zone box psx { from: nb_x + nb_w - 48, sy + 7; size: 34, 26; corner: 8; cursor: pointer; role: button; label: "Forget this item"; show: nd_kind == 13 and nd_pgp == 4 }
                        on press psx { emit nd_stdel(s.id) }
                    }
                    text "󰏗" { at: nb_x + nb_w / 2, nb_y + 150; anchor: center; align: center; size: 30; family: "CaskaydiaCove Nerd Font"; color: fl.muted; opacity: 0.7; show: stz.count == 0 }
                    text "Nothing kept yet — copy something and press From clipboard" { at: nb_x + nb_w / 2, nb_y + 186; anchor: center; align: center; size: 11; family: "Exo 2"; color: fl.muted; width: nb_w - 80; lines: 2; show: stz.count == 0 }
                }
                group { show: nd_pgp == 10
                    box { from: nb_x + 16, nb_y + 58; size: nb_w - 32, 32; corner: 16 * max(0.3, nd_rnd); color: fl.well }
                    text "󰍉" { at: nb_x + 34, nb_y + 74; anchor: center; size: 13; family: "CaskaydiaCove Nerd Font"; color: nd_acc }
                    input nd_kq { at: nb_x + 52, nb_y + 64; width: nb_w - 88; size: 12; family: "Exo 2"; color: fl.engrave; selection: fl.hull_raised; placeholder: "filter: a key, or what it does" }
                    for k in kb {
                        let ky = nb_y + 100 + k.index * 32
                        box { from: nb_x + 12, ky; size: nb_w - 24, 28; corner: 8 * nd_rnd; color: fl.well; opacity: if(k.index - floor(k.index / 2) * 2 == 0, 0.45, 0.2) }
                        text k.keys { at: nb_x + 24, ky + 14; anchor: left center; size: 10; weight: 700; family: "Share Tech Mono"; color: nd_acc; width: 190; lines: 1 }
                        text k.what { at: nb_x + 222, ky + 14; anchor: left center; size: 11; family: "Exo 2"; color: fl.engrave; width: nb_w - 246; lines: 1 }
                    }
                    text "{nd_kmore, 0} MORE · ↑ ↓ OR THE WHEEL" { at: nb_x + nb_w / 2, nb_y + 433; anchor: center; align: center; size: 9; family: "Share Tech Mono"; color: fl.muted; show: nd_kmore > 0.5 }
                    text "Nothing bound matches" { at: nb_x + nb_w / 2, nb_y + 130; anchor: center; align: center; size: 11; family: "Exo 2"; color: fl.muted; show: kb.count == 0 }
                    zone box pksz { from: nb_x + 12, nb_y + 100; size: nb_w - 24, 320; show: nd_kind == 13 and nd_pgp == 10 }
                    on scroll pksz { emit nd_ksc(if(wheel > 0, -1, 1)) }
                }
                group { show: nd_pgp == 5
                    for w in wl {
                        let wcol = w.index - floor(w.index / 3) * 3
                        let wrow = floor(w.index / 3)
                        let ww = (nb_w - 52) / 3
                        let wx = nb_x + 16 + wcol * (ww + 10)
                        let wy = nb_y + 58 + wrow * (ww * 0.5625 + 26)
                        group { clip box { from: wx, wy; size: ww, ww * 0.5625; corner: 10 * max(0.4, nd_rnd) }
                            box { from: wx, wy; size: ww, ww * 0.5625; color: fl.hull_raised }
                            image w.img { at: wx, wy; size: ww, ww * 0.5625; fit: cover } }
                        box { from: wx, wy; size: ww, ww * 0.5625; corner: 10 * max(0.4, nd_rnd); stroke: if(w.on, 2.5, 1); color: if(w.on, nd_acc, if(pwlz.hover, fl.trace_lit, fl.trace_dim)) }
                        text "󰄬" { at: wx + ww - 14, wy + 14; anchor: center; size: 12; family: "CaskaydiaCove Nerd Font"; color: nd_acc; show: w.on }
                        text w.name { at: wx + 2, wy + ww * 0.5625 + 11; anchor: left center; size: 9; family: "Share Tech Mono"; color: if(w.on, nd_acc, fl.muted); width: ww - 4; lines: 1 }
                        zone box pwlz { from: wx, wy; size: ww, ww * 0.5625; corner: 10; cursor: pointer; role: item; label: "Wear {w.name}"; show: nd_kind == 13 and nd_pgp == 5 }
                        on press pwlz { emit nd_br(10 + w.index) }
                        // D307: the heart, on a favourite always and on any picture under the pointer
                        group { show: w.fav or pwlz.hover or pwfz.hover
                            ellipse { at: wx + 14, wy + 14; radius: 10; color: fl.ground; opacity: 0.8 }
                            text "♥" { at: wx + 14, wy + 14; anchor: center; size: 11; family: "Exo 2"; color: if(w.fav, nd_acc, if(pwfz.hover, fl.engrave, fl.muted)) } }
                        zone box pwfz { from: wx + 2, wy + 2; size: 24, 24; corner: 12; cursor: pointer; role: toggle; checked: w.fav; label: "Favourite"; show: nd_kind == 13 and nd_pgp == 5 }
                        on press pwfz { emit nd_br(30 + w.index) }
                        on scroll pwlz { emit nd_br(if(wheel > 0, 1, 2)) }
                    }
                    text "No pictures indexed yet — open the picker once (Super+W)" { at: nb_x + nb_w / 2, nb_y + 140; anchor: center; align: center; size: 11; family: "Exo 2"; color: fl.muted; show: wl.count == 0 }
                    box { from: nb_x + 14, nb_y + 402; size: 70, 32; corner: 10; color: nd_acc; opacity: if(pwb1.hover, 0.16, 0.06) }
                    box { from: nb_x + 14, nb_y + 402; size: 70, 32; corner: 10; stroke: 1; color: if(pwb1.hover, nd_acc, fl.trace_dim) }
                    text "󰁍  Back" { at: nb_x + 14 + 70 / 2, nb_y + 418; anchor: center; align: center; size: 10; weight: 700; family: "CaskaydiaCove Nerd Font"; color: if(pwb1.hover, nd_acc, fl.engrave) }
                    zone box pwb1 { from: nb_x + 14, nb_y + 402; size: 70, 32; corner: 10; cursor: pointer; role: button; label: "Back"; show: nd_kind == 13 and nd_pgp == 5 }
                    on press pwb1 { emit nd_br(1) }
                    box { from: nb_x + 92, nb_y + 402; size: 70, 32; corner: 10; color: nd_acc; opacity: if(pwb2.hover, 0.16, 0.06) }
                    box { from: nb_x + 92, nb_y + 402; size: 70, 32; corner: 10; stroke: 1; color: if(pwb2.hover, nd_acc, fl.trace_dim) }
                    text "󰁔  On" { at: nb_x + 92 + 70 / 2, nb_y + 418; anchor: center; align: center; size: 10; weight: 700; family: "CaskaydiaCove Nerd Font"; color: if(pwb2.hover, nd_acc, fl.engrave) }
                    zone box pwb2 { from: nb_x + 92, nb_y + 402; size: 70, 32; corner: 10; cursor: pointer; role: button; label: "On"; show: nd_kind == 13 and nd_pgp == 5 }
                    on press pwb2 { emit nd_br(2) }
                    box { from: nb_x + 170, nb_y + 402; size: 84, 32; corner: 10; color: nd_acc; opacity: if(pwb5.hover, 0.16, if(nd_wlfav, 0.22, 0.06)) }
                    box { from: nb_x + 170, nb_y + 402; size: 84, 32; corner: 10; stroke: 1; color: if(pwb5.hover, nd_acc, fl.trace_dim) }
                    text "♥  Favs" { at: nb_x + 170 + 84 / 2, nb_y + 418; anchor: center; align: center; size: 10; weight: 700; family: "CaskaydiaCove Nerd Font"; color: if(pwb5.hover, nd_acc, fl.engrave) }
                    zone box pwb5 { from: nb_x + 170, nb_y + 402; size: 84, 32; corner: 10; cursor: pointer; role: button; label: "Favs"; show: nd_kind == 13 and nd_pgp == 5 }
                    on press pwb5 { emit nd_br(93) }
                    box { from: nb_x + nb_w - 232, nb_y + 402; size: 100, 32; corner: 10; color: nd_acc; opacity: if(pwb3.hover, 0.16, 0.06) }
                    box { from: nb_x + nb_w - 232, nb_y + 402; size: 100, 32; corner: 10; stroke: 1; color: if(pwb3.hover, nd_acc, fl.trace_dim) }
                    text "󰒝  Random" { at: nb_x + nb_w - 232 + 100 / 2, nb_y + 418; anchor: center; align: center; size: 10; weight: 700; family: "CaskaydiaCove Nerd Font"; color: if(pwb3.hover, nd_acc, fl.engrave) }
                    zone box pwb3 { from: nb_x + nb_w - 232, nb_y + 402; size: 100, 32; corner: 10; cursor: pointer; role: button; label: "Random"; show: nd_kind == 13 and nd_pgp == 5 }
                    on press pwb3 { emit nd_br(91) }
                    box { from: nb_x + nb_w - 124, nb_y + 402; size: 110, 32; corner: 10; color: nd_acc; opacity: if(pwb4.hover, 0.16, 0.06) }
                    box { from: nb_x + nb_w - 124, nb_y + 402; size: 110, 32; corner: 10; stroke: 1; color: if(pwb4.hover, nd_acc, fl.trace_dim) }
                    text "󰸉  All" { at: nb_x + nb_w - 124 + 110 / 2, nb_y + 418; anchor: center; align: center; size: 10; weight: 700; family: "CaskaydiaCove Nerd Font"; color: if(pwb4.hover, nd_acc, fl.engrave) }
                    zone box pwb4 { from: nb_x + nb_w - 124, nb_y + 402; size: 110, 32; corner: 10; cursor: pointer; role: button; label: "All"; show: nd_kind == 13 and nd_pgp == 5 }
                    on press pwb4 { emit nd_br(92) }
                }
                group { show: nd_pgp == 6
                    for p in sy {
                        let col = p.index - floor(p.index / 2) * 2
                        let row = floor(p.index / 2)
                        let gx = nb_x + 14 + col * ((nb_w - 28) / 2 + 12)
                        let gy = nb_y + 56 + row * 96
                        let gw = (nb_w - 40) / 2
                        box { from: gx, gy; size: gw, 88; corner: 12; color: fl.well }
                        text p.label { at: gx + 12, gy + 17; anchor: left center; size: 9; weight: 700; family: "Share Tech Mono"; color: fl.muted }
                        text p.value { at: gx + gw - 12, gy + 17; anchor: right center; align: right; size: 12; weight: 700; family: "Share Tech Mono"; color: if(p.hot, fl.ember, fl.engrave) }
                        box { from: gx + 12 + 0 * ((gw - 24) / 20), gy + 70 - p.h0 * 38; size: (gw - 28) / 20, p.h0 * 38 + 1; corner: 1; color: if(p.hot, fl.ember, nd_acc); opacity: 0.35 + 0.55 * p.h0 }
                        box { from: gx + 12 + 1 * ((gw - 24) / 20), gy + 70 - p.h1 * 38; size: (gw - 28) / 20, p.h1 * 38 + 1; corner: 1; color: if(p.hot, fl.ember, nd_acc); opacity: 0.35 + 0.55 * p.h1 }
                        box { from: gx + 12 + 2 * ((gw - 24) / 20), gy + 70 - p.h2 * 38; size: (gw - 28) / 20, p.h2 * 38 + 1; corner: 1; color: if(p.hot, fl.ember, nd_acc); opacity: 0.35 + 0.55 * p.h2 }
                        box { from: gx + 12 + 3 * ((gw - 24) / 20), gy + 70 - p.h3 * 38; size: (gw - 28) / 20, p.h3 * 38 + 1; corner: 1; color: if(p.hot, fl.ember, nd_acc); opacity: 0.35 + 0.55 * p.h3 }
                        box { from: gx + 12 + 4 * ((gw - 24) / 20), gy + 70 - p.h4 * 38; size: (gw - 28) / 20, p.h4 * 38 + 1; corner: 1; color: if(p.hot, fl.ember, nd_acc); opacity: 0.35 + 0.55 * p.h4 }
                        box { from: gx + 12 + 5 * ((gw - 24) / 20), gy + 70 - p.h5 * 38; size: (gw - 28) / 20, p.h5 * 38 + 1; corner: 1; color: if(p.hot, fl.ember, nd_acc); opacity: 0.35 + 0.55 * p.h5 }
                        box { from: gx + 12 + 6 * ((gw - 24) / 20), gy + 70 - p.h6 * 38; size: (gw - 28) / 20, p.h6 * 38 + 1; corner: 1; color: if(p.hot, fl.ember, nd_acc); opacity: 0.35 + 0.55 * p.h6 }
                        box { from: gx + 12 + 7 * ((gw - 24) / 20), gy + 70 - p.h7 * 38; size: (gw - 28) / 20, p.h7 * 38 + 1; corner: 1; color: if(p.hot, fl.ember, nd_acc); opacity: 0.35 + 0.55 * p.h7 }
                        box { from: gx + 12 + 8 * ((gw - 24) / 20), gy + 70 - p.h8 * 38; size: (gw - 28) / 20, p.h8 * 38 + 1; corner: 1; color: if(p.hot, fl.ember, nd_acc); opacity: 0.35 + 0.55 * p.h8 }
                        box { from: gx + 12 + 9 * ((gw - 24) / 20), gy + 70 - p.h9 * 38; size: (gw - 28) / 20, p.h9 * 38 + 1; corner: 1; color: if(p.hot, fl.ember, nd_acc); opacity: 0.35 + 0.55 * p.h9 }
                        box { from: gx + 12 + 10 * ((gw - 24) / 20), gy + 70 - p.h10 * 38; size: (gw - 28) / 20, p.h10 * 38 + 1; corner: 1; color: if(p.hot, fl.ember, nd_acc); opacity: 0.35 + 0.55 * p.h10 }
                        box { from: gx + 12 + 11 * ((gw - 24) / 20), gy + 70 - p.h11 * 38; size: (gw - 28) / 20, p.h11 * 38 + 1; corner: 1; color: if(p.hot, fl.ember, nd_acc); opacity: 0.35 + 0.55 * p.h11 }
                        box { from: gx + 12 + 12 * ((gw - 24) / 20), gy + 70 - p.h12 * 38; size: (gw - 28) / 20, p.h12 * 38 + 1; corner: 1; color: if(p.hot, fl.ember, nd_acc); opacity: 0.35 + 0.55 * p.h12 }
                        box { from: gx + 12 + 13 * ((gw - 24) / 20), gy + 70 - p.h13 * 38; size: (gw - 28) / 20, p.h13 * 38 + 1; corner: 1; color: if(p.hot, fl.ember, nd_acc); opacity: 0.35 + 0.55 * p.h13 }
                        box { from: gx + 12 + 14 * ((gw - 24) / 20), gy + 70 - p.h14 * 38; size: (gw - 28) / 20, p.h14 * 38 + 1; corner: 1; color: if(p.hot, fl.ember, nd_acc); opacity: 0.35 + 0.55 * p.h14 }
                        box { from: gx + 12 + 15 * ((gw - 24) / 20), gy + 70 - p.h15 * 38; size: (gw - 28) / 20, p.h15 * 38 + 1; corner: 1; color: if(p.hot, fl.ember, nd_acc); opacity: 0.35 + 0.55 * p.h15 }
                        box { from: gx + 12 + 16 * ((gw - 24) / 20), gy + 70 - p.h16 * 38; size: (gw - 28) / 20, p.h16 * 38 + 1; corner: 1; color: if(p.hot, fl.ember, nd_acc); opacity: 0.35 + 0.55 * p.h16 }
                        box { from: gx + 12 + 17 * ((gw - 24) / 20), gy + 70 - p.h17 * 38; size: (gw - 28) / 20, p.h17 * 38 + 1; corner: 1; color: if(p.hot, fl.ember, nd_acc); opacity: 0.35 + 0.55 * p.h17 }
                        box { from: gx + 12 + 18 * ((gw - 24) / 20), gy + 70 - p.h18 * 38; size: (gw - 28) / 20, p.h18 * 38 + 1; corner: 1; color: if(p.hot, fl.ember, nd_acc); opacity: 0.35 + 0.55 * p.h18 }
                        box { from: gx + 12 + 19 * ((gw - 24) / 20), gy + 70 - p.h19 * 38; size: (gw - 28) / 20, p.h19 * 38 + 1; corner: 1; color: if(p.hot, fl.ember, nd_acc); opacity: 0.35 + 0.55 * p.h19 }
                        zone box psyz { from: gx, gy; size: gw, 88; corner: 12; cursor: if(p.deep, pointer, default); role: button; label: "{p.label} {p.value}"; show: nd_kind == 13 and nd_pgp == 6 }
                        on press psyz { emit nd_sys(p.index) }
                    }
                }
                group { show: nd_pgp == 8
                    box { from: nb_x + 14, nb_y + 54; size: nb_w - 28, 72; corner: 14; color: fl.well }
                    text "󰖩" { at: nb_x + 38, nb_y + 90; anchor: center; align: center; size: 24; family: "CaskaydiaCove Nerd Font"; color: if(nd_won, nd_acc, fl.muted) }
                    text nd_wname { at: nb_x + 62, nb_y + 80; anchor: left center; size: 14; weight: 700; family: "Exo 2"; color: fl.engrave; width: nb_w - 210; lines: 1 }
                    text if(nd_won, "CONNECTED", "THE RADIO IS OFF") { at: nb_x + 62, nb_y + 98; anchor: left center; size: 9; weight: 700; family: "Share Tech Mono"; color: fl.muted }
                    repeat wb in 0..4 { box { from: nb_x + nb_w - 154 + wb * 7, nb_y + 96 - wb * 3; size: 4, 4 + wb * 3; corner: 1; color: if(wb < nd_wbars, nd_acc, fl.trace_dim) } }
                    text "󰌾" { at: nb_x + nb_w - 108, nb_y + 90; anchor: center; align: center; size: 13; family: "CaskaydiaCove Nerd Font"; color: fl.muted; show: nd_wsec }
                    zone box pwz0 { from: nb_x + 14, nb_y + 54; size: nb_w - 28, 72; corner: 14; cursor: if(nd_won, default, pointer); role: button; label: if(nd_won, nd_wname, "Turn Wi-Fi on"); show: nd_kind == 13 and nd_pgp == 8 }
                    on press pwz0 { emit nd_ptog(1) }
                    text "󰑐" { at: nb_x + nb_w - 30, nb_y + 30; anchor: center; align: center; size: 14; family: "CaskaydiaCove Nerd Font"; color: if(pwrz.hover, nd_acc, fl.muted) }
                    zone box pwrz { from: nb_x + nb_w - 48, nb_y + 12; size: 36, 30; cursor: pointer; role: button; label: "Look for networks"; show: nd_kind == 13 and nd_pgp == 8 }
                    on press pwrz { emit nd_wr }
                    group { show: nd_wsel == 0
                    for n in nw {
                        let wy = nb_y + 140 + n.index * 30
                        box { from: nb_x + 14, wy; size: nb_w - 28, 27; corner: 8 * nd_rnd; color: fl.well; opacity: if(pwnz.hover, 0.9, 0.35) }
                        text n.name { at: nb_x + 28, wy + 13.5; anchor: left center; size: 11; family: "Exo 2"; color: fl.engrave; width: nb_w - 210; lines: 1 }
                        repeat wb2 in 0..4 { box { from: nb_x + nb_w - 154 + wb2 * 7, wy + 21 - wb2 * 3; size: 4, 4 + wb2 * 3; corner: 1; color: if(wb2 < n.bars, nd_acc, fl.trace_dim) } }
                        text "󰌾" { at: nb_x + nb_w - 98, wy + 13.5; anchor: center; align: center; size: 11; family: "CaskaydiaCove Nerd Font"; color: fl.muted; show: n.secure }
                        text "known" { at: nb_x + nb_w - 70, wy + 13.5; anchor: left center; size: 8; family: "Share Tech Mono"; color: fl.muted; show: n.known }
                        text "×" { at: nb_x + nb_w - 24, wy + 13.5; anchor: center; size: 13; family: "Exo 2"; color: if(pwfz.hover, fl.engrave, fl.muted); show: n.known }
                        zone box pwnz { from: nb_x + 14, wy; size: nb_w - 70, 27; cursor: pointer; role: item; label: "Join {n.name}"; show: nd_kind == 13 and nd_pgp == 8 }
                        on press pwnz { emit nd_wn(n.index) }
                        zone box pwfz { from: nb_x + nb_w - 44, wy; size: 30, 27; cursor: pointer; role: button; label: "Forget {n.name}"; show: nd_kind == 13 and nd_pgp == 8 and n.known }
                        on press pwfz { emit nd_wf(n.index) }
                    }
                    text "Scanning…" { at: nb_x + nb_w / 2, nb_y + 196; anchor: center; align: center; size: 10; family: "Share Tech Mono"; color: fl.muted; show: nd_won and nw.count == 0 }
                    }
                    group { show: nd_wsel > 0
                        box { from: nb_x + 14, nb_y + 140; size: nb_w - 28, 34; corner: 10; color: fl.well }
                        box { from: nb_x + 14, nb_y + 140; size: nb_w - 28, 34; corner: 10; stroke: 1; color: nd_acc }
                        text "PASSWORD FOR" { at: nb_x + 26, nb_y + 157; anchor: left center; size: 8; weight: 700; family: "Share Tech Mono"; color: fl.muted }
                        input nd_wpw { at: nb_x + 112, nb_y + 149; width: nb_w - 130; size: 12; family: "Exo 2"; color: fl.engrave; selection: fl.hull_raised; secret: true; placeholder: "press Return to join" }
                        zone box pwpz { from: nb_x + 14, nb_y + 140; size: nb_w - 28, 34; cursor: pointer; role: button; label: "Join {nd_wssid}" }
                        on press pwpz { emit nd_wgo }
                    }
                    text nd_werr { at: nb_x + 16, nb_y + nb_h - 42; anchor: left center; size: 9; family: "Share Tech Mono"; color: fl.ember; width: nb_w - 32; lines: 1; show: nd_werron }
                }
                group { show: nd_pgp == 9
                    box { from: nb_x + 14, nb_y + 54; size: nb_w - 28, 72; corner: 14; color: fl.well }
                    text if(nd_btpw, "󰂯", "󰂲") { at: nb_x + 38, nb_y + 90; anchor: center; align: center; size: 24; family: "CaskaydiaCove Nerd Font"; color: if(nd_btpw, nd_acc, fl.muted) }
                    text nd_bth { at: nb_x + 62, nb_y + 80; anchor: left center; size: 14; weight: 700; family: "Exo 2"; color: fl.engrave; width: nb_w - 190; lines: 1 }
                    text if(nd_btpw, "ON", "OFF") { at: nb_x + 62, nb_y + 98; anchor: left center; size: 9; weight: 700; family: "Share Tech Mono"; color: fl.muted }
                    text "{round(nd_btbat * 100)}%" { at: nb_x + nb_w - 54, nb_y + 90; anchor: right center; align: right; size: 10; weight: 700; family: "Share Tech Mono"; color: nd_acc; show: nd_btbat >= 0 }
                    zone box pbz0 { from: nb_x + 14, nb_y + 54; size: nb_w - 28, 72; corner: 14; cursor: if(nd_btpw, default, pointer); role: button; label: if(nd_btpw, nd_bth, "Turn Bluetooth on"); show: nd_kind == 13 and nd_pgp == 9 }
                    on press pbz0 { emit nd_ptog(4) }
                    text "󰑐" { at: nb_x + nb_w - 30, nb_y + 30; anchor: center; align: center; size: 14; family: "CaskaydiaCove Nerd Font"; color: if(pbrz.hover, nd_acc, fl.muted) }
                    zone box pbrz { from: nb_x + nb_w - 48, nb_y + 12; size: 36, 30; cursor: pointer; role: button; label: "Look for devices"; show: nd_kind == 13 and nd_pgp == 9 and nd_btpw }
                    on press pbrz { emit nd_brf }
                    for d in bt {
                        let by = nb_y + 140 + d.index * 30
                        box { from: nb_x + 14, by; size: nb_w - 28, 27; corner: 8 * nd_rnd; color: fl.well; opacity: if(pbdz.hover, 0.9, 0.35) }
                        ellipse { at: nb_x + 26, by + 13.5; radius: 3; color: if(d.on, nd_acc, if(d.paired, fl.trace_lit, fl.trace_dim)) }
                        text d.name { at: nb_x + 38, by + 13.5; anchor: left center; size: 11; family: "Exo 2"; color: fl.engrave; width: nb_w - 190; lines: 1 }
                        text d.detail { at: nb_x + nb_w - 22, by + 13.5; anchor: right center; align: right; size: 9; family: "Share Tech Mono"; color: if(d.on, nd_acc, fl.muted); width: 120; lines: 1 }
                        zone box pbdz { from: nb_x + 14, by; size: nb_w - 28, 27; cursor: pointer; role: item; label: if(d.on, "Disconnect {d.name}", "Connect {d.name}"); show: nd_kind == 13 and nd_pgp == 9 and nd_btpw }
                        on press pbdz { emit nd_bd(d.index) }
                    }
                    text if(nd_btdis, "Looking for devices…", "") { at: nb_x + nb_w / 2, nb_y + 196; anchor: center; align: center; size: 10; family: "Share Tech Mono"; color: fl.muted; show: nd_btdis }
                    text "No Bluetooth adapter" { at: nb_x + nb_w / 2, nb_y + 90; anchor: center; align: center; size: 11; family: "Exo 2"; color: fl.muted; show: not nd_btp }
                }
            }
            group { show: nd_kind == 13 and (nd_playing or nd_paused)
                box { from: nb_x + 14 + 0 * (nb_w - 28) / 32, nb_y + nb_h - 3 - if(nd_playing, 1 + nd_sp0 * 8, 0); size: (nb_w - 28) / 32 - 1, if(nd_playing, 1 + nd_sp0 * 8, 1); corner: 1; color: nd_acc; opacity: if(nd_playing, 0.45 + 0.55 * nd_sp0, 0.3) }
                box { from: nb_x + 14 + 1 * (nb_w - 28) / 32, nb_y + nb_h - 3 - if(nd_playing, 1 + nd_sp1 * 8, 0); size: (nb_w - 28) / 32 - 1, if(nd_playing, 1 + nd_sp1 * 8, 1); corner: 1; color: nd_acc; opacity: if(nd_playing, 0.45 + 0.55 * nd_sp1, 0.3) }
                box { from: nb_x + 14 + 2 * (nb_w - 28) / 32, nb_y + nb_h - 3 - if(nd_playing, 1 + nd_sp2 * 8, 0); size: (nb_w - 28) / 32 - 1, if(nd_playing, 1 + nd_sp2 * 8, 1); corner: 1; color: nd_acc; opacity: if(nd_playing, 0.45 + 0.55 * nd_sp2, 0.3) }
                box { from: nb_x + 14 + 3 * (nb_w - 28) / 32, nb_y + nb_h - 3 - if(nd_playing, 1 + nd_sp3 * 8, 0); size: (nb_w - 28) / 32 - 1, if(nd_playing, 1 + nd_sp3 * 8, 1); corner: 1; color: nd_acc; opacity: if(nd_playing, 0.45 + 0.55 * nd_sp3, 0.3) }
                box { from: nb_x + 14 + 4 * (nb_w - 28) / 32, nb_y + nb_h - 3 - if(nd_playing, 1 + nd_sp4 * 8, 0); size: (nb_w - 28) / 32 - 1, if(nd_playing, 1 + nd_sp4 * 8, 1); corner: 1; color: nd_acc; opacity: if(nd_playing, 0.45 + 0.55 * nd_sp4, 0.3) }
                box { from: nb_x + 14 + 5 * (nb_w - 28) / 32, nb_y + nb_h - 3 - if(nd_playing, 1 + nd_sp5 * 8, 0); size: (nb_w - 28) / 32 - 1, if(nd_playing, 1 + nd_sp5 * 8, 1); corner: 1; color: nd_acc; opacity: if(nd_playing, 0.45 + 0.55 * nd_sp5, 0.3) }
                box { from: nb_x + 14 + 6 * (nb_w - 28) / 32, nb_y + nb_h - 3 - if(nd_playing, 1 + nd_sp6 * 8, 0); size: (nb_w - 28) / 32 - 1, if(nd_playing, 1 + nd_sp6 * 8, 1); corner: 1; color: nd_acc; opacity: if(nd_playing, 0.45 + 0.55 * nd_sp6, 0.3) }
                box { from: nb_x + 14 + 7 * (nb_w - 28) / 32, nb_y + nb_h - 3 - if(nd_playing, 1 + nd_sp7 * 8, 0); size: (nb_w - 28) / 32 - 1, if(nd_playing, 1 + nd_sp7 * 8, 1); corner: 1; color: nd_acc; opacity: if(nd_playing, 0.45 + 0.55 * nd_sp7, 0.3) }
                box { from: nb_x + 14 + 8 * (nb_w - 28) / 32, nb_y + nb_h - 3 - if(nd_playing, 1 + nd_sp8 * 8, 0); size: (nb_w - 28) / 32 - 1, if(nd_playing, 1 + nd_sp8 * 8, 1); corner: 1; color: nd_acc; opacity: if(nd_playing, 0.45 + 0.55 * nd_sp8, 0.3) }
                box { from: nb_x + 14 + 9 * (nb_w - 28) / 32, nb_y + nb_h - 3 - if(nd_playing, 1 + nd_sp9 * 8, 0); size: (nb_w - 28) / 32 - 1, if(nd_playing, 1 + nd_sp9 * 8, 1); corner: 1; color: nd_acc; opacity: if(nd_playing, 0.45 + 0.55 * nd_sp9, 0.3) }
                box { from: nb_x + 14 + 10 * (nb_w - 28) / 32, nb_y + nb_h - 3 - if(nd_playing, 1 + nd_sp10 * 8, 0); size: (nb_w - 28) / 32 - 1, if(nd_playing, 1 + nd_sp10 * 8, 1); corner: 1; color: nd_acc; opacity: if(nd_playing, 0.45 + 0.55 * nd_sp10, 0.3) }
                box { from: nb_x + 14 + 11 * (nb_w - 28) / 32, nb_y + nb_h - 3 - if(nd_playing, 1 + nd_sp11 * 8, 0); size: (nb_w - 28) / 32 - 1, if(nd_playing, 1 + nd_sp11 * 8, 1); corner: 1; color: nd_acc; opacity: if(nd_playing, 0.45 + 0.55 * nd_sp11, 0.3) }
                box { from: nb_x + 14 + 12 * (nb_w - 28) / 32, nb_y + nb_h - 3 - if(nd_playing, 1 + nd_sp12 * 8, 0); size: (nb_w - 28) / 32 - 1, if(nd_playing, 1 + nd_sp12 * 8, 1); corner: 1; color: nd_acc; opacity: if(nd_playing, 0.45 + 0.55 * nd_sp12, 0.3) }
                box { from: nb_x + 14 + 13 * (nb_w - 28) / 32, nb_y + nb_h - 3 - if(nd_playing, 1 + nd_sp13 * 8, 0); size: (nb_w - 28) / 32 - 1, if(nd_playing, 1 + nd_sp13 * 8, 1); corner: 1; color: nd_acc; opacity: if(nd_playing, 0.45 + 0.55 * nd_sp13, 0.3) }
                box { from: nb_x + 14 + 14 * (nb_w - 28) / 32, nb_y + nb_h - 3 - if(nd_playing, 1 + nd_sp14 * 8, 0); size: (nb_w - 28) / 32 - 1, if(nd_playing, 1 + nd_sp14 * 8, 1); corner: 1; color: nd_acc; opacity: if(nd_playing, 0.45 + 0.55 * nd_sp14, 0.3) }
                box { from: nb_x + 14 + 15 * (nb_w - 28) / 32, nb_y + nb_h - 3 - if(nd_playing, 1 + nd_sp15 * 8, 0); size: (nb_w - 28) / 32 - 1, if(nd_playing, 1 + nd_sp15 * 8, 1); corner: 1; color: nd_acc; opacity: if(nd_playing, 0.45 + 0.55 * nd_sp15, 0.3) }
                box { from: nb_x + 14 + 16 * (nb_w - 28) / 32, nb_y + nb_h - 3 - if(nd_playing, 1 + nd_sp16 * 8, 0); size: (nb_w - 28) / 32 - 1, if(nd_playing, 1 + nd_sp16 * 8, 1); corner: 1; color: nd_acc; opacity: if(nd_playing, 0.45 + 0.55 * nd_sp16, 0.3) }
                box { from: nb_x + 14 + 17 * (nb_w - 28) / 32, nb_y + nb_h - 3 - if(nd_playing, 1 + nd_sp17 * 8, 0); size: (nb_w - 28) / 32 - 1, if(nd_playing, 1 + nd_sp17 * 8, 1); corner: 1; color: nd_acc; opacity: if(nd_playing, 0.45 + 0.55 * nd_sp17, 0.3) }
                box { from: nb_x + 14 + 18 * (nb_w - 28) / 32, nb_y + nb_h - 3 - if(nd_playing, 1 + nd_sp18 * 8, 0); size: (nb_w - 28) / 32 - 1, if(nd_playing, 1 + nd_sp18 * 8, 1); corner: 1; color: nd_acc; opacity: if(nd_playing, 0.45 + 0.55 * nd_sp18, 0.3) }
                box { from: nb_x + 14 + 19 * (nb_w - 28) / 32, nb_y + nb_h - 3 - if(nd_playing, 1 + nd_sp19 * 8, 0); size: (nb_w - 28) / 32 - 1, if(nd_playing, 1 + nd_sp19 * 8, 1); corner: 1; color: nd_acc; opacity: if(nd_playing, 0.45 + 0.55 * nd_sp19, 0.3) }
                box { from: nb_x + 14 + 20 * (nb_w - 28) / 32, nb_y + nb_h - 3 - if(nd_playing, 1 + nd_sp20 * 8, 0); size: (nb_w - 28) / 32 - 1, if(nd_playing, 1 + nd_sp20 * 8, 1); corner: 1; color: nd_acc; opacity: if(nd_playing, 0.45 + 0.55 * nd_sp20, 0.3) }
                box { from: nb_x + 14 + 21 * (nb_w - 28) / 32, nb_y + nb_h - 3 - if(nd_playing, 1 + nd_sp21 * 8, 0); size: (nb_w - 28) / 32 - 1, if(nd_playing, 1 + nd_sp21 * 8, 1); corner: 1; color: nd_acc; opacity: if(nd_playing, 0.45 + 0.55 * nd_sp21, 0.3) }
                box { from: nb_x + 14 + 22 * (nb_w - 28) / 32, nb_y + nb_h - 3 - if(nd_playing, 1 + nd_sp22 * 8, 0); size: (nb_w - 28) / 32 - 1, if(nd_playing, 1 + nd_sp22 * 8, 1); corner: 1; color: nd_acc; opacity: if(nd_playing, 0.45 + 0.55 * nd_sp22, 0.3) }
                box { from: nb_x + 14 + 23 * (nb_w - 28) / 32, nb_y + nb_h - 3 - if(nd_playing, 1 + nd_sp23 * 8, 0); size: (nb_w - 28) / 32 - 1, if(nd_playing, 1 + nd_sp23 * 8, 1); corner: 1; color: nd_acc; opacity: if(nd_playing, 0.45 + 0.55 * nd_sp23, 0.3) }
                box { from: nb_x + 14 + 24 * (nb_w - 28) / 32, nb_y + nb_h - 3 - if(nd_playing, 1 + nd_sp24 * 8, 0); size: (nb_w - 28) / 32 - 1, if(nd_playing, 1 + nd_sp24 * 8, 1); corner: 1; color: nd_acc; opacity: if(nd_playing, 0.45 + 0.55 * nd_sp24, 0.3) }
                box { from: nb_x + 14 + 25 * (nb_w - 28) / 32, nb_y + nb_h - 3 - if(nd_playing, 1 + nd_sp25 * 8, 0); size: (nb_w - 28) / 32 - 1, if(nd_playing, 1 + nd_sp25 * 8, 1); corner: 1; color: nd_acc; opacity: if(nd_playing, 0.45 + 0.55 * nd_sp25, 0.3) }
                box { from: nb_x + 14 + 26 * (nb_w - 28) / 32, nb_y + nb_h - 3 - if(nd_playing, 1 + nd_sp26 * 8, 0); size: (nb_w - 28) / 32 - 1, if(nd_playing, 1 + nd_sp26 * 8, 1); corner: 1; color: nd_acc; opacity: if(nd_playing, 0.45 + 0.55 * nd_sp26, 0.3) }
                box { from: nb_x + 14 + 27 * (nb_w - 28) / 32, nb_y + nb_h - 3 - if(nd_playing, 1 + nd_sp27 * 8, 0); size: (nb_w - 28) / 32 - 1, if(nd_playing, 1 + nd_sp27 * 8, 1); corner: 1; color: nd_acc; opacity: if(nd_playing, 0.45 + 0.55 * nd_sp27, 0.3) }
                box { from: nb_x + 14 + 28 * (nb_w - 28) / 32, nb_y + nb_h - 3 - if(nd_playing, 1 + nd_sp28 * 8, 0); size: (nb_w - 28) / 32 - 1, if(nd_playing, 1 + nd_sp28 * 8, 1); corner: 1; color: nd_acc; opacity: if(nd_playing, 0.45 + 0.55 * nd_sp28, 0.3) }
                box { from: nb_x + 14 + 29 * (nb_w - 28) / 32, nb_y + nb_h - 3 - if(nd_playing, 1 + nd_sp29 * 8, 0); size: (nb_w - 28) / 32 - 1, if(nd_playing, 1 + nd_sp29 * 8, 1); corner: 1; color: nd_acc; opacity: if(nd_playing, 0.45 + 0.55 * nd_sp29, 0.3) }
                box { from: nb_x + 14 + 30 * (nb_w - 28) / 32, nb_y + nb_h - 3 - if(nd_playing, 1 + nd_sp30 * 8, 0); size: (nb_w - 28) / 32 - 1, if(nd_playing, 1 + nd_sp30 * 8, 1); corner: 1; color: nd_acc; opacity: if(nd_playing, 0.45 + 0.55 * nd_sp30, 0.3) }
                box { from: nb_x + 14 + 31 * (nb_w - 28) / 32, nb_y + nb_h - 3 - if(nd_playing, 1 + nd_sp31 * 8, 0); size: (nb_w - 28) / 32 - 1, if(nd_playing, 1 + nd_sp31 * 8, 1); corner: 1; color: nd_acc; opacity: if(nd_playing, 0.45 + 0.55 * nd_sp31, 0.3) }
            }
            // the icon row: every page, the current page lit
            line { from: nb_x + 14, nb_y + nb_h - 58; to: nb_x + nb_w - 14, nb_y + nb_h - 58; width: 1; color: fl.trace_dim }
            box { from: nb_x + 14 + 0 * (nb_w - 28) / 12, nb_y + nb_h - 52; size: (nb_w - 28) / 12 - 4, 42; corner: 10; color: nd_acc; opacity: if(nd_pgp == 0 or nd_pgp == 11, 0.18, 0) }
            box { from: nb_x + 14 + 0 * (nb_w - 28) / 12, nb_y + nb_h - 52; size: (nb_w - 28) / 12 - 4, 42; corner: 10; stroke: 1; color: nd_acc; opacity: if(nd_pgp == 0 or nd_pgp == 11, 0.8, 0) }
            text "󰋜" { at: nb_x + 14 + 0 * (nb_w - 28) / 12 + (nb_w - 28) / 12 / 2, nb_y + nb_h - 31; anchor: center; align: center; size: 17; family: "CaskaydiaCove Nerd Font"; color: if(nd_pgp == 0 or nd_pgp == 11, nd_acc, if(pi0.hover, fl.engrave, fl.muted)) }
            zone box pi0 { from: nb_x + 14 + 0 * (nb_w - 28) / 12, nb_y + nb_h - 52; size: (nb_w - 28) / 12, 42; cursor: pointer; role: button; label: "Home"; show: nd_kind == 13 }
            on press pi0 { emit nd_pg(0) }
            box { from: nb_x + 14 + 1 * (nb_w - 28) / 12, nb_y + nb_h - 52; size: (nb_w - 28) / 12 - 4, 42; corner: 10; color: nd_acc; opacity: if(nd_pgp == 1, 0.18, 0) }
            box { from: nb_x + 14 + 1 * (nb_w - 28) / 12, nb_y + nb_h - 52; size: (nb_w - 28) / 12 - 4, 42; corner: 10; stroke: 1; color: nd_acc; opacity: if(nd_pgp == 1, 0.8, 0) }
            text "󰃭" { at: nb_x + 14 + 1 * (nb_w - 28) / 12 + (nb_w - 28) / 12 / 2, nb_y + nb_h - 31; anchor: center; align: center; size: 17; family: "CaskaydiaCove Nerd Font"; color: if(nd_pgp == 1, nd_acc, if(pi1.hover, fl.engrave, fl.muted)) }
            zone box pi1 { from: nb_x + 14 + 1 * (nb_w - 28) / 12, nb_y + nb_h - 52; size: (nb_w - 28) / 12, 42; cursor: pointer; role: button; label: "Calendar"; show: nd_kind == 13 }
            on press pi1 { emit nd_pg(1) }
            box { from: nb_x + 14 + 2 * (nb_w - 28) / 12, nb_y + nb_h - 52; size: (nb_w - 28) / 12 - 4, 42; corner: 10; color: nd_acc; opacity: if(nd_pgp == 2, 0.18, 0) }
            box { from: nb_x + 14 + 2 * (nb_w - 28) / 12, nb_y + nb_h - 52; size: (nb_w - 28) / 12 - 4, 42; corner: 10; stroke: 1; color: nd_acc; opacity: if(nd_pgp == 2, 0.8, 0) }
            text "󰎞" { at: nb_x + 14 + 2 * (nb_w - 28) / 12 + (nb_w - 28) / 12 / 2, nb_y + nb_h - 31; anchor: center; align: center; size: 17; family: "CaskaydiaCove Nerd Font"; color: if(nd_pgp == 2, nd_acc, if(pi2.hover, fl.engrave, fl.muted)) }
            zone box pi2 { from: nb_x + 14 + 2 * (nb_w - 28) / 12, nb_y + nb_h - 52; size: (nb_w - 28) / 12, 42; cursor: pointer; role: button; label: "Notes"; show: nd_kind == 13 }
            on press pi2 { emit nd_pg(2) }
            box { from: nb_x + 14 + 3 * (nb_w - 28) / 12, nb_y + nb_h - 52; size: (nb_w - 28) / 12 - 4, 42; corner: 10; color: nd_acc; opacity: if(nd_pgp == 3, 0.18, 0) }
            box { from: nb_x + 14 + 3 * (nb_w - 28) / 12, nb_y + nb_h - 52; size: (nb_w - 28) / 12 - 4, 42; corner: 10; stroke: 1; color: nd_acc; opacity: if(nd_pgp == 3, 0.8, 0) }
            text "󰅌" { at: nb_x + 14 + 3 * (nb_w - 28) / 12 + (nb_w - 28) / 12 / 2, nb_y + nb_h - 31; anchor: center; align: center; size: 17; family: "CaskaydiaCove Nerd Font"; color: if(nd_pgp == 3, nd_acc, if(pi3.hover, fl.engrave, fl.muted)) }
            zone box pi3 { from: nb_x + 14 + 3 * (nb_w - 28) / 12, nb_y + nb_h - 52; size: (nb_w - 28) / 12, 42; cursor: pointer; role: button; label: "Clipboard"; show: nd_kind == 13 }
            on press pi3 { emit nd_pg(3) }
            box { from: nb_x + 14 + 4 * (nb_w - 28) / 12, nb_y + nb_h - 52; size: (nb_w - 28) / 12 - 4, 42; corner: 10; color: nd_acc; opacity: if(nd_pgp == 4, 0.18, 0) }
            box { from: nb_x + 14 + 4 * (nb_w - 28) / 12, nb_y + nb_h - 52; size: (nb_w - 28) / 12 - 4, 42; corner: 10; stroke: 1; color: nd_acc; opacity: if(nd_pgp == 4, 0.8, 0) }
            text "󰏗" { at: nb_x + 14 + 4 * (nb_w - 28) / 12 + (nb_w - 28) / 12 / 2, nb_y + nb_h - 31; anchor: center; align: center; size: 17; family: "CaskaydiaCove Nerd Font"; color: if(nd_pgp == 4, nd_acc, if(pi4.hover, fl.engrave, fl.muted)) }
            zone box pi4 { from: nb_x + 14 + 4 * (nb_w - 28) / 12, nb_y + nb_h - 52; size: (nb_w - 28) / 12, 42; cursor: pointer; role: button; label: "Stash"; show: nd_kind == 13 }
            on press pi4 { emit nd_pg(4) }
            box { from: nb_x + 14 + 5 * (nb_w - 28) / 12, nb_y + nb_h - 52; size: (nb_w - 28) / 12 - 4, 42; corner: 10; color: nd_acc; opacity: if(nd_pgp == 5, 0.18, 0) }
            box { from: nb_x + 14 + 5 * (nb_w - 28) / 12, nb_y + nb_h - 52; size: (nb_w - 28) / 12 - 4, 42; corner: 10; stroke: 1; color: nd_acc; opacity: if(nd_pgp == 5, 0.8, 0) }
            text "󰸉" { at: nb_x + 14 + 5 * (nb_w - 28) / 12 + (nb_w - 28) / 12 / 2, nb_y + nb_h - 31; anchor: center; align: center; size: 17; family: "CaskaydiaCove Nerd Font"; color: if(nd_pgp == 5, nd_acc, if(pi5.hover, fl.engrave, fl.muted)) }
            zone box pi5 { from: nb_x + 14 + 5 * (nb_w - 28) / 12, nb_y + nb_h - 52; size: (nb_w - 28) / 12, 42; cursor: pointer; role: button; label: "Wallpaper"; show: nd_kind == 13 }
            on press pi5 { emit nd_pg(5) }
            box { from: nb_x + 14 + 6 * (nb_w - 28) / 12, nb_y + nb_h - 52; size: (nb_w - 28) / 12 - 4, 42; corner: 10; color: nd_acc; opacity: if(nd_pgp == 6, 0.18, 0) }
            box { from: nb_x + 14 + 6 * (nb_w - 28) / 12, nb_y + nb_h - 52; size: (nb_w - 28) / 12 - 4, 42; corner: 10; stroke: 1; color: nd_acc; opacity: if(nd_pgp == 6, 0.8, 0) }
            text "󰍛" { at: nb_x + 14 + 6 * (nb_w - 28) / 12 + (nb_w - 28) / 12 / 2, nb_y + nb_h - 31; anchor: center; align: center; size: 17; family: "CaskaydiaCove Nerd Font"; color: if(nd_pgp == 6, nd_acc, if(pi6.hover, fl.engrave, fl.muted)) }
            zone box pi6 { from: nb_x + 14 + 6 * (nb_w - 28) / 12, nb_y + nb_h - 52; size: (nb_w - 28) / 12, 42; cursor: pointer; role: button; label: "System"; show: nd_kind == 13 }
            on press pi6 { emit nd_pg(6) }
            box { from: nb_x + 14 + 7 * (nb_w - 28) / 12, nb_y + nb_h - 52; size: (nb_w - 28) / 12 - 4, 42; corner: 10; color: nd_acc; opacity: if(nd_pgp == 8, 0.18, 0) }
            box { from: nb_x + 14 + 7 * (nb_w - 28) / 12, nb_y + nb_h - 52; size: (nb_w - 28) / 12 - 4, 42; corner: 10; stroke: 1; color: nd_acc; opacity: if(nd_pgp == 8, 0.8, 0) }
            text "󰖩" { at: nb_x + 14 + 7 * (nb_w - 28) / 12 + (nb_w - 28) / 12 / 2, nb_y + nb_h - 31; anchor: center; align: center; size: 17; family: "CaskaydiaCove Nerd Font"; color: if(nd_pgp == 8, nd_acc, if(pi7.hover, fl.engrave, fl.muted)) }
            zone box pi7 { from: nb_x + 14 + 7 * (nb_w - 28) / 12, nb_y + nb_h - 52; size: (nb_w - 28) / 12, 42; cursor: pointer; role: button; label: "Wi-Fi"; show: nd_kind == 13 }
            on press pi7 { emit nd_pg(7) }
            box { from: nb_x + 14 + 8 * (nb_w - 28) / 12, nb_y + nb_h - 52; size: (nb_w - 28) / 12 - 4, 42; corner: 10; color: nd_acc; opacity: if(nd_pgp == 9, 0.18, 0) }
            box { from: nb_x + 14 + 8 * (nb_w - 28) / 12, nb_y + nb_h - 52; size: (nb_w - 28) / 12 - 4, 42; corner: 10; stroke: 1; color: nd_acc; opacity: if(nd_pgp == 9, 0.8, 0) }
            text "󰂯" { at: nb_x + 14 + 8 * (nb_w - 28) / 12 + (nb_w - 28) / 12 / 2, nb_y + nb_h - 31; anchor: center; align: center; size: 17; family: "CaskaydiaCove Nerd Font"; color: if(nd_pgp == 9, nd_acc, if(pi8.hover, fl.engrave, fl.muted)) }
            zone box pi8 { from: nb_x + 14 + 8 * (nb_w - 28) / 12, nb_y + nb_h - 52; size: (nb_w - 28) / 12, 42; cursor: pointer; role: button; label: "Bluetooth"; show: nd_kind == 13 }
            on press pi8 { emit nd_pg(8) }
            box { from: nb_x + 14 + 9 * (nb_w - 28) / 12, nb_y + nb_h - 52; size: (nb_w - 28) / 12 - 4, 42; corner: 10; color: nd_acc; opacity: if(false, 0.18, 0) }
            box { from: nb_x + 14 + 9 * (nb_w - 28) / 12, nb_y + nb_h - 52; size: (nb_w - 28) / 12 - 4, 42; corner: 10; stroke: 1; color: nd_acc; opacity: if(false, 0.8, 0) }
            text "󰒓" { at: nb_x + 14 + 9 * (nb_w - 28) / 12 + (nb_w - 28) / 12 / 2, nb_y + nb_h - 31; anchor: center; align: center; size: 17; family: "CaskaydiaCove Nerd Font"; color: if(false, nd_acc, if(pi9.hover, fl.engrave, fl.muted)) }
            zone box pi9 { from: nb_x + 14 + 9 * (nb_w - 28) / 12, nb_y + nb_h - 52; size: (nb_w - 28) / 12, 42; cursor: pointer; role: button; label: "Settings"; show: nd_kind == 13 }
            on press pi9 { emit nd_pg(9) }
            box { from: nb_x + 14 + 10 * (nb_w - 28) / 12, nb_y + nb_h - 52; size: (nb_w - 28) / 12 - 4, 42; corner: 10; color: nd_acc; opacity: if(false, 0.18, 0) }
            box { from: nb_x + 14 + 10 * (nb_w - 28) / 12, nb_y + nb_h - 52; size: (nb_w - 28) / 12 - 4, 42; corner: 10; stroke: 1; color: nd_acc; opacity: if(false, 0.8, 0) }
            text "󰣇" { at: nb_x + 14 + 10 * (nb_w - 28) / 12 + (nb_w - 28) / 12 / 2, nb_y + nb_h - 31; anchor: center; align: center; size: 17; family: "CaskaydiaCove Nerd Font"; color: if(false, nd_acc, if(pi10.hover, fl.engrave, fl.muted)) }
            zone box pi10 { from: nb_x + 14 + 10 * (nb_w - 28) / 12, nb_y + nb_h - 52; size: (nb_w - 28) / 12, 42; cursor: pointer; role: button; label: "Control Nexus"; show: nd_kind == 13 }
            on press pi10 { emit nd_pg(10) }
            box { from: nb_x + 14 + 11 * (nb_w - 28) / 12, nb_y + nb_h - 52; size: (nb_w - 28) / 12 - 4, 42; corner: 10; color: nd_acc; opacity: if(nd_pgp == 7, 0.18, 0) }
            box { from: nb_x + 14 + 11 * (nb_w - 28) / 12, nb_y + nb_h - 52; size: (nb_w - 28) / 12 - 4, 42; corner: 10; stroke: 1; color: nd_acc; opacity: if(nd_pgp == 7, 0.8, 0) }
            text "󰐥" { at: nb_x + 14 + 11 * (nb_w - 28) / 12 + (nb_w - 28) / 12 / 2, nb_y + nb_h - 31; anchor: center; align: center; size: 17; family: "CaskaydiaCove Nerd Font"; color: if(nd_pgp == 7, nd_acc, if(pi11.hover, fl.engrave, fl.muted)) }
            zone box pi11 { from: nb_x + 14 + 11 * (nb_w - 28) / 12, nb_y + nb_h - 52; size: (nb_w - 28) / 12, 42; cursor: pointer; role: button; label: "Power"; show: nd_kind == 13 }
            on press pi11 { emit nd_pg(11) }
        }
        on submit nd_nq { emit nd_br(90) }
        on change nd_kb while nd_kb and nd_kind == 13 and nd_pgp == 2 { focus nd_nq }
        on change nd_kb while nd_kb and nd_kind == 13 and nd_pgp == 10 { focus nd_kq }
        // notices: a stem drops from the node, and the cards branch from it one after another (each grows out of
        // the stem's foot: it slides down from it, opening as it comes)
        group { show: nd_kind == 2
            line { from: nb_x + nb_w / 2, nb_y + nb_h; to: nb_x + nb_w / 2, nb_y + nb_h + 22 * nd_grow; width: 1.5; color: nd_acc }
            for n in nc {
                let row = n.index
                let g = clamp(nd_grow * nd_gk - row * 0.32 * nd_stg, 0, 1)
                let rise = (n.y - nb_y - nb_h) * (1 - g)
                let ncr = max(3, 12 * nd_rnd)
                group { opacity: g; move: 0, 0 - rise; pivot: n.x + n.w / 2, n.y; scale: 0.7 + 0.3 * g
                    line { from: nb_x + nb_w / 2, n.y - 8; to: n.x + n.w / 2, n.y; width: 1; color: fl.trace_lit; opacity: 0.6 }
                    group { glow: 16, 0.35, #000000
                        box { from: n.x, n.y; size: n.w, n.h; corner: ncr; color: fl.hull; opacity: 0.96 } }
                    box { from: n.x, n.y; size: n.w, n.h; corner: ncr; stroke: 1; color: fl.trace_lit; opacity: 0.6 }
                    box { from: n.x, n.y + 10; size: 3, n.h - 20; corner: 1; color: nd_acc }
                    // its time, draining along its floor (held while the pointer rests on the node)
                    box { from: n.x + 12, n.y + n.h - 3; size: (n.w - 24) * nd_ncs, 1.5; corner: 1; color: nd_acc; opacity: 0.6; show: row == 0 }
                    text n.app { at: n.x + 14, n.y + 16; anchor: left center; size: 9; weight: 700; family: "Share Tech Mono"; color: nd_acc; width: n.w - 60; lines: 1 }
                    text n.title { at: n.x + 14, n.y + 37; anchor: left center; size: 12; family: "Exo 2"; color: fl.engrave; width: if(n.hasact, n.w - 120, n.w - 40); lines: 1 }
                    // opened to be read: the message under the title (D245)
                    text n.body { at: n.x + 14, n.y + 54; anchor: left top; size: 11; family: "Exo 2"; color: fl.muted; width: n.w - 28; lines: 6; show: n.open }
                    group { show: n.hasact
                        box { from: n.x + n.w - 100, n.y + 27; size: 64, 20; corner: 10 * nd_rnd; stroke: 1; color: nd_acc }
                        text n.act { at: n.x + n.w - 68, n.y + 37; anchor: center; align: center; size: 9; family: "Share Tech Mono"; color: nd_acc; width: 58; lines: 1 } }
                    text "×" { at: n.x + n.w - 18, n.y + 16; anchor: center; size: 14; family: "Exo 2"; color: if(ncx.hover, fl.engrave, fl.muted) }
                }
                zone box ncz { from: n.x, n.y; size: n.w, n.h; corner: 12; cursor: pointer; role: button; label: "{n.app}: {n.title}"; show: nd_kind == 2 and g > 0.9 and not nd_studio }
                on press ncz { emit nd_nc(row * 10) }
                let nchv = ncz.hover
                on change nchv { emit nd_ncx(if(nchv, row + 1, 0)) }
                zone box nca { from: n.x + n.w - 100, n.y + 27; size: 64, 20; cursor: pointer; role: button; label: "{n.act}"; show: nd_kind == 2 and n.hasact and g > 0.9 and not nd_studio }
                on press nca { emit nd_nc(row * 10 + 1) }
                zone box ncx { from: n.x + n.w - 30, n.y + 4; size: 24, 24; cursor: pointer; role: button; label: "Dismiss"; show: nd_kind == 2 and g > 0.9 and not nd_studio }
                on press ncx { emit nd_nc(row * 10 + 9) }
            }
            // more than fit: how many wait
            text "+{nd_more, 0} MORE" { at: nb_x + nb_w / 2, nb_y + nb_h + 22 + nd_ncn * 66 + 8; anchor: center; align: center; size: 9; weight: 700; family: "Share Tech Mono"; color: fl.muted; opacity: nd_grow; show: nd_more > 0.5 }
        }
        // the gauge (D265): the volume, the light, a mute, a lock key, the cable — the node becomes its bar
        group { show: nd_kind == 3; opacity: nd_cf
            box { from: nb_x + 3, nb_y + 3; size: max(0, (nb_w - 6) * nd_gv), nb_h - 6; corner: max(0, nb_r - 3); color: if(nd_gwarm, fl.ember, nd_acc); opacity: 0.85 }
            text nd_gicon { at: nb_x + nb_w / 2 - 6 - gmw.width / 2, nb_y + nb_h + 12; anchor: center; align: center; size: 12; family: "CaskaydiaCove Nerd Font"; color: if(nd_gwarm, fl.ember, nd_acc); opacity: nd_grow }
            text nd_vlabel { at: nb_x + nb_w / 2 + 8, nb_y + nb_h + 12; anchor: center; align: center; size: 9; family: "Share Tech Mono"; color: fl.engrave; opacity: nd_grow; measure: gmw } }
        // workspaces: a rail drawn out from the middle, the active one a bead that slides along it — or (D255) the rail
        // sliding in from the side it came from, flipping over, the bead pulsing, or only the number
        group { show: nd_kind == 4 and nd_wss == 4; opacity: nd_cf
            group { move: nd_wsoff * 2 * (1 - nd_grow), 0
                text nd_wsl { at: nb_x + nb_w / 2, nb_y + nb_h / 2; anchor: center; align: center; size: 18; weight: 700; family: "Share Tech Mono"; color: nd_acc } } }
        group { show: nd_kind == 4 and nd_wss != 4; opacity: nd_cf; move: if(nd_wss == 1, nd_wsoff * (1 - nd_grow), 0), 0; pivot: nb_x + nb_w / 2, nb_y + nb_h / 2; scale: 1, if(nd_wss == 2, max(0.05, abs(1 - 2 * (1 - nd_grow))), 1)
            line { from: nb_x + nb_w / 2 - (nb_w / 2 - 18) * nd_grow, nb_y + nb_h / 2; to: nb_x + nb_w / 2 + (nb_w / 2 - 18) * nd_grow, nb_y + nb_h / 2; width: 1; color: fl.trace_lit; opacity: 0.7 }
            for r in rl {
                let rx = nb_x + nb_w / 2 + (r.x - nb_x - nb_w / 2) * nd_grow
                ellipse { at: rx, nb_y + nb_h / 2; radius: if(r.used, 3.5, 2); color: if(r.used, fl.engrave, fl.muted) }
                zone box rz { from: r.x - 20, nb_y; size: 40, nb_h; cursor: pointer; role: button; label: "Workspace {r.n}"; show: nd_kind == 4 and not nd_studio }
                on press rz { emit nd_ws(r.index) }
            }
            group { glow: 12, 0.8 * nd_glow, nd_glc
                ellipse { at: nd_bead, nb_y + nb_h / 2; radius: 10 * nd_grow + if(nd_wss == 3, 9 * (1 - nd_grow), 0); color: nd_acc } }
            ellipse { at: nd_bead, nb_y + nb_h / 2; radius: 10 + 26 * (1 - nd_grow); stroke: 1.5; color: nd_acc; opacity: 0.8 * nd_grow * (1 - nd_grow) * 4; show: nd_wss == 3 }
            for r in rl { text r.n { at: r.x, nb_y + nb_h / 2; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: fl.ground; show: r.on and nd_grow > 0.6 } }
        }
        // the launcher: the node widens into a search line, the results drop out of it one after another
        group { show: nd_kind == 6; opacity: nd_cf
            text "›" { at: nb_x + 18, nb_y + nb_h / 2; anchor: center; size: 18; family: "Exo 2"; color: nd_acc }
            input nd_q { at: nb_x + 34, nb_y + nb_h / 2 - 9; width: nb_w - 50; size: 14; family: "Exo 2"; color: fl.engrave; selection: fl.well; placeholder: "search apps" }
        }
        for r in lr {
            let i = r.index
            let g = clamp(nd_grow * nd_gk - i * 0.18 * nd_stg, 0, 1)
            group { show: nd_kind == 6; opacity: g * nd_cf; move: 0, 0 - (r.y - nb_y - nb_h) * (1 - g)
                box { from: r.x, r.y; size: r.w, r.h; corner: max(2, 10 * nd_rnd); color: if(nd_sel == i, fl.hull_raised, fl.hull); opacity: 0.95 }
                box { from: r.x, r.y; size: 3, r.h; color: nd_acc; show: nd_sel == i }
                image r.icon { at: r.x + 12, r.y + 7; size: 28, 28; show: r.iconed }
                text r.letter { at: r.x + 26, r.y + 21; anchor: center; align: center; size: 13; weight: 700; family: "Share Tech Mono"; color: nd_acc; show: not r.iconed }
                text r.name { at: r.x + 52, r.y + 21; anchor: left center; size: 13; family: "Exo 2"; color: fl.engrave; width: r.w - 140; lines: 1 }
                text r.tag { at: r.x + r.w - 16, r.y + 21; anchor: right center; align: right; size: 8; weight: 700; family: "Share Tech Mono"; color: fl.muted; width: 80; lines: 1 }
            }
            zone box lz { from: r.x, r.y; size: r.w, r.h; cursor: pointer; role: button; label: "Open {r.name}"; show: nd_kind == 6 and not nd_studio }
            on press lz { emit nd_lr(i) }
        }
        on submit nd_q { emit nd_key(13) }
        on change nd_kb while nd_kb and nd_kind == 6 and not nd_studio { focus nd_q }
        // the capsule: while a timer, a focus phase, the stopwatch or a near alarm runs, the seed is a capsule with its
        // value, a line that drains, and a sweep of light (faster, and warm, in the last minute)
        group { show: nd_kind == 0 and nd_cap
            let cw = if(nd_capu, fl.ember, nd_acc)
            group { glow: 10, 0.5 * nd_gw + if(nd_capu, 0.3, 0), if(nd_capu, fl.ember, nd_glc)
                box { from: nb_x, nb_y; size: nb_w, nb_h; corner: nb_r; color: fl.hull; opacity: 0.95 } }
            box { from: nb_x, nb_y; size: nb_w, nb_h; corner: nb_r; stroke: 1; color: cw; opacity: 0.7 }
            group { clip box { from: nb_x, nb_y; size: nb_w, nb_h; corner: nb_r }
                box { from: nb_x - 24 + fract(nd_swp / 360) * (nb_w + 24), nb_y; size: 24, nb_h; color: cw; opacity: 0.18 }
                box { from: nb_x + 8, nb_y + nb_h - 3; size: (nb_w - 16) * nd_capf, 1.5; color: cw; opacity: 0.9 } }
            text nd_capm { at: nb_x + 10, nb_y + nb_h / 2; anchor: left center; size: 8; weight: 700; family: "Share Tech Mono"; color: fl.muted; opacity: nd_cf }
            text nd_capt { at: nb_x + nb_w - 10, nb_y + nb_h / 2; anchor: right center; align: right; size: 11; weight: 700; family: "Share Tech Mono"; color: if(nd_capu, fl.ember, fl.engrave); opacity: nd_cf }
        }
        // the panel: the mode on stage, its readout big, its progress as a strip of cells, its controls; the other
        // three on the rail along the floor, still counting
        group { show: nd_kind == 8; opacity: nd_cf
            clip box { from: nb_x, nb_y; size: nb_w, nb_h; corner: nb_r }
            text "TIMER" { at: nb_x + 20, nb_y + 20; anchor: left center; size: 9; weight: 700; family: "Share Tech Mono"; color: if(nd_tmm == 0, nd_acc, if(tmz0.hover, fl.engrave, fl.muted)) }
            box { from: nb_x + 20, nb_y + 29; size: 24, 1.5; color: nd_acc; show: nd_tmm == 0 }
            zone box tmz0 { from: nb_x + 20 - 6, nb_y + 8; size: 92, 26; cursor: pointer; role: tab; label: "Timer"; selected: nd_tmm == 0; show: nd_kind == 8 }
            on press tmz0 { emit nd_tm(0) }
            text "STOPWATCH" { at: nb_x + 116, nb_y + 20; anchor: left center; size: 9; weight: 700; family: "Share Tech Mono"; color: if(nd_tmm == 1, nd_acc, if(tmz1.hover, fl.engrave, fl.muted)) }
            box { from: nb_x + 116, nb_y + 29; size: 24, 1.5; color: nd_acc; show: nd_tmm == 1 }
            zone box tmz1 { from: nb_x + 116 - 6, nb_y + 8; size: 92, 26; cursor: pointer; role: tab; label: "Stopwatch"; selected: nd_tmm == 1; show: nd_kind == 8 }
            on press tmz1 { emit nd_tm(1) }
            text "FOCUS" { at: nb_x + 212, nb_y + 20; anchor: left center; size: 9; weight: 700; family: "Share Tech Mono"; color: if(nd_tmm == 2, nd_acc, if(tmz2.hover, fl.engrave, fl.muted)) }
            box { from: nb_x + 212, nb_y + 29; size: 24, 1.5; color: nd_acc; show: nd_tmm == 2 }
            zone box tmz2 { from: nb_x + 212 - 6, nb_y + 8; size: 92, 26; cursor: pointer; role: tab; label: "Focus"; selected: nd_tmm == 2; show: nd_kind == 8 }
            on press tmz2 { emit nd_tm(2) }
            text "ALARM" { at: nb_x + 308, nb_y + 20; anchor: left center; size: 9; weight: 700; family: "Share Tech Mono"; color: if(nd_tmm == 3, nd_acc, if(tmz3.hover, fl.engrave, fl.muted)) }
            box { from: nb_x + 308, nb_y + 29; size: 24, 1.5; color: nd_acc; show: nd_tmm == 3 }
            zone box tmz3 { from: nb_x + 308 - 6, nb_y + 8; size: 92, 26; cursor: pointer; role: tab; label: "Alarm"; selected: nd_tmm == 3; show: nd_kind == 8 }
            on press tmz3 { emit nd_tm(3) }
            // the readout: a 5×7 matrix of mooi's own, every cell there and dim, the lit ones in its colour
            repeat gc in 0..48 { repeat gr in 0..7 { box { from: nb_x + 20 + gc * 6, nb_y + 44 + gr * 6; size: 5, 5; corner: 1; color: fl.trace_dim; opacity: 0.35; show: gc < nd_pxw } } }
            group { glow: 8, 0.5 * nd_gw, nd_glc
                for q in px { box { from: nb_x + 20 + q.x * 6, nb_y + 44 + q.y * 6; size: 5, 5; corner: 1; color: nd_acc } } }
            text nd_tms { at: nb_x + 22, nb_y + 94; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.muted; width: 300; lines: 1 }
            repeat cl in 0..30 { box { from: nb_x + 20 + cl * 10, nb_y + 108; size: 7, 5; corner: 1; color: if(cl < nd_tmp * 30, nd_acc, fl.trace_dim); opacity: if(cl < nd_tmp * 30, 0.9, 0.6) } }
            box { from: nb_x + nb_w - 214, nb_y + 46; size: 94, 30; corner: 15 * max(0.3, nd_rnd); color: nd_acc; opacity: if(true, 0.9, if(tmb10.hover, 0.18, 0)) }
            box { from: nb_x + nb_w - 214, nb_y + 46; size: 94, 30; corner: 15 * max(0.3, nd_rnd); stroke: 1; color: if(true, nd_acc, fl.trace_lit) }
            text nd_tmgl { at: nb_x + nb_w - 214 + 47, nb_y + 61; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(true, fl.ground, fl.engrave) }
            zone box tmb10 { from: nb_x + nb_w - 214, nb_y + 46; size: 94, 30; cursor: pointer; role: button; label: "{nd_tmgl}"; show: nd_kind == 8 }
            on press tmb10 { emit nd_tm(10) }
            box { from: nb_x + nb_w - 112, nb_y + 46; size: 94, 30; corner: 15 * max(0.3, nd_rnd); color: nd_acc; opacity: if(false, 0.9, if(tmb11.hover, 0.18, 0)) }
            box { from: nb_x + nb_w - 112, nb_y + 46; size: 94, 30; corner: 15 * max(0.3, nd_rnd); stroke: 1; color: if(false, nd_acc, fl.trace_lit) }
            text nd_tm2l { at: nb_x + nb_w - 112 + 47, nb_y + 61; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(false, fl.ground, fl.engrave) }
            zone box tmb11 { from: nb_x + nb_w - 112, nb_y + 46; size: 94, 30; cursor: pointer; role: button; label: "{nd_tm2l}"; show: nd_kind == 8 }
            on press tmb11 { emit nd_tm(11) }
            for k in tc {
                let kx = nb_x + nb_w - 214 + k.index * 50
                box { from: kx, nb_y + 86; size: 44, 24; corner: 12 * max(0.3, nd_rnd); stroke: 1; color: if(tcz.hover, nd_acc, fl.trace_lit) }
                text k.label { at: kx + 22, nb_y + 98; anchor: center; align: center; size: 9; weight: 700; family: "Share Tech Mono"; color: fl.engrave; width: 42; lines: 1 }
                zone box tcz { from: kx, nb_y + 86; size: 44, 24; cursor: pointer; role: button; label: "{k.label}"; show: nd_kind == 8 }
                on press tcz { emit nd_tm(k.code) }
            }
            line { from: nb_x + 16, nb_y + nb_h - 36; to: nb_x + nb_w - 16, nb_y + nb_h - 36; width: 1; color: fl.trace_dim }
            for r in tr {
                let rx = nb_x + 20 + r.index * ((nb_w - 40) / 3)
                ellipse { at: rx + 3, nb_y + nb_h - 18; radius: 2.5; color: if(r.on, nd_acc, fl.trace_dim) }
                text r.label { at: rx + 12, nb_y + nb_h - 18; anchor: left center; size: 8; weight: 700; family: "Share Tech Mono"; color: fl.muted }
                text r.value { at: rx + 90, nb_y + nb_h - 18; anchor: left center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(r.on, fl.engrave, fl.muted) }
                zone box trz { from: rx, nb_y + nb_h - 30; size: (nb_w - 40) / 3 - 8, 24; cursor: pointer; role: button; label: "{r.label} {r.value}"; show: nd_kind == 8 }
                on press trz { emit nd_tm(r.m) }
            }
        }
        // something finished: the node becomes a card that pulses until it is answered (a click on it, Esc, Space,
        // Return, or OK) — never by the pointer merely resting there, never by folding away
        group { show: nd_kind == 9
            group { glow: 20, 0.45 + 0.35 * sin(nd_dph), fl.ember
                box { from: nb_x, nb_y; size: nb_w, nb_h; corner: nb_r; color: fl.hull; opacity: 0.97 } }
            box { from: nb_x, nb_y; size: nb_w, nb_h; corner: nb_r; stroke: 1.5; color: fl.ember; opacity: 0.6 + 0.3 * sin(nd_dph) }
            group { opacity: nd_cf
                text nd_dnt { at: nb_x + 22, nb_y + 28; anchor: left center; size: 15; weight: 700; family: "Exo 2"; color: fl.engrave; width: nb_w - 140; lines: 1 }
                text nd_dnd { at: nb_x + 22, nb_y + 50; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.muted; width: nb_w - 140; lines: 1 }
                box { from: nb_x + nb_w - 92, nb_y + nb_h / 2 - 15; size: 72, 30; corner: 15 * max(0.3, nd_rnd); color: fl.ember; opacity: 0.9 }
                text "OK" { at: nb_x + nb_w - 56, nb_y + nb_h / 2; anchor: center; align: center; size: 11; weight: 700; family: "Share Tech Mono"; color: fl.ground } }
            zone box dnz { from: nb_x, nb_y; size: nb_w, nb_h; corner: nb_r; cursor: pointer; role: button; label: "{nd_dnt}: OK"; show: nd_kind == 9 }
            on press dnz { emit nd_dn }
        }
        // the player: the cover at the left, the song over its foot and beside it, the music a wave through
        // the middle, where in it, its transport as icons, and three meters on the right to drag
        group { show: nd_kind == 11; opacity: nd_cf
            clip box { from: nb_x, nb_y; size: nb_w, nb_h; corner: nb_r }
            let mx = nb_x + 172
            let mw = nb_w - 172 - 176
            // the cover, large, with the song and its source over the foot
            group { clip box { from: nb_x + 16, nb_y + 16; size: 140, 140; corner: if(nd_cov == 1, 70, max(3, 14 * nd_rnd)) }
                box { from: nb_x + 16, nb_y + 16; size: 140, 140; color: fl.well }
                image nd_cover { at: nb_x + 16, nb_y + 16; size: 140, 140; fit: cover; show: nd_arted } }
            box { from: nb_x + 16, nb_y + 120; size: 140, 36; corner: 10; color: fl.hull; opacity: 0.9 }
            text nd_title { at: nb_x + 24, nb_y + 131; anchor: left center; size: 10; weight: 700; family: "Exo 2"; color: fl.engrave; width: 124; lines: 1 }
            text nd_artist { at: nb_x + 24, nb_y + 145; anchor: left center; size: 8; family: "Share Tech Mono"; color: fl.muted; width: 124; lines: 1 }
            // the song beside it
            text nd_title { at: mx, nb_y + 30; anchor: left center; size: 16; weight: 700; family: "Exo 2"; color: fl.engrave; width: mw - 58; lines: 1 }
            text nd_artist { at: mx, nb_y + 50; anchor: left center; size: 11; family: "Exo 2"; color: fl.muted; width: mw - 58; lines: 1 }
            // the page's switch
            text if(nd_mix, "PLAYER", "MIX") { at: mx + mw, nb_y + 28; anchor: right center; align: right; size: 9; weight: 700; family: "Share Tech Mono"; color: if(pmxz.hover or nd_mix, nd_acc, fl.muted) }
            zone box pmxz { from: mx + mw - 52, nb_y + 16; size: 54, 22; cursor: pointer; role: toggle; label: "Each app's volume"; checked: nd_mix; show: nd_kind == 11 }
            on press pmxz { emit nd_pl(7) }
            // the music, mirrored as a wave: the low bands meet in the middle
            group { show: not nd_mix and not nd_lyon
                box { from: mx + 0 * mw / 32 + 1, nb_y + 108 - nd_sp0 * 30; size: mw / 32 - 2, nd_sp0 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.3 + 0.55 * nd_sp0 }
                box { from: mx + 0 * mw / 32 + 1, nb_y + 109; size: mw / 32 - 2, nd_sp0 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.18 + 0.4 * nd_sp0 }
                box { from: mx + 1 * mw / 32 + 1, nb_y + 108 - nd_sp1 * 30; size: mw / 32 - 2, nd_sp1 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.3 + 0.55 * nd_sp1 }
                box { from: mx + 1 * mw / 32 + 1, nb_y + 109; size: mw / 32 - 2, nd_sp1 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.18 + 0.4 * nd_sp1 }
                box { from: mx + 2 * mw / 32 + 1, nb_y + 108 - nd_sp2 * 30; size: mw / 32 - 2, nd_sp2 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.3 + 0.55 * nd_sp2 }
                box { from: mx + 2 * mw / 32 + 1, nb_y + 109; size: mw / 32 - 2, nd_sp2 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.18 + 0.4 * nd_sp2 }
                box { from: mx + 3 * mw / 32 + 1, nb_y + 108 - nd_sp3 * 30; size: mw / 32 - 2, nd_sp3 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.3 + 0.55 * nd_sp3 }
                box { from: mx + 3 * mw / 32 + 1, nb_y + 109; size: mw / 32 - 2, nd_sp3 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.18 + 0.4 * nd_sp3 }
                box { from: mx + 4 * mw / 32 + 1, nb_y + 108 - nd_sp4 * 30; size: mw / 32 - 2, nd_sp4 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.3 + 0.55 * nd_sp4 }
                box { from: mx + 4 * mw / 32 + 1, nb_y + 109; size: mw / 32 - 2, nd_sp4 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.18 + 0.4 * nd_sp4 }
                box { from: mx + 5 * mw / 32 + 1, nb_y + 108 - nd_sp5 * 30; size: mw / 32 - 2, nd_sp5 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.3 + 0.55 * nd_sp5 }
                box { from: mx + 5 * mw / 32 + 1, nb_y + 109; size: mw / 32 - 2, nd_sp5 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.18 + 0.4 * nd_sp5 }
                box { from: mx + 6 * mw / 32 + 1, nb_y + 108 - nd_sp6 * 30; size: mw / 32 - 2, nd_sp6 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.3 + 0.55 * nd_sp6 }
                box { from: mx + 6 * mw / 32 + 1, nb_y + 109; size: mw / 32 - 2, nd_sp6 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.18 + 0.4 * nd_sp6 }
                box { from: mx + 7 * mw / 32 + 1, nb_y + 108 - nd_sp7 * 30; size: mw / 32 - 2, nd_sp7 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.3 + 0.55 * nd_sp7 }
                box { from: mx + 7 * mw / 32 + 1, nb_y + 109; size: mw / 32 - 2, nd_sp7 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.18 + 0.4 * nd_sp7 }
                box { from: mx + 8 * mw / 32 + 1, nb_y + 108 - nd_sp8 * 30; size: mw / 32 - 2, nd_sp8 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.3 + 0.55 * nd_sp8 }
                box { from: mx + 8 * mw / 32 + 1, nb_y + 109; size: mw / 32 - 2, nd_sp8 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.18 + 0.4 * nd_sp8 }
                box { from: mx + 9 * mw / 32 + 1, nb_y + 108 - nd_sp9 * 30; size: mw / 32 - 2, nd_sp9 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.3 + 0.55 * nd_sp9 }
                box { from: mx + 9 * mw / 32 + 1, nb_y + 109; size: mw / 32 - 2, nd_sp9 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.18 + 0.4 * nd_sp9 }
                box { from: mx + 10 * mw / 32 + 1, nb_y + 108 - nd_sp10 * 30; size: mw / 32 - 2, nd_sp10 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.3 + 0.55 * nd_sp10 }
                box { from: mx + 10 * mw / 32 + 1, nb_y + 109; size: mw / 32 - 2, nd_sp10 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.18 + 0.4 * nd_sp10 }
                box { from: mx + 11 * mw / 32 + 1, nb_y + 108 - nd_sp11 * 30; size: mw / 32 - 2, nd_sp11 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.3 + 0.55 * nd_sp11 }
                box { from: mx + 11 * mw / 32 + 1, nb_y + 109; size: mw / 32 - 2, nd_sp11 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.18 + 0.4 * nd_sp11 }
                box { from: mx + 12 * mw / 32 + 1, nb_y + 108 - nd_sp12 * 30; size: mw / 32 - 2, nd_sp12 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.3 + 0.55 * nd_sp12 }
                box { from: mx + 12 * mw / 32 + 1, nb_y + 109; size: mw / 32 - 2, nd_sp12 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.18 + 0.4 * nd_sp12 }
                box { from: mx + 13 * mw / 32 + 1, nb_y + 108 - nd_sp13 * 30; size: mw / 32 - 2, nd_sp13 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.3 + 0.55 * nd_sp13 }
                box { from: mx + 13 * mw / 32 + 1, nb_y + 109; size: mw / 32 - 2, nd_sp13 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.18 + 0.4 * nd_sp13 }
                box { from: mx + 14 * mw / 32 + 1, nb_y + 108 - nd_sp14 * 30; size: mw / 32 - 2, nd_sp14 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.3 + 0.55 * nd_sp14 }
                box { from: mx + 14 * mw / 32 + 1, nb_y + 109; size: mw / 32 - 2, nd_sp14 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.18 + 0.4 * nd_sp14 }
                box { from: mx + 15 * mw / 32 + 1, nb_y + 108 - nd_sp15 * 30; size: mw / 32 - 2, nd_sp15 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.3 + 0.55 * nd_sp15 }
                box { from: mx + 15 * mw / 32 + 1, nb_y + 109; size: mw / 32 - 2, nd_sp15 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.18 + 0.4 * nd_sp15 }
                box { from: mx + 16 * mw / 32 + 1, nb_y + 108 - nd_sp16 * 30; size: mw / 32 - 2, nd_sp16 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.3 + 0.55 * nd_sp16 }
                box { from: mx + 16 * mw / 32 + 1, nb_y + 109; size: mw / 32 - 2, nd_sp16 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.18 + 0.4 * nd_sp16 }
                box { from: mx + 17 * mw / 32 + 1, nb_y + 108 - nd_sp17 * 30; size: mw / 32 - 2, nd_sp17 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.3 + 0.55 * nd_sp17 }
                box { from: mx + 17 * mw / 32 + 1, nb_y + 109; size: mw / 32 - 2, nd_sp17 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.18 + 0.4 * nd_sp17 }
                box { from: mx + 18 * mw / 32 + 1, nb_y + 108 - nd_sp18 * 30; size: mw / 32 - 2, nd_sp18 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.3 + 0.55 * nd_sp18 }
                box { from: mx + 18 * mw / 32 + 1, nb_y + 109; size: mw / 32 - 2, nd_sp18 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.18 + 0.4 * nd_sp18 }
                box { from: mx + 19 * mw / 32 + 1, nb_y + 108 - nd_sp19 * 30; size: mw / 32 - 2, nd_sp19 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.3 + 0.55 * nd_sp19 }
                box { from: mx + 19 * mw / 32 + 1, nb_y + 109; size: mw / 32 - 2, nd_sp19 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.18 + 0.4 * nd_sp19 }
                box { from: mx + 20 * mw / 32 + 1, nb_y + 108 - nd_sp20 * 30; size: mw / 32 - 2, nd_sp20 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.3 + 0.55 * nd_sp20 }
                box { from: mx + 20 * mw / 32 + 1, nb_y + 109; size: mw / 32 - 2, nd_sp20 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.18 + 0.4 * nd_sp20 }
                box { from: mx + 21 * mw / 32 + 1, nb_y + 108 - nd_sp21 * 30; size: mw / 32 - 2, nd_sp21 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.3 + 0.55 * nd_sp21 }
                box { from: mx + 21 * mw / 32 + 1, nb_y + 109; size: mw / 32 - 2, nd_sp21 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.18 + 0.4 * nd_sp21 }
                box { from: mx + 22 * mw / 32 + 1, nb_y + 108 - nd_sp22 * 30; size: mw / 32 - 2, nd_sp22 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.3 + 0.55 * nd_sp22 }
                box { from: mx + 22 * mw / 32 + 1, nb_y + 109; size: mw / 32 - 2, nd_sp22 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.18 + 0.4 * nd_sp22 }
                box { from: mx + 23 * mw / 32 + 1, nb_y + 108 - nd_sp23 * 30; size: mw / 32 - 2, nd_sp23 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.3 + 0.55 * nd_sp23 }
                box { from: mx + 23 * mw / 32 + 1, nb_y + 109; size: mw / 32 - 2, nd_sp23 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.18 + 0.4 * nd_sp23 }
                box { from: mx + 24 * mw / 32 + 1, nb_y + 108 - nd_sp24 * 30; size: mw / 32 - 2, nd_sp24 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.3 + 0.55 * nd_sp24 }
                box { from: mx + 24 * mw / 32 + 1, nb_y + 109; size: mw / 32 - 2, nd_sp24 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.18 + 0.4 * nd_sp24 }
                box { from: mx + 25 * mw / 32 + 1, nb_y + 108 - nd_sp25 * 30; size: mw / 32 - 2, nd_sp25 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.3 + 0.55 * nd_sp25 }
                box { from: mx + 25 * mw / 32 + 1, nb_y + 109; size: mw / 32 - 2, nd_sp25 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.18 + 0.4 * nd_sp25 }
                box { from: mx + 26 * mw / 32 + 1, nb_y + 108 - nd_sp26 * 30; size: mw / 32 - 2, nd_sp26 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.3 + 0.55 * nd_sp26 }
                box { from: mx + 26 * mw / 32 + 1, nb_y + 109; size: mw / 32 - 2, nd_sp26 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.18 + 0.4 * nd_sp26 }
                box { from: mx + 27 * mw / 32 + 1, nb_y + 108 - nd_sp27 * 30; size: mw / 32 - 2, nd_sp27 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.3 + 0.55 * nd_sp27 }
                box { from: mx + 27 * mw / 32 + 1, nb_y + 109; size: mw / 32 - 2, nd_sp27 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.18 + 0.4 * nd_sp27 }
                box { from: mx + 28 * mw / 32 + 1, nb_y + 108 - nd_sp28 * 30; size: mw / 32 - 2, nd_sp28 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.3 + 0.55 * nd_sp28 }
                box { from: mx + 28 * mw / 32 + 1, nb_y + 109; size: mw / 32 - 2, nd_sp28 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.18 + 0.4 * nd_sp28 }
                box { from: mx + 29 * mw / 32 + 1, nb_y + 108 - nd_sp29 * 30; size: mw / 32 - 2, nd_sp29 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.3 + 0.55 * nd_sp29 }
                box { from: mx + 29 * mw / 32 + 1, nb_y + 109; size: mw / 32 - 2, nd_sp29 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.18 + 0.4 * nd_sp29 }
                box { from: mx + 30 * mw / 32 + 1, nb_y + 108 - nd_sp30 * 30; size: mw / 32 - 2, nd_sp30 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.3 + 0.55 * nd_sp30 }
                box { from: mx + 30 * mw / 32 + 1, nb_y + 109; size: mw / 32 - 2, nd_sp30 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.18 + 0.4 * nd_sp30 }
                box { from: mx + 31 * mw / 32 + 1, nb_y + 108 - nd_sp31 * 30; size: mw / 32 - 2, nd_sp31 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.3 + 0.55 * nd_sp31 }
                box { from: mx + 31 * mw / 32 + 1, nb_y + 109; size: mw / 32 - 2, nd_sp31 * 30 + 1; corner: 1; color: nd_acc; opacity: 0.18 + 0.4 * nd_sp31 }
            }
            // the words, in time
            group { show: nd_lyon
                text nd_lyc { at: mx, nb_y + 100; anchor: left center; size: 13; weight: 600; family: "Exo 2"; color: nd_acc; width: mw; lines: 1 }
                text nd_lyn { at: mx, nb_y + 120; anchor: left center; size: 10; family: "Exo 2"; color: fl.muted; width: mw; lines: 1 } }
            // where in the song, and its two times
            group { show: not nd_mix
                box { from: mx, nb_y + 154; size: mw, 3; corner: 1.5; color: fl.trace_dim }
                box { from: mx, nb_y + 154; size: mw * nd_prog, 3; corner: 1.5; color: nd_acc }
                ellipse { at: mx + mw * nd_prog, nb_y + 155.5; radius: if(pkz.hover, 6, 4); color: nd_acc }
                text nd_pos { at: mx, nb_y + 170; anchor: left center; size: 9; family: "Share Tech Mono"; color: fl.muted }
                text nd_len { at: mx + mw, nb_y + 170; anchor: right center; align: right; size: 9; family: "Share Tech Mono"; color: fl.muted }
                zone box pkz { from: mx - 6, nb_y + 144; size: mw + 12, 22; cursor: pointer; role: slider; label: "Where in the song"; value: "{nd_pos}"; show: nd_kind == 11 and not nd_mix }
                on press pkz { emit nd_seek(round(clamp((pointer.x - mx) / mw, 0, 1) * 1000)) }
                on drag pkz { emit nd_seek(round(clamp((pointer.x - mx) / mw, 0, 1) * 1000)) }
            }
            group { show: not nd_mix
                text "󰒟" { at: mx + 24 + (mw - 48) * 0.0000, nb_y + 202; anchor: center; align: center; size: 15; family: "CaskaydiaCove Nerd Font"; color: if(nd_shuf, nd_acc, if(pbz1.hover, fl.engrave, fl.muted)) }
                box { from: mx + 24 + (mw - 48) * 0.0000 - 15, nb_y + 192; size: 30, 2; corner: 1; color: nd_acc; opacity: if(nd_shuf, 0.85, 0); show: nd_shuf }
                zone box pbz1 { from: mx + 24 + (mw - 48) * 0.0000 - 16, nb_y + 184; size: 32, 32; corner: 16; cursor: pointer; role: button; label: "Shuffle"; show: nd_kind == 11 and not nd_mix }
                on press pbz1 { emit nd_pl(1) }
                text "󰒮" { at: mx + 24 + (mw - 48) * 0.2500, nb_y + 202; anchor: center; align: center; size: 15; family: "CaskaydiaCove Nerd Font"; color: if(false, nd_acc, if(pbz2.hover, fl.engrave, fl.muted)) }
                box { from: mx + 24 + (mw - 48) * 0.2500 - 15, nb_y + 192; size: 30, 2; corner: 1; color: nd_acc; opacity: if(false, 0.85, 0); show: false }
                zone box pbz2 { from: mx + 24 + (mw - 48) * 0.2500 - 16, nb_y + 184; size: 32, 32; corner: 16; cursor: pointer; role: button; label: "Back"; show: nd_kind == 11 and not nd_mix }
                on press pbz2 { emit nd_pl(2) }
                ellipse { at: mx + 24 + (mw - 48) * 0.5000, nb_y + 202; radius: 19; color: nd_acc; opacity: 0.92; show: not nd_playing }
                text "󰐊" { at: mx + 24 + (mw - 48) * 0.5000, nb_y + 202; anchor: center; align: center; size: 18; family: "CaskaydiaCove Nerd Font"; color: fl.ground; show: not nd_playing }
                text "󰏤" { at: mx + 24 + (mw - 48) * 0.5000, nb_y + 202; anchor: center; align: center; size: 18; family: "CaskaydiaCove Nerd Font"; color: fl.ground; show: nd_playing }
                zone box pbz3 { from: mx + 24 + (mw - 48) * 0.5000 - 16, nb_y + 184; size: 32, 32; corner: 16; cursor: pointer; role: button; label: "Play or pause"; show: nd_kind == 11 and not nd_mix }
                on press pbz3 { emit nd_pl(3) }
                text "󰒭" { at: mx + 24 + (mw - 48) * 0.7500, nb_y + 202; anchor: center; align: center; size: 15; family: "CaskaydiaCove Nerd Font"; color: if(false, nd_acc, if(pbz4.hover, fl.engrave, fl.muted)) }
                box { from: mx + 24 + (mw - 48) * 0.7500 - 15, nb_y + 192; size: 30, 2; corner: 1; color: nd_acc; opacity: if(false, 0.85, 0); show: false }
                zone box pbz4 { from: mx + 24 + (mw - 48) * 0.7500 - 16, nb_y + 184; size: 32, 32; corner: 16; cursor: pointer; role: button; label: "Next"; show: nd_kind == 11 and not nd_mix }
                on press pbz4 { emit nd_pl(4) }
                text "󰑖" { at: mx + 24 + (mw - 48) * 1.0000, nb_y + 202; anchor: center; align: center; size: 15; family: "CaskaydiaCove Nerd Font"; color: if(nd_loop > 0, nd_acc, if(pbz5.hover, fl.engrave, fl.muted)) }
                box { from: mx + 24 + (mw - 48) * 1.0000 - 15, nb_y + 192; size: 30, 2; corner: 1; color: nd_acc; opacity: if(nd_loop > 0, 0.85, 0); show: nd_loop > 0 }
                zone box pbz5 { from: mx + 24 + (mw - 48) * 1.0000 - 16, nb_y + 184; size: 32, 32; corner: 16; cursor: pointer; role: button; label: "Repeat"; show: nd_kind == 11 and not nd_mix }
                on press pbz5 { emit nd_pl(5) }
                text "1" { at: mx + 24 + (mw - 48) * 1, nb_y + 220; anchor: center; align: center; size: 8; weight: 700; family: "Share Tech Mono"; color: nd_acc; show: nd_loop == 2 }
            }
            group { show: nd_mix
                for a in mx {
                    let my = nb_y + 84 + a.index * 26
                    text a.name { at: mx, my + 9; anchor: left center; size: 11; family: "Exo 2"; color: if(a.muted, fl.muted, fl.engrave); width: 96; lines: 1 }
                    box { from: mx + 104, my + 7; size: mw - 160, 4; corner: 2; color: fl.trace_dim }
                    box { from: mx + 104, my + 7; size: (mw - 160) * a.vol, 4; corner: 2; color: if(a.muted, fl.trace_lit, nd_acc) }
                    zone box mxz { from: mx + 98, my - 2; size: mw - 148, 22; cursor: ew_resize; role: slider; label: "{a.name}"; value: a.vol; show: nd_kind == 11 and nd_mix }
                    on press mxz { emit nd_mx(a.index * 2000 + round(clamp((pointer.x - mx - 104) / (mw - 160), 0, 1) * 1000)) }
                    on drag mxz { emit nd_mx(a.index * 2000 + round(clamp((pointer.x - mx - 104) / (mw - 160), 0, 1) * 1000)) }
                    text if(a.muted, "MUTED", "MUTE") { at: mx + mw, my + 9; anchor: right center; align: right; size: 8; weight: 700; family: "Share Tech Mono"; color: if(a.muted, fl.ember, if(mxmz.hover, fl.engrave, fl.muted)) }
                    zone box mxmz { from: mx + mw - 42, my - 2; size: 44, 22; cursor: pointer; role: toggle; label: "Mute {a.name}"; checked: a.muted; show: nd_kind == 11 and nd_mix }
                    on press mxmz { emit nd_mxm(a.index) }
                }
                text "NOTHING ELSE PLAYS" { at: mx, nb_y + 94; anchor: left center; size: 9; family: "Share Tech Mono"; color: fl.muted; show: mx.count == 0 }
            }
            box { from: nb_x + nb_w - 160, nb_y + 14; size: 146, nb_h - 28; corner: 16 * max(0.3, nd_rnd); color: fl.well }
            box { from: nb_x + nb_w - 160, nb_y + 14; size: 146, nb_h - 28; corner: 16 * max(0.3, nd_rnd); stroke: 1; color: fl.trace_dim }
            text "LEVELS" { at: nb_x + nb_w - 87, nb_y + 30; anchor: center; align: center; size: 8; weight: 700; family: "Share Tech Mono"; color: fl.muted }
            group { show: true
                repeat sg0 in 0..10 {
                    box { from: nb_x + nb_w - 146 + 0 * 42, nb_y + 154 - sg0 * 11; size: 28, 8; corner: 2 * max(0.3, nd_rnd); color: if(sg0 < round(nd_vol * 10), if(0 == 2 and nd_micm, fl.trace_lit, nd_acc), fl.trace_dim); opacity: if(sg0 < round(nd_vol * 10), 0.95, 0.45) }
                }
                text "󰕾" { at: nb_x + nb_w - 146 + 0 * 42 + 14, nb_y + 188; anchor: center; align: center; size: 15; family: "CaskaydiaCove Nerd Font"; color: if(0 == 2 and nd_micm, fl.ember, fl.muted) }
                text "VOL" { at: nb_x + nb_w - 146 + 0 * 42 + 14, nb_y + 204; anchor: center; align: center; size: 7; weight: 700; family: "Share Tech Mono"; color: fl.muted }
                zone box pmz0 { from: nb_x + nb_w - 146 + 0 * 42 - 4, nb_y + 38; size: 36, 134; cursor: ns_resize; role: slider; label: "Vol"; value: nd_vol; show: nd_kind == 11 }
                on press pmz0 { emit nd_mt(0 * 2000 + round(clamp((nb_y + 166 - pointer.y) / 116, 0, 1) * 1000)) }
                on drag pmz0 { emit nd_mt(0 * 2000 + round(clamp((nb_y + 166 - pointer.y) / 116, 0, 1) * 1000)) }
            }
            group { show: nd_hasbri
                repeat sg1 in 0..10 {
                    box { from: nb_x + nb_w - 146 + 1 * 42, nb_y + 154 - sg1 * 11; size: 28, 8; corner: 2 * max(0.3, nd_rnd); color: if(sg1 < round(nd_bri * 10), if(1 == 2 and nd_micm, fl.trace_lit, nd_acc), fl.trace_dim); opacity: if(sg1 < round(nd_bri * 10), 0.95, 0.45) }
                }
                text "󰃟" { at: nb_x + nb_w - 146 + 1 * 42 + 14, nb_y + 188; anchor: center; align: center; size: 15; family: "CaskaydiaCove Nerd Font"; color: if(1 == 2 and nd_micm, fl.ember, fl.muted) }
                text "LIGHT" { at: nb_x + nb_w - 146 + 1 * 42 + 14, nb_y + 204; anchor: center; align: center; size: 7; weight: 700; family: "Share Tech Mono"; color: fl.muted }
                zone box pmz1 { from: nb_x + nb_w - 146 + 1 * 42 - 4, nb_y + 38; size: 36, 134; cursor: ns_resize; role: slider; label: "Light"; value: nd_bri; show: nd_kind == 11 }
                on press pmz1 { emit nd_mt(1 * 2000 + round(clamp((nb_y + 166 - pointer.y) / 116, 0, 1) * 1000)) }
                on drag pmz1 { emit nd_mt(1 * 2000 + round(clamp((nb_y + 166 - pointer.y) / 116, 0, 1) * 1000)) }
            }
            group { show: true
                repeat sg2 in 0..10 {
                    box { from: nb_x + nb_w - 146 + 2 * 42, nb_y + 154 - sg2 * 11; size: 28, 8; corner: 2 * max(0.3, nd_rnd); color: if(sg2 < round(nd_mic * 10), if(2 == 2 and nd_micm, fl.trace_lit, nd_acc), fl.trace_dim); opacity: if(sg2 < round(nd_mic * 10), 0.95, 0.45) }
                }
                text "󰍬" { at: nb_x + nb_w - 146 + 2 * 42 + 14, nb_y + 188; anchor: center; align: center; size: 15; family: "CaskaydiaCove Nerd Font"; color: if(2 == 2 and nd_micm, fl.ember, fl.muted) }
                text "MIC" { at: nb_x + nb_w - 146 + 2 * 42 + 14, nb_y + 204; anchor: center; align: center; size: 7; weight: 700; family: "Share Tech Mono"; color: fl.muted }
                zone box pmz2 { from: nb_x + nb_w - 146 + 2 * 42 - 4, nb_y + 38; size: 36, 134; cursor: ns_resize; role: slider; label: "Mic"; value: nd_mic; show: nd_kind == 11 }
                on press pmz2 { emit nd_mt(2 * 2000 + round(clamp((nb_y + 166 - pointer.y) / 116, 0, 1) * 1000)) }
                on drag pmz2 { emit nd_mt(2 * 2000 + round(clamp((nb_y + 166 - pointer.y) / 116, 0, 1) * 1000)) }
                zone box pmmz { from: nb_x + nb_w - 146 + 2 * 42 - 4, nb_y + 178; size: 36, 34; cursor: pointer; role: toggle; label: "Mute the microphone"; checked: nd_micm; show: nd_kind == 11 }
                on press pmmz { emit nd_pl(6) }
            }
        }
        // privacy: the microphone or the camera, the moment it starts or stops, and who has it
        group { show: nd_kind == 10; opacity: nd_cf
            group { glow: 10, if(nd_pvon, 0.8, 0.2), fl.ember
                ellipse { at: nb_x + 22, nb_y + nb_h / 2; radius: 5; color: if(nd_pvon, fl.ember, fl.trace_lit) } }
            text nd_pvt { at: nb_x + 38, nb_y + nb_h / 2 - 7; anchor: left center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(nd_pvon, fl.ember, fl.engrave) }
            text nd_pvd { at: nb_x + 38, nb_y + nb_h / 2 + 8; anchor: left center; size: 10; family: "Exo 2"; color: fl.muted; width: nb_w - 50; lines: 1 }
        }
        // the deck: the pages of what the node may look like
        group { show: nd_stf > 0.01; opacity: nd_stf; move: 0, 40 * (1 - nd_stf)
            group { glow: 24, 0.4, #000000
                box { from: st_x, st_dy; size: 940, 470; corner: 18; color: fl.hull; opacity: 0.97 } }
            box { from: st_x, st_dy; size: 940, 470; corner: 18; stroke: 1; color: fl.trace_dim }
            text "Presets" { at: st_x + 20 + 38, st_dy + 36; anchor: center; align: center; size: 13; weight: if(nd_tab == 0, 700, 500); family: "Exo 2"; color: if(nd_tab == 0, fl.engrave, fl.muted) }
            box { from: st_x + 20 + 12, st_dy + 52; size: 52, 2; corner: 1; color: nd_acc; show: nd_tab == 0 }
            zone box stt0 { from: st_x + 20, st_dy + 18; size: 76, 38; cursor: pointer; role: tab; label: "Presets"; selected: nd_tab == 0; show: nd_studio }
            on press stt0 { emit nd_tab(0) }
            text "Pill" { at: st_x + 99 + 38, st_dy + 36; anchor: center; align: center; size: 13; weight: if(nd_tab == 1, 700, 500); family: "Exo 2"; color: if(nd_tab == 1, fl.engrave, fl.muted) }
            box { from: st_x + 99 + 12, st_dy + 52; size: 52, 2; corner: 1; color: nd_acc; show: nd_tab == 1 }
            zone box stt1 { from: st_x + 99, st_dy + 18; size: 76, 38; cursor: pointer; role: tab; label: "Pill"; selected: nd_tab == 1; show: nd_studio }
            on press stt1 { emit nd_tab(1) }
            text "Shape" { at: st_x + 178 + 38, st_dy + 36; anchor: center; align: center; size: 13; weight: if(nd_tab == 2, 700, 500); family: "Exo 2"; color: if(nd_tab == 2, fl.engrave, fl.muted) }
            box { from: st_x + 178 + 12, st_dy + 52; size: 52, 2; corner: 1; color: nd_acc; show: nd_tab == 2 }
            zone box stt2 { from: st_x + 178, st_dy + 18; size: 76, 38; cursor: pointer; role: tab; label: "Shape"; selected: nd_tab == 2; show: nd_studio }
            on press stt2 { emit nd_tab(2) }
            text "Surface" { at: st_x + 257 + 38, st_dy + 36; anchor: center; align: center; size: 13; weight: if(nd_tab == 3, 700, 500); family: "Exo 2"; color: if(nd_tab == 3, fl.engrave, fl.muted) }
            box { from: st_x + 257 + 12, st_dy + 52; size: 52, 2; corner: 1; color: nd_acc; show: nd_tab == 3 }
            zone box stt3 { from: st_x + 257, st_dy + 18; size: 76, 38; cursor: pointer; role: tab; label: "Surface"; selected: nd_tab == 3; show: nd_studio }
            on press stt3 { emit nd_tab(3) }
            text "Motion" { at: st_x + 336 + 38, st_dy + 36; anchor: center; align: center; size: 13; weight: if(nd_tab == 4, 700, 500); family: "Exo 2"; color: if(nd_tab == 4, fl.engrave, fl.muted) }
            box { from: st_x + 336 + 12, st_dy + 52; size: 52, 2; corner: 1; color: nd_acc; show: nd_tab == 4 }
            zone box stt4 { from: st_x + 336, st_dy + 18; size: 76, 38; cursor: pointer; role: tab; label: "Motion"; selected: nd_tab == 4; show: nd_studio }
            on press stt4 { emit nd_tab(4) }
            text "Music" { at: st_x + 415 + 38, st_dy + 36; anchor: center; align: center; size: 13; weight: if(nd_tab == 5, 700, 500); family: "Exo 2"; color: if(nd_tab == 5, fl.engrave, fl.muted) }
            box { from: st_x + 415 + 12, st_dy + 52; size: 52, 2; corner: 1; color: nd_acc; show: nd_tab == 5 }
            zone box stt5 { from: st_x + 415, st_dy + 18; size: 76, 38; cursor: pointer; role: tab; label: "Music"; selected: nd_tab == 5; show: nd_studio }
            on press stt5 { emit nd_tab(5) }
            text "Parts" { at: st_x + 494 + 38, st_dy + 36; anchor: center; align: center; size: 13; weight: if(nd_tab == 6, 700, 500); family: "Exo 2"; color: if(nd_tab == 6, fl.engrave, fl.muted) }
            box { from: st_x + 494 + 12, st_dy + 52; size: 52, 2; corner: 1; color: nd_acc; show: nd_tab == 6 }
            zone box stt6 { from: st_x + 494, st_dy + 18; size: 76, 38; cursor: pointer; role: tab; label: "Parts"; selected: nd_tab == 6; show: nd_studio }
            on press stt6 { emit nd_tab(6) }
            box { from: st_x + 940 - 24 - 336, st_dy + 22; size: 100, 30; corner: 30 / 2; color: nd_acc; opacity: if(false, 0.9, if(stc3.hover, 0.18, 0)) }
            box { from: st_x + 940 - 24 - 336, st_dy + 22; size: 100, 30; corner: 30 / 2; stroke: 1; color: if(false, nd_acc, fl.trace_lit) }
            text "RESET" { at: st_x + 940 - 24 - 336 + 100 / 2, st_dy + 22 + 30 / 2; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(false, fl.ground, fl.engrave) }
            zone box stc3 { from: st_x + 940 - 24 - 336, st_dy + 22; size: 100, 30; corner: 30 / 2; cursor: pointer; role: button; label: "Reset"; show: nd_studio }
            on press stc3 { emit nd_stc(3) }
            box { from: st_x + 940 - 24 - 224, st_dy + 22; size: 108, 30; corner: 30 / 2; color: nd_acc; opacity: if(false, 0.9, if(stc1.hover, 0.18, 0)) }
            box { from: st_x + 940 - 24 - 224, st_dy + 22; size: 108, 30; corner: 30 / 2; stroke: 1; color: if(false, nd_acc, fl.trace_lit) }
            text "SHUFFLE" { at: st_x + 940 - 24 - 224 + 108 / 2, st_dy + 22 + 30 / 2; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(false, fl.ground, fl.engrave) }
            zone box stc1 { from: st_x + 940 - 24 - 224, st_dy + 22; size: 108, 30; corner: 30 / 2; cursor: pointer; role: button; label: "Shuffle"; show: nd_studio }
            on press stc1 { emit nd_stc(1) }
            box { from: st_x + 940 - 24 - 104, st_dy + 22; size: 104, 30; corner: 30 / 2; color: nd_acc; opacity: if(true, 0.9, if(stc2.hover, 0.18, 0)) }
            box { from: st_x + 940 - 24 - 104, st_dy + 22; size: 104, 30; corner: 30 / 2; stroke: 1; color: if(true, nd_acc, fl.trace_lit) }
            text "DONE" { at: st_x + 940 - 24 - 104 + 104 / 2, st_dy + 22 + 30 / 2; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(true, fl.ground, fl.engrave) }
            zone box stc2 { from: st_x + 940 - 24 - 104, st_dy + 22; size: 104, 30; corner: 30 / 2; cursor: pointer; role: button; label: "Done"; show: nd_studio }
            on press stc2 { emit nd_stc(2) }
            line { from: st_x + 16, st_dy + 64; to: st_x + 924, st_dy + 64; width: 1; color: fl.trace_dim }
            // the presets: four characters to start from (each card draws its own seed, three times its size)
            group { show: nd_tab == 0
                for p in ps {
                    // (D296) six characters in one row: a card each, its seed drawn at twice its size
                    let px = st_x + 24 + p.index * 151
                    let py = st_dy + 80
                    let pw2 = min(p.sw * 2, 110)
                    let ph2 = min(p.sh * 2, 34)
                    let pr = min(pw2, ph2) / 2 * p.sr
                    box { from: px, py; size: 144, 126; corner: 14; color: if(p.on, fl.hull_raised, fl.well); opacity: 0.9 }
                    box { from: px, py; size: 144, 126; corner: 14; stroke: if(p.on, 2, 1); color: if(p.on, nd_acc, if(psz.hover, fl.trace_lit, fl.trace_dim)) }
                    group { glow: 10, 0.5, nd_glc
                        box { from: px + 72 - pw2 / 2, py + 28 - ph2 / 2; size: pw2, ph2; corner: pr; color: nd_acc; show: p.seed != 2 and p.seed != 3 and p.seed != 7 and p.seed != 8 }
                        box { from: px + 72 - pw2 / 2, py + 28 - ph2 / 2; size: pw2 * 0.45, ph2; corner: pr; color: nd_acc; show: p.seed == 3 }
                        box { from: px + 72 + pw2 * 0.05, py + 28 - ph2 / 2; size: pw2 * 0.45, ph2; corner: pr; color: nd_acc; show: p.seed == 3 }
                        ellipse { at: px + 72, py + 28; radius: ph2 / 2; color: nd_acc; opacity: 0.8; show: p.seed == 7 }
                        ellipse { at: px + 72 - ph2 * 0.15, py + 28 - ph2 * 0.15; radius: ph2 * 0.13; color: #ffffff; opacity: 0.6; show: p.seed == 7 }
                        ellipse { at: px + 72 + pw2 / 2 - ph2 / 2, py + 28; radius: ph2 / 2; color: nd_acc; show: p.seed == 8 }
                        box { from: px + 72 - pw2 / 2, py + 28 - ph2 / 6; size: pw2 - ph2 / 2, ph2 / 3; corner: ph2 / 6; color: nd_acc; opacity: 0.35; show: p.seed == 8 } }
                    box { from: px + 72 - pw2 / 2, py + 28 - ph2 / 2; size: pw2, ph2; corner: pr; stroke: 2; color: nd_acc; show: p.seed == 2 }
                    text p.name { at: px + 14, py + 62; anchor: left center; size: 14; weight: 700; family: "Exo 2"; color: fl.engrave }
                    text p.desc { at: px + 14, py + 76; anchor: left top; size: 9; family: "Exo 2"; color: fl.muted; width: 120; lines: 3 }
                    zone box psz { from: px, py; size: 144, 126; corner: 14; cursor: pointer; role: item; label: "Wear {p.name}"; selected: p.on; show: nd_studio and nd_tab == 0 }
                    on press psz { emit nd_ps(p.index) }
                }
                text "YOUR LOOKS" { at: st_x + 24, st_dy + 232; anchor: left center; size: 9; weight: 700; family: "Share Tech Mono"; color: fl.muted }
                for s in sl {
                    let sy0 = st_dy + 246 + s.index * 52
                    box { from: st_x + 24, sy0; size: 892, 44; corner: 12; color: fl.well; opacity: 0.8 }
                    text "{s.index + 1, 0}" { at: st_x + 46, sy0 + 22; anchor: center; align: center; size: 13; weight: 700; family: "Share Tech Mono"; color: if(s.full, nd_acc, fl.muted) }
                    text s.label { at: st_x + 70, sy0 + 22; anchor: left center; size: 12; family: "Exo 2"; color: if(s.full, fl.engrave, fl.muted); width: 500; lines: 1 }
                    box { from: st_x + 916 - 330, sy0 + 8; size: 120, 28; corner: 28 / 2; color: nd_acc; opacity: if(false, 0.9, if(sls.hover, 0.18, 0)) }
                    box { from: st_x + 916 - 330, sy0 + 8; size: 120, 28; corner: 28 / 2; stroke: 1; color: if(false, nd_acc, fl.trace_lit) }
                    text "SAVE HERE" { at: st_x + 916 - 330 + 120 / 2, sy0 + 8 + 28 / 2; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(false, fl.ground, fl.engrave) }
                    zone box sls { from: st_x + 916 - 330, sy0 + 8; size: 120, 28; corner: 28 / 2; cursor: pointer; role: button; label: "Save here"; show: nd_studio }
                    on press sls { emit nd_slot(s.index * 10) }
                    group { show: s.full
                        box { from: st_x + 916 - 202, sy0 + 8; size: 100, 28; corner: 28 / 2; color: nd_acc; opacity: if(false, 0.9, if(slw.hover, 0.18, 0)) }
                        box { from: st_x + 916 - 202, sy0 + 8; size: 100, 28; corner: 28 / 2; stroke: 1; color: if(false, nd_acc, fl.trace_lit) }
                        text "WEAR" { at: st_x + 916 - 202 + 100 / 2, sy0 + 8 + 28 / 2; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(false, fl.ground, fl.engrave) }
                        zone box slw { from: st_x + 916 - 202, sy0 + 8; size: 100, 28; corner: 28 / 2; cursor: pointer; role: button; label: "Wear"; show: nd_studio }
                        on press slw { emit nd_slot(s.index * 10 + 1) }
                        box { from: st_x + 916 - 94, sy0 + 8; size: 94, 28; corner: 28 / 2; color: nd_acc; opacity: if(false, 0.9, if(slx.hover, 0.18, 0)) }
                        box { from: st_x + 916 - 94, sy0 + 8; size: 94, 28; corner: 28 / 2; stroke: 1; color: if(false, nd_acc, fl.trace_lit) }
                        text "CLEAR" { at: st_x + 916 - 94 + 94 / 2, sy0 + 8 + 28 / 2; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(false, fl.ground, fl.engrave) }
                        zone box slx { from: st_x + 916 - 94, sy0 + 8; size: 94, 28; corner: 28 / 2; cursor: pointer; role: button; label: "Clear"; show: nd_studio }
                        on press slx { emit nd_slot(s.index * 10 + 9) }
                    }
                }
            }
            // the modules (D257): what the long pill or the notch holds, in its order — ‹ › to move one, × to take it
            // out; a press on one of the rest adds it at the end
            group { show: nd_tab == 1
                text pick(nd_mside, "IN THE PILL", "IN THE LEFT CORNER", "IN THE RIGHT CORNER") { at: st_x + 24, st_dy + 196; anchor: left center; size: 9; weight: 700; family: "Share Tech Mono"; color: fl.muted }
                text pick(nd_mside, "NONE: THE PILL RESTS AS A SEED (SHAPE → SEED)", "NONE: NO NOTCH IN THE LEFT CORNER", "NONE: NO NOTCH IN THE RIGHT CORNER") { at: st_x + 170, st_dy + 196; anchor: left center; size: 9; family: "Share Tech Mono"; color: fl.muted; show: md.count == 0 }
                box { from: st_x + 520 + 0 * 118, st_dy + 184; size: 110, 24; corner: 12 * max(0.3, nd_rnd); color: nd_acc; opacity: if(nd_mside == 0, 0.22, if(mside0.hover, 0.1, 0)) }
                box { from: st_x + 520 + 0 * 118, st_dy + 184; size: 110, 24; corner: 12 * max(0.3, nd_rnd); stroke: 1; color: if(nd_mside == 0, nd_acc, fl.trace_lit) }
                text "CENTRE" { at: st_x + 520 + 0 * 118 + 55, st_dy + 196; anchor: center; align: center; size: 9; weight: 700; family: "Share Tech Mono"; color: if(nd_mside == 0, nd_acc, fl.engrave) }
                zone box mside0 { from: st_x + 520 + 0 * 118, st_dy + 184; size: 110, 24; cursor: pointer; role: tab; label: "The pill"; selected: nd_mside == 0; show: nd_studio and nd_tab == 1 }
                on press mside0 { emit nd_mside(0) }
                box { from: st_x + 520 + 1 * 118, st_dy + 184; size: 110, 24; corner: 12 * max(0.3, nd_rnd); color: nd_acc; opacity: if(nd_mside == 1, 0.22, if(mside1.hover, 0.1, 0)) }
                box { from: st_x + 520 + 1 * 118, st_dy + 184; size: 110, 24; corner: 12 * max(0.3, nd_rnd); stroke: 1; color: if(nd_mside == 1, nd_acc, fl.trace_lit) }
                text "LEFT CORNER" { at: st_x + 520 + 1 * 118 + 55, st_dy + 196; anchor: center; align: center; size: 9; weight: 700; family: "Share Tech Mono"; color: if(nd_mside == 1, nd_acc, fl.engrave) }
                zone box mside1 { from: st_x + 520 + 1 * 118, st_dy + 184; size: 110, 24; cursor: pointer; role: tab; label: "The left corner notch"; selected: nd_mside == 1; show: nd_studio and nd_tab == 1 }
                on press mside1 { emit nd_mside(1) }
                box { from: st_x + 520 + 2 * 118, st_dy + 184; size: 110, 24; corner: 12 * max(0.3, nd_rnd); color: nd_acc; opacity: if(nd_mside == 2, 0.22, if(mside2.hover, 0.1, 0)) }
                box { from: st_x + 520 + 2 * 118, st_dy + 184; size: 110, 24; corner: 12 * max(0.3, nd_rnd); stroke: 1; color: if(nd_mside == 2, nd_acc, fl.trace_lit) }
                text "RIGHT CORNER" { at: st_x + 520 + 2 * 118 + 55, st_dy + 196; anchor: center; align: center; size: 9; weight: 700; family: "Share Tech Mono"; color: if(nd_mside == 2, nd_acc, fl.engrave) }
                zone box mside2 { from: st_x + 520 + 2 * 118, st_dy + 184; size: 110, 24; cursor: pointer; role: tab; label: "The right corner notch"; selected: nd_mside == 2; show: nd_studio and nd_tab == 1 }
                on press mside2 { emit nd_mside(2) }
                for m in md {
                    let mx = st_x + 24 + m.index * 148
                    box { from: mx, st_dy + 210; size: 140, 36; corner: 18 * max(0.3, nd_rnd); color: fl.hull_raised }
                    box { from: mx, st_dy + 210; size: 140, 36; corner: 18 * max(0.3, nd_rnd); stroke: 1; color: nd_acc; opacity: 0.8 }
                    text m.label { at: mx + 70, st_dy + 228; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: fl.engrave; width: 84; lines: 1 }
                    text "‹" { at: mx + 14, st_dy + 228; anchor: center; size: 15; family: "Exo 2"; color: if(mdl.hover, nd_acc, fl.muted); show: m.index > 0 }
                    text "›" { at: mx + 126, st_dy + 228; anchor: center; size: 15; family: "Exo 2"; color: if(mdr.hover, nd_acc, fl.muted); show: m.index < md.count - 1 }
                    ellipse { at: mx + 136, st_dy + 212; radius: 8; color: if(mdx.hover, fl.ember, fl.hull) }
                    text "×" { at: mx + 136, st_dy + 212; anchor: center; size: 11; family: "Exo 2"; color: if(mdx.hover, fl.ground, fl.engrave) }
                    zone box mdl { from: mx, st_dy + 210; size: 28, 36; cursor: pointer; role: button; label: "Move {m.label} left"; show: nd_studio and nd_tab == 1 and m.index > 0 }
                    on press mdl { emit nd_md(m.index * 10 + 1) }
                    zone box mdr { from: mx + 112, st_dy + 210; size: 28, 36; cursor: pointer; role: button; label: "Move {m.label} right"; show: nd_studio and nd_tab == 1 and m.index < md.count - 1 }
                    on press mdr { emit nd_md(m.index * 10 + 2) }
                    zone box mdx { from: mx + 127, st_dy + 203; size: 18, 18; corner: 9; cursor: pointer; role: button; label: "Take {m.label} out"; show: nd_studio and nd_tab == 1 }
                    on press mdx { emit nd_md(m.index * 10 + 9) }
                }
                text "ADD" { at: st_x + 24, st_dy + 268; anchor: left center; size: 9; weight: 700; family: "Share Tech Mono"; color: fl.muted }
                text "FULL: SIX AT MOST" { at: st_x + 70, st_dy + 268; anchor: left center; size: 9; family: "Share Tech Mono"; color: fl.muted; show: md.count >= 6 }
                for a in ma {
                    let ax = st_x + 24 + (a.index - floor(a.index / 8) * 8) * 112
                    let ay = st_dy + 282 + floor(a.index / 8) * 40
                    box { from: ax, ay; size: 104, 32; corner: 16 * max(0.3, nd_rnd); color: nd_acc; opacity: if(maz.hover, 0.18, 0) }
                    box { from: ax, ay; size: 104, 32; corner: 16 * max(0.3, nd_rnd); stroke: 1; color: if(maz.hover, nd_acc, fl.trace_lit) }
                    text "+ {a.label}" { at: ax + 52, ay + 16; anchor: center; align: center; size: 9; weight: 700; family: "Share Tech Mono"; color: fl.engrave; width: 98; lines: 1 }
                    zone box maz { from: ax, ay; size: 104, 32; corner: 16; cursor: pointer; role: button; label: "Add {a.label}"; show: nd_studio and nd_tab == 1 and md.count < 6 }
                    on press maz { emit nd_md(100 + a.index) }
                }
            }
            // the other pages: a row each — a slider to drag, or a choice of chips; the arrows move the lit row
            for r in sk {
                let ry = st_dy + 78 + r.index * 52
                let tx = st_x + 430
                group { show: nd_tab > 0; opacity: if(r.off, 0.35, 1)
                    box { from: st_x + 12, ry; size: 916, 46; corner: 10; color: fl.well; opacity: if(nd_kr == r.index, 0.85, 0) }
                    box { from: st_x + 12, ry + 10; size: 3, 26; corner: 1; color: nd_acc; show: nd_kr == r.index }
                    text r.label { at: st_x + 32, ry + 16; anchor: left center; size: 13; weight: 600; family: "Exo 2"; color: fl.engrave }
                    text r.desc { at: st_x + 32, ry + 33; anchor: left center; size: 10; family: "Exo 2"; color: fl.muted; width: 380; lines: 1; show: not r.off }
                    text r.why { at: st_x + 32, ry + 33; anchor: left center; size: 10; family: "Exo 2"; color: fl.ember; width: 380; lines: 1; show: r.off }
                    group { show: r.kind == 0
                        box { from: tx, ry + 21; size: 380, 4; corner: 2; color: fl.trace_dim }
                        box { from: tx, ry + 21; size: 380 * r.frac, 4; corner: 2; color: nd_acc }
                        group { glow: 10, if(skz.hover or nd_kr == r.index, 0.6, 0.2), nd_glc
                            ellipse { at: tx + 380 * r.frac, ry + 23; radius: if(skz.hover, 9, 7); color: nd_acc } }
                        text r.value { at: st_x + 916, ry + 23; anchor: right center; align: right; size: 11; weight: 700; family: "Share Tech Mono"; color: fl.engrave; width: 90; lines: 1 }
                    }
                    group { show: r.kind == 1 and r.n > 0
                        box { from: tx + 0 * if(r.n > 7, 55, 69), ry + 9; size: if(r.n > 7, 51, 64), 28; corner: 14 * max(0.3, nd_rnd); color: nd_acc; opacity: if(r.sel == 0, 0.9, if(sko0.hover, 0.16, 0)) }
                        box { from: tx + 0 * if(r.n > 7, 55, 69), ry + 9; size: if(r.n > 7, 51, 64), 28; corner: 14 * max(0.3, nd_rnd); stroke: 1; color: if(r.sel == 0, nd_acc, fl.trace_lit) }
                        text r.o0 { at: tx + 0 * if(r.n > 7, 55, 69) + 32, ry + 23; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(r.sel == 0, fl.ground, fl.engrave); width: 60; lines: 1 }
                    }
                    zone box sko0 { from: tx + 0 * if(r.n > 7, 55, 69), ry + 9; size: if(r.n > 7, 51, 64), 28; cursor: pointer; role: item; label: "{r.label}: {r.o0}"; selected: r.sel == 0; show: nd_studio and nd_tab > 0 and r.kind == 1 and r.n > 0 and not r.off }
                    on press sko0 { emit nd_so(r.index * 10 + 0) }
                    group { show: r.kind == 1 and r.n > 1
                        box { from: tx + 1 * if(r.n > 7, 55, 69), ry + 9; size: if(r.n > 7, 51, 64), 28; corner: 14 * max(0.3, nd_rnd); color: nd_acc; opacity: if(r.sel == 1, 0.9, if(sko1.hover, 0.16, 0)) }
                        box { from: tx + 1 * if(r.n > 7, 55, 69), ry + 9; size: if(r.n > 7, 51, 64), 28; corner: 14 * max(0.3, nd_rnd); stroke: 1; color: if(r.sel == 1, nd_acc, fl.trace_lit) }
                        text r.o1 { at: tx + 1 * if(r.n > 7, 55, 69) + 32, ry + 23; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(r.sel == 1, fl.ground, fl.engrave); width: 60; lines: 1 }
                    }
                    zone box sko1 { from: tx + 1 * if(r.n > 7, 55, 69), ry + 9; size: if(r.n > 7, 51, 64), 28; cursor: pointer; role: item; label: "{r.label}: {r.o1}"; selected: r.sel == 1; show: nd_studio and nd_tab > 0 and r.kind == 1 and r.n > 1 and not r.off }
                    on press sko1 { emit nd_so(r.index * 10 + 1) }
                    group { show: r.kind == 1 and r.n > 2
                        box { from: tx + 2 * if(r.n > 7, 55, 69), ry + 9; size: if(r.n > 7, 51, 64), 28; corner: 14 * max(0.3, nd_rnd); color: nd_acc; opacity: if(r.sel == 2, 0.9, if(sko2.hover, 0.16, 0)) }
                        box { from: tx + 2 * if(r.n > 7, 55, 69), ry + 9; size: if(r.n > 7, 51, 64), 28; corner: 14 * max(0.3, nd_rnd); stroke: 1; color: if(r.sel == 2, nd_acc, fl.trace_lit) }
                        text r.o2 { at: tx + 2 * if(r.n > 7, 55, 69) + 32, ry + 23; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(r.sel == 2, fl.ground, fl.engrave); width: 60; lines: 1 }
                    }
                    zone box sko2 { from: tx + 2 * if(r.n > 7, 55, 69), ry + 9; size: if(r.n > 7, 51, 64), 28; cursor: pointer; role: item; label: "{r.label}: {r.o2}"; selected: r.sel == 2; show: nd_studio and nd_tab > 0 and r.kind == 1 and r.n > 2 and not r.off }
                    on press sko2 { emit nd_so(r.index * 10 + 2) }
                    group { show: r.kind == 1 and r.n > 3
                        box { from: tx + 3 * if(r.n > 7, 55, 69), ry + 9; size: if(r.n > 7, 51, 64), 28; corner: 14 * max(0.3, nd_rnd); color: nd_acc; opacity: if(r.sel == 3, 0.9, if(sko3.hover, 0.16, 0)) }
                        box { from: tx + 3 * if(r.n > 7, 55, 69), ry + 9; size: if(r.n > 7, 51, 64), 28; corner: 14 * max(0.3, nd_rnd); stroke: 1; color: if(r.sel == 3, nd_acc, fl.trace_lit) }
                        text r.o3 { at: tx + 3 * if(r.n > 7, 55, 69) + 32, ry + 23; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(r.sel == 3, fl.ground, fl.engrave); width: 60; lines: 1 }
                    }
                    zone box sko3 { from: tx + 3 * if(r.n > 7, 55, 69), ry + 9; size: if(r.n > 7, 51, 64), 28; cursor: pointer; role: item; label: "{r.label}: {r.o3}"; selected: r.sel == 3; show: nd_studio and nd_tab > 0 and r.kind == 1 and r.n > 3 and not r.off }
                    on press sko3 { emit nd_so(r.index * 10 + 3) }
                    group { show: r.kind == 1 and r.n > 4
                        box { from: tx + 4 * if(r.n > 7, 55, 69), ry + 9; size: if(r.n > 7, 51, 64), 28; corner: 14 * max(0.3, nd_rnd); color: nd_acc; opacity: if(r.sel == 4, 0.9, if(sko4.hover, 0.16, 0)) }
                        box { from: tx + 4 * if(r.n > 7, 55, 69), ry + 9; size: if(r.n > 7, 51, 64), 28; corner: 14 * max(0.3, nd_rnd); stroke: 1; color: if(r.sel == 4, nd_acc, fl.trace_lit) }
                        text r.o4 { at: tx + 4 * if(r.n > 7, 55, 69) + 32, ry + 23; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(r.sel == 4, fl.ground, fl.engrave); width: 60; lines: 1 }
                    }
                    zone box sko4 { from: tx + 4 * if(r.n > 7, 55, 69), ry + 9; size: if(r.n > 7, 51, 64), 28; cursor: pointer; role: item; label: "{r.label}: {r.o4}"; selected: r.sel == 4; show: nd_studio and nd_tab > 0 and r.kind == 1 and r.n > 4 and not r.off }
                    on press sko4 { emit nd_so(r.index * 10 + 4) }
                    group { show: r.kind == 1 and r.n > 5
                        box { from: tx + 5 * if(r.n > 7, 55, 69), ry + 9; size: if(r.n > 7, 51, 64), 28; corner: 14 * max(0.3, nd_rnd); color: nd_acc; opacity: if(r.sel == 5, 0.9, if(sko5.hover, 0.16, 0)) }
                        box { from: tx + 5 * if(r.n > 7, 55, 69), ry + 9; size: if(r.n > 7, 51, 64), 28; corner: 14 * max(0.3, nd_rnd); stroke: 1; color: if(r.sel == 5, nd_acc, fl.trace_lit) }
                        text r.o5 { at: tx + 5 * if(r.n > 7, 55, 69) + 32, ry + 23; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(r.sel == 5, fl.ground, fl.engrave); width: 60; lines: 1 }
                    }
                    zone box sko5 { from: tx + 5 * if(r.n > 7, 55, 69), ry + 9; size: if(r.n > 7, 51, 64), 28; cursor: pointer; role: item; label: "{r.label}: {r.o5}"; selected: r.sel == 5; show: nd_studio and nd_tab > 0 and r.kind == 1 and r.n > 5 and not r.off }
                    on press sko5 { emit nd_so(r.index * 10 + 5) }
                    group { show: r.kind == 1 and r.n > 6
                        box { from: tx + 6 * if(r.n > 7, 55, 69), ry + 9; size: if(r.n > 7, 51, 64), 28; corner: 14 * max(0.3, nd_rnd); color: nd_acc; opacity: if(r.sel == 6, 0.9, if(sko6.hover, 0.16, 0)) }
                        box { from: tx + 6 * if(r.n > 7, 55, 69), ry + 9; size: if(r.n > 7, 51, 64), 28; corner: 14 * max(0.3, nd_rnd); stroke: 1; color: if(r.sel == 6, nd_acc, fl.trace_lit) }
                        text r.o6 { at: tx + 6 * if(r.n > 7, 55, 69) + 32, ry + 23; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(r.sel == 6, fl.ground, fl.engrave); width: 60; lines: 1 }
                    }
                    zone box sko6 { from: tx + 6 * if(r.n > 7, 55, 69), ry + 9; size: if(r.n > 7, 51, 64), 28; cursor: pointer; role: item; label: "{r.label}: {r.o6}"; selected: r.sel == 6; show: nd_studio and nd_tab > 0 and r.kind == 1 and r.n > 6 and not r.off }
                    on press sko6 { emit nd_so(r.index * 10 + 6) }
                    group { show: r.kind == 1 and r.n > 7
                        box { from: tx + 7 * if(r.n > 7, 55, 69), ry + 9; size: if(r.n > 7, 51, 64), 28; corner: 14 * max(0.3, nd_rnd); color: nd_acc; opacity: if(r.sel == 7, 0.9, if(sko7.hover, 0.16, 0)) }
                        box { from: tx + 7 * if(r.n > 7, 55, 69), ry + 9; size: if(r.n > 7, 51, 64), 28; corner: 14 * max(0.3, nd_rnd); stroke: 1; color: if(r.sel == 7, nd_acc, fl.trace_lit) }
                        text r.o7 { at: tx + 7 * if(r.n > 7, 55, 69) + 32, ry + 23; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(r.sel == 7, fl.ground, fl.engrave); width: 60; lines: 1 }
                    }
                    zone box sko7 { from: tx + 7 * if(r.n > 7, 55, 69), ry + 9; size: if(r.n > 7, 51, 64), 28; cursor: pointer; role: item; label: "{r.label}: {r.o7}"; selected: r.sel == 7; show: nd_studio and nd_tab > 0 and r.kind == 1 and r.n > 7 and not r.off }
                    on press sko7 { emit nd_so(r.index * 10 + 7) }
                    group { show: r.kind == 1 and r.n > 8
                        box { from: tx + 8 * if(r.n > 7, 55, 69), ry + 9; size: if(r.n > 7, 51, 64), 28; corner: 14 * max(0.3, nd_rnd); color: nd_acc; opacity: if(r.sel == 8, 0.9, if(sko8.hover, 0.16, 0)) }
                        box { from: tx + 8 * if(r.n > 7, 55, 69), ry + 9; size: if(r.n > 7, 51, 64), 28; corner: 14 * max(0.3, nd_rnd); stroke: 1; color: if(r.sel == 8, nd_acc, fl.trace_lit) }
                        text r.o8 { at: tx + 8 * if(r.n > 7, 55, 69) + 32, ry + 23; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(r.sel == 8, fl.ground, fl.engrave); width: 60; lines: 1 }
                    }
                    zone box sko8 { from: tx + 8 * if(r.n > 7, 55, 69), ry + 9; size: if(r.n > 7, 51, 64), 28; cursor: pointer; role: item; label: "{r.label}: {r.o8}"; selected: r.sel == 8; show: nd_studio and nd_tab > 0 and r.kind == 1 and r.n > 8 and not r.off }
                    on press sko8 { emit nd_so(r.index * 10 + 8) }
                }
                zone box skz { from: tx - 12, ry + 4; size: 404, 38; cursor: grab; role: slider; label: "{r.label}"; value: "{r.value}"; show: nd_studio and nd_tab > 0 and r.kind == 0 and not r.off }
                on press skz { emit nd_sk(r.index * 2000 + round(clamp((pointer.x - tx) / 380, 0, 1) * 1000)) }
                on drag skz { emit nd_sk(r.index * 2000 + round(clamp((pointer.x - tx) / 380, 0, 1) * 1000)) }
            }
            text "↑ ↓  A ROW     ← →  CHANGE IT     TAB  THE NEXT PAGE     ESC  DONE     PRESS THE NODE  THE NEXT STATE" { at: st_x + 470, st_dy + 450; anchor: center; align: center; size: 9; family: "Share Tech Mono"; color: fl.muted }
        }
        // the keyboard, while the node holds it (the launcher, the universe, the studio)
        on key Escape while nd_kb { emit nd_key(27) }
        on key Return while nd_kb { emit nd_key(13) }
        on key Up while nd_kb { emit nd_key(38) }
        on key Down while nd_kb { emit nd_key(40) }
        on key Left while nd_kb { emit nd_key(37) }
        on key Right while nd_kb { emit nd_key(39) }
        on key Tab while nd_kb { emit nd_key(9) }
        on key space while nd_kb { emit nd_key(32) }
    }
}
