    fact cn_kind = 0
    fact cn_scale = 1
    fact c_bg_primary_r = 0.062745
    fact c_bg_primary_g = 0.078431
    fact c_bg_primary_b = 0.086275
    fact c_bg_secondary_r = 0.086275
    fact c_bg_secondary_g = 0.105882
