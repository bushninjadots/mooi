            line { from: vx + cos((14 * 11.25 - 90)) * (vr + 3), vy + sin((14 * 11.25 - 90)) * (vr + 3); to: vx + cos((14 * 11.25 - 90)) * (vr + 4 + nd_sp14 * 26), vy + sin((14 * 11.25 - 90)) * (vr + 4 + nd_sp14 * 26); width: 3; color: nd_acc; opacity: 0.35 + 0.6 * nd_sp14 }
            line { from: vx + cos((15 * 11.25 - 90)) * (vr + 3), vy + sin((15 * 11.25 - 90)) * (vr + 3); to: vx + cos((15 * 11.25 - 90)) * (vr + 4 + nd_sp15 * 26), vy + sin((15 * 11.25 - 90)) * (vr + 4 + nd_sp15 * 26); width: 3; color: nd_acc; opacity: 0.35 + 0.6 * nd_sp15 }
            line { from: vx + cos((16 * 11.25 - 90)) * (vr + 3), vy + sin((16 * 11.25 - 90)) * (vr + 3); to: vx + cos((16 * 11.25 - 90)) * (vr + 4 + nd_sp16 * 26), vy + sin((16 * 11.25 - 90)) * (vr + 4 + nd_sp16 * 26); width: 3; color: nd_acc; opacity: 0.35 + 0.6 * nd_sp16 }
            line { from: vx + cos((17 * 11.25 - 90)) * (vr + 3), vy + sin((17 * 11.25 - 90)) * (vr + 3); to: vx + cos((17 * 11.25 - 90)) * (vr + 4 + nd_sp17 * 26), vy + sin((17 * 11.25 - 90)) * (vr + 4 + nd_sp17 * 26); width: 3; color: nd_acc; opacity: 0.35 + 0.6 * nd_sp17 }
            line { from: vx + cos((18 * 11.25 - 90)) * (vr + 3), vy + sin((18 * 11.25 - 90)) * (vr + 3); to: vx + cos((18 * 11.25 - 90)) * (vr + 4 + nd_sp18 * 26), vy + sin((18 * 11.25 - 90)) * (vr + 4 + nd_sp18 * 26); width: 3; color: nd_acc; opacity: 0.35 + 0.6 * nd_sp18 }
            line { from: vx + cos((19 * 11.25 - 90)) * (vr + 3), vy + sin((19 * 11.25 - 90)) * (vr + 3); to: vx + cos((19 * 11.25 - 90)) * (vr + 4 + nd_sp19 * 26), vy + sin((19 * 11.25 - 90)) * (vr + 4 + nd_sp19 * 26); width: 3; color: nd_acc; opacity: 0.35 + 0.6 * nd_sp19 }
            line { from: vx + cos((20 * 11.25 - 90)) * (vr + 3), vy + sin((20 * 11.25 - 90)) * (vr + 3); to: vx + cos((20 * 11.25 - 90)) * (vr + 4 + nd_sp20 * 26), vy + sin((20 * 11.25 - 90)) * (vr + 4 + nd_sp20 * 26); width: 3; color: nd_acc; opacity: 0.35 + 0.6 * nd_sp20 }
            line { from: vx + cos((21 * 11.25 - 90)) * (vr + 3), vy + sin((21 * 11.25 - 90)) * (vr + 3); to: vx + cos((21 * 11.25 - 90)) * (vr + 4 + nd_sp21 * 26), vy + sin((21 * 11.25 - 90)) * (vr + 4 + nd_sp21 * 26); width: 3; color: nd_acc; opacity: 0.35 + 0.6 * nd_sp21 }
            line { from: vx + cos((22 * 11.25 - 90)) * (vr + 3), vy + sin((22 * 11.25 - 90)) * (vr + 3); to: vx + cos((22 * 11.25 - 90)) * (vr + 4 + nd_sp22 * 26), vy + sin((22 * 11.25 - 90)) * (vr + 4 + nd_sp22 * 26); width: 3; color: nd_acc; opacity: 0.35 + 0.6 * nd_sp22 }
            line { from: vx + cos((23 * 11.25 - 90)) * (vr + 3), vy + sin((23 * 11.25 - 90)) * (vr + 3); to: vx + cos((23 * 11.25 - 90)) * (vr + 4 + nd_sp23 * 26), vy + sin((23 * 11.25 - 90)) * (vr + 4 + nd_sp23 * 26); width: 3; color: nd_acc; opacity: 0.35 + 0.6 * nd_sp23 }
            line { from: vx + cos((24 * 11.25 - 90)) * (vr + 3), vy + sin((24 * 11.25 - 90)) * (vr + 3); to: vx + cos((24 * 11.25 - 90)) * (vr + 4 + nd_sp24 * 26), vy + sin((24 * 11.25 - 90)) * (vr + 4 + nd_sp24 * 26); width: 3; color: nd_acc; opacity: 0.35 + 0.6 * nd_sp24 }
            line { from: vx + cos((25 * 11.25 - 90)) * (vr + 3), vy + sin((25 * 11.25 - 90)) * (vr + 3); to: vx + cos((25 * 11.25 - 90)) * (vr + 4 + nd_sp25 * 26), vy + sin((25 * 11.25 - 90)) * (vr + 4 + nd_sp25 * 26); width: 3; color: nd_acc; opacity: 0.35 + 0.6 * nd_sp25 }
            line { from: vx + cos((26 * 11.25 - 90)) * (vr + 3), vy + sin((26 * 11.25 - 90)) * (vr + 3); to: vx + cos((26 * 11.25 - 90)) * (vr + 4 + nd_sp26 * 26), vy + sin((26 * 11.25 - 90)) * (vr + 4 + nd_sp26 * 26); width: 3; color: nd_acc; opacity: 0.35 + 0.6 * nd_sp26 }
            line { from: vx + cos((27 * 11.25 - 90)) * (vr + 3), vy + sin((27 * 11.25 - 90)) * (vr + 3); to: vx + cos((27 * 11.25 - 90)) * (vr + 4 + nd_sp27 * 26), vy + sin((27 * 11.25 - 90)) * (vr + 4 + nd_sp27 * 26); width: 3; color: nd_acc; opacity: 0.35 + 0.6 * nd_sp27 }
            line { from: vx + cos((28 * 11.25 - 90)) * (vr + 3), vy + sin((28 * 11.25 - 90)) * (vr + 3); to: vx + cos((28 * 11.25 - 90)) * (vr + 4 + nd_sp28 * 26), vy + sin((28 * 11.25 - 90)) * (vr + 4 + nd_sp28 * 26); width: 3; color: nd_acc; opacity: 0.35 + 0.6 * nd_sp28 }
            line { from: vx + cos((29 * 11.25 - 90)) * (vr + 3), vy + sin((29 * 11.25 - 90)) * (vr + 3); to: vx + cos((29 * 11.25 - 90)) * (vr + 4 + nd_sp29 * 26), vy + sin((29 * 11.25 - 90)) * (vr + 4 + nd_sp29 * 26); width: 3; color: nd_acc; opacity: 0.35 + 0.6 * nd_sp29 }
            line { from: vx + cos((30 * 11.25 - 90)) * (vr + 3), vy + sin((30 * 11.25 - 90)) * (vr + 3); to: vx + cos((30 * 11.25 - 90)) * (vr + 4 + nd_sp30 * 26), vy + sin((30 * 11.25 - 90)) * (vr + 4 + nd_sp30 * 26); width: 3; color: nd_acc; opacity: 0.35 + 0.6 * nd_sp30 }
            line { from: vx + cos((31 * 11.25 - 90)) * (vr + 3), vy + sin((31 * 11.25 - 90)) * (vr + 3); to: vx + cos((31 * 11.25 - 90)) * (vr + 4 + nd_sp31 * 26), vy + sin((31 * 11.25 - 90)) * (vr + 4 + nd_sp31 * 26); width: 3; color: nd_acc; opacity: 0.35 + 0.6 * nd_sp31 }
            group { glow: 16, 0.35 * nd_gw, nd_glc
                ellipse { at: vx, vy; radius: vr; color: #0b0b0d } }
            ellipse { at: vx, vy; radius: vr * 0.920; stroke: 0.8; color: fl.trace_lit; opacity: 0.10 }
            ellipse { at: vx, vy; radius: vr * 0.845; stroke: 0.8; color: fl.trace_lit; opacity: 0.13 }
            ellipse { at: vx, vy; radius: vr * 0.770; stroke: 0.8; color: fl.trace_lit; opacity: 0.10 }
            ellipse { at: vx, vy; radius: vr * 0.695; stroke: 0.8; color: fl.trace_lit; opacity: 0.13 }
            ellipse { at: vx, vy; radius: vr * 0.620; stroke: 0.8; color: fl.trace_lit; opacity: 0.10 }
            ellipse { at: vx, vy; radius: vr * 0.545; stroke: 0.8; color: fl.trace_lit; opacity: 0.13 }
            ellipse { at: vx, vy; radius: vr * 0.470; stroke: 0.8; color: fl.trace_lit; opacity: 0.10 }
            group { pivot: vx, vy; rotate: nd_vrot
                arc { at: vx, vy; radius: vr * 0.7; span: 50deg; rotate: -40deg; width: vr * 0.45; color: #ffffff; opacity: 0.05 }
                arc { at: vx, vy; radius: vr * 0.7; span: 50deg; rotate: 140deg; width: vr * 0.45; color: #ffffff; opacity: 0.035 }
                group { clip box { from: vx - vr * 0.34, vy - vr * 0.34; size: vr * 0.68, vr * 0.68; corner: vr * 0.34 }
                    ellipse { at: vx, vy; radius: vr * 0.34; color: nd_acc }
                    image nd_cover { at: vx - vr * 0.34, vy - vr * 0.34; size: vr * 0.68, vr * 0.68; fit: cover; show: nd_arted } }
            }
            ellipse { at: vx, vy; radius: 3; color: fl.ground }
            // the tonearm, from its pivot beside the record to the grooves
            ellipse { at: vx + vr * 0.95, vy - vr * 0.8; radius: 6; color: fl.hull_raised }
            line { from: vx + vr * 0.95, vy - vr * 0.8; to: vx + vr * 0.35, vy + vr * 0.25; width: 3; color: fl.trace_lit }
            box { from: vx + vr * 0.35 - 4, vy + vr * 0.25 - 3; size: 9, 7; corner: 2; color: nd_acc }
        }
        // the shelf: the node holds what has the focus and the time; the side pills grow out of its ends
        group { show: nd_kind == 12; opacity: nd_cf
            text nd_awin { at: nb_x + 16, nb_y + nb_h / 2; anchor: left center; size: 12; weight: 600; family: "Exo 2"; color: fl.engrave; width: nb_w - 90; lines: 1 }
            text nd_shclk { at: nb_x + nb_w - 14, nb_y + nb_h / 2; anchor: right center; align: right; size: 11; weight: 700; family: "Share Tech Mono"; color: nd_acc }
        }
        for p in sh {
            let g = clamp(nd_grow * nd_gk - p.index * 0.09 * nd_stg, 0, 1)
            let edge = if(p.side < 0, nb_x, nb_x + nb_w)
            group { show: nd_kind == 12; opacity: g
                let sx = if(p.side < 0, edge - (edge - p.x) * g, edge + (p.x - edge) * g)
                box { from: sx, p.y; size: p.w * max(0.2, g), 26; corner: 13 * max(0.3, nd_rnd); color: if(shz.hover, fl.hull_raised, fl.hull); opacity: 0.95 }
                box { from: sx, p.y; size: p.w * max(0.2, g), 26; corner: 13 * max(0.3, nd_rnd); stroke: 1; color: if(shz.hover, nd_acc, fl.trace_lit); opacity: 0.8 }
                text p.label { at: sx + p.w * g / 2, p.y + 13; anchor: center; align: center; size: 9; weight: 700; family: "Share Tech Mono"; color: if(shz.hover, nd_acc, fl.engrave); opacity: g }
            }
            zone box shz { from: p.x, p.y; size: p.w, 26; corner: 13; cursor: pointer; role: button; label: "{p.label}"; show: nd_kind == 12 and g > 0.9 }
            on press shz { emit nd_sh(p.code) }
        }
        // a branch: its title, and what it holds
        group { show: nd_kind == 13; opacity: nd_cf
            clip box { from: nb_x, nb_y; size: nb_w, nb_h; corner: nb_r }
            text nd_brt { at: nb_x + 20, nb_y + 22; anchor: left center; size: 10; weight: 700; family: "Share Tech Mono"; color: nd_acc }
            text nd_brs { at: nb_x + nb_w - 20, nb_y + 22; anchor: right center; align: right; size: 9; family: "Share Tech Mono"; color: fl.muted; width: 300; lines: 1 }
            line { from: nb_x + 16, nb_y + 38; to: nb_x + nb_w - 16, nb_y + 38; width: 1; color: fl.trace_dim }
            // the calendar: a month of six weeks, today lit; ‹ › for the months either side
            group { show: nd_bk == 1
                text "M" { at: nb_x + 34 + 0 * 66, nb_y + 54; anchor: center; align: center; size: 9; weight: 700; family: "Share Tech Mono"; color: fl.muted }
                text "T" { at: nb_x + 34 + 1 * 66, nb_y + 54; anchor: center; align: center; size: 9; weight: 700; family: "Share Tech Mono"; color: fl.muted }
                text "W" { at: nb_x + 34 + 2 * 66, nb_y + 54; anchor: center; align: center; size: 9; weight: 700; family: "Share Tech Mono"; color: fl.muted }
                text "T" { at: nb_x + 34 + 3 * 66, nb_y + 54; anchor: center; align: center; size: 9; weight: 700; family: "Share Tech Mono"; color: fl.muted }
                text "F" { at: nb_x + 34 + 4 * 66, nb_y + 54; anchor: center; align: center; size: 9; weight: 700; family: "Share Tech Mono"; color: fl.muted }
                text "S" { at: nb_x + 34 + 5 * 66, nb_y + 54; anchor: center; align: center; size: 9; weight: 700; family: "Share Tech Mono"; color: fl.muted }
                text "S" { at: nb_x + 34 + 6 * 66, nb_y + 54; anchor: center; align: center; size: 9; weight: 700; family: "Share Tech Mono"; color: fl.muted }
                for d in cal {
                    let col = d.index - floor(d.index / 7) * 7
                    let rw = floor(d.index / 7)
                    ellipse { at: nb_x + 34 + col * 66, nb_y + 76 + rw * 26; radius: 11; color: nd_acc; show: d.today }
                    text d.d { at: nb_x + 34 + col * 66, nb_y + 76 + rw * 26; anchor: center; align: center; size: 11; weight: if(d.today, 700, 500); family: "Share Tech Mono"; color: if(d.today, fl.ground, if(d.muted, fl.trace_lit, if(d.weekend, nd_acc, fl.engrave))) }
                }
            }
            text "‹" { at: nb_x + nb_w - 70, nb_y + 22; anchor: center; size: 16; family: "Exo 2"; color: if(brz1.hover, nd_acc, fl.engrave); show: nd_bk == 1 or nd_bk == 5 }
            zone box brz1 { from: nb_x + nb_w - 70 - 12, nb_y + 8; size: 24, 28; cursor: pointer; role: button; label: "Back"; show: nd_kind == 13 and (nd_bk == 1 or nd_bk == 5) }
            on press brz1 { emit nd_br(1) }
            text "›" { at: nb_x + nb_w - 40, nb_y + 22; anchor: center; size: 16; family: "Exo 2"; color: if(brz2.hover, nd_acc, fl.engrave); show: nd_bk == 1 or nd_bk == 5 }
            zone box brz2 { from: nb_x + nb_w - 40 - 12, nb_y + 8; size: 24, 28; cursor: pointer; role: button; label: "On"; show: nd_kind == 13 and (nd_bk == 1 or nd_bk == 5) }
            on press brz2 { emit nd_br(2) }
            // notes: a line to write one, the newest under it (pinned first); a press copies one
            group { show: nd_bk == 2
                box { from: nb_x + 16, nb_y + 48; size: nb_w - 32, 30; corner: 15 * max(0.3, nd_rnd); color: fl.well }
                text "+" { at: nb_x + 32, nb_y + 63; anchor: center; size: 14; family: "Exo 2"; color: nd_acc }
                input nd_nq { at: nb_x + 46, nb_y + 54; width: nb_w - 80; size: 12; family: "Exo 2"; color: fl.engrave; selection: fl.hull_raised; placeholder: "write a note, Return keeps it" }
            }
            // a list: notes, the clipboard, the stash — a row each
            group { show: (nd_bk >= 2 and nd_bk <= 4) or nd_bk == 6
                for r in br {
                    let ry = nb_y + if(nd_bk == 2, 86, 48) + r.index * 30
                    box { from: nb_x + 12, ry; size: nb_w - 24, 27; corner: 8 * nd_rnd; color: fl.well; opacity: if(brr.hover, 0.9, 0.35) }
                    ellipse { at: nb_x + 24, ry + 13.5; radius: 2.5; color: nd_acc; show: r.pinned }
                    text r.label { at: nb_x + 34, ry + 13.5; anchor: left center; size: 11; family: "Exo 2"; color: fl.engrave; width: nb_w - 170; lines: 1 }
                    text r.detail { at: nb_x + nb_w - 22, ry + 13.5; anchor: right center; align: right; size: 9; family: "Share Tech Mono"; color: fl.muted; width: 110; lines: 1 }
                    zone box brr { from: nb_x + 12, ry; size: nb_w - 24, 27; cursor: pointer; role: item; label: "{r.label}"; show: nd_kind == 13 and ((nd_bk >= 2 and nd_bk <= 4) or nd_bk == 6) }
                    on press brr { emit nd_br(10 + r.index) }
                }
            }
            // the wallpaper: a strip of pictures round the one worn; the wheel or ‹ › walk it, a press wears one
            group { show: nd_bk == 5
                for w in wl {
                    let wx = nb_x + 16 + w.index * ((nb_w - 32) / 7)
                    let ww = (nb_w - 32) / 7 - 6
                    group { clip box { from: wx, nb_y + 58; size: ww, ww * 0.5625; corner: 6 * nd_rnd }
                        image w.img { at: wx, nb_y + 58; size: ww, ww * 0.5625; fit: cover } }
                    box { from: wx, nb_y + 58; size: ww, ww * 0.5625; corner: 6 * nd_rnd; stroke: if(w.on, 2, 1); color: if(w.on, nd_acc, if(wlz.hover, fl.trace_lit, fl.trace_dim)) }
                    zone box wlz { from: wx, nb_y + 58; size: ww, ww * 0.5625; cursor: pointer; role: item; label: "Wear this picture"; show: nd_kind == 13 and nd_bk == 5 }
                    on press wlz { emit nd_br(10 + w.index) }
                    on scroll wlz { emit nd_br(if(wheel > 0, 1, 2)) }
                }
            }
        }
        on submit nd_nq { emit nd_br(90) }
        on change nd_kb while nd_kb and nd_kind == 13 and nd_bk == 2 { focus nd_nq }
        // notices: a stem drops from the node, and the cards branch from it one after another (each grows out of
        // the stem's foot: it slides down from it, opening as it comes)
        group { show: nd_kind == 2
            line { from: nb_x + nb_w / 2, nb_y + nb_h; to: nb_x + nb_w / 2, nb_y + nb_h + 22 * nd_grow; width: 1.5; color: nd_acc }
            for n in nc {
                let row = n.index
                let g = clamp(nd_grow * nd_gk - row * 0.32 * nd_stg, 0, 1)
                let rise = (n.y - nb_y - nb_h) * (1 - g)
                let ncr = max(3, 12 * nd_rnd)
                group { opacity: g; move: 0, 0 - rise; pivot: n.x + n.w / 2, n.y; scale: 0.7 + 0.3 * g
                    line { from: nb_x + nb_w / 2, n.y - 8; to: n.x + n.w / 2, n.y; width: 1; color: fl.trace_lit; opacity: 0.6 }
                    group { glow: 16, 0.35, #000000
                        box { from: n.x, n.y; size: n.w, n.h; corner: ncr; color: fl.hull; opacity: 0.96 } }
                    box { from: n.x, n.y; size: n.w, n.h; corner: ncr; stroke: 1; color: fl.trace_lit; opacity: 0.6 }
                    box { from: n.x, n.y + 10; size: 3, n.h - 20; corner: 1; color: nd_acc }
                    // its time, draining along its floor (held while the pointer rests on the node)
                    box { from: n.x + 12, n.y + n.h - 3; size: (n.w - 24) * nd_ncs, 1.5; corner: 1; color: nd_acc; opacity: 0.6; show: row == 0 }
                    text n.app { at: n.x + 14, n.y + 16; anchor: left center; size: 9; weight: 700; family: "Share Tech Mono"; color: nd_acc; width: n.w - 60; lines: 1 }
                    text n.title { at: n.x + 14, n.y + 37; anchor: left center; size: 12; family: "Exo 2"; color: fl.engrave; width: if(n.hasact, n.w - 120, n.w - 40); lines: 1 }
                    // opened to be read: the message under the title (D245)
                    text n.body { at: n.x + 14, n.y + 54; anchor: left top; size: 11; family: "Exo 2"; color: fl.muted; width: n.w - 28; lines: 6; show: n.open }
                    group { show: n.hasact
                        box { from: n.x + n.w - 100, n.y + 27; size: 64, 20; corner: 10 * nd_rnd; stroke: 1; color: nd_acc }
                        text n.act { at: n.x + n.w - 68, n.y + 37; anchor: center; align: center; size: 9; family: "Share Tech Mono"; color: nd_acc; width: 58; lines: 1 } }
                    text "×" { at: n.x + n.w - 18, n.y + 16; anchor: center; size: 14; family: "Exo 2"; color: if(ncx.hover, fl.engrave, fl.muted) }
                }
                zone box ncz { from: n.x, n.y; size: n.w, n.h; corner: 12; cursor: pointer; role: button; label: "{n.app}: {n.title}"; show: nd_kind == 2 and g > 0.9 and not nd_studio }
                on press ncz { emit nd_nc(row * 10) }
                let nchv = ncz.hover
                on change nchv { emit nd_ncx(if(nchv, row + 1, 0)) }
                zone box nca { from: n.x + n.w - 100, n.y + 27; size: 64, 20; cursor: pointer; role: button; label: "{n.act}"; show: nd_kind == 2 and n.hasact and g > 0.9 and not nd_studio }
                on press nca { emit nd_nc(row * 10 + 1) }
                zone box ncx { from: n.x + n.w - 30, n.y + 4; size: 24, 24; cursor: pointer; role: button; label: "Dismiss"; show: nd_kind == 2 and g > 0.9 and not nd_studio }
                on press ncx { emit nd_nc(row * 10 + 9) }
            }
            // more than fit: how many wait
            text "+{nd_more, 0} MORE" { at: nb_x + nb_w / 2, nb_y + nb_h + 22 + nd_ncn * 66 + 8; anchor: center; align: center; size: 9; weight: 700; family: "Share Tech Mono"; color: fl.muted; opacity: nd_grow; show: nd_more > 0.5 }
        }
        // volume or brightness: the node becomes a gauge
        group { show: nd_kind == 3; opacity: nd_cf
            box { from: nb_x + 3, nb_y + 3; size: max(0, (nb_w - 6) * nd_vol), nb_h - 6; corner: max(0, nb_r - 3); color: nd_acc; opacity: 0.85 }
            text nd_vlabel { at: nb_x + nb_w / 2, nb_y + nb_h + 12; anchor: center; align: center; size: 9; family: "Share Tech Mono"; color: fl.engrave; opacity: nd_grow } }
        // workspaces: a rail drawn out from the middle, the active one a bead that slides along it — or (D255) the rail
        // sliding in from the side it came from, flipping over, the bead pulsing, or only the number
        group { show: nd_kind == 4 and nd_wss == 4; opacity: nd_cf
            group { move: nd_wsoff * 2 * (1 - nd_grow), 0
                text nd_wsl { at: nb_x + nb_w / 2, nb_y + nb_h / 2; anchor: center; align: center; size: 18; weight: 700; family: "Share Tech Mono"; color: nd_acc } } }
        group { show: nd_kind == 4 and nd_wss != 4; opacity: nd_cf; move: if(nd_wss == 1, nd_wsoff * (1 - nd_grow), 0), 0; pivot: nb_x + nb_w / 2, nb_y + nb_h / 2; scale: 1, if(nd_wss == 2, max(0.05, abs(1 - 2 * (1 - nd_grow))), 1)
            line { from: nb_x + nb_w / 2 - (nb_w / 2 - 18) * nd_grow, nb_y + nb_h / 2; to: nb_x + nb_w / 2 + (nb_w / 2 - 18) * nd_grow, nb_y + nb_h / 2; width: 1; color: fl.trace_lit; opacity: 0.7 }
            for r in rl {
                let rx = nb_x + nb_w / 2 + (r.x - nb_x - nb_w / 2) * nd_grow
                ellipse { at: rx, nb_y + nb_h / 2; radius: if(r.used, 3.5, 2); color: if(r.used, fl.engrave, fl.muted) }
                zone box rz { from: r.x - 20, nb_y; size: 40, nb_h; cursor: pointer; role: button; label: "Workspace {r.n}"; show: nd_kind == 4 and not nd_studio }
                on press rz { emit nd_ws(r.index) }
            }
            group { glow: 12, 0.8 * nd_glow, nd_glc
                ellipse { at: nd_bead, nb_y + nb_h / 2; radius: 10 * nd_grow + if(nd_wss == 3, 9 * (1 - nd_grow), 0); color: nd_acc } }
            ellipse { at: nd_bead, nb_y + nb_h / 2; radius: 10 + 26 * (1 - nd_grow); stroke: 1.5; color: nd_acc; opacity: 0.8 * nd_grow * (1 - nd_grow) * 4; show: nd_wss == 3 }
            for r in rl { text r.n { at: r.x, nb_y + nb_h / 2; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: fl.ground; show: r.on and nd_grow > 0.6 } }
        }
        // system (D249): spokes from the node, rings in a row under it, or a card each with its last readings; a press
        // on one that runs deeper (the processor, the memory, the heat) opens btop
        group { show: nd_kind == 5
            for p in sy {
                let g = clamp(nd_grow * nd_gk - p.index * 0.2 * nd_stg, 0, 1)
                let n5 = sy.count
                // the spokes
                group { show: nd_sys == 0
                    let px = nb_x + nb_w / 2 + (p.x - nb_x - nb_w / 2) * g
                    let py = nb_y + nb_h / 2 + (p.y - nb_y - nb_h / 2) * g
                    line { from: nb_x + nb_w / 2, nb_y + nb_h / 2; to: px, py; width: 1; color: fl.trace_lit; opacity: 0.7 }
                    group { opacity: g; pivot: px, py; scale: 0.5 + 0.5 * g
                        box { from: px - 46, py - 14; size: 92, 28; corner: 14 * nd_rnd; color: fl.hull; opacity: 0.95 }
                        box { from: px - 46, py - 14; size: 92, 28; corner: 14 * nd_rnd; stroke: 1; color: if(p.hot, fl.ember, if(syz0.hover, fl.engrave, nd_acc)); opacity: 0.8 }
                        text p.label { at: px - 38, py; anchor: left center; size: 8; family: "Share Tech Mono"; color: fl.muted }
                        text p.value { at: px + 38, py; anchor: right center; size: 11; weight: 700; family: "Share Tech Mono"; color: if(p.hot, fl.ember, fl.engrave) }
                    }
                    zone box syz0 { from: p.x - 46, p.y - 14; size: 92, 28; cursor: if(p.deep, pointer, default); role: button; label: "{p.label} {p.value}"; show: nd_kind == 5 and nd_sys == 0 and g > 0.9 }
                    on press syz0 { emit nd_sys(p.index) }
                }
                // the rings: a gauge each, in a row under the node
                group { show: nd_sys == 1; opacity: g
                    let rx = nb_x + nb_w / 2 + (p.index - (n5 - 1) / 2) * 86
                    let ry = nb_y + nb_h + 48 - 20 * (1 - g)
                    group { glow: 10, if(syz1.hover, 0.6, 0.25) * nd_gw, if(p.hot, fl.ember, nd_glc)
                        arc { at: rx, ry; radius: 32; span: 360deg; width: 4; color: fl.trace_dim; opacity: 0.6 }
                        arc { at: rx, ry; radius: 32; span: p.frac * 360deg * g; rotate: p.frac * 180deg * g; width: 4; color: if(p.hot, fl.ember, nd_acc) } }
                    text p.value { at: rx, ry - 3; anchor: center; align: center; size: 12; weight: 700; family: "Share Tech Mono"; color: if(p.hot, fl.ember, fl.engrave) }
                    text p.label { at: rx, ry + 12; anchor: center; align: center; size: 8; family: "Share Tech Mono"; color: fl.muted }
                    zone box syz1 { from: rx - 36, ry - 36; size: 72, 72; corner: 36; cursor: if(p.deep, pointer, default); role: button; label: "{p.label} {p.value}"; show: nd_kind == 5 and nd_sys == 1 and g > 0.9 }
                    on press syz1 { emit nd_sys(p.index) }
                }
                // the graphs: a card each, its last readings as bars, the newest at the right
                group { show: nd_sys == 2; opacity: g
                    let gx = nb_x + nb_w / 2 + (p.index - (n5 - 1) / 2) * 134 - 62
                    let gy = nb_y + nb_h + 18 - 14 * (1 - g)
                    box { from: gx, gy; size: 124, 64; corner: 12 * nd_rnd; color: fl.hull; opacity: 0.95 }
                    box { from: gx, gy; size: 124, 64; corner: 12 * nd_rnd; stroke: 1; color: if(p.hot, fl.ember, if(syz2.hover, nd_acc, fl.trace_lit)); opacity: 0.7 }
                    text p.label { at: gx + 10, gy + 13; anchor: left center; size: 8; family: "Share Tech Mono"; color: fl.muted }
                    text p.value { at: gx + 114, gy + 13; anchor: right center; size: 11; weight: 700; family: "Share Tech Mono"; color: if(p.hot, fl.ember, fl.engrave) }
                    box { from: gx + 8 + 0 * 5.4, gy + 58 - p.h0 * 32; size: 3.6, p.h0 * 32 + 1; corner: 1; color: if(p.hot, fl.ember, nd_acc); opacity: 0.4 + 0.5 * p.h0 }
                    box { from: gx + 8 + 1 * 5.4, gy + 58 - p.h1 * 32; size: 3.6, p.h1 * 32 + 1; corner: 1; color: if(p.hot, fl.ember, nd_acc); opacity: 0.4 + 0.5 * p.h1 }
                    box { from: gx + 8 + 2 * 5.4, gy + 58 - p.h2 * 32; size: 3.6, p.h2 * 32 + 1; corner: 1; color: if(p.hot, fl.ember, nd_acc); opacity: 0.4 + 0.5 * p.h2 }
                    box { from: gx + 8 + 3 * 5.4, gy + 58 - p.h3 * 32; size: 3.6, p.h3 * 32 + 1; corner: 1; color: if(p.hot, fl.ember, nd_acc); opacity: 0.4 + 0.5 * p.h3 }
                    box { from: gx + 8 + 4 * 5.4, gy + 58 - p.h4 * 32; size: 3.6, p.h4 * 32 + 1; corner: 1; color: if(p.hot, fl.ember, nd_acc); opacity: 0.4 + 0.5 * p.h4 }
                    box { from: gx + 8 + 5 * 5.4, gy + 58 - p.h5 * 32; size: 3.6, p.h5 * 32 + 1; corner: 1; color: if(p.hot, fl.ember, nd_acc); opacity: 0.4 + 0.5 * p.h5 }
                    box { from: gx + 8 + 6 * 5.4, gy + 58 - p.h6 * 32; size: 3.6, p.h6 * 32 + 1; corner: 1; color: if(p.hot, fl.ember, nd_acc); opacity: 0.4 + 0.5 * p.h6 }
                    box { from: gx + 8 + 7 * 5.4, gy + 58 - p.h7 * 32; size: 3.6, p.h7 * 32 + 1; corner: 1; color: if(p.hot, fl.ember, nd_acc); opacity: 0.4 + 0.5 * p.h7 }
                    box { from: gx + 8 + 8 * 5.4, gy + 58 - p.h8 * 32; size: 3.6, p.h8 * 32 + 1; corner: 1; color: if(p.hot, fl.ember, nd_acc); opacity: 0.4 + 0.5 * p.h8 }
                    box { from: gx + 8 + 9 * 5.4, gy + 58 - p.h9 * 32; size: 3.6, p.h9 * 32 + 1; corner: 1; color: if(p.hot, fl.ember, nd_acc); opacity: 0.4 + 0.5 * p.h9 }
                    box { from: gx + 8 + 10 * 5.4, gy + 58 - p.h10 * 32; size: 3.6, p.h10 * 32 + 1; corner: 1; color: if(p.hot, fl.ember, nd_acc); opacity: 0.4 + 0.5 * p.h10 }
                    box { from: gx + 8 + 11 * 5.4, gy + 58 - p.h11 * 32; size: 3.6, p.h11 * 32 + 1; corner: 1; color: if(p.hot, fl.ember, nd_acc); opacity: 0.4 + 0.5 * p.h11 }
                    box { from: gx + 8 + 12 * 5.4, gy + 58 - p.h12 * 32; size: 3.6, p.h12 * 32 + 1; corner: 1; color: if(p.hot, fl.ember, nd_acc); opacity: 0.4 + 0.5 * p.h12 }
                    box { from: gx + 8 + 13 * 5.4, gy + 58 - p.h13 * 32; size: 3.6, p.h13 * 32 + 1; corner: 1; color: if(p.hot, fl.ember, nd_acc); opacity: 0.4 + 0.5 * p.h13 }
                    box { from: gx + 8 + 14 * 5.4, gy + 58 - p.h14 * 32; size: 3.6, p.h14 * 32 + 1; corner: 1; color: if(p.hot, fl.ember, nd_acc); opacity: 0.4 + 0.5 * p.h14 }
                    box { from: gx + 8 + 15 * 5.4, gy + 58 - p.h15 * 32; size: 3.6, p.h15 * 32 + 1; corner: 1; color: if(p.hot, fl.ember, nd_acc); opacity: 0.4 + 0.5 * p.h15 }
                    box { from: gx + 8 + 16 * 5.4, gy + 58 - p.h16 * 32; size: 3.6, p.h16 * 32 + 1; corner: 1; color: if(p.hot, fl.ember, nd_acc); opacity: 0.4 + 0.5 * p.h16 }
                    box { from: gx + 8 + 17 * 5.4, gy + 58 - p.h17 * 32; size: 3.6, p.h17 * 32 + 1; corner: 1; color: if(p.hot, fl.ember, nd_acc); opacity: 0.4 + 0.5 * p.h17 }
                    box { from: gx + 8 + 18 * 5.4, gy + 58 - p.h18 * 32; size: 3.6, p.h18 * 32 + 1; corner: 1; color: if(p.hot, fl.ember, nd_acc); opacity: 0.4 + 0.5 * p.h18 }
                    box { from: gx + 8 + 19 * 5.4, gy + 58 - p.h19 * 32; size: 3.6, p.h19 * 32 + 1; corner: 1; color: if(p.hot, fl.ember, nd_acc); opacity: 0.4 + 0.5 * p.h19 }
                    zone box syz2 { from: gx, gy; size: 124, 64; corner: 12; cursor: if(p.deep, pointer, default); role: button; label: "{p.label} {p.value}"; show: nd_kind == 5 and nd_sys == 2 and g > 0.9 }
                    on press syz2 { emit nd_sys(p.index) }
                }
            }
            ellipse { at: nb_x + nb_w / 2, nb_y + nb_h / 2; radius: 5; color: nd_acc }
        }
        // the launcher: the node widens into a search line, the results drop out of it one after another
        group { show: nd_kind == 6; opacity: nd_cf
            text "›" { at: nb_x + 18, nb_y + nb_h / 2; anchor: center; size: 18; family: "Exo 2"; color: nd_acc }
            input nd_q { at: nb_x + 34, nb_y + nb_h / 2 - 9; width: nb_w - 50; size: 14; family: "Exo 2"; color: fl.engrave; selection: fl.well; placeholder: "search apps" }
        }
        for r in lr {
            let i = r.index
            let g = clamp(nd_grow * nd_gk - i * 0.18 * nd_stg, 0, 1)
            group { show: nd_kind == 6; opacity: g * nd_cf; move: 0, 0 - (r.y - nb_y - nb_h) * (1 - g)
                box { from: r.x, r.y; size: r.w, r.h; corner: max(2, 10 * nd_rnd); color: if(nd_sel == i, fl.hull_raised, fl.hull); opacity: 0.95 }
                box { from: r.x, r.y; size: 3, r.h; color: nd_acc; show: nd_sel == i }
                image r.icon { at: r.x + 12, r.y + 7; size: 28, 28; show: r.iconed }
                text r.letter { at: r.x + 26, r.y + 21; anchor: center; align: center; size: 13; weight: 700; family: "Share Tech Mono"; color: nd_acc; show: not r.iconed }
                text r.name { at: r.x + 52, r.y + 21; anchor: left center; size: 13; family: "Exo 2"; color: fl.engrave; width: r.w - 140; lines: 1 }
                text r.tag { at: r.x + r.w - 16, r.y + 21; anchor: right center; align: right; size: 8; weight: 700; family: "Share Tech Mono"; color: fl.muted; width: 80; lines: 1 }
            }
            zone box lz { from: r.x, r.y; size: r.w, r.h; cursor: pointer; role: button; label: "Open {r.name}"; show: nd_kind == 6 and not nd_studio }
            on press lz { emit nd_lr(i) }
        }
        on submit nd_q { emit nd_key(13) }
        on change nd_kb while nd_kb and nd_kind == 6 and not nd_studio { focus nd_q }
        // the capsule: while a timer, a focus phase, the stopwatch or a near alarm runs, the seed is a capsule with its
        // value, a line that drains, and a sweep of light (faster, and warm, in the last minute)
        group { show: nd_kind == 0 and nd_cap
            let cw = if(nd_capu, fl.ember, nd_acc)
            group { glow: 10, 0.5 * nd_gw + if(nd_capu, 0.3, 0), if(nd_capu, fl.ember, nd_glc)
                box { from: nb_x, nb_y; size: nb_w, nb_h; corner: nb_r; color: fl.hull; opacity: 0.95 } }
            box { from: nb_x, nb_y; size: nb_w, nb_h; corner: nb_r; stroke: 1; color: cw; opacity: 0.7 }
            group { clip box { from: nb_x, nb_y; size: nb_w, nb_h; corner: nb_r }
                box { from: nb_x - 24 + fract(nd_swp / 360) * (nb_w + 24), nb_y; size: 24, nb_h; color: cw; opacity: 0.18 }
                box { from: nb_x + 8, nb_y + nb_h - 3; size: (nb_w - 16) * nd_capf, 1.5; color: cw; opacity: 0.9 } }
            text nd_capm { at: nb_x + 10, nb_y + nb_h / 2; anchor: left center; size: 8; weight: 700; family: "Share Tech Mono"; color: fl.muted; opacity: nd_cf }
            text nd_capt { at: nb_x + nb_w - 10, nb_y + nb_h / 2; anchor: right center; align: right; size: 11; weight: 700; family: "Share Tech Mono"; color: if(nd_capu, fl.ember, fl.engrave); opacity: nd_cf }
        }
        // the panel: the mode on stage, its readout big, its progress as a strip of cells, its controls; the other
        // three on the rail along the floor, still counting
        group { show: nd_kind == 8; opacity: nd_cf
            clip box { from: nb_x, nb_y; size: nb_w, nb_h; corner: nb_r }
            text "TIMER" { at: nb_x + 20, nb_y + 20; anchor: left center; size: 9; weight: 700; family: "Share Tech Mono"; color: if(nd_tmm == 0, nd_acc, if(tmz0.hover, fl.engrave, fl.muted)) }
            box { from: nb_x + 20, nb_y + 29; size: 24, 1.5; color: nd_acc; show: nd_tmm == 0 }
            zone box tmz0 { from: nb_x + 20 - 6, nb_y + 8; size: 92, 26; cursor: pointer; role: tab; label: "Timer"; selected: nd_tmm == 0; show: nd_kind == 8 }
            on press tmz0 { emit nd_tm(0) }
            text "STOPWATCH" { at: nb_x + 116, nb_y + 20; anchor: left center; size: 9; weight: 700; family: "Share Tech Mono"; color: if(nd_tmm == 1, nd_acc, if(tmz1.hover, fl.engrave, fl.muted)) }
            box { from: nb_x + 116, nb_y + 29; size: 24, 1.5; color: nd_acc; show: nd_tmm == 1 }
            zone box tmz1 { from: nb_x + 116 - 6, nb_y + 8; size: 92, 26; cursor: pointer; role: tab; label: "Stopwatch"; selected: nd_tmm == 1; show: nd_kind == 8 }
            on press tmz1 { emit nd_tm(1) }
            text "FOCUS" { at: nb_x + 212, nb_y + 20; anchor: left center; size: 9; weight: 700; family: "Share Tech Mono"; color: if(nd_tmm == 2, nd_acc, if(tmz2.hover, fl.engrave, fl.muted)) }
            box { from: nb_x + 212, nb_y + 29; size: 24, 1.5; color: nd_acc; show: nd_tmm == 2 }
            zone box tmz2 { from: nb_x + 212 - 6, nb_y + 8; size: 92, 26; cursor: pointer; role: tab; label: "Focus"; selected: nd_tmm == 2; show: nd_kind == 8 }
            on press tmz2 { emit nd_tm(2) }
            text "ALARM" { at: nb_x + 308, nb_y + 20; anchor: left center; size: 9; weight: 700; family: "Share Tech Mono"; color: if(nd_tmm == 3, nd_acc, if(tmz3.hover, fl.engrave, fl.muted)) }
            box { from: nb_x + 308, nb_y + 29; size: 24, 1.5; color: nd_acc; show: nd_tmm == 3 }
            zone box tmz3 { from: nb_x + 308 - 6, nb_y + 8; size: 92, 26; cursor: pointer; role: tab; label: "Alarm"; selected: nd_tmm == 3; show: nd_kind == 8 }
            on press tmz3 { emit nd_tm(3) }
            // the readout: a 5×7 matrix of mooi's own, every cell there and dim, the lit ones in its colour
            repeat gc in 0..48 { repeat gr in 0..7 { box { from: nb_x + 20 + gc * 6, nb_y + 44 + gr * 6; size: 5, 5; corner: 1; color: fl.trace_dim; opacity: 0.35; show: gc < nd_pxw } } }
            group { glow: 8, 0.5 * nd_gw, nd_glc
                for q in px { box { from: nb_x + 20 + q.x * 6, nb_y + 44 + q.y * 6; size: 5, 5; corner: 1; color: nd_acc } } }
            text nd_tms { at: nb_x + 22, nb_y + 94; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.muted; width: 300; lines: 1 }
            repeat cl in 0..30 { box { from: nb_x + 20 + cl * 10, nb_y + 108; size: 7, 5; corner: 1; color: if(cl < nd_tmp * 30, nd_acc, fl.trace_dim); opacity: if(cl < nd_tmp * 30, 0.9, 0.6) } }
            box { from: nb_x + nb_w - 214, nb_y + 46; size: 94, 30; corner: 15 * max(0.3, nd_rnd); color: nd_acc; opacity: if(true, 0.9, if(tmb10.hover, 0.18, 0)) }
            box { from: nb_x + nb_w - 214, nb_y + 46; size: 94, 30; corner: 15 * max(0.3, nd_rnd); stroke: 1; color: if(true, nd_acc, fl.trace_lit) }
            text nd_tmgl { at: nb_x + nb_w - 214 + 47, nb_y + 61; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(true, fl.ground, fl.engrave) }
            zone box tmb10 { from: nb_x + nb_w - 214, nb_y + 46; size: 94, 30; cursor: pointer; role: button; label: "{nd_tmgl}"; show: nd_kind == 8 }
            on press tmb10 { emit nd_tm(10) }
            box { from: nb_x + nb_w - 112, nb_y + 46; size: 94, 30; corner: 15 * max(0.3, nd_rnd); color: nd_acc; opacity: if(false, 0.9, if(tmb11.hover, 0.18, 0)) }
            box { from: nb_x + nb_w - 112, nb_y + 46; size: 94, 30; corner: 15 * max(0.3, nd_rnd); stroke: 1; color: if(false, nd_acc, fl.trace_lit) }
            text nd_tm2l { at: nb_x + nb_w - 112 + 47, nb_y + 61; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(false, fl.ground, fl.engrave) }
            zone box tmb11 { from: nb_x + nb_w - 112, nb_y + 46; size: 94, 30; cursor: pointer; role: button; label: "{nd_tm2l}"; show: nd_kind == 8 }
            on press tmb11 { emit nd_tm(11) }
            for k in tc {
                let kx = nb_x + nb_w - 214 + k.index * 50
                box { from: kx, nb_y + 86; size: 44, 24; corner: 12 * max(0.3, nd_rnd); stroke: 1; color: if(tcz.hover, nd_acc, fl.trace_lit) }
                text k.label { at: kx + 22, nb_y + 98; anchor: center; align: center; size: 9; weight: 700; family: "Share Tech Mono"; color: fl.engrave; width: 42; lines: 1 }
                zone box tcz { from: kx, nb_y + 86; size: 44, 24; cursor: pointer; role: button; label: "{k.label}"; show: nd_kind == 8 }
                on press tcz { emit nd_tm(k.code) }
            }
            line { from: nb_x + 16, nb_y + nb_h - 36; to: nb_x + nb_w - 16, nb_y + nb_h - 36; width: 1; color: fl.trace_dim }
            for r in tr {
                let rx = nb_x + 20 + r.index * ((nb_w - 40) / 3)
                ellipse { at: rx + 3, nb_y + nb_h - 18; radius: 2.5; color: if(r.on, nd_acc, fl.trace_dim) }
                text r.label { at: rx + 12, nb_y + nb_h - 18; anchor: left center; size: 8; weight: 700; family: "Share Tech Mono"; color: fl.muted }
                text r.value { at: rx + 90, nb_y + nb_h - 18; anchor: left center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(r.on, fl.engrave, fl.muted) }
                zone box trz { from: rx, nb_y + nb_h - 30; size: (nb_w - 40) / 3 - 8, 24; cursor: pointer; role: button; label: "{r.label} {r.value}"; show: nd_kind == 8 }
                on press trz { emit nd_tm(r.m) }
            }
        }
        // something finished: the node becomes a card that pulses until it is answered (a click on it, Esc, Space,
        // Return, or OK) — never by the pointer merely resting there, never by folding away
        group { show: nd_kind == 9
            group { glow: 20, 0.45 + 0.35 * sin(nd_dph), fl.ember
                box { from: nb_x, nb_y; size: nb_w, nb_h; corner: nb_r; color: fl.hull; opacity: 0.97 } }
            box { from: nb_x, nb_y; size: nb_w, nb_h; corner: nb_r; stroke: 1.5; color: fl.ember; opacity: 0.6 + 0.3 * sin(nd_dph) }
            group { opacity: nd_cf
                text nd_dnt { at: nb_x + 22, nb_y + 28; anchor: left center; size: 15; weight: 700; family: "Exo 2"; color: fl.engrave; width: nb_w - 140; lines: 1 }
                text nd_dnd { at: nb_x + 22, nb_y + 50; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.muted; width: nb_w - 140; lines: 1 }
                box { from: nb_x + nb_w - 92, nb_y + nb_h / 2 - 15; size: 72, 30; corner: 15 * max(0.3, nd_rnd); color: fl.ember; opacity: 0.9 }
                text "OK" { at: nb_x + nb_w - 56, nb_y + nb_h / 2; anchor: center; align: center; size: 11; weight: 700; family: "Share Tech Mono"; color: fl.ground } }
            zone box dnz { from: nb_x, nb_y; size: nb_w, nb_h; corner: nb_r; cursor: pointer; role: button; label: "{nd_dnt}: OK"; show: nd_kind == 9 }
            on press dnz { emit nd_dn }
        }
        // the player: the cover, the song, where in it (drag to go there), its transport, the music mirrored round
        // the middle along its floor, and three meters on the right — volume, the screen's light, the microphone
        group { show: nd_kind == 11; opacity: nd_cf
            clip box { from: nb_x, nb_y; size: nb_w, nb_h; corner: nb_r }
            let pw = nb_w - 164 - 160
            group { clip box { from: nb_x + 16, nb_y + 16; size: 132, 132; corner: if(nd_cov == 1, 66, max(3, 14 * nd_rnd)) }
                box { from: nb_x + 16, nb_y + 16; size: 132, 132; color: fl.well }
                image nd_cover { at: nb_x + 16, nb_y + 16; size: 132, 132; fit: cover; show: nd_arted } }
            text nd_title { at: nb_x + 164, nb_y + 32; anchor: left center; size: 16; weight: 700; family: "Exo 2"; color: fl.engrave; width: pw - 66; lines: 1 }
            text nd_artist { at: nb_x + 164, nb_y + 54; anchor: left center; size: 11; family: "Share Tech Mono"; color: fl.muted; width: pw; lines: 1 }
            box { from: nb_x + 164, nb_y + 78; size: pw, 3; corner: 1.5; color: fl.trace_dim }
            box { from: nb_x + 164, nb_y + 78; size: pw * nd_prog, 3; corner: 1.5; color: nd_acc }
            ellipse { at: nb_x + 164 + pw * nd_prog, nb_y + 79.5; radius: if(pkz.hover, 7, 5); color: nd_acc }
            text nd_pos { at: nb_x + 164, nb_y + 94; anchor: left center; size: 9; family: "Share Tech Mono"; color: fl.muted }
            text nd_len { at: nb_x + 164 + pw, nb_y + 94; anchor: right center; align: right; size: 9; family: "Share Tech Mono"; color: fl.muted }
            zone box pkz { from: nb_x + 158, nb_y + 68; size: pw + 12, 22; cursor: pointer; role: slider; label: "Where in the song"; value: "{nd_pos}"; show: nd_kind == 11 }
            on press pkz { emit nd_seek(round(clamp((pointer.x - nb_x - 164) / pw, 0, 1) * 1000)) }
            on drag pkz { emit nd_seek(round(clamp((pointer.x - nb_x - 164) / pw, 0, 1) * 1000)) }
            group { show: not nd_mix
                group { pivot: nb_x + 164 + 18, nb_y + 127; scale: if(pbz1.hover, 1.1, 1)
                    ellipse { at: nb_x + 164 + 18, nb_y + 127; radius: 17; color: nd_acc; opacity: if(nd_shuf, 0.22, if(pbz1.hover, 0.12, 0)) }
                    text "⤮" { at: nb_x + 164 + 18, nb_y + 127; anchor: center; align: center; size: 15; family: "Exo 2"; color: if(nd_shuf, nd_acc, fl.engrave) }
                }
                zone box pbz1 { from: nb_x + 164 + 18 - 17, nb_y + 127 - 17; size: 34, 34; corner: 17; cursor: pointer; role: button; label: "Shuffle"; show: nd_kind == 11 }
                on press pbz1 { emit nd_pl(1) }
                group { pivot: nb_x + 164 + 62, nb_y + 127; scale: if(pbz2.hover, 1.1, 1)
                    ellipse { at: nb_x + 164 + 62, nb_y + 127; radius: 17; color: nd_acc; opacity: if(false, 0.22, if(pbz2.hover, 0.12, 0)) }
                    box { from: nb_x + 164 + 54, nb_y + 120; size: 2.5, 14; corner: 1; color: fl.engrave }
                    path { at: nb_x + 164 + 64, nb_y + 127; move 5, -7; line -5, 0; line 5, 7; close; color: fl.engrave }
                }
                zone box pbz2 { from: nb_x + 164 + 62 - 17, nb_y + 127 - 17; size: 34, 34; corner: 17; cursor: pointer; role: button; label: "Back"; show: nd_kind == 11 }
                on press pbz2 { emit nd_pl(2) }
                // play: the song's progress a ring round it
                arc { at: nb_x + 164 + 116, nb_y + 127; radius: 26; span: nd_prog * 360deg; rotate: nd_prog * 180deg; width: 2.5; color: nd_acc; opacity: 0.9 }
                arc { at: nb_x + 164 + 116, nb_y + 127; radius: 26; span: 360deg; width: 1; color: fl.trace_dim; opacity: 0.6 }
                group { pivot: nb_x + 164 + 116, nb_y + 127; scale: if(pbz3.hover, 1.1, 1)
                    ellipse { at: nb_x + 164 + 116, nb_y + 127; radius: 22; color: nd_acc; opacity: 0.92 }
                    path { at: nb_x + 164 + 118, nb_y + 127; move -6, -9; line 9, 0; line -6, 9; close; color: fl.ground; show: not nd_playing }
                    box { from: nb_x + 164 + 109.5, nb_y + 119; size: 4.5, 16; corner: 1; color: fl.ground; show: nd_playing }
                    box { from: nb_x + 164 + 118, nb_y + 119; size: 4.5, 16; corner: 1; color: fl.ground; show: nd_playing }
                }
                zone box pbz3 { from: nb_x + 164 + 116 - 22, nb_y + 127 - 22; size: 44, 44; corner: 22; cursor: pointer; role: button; label: "Play or pause"; show: nd_kind == 11 }
                on press pbz3 { emit nd_pl(3) }
                group { pivot: nb_x + 164 + 170, nb_y + 127; scale: if(pbz4.hover, 1.1, 1)
                    ellipse { at: nb_x + 164 + 170, nb_y + 127; radius: 17; color: nd_acc; opacity: if(false, 0.22, if(pbz4.hover, 0.12, 0)) }
                    path { at: nb_x + 164 + 168, nb_y + 127; move -5, -7; line 5, 0; line -5, 7; close; color: fl.engrave }
                    box { from: nb_x + 164 + 175.5, nb_y + 120; size: 2.5, 14; corner: 1; color: fl.engrave }
                }
                zone box pbz4 { from: nb_x + 164 + 170 - 17, nb_y + 127 - 17; size: 34, 34; corner: 17; cursor: pointer; role: button; label: "Next"; show: nd_kind == 11 }
                on press pbz4 { emit nd_pl(4) }
                group { pivot: nb_x + 164 + 214, nb_y + 127; scale: if(pbz5.hover, 1.1, 1)
                    ellipse { at: nb_x + 164 + 214, nb_y + 127; radius: 17; color: nd_acc; opacity: if(nd_loop > 0, 0.22, if(pbz5.hover, 0.12, 0)) }
                    text "⟲" { at: nb_x + 164 + 214, nb_y + 127; anchor: center; align: center; size: 15; family: "Exo 2"; color: if(nd_loop > 0, nd_acc, fl.engrave) }
                }
                zone box pbz5 { from: nb_x + 164 + 214 - 17, nb_y + 127 - 17; size: 34, 34; corner: 17; cursor: pointer; role: button; label: "Repeat"; show: nd_kind == 11 }
                on press pbz5 { emit nd_pl(5) }
                text "1" { at: nb_x + 164 + 226, nb_y + 116; anchor: center; size: 8; weight: 700; family: "Share Tech Mono"; color: nd_acc; show: nd_loop == 2 }
                // the music, mirrored: the low bands meet in the middle
                group { show: not nd_lyon
                    box { from: nb_x + 164 + 0 * pw / 32 + 1, nb_y + nb_h - 10 - nd_sp0 * 34; size: pw / 32 - 2, nd_sp0 * 34 + 1; corner: 1; color: nd_acc; opacity: 0.35 + 0.4 * nd_sp0 }
                    box { from: nb_x + 164 + 1 * pw / 32 + 1, nb_y + nb_h - 10 - nd_sp1 * 34; size: pw / 32 - 2, nd_sp1 * 34 + 1; corner: 1; color: nd_acc; opacity: 0.35 + 0.4 * nd_sp1 }
                    box { from: nb_x + 164 + 2 * pw / 32 + 1, nb_y + nb_h - 10 - nd_sp2 * 34; size: pw / 32 - 2, nd_sp2 * 34 + 1; corner: 1; color: nd_acc; opacity: 0.35 + 0.4 * nd_sp2 }
                    box { from: nb_x + 164 + 3 * pw / 32 + 1, nb_y + nb_h - 10 - nd_sp3 * 34; size: pw / 32 - 2, nd_sp3 * 34 + 1; corner: 1; color: nd_acc; opacity: 0.35 + 0.4 * nd_sp3 }
                    box { from: nb_x + 164 + 4 * pw / 32 + 1, nb_y + nb_h - 10 - nd_sp4 * 34; size: pw / 32 - 2, nd_sp4 * 34 + 1; corner: 1; color: nd_acc; opacity: 0.35 + 0.4 * nd_sp4 }
                    box { from: nb_x + 164 + 5 * pw / 32 + 1, nb_y + nb_h - 10 - nd_sp5 * 34; size: pw / 32 - 2, nd_sp5 * 34 + 1; corner: 1; color: nd_acc; opacity: 0.35 + 0.4 * nd_sp5 }
                    box { from: nb_x + 164 + 6 * pw / 32 + 1, nb_y + nb_h - 10 - nd_sp6 * 34; size: pw / 32 - 2, nd_sp6 * 34 + 1; corner: 1; color: nd_acc; opacity: 0.35 + 0.4 * nd_sp6 }
                    box { from: nb_x + 164 + 7 * pw / 32 + 1, nb_y + nb_h - 10 - nd_sp7 * 34; size: pw / 32 - 2, nd_sp7 * 34 + 1; corner: 1; color: nd_acc; opacity: 0.35 + 0.4 * nd_sp7 }
                    box { from: nb_x + 164 + 8 * pw / 32 + 1, nb_y + nb_h - 10 - nd_sp8 * 34; size: pw / 32 - 2, nd_sp8 * 34 + 1; corner: 1; color: nd_acc; opacity: 0.35 + 0.4 * nd_sp8 }
                    box { from: nb_x + 164 + 9 * pw / 32 + 1, nb_y + nb_h - 10 - nd_sp9 * 34; size: pw / 32 - 2, nd_sp9 * 34 + 1; corner: 1; color: nd_acc; opacity: 0.35 + 0.4 * nd_sp9 }
                    box { from: nb_x + 164 + 10 * pw / 32 + 1, nb_y + nb_h - 10 - nd_sp10 * 34; size: pw / 32 - 2, nd_sp10 * 34 + 1; corner: 1; color: nd_acc; opacity: 0.35 + 0.4 * nd_sp10 }
                    box { from: nb_x + 164 + 11 * pw / 32 + 1, nb_y + nb_h - 10 - nd_sp11 * 34; size: pw / 32 - 2, nd_sp11 * 34 + 1; corner: 1; color: nd_acc; opacity: 0.35 + 0.4 * nd_sp11 }
                    box { from: nb_x + 164 + 12 * pw / 32 + 1, nb_y + nb_h - 10 - nd_sp12 * 34; size: pw / 32 - 2, nd_sp12 * 34 + 1; corner: 1; color: nd_acc; opacity: 0.35 + 0.4 * nd_sp12 }
