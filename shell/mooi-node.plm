                box { from: nb_x + 6 + 29 * (nb_w - 12) / 32 + 1, nb_y + nb_h / 2 - (0.08 + nd_sp29 * 0.92) * (nb_h / 2 - 3); size: (nb_w - 12) / 32 - 2, (0.08 + nd_sp29 * 0.92) * (nb_h - 6); corner: max(0.5, ((nb_w - 12) / 32 - 2) / 2 * nd_rnd); color: nd_acc; opacity: 0.55 + 0.45 * nd_sp29 }
                box { from: nb_x + 6 + 30 * (nb_w - 12) / 32 + 1, nb_y + nb_h / 2 - (0.08 + nd_sp30 * 0.92) * (nb_h / 2 - 3); size: (nb_w - 12) / 32 - 2, (0.08 + nd_sp30 * 0.92) * (nb_h - 6); corner: max(0.5, ((nb_w - 12) / 32 - 2) / 2 * nd_rnd); color: nd_acc; opacity: 0.55 + 0.45 * nd_sp30 }
                box { from: nb_x + 6 + 31 * (nb_w - 12) / 32 + 1, nb_y + nb_h / 2 - (0.08 + nd_sp31 * 0.92) * (nb_h / 2 - 3); size: (nb_w - 12) / 32 - 2, (0.08 + nd_sp31 * 0.92) * (nb_h - 6); corner: max(0.5, ((nb_w - 12) / 32 - 2) / 2 * nd_rnd); color: nd_acc; opacity: 0.55 + 0.45 * nd_sp31 }
            }
        }
        // the music as a record: grooves, the cover for its label, a glint that turns with it, the tonearm resting on
        // it, and the spectrum standing out round its rim
        group { show: nd_kind == 1 and nd_mf == 2; opacity: nd_cf
            let vx = nb_x + nb_w / 2
            let vy = nb_y + nb_h / 2
            let vr = min(nb_w, nb_h) / 2
            line { from: vx + cos((0 * 11.25 - 90)) * (vr + 3), vy + sin((0 * 11.25 - 90)) * (vr + 3); to: vx + cos((0 * 11.25 - 90)) * (vr + 4 + nd_sp0 * 26), vy + sin((0 * 11.25 - 90)) * (vr + 4 + nd_sp0 * 26); width: 3; color: nd_acc; opacity: 0.35 + 0.6 * nd_sp0 }
            line { from: vx + cos((1 * 11.25 - 90)) * (vr + 3), vy + sin((1 * 11.25 - 90)) * (vr + 3); to: vx + cos((1 * 11.25 - 90)) * (vr + 4 + nd_sp1 * 26), vy + sin((1 * 11.25 - 90)) * (vr + 4 + nd_sp1 * 26); width: 3; color: nd_acc; opacity: 0.35 + 0.6 * nd_sp1 }
            line { from: vx + cos((2 * 11.25 - 90)) * (vr + 3), vy + sin((2 * 11.25 - 90)) * (vr + 3); to: vx + cos((2 * 11.25 - 90)) * (vr + 4 + nd_sp2 * 26), vy + sin((2 * 11.25 - 90)) * (vr + 4 + nd_sp2 * 26); width: 3; color: nd_acc; opacity: 0.35 + 0.6 * nd_sp2 }
            line { from: vx + cos((3 * 11.25 - 90)) * (vr + 3), vy + sin((3 * 11.25 - 90)) * (vr + 3); to: vx + cos((3 * 11.25 - 90)) * (vr + 4 + nd_sp3 * 26), vy + sin((3 * 11.25 - 90)) * (vr + 4 + nd_sp3 * 26); width: 3; color: nd_acc; opacity: 0.35 + 0.6 * nd_sp3 }
            line { from: vx + cos((4 * 11.25 - 90)) * (vr + 3), vy + sin((4 * 11.25 - 90)) * (vr + 3); to: vx + cos((4 * 11.25 - 90)) * (vr + 4 + nd_sp4 * 26), vy + sin((4 * 11.25 - 90)) * (vr + 4 + nd_sp4 * 26); width: 3; color: nd_acc; opacity: 0.35 + 0.6 * nd_sp4 }
            line { from: vx + cos((5 * 11.25 - 90)) * (vr + 3), vy + sin((5 * 11.25 - 90)) * (vr + 3); to: vx + cos((5 * 11.25 - 90)) * (vr + 4 + nd_sp5 * 26), vy + sin((5 * 11.25 - 90)) * (vr + 4 + nd_sp5 * 26); width: 3; color: nd_acc; opacity: 0.35 + 0.6 * nd_sp5 }
            line { from: vx + cos((6 * 11.25 - 90)) * (vr + 3), vy + sin((6 * 11.25 - 90)) * (vr + 3); to: vx + cos((6 * 11.25 - 90)) * (vr + 4 + nd_sp6 * 26), vy + sin((6 * 11.25 - 90)) * (vr + 4 + nd_sp6 * 26); width: 3; color: nd_acc; opacity: 0.35 + 0.6 * nd_sp6 }
            line { from: vx + cos((7 * 11.25 - 90)) * (vr + 3), vy + sin((7 * 11.25 - 90)) * (vr + 3); to: vx + cos((7 * 11.25 - 90)) * (vr + 4 + nd_sp7 * 26), vy + sin((7 * 11.25 - 90)) * (vr + 4 + nd_sp7 * 26); width: 3; color: nd_acc; opacity: 0.35 + 0.6 * nd_sp7 }
            line { from: vx + cos((8 * 11.25 - 90)) * (vr + 3), vy + sin((8 * 11.25 - 90)) * (vr + 3); to: vx + cos((8 * 11.25 - 90)) * (vr + 4 + nd_sp8 * 26), vy + sin((8 * 11.25 - 90)) * (vr + 4 + nd_sp8 * 26); width: 3; color: nd_acc; opacity: 0.35 + 0.6 * nd_sp8 }
            line { from: vx + cos((9 * 11.25 - 90)) * (vr + 3), vy + sin((9 * 11.25 - 90)) * (vr + 3); to: vx + cos((9 * 11.25 - 90)) * (vr + 4 + nd_sp9 * 26), vy + sin((9 * 11.25 - 90)) * (vr + 4 + nd_sp9 * 26); width: 3; color: nd_acc; opacity: 0.35 + 0.6 * nd_sp9 }
            line { from: vx + cos((10 * 11.25 - 90)) * (vr + 3), vy + sin((10 * 11.25 - 90)) * (vr + 3); to: vx + cos((10 * 11.25 - 90)) * (vr + 4 + nd_sp10 * 26), vy + sin((10 * 11.25 - 90)) * (vr + 4 + nd_sp10 * 26); width: 3; color: nd_acc; opacity: 0.35 + 0.6 * nd_sp10 }
            line { from: vx + cos((11 * 11.25 - 90)) * (vr + 3), vy + sin((11 * 11.25 - 90)) * (vr + 3); to: vx + cos((11 * 11.25 - 90)) * (vr + 4 + nd_sp11 * 26), vy + sin((11 * 11.25 - 90)) * (vr + 4 + nd_sp11 * 26); width: 3; color: nd_acc; opacity: 0.35 + 0.6 * nd_sp11 }
            line { from: vx + cos((12 * 11.25 - 90)) * (vr + 3), vy + sin((12 * 11.25 - 90)) * (vr + 3); to: vx + cos((12 * 11.25 - 90)) * (vr + 4 + nd_sp12 * 26), vy + sin((12 * 11.25 - 90)) * (vr + 4 + nd_sp12 * 26); width: 3; color: nd_acc; opacity: 0.35 + 0.6 * nd_sp12 }
