                box { from: nb_x + 6 + 21 * (nb_w - 12) / 32 + 1, nb_y + nb_h / 2 - (0.08 + nd_sp21 * 0.92) * (nb_h / 2 - 3); size: (nb_w - 12) / 32 - 2, (0.08 + nd_sp21 * 0.92) * (nb_h - 6); corner: max(0.5, ((nb_w - 12) / 32 - 2) / 2 * nd_rnd); color: nd_acc; opacity: 0.55 + 0.45 * nd_sp21 }
