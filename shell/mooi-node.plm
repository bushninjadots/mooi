    prop pr_engrave_b = 0.670588 ~fl.relight
    follow pr_engrave_b = fr_engrave_b
    fact cn_kind = 0
    fact cn_scale = 1
    fact c_bg_primary_r = 0.062745
    fact c_bg_primary_g = 0.078431
    fact c_bg_primary_b = 0.086275
    fact c_bg_secondary_r = 0.086275
    fact c_bg_secondary_g = 0.105882
    fact c_bg_secondary_b = 0.117647
    fact c_surface_primary_r = 0.098039
    fact c_surface_primary_g = 0.121569
    fact c_surface_primary_b = 0.133333
    fact c_surface_elevated_r = 0.133333
    fact c_surface_elevated_g = 0.160784
    fact c_surface_elevated_b = 0.176471
    fact c_border_subtle_r = 0.172549
    fact c_border_subtle_g = 0.207843
    fact c_border_subtle_b = 0.223529
    fact c_fg_primary_r = 0.890196
    fact c_fg_primary_g = 0.913725
    fact c_fg_primary_b = 0.921569
    fact c_fg_secondary_r = 0.639216
    fact c_fg_secondary_g = 0.690196
    fact c_fg_secondary_b = 0.709804
    fact c_fg_muted_r = 0.541176
    fact c_fg_muted_g = 0.592157
    fact c_fg_muted_b = 0.611765
    fact c_accent_primary_r = 0.650980
    fact c_accent_primary_g = 0.952941
    fact c_accent_primary_b = 0.819608
    fact c_accent_secondary_r = 1.000000
    fact c_accent_secondary_g = 0.572549
    fact c_accent_secondary_b = 0.372549
    fact c_status_ok_r = 0.650980
    fact c_status_ok_g = 0.952941
    fact c_status_ok_b = 0.819608
    fact c_status_error_r = 1.000000
    fact c_status_error_g = 0.572549
    fact c_status_error_b = 0.372549
    fact c_focus_ring_r = 0.650980
    fact c_focus_ring_g = 0.952941
    fact c_focus_ring_b = 0.819608
    fact c_selection_bg_r = 0.164706
    fact c_selection_bg_g = 0.227451
    fact c_selection_bg_b = 0.211765
    fact st_offset = 0
    fact st_notch = false
    fact bar_rail = true
    fact st_height = 30
    fact st_radius = 8
    fact st_res = 46
    fact st_glow = 1

    // ── what the node is (the logic, lib/node/state): 0 rest · 1 media · 2 notice · 3 volume · 4 workspaces ·
    //    5 system · 6 launcher · 7 universe; the personality picks the spring the body follows ──
    fact nd_kind = 0
    fact nd_np = 0
    fact nd_breath = true
    fact nd_kb = false
    fact nd_lean = 0       // where the pointer came in: -1 left · 1 right (expansion leans that way)
    fact nd_tx = 949
    fact nd_ty = 8
    fact nd_tw = 22
    fact nd_th = 6
    fact nd_tr = 3
    spring nd.p0 = 240, 17     // organic
    spring nd.p1 = 520, 42     // minimal
    spring nd.p2 = 640, 52     // technical
    spring nd.p3 = 760, 26     // cyber
    prop nbx0 = 949 ~nd.p0
    follow nbx0 = nd_tx
    prop nbx1 = 949 ~nd.p1
    follow nbx1 = nd_tx
    prop nbx2 = 949 ~nd.p2
    follow nbx2 = nd_tx
    prop nbx3 = 949 ~nd.p3
    follow nbx3 = nd_tx
    let nb_x = pick(nd_np, nbx0, nbx1, nbx2, nbx3)
    prop nby0 = 8 ~nd.p0
    follow nby0 = nd_ty
    prop nby1 = 8 ~nd.p1
    follow nby1 = nd_ty
    prop nby2 = 8 ~nd.p2
    follow nby2 = nd_ty
    prop nby3 = 8 ~nd.p3
    follow nby3 = nd_ty
    let nb_y = pick(nd_np, nby0, nby1, nby2, nby3)
    prop nbw0 = 22 ~nd.p0
    follow nbw0 = nd_tw
    prop nbw1 = 22 ~nd.p1
    follow nbw1 = nd_tw
    prop nbw2 = 22 ~nd.p2
    follow nbw2 = nd_tw
    prop nbw3 = 22 ~nd.p3
    follow nbw3 = nd_tw
    let nb_w = pick(nd_np, nbw0, nbw1, nbw2, nbw3)
    prop nbh0 = 6 ~nd.p0
    follow nbh0 = nd_th
    prop nbh1 = 6 ~nd.p1
    follow nbh1 = nd_th
    prop nbh2 = 6 ~nd.p2
    follow nbh2 = nd_th
    prop nbh3 = 6 ~nd.p3
    follow nbh3 = nd_th
    let nb_h = pick(nd_np, nbh0, nbh1, nbh2, nbh3)
    prop nbr0 = 3 ~nd.p0
    follow nbr0 = nd_tr
    prop nbr1 = 3 ~nd.p1
    follow nbr1 = nd_tr
    prop nbr2 = 3 ~nd.p2
    follow nbr2 = nd_tr
    prop nbr3 = 3 ~nd.p3
    follow nbr3 = nd_tr
    let nb_r = pick(nd_np, nbr0, nbr1, nbr2, nbr3)
    // what is inside appears as the body reaches its size: it grows out of the node, never pops in
    let nd_cf = clamp((nb_w - 0.82 * nd_tw) / max(1, 0.18 * nd_tw), 0, 1) * clamp((nb_h - 0.82 * nd_th) / max(1, 0.18 * nd_th), 0, 1)
    // the seed breathes (2 s), only at rest and only while allowed
    prop nd_ph = 0
    spin nd_ph by if(nd_kind == 0 and nd_breath, 180, 0)
    let nd_br = 0.5 + 0.5 * sin(nd_ph)
    // media
    text nd_title = ""
    text nd_artist = ""
    text nd_art = ""
    image nd_cover = from nd_art, 96, 96
    fact nd_playing = false
    fact nd_prog = 0
    fact nd_arted = false
    prop nd_vph = 0
    spin nd_vph by if(nd_kind == 1 and nd_playing, 240, 0)
    // notices
    model nc max 3 { x: number; y: number; w: number; h: number; app: text; title: text; act: text; hasact: bool }
    // volume
    fact nd_vol = 0
    text nd_vlabel = ""
    // workspaces
    model rl max 12 { x: number; n: text; on: bool; used: bool }
    fact nd_beadx = 960
    prop nd_bead = 960 ~nd.p0
    follow nd_bead = nd_beadx
    // system
    model sy max 4 { x: number; y: number; label: text; value: text; hot: bool }
    // launcher
    text nd_q = ""
    fact nd_sel = 0
    model lr max 6 { x: number; y: number; w: number; h: number; name: text; icon: image 28, 28; iconed: bool; letter: text }
    // universe
    model un max 12 { x: number; y: number; s: number; n: text; apps: text; front: bool; id: number }
    prop nd_uf = 0 ~nd.p0
    follow nd_uf = if(nd_kind == 7, 1, 0)
    // satellites
    model sa max 6 { x: number; y: number; w: number; h: number; label: text; kind: number }
    prop nd_sf = 0 ~nd.p0
    follow nd_sf = if(nd_kind == 0, 1, 0)

    event nd_hover ->     // the pointer over the node: 1 + x · 0 gone
    event nd_press ->     // the node pressed
    event nd_media ->     // 1 back · 2 play / pause · 3 next
    event nd_nc ->        // a notice: row * 10 + 0 open · 1 its action · 9 dismiss
    event nd_ws ->        // a workspace on the rail
    event nd_lr ->        // a launcher row
    event nd_un ->        // a workspace in the universe
    event nd_sa ->        // a satellite (its kind)
    event nd_key ->       // a key while the node holds the keyboard
    event nd_cmd ->       // from `mooi node …`: 1 wake (Super) · 2 launcher · 3 universe

    surface node {
        size: full, full
        anchor: top
        level: top, overlay while nd_kind == 7
        reserve: 0
        keyboard: exclusive while nd_kb
        rate: 60, 20 while nd_kind == 0
        // the universe (Super+Tab): the desktop dims and the workspaces gather round the node
        box { from: 0, 0; size: node.width, node.height; color: #000000; opacity: 0.62 * nd_uf; show: nd_uf > 0.01 }
        zone box nd_ubz { from: 0, 0; size: node.width, node.height; role: button; label: "Close the workspaces"; show: nd_kind == 7 }
        on press nd_ubz { emit nd_key(27) }
        on scroll nd_ubz { emit nd_key(if(wheel > 0, 37, 39)) }
        for u in un {
            group { opacity: nd_uf; show: nd_uf > 0.01
                let tw = 240 * u.s
                let th = 140 * u.s
                group { glow: 22, if(u.front, 0.7, 0.2), fl.phos
                    box { from: u.x - tw / 2, u.y - th / 2; size: tw, th; corner: 12 * u.s; color: fl.hull; opacity: 0.94 } }
                box { from: u.x - tw / 2, u.y - th / 2; size: tw, th; corner: 12 * u.s; stroke: if(u.front, 2, 1); color: if(u.front, fl.phos, fl.trace_lit) }
                text u.n { at: u.x, u.y - th / 2 + 26 * u.s; anchor: center; align: center; size: 22 * u.s; weight: 700; family: "Share Tech Mono"; color: if(u.front, fl.phos, fl.engrave) }
                text u.apps { at: u.x, u.y + 12 * u.s; anchor: center; align: center; size: 11 * u.s; family: "Exo 2"; color: fl.muted; width: tw - 20; lines: 2 }
                zone box ut { from: u.x - tw / 2, u.y - th / 2; size: tw, th; corner: 12; cursor: pointer; role: button; label: "Workspace {u.n}"; show: nd_kind == 7 }
                on press ut { emit nd_un(u.id) }
            }
        }
        // the body: one shape that is the seed, a capsule, a rail, a search line
        group { glow: if(nd_kind == 0, 8, 14), if(nd_kind == 0, 0.35 + 0.25 * nd_br, 0.4), fl.phos
            box { from: nb_x, nb_y + if(nd_kind == 0, (1 - nd_br) * 1, 0); size: nb_w, nb_h; corner: nb_r; color: if(nd_kind == 0, fl.phos, fl.hull); opacity: if(nd_kind == 0, 0.55 + 0.35 * nd_br, 0.95) } }
        box { from: nb_x, nb_y; size: nb_w, nb_h; corner: nb_r; stroke: if(nd_np == 3, 1.5, 1); color: fl.phos; opacity: if(nd_kind == 0, 0, 0.55) }
        // cyber: the outline breaks into segments
        box { from: nb_x + nb_w * 0.3, nb_y - 1; size: nb_w * 0.12, 2; color: fl.ground; show: nd_np == 3 and nd_kind > 0 }
        box { from: nb_x + nb_w * 0.7, nb_y + nb_h - 1; size: nb_w * 0.08, 2; color: fl.ground; show: nd_np == 3 and nd_kind > 0 }
        // technical: ticks along the floor
        repeat tk in 0..9 { box { from: nb_x + nb_w * (tk + 0.5) / 9, nb_y + nb_h - 3; size: 1, 3; color: fl.phos; opacity: 0.5; show: nd_np == 2 and nd_kind > 0 and nd_kind < 6 } }
        zone box nd_bz { from: nb_x - 16, nb_y - 8; size: nb_w + 32, nb_h + 16; corner: nb_r; cursor: pointer; role: button; label: "The Pill" }
        let nd_hv = nd_bz.hover
        on change nd_hv { emit nd_hover(if(nd_hv, 1 + round(pointer.x), 0)) }
        on press nd_bz { emit nd_press }
        // media: a lateral capsule — the cover, the song, its controls, its progress, the music in its floor
        group { show: nd_kind == 1; opacity: nd_cf
            group { clip box { from: nb_x + 8, nb_y + 8; size: 48, 48; corner: if(nd_np == 2, 3, 10) }
                box { from: nb_x + 8, nb_y + 8; size: 48, 48; color: fl.well }
                image nd_cover { at: nb_x + 8, nb_y + 8; size: 48, 48; fit: cover; show: nd_arted } }
            text nd_title { at: nb_x + 68, nb_y + 22; anchor: left center; size: 13; weight: 600; family: "Exo 2"; color: fl.engrave; width: nb_w - 200; lines: 1 }
            text nd_artist { at: nb_x + 68, nb_y + 40; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.muted; width: nb_w - 200; lines: 1 }
            box { from: nb_x + 68, nb_y + nb_h - 12; size: nb_w - 200, 2; corner: 1; color: fl.trace_dim }
            box { from: nb_x + 68, nb_y + nb_h - 12; size: (nb_w - 200) * nd_prog, 2; corner: 1; color: fl.phos }
            // the music, woven into the capsule's floor
            repeat vb in 0..24 { box { from: nb_x + 16 + vb * (nb_w - 32) / 24, nb_y + nb_h - 3 - (0.3 + 0.7 * abs(sin(vb * 47 + nd_vph))) * lv.level * 10; size: (nb_w - 32) / 24 * 0.5, (0.3 + 0.7 * abs(sin(vb * 47 + nd_vph))) * lv.level * 10 + 1; color: fl.phos; opacity: 0.35 } }
            text "⏮" { at: nb_x + nb_w - 118 + 0 + 14, nb_y + nb_h / 2; anchor: center; align: center; size: 15; family: "Exo 2"; color: if(nmc1.hover, fl.phos, fl.engrave) }
            zone box nmc1 { from: nb_x + nb_w - 118 + 0, nb_y + nb_h / 2 - 14; size: 28, 28; corner: 14; cursor: pointer; role: button; label: "Back"; show: nd_kind == 1 }
            on press nmc1 { emit nd_media(1) }
            text "⏯" { at: nb_x + nb_w - 118 + 36 + 14, nb_y + nb_h / 2; anchor: center; align: center; size: 15; family: "Exo 2"; color: if(nmc2.hover, fl.phos, fl.engrave) }
            zone box nmc2 { from: nb_x + nb_w - 118 + 36, nb_y + nb_h / 2 - 14; size: 28, 28; corner: 14; cursor: pointer; role: button; label: "Play or pause"; show: nd_kind == 1 }
            on press nmc2 { emit nd_media(2) }
            text "⏭" { at: nb_x + nb_w - 118 + 72 + 14, nb_y + nb_h / 2; anchor: center; align: center; size: 15; family: "Exo 2"; color: if(nmc3.hover, fl.phos, fl.engrave) }
            zone box nmc3 { from: nb_x + nb_w - 118 + 72, nb_y + nb_h / 2 - 14; size: 28, 28; corner: 14; cursor: pointer; role: button; label: "Next"; show: nd_kind == 1 }
            on press nmc3 { emit nd_media(3) }
        }
        // notices: a stem drops from the node, the cards branch from it
        group { show: nd_kind == 2; opacity: nd_cf
            line { from: nb_x + nb_w / 2, nb_y + nb_h; to: nb_x + nb_w / 2, nb_y + nb_h + 22; width: 1.5; color: fl.phos }
            for n in nc {
                let row = n.index
                line { from: nb_x + nb_w / 2, n.y - 8; to: n.x + n.w / 2, n.y; width: 1; color: fl.trace_lit; opacity: 0.6 }
                group { glow: 16, 0.35, #000000
                    box { from: n.x, n.y; size: n.w, n.h; corner: if(nd_np == 2, 4, 12); color: fl.hull; opacity: 0.96 } }
                box { from: n.x, n.y; size: n.w, n.h; corner: if(nd_np == 2, 4, 12); stroke: 1; color: fl.trace_lit; opacity: 0.6 }
                text n.app { at: n.x + 14, n.y + 16; anchor: left center; size: 9; weight: 700; family: "Share Tech Mono"; color: fl.phos; width: n.w - 60; lines: 1 }
                text n.title { at: n.x + 14, n.y + 37; anchor: left center; size: 12; family: "Exo 2"; color: fl.engrave; width: n.w - 120; lines: 1 }
                zone box ncz { from: n.x, n.y; size: n.w, n.h; corner: 12; cursor: pointer; role: button; label: "{n.app}: {n.title}"; show: nd_kind == 2 }
                on press ncz { emit nd_nc(row * 10) }
                group { show: n.hasact
                    box { from: n.x + n.w - 100, n.y + 27; size: 64, 20; corner: 10; stroke: 1; color: fl.phos }
                    text n.act { at: n.x + n.w - 68, n.y + 37; anchor: center; align: center; size: 9; family: "Share Tech Mono"; color: fl.phos; width: 58; lines: 1 }
                    zone box nca { from: n.x + n.w - 100, n.y + 27; size: 64, 20; cursor: pointer; role: button; label: "{n.act}"; show: nd_kind == 2 and n.hasact }
                    on press nca { emit nd_nc(row * 10 + 1) } }
                text "×" { at: n.x + n.w - 18, n.y + 16; anchor: center; size: 14; family: "Exo 2"; color: fl.muted }
                zone box ncx { from: n.x + n.w - 30, n.y + 4; size: 24, 24; cursor: pointer; role: button; label: "Dismiss"; show: nd_kind == 2 }
                on press ncx { emit nd_nc(row * 10 + 9) }
            }
        }
        // volume or brightness: the node becomes a gauge
        group { show: nd_kind == 3; opacity: nd_cf
            box { from: nb_x + 3, nb_y + 3; size: max(0, (nb_w - 6) * nd_vol), nb_h - 6; corner: max(0, nb_r - 3); color: fl.phos; opacity: 0.85 }
            text nd_vlabel { at: nb_x + nb_w / 2, nb_y + nb_h + 12; anchor: center; align: center; size: 9; family: "Share Tech Mono"; color: fl.engrave } }
        // workspaces: a rail, the active one a bead that slides along it
        group { show: nd_kind == 4; opacity: nd_cf
            line { from: nb_x + 18, nb_y + nb_h / 2; to: nb_x + nb_w - 18, nb_y + nb_h / 2; width: 1; color: fl.trace_lit; opacity: 0.7 }
            for r in rl {
                ellipse { at: r.x, nb_y + nb_h / 2; radius: if(r.used, 3.5, 2); color: if(r.used, fl.engrave, fl.muted) }
                text r.n { at: r.x, nb_y + nb_h / 2 - 1; anchor: center; align: center; size: 9; weight: 700; family: "Share Tech Mono"; color: fl.ground; show: r.on }
                zone box rz { from: r.x - 20, nb_y; size: 40, nb_h; cursor: pointer; role: button; label: "Workspace {r.n}"; show: nd_kind == 4 }
                on press rz { emit nd_ws(r.index) }
            }
            group { glow: 12, 0.8, fl.phos
                ellipse { at: nd_bead, nb_y + nb_h / 2; radius: 10; color: fl.phos } }
            for r in rl { text r.n { at: r.x, nb_y + nb_h / 2; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: fl.ground; show: r.on } }
        }
        // system: a cluster round the node
        group { show: nd_kind == 5; opacity: nd_cf
            for p in sy {
                line { from: nb_x + nb_w / 2, nb_y + nb_h / 2; to: p.x, p.y; width: 1; color: fl.trace_lit; opacity: 0.7 }
                box { from: p.x - 46, p.y - 14; size: 92, 28; corner: if(nd_np == 2, 3, 14); color: fl.hull; opacity: 0.95 }
                box { from: p.x - 46, p.y - 14; size: 92, 28; corner: if(nd_np == 2, 3, 14); stroke: 1; color: if(p.hot, fl.ember, fl.phos); opacity: 0.8 }
                text p.label { at: p.x - 38, p.y; anchor: left center; size: 8; family: "Share Tech Mono"; color: fl.muted }
                text p.value { at: p.x + 38, p.y; anchor: right center; size: 11; weight: 700; family: "Share Tech Mono"; color: if(p.hot, fl.ember, fl.engrave) }
            }
            ellipse { at: nb_x + nb_w / 2, nb_y + nb_h / 2; radius: 5; color: fl.phos }
        }
        // the launcher: the node widens into a search line, results grow under it
        group { show: nd_kind == 6; opacity: nd_cf
            text "›" { at: nb_x + 18, nb_y + nb_h / 2; anchor: center; size: 18; family: "Exo 2"; color: fl.phos }
            input nd_q { at: nb_x + 34, nb_y + nb_h / 2 - 9; width: nb_w - 50; size: 14; family: "Exo 2"; color: fl.engrave; selection: fl.well; placeholder: "search apps" }
            for r in lr {
                let i = r.index
                box { from: r.x, r.y; size: r.w, r.h; corner: if(nd_np == 2, 4, 10); color: if(nd_sel == i, fl.hull_raised, fl.hull); opacity: 0.95 }
                box { from: r.x, r.y; size: 3, r.h; color: fl.phos; show: nd_sel == i }
                image r.icon { at: r.x + 12, r.y + 7; size: 28, 28; show: r.iconed }
                text r.letter { at: r.x + 26, r.y + 21; anchor: center; align: center; size: 13; weight: 700; family: "Share Tech Mono"; color: fl.phos; show: not r.iconed }
                text r.name { at: r.x + 52, r.y + 21; anchor: left center; size: 13; family: "Exo 2"; color: fl.engrave; width: r.w - 64; lines: 1 }
                zone box lz { from: r.x, r.y; size: r.w, r.h; cursor: pointer; role: button; label: "Open {r.name}"; show: nd_kind == 6 }
                on press lz { emit nd_lr(i) }
            }
        }
        on submit nd_q { emit nd_key(13) }
        on change nd_kb while nd_kb and nd_kind == 6 { focus nd_q }
        // satellites: what deserves a place, on an arc under the seed
        for s in sa {
            group { opacity: nd_sf; show: nd_sf > 0.01
                line { from: nb_x + nb_w / 2, nb_y + nb_h; to: s.x + s.w / 2, s.y; width: 1; color: fl.trace_lit; opacity: 0.35 }
                box { from: s.x, s.y; size: s.w, s.h; corner: if(nd_np == 2, 3, s.h / 2); color: fl.hull; opacity: 0.92 }
                box { from: s.x, s.y; size: s.w, s.h; corner: if(nd_np == 2, 3, s.h / 2); stroke: 1; color: if(s.kind == 2 or s.kind == 3 or s.kind == 4, fl.ember, fl.phos); opacity: 0.8 }
                text s.label { at: s.x + s.w / 2, s.y + s.h / 2; anchor: center; align: center; size: 9; weight: 700; family: "Share Tech Mono"; color: fl.engrave; width: s.w - 10; lines: 1 }
                zone box saz { from: s.x, s.y; size: s.w, s.h; cursor: pointer; role: button; label: "{s.label}"; show: nd_kind == 0 }
                on press saz { emit nd_sa(s.kind) }
            }
        }
        // the keyboard, while the node holds it (the launcher, the universe)
        on key Escape while nd_kb { emit nd_key(27) }
        on key Return while nd_kb { emit nd_key(13) }
        on key Up while nd_kb { emit nd_key(38) }
        on key Down while nd_kb { emit nd_key(40) }
        on key Left while nd_kb { emit nd_key(37) }
        on key Right while nd_kb { emit nd_key(39) }
        on key Tab while nd_kb { emit nd_key(9) }
    }
}
