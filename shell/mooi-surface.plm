                ellipse { at: dcx + 5 * dr / 10, dcy + 8 * dr / 10; radius: max(0.3, dr / 10 * 0.48 * (0.5 + 0.5 * sin(273 + ph * 0.15) * cos(197 - ph * 0.1))); color: mix(rgb(h0_r, h0_g, h0_b), #ffffff, 0.25 * (0.5 + 0.5 * sin(273 + ph * 0.15) * cos(197 - ph * 0.1))); opacity: 0.9 }
