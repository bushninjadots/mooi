        }
        text h0_t1 { at: h0_cx, h0_y + h0_h / 2; anchor: left center; size: 12; weight: 700; family: "Exo 2"; color: mix(ink, rgb(h0_r, h0_g, h0_b), 0.15); width: max(10, h0_x + h0_w - h0_cx - 6); lines: 1; show: h0_on and h0_form > 0.5 and h0_form < 1.5 }
        zone box hz0 { from: h0_x, h0_y; size: max(1, h0_w), max(1, h0_h); cursor: pointer; role: button; label: "The Sigil"; show: h0_on }
        on press hz0 { emit sg_press(0) }
        on press right hz0 { emit sg_rpress(0) }
        on scroll hz0 { emit sg_wheel(0 + if(wheel > 0, 1, 0)) }
        let hz0_in = hz0.hover > 0.5
        on change hz0_in while hz0_in { emit sg_hover(1) }
        on change hz0_in while not hz0_in { emit sg_hover(0) }
