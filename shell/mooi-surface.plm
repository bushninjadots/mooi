    let h0_wx0 = h0_x0
    let h0_wy0 = h0_y0 + sin(ph + 0) * (wob + breath * 0.5 * (1 + sin(ph * 0.3))) * 0.4 + sin(ph * 2 + 0) * lv.level * 7 * h0_rip
    let h0_d0 = sqrt(pow(h0_wx0 - cursor.x, 2) + pow(h0_wy0 - cursor.y, 2) + 1)
    let h0_p0 = push * max(0, 40 - h0_d0) / 40 * 6 / h0_d0
    let h0_X0 = h0_wx0 + (h0_wx0 - cursor.x) * h0_p0
    let h0_Y0 = h0_wy0 + (h0_wy0 - cursor.y) * h0_p0
    let h0_wx1 = h0_x1
    let h0_wy1 = h0_y1 + sin(ph + 23) * (wob + breath * 0.5 * (1 + sin(ph * 0.3))) * 0.4 + sin(ph * 2 + 40) * lv.level * 7 * h0_rip
    let h0_d1 = sqrt(pow(h0_wx1 - cursor.x, 2) + pow(h0_wy1 - cursor.y, 2) + 1)
    let h0_p1 = push * max(0, 40 - h0_d1) / 40 * 6 / h0_d1
    let h0_X1 = h0_wx1 + (h0_wx1 - cursor.x) * h0_p1
    let h0_Y1 = h0_wy1 + (h0_wy1 - cursor.y) * h0_p1
    let h0_wx2 = h0_x2
    let h0_wy2 = h0_y2 + sin(ph + 46) * (wob + breath * 0.5 * (1 + sin(ph * 0.3))) * 0.4 + sin(ph * 2 + 80) * lv.level * 7 * h0_rip
    let h0_d2 = sqrt(pow(h0_wx2 - cursor.x, 2) + pow(h0_wy2 - cursor.y, 2) + 1)
    let h0_p2 = push * max(0, 40 - h0_d2) / 40 * 6 / h0_d2
    let h0_X2 = h0_wx2 + (h0_wx2 - cursor.x) * h0_p2
    let h0_Y2 = h0_wy2 + (h0_wy2 - cursor.y) * h0_p2
    let h0_wx3 = h0_x3
    let h0_wy3 = h0_y3 + sin(ph + 69) * (wob + breath * 0.5 * (1 + sin(ph * 0.3))) * 0.4 + sin(ph * 2 + 120) * lv.level * 7 * h0_rip
    let h0_d3 = sqrt(pow(h0_wx3 - cursor.x, 2) + pow(h0_wy3 - cursor.y, 2) + 1)
    let h0_p3 = push * max(0, 40 - h0_d3) / 40 * 6 / h0_d3
    let h0_X3 = h0_wx3 + (h0_wx3 - cursor.x) * h0_p3
    let h0_Y3 = h0_wy3 + (h0_wy3 - cursor.y) * h0_p3
