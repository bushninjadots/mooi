                ellipse { at: dcx + 0 * dr / 10, dcy + 10 * dr / 10; radius: max(0.3, dr / 10 * 0.48 * (0.5 + 0.5 * sin(110 + ph * 0.15) * cos(290 - ph * 0.1))); color: mix(rgb(h0_r, h0_g, h0_b), #ffffff, 0.25 * (0.5 + 0.5 * sin(110 + ph * 0.15) * cos(290 - ph * 0.1))); opacity: 0.9 }
            }
            // the ring's fill (kind 4): a progress arc to h0_val
            group {
                show: h0_kind == 4
                let rr = min(d_h * 0.4, d_w * 0.2) - 9
                arc { at: d_x + rr + 11, d_y + d_h / 2; radius: rr; span: clamp(h0_val, 0, 1) * 306deg; rotate: 180deg - clamp(h0_val, 0, 1) * 153deg + 153deg; width: 6; color: rgb(h0_r, h0_g, h0_b) }
            }
            // the ribbon's fill (kind 7)
            box { from: d_x + d_w * 0.05 + 4, d_y + d_h / 2 - 7; size: max(1, (d_w * 0.9 - 8) * clamp(h0_val, 0, 1)), 14; corner: 7; color: rgb(h0_r, h0_g, h0_b); opacity: 0.85; show: h0_kind == 7 }
            // the horizon's sun (kind 8): where the day is on its arc (h0_val 0 sunrise … 1 sunset)
            group {
                show: h0_kind == 8
                glow: 18, 0.8 * st_glow, #ffd678
                ellipse { at: d_x + d_w / 2 - cos(clamp(h0_val, 0, 1) * 180) * (d_w - 4) * 0.36, d_y + d_h - 2 - sin(clamp(h0_val, 0, 1) * 180) * (d_h - 4); radius: 10; color: #ffd678 }
            }
            // its words
            text h0_t1 { at: d_tx, d_ty; anchor: left center; size: 22; weight: 700; family: "Exo 2"; color: ink; width: max(20, d_x + d_w - d_tx - 8); lines: 1 }
            text h0_t2 { at: d_tx, d_ty + 26; anchor: left center; size: 13; family: "Share Tech Mono"; color: muted; width: max(20, d_x + d_w - d_tx - 8); lines: 1 }
            group {
                show: h0_on
                group {
                    glow: 22, 0.5 * st_glow, rgb(h0_r, h0_g, h0_b)
                    path { stroke: 8; color: rgb(h0_r, h0_g, h0_b); opacity: 0.1; move h0_X0, h0_Y0; line h0_X1, h0_Y1; line h0_X2, h0_Y2; line h0_X3, h0_Y3; line h0_X4, h0_Y4; line h0_X5, h0_Y5; line h0_X6, h0_Y6; line h0_X7, h0_Y7; line h0_X8, h0_Y8; line h0_X9, h0_Y9; line h0_X10, h0_Y10; line h0_X11, h0_Y11; line h0_X12, h0_Y12; line h0_X13, h0_Y13; line h0_X14, h0_Y14; line h0_X15, h0_Y15; line h0_X16, h0_Y16; line h0_X17, h0_Y17; line h0_X18, h0_Y18; line h0_X19, h0_Y19; line h0_X20, h0_Y20; line h0_X21, h0_Y21; line h0_X22, h0_Y22; line h0_X23, h0_Y23; line h0_X24, h0_Y24; line h0_X25, h0_Y25; line h0_X26, h0_Y26; line h0_X27, h0_Y27; line h0_X28, h0_Y28; line h0_X29, h0_Y29; line h0_X30, h0_Y30; line h0_X31, h0_Y31; line h0_X32, h0_Y32; line h0_X33, h0_Y33; line h0_X34, h0_Y34; line h0_X35, h0_Y35; line h0_X36, h0_Y36; line h0_X37, h0_Y37; line h0_X38, h0_Y38; line h0_X39, h0_Y39; line h0_X40, h0_Y40; line h0_X41, h0_Y41; line h0_X42, h0_Y42; line h0_X43, h0_Y43; line h0_X44, h0_Y44; line h0_X45, h0_Y45; line h0_X46, h0_Y46; line h0_X47, h0_Y47; line h0_X48, h0_Y48; line h0_X49, h0_Y49; line h0_X50, h0_Y50; line h0_X51, h0_Y51; line h0_X52, h0_Y52; line h0_X53, h0_Y53; line h0_X54, h0_Y54; line h0_X55, h0_Y55; line h0_X56, h0_Y56; line h0_X57, h0_Y57; line h0_X58, h0_Y58; line h0_X59, h0_Y59; line h0_X60, h0_Y60; line h0_X61, h0_Y61; line h0_X62, h0_Y62; line h0_X63, h0_Y63 }
                    path { stroke: 3.2; color: rgb(h0_r, h0_g, h0_b); opacity: 0.3; move h0_X0, h0_Y0; line h0_X1, h0_Y1; line h0_X2, h0_Y2; line h0_X3, h0_Y3; line h0_X4, h0_Y4; line h0_X5, h0_Y5; line h0_X6, h0_Y6; line h0_X7, h0_Y7; line h0_X8, h0_Y8; line h0_X9, h0_Y9; line h0_X10, h0_Y10; line h0_X11, h0_Y11; line h0_X12, h0_Y12; line h0_X13, h0_Y13; line h0_X14, h0_Y14; line h0_X15, h0_Y15; line h0_X16, h0_Y16; line h0_X17, h0_Y17; line h0_X18, h0_Y18; line h0_X19, h0_Y19; line h0_X20, h0_Y20; line h0_X21, h0_Y21; line h0_X22, h0_Y22; line h0_X23, h0_Y23; line h0_X24, h0_Y24; line h0_X25, h0_Y25; line h0_X26, h0_Y26; line h0_X27, h0_Y27; line h0_X28, h0_Y28; line h0_X29, h0_Y29; line h0_X30, h0_Y30; line h0_X31, h0_Y31; line h0_X32, h0_Y32; line h0_X33, h0_Y33; line h0_X34, h0_Y34; line h0_X35, h0_Y35; line h0_X36, h0_Y36; line h0_X37, h0_Y37; line h0_X38, h0_Y38; line h0_X39, h0_Y39; line h0_X40, h0_Y40; line h0_X41, h0_Y41; line h0_X42, h0_Y42; line h0_X43, h0_Y43; line h0_X44, h0_Y44; line h0_X45, h0_Y45; line h0_X46, h0_Y46; line h0_X47, h0_Y47; line h0_X48, h0_Y48; line h0_X49, h0_Y49; line h0_X50, h0_Y50; line h0_X51, h0_Y51; line h0_X52, h0_Y52; line h0_X53, h0_Y53; line h0_X54, h0_Y54; line h0_X55, h0_Y55; line h0_X56, h0_Y56; line h0_X57, h0_Y57; line h0_X58, h0_Y58; line h0_X59, h0_Y59; line h0_X60, h0_Y60; line h0_X61, h0_Y61; line h0_X62, h0_Y62; line h0_X63, h0_Y63 }
                }
                path { stroke: 1.7; color: rgb(h0_r, h0_g, h0_b); move h0_X0, h0_Y0; line h0_X1, h0_Y1; line h0_X2, h0_Y2; line h0_X3, h0_Y3; line h0_X4, h0_Y4; line h0_X5, h0_Y5; line h0_X6, h0_Y6; line h0_X7, h0_Y7; line h0_X8, h0_Y8; line h0_X9, h0_Y9; line h0_X10, h0_Y10; line h0_X11, h0_Y11; line h0_X12, h0_Y12; line h0_X13, h0_Y13; line h0_X14, h0_Y14; line h0_X15, h0_Y15; line h0_X16, h0_Y16; line h0_X17, h0_Y17; line h0_X18, h0_Y18; line h0_X19, h0_Y19; line h0_X20, h0_Y20; line h0_X21, h0_Y21; line h0_X22, h0_Y22; line h0_X23, h0_Y23; line h0_X24, h0_Y24; line h0_X25, h0_Y25; line h0_X26, h0_Y26; line h0_X27, h0_Y27; line h0_X28, h0_Y28; line h0_X29, h0_Y29; line h0_X30, h0_Y30; line h0_X31, h0_Y31; line h0_X32, h0_Y32; line h0_X33, h0_Y33; line h0_X34, h0_Y34; line h0_X35, h0_Y35; line h0_X36, h0_Y36; line h0_X37, h0_Y37; line h0_X38, h0_Y38; line h0_X39, h0_Y39; line h0_X40, h0_Y40; line h0_X41, h0_Y41; line h0_X42, h0_Y42; line h0_X43, h0_Y43; line h0_X44, h0_Y44; line h0_X45, h0_Y45; line h0_X46, h0_Y46; line h0_X47, h0_Y47; line h0_X48, h0_Y48; line h0_X49, h0_Y49; line h0_X50, h0_Y50; line h0_X51, h0_Y51; line h0_X52, h0_Y52; line h0_X53, h0_Y53; line h0_X54, h0_Y54; line h0_X55, h0_Y55; line h0_X56, h0_Y56; line h0_X57, h0_Y57; line h0_X58, h0_Y58; line h0_X59, h0_Y59; line h0_X60, h0_Y60; line h0_X61, h0_Y61; line h0_X62, h0_Y62; line h0_X63, h0_Y63 }
                group { glow: 12, 0.9 * st_glow, #ffffff
                    ellipse { at: pick(mod(floor(ph * 0.3), 64), h0_X0, h0_X1, h0_X2, h0_X3, h0_X4, h0_X5, h0_X6, h0_X7, h0_X8, h0_X9, h0_X10, h0_X11, h0_X12, h0_X13, h0_X14, h0_X15, h0_X16, h0_X17, h0_X18, h0_X19, h0_X20, h0_X21, h0_X22, h0_X23, h0_X24, h0_X25, h0_X26, h0_X27, h0_X28, h0_X29, h0_X30, h0_X31, h0_X32, h0_X33, h0_X34, h0_X35, h0_X36, h0_X37, h0_X38, h0_X39, h0_X40, h0_X41, h0_X42, h0_X43, h0_X44, h0_X45, h0_X46, h0_X47, h0_X48, h0_X49, h0_X50, h0_X51, h0_X52, h0_X53, h0_X54, h0_X55, h0_X56, h0_X57, h0_X58, h0_X59, h0_X60, h0_X61, h0_X62, h0_X63), pick(mod(floor(ph * 0.3), 64), h0_Y0, h0_Y1, h0_Y2, h0_Y3, h0_Y4, h0_Y5, h0_Y6, h0_Y7, h0_Y8, h0_Y9, h0_Y10, h0_Y11, h0_Y12, h0_Y13, h0_Y14, h0_Y15, h0_Y16, h0_Y17, h0_Y18, h0_Y19, h0_Y20, h0_Y21, h0_Y22, h0_Y23, h0_Y24, h0_Y25, h0_Y26, h0_Y27, h0_Y28, h0_Y29, h0_Y30, h0_Y31, h0_Y32, h0_Y33, h0_Y34, h0_Y35, h0_Y36, h0_Y37, h0_Y38, h0_Y39, h0_Y40, h0_Y41, h0_Y42, h0_Y43, h0_Y44, h0_Y45, h0_Y46, h0_Y47, h0_Y48, h0_Y49, h0_Y50, h0_Y51, h0_Y52, h0_Y53, h0_Y54, h0_Y55, h0_Y56, h0_Y57, h0_Y58, h0_Y59, h0_Y60, h0_Y61, h0_Y62, h0_Y63); radius: 2; color: #ffffff; show: wob > 0 } }
            }
            zone box dz { from: d_x, d_y; size: d_w, d_h; cursor: pointer; role: button; label: "The Sigil's display" }
            on press dz { emit sg_press(0) }
            let dz_in = dz.hover > 0.5
            on change dz_in while dz_in { emit sg_hover(3) }
            on change dz_in while not dz_in { emit sg_hover(2) }
        }
    }

    // ── Surface (D209): the opening's ground and edge, and the Presences ──
    shader tear = file "shaders/tear.wgsl"
    shader aperture = file "shaders/aperture.wgsl"
    shader membrane = file "shaders/membrane.wgsl"
    shader ripple = file "shaders/ripple.wgsl"
    shader fold = file "shaders/fold.wgsl"
    shader dissolve = file "shaders/dissolve.wgsl"
    shader glass = file "shaders/glass.wgsl"
    shader glow = file "shaders/glow.wgsl"
    shader ground = file "shaders/ground.wgsl"
    shader aura = file "shaders/aura.wgsl"
    fact rv_on = false
    fact sf_firm = false   // the opening is open and the pointer has moved: the keyboard is ours
    fact sf_fx = 1         // the opening's look: 1 tear · 2 aperture · 3 membrane · 4 ripple · 5 fold · 6 dissolve · 7 glass · 8 glow
    fact sf_int = 0.85     // the effect's strength
    fact sf_edge = 0.5     // the lip's width
    fact sf_col = 0        // the rim's colour: 0 accent · 1 plain · 2 warm
    fact sf_param = 85500  // intensity, edge and colour in one value for the shaders
    fact sf_wall = true
    fact sf_dim = 0.35
    fact sf_tint = 0.18
    fact sf_fit = 0
    fact sf_grid = 0.45
    fact sf_labels = true
    fact sf_glow = 1
    fact sf_ping = 0
    fact sf_ovm = 16
    text rv_wall = ""
    image rv_img = from rv_wall, 0, 0
    image sf_cover = from rv_wall, 0, 0
    image sf_contain = from rv_wall, 0, 0
    event rv_down ->       // from `mooi reveal down`: Super went down
    event rv_up ->         // from `mooi reveal up`: Super came up
    event rv_esc ->        // Escape while revealing
    event rv_move ->       // x * 10000 + y: the pointer while revealing

    surface ground {
        size: full, full
        anchor: top
        level: background
        reserve: -1
        keyboard: none
        rate: 60, 20 while calm
        open: op_vis
        // the opening's repaint (D214): a moving clip leaves what it uncovered behind unless the whole
        // surface is repainted; this veil changes with the hole, and is gone when the opening is
        box { from: 0, 0; size: 8192, 8192; color: #000000; opacity: 0.004 + 0.001 * fract((op_x + op_y + op_w + op_h) / 97); show: op_k > 0.001 }
        group {
            clip box { from: op_x, op_y; size: op_w, op_h; corner: op_r }
            // the wallpaper the opening is cut into: the real one, fitted, with a tint, then the ground's
            // own skin over it (a group's shader sees what the group holds, so the hubs stay above it)
            group {
                clip box { from: op_x, op_y; size: op_w, op_h; corner: op_r }
                image sf_cover { at: 0, 0; size: ground.width, ground.height; fit: cover; show: sf_wall and sf_fit < 0.5 }
                image sf_contain { at: 0, 0; size: ground.width, ground.height; fit: contain; show: sf_wall and sf_fit > 0.5 }
                box { from: op_x, op_y; size: op_w, op_h; color: rgb(0.62, 0.84, 0.74); opacity: sf_tint * 0.16; show: sf_wall }
                shader: ground, op_k, op_x, op_y, sf_dim, sf_grid, sf_tint
            }
            // light through the skin: a soft glow at Music and the Notices while the opening is open
            shader aura { at: op_x, op_y; size: op_w, op_h; values: op_k, op_x, op_y, au_mx, au_my, au_nx, au_ny, sf_glow + sf_ping * 1.5; colors: rgb(0.62, 0.84, 0.74), rgb(0.95, 0.62, 0.38); show: op_vis and sf_glow > 0.5 }
            // the Overview: the wallpaper pulls back to a thin lit margin and the canvas takes the screen
            box { from: op_x + sf_ovm, op_y + sf_ovm; size: max(0, op_w - 2 * sf_ovm), max(0, op_h - 2 * sf_ovm); corner: max(0, op_r - 6); color: rgb(0.035, 0.05, 0.055); opacity: 0.99; show: op_vis and op_mode == 4 }
            // its grid: three uprights and two crossbars, faint enough to arrange against without seeing lines
            box { from: op_x + op_w * 0.25, op_y + sf_ovm; size: 1, max(0, op_h - 2 * sf_ovm); color: rgb(0.62, 0.84, 0.74); opacity: 0.03; show: op_vis and op_mode == 4 }
            box { from: op_x + op_w * 0.5, op_y + sf_ovm; size: 1, max(0, op_h - 2 * sf_ovm); color: rgb(0.62, 0.84, 0.74); opacity: 0.03; show: op_vis and op_mode == 4 }
            box { from: op_x + op_w * 0.75, op_y + sf_ovm; size: 1, max(0, op_h - 2 * sf_ovm); color: rgb(0.62, 0.84, 0.74); opacity: 0.03; show: op_vis and op_mode == 4 }
            box { from: op_x + sf_ovm, op_y + op_h * 0.33; size: max(0, op_w - 2 * sf_ovm), 1; color: rgb(0.62, 0.84, 0.74); opacity: 0.03; show: op_vis and op_mode == 4 }
            box { from: op_x + sf_ovm, op_y + op_h * 0.66; size: max(0, op_w - 2 * sf_ovm), 1; color: rgb(0.62, 0.84, 0.74); opacity: 0.03; show: op_vis and op_mode == 4 }
            text "THE SUBSURFACE" { at: op_x + sf_ovm + 24, op_y + sf_ovm + 48; anchor: left center; size: 11; weight: 700; family: "Share Tech Mono"; color: rgb(0.62, 0.84, 0.74); show: op_vis and op_mode == 4 }
            text "the widgets are in edit mode: drag, resize, undo  /  type to find an app  /  Esc to close" { at: op_x + sf_ovm + 24, op_y + sf_ovm + 66; anchor: left center; size: 10; family: "Share Tech Mono"; color: rgb(0.55, 0.6, 0.58); show: op_mode == 4 and sf_labels > 0.5 }
            // the Overview's close, over the canvas at its top right (undo is the widgets' own, in edit mode)
            box { from: op_x + op_w - sf_ovm - 92, op_y + sf_ovm + 108; size: 80, 26; corner: 6; color: rgb(0.08, 0.1, 0.11); opacity: 0.72; show: op_vis and op_mode == 4 }
            text "CLOSE" { at: op_x + op_w - sf_ovm - 52, op_y + sf_ovm + 108 + 13; anchor: center; align: center; size: 9; weight: 700; family: "Share Tech Mono"; color: rgb(0.62, 0.84, 0.74); show: op_vis and op_mode == 4 }
            zone box ov_close { from: op_x + op_w - sf_ovm - 92, op_y + sf_ovm + 108; size: 80, 26; cursor: pointer; role: button; label: "Close the Overview"; show: op_live and op_mode == 4 }
            on press ov_close { emit rv_esc }
            // a press on the thin wallpaper margin closes it too
            zone box ov_edge_t { from: op_x, op_y; size: op_w, max(1, sf_ovm); cursor: pointer; role: button; label: "Close the Overview"; show: op_live and op_mode == 4 and sf_ovm > 0.5 }
            on press ov_edge_t { emit rv_esc }
            zone box ov_edge_b { from: op_x, op_y + op_h - sf_ovm; size: op_w, max(1, sf_ovm); cursor: pointer; role: button; label: "Close the Overview"; show: op_live and op_mode == 4 and sf_ovm > 0.5 }
            on press ov_edge_b { emit rv_esc }
            zone box ov_edge_l { from: op_x, op_y + sf_ovm; size: max(1, sf_ovm), max(0, op_h - 2 * sf_ovm); cursor: pointer; role: button; label: "Close the Overview"; show: op_live and op_mode == 4 and sf_ovm > 0.5 }
            on press ov_edge_l { emit rv_esc }
            zone box ov_edge_r { from: op_x + op_w - sf_ovm, op_y + sf_ovm; size: max(1, sf_ovm), max(0, op_h - 2 * sf_ovm); cursor: pointer; role: button; label: "Close the Overview"; show: op_live and op_mode == 4 and sf_ovm > 0.5 }
            on press ov_edge_r { emit rv_esc }
            // the Overview's thin lit margin: the wallpaper's edge, pulled back
            box { from: op_x + sf_ovm, op_y + sf_ovm; size: max(0, op_w - 2 * sf_ovm), max(0, op_h - 2 * sf_ovm); stroke: 1; color: rgb(0.62, 0.84, 0.74); opacity: 0.32; show: op_vis and op_mode == 4 and sf_ovm > 0.5 }
        }
    }

    surface edge {
        size: full, full
        anchor: top
        level: bottom
        reserve: -1
        keyboard: exclusive while op_vis and sf_firm
        rate: 60
        open: op_vis
        // the opening's repaint (D214): a moving clip leaves what it uncovered behind unless the whole
        // surface is repainted; this veil changes with the hole, and is gone when the opening is
        box { from: 0, 0; size: 8192, 8192; color: #000000; opacity: 0.004 + 0.001 * fract((op_x + op_y + op_w + op_h) / 97); show: op_k > 0.001 }
        // where the pointer is, told to the logic as it moves (every 6 px), while revealing
        let rv_q = round(cursor.x / 6) * 100000 + round(cursor.y / 6)
        on change rv_q while rv_on or op_vis { emit rv_move(round(cursor.x) * 10000 + round(cursor.y)) }
        // the keyboard, once the opening is firm: walk the places, press, widen, heal
        on key Escape { emit rv_esc }
        on key Tab { emit op_key(1) }
        on key Shift+Tab { emit op_key(-1) }
        on key Return { emit op_key(2) }
        on key Page_Up { emit op_wheel(1) }
        on key Page_Down { emit op_wheel(-1) }
        // typing into Launch's grid while the Overview is open: letters, a space, a rub-out
        on key a while op_mode == 4 { emit op_type(97) }
        on key b while op_mode == 4 { emit op_type(98) }
        on key c while op_mode == 4 { emit op_type(99) }
        on key d while op_mode == 4 { emit op_type(100) }
        on key e while op_mode == 4 { emit op_type(101) }
        on key f while op_mode == 4 { emit op_type(102) }
        on key g while op_mode == 4 { emit op_type(103) }
        on key h while op_mode == 4 { emit op_type(104) }
        on key i while op_mode == 4 { emit op_type(105) }
        on key j while op_mode == 4 { emit op_type(106) }
        on key k while op_mode == 4 { emit op_type(107) }
        on key l while op_mode == 4 { emit op_type(108) }
        on key m while op_mode == 4 { emit op_type(109) }
        on key n while op_mode == 4 { emit op_type(110) }
        on key o while op_mode == 4 { emit op_type(111) }
        on key p while op_mode == 4 { emit op_type(112) }
        on key q while op_mode == 4 { emit op_type(113) }
        on key r while op_mode == 4 { emit op_type(114) }
        on key s while op_mode == 4 { emit op_type(115) }
        on key t while op_mode == 4 { emit op_type(116) }
        on key u while op_mode == 4 { emit op_type(117) }
        on key v while op_mode == 4 { emit op_type(118) }
        on key w while op_mode == 4 { emit op_type(119) }
        on key x while op_mode == 4 { emit op_type(120) }
        on key y while op_mode == 4 { emit op_type(121) }
        on key z while op_mode == 4 { emit op_type(122) }
        on key Left while op_mode == 4 { emit op_wkey(1) }
        on key Right while op_mode == 4 { emit op_wkey(2) }
        on key Up while op_mode == 4 { emit op_wkey(3) }
        on key Down while op_mode == 4 { emit op_wkey(4) }
        on key Shift+Left while op_mode == 4 { emit op_wkey(5) }
        on key Shift+Right while op_mode == 4 { emit op_wkey(6) }
        on key Shift+Up while op_mode == 4 { emit op_wkey(7) }
        on key Shift+Down while op_mode == 4 { emit op_wkey(8) }
        on key Delete while op_mode == 4 { emit op_wkey(9) }
        on key Ctrl+d while op_mode == 4 { emit op_wkey(10) }
        on key Ctrl+z while op_mode == 4 { emit op_wkey(11) }
        on key Ctrl+Shift+z while op_mode == 4 { emit op_wkey(12) }
        on key Ctrl+a while op_mode == 4 { emit op_wkey(13) }
        on key space while op_mode == 4 { emit op_type(32) }
        on key BackSpace while op_mode == 4 { emit op_type(8) }
        // the eight looks: the real wallpaper, cut open over the hole (the surface's own size: screen.height
        // is the scene's first surface's, the 40 px bar strip — found live, D208)
        // a group's shader sees its own box: the clip's, from its top left corner — each derives the screen
        // origin from op_x/op_y in its own file, so all eight values are free for shape and strength
        // (the intensity, edge and colour arrive packed in sf_param: see the shaders)
        group {
            show: sf_fx > 0.5 and sf_fx < 1.5
            clip box { from: op_x - 40, op_y - 40; size: op_w + 80, op_h + 80; corner: op_r + 40 }
            shader: tear, op_k, op_x, op_y, op_w, op_h, op_r, sf_param, 0
            image rv_img { at: 0, 0; size: edge.width, edge.height; fit: cover }
        }
        group {
            show: sf_fx > 1.5 and sf_fx < 2.5
            clip box { from: op_x - 40, op_y - 40; size: op_w + 80, op_h + 80; corner: op_r + 40 }
            shader: aperture, op_k, op_x, op_y, op_w, op_h, op_r, sf_param, 0
            image rv_img { at: 0, 0; size: edge.width, edge.height; fit: cover }
        }
        group {
            show: sf_fx > 2.5 and sf_fx < 3.5
            clip box { from: op_x - 40, op_y - 40; size: op_w + 80, op_h + 80; corner: op_r + 40 }
            shader: membrane, op_k, op_x, op_y, op_w, op_h, op_r, sf_param, 0
            image rv_img { at: 0, 0; size: edge.width, edge.height; fit: cover }
        }
        group {
            show: sf_fx > 3.5 and sf_fx < 4.5
            clip box { from: op_x - 40, op_y - 40; size: op_w + 80, op_h + 80; corner: op_r + 40 }
            shader: ripple, op_k, op_x, op_y, op_w, op_h, op_r, sf_param, 0
            image rv_img { at: 0, 0; size: edge.width, edge.height; fit: cover }
        }
        group {
            show: sf_fx > 4.5 and sf_fx < 5.5
            clip box { from: op_x - 40, op_y - 40; size: op_w + 80, op_h + 80; corner: op_r + 40 }
            shader: fold, op_k, op_x, op_y, op_w, op_h, op_r, sf_param, 0
            image rv_img { at: 0, 0; size: edge.width, edge.height; fit: cover }
        }
        group {
            show: sf_fx > 5.5 and sf_fx < 6.5
            clip box { from: op_x - 40, op_y - 40; size: op_w + 80, op_h + 80; corner: op_r + 40 }
            shader: dissolve, op_k, op_x, op_y, op_w, op_h, op_r, sf_param, 0
            image rv_img { at: 0, 0; size: edge.width, edge.height; fit: cover }
        }
        group {
            show: sf_fx > 6.5 and sf_fx < 7.5
            clip box { from: op_x - 40, op_y - 40; size: op_w + 80, op_h + 80; corner: op_r + 40 }
            shader: glass, op_k, op_x, op_y, op_w, op_h, op_r, sf_param, 0
            image rv_img { at: 0, 0; size: edge.width, edge.height; fit: cover }
        }
        group {
            show: sf_fx > 7.5 and sf_fx < 8.5
            clip box { from: op_x - 40, op_y - 40; size: op_w + 80, op_h + 80; corner: op_r + 40 }
            shader: glow, op_k, op_x, op_y, op_w, op_h, op_r, sf_param, 0
            image rv_img { at: 0, 0; size: edge.width, edge.height; fit: cover }
        }
    }
}
