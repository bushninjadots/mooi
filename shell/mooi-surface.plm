language 0.9

// The Subsurface (D209): hold Super and the wallpaper opens — GENERATED by tools/gen-surface.py; do not edit.
// The logic (shell/mooi-surface.luau) owns the opening and the push up from below; this springs and draws them.
// (D226: the Sigil, the living line this program first drew, gave way to the node — shell/mooi-node.plm.)

scene Sigil {
    permissions {
        run: "pleamar", "mooi", "hyprctl", "readlink"
        services: "files", "files.write", "env", "audio.level", "media", "workspaces", "window", "clock", "capture", "thumbnails", "thumbnails.*"
    }
    service audio.level as lv { level: number }
    fact calm = false     // (the opening's surfaces paint at their full rate while they are open)
    // <gen:opening>
    // The opening (D209): mooi-surface packs the hole into three numbers (lib/surface/opening `pack`);
    // every program turns them into the same sprung rectangle. mode = c / 1000: closed 0 · follow 1 · snapped 2 ·
    // section 3 · full 4. Follow sends no a, b: the target is the square of side 2 * R on the pointer.
    // A fresh opening is faint (c carries 500) until it is firm or snapped: drawn weaker, and no zone answers.
    event op_a ->          // x * 4096 + y
    event op_b ->          // w * 4096 + h
    event op_c ->          // mode * 1000 + (500 while faint) + r
    event sf_set ->        // the Surface: bit 0 on, bit 1 BMO lives below
    event op_want ->       // to mooi-surface: what a program under the wallpaper asks for
    event op_key ->        // the keyboard: 1 next · -1 before · 2 press what is snapped
    event op_wheel ->      // the wheel while the opening shows: 1 widen · -1 narrow
    fact op_ta = 0
    fact op_tb = 0
    fact op_tc = 0
    fact sf_on = false     // Surface on
    fact sf_bmo = true     // BMO lives below
    on op_a(v) { op_ta = v }
    on op_b(v) { op_tb = v }
    on op_c(v) { op_tc = v }
    on sf_set(v) { sf_on = mod(v, 2) == 1; sf_bmo = floor(v / 2) == 1 }
    spring sg.op = 380, 34
    let op_mode = if(sf_on, floor(op_tc / 1000), 0)
    let op_r1 = op_tc - floor(op_tc / 1000) * 1000
    let op_faint = op_r1 > 499.5
    let op_r0 = op_r1 - if(op_faint, 500, 0)
    let op_ax = floor(op_ta / 4096)
    let op_aw = floor(op_tb / 4096)
    // D218: every mode, follow too, draws the hole mooi-surface sends: it reads the pointer from Hyprland
    // while Super is held (a scene's own pointer reading stands still while it is over anything else)
    let op_tx = op_ax
    let op_ty = op_ta - op_ax * 4096
    let op_tw = op_aw
    let op_th = op_tb - op_aw * 4096
    let op_tr = op_r0
    prop op_x = 0 ~sg.op
    follow op_x = op_tx
    prop op_y = 0 ~sg.op
    follow op_y = op_ty
    prop op_w = 0 ~sg.op
    follow op_w = op_tw
    prop op_h = 0 ~sg.op
    follow op_h = op_th
    prop op_r = 0 ~sg.op
    follow op_r = op_tr
    prop op_k = 0 ~sg.op
    follow op_k = if(op_mode > 0, if(op_faint, 0.45, 1), 0)
    let op_vis = sf_on and op_k > 0.01
    let op_live = op_vis and not op_faint     // what is below answers a press only once the opening is firm
    // </gen:opening>

    // ── the subsurface (D209, D215): the opening's own facts; the things below are mooi-widgets' ──
    event op_type ->      // a letter typed in the Overview (its code; 8 rubs one out): sent on to Launch's grid
    event lw_try ->       // D221: Live wallpaper's Try it (from mooi-settings): every effect that is on, now
    event op_bx ->        // from BMO: where he stands, x * 4096 + y
    event op_bs ->        // ... and how big he is, w * 4096 + h
    event op_wbar ->      // from mooi-widgets: how far below the screen's top its surface starts
    event op_wkey ->      // an edit key in the Overview, sent on to mooi-widgets as its own (wg_key)
    event sb_drag ->      // from mooi-widgets: a widget is being dragged in the opening (-1)
    event sb_drop ->      // ... and let go
    fact sf_snap = 0      // what the opening hugs: BMO 20, a widget 30, none 0
    // light through the skin: the centres of the Now Playing and Notices widgets, on the screen (far off: none)
    fact au_mx = -9999
    fact au_my = -9999
    fact au_nx = -9999
    fact au_ny = -9999

    // ── Surface (D209): the opening's ground and edge, and the Presences ──
    shader tear = file "shaders/tear.wgsl"
    shader aperture = file "shaders/aperture.wgsl"
    shader membrane = file "shaders/membrane.wgsl"
    shader ripple = file "shaders/ripple.wgsl"
    shader fold = file "shaders/fold.wgsl"
    shader dissolve = file "shaders/dissolve.wgsl"
    shader glass = file "shaders/glass.wgsl"
    shader glow = file "shaders/glow.wgsl"
    shader ground = file "shaders/ground.wgsl"
    shader aura = file "shaders/aura.wgsl"
    shader bulge = file "shaders/bulge.wgsl"
    shader skin = file "shaders/skin.wgsl"
    shader music = file "shaders/music.wgsl"
    fact rv_on = false
    fact sf_firm = false   // the opening is open and the pointer has moved: the keyboard is ours
    fact sf_fx = 1         // the opening's look: 1 tear · 2 aperture · 3 membrane · 4 ripple · 5 fold · 6 dissolve · 7 glass · 8 glow
    fact sf_int = 0.85     // the effect's strength
    fact sf_edge = 0.5     // the lip's width
    fact sf_col = 0        // the rim's colour: 0 accent · 1 plain · 2 warm
    fact sf_param = 85500  // intensity, edge and colour in one value for the shaders
    fact sf_wall = true
    fact sf_dim = 0.35
    fact sf_tint = 0.18
    fact sf_fit = 0
    fact sf_grid = 0.45
    fact sf_labels = true
    fact sf_glow = 1
    fact sf_ping = 0
    fact sf_ovm = 16
    text rv_wall = ""
    image rv_img = from rv_wall, 0, 0
    image sf_cover = from rv_wall, 0, 0
    image sf_contain = from rv_wall, 0, 0
    event rv_down ->       // from `mooi reveal down`: Super went down
    event rv_overview ->   // from `mooi reveal overview` (D271): the Overview at once
    event rv_up ->         // from `mooi reveal up`: Super came up
    event rv_esc ->        // Escape while revealing
    event rv_move ->       // x * 10000 + y: the pointer while revealing

    surface ground {
        size: full, full
        anchor: top
        level: background
        reserve: -1
        keyboard: none
        rate: 60, 20 while calm
        open: op_vis
        // the opening's repaint (D214): a moving clip leaves what it uncovered behind unless the whole
        // surface is repainted; this veil changes with the hole, and is gone when the opening is
        box { from: 0, 0; size: 8192, 8192; color: #000000; opacity: 0.004 + 0.001 * fract((op_x + op_y + op_w + op_h) / 97); show: op_k > 0.001 }
        group {
            clip box { from: op_x, op_y; size: op_w, op_h; corner: op_r }
            // the wallpaper the opening is cut into: the real one, fitted, with a tint, then the ground's
            // own skin over it (a group's shader sees what the group holds, so the hubs stay above it)
            group {
                clip box { from: op_x, op_y; size: op_w, op_h; corner: op_r }
                image sf_cover { at: 0, 0; size: ground.width, ground.height; fit: cover; show: sf_wall and sf_fit < 0.5 }
                image sf_contain { at: 0, 0; size: ground.width, ground.height; fit: contain; show: sf_wall and sf_fit > 0.5 }
                box { from: op_x, op_y; size: op_w, op_h; color: rgb(0.62, 0.84, 0.74); opacity: sf_tint * 0.16; show: sf_wall }
                shader: ground, op_k, op_x, op_y, sf_dim, sf_grid, sf_tint, op_w, op_h
            }
            // light through the skin: a soft glow at Music and the Notices while the opening is open
            shader aura { at: op_x, op_y; size: op_w, op_h; values: op_k, op_x, op_y, au_mx, au_my, au_nx, au_ny, sf_glow + sf_ping * 1.5; colors: rgb(0.62, 0.84, 0.74), rgb(0.95, 0.62, 0.38); show: op_vis and sf_glow > 0.5 }
            // the Overview: the wallpaper pulls back to a thin lit margin and the canvas takes the screen
            box { from: op_x + sf_ovm, op_y + sf_ovm; size: max(0, op_w - 2 * sf_ovm), max(0, op_h - 2 * sf_ovm); corner: max(0, op_r - 6); color: rgb(0.035, 0.05, 0.055); opacity: 0.99; show: op_vis and op_mode == 4 and not sf_mu }
            // its grid: three uprights and two crossbars, faint enough to arrange against without seeing lines
            box { from: op_x + op_w * 0.25, op_y + sf_ovm; size: 1, max(0, op_h - 2 * sf_ovm); color: rgb(0.62, 0.84, 0.74); opacity: 0.03; show: op_vis and op_mode == 4 and not sf_mu }
            box { from: op_x + op_w * 0.5, op_y + sf_ovm; size: 1, max(0, op_h - 2 * sf_ovm); color: rgb(0.62, 0.84, 0.74); opacity: 0.03; show: op_vis and op_mode == 4 and not sf_mu }
            box { from: op_x + op_w * 0.75, op_y + sf_ovm; size: 1, max(0, op_h - 2 * sf_ovm); color: rgb(0.62, 0.84, 0.74); opacity: 0.03; show: op_vis and op_mode == 4 and not sf_mu }
            box { from: op_x + sf_ovm, op_y + op_h * 0.33; size: max(0, op_w - 2 * sf_ovm), 1; color: rgb(0.62, 0.84, 0.74); opacity: 0.03; show: op_vis and op_mode == 4 and not sf_mu }
            box { from: op_x + sf_ovm, op_y + op_h * 0.66; size: max(0, op_w - 2 * sf_ovm), 1; color: rgb(0.62, 0.84, 0.74); opacity: 0.03; show: op_vis and op_mode == 4 and not sf_mu }
            text "THE SUBSURFACE" { at: op_x + sf_ovm + 24, op_y + op_h - sf_ovm - 44; anchor: left center; size: 11; weight: 700; family: "Share Tech Mono"; color: rgb(0.62, 0.84, 0.74); show: op_vis and op_mode == 4 }
            text "the widgets are in edit mode: drag, resize, undo  /  type to find an app  /  Esc to close" { at: op_x + sf_ovm + 24, op_y + op_h - sf_ovm - 26; anchor: left center; size: 10; family: "Share Tech Mono"; color: rgb(0.55, 0.6, 0.58); show: op_mode == 4 and sf_labels > 0.5 }
            // D224: buried windows, each a tile where it was buried; a press brings it back
            group { show: op_vis and bt1 and not sf_mu
                group { glow: 18, 0.5, #000000
                    box { from: bt1x, bt1y; size: bt1w, bt1h; corner: 10; color: rgb(0.05, 0.06, 0.07); opacity: 0.94 } }
                group { clip box { from: bt1x + 6, bt1y + 6; size: bt1w - 12, bt1h - 34; corner: 6 }
                    image bt1_img { at: bt1x + 6, bt1y + 6; size: bt1w - 12, bt1h - 34; fit: cover } }
                text bt1_name { at: bt1x + 10, bt1y + bt1h - 14; anchor: left center; size: 10; weight: 700; family: "Share Tech Mono"; color: rgb(0.86, 0.9, 0.88); width: bt1w - 20; lines: 1 }
                box { from: bt1x + 0.5, bt1y + 0.5; size: bt1w - 1, bt1h - 1; corner: 10; stroke: 1; color: rgb(0.62, 0.84, 0.74); opacity: 0.5 }
                zone box bt_z1 { from: bt1x, bt1y; size: bt1w, bt1h; corner: 10; cursor: pointer; role: button; label: "Bring this window back"; show: op_live and bt1 }
                on press bt_z1 { emit bt_go(1) }
            }
            group { show: op_vis and bt2 and not sf_mu
                group { glow: 18, 0.5, #000000
                    box { from: bt2x, bt2y; size: bt2w, bt2h; corner: 10; color: rgb(0.05, 0.06, 0.07); opacity: 0.94 } }
                group { clip box { from: bt2x + 6, bt2y + 6; size: bt2w - 12, bt2h - 34; corner: 6 }
                    image bt2_img { at: bt2x + 6, bt2y + 6; size: bt2w - 12, bt2h - 34; fit: cover } }
                text bt2_name { at: bt2x + 10, bt2y + bt2h - 14; anchor: left center; size: 10; weight: 700; family: "Share Tech Mono"; color: rgb(0.86, 0.9, 0.88); width: bt2w - 20; lines: 1 }
                box { from: bt2x + 0.5, bt2y + 0.5; size: bt2w - 1, bt2h - 1; corner: 10; stroke: 1; color: rgb(0.62, 0.84, 0.74); opacity: 0.5 }
                zone box bt_z2 { from: bt2x, bt2y; size: bt2w, bt2h; corner: 10; cursor: pointer; role: button; label: "Bring this window back"; show: op_live and bt2 }
                on press bt_z2 { emit bt_go(2) }
            }
            group { show: op_vis and bt3 and not sf_mu
                group { glow: 18, 0.5, #000000
                    box { from: bt3x, bt3y; size: bt3w, bt3h; corner: 10; color: rgb(0.05, 0.06, 0.07); opacity: 0.94 } }
                group { clip box { from: bt3x + 6, bt3y + 6; size: bt3w - 12, bt3h - 34; corner: 6 }
                    image bt3_img { at: bt3x + 6, bt3y + 6; size: bt3w - 12, bt3h - 34; fit: cover } }
                text bt3_name { at: bt3x + 10, bt3y + bt3h - 14; anchor: left center; size: 10; weight: 700; family: "Share Tech Mono"; color: rgb(0.86, 0.9, 0.88); width: bt3w - 20; lines: 1 }
                box { from: bt3x + 0.5, bt3y + 0.5; size: bt3w - 1, bt3h - 1; corner: 10; stroke: 1; color: rgb(0.62, 0.84, 0.74); opacity: 0.5 }
                zone box bt_z3 { from: bt3x, bt3y; size: bt3w, bt3h; corner: 10; cursor: pointer; role: button; label: "Bring this window back"; show: op_live and bt3 }
                on press bt_z3 { emit bt_go(3) }
            }
            group { show: op_vis and bt4 and not sf_mu
                group { glow: 18, 0.5, #000000
                    box { from: bt4x, bt4y; size: bt4w, bt4h; corner: 10; color: rgb(0.05, 0.06, 0.07); opacity: 0.94 } }
                group { clip box { from: bt4x + 6, bt4y + 6; size: bt4w - 12, bt4h - 34; corner: 6 }
                    image bt4_img { at: bt4x + 6, bt4y + 6; size: bt4w - 12, bt4h - 34; fit: cover } }
                text bt4_name { at: bt4x + 10, bt4y + bt4h - 14; anchor: left center; size: 10; weight: 700; family: "Share Tech Mono"; color: rgb(0.86, 0.9, 0.88); width: bt4w - 20; lines: 1 }
                box { from: bt4x + 0.5, bt4y + 0.5; size: bt4w - 1, bt4h - 1; corner: 10; stroke: 1; color: rgb(0.62, 0.84, 0.74); opacity: 0.5 }
                zone box bt_z4 { from: bt4x, bt4y; size: bt4w, bt4h; corner: 10; cursor: pointer; role: button; label: "Bring this window back"; show: op_live and bt4 }
                on press bt_z4 { emit bt_go(4) }
            }
            group { show: op_vis and bt5 and not sf_mu
                group { glow: 18, 0.5, #000000
                    box { from: bt5x, bt5y; size: bt5w, bt5h; corner: 10; color: rgb(0.05, 0.06, 0.07); opacity: 0.94 } }
                group { clip box { from: bt5x + 6, bt5y + 6; size: bt5w - 12, bt5h - 34; corner: 6 }
                    image bt5_img { at: bt5x + 6, bt5y + 6; size: bt5w - 12, bt5h - 34; fit: cover } }
                text bt5_name { at: bt5x + 10, bt5y + bt5h - 14; anchor: left center; size: 10; weight: 700; family: "Share Tech Mono"; color: rgb(0.86, 0.9, 0.88); width: bt5w - 20; lines: 1 }
                box { from: bt5x + 0.5, bt5y + 0.5; size: bt5w - 1, bt5h - 1; corner: 10; stroke: 1; color: rgb(0.62, 0.84, 0.74); opacity: 0.5 }
                zone box bt_z5 { from: bt5x, bt5y; size: bt5w, bt5h; corner: 10; cursor: pointer; role: button; label: "Bring this window back"; show: op_live and bt5 }
                on press bt_z5 { emit bt_go(5) }
            }
            group { show: op_vis and bt6 and not sf_mu
                group { glow: 18, 0.5, #000000
                    box { from: bt6x, bt6y; size: bt6w, bt6h; corner: 10; color: rgb(0.05, 0.06, 0.07); opacity: 0.94 } }
                group { clip box { from: bt6x + 6, bt6y + 6; size: bt6w - 12, bt6h - 34; corner: 6 }
                    image bt6_img { at: bt6x + 6, bt6y + 6; size: bt6w - 12, bt6h - 34; fit: cover } }
                text bt6_name { at: bt6x + 10, bt6y + bt6h - 14; anchor: left center; size: 10; weight: 700; family: "Share Tech Mono"; color: rgb(0.86, 0.9, 0.88); width: bt6w - 20; lines: 1 }
                box { from: bt6x + 0.5, bt6y + 0.5; size: bt6w - 1, bt6h - 1; corner: 10; stroke: 1; color: rgb(0.62, 0.84, 0.74); opacity: 0.5 }
                zone box bt_z6 { from: bt6x, bt6y; size: bt6w, bt6h; corner: 10; cursor: pointer; role: button; label: "Bring this window back"; show: op_live and bt6 }
                on press bt_z6 { emit bt_go(6) }
            }
            group { show: op_vis and bt7 and not sf_mu
                group { glow: 18, 0.5, #000000
                    box { from: bt7x, bt7y; size: bt7w, bt7h; corner: 10; color: rgb(0.05, 0.06, 0.07); opacity: 0.94 } }
                group { clip box { from: bt7x + 6, bt7y + 6; size: bt7w - 12, bt7h - 34; corner: 6 }
                    image bt7_img { at: bt7x + 6, bt7y + 6; size: bt7w - 12, bt7h - 34; fit: cover } }
                text bt7_name { at: bt7x + 10, bt7y + bt7h - 14; anchor: left center; size: 10; weight: 700; family: "Share Tech Mono"; color: rgb(0.86, 0.9, 0.88); width: bt7w - 20; lines: 1 }
                box { from: bt7x + 0.5, bt7y + 0.5; size: bt7w - 1, bt7h - 1; corner: 10; stroke: 1; color: rgb(0.62, 0.84, 0.74); opacity: 0.5 }
                zone box bt_z7 { from: bt7x, bt7y; size: bt7w, bt7h; corner: 10; cursor: pointer; role: button; label: "Bring this window back"; show: op_live and bt7 }
                on press bt_z7 { emit bt_go(7) }
            }
            group { show: op_vis and bt8 and not sf_mu
                group { glow: 18, 0.5, #000000
                    box { from: bt8x, bt8y; size: bt8w, bt8h; corner: 10; color: rgb(0.05, 0.06, 0.07); opacity: 0.94 } }
                group { clip box { from: bt8x + 6, bt8y + 6; size: bt8w - 12, bt8h - 34; corner: 6 }
                    image bt8_img { at: bt8x + 6, bt8y + 6; size: bt8w - 12, bt8h - 34; fit: cover } }
                text bt8_name { at: bt8x + 10, bt8y + bt8h - 14; anchor: left center; size: 10; weight: 700; family: "Share Tech Mono"; color: rgb(0.86, 0.9, 0.88); width: bt8w - 20; lines: 1 }
                box { from: bt8x + 0.5, bt8y + 0.5; size: bt8w - 1, bt8h - 1; corner: 10; stroke: 1; color: rgb(0.62, 0.84, 0.74); opacity: 0.5 }
                zone box bt_z8 { from: bt8x, bt8y; size: bt8w, bt8h; corner: 10; cursor: pointer; role: button; label: "Bring this window back"; show: op_live and bt8 }
                on press bt_z8 { emit bt_go(8) }
            }
            // D223: the Overview's Music mode — the whole picture at full light, and where the music grows from
            box { from: op_x + op_w - sf_ovm - 184, op_y + sf_ovm + 108; size: 80, 26; corner: 6; color: rgb(0.08, 0.1, 0.11); opacity: 0.72; show: op_vis and op_mode == 4 and not sf_mu }
            text "MUSIC" { at: op_x + op_w - sf_ovm - 144, op_y + sf_ovm + 121; anchor: center; align: center; size: 9; weight: 700; family: "Share Tech Mono"; color: rgb(0.62, 0.84, 0.74); show: op_vis and op_mode == 4 and not sf_mu }
            zone box ov_music { from: op_x + op_w - sf_ovm - 184, op_y + sf_ovm + 108; size: 80, 26; cursor: pointer; role: button; label: "Music in the picture: where it grows from"; show: op_live and op_mode == 4 and not sf_mu }
            on press ov_music { emit mu_mode(1) }
            group {
                show: op_vis and op_mode == 4 and sf_mu
                clip box { from: op_x, op_y; size: op_w, op_h; corner: op_r }
                image sf_cover { at: 0, 0; size: ground.width, ground.height; fit: cover }
                // where it grows from: the edge line, the areas, the rubber band
                line { from: op_x, mu_ey + mu_eh; to: op_x + op_w, mu_ey + mu_eh; width: 2; color: rgb(0.62, 0.84, 0.74); opacity: if(mu_e, 0.9, 0.3) }
                text "EDGE" { at: op_x + 24, mu_ey + mu_eh - 12; anchor: left center; size: 9; weight: 700; family: "Share Tech Mono"; color: rgb(0.62, 0.84, 0.74); opacity: if(mu_e, 1, 0.4) }
                box { from: mu_a1x, mu_a1y; size: mu_a1w, mu_a1h; corner: 4; stroke: 1.5; color: rgb(0.62, 0.84, 0.74); opacity: 0.85; show: mu_a1 }
                box { from: mu_a2x, mu_a2y; size: mu_a2w, mu_a2h; corner: 4; stroke: 1.5; color: rgb(0.62, 0.84, 0.74); opacity: 0.85; show: mu_a2 }
                box { from: mu_a3x, mu_a3y; size: mu_a3w, mu_a3h; corner: 4; stroke: 1.5; color: rgb(0.62, 0.84, 0.74); opacity: 0.85; show: mu_a3 }
                box { from: mu_a4x, mu_a4y; size: mu_a4w, mu_a4h; corner: 4; stroke: 1.5; color: rgb(0.62, 0.84, 0.74); opacity: 0.85; show: mu_a4 }
                box { from: min(mu_px, mu_qx), min(mu_py, mu_qy); size: abs(mu_qx - mu_px), abs(mu_qy - mu_py); corner: 4; stroke: 1.5; color: rgb(0.95, 0.62, 0.38); show: mu_dr }
                // the toolbar
                box { from: op_x + op_w / 2 - 430, op_y + sf_ovm + 64 - 6; size: 860, 40; corner: 8; color: rgb(0.05, 0.06, 0.07); opacity: 0.88 }
                box { from: op_x + op_w / 2 - 422 + 0, op_y + sf_ovm + 64; size: 106, 28; corner: 5; color: if(mu_e, rgb(0.62, 0.84, 0.74), rgb(0.12, 0.14, 0.15)); opacity: 0.92 }
                text "EDGE" { at: op_x + op_w / 2 - 422 + 0 + 53, op_y + sf_ovm + 64 + 14; anchor: center; align: center; size: 9; weight: 700; family: "Share Tech Mono"; color: if(mu_e, rgb(0.05, 0.06, 0.07), rgb(0.86, 0.9, 0.88)) }
                zone box mu_t_edge { from: op_x + op_w / 2 - 422 + 0, op_y + sf_ovm + 64; size: 106, 28; cursor: pointer; role: button; label: "Edge"; show: op_live }
                on press mu_t_edge { emit mu_tog(1) }
                box { from: op_x + op_w / 2 - 422 + 112, op_y + sf_ovm + 64; size: 106, 28; corner: 5; color: if(mu_s, rgb(0.62, 0.84, 0.74), rgb(0.12, 0.14, 0.15)); opacity: 0.92 }
                text "SUBJECT" { at: op_x + op_w / 2 - 422 + 112 + 53, op_y + sf_ovm + 64 + 14; anchor: center; align: center; size: 9; weight: 700; family: "Share Tech Mono"; color: if(mu_s, rgb(0.05, 0.06, 0.07), rgb(0.86, 0.9, 0.88)) }
                zone box mu_t_subject { from: op_x + op_w / 2 - 422 + 112, op_y + sf_ovm + 64; size: 106, 28; cursor: pointer; role: button; label: "Subject"; show: op_live }
                on press mu_t_subject { emit mu_tog(2) }
                box { from: op_x + op_w / 2 - 422 + 224, op_y + sf_ovm + 64; size: 106, 28; corner: 5; color: if(mu_tool == 1, rgb(0.62, 0.84, 0.74), rgb(0.12, 0.14, 0.15)); opacity: 0.92 }
                text "DRAW AREA" { at: op_x + op_w / 2 - 422 + 224 + 53, op_y + sf_ovm + 64 + 14; anchor: center; align: center; size: 9; weight: 700; family: "Share Tech Mono"; color: if(mu_tool == 1, rgb(0.05, 0.06, 0.07), rgb(0.86, 0.9, 0.88)) }
                zone box mu_t_area { from: op_x + op_w / 2 - 422 + 224, op_y + sf_ovm + 64; size: 106, 28; cursor: pointer; role: button; label: "Draw Area"; show: op_live }
                on press mu_t_area { mu_tool = 1 }
                box { from: op_x + op_w / 2 - 422 + 336, op_y + sf_ovm + 64; size: 106, 28; corner: 5; color: if(mu_tool == 2, rgb(0.62, 0.84, 0.74), rgb(0.12, 0.14, 0.15)); opacity: 0.92 }
                text "PICK COLOUR" { at: op_x + op_w / 2 - 422 + 336 + 53, op_y + sf_ovm + 64 + 14; anchor: center; align: center; size: 9; weight: 700; family: "Share Tech Mono"; color: if(mu_tool == 2, rgb(0.05, 0.06, 0.07), rgb(0.86, 0.9, 0.88)) }
                zone box mu_t_colour { from: op_x + op_w / 2 - 422 + 336, op_y + sf_ovm + 64; size: 106, 28; cursor: pointer; role: button; label: "Pick Colour"; show: op_live }
                on press mu_t_colour { mu_tool = 2 }
                box { from: op_x + op_w / 2 - 422 + 448, op_y + sf_ovm + 64; size: 106, 28; corner: 5; color: if(mu_tool == 3, rgb(0.62, 0.84, 0.74), rgb(0.12, 0.14, 0.15)); opacity: 0.92 }
                text "MOVE EDGE" { at: op_x + op_w / 2 - 422 + 448 + 53, op_y + sf_ovm + 64 + 14; anchor: center; align: center; size: 9; weight: 700; family: "Share Tech Mono"; color: if(mu_tool == 3, rgb(0.05, 0.06, 0.07), rgb(0.86, 0.9, 0.88)) }
                zone box mu_t_line { from: op_x + op_w / 2 - 422 + 448, op_y + sf_ovm + 64; size: 106, 28; cursor: pointer; role: button; label: "Move Edge"; show: op_live }
                on press mu_t_line { mu_tool = 3 }
                box { from: op_x + op_w / 2 - 422 + 560, op_y + sf_ovm + 64; size: 106, 28; corner: 5; color: if(false, rgb(0.62, 0.84, 0.74), rgb(0.12, 0.14, 0.15)); opacity: 0.92 }
                text "CLEAR" { at: op_x + op_w / 2 - 422 + 560 + 53, op_y + sf_ovm + 64 + 14; anchor: center; align: center; size: 9; weight: 700; family: "Share Tech Mono"; color: if(false, rgb(0.05, 0.06, 0.07), rgb(0.86, 0.9, 0.88)) }
                zone box mu_t_clear { from: op_x + op_w / 2 - 422 + 560, op_y + sf_ovm + 64; size: 106, 28; cursor: pointer; role: button; label: "Clear"; show: op_live }
                on press mu_t_clear { emit mu_clear }
                box { from: op_x + op_w / 2 - 422 + 672, op_y + sf_ovm + 64; size: 106, 28; corner: 5; color: if(false, rgb(0.62, 0.84, 0.74), rgb(0.12, 0.14, 0.15)); opacity: 0.92 }
                text "DONE" { at: op_x + op_w / 2 - 422 + 672 + 53, op_y + sf_ovm + 64 + 14; anchor: center; align: center; size: 9; weight: 700; family: "Share Tech Mono"; color: if(false, rgb(0.05, 0.06, 0.07), rgb(0.86, 0.9, 0.88)) }
                zone box mu_t_done { from: op_x + op_w / 2 - 422 + 672, op_y + sf_ovm + 64; size: 106, 28; cursor: pointer; role: button; label: "Done"; show: op_live }
                on press mu_t_done { mu_tool = 0; emit mu_mode(0) }
                box { from: op_x + op_w / 2 + 364, op_y + sf_ovm + 64 + 6; size: 16, 16; corner: 3; color: rgb(mu_c1r, mu_c1g, mu_c1b); show: mu_c1 }
                box { from: op_x + op_w / 2 + 384, op_y + sf_ovm + 64 + 6; size: 16, 16; corner: 3; color: rgb(mu_c2r, mu_c2g, mu_c2b); show: mu_c2 }
                text "DRAG A BOX · CLICK A COLOUR IN THE PICTURE · DRAG THE EDGE LINE" { at: op_x + op_w / 2, op_y + sf_ovm + 64 + 48; anchor: center; align: center; size: 9; family: "Share Tech Mono"; color: rgb(0.86, 0.9, 0.88) }
                // the picture itself: draw, pick, drag
                zone box mu_z { from: op_x, op_y + sf_ovm + 64 + 60; size: op_w, op_h - (sf_ovm + 124); cursor: crosshair; role: button; label: "The picture"; show: op_live and mu_tool > 0 }
                on press mu_z while mu_tool == 1 { mu_px = pointer.x; mu_py = pointer.y; mu_qx = pointer.x; mu_qy = pointer.y; mu_dr = true }
                on drag mu_z while mu_tool == 1 { mu_qx = pointer.x; mu_qy = pointer.y }
                on release mu_z while mu_tool == 1 {
                    mu_dr = false
                    emit mu_at(round(min(mu_px, mu_qx)) * 4096 + round(min(mu_py, mu_qy)))
                    emit mu_wh(round(abs(mu_qx - mu_px)) * 4096 + round(abs(mu_qy - mu_py)))
                }
                on press mu_z while mu_tool == 2 { emit mu_pick(round(pointer.x) * 4096 + round(pointer.y)) }
                on press mu_z while mu_tool == 3 { emit mu_edge(round(pointer.y)) }
                on drag mu_z while mu_tool == 3 { emit mu_edge(round(pointer.y)) }
            }
            // the Overview's close, over the canvas at its top right (undo is the widgets' own, in edit mode)
            box { from: op_x + op_w - sf_ovm - 92, op_y + sf_ovm + 108; size: 80, 26; corner: 6; color: rgb(0.08, 0.1, 0.11); opacity: 0.72; show: op_vis and op_mode == 4 }
            text "CLOSE" { at: op_x + op_w - sf_ovm - 52, op_y + sf_ovm + 108 + 13; anchor: center; align: center; size: 9; weight: 700; family: "Share Tech Mono"; color: rgb(0.62, 0.84, 0.74); show: op_vis and op_mode == 4 }
            zone box ov_close { from: op_x + op_w - sf_ovm - 92, op_y + sf_ovm + 108; size: 80, 26; cursor: pointer; role: button; label: "Close the Overview"; show: op_live and op_mode == 4 }
            on press ov_close { emit rv_esc }
            // a press on the thin wallpaper margin closes it too
            zone box ov_edge_t { from: op_x, op_y; size: op_w, max(1, sf_ovm); cursor: pointer; role: button; label: "Close the Overview"; show: op_live and op_mode == 4 and sf_ovm > 0.5 }
            on press ov_edge_t { emit rv_esc }
            zone box ov_edge_b { from: op_x, op_y + op_h - sf_ovm; size: op_w, max(1, sf_ovm); cursor: pointer; role: button; label: "Close the Overview"; show: op_live and op_mode == 4 and sf_ovm > 0.5 }
            on press ov_edge_b { emit rv_esc }
            zone box ov_edge_l { from: op_x, op_y + sf_ovm; size: max(1, sf_ovm), max(0, op_h - 2 * sf_ovm); cursor: pointer; role: button; label: "Close the Overview"; show: op_live and op_mode == 4 and sf_ovm > 0.5 }
            on press ov_edge_l { emit rv_esc }
            zone box ov_edge_r { from: op_x + op_w - sf_ovm, op_y + sf_ovm; size: max(1, sf_ovm), max(0, op_h - 2 * sf_ovm); cursor: pointer; role: button; label: "Close the Overview"; show: op_live and op_mode == 4 and sf_ovm > 0.5 }
            on press ov_edge_r { emit rv_esc }
            // the Overview's thin lit margin: the wallpaper's edge, pulled back
            box { from: op_x + sf_ovm, op_y + sf_ovm; size: max(0, op_w - 2 * sf_ovm), max(0, op_h - 2 * sf_ovm); stroke: 1; color: rgb(0.62, 0.84, 0.74); opacity: 0.32; show: op_vis and op_mode == 4 and sf_ovm > 0.5 }
        }
    }

    surface edge {
        size: full, full
        anchor: top
        level: bottom
        reserve: -1
        keyboard: exclusive while op_vis and sf_firm
        rate: 60
        open: op_vis
        // the opening's repaint (D214): a moving clip leaves what it uncovered behind unless the whole
        // surface is repainted; this veil changes with the hole, and is gone when the opening is
        box { from: 0, 0; size: 8192, 8192; color: #000000; opacity: 0.004 + 0.001 * fract((op_x + op_y + op_w + op_h) / 97); show: op_k > 0.001 }
        // where the pointer is, told to the logic as it moves (every 6 px), while revealing
        let rv_q = round(cursor.x / 6) * 100000 + round(cursor.y / 6)
        on change rv_q while rv_on or op_vis { emit rv_move(round(cursor.x) * 10000 + round(cursor.y)) }
        // the keyboard, once the opening is firm: walk the places, press, widen, heal
        on key Escape { emit rv_esc }
        on key Tab { emit op_key(1) }
        on key Shift+Tab { emit op_key(-1) }
        on key Return { emit op_key(2) }
        on key Page_Up { emit op_wheel(1) }
        on key Page_Down { emit op_wheel(-1) }
        // typing into Launch's grid while the Overview is open: letters, a space, a rub-out
        on key a while op_mode == 4 { emit op_type(97) }
        on key b while op_mode == 4 { emit op_type(98) }
        on key c while op_mode == 4 { emit op_type(99) }
        on key d while op_mode == 4 { emit op_type(100) }
        on key e while op_mode == 4 { emit op_type(101) }
        on key f while op_mode == 4 { emit op_type(102) }
        on key g while op_mode == 4 { emit op_type(103) }
        on key h while op_mode == 4 { emit op_type(104) }
        on key i while op_mode == 4 { emit op_type(105) }
        on key j while op_mode == 4 { emit op_type(106) }
        on key k while op_mode == 4 { emit op_type(107) }
        on key l while op_mode == 4 { emit op_type(108) }
        on key m while op_mode == 4 { emit op_type(109) }
        on key n while op_mode == 4 { emit op_type(110) }
        on key o while op_mode == 4 { emit op_type(111) }
        on key p while op_mode == 4 { emit op_type(112) }
        on key q while op_mode == 4 { emit op_type(113) }
        on key r while op_mode == 4 { emit op_type(114) }
        on key s while op_mode == 4 { emit op_type(115) }
        on key t while op_mode == 4 { emit op_type(116) }
        on key u while op_mode == 4 { emit op_type(117) }
        on key v while op_mode == 4 { emit op_type(118) }
        on key w while op_mode == 4 { emit op_type(119) }
        on key x while op_mode == 4 { emit op_type(120) }
        on key y while op_mode == 4 { emit op_type(121) }
        on key z while op_mode == 4 { emit op_type(122) }
        on key Left while op_mode == 4 { emit op_wkey(1) }
        on key Right while op_mode == 4 { emit op_wkey(2) }
        on key Up while op_mode == 4 { emit op_wkey(3) }
        on key Down while op_mode == 4 { emit op_wkey(4) }
        on key Shift+Left while op_mode == 4 { emit op_wkey(5) }
        on key Shift+Right while op_mode == 4 { emit op_wkey(6) }
        on key Shift+Up while op_mode == 4 { emit op_wkey(7) }
        on key Shift+Down while op_mode == 4 { emit op_wkey(8) }
        on key Delete while op_mode == 4 { emit op_wkey(9) }
        on key Ctrl+d while op_mode == 4 { emit op_wkey(10) }
        on key Ctrl+z while op_mode == 4 { emit op_wkey(11) }
        on key Ctrl+Shift+z while op_mode == 4 { emit op_wkey(12) }
        on key Ctrl+a while op_mode == 4 { emit op_wkey(13) }
        on key space while op_mode == 4 { emit op_type(32) }
        on key BackSpace while op_mode == 4 { emit op_type(8) }
        // the eight looks: the real wallpaper, cut open over the hole (the surface's own size: screen.height
        // is the scene's first surface's, the 40 px bar strip — found live, D208)
        // a group's shader sees its own box: the clip's, from its top left corner — each derives the screen
        // origin from op_x/op_y in its own file, so all eight values are free for shape and strength
        // (the intensity, edge and colour arrive packed in sf_param: see the shaders)
        // the lip: a thin lit line round the hole, with a soft glow (every effect has it)
        group { glow: 18, 0.9 * op_k, rgb(0.62, 0.84, 0.74); show: op_vis and op_mode < 4
            box { from: op_x, op_y; size: op_w, op_h; corner: op_r; stroke: 2; color: rgb(0.62, 0.84, 0.74); opacity: 0.9 * op_k } }
        group {
            show: sf_fx > 0.5 and sf_fx < 1.5
            clip box { from: op_x - 40, op_y - 40; size: op_w + 80, op_h + 80; corner: op_r + 40 }
            shader: tear, op_k, op_x, op_y, op_w, op_h, op_r, sf_param, 0
            image rv_img { at: 0, 0; size: edge.width, edge.height; fit: cover }
        }
        group {
            show: sf_fx > 1.5 and sf_fx < 2.5
            clip box { from: op_x - 40, op_y - 40; size: op_w + 80, op_h + 80; corner: op_r + 40 }
            shader: aperture, op_k, op_x, op_y, op_w, op_h, op_r, sf_param, 0
            image rv_img { at: 0, 0; size: edge.width, edge.height; fit: cover }
        }
        group {
            show: sf_fx > 2.5 and sf_fx < 3.5
            clip box { from: op_x - 40, op_y - 40; size: op_w + 80, op_h + 80; corner: op_r + 40 }
            shader: membrane, op_k, op_x, op_y, op_w, op_h, op_r, sf_param, 0
            image rv_img { at: 0, 0; size: edge.width, edge.height; fit: cover }
        }
        group {
            show: sf_fx > 3.5 and sf_fx < 4.5
            clip box { from: op_x - 40, op_y - 40; size: op_w + 80, op_h + 80; corner: op_r + 40 }
            shader: ripple, op_k, op_x, op_y, op_w, op_h, op_r, sf_param, 0
            image rv_img { at: 0, 0; size: edge.width, edge.height; fit: cover }
        }
        group {
            show: sf_fx > 4.5 and sf_fx < 5.5
            clip box { from: op_x - 40, op_y - 40; size: op_w + 80, op_h + 80; corner: op_r + 40 }
            shader: fold, op_k, op_x, op_y, op_w, op_h, op_r, sf_param, 0
            image rv_img { at: 0, 0; size: edge.width, edge.height; fit: cover }
        }
        group {
            show: sf_fx > 5.5 and sf_fx < 6.5
            clip box { from: op_x - 40, op_y - 40; size: op_w + 80, op_h + 80; corner: op_r + 40 }
            shader: dissolve, op_k, op_x, op_y, op_w, op_h, op_r, sf_param, 0
            image rv_img { at: 0, 0; size: edge.width, edge.height; fit: cover }
        }
        group {
            show: sf_fx > 6.5 and sf_fx < 7.5
            clip box { from: op_x - 40, op_y - 40; size: op_w + 80, op_h + 80; corner: op_r + 40 }
            shader: glass, op_k, op_x, op_y, op_w, op_h, op_r, sf_param, 0
            image rv_img { at: 0, 0; size: edge.width, edge.height; fit: cover }
        }
        group {
            show: sf_fx > 7.5 and sf_fx < 8.5
            clip box { from: op_x - 40, op_y - 40; size: op_w + 80, op_h + 80; corner: op_r + 40 }
            shader: glow, op_k, op_x, op_y, op_w, op_h, op_r, sf_param, 0
            image rv_img { at: 0, 0; size: edge.width, edge.height; fit: cover }
        }
    }

    // ── push up from below (D217): what lives below reaches up through the picture ──
    fact sk_on = false     // the rest: anything glowing, moving or sweeping
    fact sk_g = 1          // the glow: 0 off · 1 subtle · 2 bright
    fact sk_mx = -9999
    fact sk_my = -9999
    fact sk_mp = false   // Now Playing, playing
    fact sk_nx = -9999
    fact sk_ny = -9999
    fact sk_nn = false   // Notices, holding news
    // Live wallpaper (D219): each effect's patch (or the screen), its widget's box, its packed numbers
    fact lw_on = false
    fact lw_whole = false
    fact lw_speed = 100
    fact lw_boost = 0
    // ── Music in the picture (D223): the bands, the places it grows from, the Overview's Music mode ──
    fact lw_music = false
    fact lw_music_p = 0
    spring sg.mb = 520, 34
    fact mb_t0 = 0
    prop mb0 = 0 ~sg.mb
    follow mb0 = mb_t0
    fact mb_t1 = 0
    prop mb1 = 0 ~sg.mb
    follow mb1 = mb_t1
    fact mb_t2 = 0
    prop mb2 = 0 ~sg.mb
    follow mb2 = mb_t2
    fact mb_t3 = 0
    prop mb3 = 0 ~sg.mb
    follow mb3 = mb_t3
    fact mb_t4 = 0
    prop mb4 = 0 ~sg.mb
    follow mb4 = mb_t4
    fact mb_t5 = 0
    prop mb5 = 0 ~sg.mb
    follow mb5 = mb_t5
    fact mb_t6 = 0
    prop mb6 = 0 ~sg.mb
    follow mb6 = mb_t6
    fact mb_t7 = 0
    prop mb7 = 0 ~sg.mb
    follow mb7 = mb_t7
    fact mb_t8 = 0
    prop mb8 = 0 ~sg.mb
    follow mb8 = mb_t8
    fact mb_t9 = 0
    prop mb9 = 0 ~sg.mb
    follow mb9 = mb_t9
    fact mb_t10 = 0
    prop mb10 = 0 ~sg.mb
    follow mb10 = mb_t10
    fact mb_t11 = 0
    prop mb11 = 0 ~sg.mb
    follow mb11 = mb_t11
    fact mb_t12 = 0
    prop mb12 = 0 ~sg.mb
    follow mb12 = mb_t12
    fact mb_t13 = 0
    prop mb13 = 0 ~sg.mb
    follow mb13 = mb_t13
    fact mb_t14 = 0
    prop mb14 = 0 ~sg.mb
    follow mb14 = mb_t14
    fact mb_t15 = 0
    prop mb15 = 0 ~sg.mb
    follow mb15 = mb_t15
    let mb_v0 = round(mb0 * 255) * 65536 + round(mb1 * 255) * 256 + round(mb2 * 255)
    let mb_v1 = round(mb3 * 255) * 65536 + round(mb4 * 255) * 256 + round(mb5 * 255)
    let mb_v2 = round(mb6 * 255) * 65536 + round(mb7 * 255) * 256 + round(mb8 * 255)
    let mb_v3 = round(mb9 * 255) * 65536 + round(mb10 * 255) * 256 + round(mb11 * 255)
    let mb_v4 = round(mb12 * 255) * 65536 + round(mb13 * 255) * 256 + round(mb14 * 255)
    let mb_v5 = round(mb15 * 255) * 65536 + 0 + 0
    fact mu_e = false
    fact mu_ex = 0
    fact mu_ey = 0
    fact mu_ew = 1
    fact mu_eh = 1
    fact mu_a1 = false
    fact mu_a1x = 0
    fact mu_a1y = 0
    fact mu_a1w = 1
    fact mu_a1h = 1
    fact mu_a2 = false
    fact mu_a2x = 0
    fact mu_a2y = 0
    fact mu_a2w = 1
    fact mu_a2h = 1
    fact mu_a3 = false
    fact mu_a3x = 0
    fact mu_a3y = 0
    fact mu_a3w = 1
    fact mu_a3h = 1
    fact mu_a4 = false
    fact mu_a4x = 0
    fact mu_a4y = 0
    fact mu_a4w = 1
    fact mu_a4h = 1
    fact mu_c1 = false
    fact mu_c1v = 0
    fact mu_c1r = 0
    fact mu_c1g = 0
    fact mu_c1b = 0
    fact mu_c2 = false
    fact mu_c2v = 0
    fact mu_c2r = 0
    fact mu_c2g = 0
    fact mu_c2b = 0
    fact mu_s = false
    text mu_cutp = ""
    image mu_cut = from mu_cutp, 0, 0
    fact sf_mu = false     // the Overview's Music mode
    fact mu_tool = 0       // 1 draw an area · 2 pick a colour · 3 drag the edge line
    fact mu_px = 0
    fact mu_py = 0
    fact mu_qx = 0
    fact mu_qy = 0
    fact mu_dr = false
    event mu_mode ->      // the Overview's Music mode: 1 in · 0 out
    event mu_at ->        // an area drawn: its corner, x * 4096 + y
    event mu_wh ->        // ... and its size, w * 4096 + h
    event mu_pick ->      // a colour picked at x * 4096 + y
    event mu_edge ->      // the edge line moved to this y
    event mu_tog ->       // 1 the edge on/off · 2 the subject on/off
    event mu_clear ->     // every area and colour let go
    // ── phase 4 (D224): peering and burying ──
    fact pr_on = false     // a peek: Super held over a window with another behind it
    fact pr_x = 0
    fact pr_y = 0
    fact pr_r = 110
    fact pr_bx = 0
    fact pr_by = 0
    fact pr_bw = 1
    fact pr_bh = 1
    text pr_pic = ""
    image pr_img = from pr_pic, 0, 0
    prop pr_rs = 0 ~sg.op
    follow pr_rs = if(pr_on, pr_r, 0)
    event bury ->         // Super+Alt+B: the focused window under the wallpaper
    event bt_go ->        // a buried window's tile pressed: it comes back
    fact bt1 = false
    fact bt1x = 0
    fact bt1y = 0
    fact bt1w = 240
    fact bt1h = 150
    text bt1_pic = ""
    image bt1_img = from bt1_pic, 0, 0
    text bt1_name = ""
    fact bt2 = false
    fact bt2x = 0
    fact bt2y = 0
    fact bt2w = 240
    fact bt2h = 150
    text bt2_pic = ""
    image bt2_img = from bt2_pic, 0, 0
    text bt2_name = ""
    fact bt3 = false
    fact bt3x = 0
    fact bt3y = 0
    fact bt3w = 240
    fact bt3h = 150
    text bt3_pic = ""
    image bt3_img = from bt3_pic, 0, 0
    text bt3_name = ""
    fact bt4 = false
    fact bt4x = 0
    fact bt4y = 0
    fact bt4w = 240
    fact bt4h = 150
    text bt4_pic = ""
    image bt4_img = from bt4_pic, 0, 0
    text bt4_name = ""
    fact bt5 = false
    fact bt5x = 0
    fact bt5y = 0
    fact bt5w = 240
    fact bt5h = 150
    text bt5_pic = ""
    image bt5_img = from bt5_pic, 0, 0
    text bt5_name = ""
    fact bt6 = false
    fact bt6x = 0
    fact bt6y = 0
    fact bt6w = 240
    fact bt6h = 150
    text bt6_pic = ""
    image bt6_img = from bt6_pic, 0, 0
    text bt6_name = ""
    fact bt7 = false
    fact bt7x = 0
    fact bt7y = 0
    fact bt7w = 240
    fact bt7h = 150
    text bt7_pic = ""
    image bt7_img = from bt7_pic, 0, 0
    text bt7_name = ""
    fact bt8 = false
    fact bt8x = 0
    fact bt8y = 0
    fact bt8w = 240
    fact bt8h = 150
    text bt8_pic = ""
    image bt8_img = from bt8_pic, 0, 0
    text bt8_name = ""
    fact lw_ripple = false
    fact lw_ripple_x = -9999
    fact lw_ripple_y = -9999
    fact lw_ripple_w = 1
    fact lw_ripple_h = 1
    fact lw_ripple_bx = -9999
    fact lw_ripple_by = -9999
    fact lw_ripple_bw = 1
    fact lw_ripple_bh = 1
    fact lw_ripple_p = 0
    fact lw_ripple_s = 0
    fact lw_breathe = false
    fact lw_breathe_x = -9999
    fact lw_breathe_y = -9999
    fact lw_breathe_w = 1
    fact lw_breathe_h = 1
    fact lw_breathe_bx = -9999
    fact lw_breathe_by = -9999
    fact lw_breathe_bw = 1
    fact lw_breathe_bh = 1
    fact lw_breathe_p = 0
    fact lw_breathe_s = 0
    fact lw_flow = false
    fact lw_flow_x = -9999
    fact lw_flow_y = -9999
    fact lw_flow_w = 1
    fact lw_flow_h = 1
    fact lw_flow_bx = -9999
    fact lw_flow_by = -9999
    fact lw_flow_bw = 1
    fact lw_flow_bh = 1
    fact lw_flow_p = 0
    fact lw_flow_s = 0
    fact lw_sweep = false
    fact lw_sweep_x = -9999
    fact lw_sweep_y = -9999
    fact lw_sweep_w = 1
    fact lw_sweep_h = 1
    fact lw_sweep_bx = -9999
    fact lw_sweep_by = -9999
    fact lw_sweep_bw = 1
    fact lw_sweep_bh = 1
    fact lw_sweep_p = 0
    fact lw_sweep_s = 0
    fact sk_swt = 0      // the hour's sweep: where its band is going (0 … 1)
    fact sk_swv = 0      // ... and how seen it is
    spring sg.slow = 14, 7.5
    prop sk_swp = 0 ~sg.slow
    follow sk_swp = sk_swt
    prop sk_swa = 0 ~sg.op
    follow sk_swa = sk_swv
    fact pu_on = false     // the push: a bulge and its words
    fact pu_x = 0
    fact pu_y = 0
    fact pu_w = 1
    fact pu_h = 1
    fact pu_bt = 0
    fact pu_wt = 0
    fact pu_plate = false   // high contrast: a plate under the words
    text pu_words = ""
    spring sg.bulge = 180, 16
    prop pu_b = 0 ~sg.bulge
    follow pu_b = pu_bt
    prop pu_wd = 0 ~sg.op
    follow pu_wd = pu_wt
    fact lt_on = false     // the light: a notice's spark, its line, the window's border
    fact lt_sx = 0
    fact lt_sy = 0
    fact lt_tx = 0
    fact lt_ty = 0
    fact lt_rx = 0
    fact lt_ry = 0
    fact lt_rw = 1
    fact lt_rh = 1
    fact lt_win = false   // a window to travel to
    fact lt_so = 0        // the side the line meets: 0 top · 1 right · 2 bottom · 3 left (the trace starts there)
    fact lt_n = 1         // a burst: how many
    fact lt_st = 0
    fact lt_tt = 0
    fact lt_bt = 0
    fact lt_kt = 0
    event lt_go ->        // the spark pressed
    event nd_fx ->        // D226: the node (the Pill) had news — the wallpaper ripples under it (its centre x)
    fact nf_on = false
    fact nf_x = 960
    fact nf_t = 0
    prop nf_k = 0 ~sg.bulge
    follow nf_k = nf_t
    spring sg.lt = 70, 16
    spring sg.ltb = 26, 10
    prop lt_s = 0 ~sg.op
    follow lt_s = lt_st
    prop lt_t = 0 ~sg.lt
    follow lt_t = lt_tt
    prop lt_b = 0 ~sg.ltb
    follow lt_b = lt_bt
    prop lt_k = 0 ~sg.op
    follow lt_k = lt_kt

    surface skin {
        size: full, full
        anchor: top
        level: bottom
        reserve: -1
        keyboard: none
        rate: 30, 20 while calm
        open: not op_vis and (lw_on or nf_on or (sf_on and (sk_on or pu_on)))
        // the glow through: a soft breath at Now Playing while it plays, at Notices while it holds news
        shader aura { at: sk_mx - 220, sk_my - 220; size: 440, 440; values: 1, sk_mx - 220, sk_my - 220, sk_mx, sk_my, -9999, -9999, sk_g * (0.75 + 0.5 * lv.level); colors: rgb(0.62, 0.84, 0.74), rgb(0.95, 0.62, 0.38); show: sk_mp }
        shader aura { at: sk_nx - 220, sk_ny - 220; size: 440, 440; values: 1, sk_nx - 220, sk_ny - 220, -9999, -9999, sk_nx, sk_ny, sk_g; colors: rgb(0.62, 0.84, 0.74), rgb(0.95, 0.62, 0.38); show: sk_nn }
        // Live wallpaper (D219): one pass per effect over its patch (or the screen) — ripple, breathe, flow, sweep;
        // the first number carries the speed (whole) and the music's level (or the sweep's place)
        group {
            show: lw_ripple
            clip box { from: lw_ripple_x, lw_ripple_y; size: lw_ripple_w, lw_ripple_h; corner: if(lw_whole, 0, 48) }
            shader: skin, lw_speed + min(0.999, max(lv.level, lw_boost)), lw_ripple_x, lw_ripple_y, lw_ripple_bx, lw_ripple_by, lw_ripple_bw, lw_ripple_bh, lw_ripple_p
            image rv_img { at: 0, 0; size: skin.width, skin.height; fit: cover }
        }
        group {
            show: lw_breathe
            clip box { from: lw_breathe_x, lw_breathe_y; size: lw_breathe_w, lw_breathe_h; corner: if(lw_whole, 0, 48) }
            shader: skin, lw_speed + min(0.999, max(lv.level, lw_boost)), lw_breathe_x, lw_breathe_y, lw_breathe_bx, lw_breathe_by, lw_breathe_bw, lw_breathe_bh, lw_breathe_p
            image rv_img { at: 0, 0; size: skin.width, skin.height; fit: cover }
        }
        group {
            show: lw_flow
            clip box { from: lw_flow_x, lw_flow_y; size: lw_flow_w, lw_flow_h; corner: if(lw_whole, 0, 48) }
            shader: skin, lw_speed + min(0.999, max(lv.level, lw_boost)), lw_flow_x, lw_flow_y, lw_flow_bx, lw_flow_by, lw_flow_bw, lw_flow_bh, lw_flow_p
            image rv_img { at: 0, 0; size: skin.width, skin.height; fit: cover }
        }
        group {
            show: lw_sweep
            clip box { from: lw_sweep_x, lw_sweep_y; size: lw_sweep_w, lw_sweep_h; corner: if(lw_whole, 0, 48) }
            shader: skin, lw_speed + min(0.999, sk_swp), lw_sweep_x, lw_sweep_y, lw_sweep_bx, lw_sweep_by, lw_sweep_bw, lw_sweep_bh, lw_sweep_p - lw_sweep_s * 10000 + round(lw_sweep_s * sk_swa) * 10000
            image rv_img { at: 0, 0; size: skin.width, skin.height; fit: cover }
        }
        // Music in the picture (D223): strips of the picture pulled up out of it by the music
        group {
            show: lw_music and mu_e
            clip box { from: mu_ex, mu_ey; size: mu_ew, mu_eh }
            shader: music, mb_v0, mb_v1, mb_v2, mb_v3, mb_v4, mb_v5, lw_music_p, 0
            image rv_img { at: 0, 0; size: skin.width, skin.height; fit: cover }
        }
        group {
            show: lw_music and mu_a1
            clip box { from: mu_a1x, mu_a1y; size: mu_a1w, mu_a1h }
            shader: music, mb_v0, mb_v1, mb_v2, mb_v3, mb_v4, mb_v5, lw_music_p, 0
            image rv_img { at: 0, 0; size: skin.width, skin.height; fit: cover }
        }
        group {
            show: lw_music and mu_a2
            clip box { from: mu_a2x, mu_a2y; size: mu_a2w, mu_a2h }
            shader: music, mb_v0, mb_v1, mb_v2, mb_v3, mb_v4, mb_v5, lw_music_p, 0
            image rv_img { at: 0, 0; size: skin.width, skin.height; fit: cover }
        }
        group {
            show: lw_music and mu_a3
            clip box { from: mu_a3x, mu_a3y; size: mu_a3w, mu_a3h }
            shader: music, mb_v0, mb_v1, mb_v2, mb_v3, mb_v4, mb_v5, lw_music_p, 0
            image rv_img { at: 0, 0; size: skin.width, skin.height; fit: cover }
        }
        group {
            show: lw_music and mu_a4
            clip box { from: mu_a4x, mu_a4y; size: mu_a4w, mu_a4h }
            shader: music, mb_v0, mb_v1, mb_v2, mb_v3, mb_v4, mb_v5, lw_music_p, 0
            image rv_img { at: 0, 0; size: skin.width, skin.height; fit: cover }
        }
        group {
            show: lw_music and mu_c1
            clip box { from: 0, 0; size: skin.width, skin.height }
            shader: music, mb_v0, mb_v1, mb_v2, mb_v3, mb_v4, mb_v5, lw_music_p + 1000000, mu_c1v
            image rv_img { at: 0, 0; size: skin.width, skin.height; fit: cover }
        }
        group {
            show: lw_music and mu_c2
            clip box { from: 0, 0; size: skin.width, skin.height }
            shader: music, mb_v0, mb_v1, mb_v2, mb_v3, mb_v4, mb_v5, lw_music_p + 1000000, mu_c2v
            image rv_img { at: 0, 0; size: skin.width, skin.height; fit: cover }
        }
        group {
            show: lw_music and mu_s
            clip box { from: 0, 0; size: skin.width, skin.height }
            shader: music, mb_v0, mb_v1, mb_v2, mb_v3, mb_v4, mb_v5, lw_music_p + 2000000, 0
            image mu_cut { at: 0, 0; size: skin.width, skin.height; fit: cover }
        }
        // D226: news at the node — a ripple on the wallpaper under it
        group {
            show: nf_on and nf_k > 0.01
            clip box { from: nf_x - 200, 0; size: 400, 150; corner: 60 }
            shader: skin, 140 + min(0.999, nf_k), nf_x - 200, 0, nf_x - 40, 0, 80, 22, 1608040
            image rv_img { at: 0, 0; size: skin.width, skin.height; fit: cover }
        }
        // news: the picture bulges over the widget's place ...
        group {
            show: pu_on and pu_b > 0.005
            clip box { from: pu_x - 48, pu_y - 48; size: pu_w + 96, pu_h + 96; corner: 48 }
            shader: bulge, pu_b, pu_x - 48, pu_y - 48, pu_x, pu_y, pu_w, pu_h, 1
            image rv_img { at: 0, 0; size: skin.width, skin.height; fit: cover }
        }
        // ... and its words press up through it, then settle back
        group {
            show: pu_on and pu_wd > 0.01
            opacity: pu_wd
            box { from: pu_x + pu_w / 2 - min(pu_w, 420) / 2, pu_y + pu_h / 2 - 18; size: min(pu_w, 420), 36; corner: 8; color: rgb(0.05, 0.06, 0.06); opacity: 0.86; show: pu_plate }
            group { glow: 16, 0.7, #000000
                text pu_words { at: pu_x + pu_w / 2, pu_y + pu_h / 2 + 8 * (1 - pu_wd); anchor: center; align: center; size: 16; weight: 600; family: "Exo 2"; color: rgb(0.95, 0.96, 0.95); width: min(pu_w, 420) - 16; lines: 1 } }
        }
    }

    surface light {
        size: full, full
        anchor: top
        level: overlay
        reserve: -1
        keyboard: none
        rate: 60, 20 while calm
        open: lt_on
        // the line: a short comet from the spark to where it meets the window
        let lt_a = max(0, lt_t - 0.3)
        group { glow: 10, 0.9, rgb(0.95, 0.62, 0.38); opacity: lt_k; show: lt_win and lt_t > 0.01
            line { from: lt_sx + (lt_tx - lt_sx) * lt_a, lt_sy + (lt_ty - lt_sy) * lt_a; to: lt_sx + (lt_tx - lt_sx) * lt_t, lt_sy + (lt_ty - lt_sy) * lt_t; width: 2; color: rgb(0.95, 0.62, 0.38) } }
        // once round the window's border, from the side the line met
        let lt_p0 = clamp(lt_b * 4 - mod(0 - lt_so + 4, 4), 0, 1)
        let lt_p1 = clamp(lt_b * 4 - mod(1 - lt_so + 4, 4), 0, 1)
        let lt_p2 = clamp(lt_b * 4 - mod(2 - lt_so + 4, 4), 0, 1)
        let lt_p3 = clamp(lt_b * 4 - mod(3 - lt_so + 4, 4), 0, 1)
        group { glow: 12, 0.8, rgb(0.95, 0.62, 0.38); opacity: lt_k; show: lt_win and lt_b > 0.001
            line { from: lt_rx, lt_ry; to: lt_rx + lt_rw * lt_p0, lt_ry; width: 2; color: rgb(0.95, 0.62, 0.38); show: lt_p0 > 0.001 }
            line { from: lt_rx + lt_rw, lt_ry; to: lt_rx + lt_rw, lt_ry + lt_rh * lt_p1; width: 2; color: rgb(0.95, 0.62, 0.38); show: lt_p1 > 0.001 }
            line { from: lt_rx + lt_rw, lt_ry + lt_rh; to: lt_rx + lt_rw - lt_rw * lt_p2, lt_ry + lt_rh; width: 2; color: rgb(0.95, 0.62, 0.38); show: lt_p2 > 0.001 }
            line { from: lt_rx, lt_ry + lt_rh; to: lt_rx, lt_ry + lt_rh - lt_rh * lt_p3; width: 2; color: rgb(0.95, 0.62, 0.38); show: lt_p3 > 0.001 }
        }
        // the spark, and how many came at once
        group { glow: 14, 0.9 * lt_s, rgb(0.95, 0.62, 0.38)
            ellipse { at: lt_sx, lt_sy; radius: 3 + 3 * lt_s; color: rgb(0.95, 0.62, 0.38); opacity: lt_s } }
        text "{lt_n}" { at: lt_sx + 12, lt_sy - 10; anchor: left center; size: 10; weight: 700; family: "Share Tech Mono"; color: rgb(0.95, 0.62, 0.38); opacity: lt_s; show: lt_n > 1.5 }
        zone box lt_z { from: lt_sx - 14, lt_sy - 14; size: 28, 28; cursor: pointer; role: button; label: "Open the notices"; show: lt_s > 0.2 }
        on press lt_z { emit lt_go }
    }

    surface peer {
        size: full, full
        anchor: top
        level: overlay
        reserve: -1
        keyboard: none
        rate: 60, 20 while calm
        open: pr_on or pr_rs > 1
        group {
            clip box { from: pr_x - pr_rs, pr_y - pr_rs; size: pr_rs * 2, pr_rs * 2; corner: pr_rs }
            box { from: pr_x - pr_rs, pr_y - pr_rs; size: pr_rs * 2, pr_rs * 2; color: rgb(0.03, 0.04, 0.035) }
            image pr_img { at: pr_bx, pr_by; size: pr_bw, pr_bh }
        }
        group { glow: 18, 0.9, rgb(0.62, 0.84, 0.74)
            ellipse { at: pr_x, pr_y; radius: max(1, pr_rs); stroke: 2; color: rgb(0.62, 0.84, 0.74); opacity: 0.9 } }
    }
}
