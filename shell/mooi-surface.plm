            }
            // the cover as halftone: the disc's inside (kind 3), a pattern turning slowly, tinted
            group {
                show: h0_kind == 3
                let dr = min(d_h * 0.42, d_w * 0.2) - 3
                let dcx = d_x + dr + 5
                let dcy = d_y + d_h / 2
                ellipse { at: dcx + 0 * dr / 10, dcy + -10 * dr / 10; radius: max(0.3, dr / 10 * 0.48 * (0.5 + 0.5 * sin(-110 + ph * 0.15) * cos(-290 - ph * 0.1))); color: mix(rgb(h0_r, h0_g, h0_b), #ffffff, 0.25 * (0.5 + 0.5 * sin(-110 + ph * 0.15) * cos(-290 - ph * 0.1))); opacity: 0.9 }
                ellipse { at: dcx + -4 * dr / 10, dcy + -9 * dr / 10; radius: max(0.3, dr / 10 * 0.48 * (0.5 + 0.5 * sin(-247 + ph * 0.15) * cos(-233 - ph * 0.1))); color: mix(rgb(h0_r, h0_g, h0_b), #ffffff, 0.25 * (0.5 + 0.5 * sin(-247 + ph * 0.15) * cos(-233 - ph * 0.1))); opacity: 0.9 }
                ellipse { at: dcx + -3 * dr / 10, dcy + -9 * dr / 10; radius: max(0.3, dr / 10 * 0.48 * (0.5 + 0.5 * sin(-210 + ph * 0.15) * cos(-240 - ph * 0.1))); color: mix(rgb(h0_r, h0_g, h0_b), #ffffff, 0.25 * (0.5 + 0.5 * sin(-210 + ph * 0.15) * cos(-240 - ph * 0.1))); opacity: 0.9 }
                ellipse { at: dcx + -2 * dr / 10, dcy + -9 * dr / 10; radius: max(0.3, dr / 10 * 0.48 * (0.5 + 0.5 * sin(-173 + ph * 0.15) * cos(-247 - ph * 0.1))); color: mix(rgb(h0_r, h0_g, h0_b), #ffffff, 0.25 * (0.5 + 0.5 * sin(-173 + ph * 0.15) * cos(-247 - ph * 0.1))); opacity: 0.9 }
