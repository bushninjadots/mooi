    let h3_X59 = h3_wx59 + (h3_wx59 - cursor.x) * h3_p59
    let h3_Y59 = h3_wy59 + (h3_wy59 - cursor.y) * h3_p59
    let h3_wx60 = h3_x60
    let h3_wy60 = h3_y60 + sin(ph + 1380) * (wob + breath * 0.5 * (1 + sin(ph * 0.3))) * 0.4 + sin(ph * 2 + 2400) * lv.level * 7 * h3_rip
    let h3_d60 = sqrt(pow(h3_wx60 - cursor.x, 2) + pow(h3_wy60 - cursor.y, 2) + 1)
    let h3_p60 = push * max(0, 40 - h3_d60) / 40 * 6 / h3_d60
    let h3_X60 = h3_wx60 + (h3_wx60 - cursor.x) * h3_p60
    let h3_Y60 = h3_wy60 + (h3_wy60 - cursor.y) * h3_p60
    let h3_wx61 = h3_x61
    let h3_wy61 = h3_y61 + sin(ph + 1403) * (wob + breath * 0.5 * (1 + sin(ph * 0.3))) * 0.4 + sin(ph * 2 + 2440) * lv.level * 7 * h3_rip
    let h3_d61 = sqrt(pow(h3_wx61 - cursor.x, 2) + pow(h3_wy61 - cursor.y, 2) + 1)
    let h3_p61 = push * max(0, 40 - h3_d61) / 40 * 6 / h3_d61
    let h3_X61 = h3_wx61 + (h3_wx61 - cursor.x) * h3_p61
    let h3_Y61 = h3_wy61 + (h3_wy61 - cursor.y) * h3_p61
    let h3_wx62 = h3_x62
    let h3_wy62 = h3_y62 + sin(ph + 1426) * (wob + breath * 0.5 * (1 + sin(ph * 0.3))) * 0.4 + sin(ph * 2 + 2480) * lv.level * 7 * h3_rip
    let h3_d62 = sqrt(pow(h3_wx62 - cursor.x, 2) + pow(h3_wy62 - cursor.y, 2) + 1)
    let h3_p62 = push * max(0, 40 - h3_d62) / 40 * 6 / h3_d62
    let h3_X62 = h3_wx62 + (h3_wx62 - cursor.x) * h3_p62
    let h3_Y62 = h3_wy62 + (h3_wy62 - cursor.y) * h3_p62
    let h3_wx63 = h3_x63
    let h3_wy63 = h3_y63 + sin(ph + 1449) * (wob + breath * 0.5 * (1 + sin(ph * 0.3))) * 0.4 + sin(ph * 2 + 2520) * lv.level * 7 * h3_rip
    let h3_d63 = sqrt(pow(h3_wx63 - cursor.x, 2) + pow(h3_wy63 - cursor.y, 2) + 1)
    let h3_p63 = push * max(0, 40 - h3_d63) / 40 * 6 / h3_d63
    let h3_X63 = h3_wx63 + (h3_wx63 - cursor.x) * h3_p63
    let h3_Y63 = h3_wy63 + (h3_wy63 - cursor.y) * h3_p63

    let op_px = cursor.x      // the pointer for the opening's follow mode (outside the generated block)
    let op_py = cursor.y
    // <gen:opening>
    // The opening (D209): mooi-surface packs the hole into three numbers (lib/surface/opening `pack`);
    // every program turns them into the same sprung rectangle. mode = c / 1000: closed 0 · follow 1 · snapped 2 ·
    // section 3 · full 4. Follow sends no a, b: the target is the square of side 2 * R on the pointer.
    // A fresh opening is faint (c carries 500) until it is firm or snapped: drawn weaker, and no zone answers.
    event op_a ->          // x * 4096 + y
    event op_b ->          // w * 4096 + h
    event op_c ->          // mode * 1000 + (500 while faint) + r
    event sf_set ->        // the Surface: bit 0 on, bit 1 BMO lives below
    event op_want ->       // to mooi-surface: what a program under the wallpaper asks for
    event op_key ->        // the keyboard: 1 next · -1 before · 2 press what is snapped
    event op_wheel ->      // the wheel while the opening shows: 1 widen · -1 narrow
    fact op_ta = 0
    fact op_tb = 0
    fact op_tc = 0
    fact sf_on = false     // Surface on
    fact sf_bmo = true     // BMO lives below
    on op_a(v) { op_ta = v }
    on op_b(v) { op_tb = v }
    on op_c(v) { op_tc = v }
    on sf_set(v) { sf_on = mod(v, 2) == 1; sf_bmo = floor(v / 2) == 1 }
    spring sg.op = 380, 34
    let op_mode = if(sf_on, floor(op_tc / 1000), 0)
    let op_r1 = op_tc - floor(op_tc / 1000) * 1000
    let op_faint = op_r1 > 499.5
    let op_r0 = op_r1 - if(op_faint, 500, 0)
    let op_ax = floor(op_ta / 4096)
    let op_aw = floor(op_tb / 4096)
    let op_tx = if(op_mode == 1, op_px - 90, op_ax)
    let op_ty = if(op_mode == 1, op_py - 90, op_ta - op_ax * 4096)
    let op_tw = if(op_mode == 1, 180, op_aw)
    let op_th = if(op_mode == 1, 180, op_tb - op_aw * 4096)
    let op_tr = if(op_mode == 1, 90, op_r0)
    prop op_x = 0 ~sg.op
    follow op_x = op_tx
    prop op_y = 0 ~sg.op
    follow op_y = op_ty
    prop op_w = 0 ~sg.op
    follow op_w = op_tw
    prop op_h = 0 ~sg.op
    follow op_h = op_th
    prop op_r = 0 ~sg.op
    follow op_r = op_tr
    prop op_k = 0 ~sg.op
    follow op_k = if(op_mode > 0, if(op_faint, 0.45, 1), 0)
    let op_vis = sf_on and op_k > 0.01
    let op_live = op_vis and not op_faint     // what is below answers a press only once the opening is firm
    // </gen:opening>

    // ── the subsurface (D209, D215): the opening's own facts; the things below are mooi-widgets' ──
    event op_type ->      // a letter typed in the Overview (its code; 8 rubs one out): sent on to Launch's grid
    event op_bx ->        // from BMO: where he stands, x * 4096 + y
    event op_bs ->        // ... and how big he is, w * 4096 + h
    event op_wbar ->      // from mooi-widgets: how far below the screen's top its surface starts
    event op_wkey ->      // an edit key in the Overview, sent on to mooi-widgets as its own (wg_key)
    event sb_drag ->      // from mooi-widgets: a widget is being dragged in the opening (-1)
    event sb_drop ->      // ... and let go
    fact sf_snap = 0      // what the opening hugs: BMO 20, a widget 30, none 0
    // light through the skin: the centres of the Now Playing and Notices widgets, on the screen (far off: none)
    fact au_mx = -9999
    fact au_my = -9999
    fact au_nx = -9999
    fact au_ny = -9999

    surface bar {
        size: full, 40
        anchor: top
        level: top
        reserve: -1
        keyboard: none
        rate: 60, 20 while calm
        open: h0_on or h1_on or h2_on or h3_on      // no host, no surface (review I1)
        group {
            show: h0_on and h0_drop < 0.5
            group {
                glow: 22, 0.5 * st_glow, rgb(h0_r, h0_g, h0_b)
                path { stroke: 8; color: rgb(h0_r, h0_g, h0_b); opacity: 0.1; move h0_X0, h0_Y0; line h0_X1, h0_Y1; line h0_X2, h0_Y2; line h0_X3, h0_Y3; line h0_X4, h0_Y4; line h0_X5, h0_Y5; line h0_X6, h0_Y6; line h0_X7, h0_Y7; line h0_X8, h0_Y8; line h0_X9, h0_Y9; line h0_X10, h0_Y10; line h0_X11, h0_Y11; line h0_X12, h0_Y12; line h0_X13, h0_Y13; line h0_X14, h0_Y14; line h0_X15, h0_Y15; line h0_X16, h0_Y16; line h0_X17, h0_Y17; line h0_X18, h0_Y18; line h0_X19, h0_Y19; line h0_X20, h0_Y20; line h0_X21, h0_Y21; line h0_X22, h0_Y22; line h0_X23, h0_Y23; line h0_X24, h0_Y24; line h0_X25, h0_Y25; line h0_X26, h0_Y26; line h0_X27, h0_Y27; line h0_X28, h0_Y28; line h0_X29, h0_Y29; line h0_X30, h0_Y30; line h0_X31, h0_Y31; line h0_X32, h0_Y32; line h0_X33, h0_Y33; line h0_X34, h0_Y34; line h0_X35, h0_Y35; line h0_X36, h0_Y36; line h0_X37, h0_Y37; line h0_X38, h0_Y38; line h0_X39, h0_Y39; line h0_X40, h0_Y40; line h0_X41, h0_Y41; line h0_X42, h0_Y42; line h0_X43, h0_Y43; line h0_X44, h0_Y44; line h0_X45, h0_Y45; line h0_X46, h0_Y46; line h0_X47, h0_Y47; line h0_X48, h0_Y48; line h0_X49, h0_Y49; line h0_X50, h0_Y50; line h0_X51, h0_Y51; line h0_X52, h0_Y52; line h0_X53, h0_Y53; line h0_X54, h0_Y54; line h0_X55, h0_Y55; line h0_X56, h0_Y56; line h0_X57, h0_Y57; line h0_X58, h0_Y58; line h0_X59, h0_Y59; line h0_X60, h0_Y60; line h0_X61, h0_Y61; line h0_X62, h0_Y62; line h0_X63, h0_Y63 }
                path { stroke: 3.2; color: rgb(h0_r, h0_g, h0_b); opacity: 0.3; move h0_X0, h0_Y0; line h0_X1, h0_Y1; line h0_X2, h0_Y2; line h0_X3, h0_Y3; line h0_X4, h0_Y4; line h0_X5, h0_Y5; line h0_X6, h0_Y6; line h0_X7, h0_Y7; line h0_X8, h0_Y8; line h0_X9, h0_Y9; line h0_X10, h0_Y10; line h0_X11, h0_Y11; line h0_X12, h0_Y12; line h0_X13, h0_Y13; line h0_X14, h0_Y14; line h0_X15, h0_Y15; line h0_X16, h0_Y16; line h0_X17, h0_Y17; line h0_X18, h0_Y18; line h0_X19, h0_Y19; line h0_X20, h0_Y20; line h0_X21, h0_Y21; line h0_X22, h0_Y22; line h0_X23, h0_Y23; line h0_X24, h0_Y24; line h0_X25, h0_Y25; line h0_X26, h0_Y26; line h0_X27, h0_Y27; line h0_X28, h0_Y28; line h0_X29, h0_Y29; line h0_X30, h0_Y30; line h0_X31, h0_Y31; line h0_X32, h0_Y32; line h0_X33, h0_Y33; line h0_X34, h0_Y34; line h0_X35, h0_Y35; line h0_X36, h0_Y36; line h0_X37, h0_Y37; line h0_X38, h0_Y38; line h0_X39, h0_Y39; line h0_X40, h0_Y40; line h0_X41, h0_Y41; line h0_X42, h0_Y42; line h0_X43, h0_Y43; line h0_X44, h0_Y44; line h0_X45, h0_Y45; line h0_X46, h0_Y46; line h0_X47, h0_Y47; line h0_X48, h0_Y48; line h0_X49, h0_Y49; line h0_X50, h0_Y50; line h0_X51, h0_Y51; line h0_X52, h0_Y52; line h0_X53, h0_Y53; line h0_X54, h0_Y54; line h0_X55, h0_Y55; line h0_X56, h0_Y56; line h0_X57, h0_Y57; line h0_X58, h0_Y58; line h0_X59, h0_Y59; line h0_X60, h0_Y60; line h0_X61, h0_Y61; line h0_X62, h0_Y62; line h0_X63, h0_Y63 }
            }
            path { stroke: 1.7; color: rgb(h0_r, h0_g, h0_b); move h0_X0, h0_Y0; line h0_X1, h0_Y1; line h0_X2, h0_Y2; line h0_X3, h0_Y3; line h0_X4, h0_Y4; line h0_X5, h0_Y5; line h0_X6, h0_Y6; line h0_X7, h0_Y7; line h0_X8, h0_Y8; line h0_X9, h0_Y9; line h0_X10, h0_Y10; line h0_X11, h0_Y11; line h0_X12, h0_Y12; line h0_X13, h0_Y13; line h0_X14, h0_Y14; line h0_X15, h0_Y15; line h0_X16, h0_Y16; line h0_X17, h0_Y17; line h0_X18, h0_Y18; line h0_X19, h0_Y19; line h0_X20, h0_Y20; line h0_X21, h0_Y21; line h0_X22, h0_Y22; line h0_X23, h0_Y23; line h0_X24, h0_Y24; line h0_X25, h0_Y25; line h0_X26, h0_Y26; line h0_X27, h0_Y27; line h0_X28, h0_Y28; line h0_X29, h0_Y29; line h0_X30, h0_Y30; line h0_X31, h0_Y31; line h0_X32, h0_Y32; line h0_X33, h0_Y33; line h0_X34, h0_Y34; line h0_X35, h0_Y35; line h0_X36, h0_Y36; line h0_X37, h0_Y37; line h0_X38, h0_Y38; line h0_X39, h0_Y39; line h0_X40, h0_Y40; line h0_X41, h0_Y41; line h0_X42, h0_Y42; line h0_X43, h0_Y43; line h0_X44, h0_Y44; line h0_X45, h0_Y45; line h0_X46, h0_Y46; line h0_X47, h0_Y47; line h0_X48, h0_Y48; line h0_X49, h0_Y49; line h0_X50, h0_Y50; line h0_X51, h0_Y51; line h0_X52, h0_Y52; line h0_X53, h0_Y53; line h0_X54, h0_Y54; line h0_X55, h0_Y55; line h0_X56, h0_Y56; line h0_X57, h0_Y57; line h0_X58, h0_Y58; line h0_X59, h0_Y59; line h0_X60, h0_Y60; line h0_X61, h0_Y61; line h0_X62, h0_Y62; line h0_X63, h0_Y63 }
            group { glow: 12, 0.9 * st_glow, #ffffff
