        on press hz3 { emit sg_press(3) }
        on press right hz3 { emit sg_rpress(3) }
        on scroll hz3 { emit sg_wheel(6 + if(wheel > 0, 1, 0)) }
        let hz3_in = hz3.hover > 0.5
        on change hz3_in while hz3_in { emit sg_hover(13) }
        on change hz3_in while not hz3_in { emit sg_hover(12) }
    }

    surface drop {
        size: full, 300
        anchor: top
        level: top
        reserve: -1
        keyboard: none
        rate: 60, 20 while calm
        open: h0_drop > 0.01
        group {
            opacity: h0_drop
            // the display's plate: the bar's surface, a hairline in the line's colour
