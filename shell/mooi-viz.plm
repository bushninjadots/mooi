    fact vs26 = 0.03
    fact vs27 = 0.03
    fact vs28 = 0.03
    fact vs29 = 0.03
    fact vs30 = 0.03
    fact vs31 = 0.03
    fact so0_0 = 0.03
    fact so0_1 = 0.03
    fact so0_2 = 0.03
    fact so0_3 = 0.03
    fact so0_4 = 0.03
