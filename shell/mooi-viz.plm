    fact c_accent_secondary_r = 1.000000
    fact c_accent_secondary_g = 0.572549
    fact c_accent_secondary_b = 0.372549
    fact c_status_ok_r = 0.650980
    fact c_status_ok_g = 0.952941
    fact c_status_ok_b = 0.819608
    fact c_status_error_r = 1.000000
    fact c_status_error_g = 0.572549
    fact c_status_error_b = 0.372549
    fact c_focus_ring_r = 0.650980
    fact c_focus_ring_g = 0.952941
    fact c_focus_ring_b = 0.819608
    fact c_selection_bg_r = 0.164706
    fact c_selection_bg_g = 0.227451
    fact c_selection_bg_b = 0.211765
    // What theme/ferrolume reads for its geometry; the studio uses the colour, not the bar's
    // strip, so these are only the values the tokens are defined against.
    fact st_offset = 0
    fact st_notch = false
    fact bar_rail = true
    fact st_height = 30
    fact st_radius = 8
    fact st_res = 46


    fact np_playing = false
    fact viz_still = false
    fact vb0 = 0.03
    fact vb1 = 0.03
    fact vb2 = 0.03
    fact vb3 = 0.03
    fact vb4 = 0.03
    fact vb5 = 0.03
    fact vb6 = 0.03
    fact vb7 = 0.03
    fact vb8 = 0.03
    fact vb9 = 0.03
    fact vb10 = 0.03
    fact vb11 = 0.03
    fact vb12 = 0.03
    fact vb13 = 0.03
    fact vb14 = 0.03
    fact vb15 = 0.03
    fact np_beat = 0
    fact lA_on = false
    fact lA_dx = 0
    fact lA_dy = 0
    fact lA_k = 0
    fact lA_x = 0
    fact lA_y = 0
    fact lA_w = 10
    fact lA_h = 10
    fact lA_u = 1
    fact lA_mode = 0
    fact lA_n = 64
    fact lA_gap = 0.3
    fact lA_glow = 0.6
    fact lA_peaks = true
    fact lA_refl = false
    fact lA_plate = false
    fact lA_st = 0
    fact lA_gh = false
    fact lA_opa = 1
    fact lA_sel = false
    fact lA_ad = false
    fact lA_beh = false
    fact lA_ar = 0.6
    fact lA_ag = 0.8
    fact lA_ab = 0.7
    fact lB_on = false
    fact lB_dx = 0
    fact lB_dy = 0
    fact lB_k = 0
    fact lB_x = 0
