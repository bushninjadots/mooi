    fact so2_19 = 0.03
    fact so2_20 = 0.03
    fact so2_21 = 0.03
    fact so2_22 = 0.03
    fact so2_23 = 0.03
    fact rp_r0 = 0
    fact rp_a0 = 0
    fact rp_r1 = 0
    fact rp_a1 = 0
    fact rp_r2 = 0
    fact rp_a2 = 0
    fact rp_r3 = 0
    fact rp_a3 = 0
    spring wg.coast = 60, 14
    prop np_tspd = 0 ~wg.coast
    follow np_tspd = if(np_playing and not viz_still, 40 * mood_pace, 0)
    prop np_turn = 0
    spin np_turn by np_tspd
    prop np_scatter = 0 ~180ms
    follow np_scatter = np_beat
    fact mood_glow = 1
    fact mood_pace = 1
    fact lA_po = 1               // its slot's own opacity (the ambient rest, idle)
    fact lA_sm = 0.5             // how slowly its bars fall (options.smooth)
    fact lB_po = 1               // its slot's own opacity (the ambient rest, idle)
    fact lB_sm = 0.5             // how slowly its bars fall (options.smooth)
    fact lC_po = 1               // its slot's own opacity (the ambient rest, idle)
    fact lC_sm = 0.5             // how slowly its bars fall (options.smooth)
    fact st_glow = 1             // the theme's finish (lib/style)
    fact hold = true             // the widgets draw them (editing, desk mode, or not yet told)

    surface viz {
        size: full, full
        anchor: top
        level: bottom
        keyboard: none
        rate: 30, 4 while not np_playing or hold

        group {
            show: lA_on and not hold and lA_st < 1.5
            opacity: if(viz_still, if(lA_st < 0.5, 1, 0.35), lA_po) * lA_opa
            box { from: lA_x, lA_y; size: lA_w, lA_h; corner: 6 * lA_u; color: fl.hull; opacity: 0.7; show: lA_plate }
            vw.LaneA(lA_x, lA_y, lA_w, lA_h, lA_u, lA_mode, lA_n, lA_gap, lA_glow * mood_glow, lA_peaks, lA_refl, if(lA_ad, rgb(lA_ar, lA_ag, lA_ab), fl.phos), if(lA_ad, mix(rgb(lA_ar, lA_ag, lA_ab), #ffffff, 0.35), fl.ember), fl.trace_dim, viz_still)
        }
        group {
            show: lB_on and not hold and lB_st < 1.5
            opacity: if(viz_still, if(lB_st < 0.5, 1, 0.35), lB_po) * lB_opa
            box { from: lB_x, lB_y; size: lB_w, lB_h; corner: 6 * lB_u; color: fl.hull; opacity: 0.7; show: lB_plate }
            vw.LaneB(lB_x, lB_y, lB_w, lB_h, lB_u, lB_mode, lB_n, lB_gap, lB_glow * mood_glow, lB_peaks, lB_refl, if(lB_ad, rgb(lB_ar, lB_ag, lB_ab), fl.phos), if(lB_ad, mix(rgb(lB_ar, lB_ag, lB_ab), #ffffff, 0.35), fl.ember), fl.trace_dim, viz_still)
        }
        group {
            show: lC_on and not hold and lC_st < 1.5
            opacity: if(viz_still, if(lC_st < 0.5, 1, 0.35), lC_po) * lC_opa
            box { from: lC_x, lC_y; size: lC_w, lC_h; corner: 6 * lC_u; color: fl.hull; opacity: 0.7; show: lC_plate }
            vw.LaneC(lC_x, lC_y, lC_w, lC_h, lC_u, lC_mode, lC_n, lC_gap, lC_glow * mood_glow, lC_peaks, lC_refl, if(lC_ad, rgb(lC_ar, lC_ag, lC_ab), fl.phos), if(lC_ad, mix(rgb(lC_ar, lC_ag, lC_ab), #ffffff, 0.35), fl.ember), fl.trace_dim, viz_still)
        }
    }
}
