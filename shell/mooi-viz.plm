language 0.9
import "theme/tokens.plm"
import "theme/ferrolume.plm"
import "ui/vizwide.plm" as vw

// mooi's visualisers (D155): the desktop widgets' visualiser lanes as a program of their own. Every
// frame of a scene costs what the whole scene holds, and in the widgets' (39k instructions) one 127-bar
// visualiser made all of it redraw 30 times a second while music played. Here it is a few thousand.
// The widgets still decide where each one is and how it looks — shell/mooi-widgets.luau sends their
// lane facts when they change — and draw them themselves while they are edited or gathered (`hold`),
// so a drag stays live. This takes the music itself (the bar's feed) and draws; no zones, every press
// goes through. shell/mooi-viz.luau.

scene Viz {
    permissions {
        run: "pleamar"
        services: "files", "media", "env"
    }

    // The same facts and springs the bar wears: the logic paints them from palette.json, and
    // the studio re-lights with the desktop when the palette changes after an apply.
    // corners on every plate (look.corners: 0 chamfer · 1 bevel · 2 rounded · 3 square; look.corner_size as a scale)
    fact cn_kind = 0
    fact cn_scale = 1
    fact fr_ground_r = 0.000000
    fact fr_ground_g = 0.000000
    fact fr_ground_b = 0.000000
    fact fr_hull_r = 0.015686
    fact fr_hull_g = 0.035294
    fact fr_hull_b = 0.031373
    fact fr_hull_raised_r = 0.027451
    fact fr_hull_raised_g = 0.074510
    fact fr_hull_raised_b = 0.066667
