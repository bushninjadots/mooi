    fact lC_y = 0
    fact lC_w = 10
    fact lC_h = 10
    fact lC_u = 1
    fact lC_mode = 0
    fact lC_n = 64
    fact lC_gap = 0.3
    fact lC_glow = 0.6
    fact lC_peaks = true
    fact lC_refl = false
    fact lC_plate = false
    fact lC_st = 0
    fact lC_gh = false
    fact lC_opa = 1
    fact lC_sel = false
    fact lC_ad = false
    fact lC_beh = false
    fact lC_ar = 0.6
    fact lC_ag = 0.8
    fact lC_ab = 0.7
    model vzA max 128 { v: number; pk: number }
    model vzB max 128 { v: number; pk: number }
    model vzC max 128 { v: number; pk: number }
    fact vs0 = 0.03
    fact vs1 = 0.03
    fact vs2 = 0.03
    fact vs3 = 0.03
