    fact lB_w = 10
    fact lB_h = 10
    fact lB_u = 1
    fact lB_mode = 0
    fact lB_n = 64
    fact lB_gap = 0.3
    fact lB_glow = 0.6
    fact lB_peaks = true
    fact lB_refl = false
    fact lB_plate = false
    fact lB_st = 0
