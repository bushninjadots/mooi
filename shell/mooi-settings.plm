                    SCard(386, gc_0_1, "Bar")
                }
                group {
                    show: true
                    move: 0, gy_0_6 - 430
                    SRow(430, "Layout", "Islands, one bar, or pieces hanging from the top", true, "", 418, false)
                    STrack(742, 446, 396)
