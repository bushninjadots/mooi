                    move: 0, gy_20_9 - 578
                    SRow(578, "Cubes", "A whole workspace folded into one small solid and unfolded back where it was. Needs Fold", true, "", 768, true)
                    SToggle(1092, 596, sv_loom_cubes, set_value, 474, "loom.cubes")
                    SRevert(1062, 608, sv_loom_cubes != df_loom_cubes, set_value, 474000 + df_loom_cubes)
                }
                group {
                    show: sv_loom_fold < 0.5 and sv_loom_cubes > 0.5 and sv_loom_mode > 0.5 and sv_loom_mode < 1.5
                    move: 0, gy_20_10 - 638
                    text "CUBES NEED FOLD — TURN FOLD ON FIRST" { at: 274, 652; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.ember }
                }
                group {
                    show: true
                    move: 0, gy_20_11 - 666
                    SRow(666, "Edge", "The screen edge the Accordions' strips and the docked Cubes stand on", true, "", 550, true)
                    STrack(874, 682, 264)
                    SChoice(874, 682, 132, "Right", sv_loom_edge == 0, set_value, 467000)
                    SChoice(1006, 682, 132, "Left", sv_loom_edge == 1, set_value, 467001)
                    SRevert(844, 696, sv_loom_edge != df_loom_edge, set_value, 467000 + df_loom_edge)
                }
                group {
                    show: true
                    move: 0, gy_20_12 - 726
                    SRow(726, "Loom", "Connections between windows that do something: hop along them, see them as threads", true, "", 768, true)
                    SToggle(1092, 744, sv_loom_loom, set_value, 477, "loom.loom")
                    SRevert(1062, 756, sv_loom_loom != df_loom_loom, set_value, 477000 + df_loom_loom)
                }
                group {
                    show: sv_loom_loom > 0.5
                    move: 0, gy_20_13 - 786
                    SRow(786, "Threads", "When the threads show: a few seconds when the focused window has connections, always, or only while linking", true, "", 418, true)
                    STrack(742, 802, 396)
                    SChoice(742, 802, 132, "When relevant", sv_loom_threads == 0, set_value, 478000)
                    SChoice(874, 802, 132, "Always", sv_loom_threads == 1, set_value, 478001)
                    SChoice(1006, 802, 132, "Hidden", sv_loom_threads == 2, set_value, 478002)
                    SRevert(712, 816, sv_loom_threads != df_loom_threads, set_value, 478000 + df_loom_threads)
                }
                group {
                    show: true
                    move: 0, gy_20_14 - 846
                    text "KEYS (SETTINGS → KEYS): SUPER+ALT+A ADD · ] [ NEXT, PREVIOUS · F FOLD · U OPEN ALL · R TAKE OUT · K MAKE A CUBE · J JOIN THE CUBE · N LINK (SHIFT: A WORKFLOW) · H HOP ALONG A LINK. A STRIP: PRESS PULLS, DRAG REORDERS, WHEEL STEPS. A CUBE: PRESS FOLDS OR UNFOLDS, WHEEL TURNS, MIDDLE OPENS ONE SIDE" { at: 274, 860; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.ember }
                }
            }
            group {
                show: set_tab == 21
                group {
                    show: true
                    move: 0, gy_21_c0 - 112
                    SCard(112, gc_21_0, "Agents")
                }
                group {
                    show: true
                    move: 0, gy_21_1 - 156
                    SRow(156, "Show idle agents", "Idle agents stay in the island instead of being hidden", true, "", 768, false)
                    SToggle(1092, 174, sv_herdr_show_idle, set_value, 503, "herdr.show_idle")
                    SRevert(1062, 186, sv_herdr_show_idle != df_herdr_show_idle, set_value, 503000 + df_herdr_show_idle)
                }
                group {
                    show: true
                    move: 0, gy_21_2 - 216
                    SRow(216, "Show finished agents", "Agents that finished stay in the island instead of being hidden", true, "", 768, true)
                    SToggle(1092, 234, sv_herdr_show_done, set_value, 504, "herdr.show_done")
                    SRevert(1062, 246, sv_herdr_show_done != df_herdr_show_done, set_value, 504000 + df_herdr_show_done)
                }
                group {
                    show: true
                    move: 0, gy_21_c1 - 298
                    SCard(298, gc_21_1, "Briefs")
                }
                group {
                    show: true
                    move: 0, gy_21_4 - 342
                    SRow(342, "What it is doing", "The window title plus the last lines of output, cached for 8 seconds", true, "", 768, false)
                    SToggle(1092, 360, sv_herdr_brief, set_value, 505, "herdr.brief")
                    SRevert(1062, 372, sv_herdr_brief != df_herdr_brief, set_value, 505000 + df_herdr_brief)
                }
                group {
                    show: sv_herdr_brief == 1
                    move: 0, gy_21_5 - 402
                    SRow(402, "Lines", "How many lines the brief reads", true, "", 404, true)
                    SSlider(728, 418, 330, sv_herdr_brief_lines, 6, set_value, 506, "Lines", "{sv_herdr_brief_lines, 0}", true)
                    SRevert(698, 432, sv_herdr_brief_lines != df_herdr_brief_lines, set_value, 506000 + df_herdr_brief_lines)
                }
                group {
                    show: true
                    move: 0, gy_21_6 - 462
                    SRow(462, "Check every", "Seconds between snapshots while the island or module is visible", true, "", 404, true)
                    SSlider(728, 478, 330, sv_herdr_poll, 8, set_value, 502, "Check every", "{sv_herdr_poll, 0} s", true)
                    SRevert(698, 492, sv_herdr_poll != df_herdr_poll, set_value, 502000 + df_herdr_poll)
                }
                group {
                    show: true
                    move: 0, gy_21_7 - 522
                    text "CLICK FOCUSES AN AGENT AND RAISES ITS WINDOW · RIGHT CLICK ATTACHES IN A TERMINAL" { at: 274, 536; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.ember }
                }
            }
            }
            // Search: what matches, from every page; a press goes to it
            group {
                show: searching
                box { from: 233, 96 + set_scroll_s; size: screen.width - 233, screen.height - 96; color: mix(fl.ground, fl.steel_900, 0.6) }
                text "{set_hits, 0} MATCHING · ENTER OPENS THE FIRST · ESC CLEARS" { at: 274, 120 + set_scroll_s; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.ember }
                for r in set_results { SResult(r, 140 + set_scroll_s + r.index * 64, set_jump) }
            }
        }
        // The header, over the scrolled rows: the page's name, what it is for, and its Reset.
        box { from: 233, 0; size: screen.width - 233, 96; color: mix(fl.ground, fl.steel_900, 0.6) }
        text pick(set_tab, "Quick settings", "Theme & colour", "Motion & effects", "Bar & Frame", "Windows", "Input", "Window shutter", "Overview", "Displays", "Wallpapers", "Widgets", "BMO", "Sound", "Power", "Lock screen", "Keys", "System", "Signal Loom", "Advanced", "Control Nexus", "Loom / Fold", "Herdr") { at: 256, 40; anchor: left center; size: 26; weight: 600; family: "Exo 2"; color: fl.phos }
        text pick(set_tab, "The few choices that change the most; every other page holds the rest", "One palette for everything mooi draws: the bar, its islands and panels, your window borders", "How fast things move, what glows, and what goes quiet to save the battery", "Everything about the bar and the frame round the screen: four choices here, every detail folded below", "Hyprland's windows, styled by mooi so they match. A slider's lowest step keeps your own", "How the touchpad and the mouse scroll. A speed's lowest step keeps your own", "A window's controls unfolding from its edge: Super+Alt+D, or Super+Alt+right-click on a window", "Super+Tab: every workspace at once — search it, move windows between them, save and restore setups", "Your monitors as Hyprland has them (set them in your Hyprland config for now)", "mooi draws the wallpaper: pictures, animated ones and videos. Pick them in the picker (Super+W) or the notch", "Music, clocks, notes, GitHub, weather, a focus timer and more on your desktop. Place them in edit mode", "Your desktop companion: his size, his home, his look and what he notices (his own panel sets these too)", "Where sound plays and where it listens, and each app's own volume", "The battery, and how hard the machine works", "When the screen locks by itself, and the picture it wears", "mooi's keyboard shortcuts. Press Change, then the new keys", "Notifications, the islands and comfort", "How notifications arrive, join up and unfold; Reset puts them back as they came", "What mooi is doing, where it keeps things, and its log", "The deck from the bar's mark, its cards and notches, the side notch, and Claude", "Experimental: connect and fold your windows into structures, alongside mooi or as the whole desktop", "Coding agents in the bar: what each is doing, and which one is waiting on you. Needs herdr") { at: 256, 70; anchor: left center; size: 12; family: "Exo 2"; color: fl.muted; width: 700; lines: 1 }
        box { from: 233, 95; size: screen.width - 233, 1; color: fl.trace_dim }
        group {
            show: not searching
            SButton(screen.width - 236, 30, 164, pick(rs_armed == set_tab, "Reset this page", "Press again to reset"), set_reset, set_tab, rs_armed == set_tab)
        }
        zone box set_close { from: screen.width - 52, 30; size: 32, 32; corner: 6; cursor: pointer; role: button; label: "Close the settings" }
        box { from: screen.width - 52, 30; size: 32, 32; corner: 6; color: fl.hull_raised; opacity: set_close.hover }
        line { from: screen.width - 42, 40; to: screen.width - 30, 52; width: 1.5; color: mix(fl.muted, fl.ember, set_close.hover) }
        line { from: screen.width - 30, 40; to: screen.width - 42, 52; width: 1.5; color: mix(fl.muted, fl.ember, set_close.hover) }
        on press set_close { emit set_action(9) }
    }
}
