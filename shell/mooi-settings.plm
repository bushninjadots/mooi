    // A page chosen slides in: it starts a little low and clear, and settles.
    prop pg = 1
    layer page_in {
        fresh for 30ms after set_pick { pg: 0 ~1ms }
        shown                         { pg: 1 ~m.enter }
    }
    on set_pick(v) { set_tab = v; set_scroll = 0; rs_armed = -1 }

    surface settings_win {
        kind: window
        title: "mooi · settings"
        size: 1180, 800
        // the keyboard on a click (search, key capture): a window has none unless it asks
        keyboard: on_demand
        box { from: 0, 0; size: screen.width, screen.height; color: mix(fl.ground, fl.steel_900, 0.6) }
        // The rail: mooi's mark, search, the pages in their groups, and the bar's own edit mode.
        box { from: 0, 0; size: 232, screen.height; color: mix(fl.steel_900, fl.hull, 0.35) }
        group { glow: 6, (0.6) * st_glow, fl.phos; box { from: 231, 0; size: 1, screen.height; color: fl.phos; opacity: 0.3 } }
        box { from: 232, 0; size: 1, screen.height; color: fl.trace_dim }
        text "MOOI" { at: 24, 38; anchor: left center; size: 24; weight: 700; family: "Exo 2"; color: fl.phos; shadow: 0, 0, 8, 40%, fl.phos }
        text "SETTINGS · {upper(bar_version)}" { at: 24, 62; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.ember; width: 190; lines: 1 }
        zone box set_find { from: 14, 82; size: 204, 34; corner: 5; cursor: text; role: region; label: "Search the settings" }
        box { from: 14, 82; size: 204, 34; corner: 5; color: fl.ground }
        box { from: 14, 82; size: 204, 34; corner: 5; stroke: 1; color: mix(mix(fl.steel_700, fl.trace_lit, set_find.hover), fl.phos, searching) }
        ellipse { at: 31, 98; radius: 5; stroke: 1.3; color: mix(fl.muted, fl.phos, searching) }
        line { from: 34.5, 101.5; to: 38.5, 105.5; width: 1.3; color: mix(fl.muted, fl.phos, searching) }
        text "SEARCH · CTRL F" { at: 46, 99; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.muted; show: not searching }
        input set_query { at: 46, 90; width: 164; size: 12; family: "Exo 2"; color: fl.phos; selection: fl.well }
        on press set_find { focus set_query }
        // the pages, scrolled by the wheel when they do not fit above the edit button
        zone box set_rail { from: 0, 124; size: 232, screen.height - 200 }
        on scroll set_rail { set_navs = clamp(set_navs - wheel * 44, 0, max(0, 751 - (screen.height - 76))) }
        group {
            clip box { from: 0, 124 + set_navs_s; size: 232, screen.height - 200 }
            move: 0, 0 - set_navs_s
            SNavGroup(136, "LOOK")
            SNav(156, "Quick", set_tab == 0, 0, set_pick)
            SNav(178, "Theme & colour", set_tab == 1, 1, set_pick)
            SNav(200, "Motion", set_tab == 2, 2, set_pick)
            SNavGroup(225, "BAR")
            SNav(243, "Bar & Frame", set_tab == 3, 3, set_pick)
            SNavGroup(268, "DESKTOP")
            SNav(286, "Windows", set_tab == 4, 4, set_pick)
            SNav(308, "Input", set_tab == 5, 5, set_pick)
            SNav(330, "Shutter", set_tab == 6, 6, set_pick)
            SNav(352, "Overview", set_tab == 7, 7, set_pick)
            SNav(374, "Displays", set_tab == 8, 8, set_pick)
            SNav(396, "Wallpaper", set_tab == 9, 9, set_pick)
            SNav(418, "Widgets", set_tab == 10, 10, set_pick)
            SNav(440, "BMO", set_tab == 11, 11, set_pick)
            SNavGroup(465, "SYSTEM")
            SNav(483, "Sound", set_tab == 12, 12, set_pick)
            SNav(505, "Power", set_tab == 13, 13, set_pick)
            SNav(527, "Lock", set_tab == 14, 14, set_pick)
            SNav(549, "Keys", set_tab == 15, 15, set_pick)
            SNav(571, "System", set_tab == 16, 16, set_pick)
            SNav(593, "Signals", set_tab == 17, 17, set_pick)
            SNav(615, "Advanced", set_tab == 18, 18, set_pick)
            SNavGroup(640, "SHELL")
            SNav(658, "Nexus", set_tab == 19, 19, set_pick)
            SNav(680, "Loom / Fold", set_tab == 20, 20, set_pick)
            SNavGroup(705, "DESKTOP")
            SNav(723, "Herdr", set_tab == 21, 21, set_pick)
        }
        box { from: 14, screen.height - 77; size: 204, 1; color: fl.trace_dim; show: 751 > screen.height - 76 }
        SButton(16, screen.height - 64, 200, "Edit on the bar", set_action, 1, bar_edit)
        text "CHANGES APPLY AT ONCE" { at: 18, screen.height - 18; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.trace }

        // The page: its cards and rows (scrolled by the wheel), sliding in when it is chosen.
