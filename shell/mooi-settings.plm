    fact cq6_g = 0.1
    fact cq6_b = 0.1
    fact cq7_r = 0.1
    fact cq7_g = 0.1
    fact cq7_b = 0.1
    fact lay_c1 = true
    fact lay_c2 = true
    fact lay_c3 = true
    fact lay_c4 = true
    fact lay_c5 = true
    fact lay_c6 = true
    fact lay_c7 = true
    fact lay_c8 = true
