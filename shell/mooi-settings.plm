            }
            // Search: what matches, from every page; a press goes to it
            group {
                show: searching
                box { from: 233, 96 + set_scroll_s; size: screen.width - 233, screen.height - 96; color: mix(fl.ground, fl.steel_900, 0.6) }
                text "{set_hits, 0} MATCHING · ENTER OPENS THE FIRST · ESC CLEARS" { at: 274, 120 + set_scroll_s; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.ember }
                for r in set_results { SResult(r, 140 + set_scroll_s + r.index * 64, set_jump) }
            }
        }
        // The header, over the scrolled rows: the page's name, what it is for, and its Reset.
        box { from: 233, 0; size: screen.width - 233, 96; color: mix(fl.ground, fl.steel_900, 0.6) }
        text pick(set_tab, "Quick settings", "Colour", "Motion & effects", "The bar", "Layout", "Workspaces", "Media", "Screen frame", "Windows", "Input", "Window shutter", "Overview", "Displays", "Desk", "Widgets", "BMO", "Sound", "Power", "Keys", "System", "Signal Loom", "Advanced", "Control Nexus") { at: 256, 40; anchor: left center; size: 26; weight: 600; family: "Exo 2"; color: fl.phos }
        text pick(set_tab, "The few choices that change the most; every other page holds the rest", "One palette for everything mooi draws: the bar, its islands and panels, your window borders", "How fast things move, what glows, and what goes quiet to save the battery", "A style sets the surface and the edges at once; change any of them and it reads Custom", "Every module, where it sits. Select one, then move it, group it or send it anywhere", "The switcher on the bar", "The player on the bar", "One body with the bar: a band round the screen the bar grows out of; it can move with the music", "Hyprland's windows, styled by mooi so they match. A slider's lowest step keeps your own", "How the touchpad and the mouse scroll. A speed's lowest step keeps your own", "A window's controls unfolding from its edge: Super+Alt+D, or Super+Alt+right-click on a window", "Super+Tab: every workspace at once — search it, move windows between them, save and restore setups", "Your monitors as Hyprland has them (set them in your Hyprland config for now)", "mooi's own drawing of the wallpaper, so it can travel with you. Pictures are picked in Skwd Wall", "Now Playing and the visualiser on your desktop. Place them by dragging in edit mode", "Your desktop companion: his size, his home, his look and what he notices (his own panel sets these too)", "Where sound plays and where it listens, and each app's own volume", "The battery, and how hard the machine works", "mooi's keyboard shortcuts. Press Change, then the new keys", "Notifications, the islands and comfort", "How notifications arrive, join up and unfold; Reset puts them back as they came", "What mooi is doing, where it keeps things, and its log", "The deck from the bar's mark, its cards and notches, the side notch, and Claude") { at: 256, 70; anchor: left center; size: 12; family: "Exo 2"; color: fl.muted; width: 700; lines: 1 }
        box { from: 233, 95; size: screen.width - 233, 1; color: fl.trace_dim }
        group {
            show: not searching
            SButton(screen.width - 236, 30, 164, pick(rs_armed == set_tab, "Reset this page", "Press again to reset"), set_reset, set_tab, rs_armed == set_tab)
        }
        zone box set_close { from: screen.width - 52, 30; size: 32, 32; corner: 6; cursor: pointer; role: button; label: "Close the settings" }
        box { from: screen.width - 52, 30; size: 32, 32; corner: 6; color: fl.hull_raised; opacity: set_close.hover }
        line { from: screen.width - 42, 40; to: screen.width - 30, 52; width: 1.5; color: mix(fl.muted, fl.ember, set_close.hover) }
        line { from: screen.width - 30, 40; to: screen.width - 42, 52; width: 1.5; color: mix(fl.muted, fl.ember, set_close.hover) }
        on press set_close { emit set_action(9) }
    }
}
