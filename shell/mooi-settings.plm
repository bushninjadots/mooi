                    SChoice(874, 446, 132, "Full bar", sv_bar_mode == 1, set_value, 1001)
                    SChoice(1006, 446, 132, "Notch", sv_bar_mode == 2, set_value, 1002)
                    SRevert(712, 460, sv_bar_mode != df_bar_mode, set_value, 1000 + df_bar_mode)
