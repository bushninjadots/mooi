    // A page chosen slides in: it starts a little low and clear, and settles.
    prop pg = 1
    layer page_in {
        fresh for 30ms after set_pick { pg: 0 ~1ms }
        shown                         { pg: 1 ~m.enter }
    }
    on set_pick(v) { set_tab = v; set_scroll = 0; rs_armed = -1 }

    surface settings_win {
        kind: window
        title: "mooi · settings"
        size: 1180, 760
        // the keyboard on a click (search, key capture): a window has none unless it asks
        keyboard: on_demand
        box { from: 0, 0; size: screen.width, screen.height; color: mix(fl.ground, fl.steel_900, 0.6) }
        // The rail: mooi's mark, search, the pages in their groups, and the bar's own edit mode.
        box { from: 0, 0; size: 232, screen.height; color: mix(fl.steel_900, fl.hull, 0.35) }
        group { glow: 6, (0.6) * st_glow, fl.phos; box { from: 231, 0; size: 1, screen.height; color: fl.phos; opacity: 0.3 } }
        box { from: 232, 0; size: 1, screen.height; color: fl.trace_dim }
        text "MOOI" { at: 24, 38; anchor: left center; size: 24; weight: 700; family: "Exo 2"; color: fl.phos; shadow: 0, 0, 8, 40%, fl.phos }
        text "SETTINGS · {upper(bar_version)}" { at: 24, 62; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.ember; width: 190; lines: 1 }
        zone box set_find { from: 14, 82; size: 204, 34; corner: 5; cursor: text; role: region; label: "Search the settings" }
        box { from: 14, 82; size: 204, 34; corner: 5; color: fl.ground }
        box { from: 14, 82; size: 204, 34; corner: 5; stroke: 1; color: mix(mix(fl.steel_700, fl.trace_lit, set_find.hover), fl.phos, searching) }
        ellipse { at: 31, 98; radius: 5; stroke: 1.3; color: mix(fl.muted, fl.phos, searching) }
        line { from: 34.5, 101.5; to: 38.5, 105.5; width: 1.3; color: mix(fl.muted, fl.phos, searching) }
        text "SEARCH · CTRL F" { at: 46, 99; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.muted; show: not searching }
        input set_query { at: 46, 90; width: 164; size: 12; family: "Exo 2"; color: fl.phos; selection: fl.well }
        on press set_find { focus set_query }
        SNavGroup(136, "LOOK")
        SNav(160, "Quick", set_tab == 0, 0, set_pick)
        SNav(194, "Colour", set_tab == 1, 1, set_pick)
        SNavGroup(234, "BAR")
        SNav(258, "Bar", set_tab == 2, 2, set_pick)
        SNav(292, "Layout", set_tab == 3, 3, set_pick)
        SNav(326, "Workspaces", set_tab == 4, 4, set_pick)
        SNav(360, "Media", set_tab == 5, 5, set_pick)
        SNavGroup(400, "DESKTOP")
        SNav(424, "Frame", set_tab == 6, 6, set_pick)
        SNav(458, "Windows", set_tab == 7, 7, set_pick)
        SNav(492, "Input", set_tab == 8, 8, set_pick)
        SNavGroup(532, "SYSTEM")
        SNav(556, "Keys", set_tab == 9, 9, set_pick)
        SNav(590, "System", set_tab == 10, 10, set_pick)
        SButton(16, screen.height - 64, 200, "Edit on the bar", set_action, 1, bar_edit)
        text "CHANGES APPLY AT ONCE" { at: 18, screen.height - 18; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.trace }

        // The page: its cards and rows (scrolled by the wheel), sliding in when it is chosen.
        zone box set_body { from: 233, 96; size: screen.width - 233, screen.height - 96 }
        on scroll set_body { set_scroll = clamp(set_scroll - wheel * 48, 0, pick(set_tab, max(0, 112 + 44 + 60 + if(sv_theme_preset > 5.5, 28, 0) + 60 + 22 + 44 + 60 + 60 + if(sv_bar_style > 4.5, 28, 0) + 60 + 60 + 22 + 44 + 60 + 60 + 22 + 24 - screen.height), max(0, 112 + 44 + 60 + 60 + if(theme_wallpaper, 60, 0) + if(theme_wallpaper, 142, 0) + 60 + 22 + 44 + 60 + 60 + 60 + 60 + 22 + 44 + 60 + 60 + if(sv_bar_bg > 0.5, 60, 0) + if(sv_bar_bg > 0.5, 60, 0) + if(sv_bar_bg > 0.5, 60, 0) + 22 + 44 + 28 + 60 + 60 + 60 + 22 + 24 - screen.height), max(0, 112 + 44 + 60 + 60 + 60 + 60 + 60 + 22 + 44 + 60 + if(sv_bar_style > 4.5, 28, 0) + 60 + if(bar_surface < 2.5, 60, 0) + if(bar_surface > 0.5 and bar_surface < 1.5, 60, 0) + if(bar_surface > 0.5 and bar_surface < 2.5, 60, 0) + if(bar_surface < 2.5 or bar_surface > 3.5, 60, 0) + 22 + 44 + 60 + if(sv_bar_edge > 0.5, 60, 0) + 60 + if(not st_notch, 60, 0) + 60 + 22 + 24 - screen.height), max(0, 112 + 308 + lay_zh + 48 + 24 - screen.height), max(0, 112 + 44 + 60 + 60 + if(ws_style < 0.5 and not bar_full and not st_notch, 60, 0) + if(ws_style < 2.5, 60, 0) + 22 + 44 + 60 + 60 + 22 + 24 - screen.height), max(0, 112 + 44 + 60 + 60 + if(media_mode != 2, 60, 0) + 22 + 24 - screen.height), max(0, 112 + 44 + 60 + if(not frame_on, 28, 0) + if(frame_on and not dk_manage, 28, 0) + 22 + if(frame_on, 44, 0) + if(frame_on, 60, 0) + if(frame_on, 60, 0) + if(frame_on, 60, 0) + if(frame_on, 60, 0) + if(frame_on, 22, 0) + if(frame_on, 44, 0) + if(frame_on, 60, 0) + if((frame_on) and (frame_music), 60, 0) + if((frame_on) and (frame_music), 60, 0) + if(frame_on, 22, 0) + 24 - screen.height), max(0, 112 + 44 + 60 + if(not dk_manage, 28, 0) + 22 + if(dk_manage, 44, 0) + if(dk_manage, 60, 0) + if(dk_manage, 60, 0) + if(dk_manage, 60, 0) + if(dk_manage, 22, 0) + if(dk_manage, 44, 0) + if(dk_manage, 60, 0) + if(dk_manage, 60, 0) + if(dk_manage, 22, 0) + if(dk_manage, 44, 0) + if(dk_manage, 60, 0) + if(dk_manage, 60, 0) + if(dk_manage, 60, 0) + if((dk_manage) and (sv_desktop_shadow > 1.5), 60, 0) + if(dk_manage, 60, 0) + if(dk_manage, 60, 0) + if(dk_manage, 22, 0) + if(dk_manage, 44, 0) + if(dk_manage, 60, 0) + if((dk_manage) and (sv_desktop_layout == 0 or sv_desktop_layout == 3), 60, 0) + if((dk_manage) and (sv_desktop_layout == 0 or sv_desktop_layout == 3), 60, 0) + if(dk_manage, 22, 0) + 24 - screen.height), max(0, 112 + if(not dk_manage, 28, 0) + if(dk_manage, 44, 0) + if(dk_manage, 60, 0) + if(dk_manage, 60, 0) + if(dk_manage, 22, 0) + if(dk_manage, 44, 0) + if(dk_manage, 60, 0) + if(dk_manage, 60, 0) + if(dk_manage, 22, 0) + 24 - screen.height), max(0, 112 + 44 + 420 + 22 + 24 - screen.height), max(0, 112 + 44 + 60 + 60 + 22 + 44 + 60 + 60 + 60 + 22 + 44 + 60 + 60 + 22 + 24 - screen.height))) }
        group {
            // the clip is in the moved group's own coordinates: it is carried back down by the scroll,
            // or it rises with the rows and a scrolled section showed only its top (fixed 2026-10-20)
            clip box { from: 233, 96 + set_scroll_s; size: screen.width - 233, screen.height - 96 }
            move: 0, 0 - set_scroll_s
            group {
                opacity: pg
                move: 0, 14 * (1 - pg)
            group {
                show: set_tab == 0
                group {
                    show: true
                    move: 0, gy_0_c0 - 112
                    SCard(112, gc_0_0, "Look")
                }
                group {
                    show: true
                    move: 0, gy_0_1 - 156
                    SRow(156, "Look", "A finished palette: base, finish and light together", true, "", 346, false)
                    STrack(670, 172, 468)
                    SChoice(670, 172, 78, "Phosphor", sv_theme_preset == 0, set_value, 66000)
                    SChoice(748, 172, 78, "Neon noir", sv_theme_preset == 1, set_value, 66001)
                    SChoice(826, 172, 78, "Concrete", sv_theme_preset == 2, set_value, 66002)
                    SChoice(904, 172, 78, "Gunmetal", sv_theme_preset == 3, set_value, 66003)
                    SChoice(982, 172, 78, "Alien", sv_theme_preset == 4, set_value, 66004)
                    SChoice(1060, 172, 78, "Titanium", sv_theme_preset == 5, set_value, 66005)
                    SRevert(640, 186, sv_theme_preset != df_theme_preset, set_value, 66000 + df_theme_preset)
                }
                group {
                    show: sv_theme_preset > 5.5
                    move: 0, gy_0_2 - 216
                    text "CUSTOM — CHANGED ON THE COLOUR PAGE" { at: 274, 230; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.ember }
                }
                group {
                    show: true
                    move: 0, gy_0_3 - 244
                    SRow(244, "Colours from", "Your wallpaper, or mooi's own teal and orange", true, "", 550, true)
                    STrack(874, 260, 264)
                    SChoice(874, 260, 132, "mooi default", theme_wallpaper == 0, set_value, 21000)
                    SChoice(1006, 260, 132, "Wallpaper", theme_wallpaper == 1, set_value, 21001)
                    SRevert(844, 274, sv_theme_source != df_theme_source, set_value, 21000 + df_theme_source)
                }
                group {
                    show: true
                    move: 0, gy_0_c1 - 326
                    SCard(326, gc_0_1, "Bar")
                }
                group {
