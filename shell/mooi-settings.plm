        group {
            // the clip is in the moved group's own coordinates: it is carried back down by the scroll,
            // or it rises with the rows and a scrolled section showed only its top (fixed 2026-10-20)
            clip box { from: 233, 96 + set_scroll_s; size: screen.width - 233, screen.height - 96 }
            move: 0, 0 - set_scroll_s
            group {
                opacity: pg
                move: 0, 14 * (1 - pg)
            group {
                show: set_tab == 0
                group {
                    show: true
                    move: 0, gy_0_c0 - 112
                    SCard(112, gc_0_0, "Look")
                }
                group {
                    show: true
                    move: 0, gy_0_1 - 156
                    SRow(156, "Look", "A finished palette: base, finish and light together", true, "", 346, false)
                    STrack(670, 172, 468)
                    SChoice(670, 172, 78, "Phosphor", sv_theme_preset == 0, set_value, 66000)
                    SChoice(748, 172, 78, "Neon noir", sv_theme_preset == 1, set_value, 66001)
                    SChoice(826, 172, 78, "Concrete", sv_theme_preset == 2, set_value, 66002)
                    SChoice(904, 172, 78, "Gunmetal", sv_theme_preset == 3, set_value, 66003)
                    SChoice(982, 172, 78, "Alien", sv_theme_preset == 4, set_value, 66004)
                    SChoice(1060, 172, 78, "Titanium", sv_theme_preset == 5, set_value, 66005)
                    SRevert(640, 186, sv_theme_preset != df_theme_preset, set_value, 66000 + df_theme_preset)
                }
                group {
                    show: sv_theme_preset > 5.5
                    move: 0, gy_0_2 - 216
                    text "CUSTOM — CHANGED ON THE COLOUR PAGE" { at: 274, 230; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.ember }
                }
                group {
                    show: true
                    move: 0, gy_0_3 - 244
                    SRow(244, "Colours from", "Your wallpaper, or mooi's own teal and orange", true, "", 550, true)
                    STrack(874, 260, 264)
                    SChoice(874, 260, 132, "mooi default", theme_wallpaper == 0, set_value, 21000)
                    SChoice(1006, 260, 132, "Wallpaper", theme_wallpaper == 1, set_value, 21001)
                    SRevert(844, 274, sv_theme_source != df_theme_source, set_value, 21000 + df_theme_source)
                }
                group {
