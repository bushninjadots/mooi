                    SRevert(638, 1012, sv_desktop_blur != df_desktop_blur, set_value, 60000 + df_desktop_blur)
                }
                group {
                    show: dk_manage
                    move: 0, gy_7_16 - 1042
                    SRow(1042, "Dim the others", "Shade every window but the one you are using", true, "", 768, true)
                    SToggle(1092, 1060, dk_dim, set_value, 36, "desktop.dim_inactive")
                    SRevert(1062, 1072, sv_desktop_dim_inactive != df_desktop_dim_inactive, set_value, 36000 + df_desktop_dim_inactive)
                }
                group {
                    show: dk_manage
                    move: 0, gy_7_c4 - 1124
                    SCard(1124, gc_7_4, "Tiling")
                }
                group {
                    show: dk_manage
                    move: 0, gy_7_18 - 1168
                    SRow(1168, "Layout", "How tiled windows are arranged", true, "", 344, false)
                    STrack(668, 1184, 470)
                    SChoice(668, 1184, 94, "Keep mine", sv_desktop_layout == 0, set_value, 53000)
                    SChoice(762, 1184, 94, "Dwindle", sv_desktop_layout == 1, set_value, 53001)
                    SChoice(856, 1184, 94, "Master", sv_desktop_layout == 2, set_value, 53002)
                    SChoice(950, 1184, 94, "Scrolling", sv_desktop_layout == 3, set_value, 53003)
                    SChoice(1044, 1184, 94, "Monocle", sv_desktop_layout == 4, set_value, 53004)
                    SRevert(638, 1198, sv_desktop_layout != df_desktop_layout, set_value, 53000 + df_desktop_layout)
                }
                group {
                    show: (dk_manage) and (sv_desktop_layout == 0 or sv_desktop_layout == 3)
                    move: 0, gy_7_19 - 1228
                    SRow(1228, "Column width", "Scrolling layout: a new column's width", true, "", 404, true)
                    SSlider(728, 1244, 330, sv_desktop_column, 91, set_value, 54, "Column width", pick(sv_desktop_column == 0, "{sv_desktop_column + 9, 0}%", "KEEP"), true)
                    SRevert(698, 1258, sv_desktop_column != df_desktop_column, set_value, 54000 + df_desktop_column)
                }
                group {
                    show: (dk_manage) and (sv_desktop_layout == 0 or sv_desktop_layout == 3)
                    move: 0, gy_7_20 - 1288
                    SRow(1288, "Focused column", "Scrolling layout: bring it into view, or centre it", true, "", 418, true)
                    STrack(742, 1304, 396)
                    SChoice(742, 1304, 132, "Keep mine", sv_desktop_column_fit == 0, set_value, 55000)
                    SChoice(874, 1304, 132, "Fit", sv_desktop_column_fit == 1, set_value, 55001)
                    SChoice(1006, 1304, 132, "Centre", sv_desktop_column_fit == 2, set_value, 55002)
                    SRevert(712, 1318, sv_desktop_column_fit != df_desktop_column_fit, set_value, 55000 + df_desktop_column_fit)
                }
            }
            group {
                show: set_tab == 8
                group {
                    show: not dk_manage
                    move: 0, gy_8_0 - 112
                    text "TURN ON LET MOOI STYLE WINDOWS (WINDOWS PAGE) TO SET THESE" { at: 274, 126; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.ember }
                }
                group {
                    show: dk_manage
                    move: 0, gy_8_c0 - 140
                    SCard(140, gc_8_0, "Touchpad")
                }
                group {
                    show: dk_manage
                    move: 0, gy_8_2 - 184
                    SRow(184, "Direction", "Natural moves the page with your fingers", true, "", 418, false)
                    STrack(742, 200, 396)
                    SChoice(742, 200, 132, "Keep mine", sv_desktop_touchpad_natural == 0, set_value, 56000)
                    SChoice(874, 200, 132, "Natural", sv_desktop_touchpad_natural == 1, set_value, 56001)
                    SChoice(1006, 200, 132, "Classic", sv_desktop_touchpad_natural == 2, set_value, 56002)
                    SRevert(712, 214, sv_desktop_touchpad_natural != df_desktop_touchpad_natural, set_value, 56000 + df_desktop_touchpad_natural)
                }
                group {
                    show: dk_manage
                    move: 0, gy_8_3 - 244
                    SRow(244, "Speed", "How far a swipe scrolls", true, "", 404, true)
                    SSlider(728, 260, 330, sv_desktop_touchpad_speed, 196, set_value, 57, "Speed", pick(sv_desktop_touchpad_speed == 0, "{(sv_desktop_touchpad_speed + 4) / 100, 2}×", "KEEP"), true)
                    SRevert(698, 274, sv_desktop_touchpad_speed != df_desktop_touchpad_speed, set_value, 57000 + df_desktop_touchpad_speed)
                }
                group {
                    show: dk_manage
                    move: 0, gy_8_c1 - 326
                    SCard(326, gc_8_1, "Mouse")
                }
                group {
                    show: dk_manage
                    move: 0, gy_8_5 - 370
                    SRow(370, "Direction", "Natural or the wheel's classic direction", true, "", 418, false)
                    STrack(742, 386, 396)
                    SChoice(742, 386, 132, "Keep mine", sv_desktop_mouse_natural == 0, set_value, 58000)
                    SChoice(874, 386, 132, "Natural", sv_desktop_mouse_natural == 1, set_value, 58001)
                    SChoice(1006, 386, 132, "Classic", sv_desktop_mouse_natural == 2, set_value, 58002)
                    SRevert(712, 400, sv_desktop_mouse_natural != df_desktop_mouse_natural, set_value, 58000 + df_desktop_mouse_natural)
                }
                group {
                    show: dk_manage
                    move: 0, gy_8_6 - 430
                    SRow(430, "Speed", "How far a notch of the wheel scrolls", true, "", 404, true)
                    SSlider(728, 446, 330, sv_desktop_mouse_speed, 196, set_value, 59, "Speed", pick(sv_desktop_mouse_speed == 0, "{(sv_desktop_mouse_speed + 4) / 100, 2}×", "KEEP"), true)
                    SRevert(698, 460, sv_desktop_mouse_speed != df_desktop_mouse_speed, set_value, 59000 + df_desktop_mouse_speed)
                }
            }
            group {
                show: set_tab == 9
                group {
                    show: true
                    move: 0, gy_9_c0 - 112
                    SCard(112, gc_9_0, "Shortcuts")
                }
                group {
                    show: true
                    move: 0, gy_9_1 - 156
                    SRow(156, "Search", "Open search (starts mooi if it is not running)", true, "", 330, false)
                    SKeys(700, 172, pick(capturing == 0, key_search, cap_text), capturing == 0)
                    SButton(1042, 171, 96, pick(capturing == 0, "Change", "Cancel"), key_change, 0, capturing == 0)
                    text key_clash_search { at: 700, 208; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.ember }
                    SRow(216, "Window actions", "Float, pin, fullscreen or close the focused window", true, "", 330, true)
                    SKeys(700, 232, pick(capturing == 1, key_window, cap_text), capturing == 1)
                    SButton(1042, 231, 96, pick(capturing == 1, "Change", "Cancel"), key_change, 1, capturing == 1)
                    text key_clash_window { at: 700, 268; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.ember }
                    SRow(276, "Workspace Atlas", "Every window, grouped by workspace", true, "", 330, true)
                    SKeys(700, 292, pick(capturing == 2, key_atlas, cap_text), capturing == 2)
                    SButton(1042, 291, 96, pick(capturing == 2, "Change", "Cancel"), key_change, 2, capturing == 2)
                    text key_clash_atlas { at: 700, 328; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.ember }
                    SRow(336, "System controls", "Volume, brightness, network, Bluetooth", true, "", 330, true)
                    SKeys(700, 352, pick(capturing == 3, key_system, cap_text), capturing == 3)
                    SButton(1042, 351, 96, pick(capturing == 3, "Change", "Cancel"), key_change, 3, capturing == 3)
                    text key_clash_system { at: 700, 388; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.ember }
                    SRow(396, "Settings", "This window", true, "", 330, true)
                    SKeys(700, 412, pick(capturing == 4, key_settings, cap_text), capturing == 4)
                    SButton(1042, 411, 96, pick(capturing == 4, "Change", "Cancel"), key_change, 4, capturing == 4)
                    text key_clash_settings { at: 700, 448; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.ember }
                    SRow(456, "Edit the bar", "Move, group and hide the bar's modules", true, "", 330, true)
                    SKeys(700, 472, pick(capturing == 5, key_edit, cap_text), capturing == 5)
                    SButton(1042, 471, 96, pick(capturing == 5, "Change", "Cancel"), key_change, 5, capturing == 5)
                    text key_clash_edit { at: 700, 508; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.ember }
                    SRow(516, "Stop mooi", "Back to ArchEclipse", true, "", 330, true)
                    SKeys(700, 532, pick(capturing == 6, key_stop, cap_text), capturing == 6)
                    SButton(1042, 531, 96, pick(capturing == 6, "Change", "Cancel"), key_change, 6, capturing == 6)
                    text key_clash_stop { at: 700, 568; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.ember }
                }
            }
            group {
                show: set_tab == 10
                group {
                    show: true
                    move: 0, gy_10_c0 - 112
                    SCard(112, gc_10_0, "Notifications and tray")
                }
                group {
                    show: true
                    move: 0, gy_10_1 - 156
                    SRow(156, "mooi shows notifications", "When it runs alone, always, or never", true, "", 418, false)
                    STrack(742, 172, 396)
                    SChoice(742, 172, 132, "On its own", note_server == 0, set_value, 27000)
                    SChoice(874, 172, 132, "Always", note_server == 1, set_value, 27001)
                    SChoice(1006, 172, 132, "Never", note_server == 2, set_value, 27002)
                    SRevert(712, 186, sv_notifications_server != df_notifications_server, set_value, 27000 + df_notifications_server)
                }
                group {
                    show: true
                    move: 0, gy_10_2 - 216
                    SRow(216, "Tray icons", "In the palette's colours, or as the apps draw them", true, "", 550, true)
                    STrack(874, 232, 264)
                    SChoice(874, 232, 132, "Themed", tray_style == 0, set_value, 26000)
                    SChoice(1006, 232, 132, "Original", tray_style == 1, set_value, 26001)
                    SRevert(844, 246, sv_tray_style != df_tray_style, set_value, 26000 + df_tray_style)
                }
                group {
                    show: true
                    move: 0, gy_10_c1 - 298
                    SCard(298, gc_10_1, "Windows and the Atlas")
                }
                group {
                    show: true
                    move: 0, gy_10_4 - 342
                    SRow(342, "Atlas previews", "Live pictures of windows in the Atlas", true, "", 768, false)
                    SToggle(1092, 360, previews, set_value, 28, "atlas.previews")
                    SRevert(1062, 372, sv_atlas_previews != df_atlas_previews, set_value, 28000 + df_atlas_previews)
                }
                group {
                    show: true
                    move: 0, gy_10_5 - 402
                    SRow(402, "Confirm before closing", "Ask once more before closing a window", true, "", 768, true)
                    SToggle(1092, 420, confirm_close, set_value, 29, "island.confirm_close")
                    SRevert(1062, 432, sv_island_confirm_close != df_island_confirm_close, set_value, 29000 + df_island_confirm_close)
                }
                group {
                    show: true
                    move: 0, gy_10_6 - 462
                    SRow(462, "Follow a window you move", "Moving a window to a workspace takes you there too", true, "", 768, true)
                    SToggle(1092, 480, sv_island_follow_on_send, set_value, 68, "island.follow_on_send")
                    SRevert(1062, 492, sv_island_follow_on_send != df_island_follow_on_send, set_value, 68000 + df_island_follow_on_send)
                }
                group {
                    show: true
                    move: 0, gy_10_c2 - 544
                    SCard(544, gc_10_2, "Comfort")
                }
                group {
                    show: true
                    move: 0, gy_10_8 - 588
                    SRow(588, "Search results", "How many results search shows", true, "", 404, false)
                    SSlider(728, 604, 330, sv_command_max_results, 7, set_value, 69, "Search results", "{sv_command_max_results + 3, 0}", true)
                    SRevert(698, 618, sv_command_max_results != df_command_max_results, set_value, 69000 + df_command_max_results)
                }
                group {
                    show: true
                    move: 0, gy_10_9 - 648
                    SRow(648, "Reduce motion", "No springs or travel; applies the next time mooi starts", true, "", 768, true)
                    SToggle(1092, 666, sv_motion_reduced, set_value, 67, "motion.reduced")
                    SRevert(1062, 678, sv_motion_reduced != df_motion_reduced, set_value, 67000 + df_motion_reduced)
                }
            }
            }
            // Search: what matches, from every page; a press goes to it
            group {
                show: searching
                box { from: 233, 96 + set_scroll_s; size: screen.width - 233, screen.height - 96; color: mix(fl.ground, fl.steel_900, 0.6) }
                text "{set_hits, 0} MATCHING · ENTER OPENS THE FIRST · ESC CLEARS" { at: 274, 120 + set_scroll_s; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.ember }
                for r in set_results { SResult(r, 140 + set_scroll_s + r.index * 64, set_jump) }
            }
        }
        // The header, over the scrolled rows: the page's name, what it is for, and its Reset.
        box { from: 233, 0; size: screen.width - 233, 96; color: mix(fl.ground, fl.steel_900, 0.6) }
        text pick(set_tab, "Quick settings", "Colour", "The bar", "Layout", "Workspaces", "Media", "Screen frame", "Windows", "Input", "Keys", "System") { at: 256, 40; anchor: left center; size: 26; weight: 600; family: "Exo 2"; color: fl.phos }
        text pick(set_tab, "The few choices that change the most; every other page holds the rest", "One palette for everything mooi draws: the bar, its islands and panels, your window borders", "A style sets the surface and the edges at once; change any of them and it reads Custom", "Every module, where it sits. Select one, then move it, group it or send it anywhere", "The switcher on the bar", "The player on the bar", "A band round the screen, the bar its top edge; it can move with the music", "Hyprland's windows, styled by mooi so they match. A slider's lowest step keeps your own", "How the touchpad and the mouse scroll. A speed's lowest step keeps your own", "mooi's keyboard shortcuts. Press Change, then the new keys", "Notifications, the islands and comfort") { at: 256, 70; anchor: left center; size: 12; family: "Exo 2"; color: fl.muted; width: 700; lines: 1 }
        box { from: 233, 95; size: screen.width - 233, 1; color: fl.trace_dim }
        group {
            show: not searching
            SButton(screen.width - 236, 30, 164, pick(rs_armed == set_tab, "Reset this page", "Press again to reset"), set_reset, set_tab, rs_armed == set_tab)
        }
        zone box set_close { from: screen.width - 52, 30; size: 32, 32; corner: 6; cursor: pointer; role: button; label: "Close the settings" }
        box { from: screen.width - 52, 30; size: 32, 32; corner: 6; color: fl.hull_raised; opacity: set_close.hover }
        line { from: screen.width - 42, 40; to: screen.width - 30, 52; width: 1.5; color: mix(fl.muted, fl.ember, set_close.hover) }
        line { from: screen.width - 30, 40; to: screen.width - 42, 52; width: 1.5; color: mix(fl.muted, fl.ember, set_close.hover) }
        on press set_close { emit set_action(9) }
    }
}
