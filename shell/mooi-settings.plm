    fact fxp3_b = 0.5
    text fxp3_hex = "#7FCFB6"
    text fxp3_in = ""
    // The shaders' own three colours (desktop.fx_phos/ember/trace), the `custom` light: each typed
    // as #rrggbb into its field, read back and saved by the logic (set_fxcolour: 1, 2 or 3).
    event set_fxcolour ->
    text kitty_shader_now = ""
    event set_kitty_shader_file ->
    fact lay_c1 = true
    fact lay_c2 = true
    fact lay_c3 = true
    fact lay_c4 = true
    fact lay_c5 = true
    fact lay_c6 = true
    fact lay_c7 = true
    fact lay_c8 = true
    fact lz0_y = 0
    fact lz0_h = 90
    fact lz0_n = 0
    fact lz1_y = 0
    fact lz1_h = 90
    fact lz1_n = 0
