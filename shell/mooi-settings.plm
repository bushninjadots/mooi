    fact lz3_h = 90
    fact lz3_n = 0

    prop gy_0_c0 = 112 ~m.reflow
    follow gy_0_c0 = 112
    prop gy_0_1 = 156 ~m.reflow
    follow gy_0_1 = 112 + 44
