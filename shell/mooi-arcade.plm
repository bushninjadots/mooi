    fact cn_kind = 0
    fact cn_scale = 1
    fact c_bg_primary_r = 0.062745
    fact c_bg_primary_g = 0.078431
    fact c_bg_primary_b = 0.086275
    fact c_bg_secondary_r = 0.086275
    fact c_bg_secondary_g = 0.105882
    fact c_bg_secondary_b = 0.117647
    fact c_surface_primary_r = 0.098039
    fact c_surface_primary_g = 0.121569
    fact c_surface_primary_b = 0.133333
    fact c_surface_elevated_r = 0.133333
    fact c_surface_elevated_g = 0.160784
    fact c_surface_elevated_b = 0.176471
    fact c_border_subtle_r = 0.172549
    fact c_border_subtle_g = 0.207843
    fact c_border_subtle_b = 0.223529
    fact c_fg_primary_r = 0.890196
    fact c_fg_primary_g = 0.913725
    fact c_fg_primary_b = 0.921569
    fact c_fg_secondary_r = 0.639216
    fact c_fg_secondary_g = 0.690196
    fact c_fg_secondary_b = 0.709804
    fact c_fg_muted_r = 0.541176
    fact c_fg_muted_g = 0.592157
    fact c_fg_muted_b = 0.611765
    fact c_accent_primary_r = 0.650980
    fact c_accent_primary_g = 0.952941
    fact c_accent_primary_b = 0.819608
    fact c_accent_secondary_r = 1.000000
    fact c_accent_secondary_g = 0.572549
    fact c_accent_secondary_b = 0.372549
    fact c_status_ok_r = 0.650980
    fact c_status_ok_g = 0.952941
    fact c_status_ok_b = 0.819608
    fact c_status_error_r = 1.000000
    fact c_status_error_g = 0.572549
    fact c_status_error_b = 0.372549
    fact c_focus_ring_r = 0.650980
    fact c_focus_ring_g = 0.952941
    fact c_focus_ring_b = 0.819608
    fact c_selection_bg_r = 0.164706
    fact c_selection_bg_g = 0.227451
    fact c_selection_bg_b = 0.211765
    fact st_offset = 0
    fact st_notch = false
    fact bar_rail = true
    fact st_height = 30
    fact st_radius = 8
    fact st_res = 46
    fact st_glow = 1

    // ── where it is: 0 shut · 1 the picker · 2 Snake (more games take the next numbers) ──
    fact ac_page = 0
    prop ac_k = 0 ~calm
    follow ac_k = if(ac_page > 0, 1, 0)
    fact ac_sel = 0
    model gm max 6 { name: text; glyph: text; line: text; best: text; ready: bool }
    // ── Snake ──
    model sn max 504 { x: number; y: number }
    fact sn_fx = -1
    fact sn_fy = -1
    fact sn_hx = 0
    fact sn_hy = 0
    fact sn_state = 0      // 0 ready · 1 playing · 2 paused · 3 over · 4 won
    text sn_score = "0"
    text sn_best = "0"

    event ac_cmd ->       // from `mooi arcade`: 1 open (or close) · 0 close
    event ac_key ->       // a key while the arcade holds the keyboard
    event ac_pick ->      // a game's card pressed

    surface arcade {
        size: full, full
        anchor: top
        level: overlay
        reserve: -1
        keyboard: exclusive while ac_page > 0
        rate: 60, 1 while ac_page == 0 and ac_k < 0.01
        let px = (arcade.width - 860) / 2
        let py = (arcade.height - 600) / 2 + 30 * (1 - ac_k)
        group { show: ac_k > 0.005
            box { from: 0, 0; size: arcade.width, arcade.height; color: #000000; opacity: 0.55 * ac_k }
            zone box acz_out { from: 0, 0; size: arcade.width, arcade.height; role: button; label: "Close the arcade"; show: ac_page > 0 }
            on press acz_out { emit ac_cmd(0) }
            group { opacity: ac_k
                body { color: fl.ground; shadow: 0, 16, 40, 0.5
                    box { from: px, py; size: 860, 600; corner: 22 } }
                box { from: px, py; size: 860, 600; corner: 22; stroke: 1.2; color: fl.trace }
                zone box acz_in { from: px, py; size: 860, 600; role: region; label: "Arcade"; show: ac_page > 0 }
                text "󰊴" { at: px + 34, py + 34; anchor: center; size: 18; family: "CaskaydiaCove Nerd Font"; color: fl.phos }
                text pick(ac_page, "", "Arcade", "Snake") { at: px + 56, py + 34; anchor: left center; size: 16; weight: 700; family: "Exo 2"; color: fl.engrave }
                text if(ac_page == 1, "← → CHOOSE · RETURN PLAYS · ESC CLOSES", "ESC BACK TO THE GAMES") { at: px + 860 - 28, py + 34; anchor: right center; align: right; size: 9; family: "Share Tech Mono"; color: fl.muted }
                line { from: px + 20, py + 58; to: px + 860 - 20, py + 58; width: 1; color: fl.trace_dim }
                group { show: ac_page == 1
                    for g in gm {
                        let gx = px + 20 + g.index * (260.0 + 20)
                        let gy = py + 110
                        let on = g.index == ac_sel
                        box { from: gx, gy; size: 260.0, 300; corner: 18; color: fl.well; opacity: if(on, 1, 0.7) }
                        box { from: gx, gy; size: 260.0, 300; corner: 18; stroke: if(on, 2, 1); color: if(on, fl.phos, fl.trace_dim) }
                        text g.glyph { at: gx + 260.0 / 2, gy + 96; anchor: center; size: 64; family: "CaskaydiaCove Nerd Font"; color: if(g.ready, fl.phos, fl.muted) }
                        text g.name { at: gx + 260.0 / 2, gy + 178; anchor: center; align: center; size: 18; weight: 700; family: "Exo 2"; color: fl.engrave }
                        text g.line { at: gx + 260.0 / 2, gy + 214; anchor: center; align: center; size: 11; family: "Exo 2"; color: fl.muted; width: 260.0 - 32; lines: 2 }
                        text g.best { at: gx + 260.0 / 2, gy + 268; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(g.ready, fl.phos, fl.muted) }
                        zone box acz_g { from: gx, gy; size: 260.0, 300; corner: 18; cursor: pointer; role: button; label: "{g.name}"; show: ac_page == 1 }
                        on press acz_g { emit ac_pick(g.index) }
                    }
                }
                group { show: ac_page == 2
                    box { from: px + (860 - 728) / 2 - 6, py + 80 - 6; size: 728 + 12, 468 + 12; corner: 12; color: fl.well }
                    for s in sn {
                        box { from: px + (860 - 728) / 2 + s.x * 26 + 2, py + 80 + s.y * 26 + 2; size: 22, 22; corner: 6; color: fl.phos; opacity: max(0.35, 1 - s.index * 0.02) }
                    }
                    box { from: px + (860 - 728) / 2 + sn_hx * 26 + 1, py + 80 + sn_hy * 26 + 1; size: 24, 24; corner: 7; color: fl.phos; show: sn.count > 0 }
                    group { show: sn_fx >= 0
                        ellipse { at: px + (860 - 728) / 2 + sn_fx * 26 + 13.0, py + 80 + sn_fy * 26 + 13.0; radius: 9.0; color: fl.ember } }
                    text "SCORE {sn_score}" { at: px + (860 - 728) / 2, py + 600 - 34; anchor: left center; size: 12; weight: 700; family: "Share Tech Mono"; color: fl.engrave }
                    text "BEST {sn_best}" { at: px + (860 - 728) / 2 + 728, py + 600 - 34; anchor: right center; align: right; size: 12; weight: 700; family: "Share Tech Mono"; color: fl.muted }
                    group { show: sn_state != 1
                        box { from: px + (860 - 728) / 2 - 6, py + 80 - 6; size: 728 + 12, 468 + 12; corner: 12; color: fl.ground; opacity: 0.72 }
                        text pick(sn_state, "Ready", "", "Paused", "Game over", "You filled the board") { at: px + 860 / 2, py + 80 + 468 / 2 - 16; anchor: center; align: center; size: 26; weight: 700; family: "Exo 2"; color: if(sn_state == 3, fl.ember, fl.phos) }
                        text if(sn_state == 2, "SPACE OR P GOES ON", "ARROWS OR WASD STEER · SPACE STARTS") { at: px + 860 / 2, py + 80 + 468 / 2 + 22; anchor: center; align: center; size: 11; family: "Share Tech Mono"; color: fl.muted } }
                }
            }
        }
        on key Escape while ac_page > 0 { emit ac_key(27) }
        on key Return while ac_page > 0 { emit ac_key(13) }
        on key Up while ac_page > 0 { emit ac_key(38) }
        on key Down while ac_page > 0 { emit ac_key(40) }
        on key Left while ac_page > 0 { emit ac_key(37) }
        on key Right while ac_page > 0 { emit ac_key(39) }
        on key space while ac_page > 0 { emit ac_key(32) }
        on key w while ac_page > 0 { emit ac_key(87) }
        on key a while ac_page > 0 { emit ac_key(65) }
        on key s while ac_page > 0 { emit ac_key(83) }
        on key d while ac_page > 0 { emit ac_key(68) }
        on key p while ac_page > 0 { emit ac_key(80) }
    }
}
