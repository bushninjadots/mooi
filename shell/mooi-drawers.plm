                    curve (drawers.width + 380 * (1 - dr_rk)) - 22, dr_rtop via (drawers.width + 380 * (1 - dr_rk)) - 0, dr_rtop
                    line (drawers.width + 380 * (1 - dr_rk)) - 362, dr_rtop
                    curve (drawers.width + 380 * (1 - dr_rk)) - 380, dr_rtop + 18 via (drawers.width + 380 * (1 - dr_rk)) - 380, dr_rtop
                    line (drawers.width + 380 * (1 - dr_rk)) - 380, dr_rtop + 600 - 18
