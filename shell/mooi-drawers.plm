                    text dr_qby { at: (-380 * (1 - dr_lk)) + 350, dr_top + 584; anchor: right center; align: right; size: 9; family: "Share Tech Mono"; color: fl.muted; width: 220; lines: 1 } }
                // the foot: refresh, and the key that opens it
                text "󰑐" { at: (-380 * (1 - dr_lk)) + 36, dr_top + 614; anchor: center; size: 13; family: "CaskaydiaCove Nerd Font"; color: if(drz_rf.hover, fl.phos, fl.muted) }
                zone box drz_rf { from: (-380 * (1 - dr_lk)) + 22, dr_top + 600; size: 28, 28; cursor: pointer; role: button; label: "Ask again"; show: dr_open == 1 }
