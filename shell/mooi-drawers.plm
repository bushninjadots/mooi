                    text "Update mooi" { at: (-380 * (1 - dr_lk)) + 302, dr_top + 466; anchor: center; align: center; size: 8; weight: 700; family: "Share Tech Mono"; color: if(drz_sf.hover, fl.phos, fl.engrave) } }
                zone box drz_sf { from: (-380 * (1 - dr_lk)) + 260, dr_top + 455; size: 84, 22; corner: 11; cursor: pointer; role: button; label: "Bring mooi up to date"; show: dr_open == 1 and dr_selfn }
