                }
                line { from: (drawers.width - 380 + 380 * (1 - dr_rk)) + 20, dr_rtop + if(dr_ppd, 424, 372) - 10; to: (drawers.width - 380 + 380 * (1 - dr_rk)) + 360, dr_rtop + if(dr_ppd, 424, 372) - 10; width: 1; color: fl.trace_dim }
                text "Notifications ({dr_ncount, 0})" { at: (drawers.width - 380 + 380 * (1 - dr_rk)) + 24, dr_rtop + if(dr_ppd, 424, 372) + 8; anchor: left center; size: 11; weight: 700; family: "Exo 2"; color: fl.engrave }
                box { from: (drawers.width - 380 + 380 * (1 - dr_rk)) + 204, dr_rtop + if(dr_ppd, 424, 372) - 5; size: 72, 26; corner: 13; color: fl.phos; opacity: if(dr_silent, 0.22, if(drz_sl.hover, 0.12, 0.04)) }
                box { from: (drawers.width - 380 + 380 * (1 - dr_rk)) + 204, dr_rtop + if(dr_ppd, 424, 372) - 5; size: 72, 26; corner: 13; stroke: 1; color: if(dr_silent, fl.phos, fl.trace_dim) }
                text if(dr_silent, "󰂛", "󰂚") { at: (drawers.width - 380 + 380 * (1 - dr_rk)) + 220, dr_rtop + if(dr_ppd, 424, 372) + 8; anchor: center; size: 12; family: "CaskaydiaCove Nerd Font"; color: if(dr_silent, fl.phos, fl.engrave) }
                text "Silent" { at: (drawers.width - 380 + 380 * (1 - dr_rk)) + 248, dr_rtop + if(dr_ppd, 424, 372) + 8; anchor: center; align: center; size: 8; weight: 700; family: "Share Tech Mono"; color: if(dr_silent, fl.phos, fl.muted); width: 44; lines: 1 }
                zone box drz_sl { from: (drawers.width - 380 + 380 * (1 - dr_rk)) + 204, dr_rtop + if(dr_ppd, 424, 372) - 5; size: 72, 26; corner: 13; cursor: pointer; role: button; label: "Silent"; show: dr_open == 2 }
                on press drz_sl { emit dr_nsilent }
                box { from: (drawers.width - 380 + 380 * (1 - dr_rk)) + 284, dr_rtop + if(dr_ppd, 424, 372) - 5; size: 72, 26; corner: 13; color: fl.phos; opacity: if(false, 0.22, if(drz_cl.hover, 0.12, 0.04)) }
                box { from: (drawers.width - 380 + 380 * (1 - dr_rk)) + 284, dr_rtop + if(dr_ppd, 424, 372) - 5; size: 72, 26; corner: 13; stroke: 1; color: if(false, fl.phos, fl.trace_dim) }
                text "󰆴" { at: (drawers.width - 380 + 380 * (1 - dr_rk)) + 300, dr_rtop + if(dr_ppd, 424, 372) + 8; anchor: center; size: 12; family: "CaskaydiaCove Nerd Font"; color: if(false, fl.phos, fl.engrave) }
                text "Clear all" { at: (drawers.width - 380 + 380 * (1 - dr_rk)) + 328, dr_rtop + if(dr_ppd, 424, 372) + 8; anchor: center; align: center; size: 8; weight: 700; family: "Share Tech Mono"; color: if(false, fl.phos, fl.muted); width: 44; lines: 1 }
                zone box drz_cl { from: (drawers.width - 380 + 380 * (1 - dr_rk)) + 284, dr_rtop + if(dr_ppd, 424, 372) - 5; size: 72, 26; corner: 13; cursor: pointer; role: button; label: "Clear all"; show: dr_open == 2 }
                on press drz_cl { emit dr_nclear }
                text "All caught up" { at: (drawers.width - 380 + 380 * (1 - dr_rk)) + 190.0, dr_rtop + if(dr_ppd, 424, 372) + 56; anchor: center; align: center; size: 11; family: "Exo 2"; color: fl.muted; show: nt.count == 0 }
                for n in nt {
                    let ny = dr_rtop + if(dr_ppd, 424, 372) + 28 + n.index * 64
                    box { from: (drawers.width - 380 + 380 * (1 - dr_rk)) + 16, ny; size: 348, 58; corner: 12; color: fl.well; opacity: if(drz_n.hover, 1, 0.8); show: n.index < 2 }
                    text n.app { at: (drawers.width - 380 + 380 * (1 - dr_rk)) + 30, ny + 16; anchor: left center; size: 9; weight: 700; family: "Share Tech Mono"; color: fl.muted; width: 200; lines: 1; show: n.index < 2 }
                    text n.ago { at: (drawers.width - 380 + 380 * (1 - dr_rk)) + 324, ny + 16; anchor: right center; align: right; size: 9; family: "Share Tech Mono"; color: fl.muted; width: 60; lines: 1; show: n.index < 2 }
                    text n.title { at: (drawers.width - 380 + 380 * (1 - dr_rk)) + 30, ny + 38; anchor: left center; size: 11; weight: 700; family: "Exo 2"; color: fl.engrave; width: 304; lines: 1; show: n.index < 2 }
                    text "×" { at: (drawers.width - 380 + 380 * (1 - dr_rk)) + 346, ny + 16; anchor: center; size: 15; family: "Exo 2"; color: if(drz_nx.hover, fl.engrave, fl.muted); show: n.index < 2 }
                    zone box drz_n { from: (drawers.width - 380 + 380 * (1 - dr_rk)) + 16, ny; size: 310, 58; corner: 12; cursor: pointer; role: button; label: "{n.app}: {n.title}"; show: dr_open == 2 and n.index < 2 }
                    on press drz_n { emit dr_nact(n.index * 10) }
                    zone box drz_nx { from: (drawers.width - 380 + 380 * (1 - dr_rk)) + 328, ny + 2; size: 36, 28; cursor: pointer; role: button; label: "Dismiss"; show: dr_open == 2 and n.index < 2 }
                    on press drz_nx { emit dr_nact(n.index * 10 + 9) }
                }
                text "SUPER+N · ESC CLOSES" { at: (drawers.width - 380 + 380 * (1 - dr_rk)) + 354, dr_rtop + 578; anchor: right center; align: right; size: 8; family: "Share Tech Mono"; color: fl.muted; opacity: 0.7 }
            }
        }
    }
}
