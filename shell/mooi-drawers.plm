    fact st_offset = 0
    fact st_notch = false
    fact bar_rail = true
    fact st_height = 30
    fact st_radius = 8
    fact st_res = 46
    fact st_glow = 1

    // ── which drawer is out: 0 none · 1 the Dashboard (left) · 2 the notices (right) ──
    fact dr_open = 0
    fact dr_edge = false      // touching the side opens it (Settings → Side drawers)
    fact dr_lon = true
    fact dr_ron = true      // each drawer may be off
    prop dr_lk = 0 ~calm
    follow dr_lk = if(dr_open == 1, 1, 0)
    prop dr_rk = 0 ~calm
    follow dr_rk = if(dr_open == 2, 1, 0)
    fact dr_top = 220      // where the drawers start: centred on the screen by the logic
    fact dr_rtop = 280
    // ── the Dashboard: GitHub ──
    fact dr_gh = false     // GitHub answered
    text dr_ghmsg = "Asking GitHub…"
    text dr_name = ""
    text dr_login = ""
    text dr_bio = ""
    text dr_av = ""
    image dr_avi = from dr_av, 96, 96
    fact dr_avon = false
    text dr_n1 = "0"
    text dr_n2 = "0"
    text dr_n3 = "0"
    text dr_n4 = "0"
    fact dr_top_on = false
    text dr_tname = ""
    text dr_tdesc = ""
    text dr_tmeta = ""
    model hm max 182 { v: number }
    fact dr_github = true   // the GitHub part shows (Settings)
    // ── the Dashboard: the system and a quote ──
    text dr_upd = "Not checked yet"
    fact dr_updn = 0
    text dr_self = ""
    fact dr_selfn = false   // D278: mooi itself has something newer to bring in
    text dr_quote = ""
    text dr_qby = ""
    fact dr_quote_on = true
    // ── the notices ──
    model nt max 5 { app: text; title: text; body: text; ago: text; act: text }
    fact dr_ncount = 0
    fact dr_silent = false
    // ── the control centre (D299): its tiles, sliders and the power profile ──
    fact dr_wifi = false
    fact dr_bt = false
    fact dr_nl = false
    fact dr_caf = false
    fact dr_game = false
    fact dr_batlow = false
    text dr_wifit = ""
    text dr_btt = ""
    text dr_nlt = ""
    text dr_caft = ""
    text dr_gamet = ""
    text dr_batt = ""
    text dr_cctime = ""
    fact dr_bri = 0
    fact dr_vol = 0
    fact dr_mic = 0
    fact dr_hasbri = false
    fact dr_ppd = false
    fact dr_prof = 1

    event dr_cmd ->       // from `mooi drawer …`: 1 the Dashboard · 2 the notices · 0 close
    event dr_key ->       // a key while a drawer holds the keyboard
    event dr_upd_go ->    // Update: the system's packages in a terminal
    event dr_ghweb ->     // the profile in the browser
    event dr_self_go ->   // D278: bring mooi up to date, in a terminal
    event dr_nact ->      // a notice pressed: row * 10 (its default), row * 10 + 9 (dismiss)
    event dr_nclear ->
    event dr_nsilent ->
    event dr_refresh ->
    event dr_tile ->      // D299: a control-centre tile: 1 Wi-Fi · 2 Bluetooth · 3 night light · 4 caffeine · 5 game mode · 6 battery
    event dr_sl ->        // a slider: which * 2000 + level (0 … 1000): 0 brightness · 1 volume · 2 microphone
    event dr_prof_go ->   // the power profile: 0 saver · 1 balanced · 2 performance

    surface drawers {
        size: full, full
        anchor: top
        level: top
        reserve: -1
        keyboard: exclusive while dr_open > 0
        // still between openings: one frame a second is plenty
        rate: 60, 1 while dr_open == 0 and dr_lk < 0.01 and dr_rk < 0.01
        zone box drz_out { from: 0, 0; size: drawers.width, drawers.height; role: button; label: "Close the drawer"; show: dr_open > 0 }
        on press drz_out { emit dr_cmd(0) }
        zone box drz_le { from: 0, dr_top; size: 3, 640; show: dr_edge and dr_open == 0 and dr_lon }
        on enter drz_le { emit dr_cmd(1) }
        zone box drz_re { from: drawers.width - 3, dr_rtop; size: 3, 600; show: dr_edge and dr_open == 0 and dr_ron }
        on enter drz_re { emit dr_cmd(2) }
        on key escape while dr_open > 0 { emit dr_key(27) }
        // ── the Dashboard, out of the left side ──
        group { show: dr_lk > 0.005
            body { color: fl.ground
                path {
                    move (-380 * (1 - dr_lk)) + 0, dr_top - 22
                    curve (-380 * (1 - dr_lk)) + 22, dr_top via (-380 * (1 - dr_lk)) + 0, dr_top
                    line (-380 * (1 - dr_lk)) + 362, dr_top
                    curve (-380 * (1 - dr_lk)) + 380, dr_top + 18 via (-380 * (1 - dr_lk)) + 380, dr_top
                    line (-380 * (1 - dr_lk)) + 380, dr_top + 640 - 18
                    curve (-380 * (1 - dr_lk)) + 362, dr_top + 640 via (-380 * (1 - dr_lk)) + 380, dr_top + 640
                    line (-380 * (1 - dr_lk)) + 22, dr_top + 640
                    curve (-380 * (1 - dr_lk)) + 0, dr_top + 640 + 22 via (-380 * (1 - dr_lk)) + 0, dr_top + 640
                    close } }
            path { stroke: 1.2; color: fl.trace; opacity: 0.9
                move (-380 * (1 - dr_lk)) + 0, dr_top - 22
                curve (-380 * (1 - dr_lk)) + 22, dr_top via (-380 * (1 - dr_lk)) + 0, dr_top
                line (-380 * (1 - dr_lk)) + 362, dr_top
                curve (-380 * (1 - dr_lk)) + 380, dr_top + 18 via (-380 * (1 - dr_lk)) + 380, dr_top
                line (-380 * (1 - dr_lk)) + 380, dr_top + 640 - 18
                curve (-380 * (1 - dr_lk)) + 362, dr_top + 640 via (-380 * (1 - dr_lk)) + 380, dr_top + 640
                line (-380 * (1 - dr_lk)) + 22, dr_top + 640
                curve (-380 * (1 - dr_lk)) + 0, dr_top + 640 + 22 via (-380 * (1 - dr_lk)) + 0, dr_top + 640
            }
            // a press on the drawer itself is the drawer's, not the outside's
            zone box drz_left_in { from: 0, dr_top; size: 380, 640; role: region; label: "Dashboard"; show: dr_lk > 0.9 }
            group { opacity: dr_lk
                // GitHub: who, then four numbers
                group { show: dr_github
                    group { clip ellipse { at: (-380 * (1 - dr_lk)) + 48, dr_top + 44; radius: 24 }
                        ellipse { at: (-380 * (1 - dr_lk)) + 48, dr_top + 44; radius: 24; color: fl.hull_raised }
                        image dr_avi { at: (-380 * (1 - dr_lk)) + 24, dr_top + 20; size: 48, 48; fit: cover; show: dr_avon } }
                    ellipse { at: (-380 * (1 - dr_lk)) + 48, dr_top + 44; radius: 24; stroke: 1.5; color: fl.phos }
                    text dr_name { at: (-380 * (1 - dr_lk)) + 84, dr_top + 34; anchor: left center; size: 15; weight: 700; family: "Exo 2"; color: fl.engrave; width: 230; lines: 1 }
                    text dr_login { at: (-380 * (1 - dr_lk)) + 84, dr_top + 54; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.muted; width: 230; lines: 1 }
                    text "󰊤" { at: (-380 * (1 - dr_lk)) + 350, dr_top + 36; anchor: center; size: 18; family: "CaskaydiaCove Nerd Font"; color: if(drz_gw.hover, fl.phos, fl.muted) }
                    zone box drz_gw { from: (-380 * (1 - dr_lk)) + 334, dr_top + 20; size: 32, 32; cursor: pointer; role: link; label: "Open the profile on GitHub"; show: dr_open == 1 and dr_gh }
                    on press drz_gw { emit dr_ghweb }
                    text dr_bio { at: (-380 * (1 - dr_lk)) + 24, dr_top + 84; anchor: left center; size: 10; family: "Exo 2"; color: fl.muted; width: 332; lines: 1 }
                    text dr_ghmsg { at: (-380 * (1 - dr_lk)) + 190.0, dr_top + 120; anchor: center; align: center; size: 10; family: "Share Tech Mono"; color: fl.muted; width: 340; lines: 2; show: not dr_gh }
                    group { show: dr_gh
                        box { from: (-380 * (1 - dr_lk)) + 24.0, dr_top + 100; size: 161.0, 42; corner: 10; color: fl.well }
                        text "󰊢" { at: (-380 * (1 - dr_lk)) + 42.0, dr_top + 121; anchor: center; size: 14; family: "CaskaydiaCove Nerd Font"; color: fl.phos }
                        text dr_n1 { at: (-380 * (1 - dr_lk)) + 58.0, dr_top + 115; anchor: left center; size: 13; weight: 700; family: "Share Tech Mono"; color: fl.engrave }
                        text "CONTRIBUTIONS" { at: (-380 * (1 - dr_lk)) + 58.0, dr_top + 131; anchor: left center; size: 8; family: "Share Tech Mono"; color: fl.muted } }
                    group { show: dr_gh
                        box { from: (-380 * (1 - dr_lk)) + 195.0, dr_top + 100; size: 161.0, 42; corner: 10; color: fl.well }
                        text "󰉋" { at: (-380 * (1 - dr_lk)) + 213.0, dr_top + 121; anchor: center; size: 14; family: "CaskaydiaCove Nerd Font"; color: fl.phos }
                        text dr_n2 { at: (-380 * (1 - dr_lk)) + 229.0, dr_top + 115; anchor: left center; size: 13; weight: 700; family: "Share Tech Mono"; color: fl.engrave }
                        text "REPOSITORIES" { at: (-380 * (1 - dr_lk)) + 229.0, dr_top + 131; anchor: left center; size: 8; family: "Share Tech Mono"; color: fl.muted } }
                    group { show: dr_gh
                        box { from: (-380 * (1 - dr_lk)) + 24.0, dr_top + 150; size: 161.0, 42; corner: 10; color: fl.well }
                        text "󰋜" { at: (-380 * (1 - dr_lk)) + 42.0, dr_top + 171; anchor: center; size: 14; family: "CaskaydiaCove Nerd Font"; color: fl.phos }
                        text dr_n3 { at: (-380 * (1 - dr_lk)) + 58.0, dr_top + 165; anchor: left center; size: 13; weight: 700; family: "Share Tech Mono"; color: fl.engrave }
                        text "FOLLOWERS" { at: (-380 * (1 - dr_lk)) + 58.0, dr_top + 181; anchor: left center; size: 8; family: "Share Tech Mono"; color: fl.muted } }
                    group { show: dr_gh
                        box { from: (-380 * (1 - dr_lk)) + 195.0, dr_top + 150; size: 161.0, 42; corner: 10; color: fl.well }
                        text "󰓎" { at: (-380 * (1 - dr_lk)) + 213.0, dr_top + 171; anchor: center; size: 14; family: "CaskaydiaCove Nerd Font"; color: fl.phos }
                        text dr_n4 { at: (-380 * (1 - dr_lk)) + 229.0, dr_top + 165; anchor: left center; size: 13; weight: 700; family: "Share Tech Mono"; color: fl.engrave }
                        text "STARS" { at: (-380 * (1 - dr_lk)) + 229.0, dr_top + 181; anchor: left center; size: 8; family: "Share Tech Mono"; color: fl.muted } }
                    text "CONTRIBUTIONS · HALF A YEAR" { at: (-380 * (1 - dr_lk)) + 24, dr_top + 214; anchor: left center; size: 9; weight: 700; family: "Share Tech Mono"; color: fl.muted; show: dr_gh }
                    for d in hm {
                        let wk = floor(d.index / 7)
                        let dy = d.index - wk * 7
                        box { from: (-380 * (1 - dr_lk)) + 24 + wk * 13.3, dr_top + 226 + dy * 13.3; size: 11, 11; corner: 2.5; color: if(d.v > 0, fl.phos, fl.well); opacity: if(d.v > 0, 0.25 + 0.1875 * d.v, 0.8); show: dr_gh }
                    }
                    group { show: dr_gh and dr_top_on
                        box { from: (-380 * (1 - dr_lk)) + 24, dr_top + 326; size: 332, 62; corner: 12; color: fl.well }
                        text "󰓎" { at: (-380 * (1 - dr_lk)) + 42, dr_top + 344; anchor: center; size: 13; family: "CaskaydiaCove Nerd Font"; color: fl.flare }
                        text dr_tname { at: (-380 * (1 - dr_lk)) + 58, dr_top + 344; anchor: left center; size: 12; weight: 700; family: "Exo 2"; color: fl.engrave; width: 200; lines: 1 }
                        text dr_tmeta { at: (-380 * (1 - dr_lk)) + 344, dr_top + 344; anchor: right center; align: right; size: 9; family: "Share Tech Mono"; color: fl.muted; width: 110; lines: 1 }
