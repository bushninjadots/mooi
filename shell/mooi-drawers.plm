                text "Wi-Fi" { at: (drawers.width - 380 + 380 * (1 - dr_rk)) + 72.0, dr_rtop + 75; anchor: left center; size: 11; weight: 700; family: "Exo 2"; color: fl.engrave; width: 105.0; lines: 1 }
                text dr_wifit { at: (drawers.width - 380 + 380 * (1 - dr_rk)) + 72.0, dr_rtop + 91; anchor: left center; size: 9; family: "Share Tech Mono"; color: fl.muted; width: 105.0; lines: 1 }
                zone box drz_t1 { from: (drawers.width - 380 + 380 * (1 - dr_rk)) + 24.0, dr_rtop + 56; size: 161.0, 52; corner: 14; cursor: pointer; role: toggle; label: "Wi-Fi"; checked: dr_wifi; show: dr_open == 2 }
