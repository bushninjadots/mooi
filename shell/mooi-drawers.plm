                    curve (drawers.width + 380 * (1 - dr_rk)) - 0, dr_rtop + 600 + 22 via (drawers.width + 380 * (1 - dr_rk)) - 0, dr_rtop + 600
                    close } }
            path { stroke: 1.2; color: fl.trace; opacity: 0.9
