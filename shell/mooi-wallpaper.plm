language 0.4
import "theme/tokens.plm"
import "theme/ferrolume.plm"
import "ui/lumen.plm"

// Lumen — mooi's wallpaper studio. A full-screen layer over the desktop: the picture is the
// canvas, the chrome floats on it, and nothing is written to the desktop until APPLY. The
// recipe (exposure, colour, crop, vignette, grain) and the vibes are in lib/wallpaper; the
// logic (mooi-wallpaper.luau) renders with ImageMagick and hands the finished still to the
// wallpaper picker, which is what draws the desktop and makes the Matugen palette.
//
// A program of its own, for the same reason the settings window is: a second keyboard
// declarer in the bar's scene would replace its `while` (D8/D53), and a full-screen takeover
// that ends cleanly is easier alone. Its data folder is linked to mooi's by bin/mooi, so
// wallpapers.json and palette.json are the shell's own.

scene Lumen {
    permissions {
        run: "magick", "matugen", "qs", "awww", "pleamar", "hyprctl", "find", "readlink", "mkdir", "rm"
        services: "files", "files.write", "env"
    }

    // ── Ferrolume's palette ─────────────────────────────────────
    // The same facts and springs the bar wears: the logic paints them from palette.json, and
    // the studio re-lights with the desktop when the palette changes after an apply.
    fact fr_ground_r = 0.000000
    fact fr_ground_g = 0.000000
    fact fr_ground_b = 0.000000
    fact fr_hull_r = 0.015686
    fact fr_hull_g = 0.035294
    fact fr_hull_b = 0.031373
    fact fr_hull_raised_r = 0.027451
    fact fr_hull_raised_g = 0.074510
    fact fr_hull_raised_b = 0.066667
    fact fr_well_r = 0.019608
    fact fr_well_g = 0.164706
    fact fr_well_b = 0.145098
    fact fr_trace_dim_r = 0.121569
    fact fr_trace_dim_g = 0.219608
    fact fr_trace_dim_b = 0.200000
    fact fr_trace_r = 0.239216
    fact fr_trace_g = 0.415686
    fact fr_trace_b = 0.376471
    fact fr_trace_lit_r = 0.423529
    fact fr_trace_lit_g = 0.788235
    fact fr_trace_lit_b = 0.682353
    fact fr_phos_r = 0.498039
    fact fr_phos_g = 0.811765
    fact fr_phos_b = 0.713725
    fact fr_phos_fill_r = 0.090196
    fact fr_phos_fill_g = 0.603922
    fact fr_phos_fill_b = 0.533333
    fact fr_ember_r = 0.878431
    fact fr_ember_g = 0.482353
    fact fr_ember_b = 0.180392
    fact fr_ember_fill_r = 0.823529
    fact fr_ember_fill_g = 0.411765
    fact fr_ember_fill_b = 0.117647
    fact fr_flare_r = 0.956863
    fact fr_flare_g = 0.713725
    fact fr_flare_b = 0.235294
    fact fr_muted_r = 0.352941
    fact fr_muted_g = 0.541176
    fact fr_muted_b = 0.494118
    fact fr_ink_r = 0.015686
    fact fr_ink_g = 0.129412
    fact fr_ink_b = 0.113725
    fact fr_steel_900_r = 0.082353
    fact fr_steel_900_g = 0.098039
    fact fr_steel_900_b = 0.105882
    fact fr_steel_700_r = 0.164706
    fact fr_steel_700_g = 0.192157
    fact fr_steel_700_b = 0.203922
    fact fr_steel_500_r = 0.290196
    fact fr_steel_500_g = 0.329412
    fact fr_steel_500_b = 0.349020
    fact fr_steel_300_r = 0.545098
    fact fr_steel_300_g = 0.592157
    fact fr_steel_300_b = 0.611765
    fact fr_engrave_r = 0.603922
    fact fr_engrave_g = 0.650980
    fact fr_engrave_b = 0.670588
    prop pr_ground_r = 0.000000 ~fl.relight
    follow pr_ground_r = fr_ground_r
    prop pr_ground_g = 0.000000 ~fl.relight
    follow pr_ground_g = fr_ground_g
    prop pr_ground_b = 0.000000 ~fl.relight
    follow pr_ground_b = fr_ground_b
    prop pr_hull_r = 0.015686 ~fl.relight
    follow pr_hull_r = fr_hull_r
    prop pr_hull_g = 0.035294 ~fl.relight
    follow pr_hull_g = fr_hull_g
    prop pr_hull_b = 0.031373 ~fl.relight
    follow pr_hull_b = fr_hull_b
    prop pr_hull_raised_r = 0.027451 ~fl.relight
    follow pr_hull_raised_r = fr_hull_raised_r
    prop pr_hull_raised_g = 0.074510 ~fl.relight
    follow pr_hull_raised_g = fr_hull_raised_g
    prop pr_hull_raised_b = 0.066667 ~fl.relight
    follow pr_hull_raised_b = fr_hull_raised_b
    prop pr_well_r = 0.019608 ~fl.relight
    follow pr_well_r = fr_well_r
    prop pr_well_g = 0.164706 ~fl.relight
    follow pr_well_g = fr_well_g
    prop pr_well_b = 0.145098 ~fl.relight
    follow pr_well_b = fr_well_b
    prop pr_trace_dim_r = 0.121569 ~fl.relight
    follow pr_trace_dim_r = fr_trace_dim_r
    prop pr_trace_dim_g = 0.219608 ~fl.relight
    follow pr_trace_dim_g = fr_trace_dim_g
    prop pr_trace_dim_b = 0.200000 ~fl.relight
    follow pr_trace_dim_b = fr_trace_dim_b
    prop pr_trace_r = 0.239216 ~fl.relight
    follow pr_trace_r = fr_trace_r
    prop pr_trace_g = 0.415686 ~fl.relight
    follow pr_trace_g = fr_trace_g
    prop pr_trace_b = 0.376471 ~fl.relight
    follow pr_trace_b = fr_trace_b
    prop pr_trace_lit_r = 0.423529 ~fl.relight
    follow pr_trace_lit_r = fr_trace_lit_r
    prop pr_trace_lit_g = 0.788235 ~fl.relight
    follow pr_trace_lit_g = fr_trace_lit_g
    prop pr_trace_lit_b = 0.682353 ~fl.relight
    follow pr_trace_lit_b = fr_trace_lit_b
    prop pr_phos_r = 0.498039 ~fl.relight
    follow pr_phos_r = fr_phos_r
    prop pr_phos_g = 0.811765 ~fl.relight
    follow pr_phos_g = fr_phos_g
    prop pr_phos_b = 0.713725 ~fl.relight
    follow pr_phos_b = fr_phos_b
    prop pr_phos_fill_r = 0.090196 ~fl.relight
    follow pr_phos_fill_r = fr_phos_fill_r
    prop pr_phos_fill_g = 0.603922 ~fl.relight
    follow pr_phos_fill_g = fr_phos_fill_g
    prop pr_phos_fill_b = 0.533333 ~fl.relight
    follow pr_phos_fill_b = fr_phos_fill_b
    prop pr_ember_r = 0.878431 ~fl.relight
    follow pr_ember_r = fr_ember_r
    prop pr_ember_g = 0.482353 ~fl.relight
    follow pr_ember_g = fr_ember_g
    prop pr_ember_b = 0.180392 ~fl.relight
    follow pr_ember_b = fr_ember_b
    prop pr_ember_fill_r = 0.823529 ~fl.relight
    follow pr_ember_fill_r = fr_ember_fill_r
    prop pr_ember_fill_g = 0.411765 ~fl.relight
    follow pr_ember_fill_g = fr_ember_fill_g
    prop pr_ember_fill_b = 0.117647 ~fl.relight
    follow pr_ember_fill_b = fr_ember_fill_b
    prop pr_flare_r = 0.956863 ~fl.relight
    follow pr_flare_r = fr_flare_r
    prop pr_flare_g = 0.713725 ~fl.relight
    follow pr_flare_g = fr_flare_g
    prop pr_flare_b = 0.235294 ~fl.relight
    follow pr_flare_b = fr_flare_b
    prop pr_muted_r = 0.352941 ~fl.relight
    follow pr_muted_r = fr_muted_r
    prop pr_muted_g = 0.541176 ~fl.relight
    follow pr_muted_g = fr_muted_g
    prop pr_muted_b = 0.494118 ~fl.relight
    follow pr_muted_b = fr_muted_b
    prop pr_ink_r = 0.015686 ~fl.relight
    follow pr_ink_r = fr_ink_r
    prop pr_ink_g = 0.129412 ~fl.relight
    follow pr_ink_g = fr_ink_g
    prop pr_ink_b = 0.113725 ~fl.relight
    follow pr_ink_b = fr_ink_b
    prop pr_steel_900_r = 0.082353 ~fl.relight
    follow pr_steel_900_r = fr_steel_900_r
    prop pr_steel_900_g = 0.098039 ~fl.relight
    follow pr_steel_900_g = fr_steel_900_g
    prop pr_steel_900_b = 0.105882 ~fl.relight
    follow pr_steel_900_b = fr_steel_900_b
    prop pr_steel_700_r = 0.164706 ~fl.relight
    follow pr_steel_700_r = fr_steel_700_r
    prop pr_steel_700_g = 0.192157 ~fl.relight
    follow pr_steel_700_g = fr_steel_700_g
    prop pr_steel_700_b = 0.203922 ~fl.relight
    follow pr_steel_700_b = fr_steel_700_b
    prop pr_steel_500_r = 0.290196 ~fl.relight
    follow pr_steel_500_r = fr_steel_500_r
    prop pr_steel_500_g = 0.329412 ~fl.relight
    follow pr_steel_500_g = fr_steel_500_g
    prop pr_steel_500_b = 0.349020 ~fl.relight
    follow pr_steel_500_b = fr_steel_500_b
    prop pr_steel_300_r = 0.545098 ~fl.relight
    follow pr_steel_300_r = fr_steel_300_r
    prop pr_steel_300_g = 0.592157 ~fl.relight
    follow pr_steel_300_g = fr_steel_300_g
    prop pr_steel_300_b = 0.611765 ~fl.relight
    follow pr_steel_300_b = fr_steel_300_b
    prop pr_engrave_r = 0.603922 ~fl.relight
    follow pr_engrave_r = fr_engrave_r
    prop pr_engrave_g = 0.650980 ~fl.relight
    follow pr_engrave_g = fr_engrave_g
    prop pr_engrave_b = 0.670588 ~fl.relight
    follow pr_engrave_b = fr_engrave_b

    // The islands' semantic tokens, which theme/tokens defines over these facts.
    fact c_bg_primary_r = 0.062745
    fact c_bg_primary_g = 0.078431
    fact c_bg_primary_b = 0.086275
    fact c_bg_secondary_r = 0.086275
    fact c_bg_secondary_g = 0.105882
    fact c_bg_secondary_b = 0.117647
    fact c_surface_primary_r = 0.098039
    fact c_surface_primary_g = 0.121569
    fact c_surface_primary_b = 0.133333
    fact c_surface_elevated_r = 0.133333
    fact c_surface_elevated_g = 0.160784
    fact c_surface_elevated_b = 0.176471
    fact c_border_subtle_r = 0.172549
    fact c_border_subtle_g = 0.207843
    fact c_border_subtle_b = 0.223529
    fact c_fg_primary_r = 0.890196
    fact c_fg_primary_g = 0.913725
    fact c_fg_primary_b = 0.921569
    fact c_fg_secondary_r = 0.639216
    fact c_fg_secondary_g = 0.690196
    fact c_fg_secondary_b = 0.709804
    fact c_fg_muted_r = 0.541176
    fact c_fg_muted_g = 0.592157
    fact c_fg_muted_b = 0.611765
    fact c_accent_primary_r = 0.650980
    fact c_accent_primary_g = 0.952941
    fact c_accent_primary_b = 0.819608
    fact c_accent_secondary_r = 1.000000
    fact c_accent_secondary_g = 0.572549
    fact c_accent_secondary_b = 0.372549
    fact c_status_ok_r = 0.650980
    fact c_status_ok_g = 0.952941
    fact c_status_ok_b = 0.819608
    fact c_status_error_r = 1.000000
    fact c_status_error_g = 0.572549
    fact c_status_error_b = 0.372549
    fact c_focus_ring_r = 0.650980
    fact c_focus_ring_g = 0.952941
    fact c_focus_ring_b = 0.819608
    fact c_selection_bg_r = 0.164706
    fact c_selection_bg_g = 0.227451
    fact c_selection_bg_b = 0.211765
    // What theme/ferrolume reads for its geometry; the studio uses the colour, not the bar's
    // strip, so these are only the values the tokens are defined against.
    fact st_offset = 0
    fact st_notch = false
    fact bar_rail = true
    fact st_height = 30
    fact st_radius = 8
    fact st_res = 46

    // ── The studio ───────────────────────────────────────────────
    fact studio_in = 0
    prop enter = 0 ~fl.relight
    follow enter = studio_in

    fact loading = true
    fact failed = false
    fact applied = false
    fact has_preview = false
    fact has_source = false
    fact tab = 0
    fact browsing = false
    fact comparing = false
    fact picking = false     // the folder picker is over the source wall
    fact pick_page = 0
    fact pick_pages = 1
    fact sel = 0
    fact page = 0
    fact pages = 1
    fact hit_count = 0
    fact fx = 50
    fact fy = 50
    fact vibe_sel = 0
    // The backdrop tab (D60): which fill is chosen (0 black, 1 the picture, 2–4 a colour read
    // from the picture) and the three colours read from its edges.
    fact bg_sel = 0
    // Whether the picture's own background is keyed out into the backdrop (D61).
    fact key_on = 0
    fact bg_c0_r = 0.0
    fact bg_c0_g = 0.0
    fact bg_c0_b = 0.0
    fact bg_c1_r = 0.0
    fact bg_c1_g = 0.0
    fact bg_c1_b = 0.0
    fact bg_c2_r = 0.0
    fact bg_c2_g = 0.0
    fact bg_c2_b = 0.0
    // The custom backdrop's colour (D62), and the field it is typed in.
    fact bg_cu_r = 0.501961
    fact bg_cu_g = 0.501961
    fact bg_cu_b = 0.501961
    // The backdrop's palette (D63): which swatch is the fill, how many there are, and whether the
    // recipe can be taken back or put forward.
    fact sw_sel = -1
    fact swatch_count = 0
    fact can_undo = 0
    fact can_redo = 0
    // The frame (lib/wallpaper): fill or fit, the quarter turns, the mirrors, the zoom.
    fact fit_on = false
    fact rot = 0
    fact flip_h = false
    fact flip_v = false
    fact zoom_now = 100
    // The picture carried by the hand: the scene moves the preview while it is dragged, the logic
    // moves the crop on release and lets the offset go when the next preview is drawn.
    fact pan_dx = 0
    fact pan_dy = 0
    // Where the wheel turned, so the zoom keeps that point under the pointer.
    fact zoom_px = 960
    fact zoom_py = 540
    // A field has the caret: the single-letter keys stand down (a letter rule would otherwise take
    // the letter from the field — `a` in a colour would apply the wallpaper).
    fact typing = false
    // H: the studio's chrome out of the way, the picture on its own.
    fact chrome_off = false

    text src_name = ""
    text src_meta = ""
    text src_query = ""
    text src_folder = ""      // the folder the source wall reads (the logic keeps it current)
    text folder_show = ""     // and the same path as the wall's heading
    text status = "READING THE WALLPAPER"

    text vibe_name = "NATURAL"
    text vibe_hint = "the picture, as it is"
    text count_label = "READING THE FOLDER…"
    text page_label = "PAGE 01 / 01"
    text pick_path = ""
    text pick_count = ""
    text pick_page_l = "PAGE 01 / 01"
    text pal_note = "READING THE PALETTE"
    text pal_phos = "#7FCFC0"
    text pal_ember = "#E07A2E"
    text bg_hex0 = "#000000"
    text bg_hex1 = "#000000"
    text bg_hex2 = "#000000"
    text bg_custom_hex = "#808080"
    text pick_typed = ""       // what is in the picker's folder field
    text bg_note = "READING THE PICTURE'S EDGES"

    fact pal_phos_r = 0.498039
    fact pal_phos_g = 0.811765
    fact pal_phos_b = 0.713725
    fact pal_ember_r = 0.878431
    fact pal_ember_g = 0.482353
    fact pal_ember_b = 0.180392

    // The preview and the untouched source, both paths; the logic bumps them file by file. The
    // declared size is the picture's cell, and it is stretched to `size:` where it is drawn: a
    // 1 × 1 cell is one pixel of the picture enlarged to the whole screen (D59). The cell is the
    // preview's own 16 : 9, the shape both files are made in — the preview squashes the screen's
    // base to that shape, and drawing it at the screen's shape unsquashes it, so the picture keeps
    // its proportions on any monitor (D60).
    text prev_file = ""
    text src_file = ""
    image prev = from prev_file, 1600, 900
    image srcpic = from src_file, 1600, 900

    // The sliders for the tab that is shown, the vibes, and the source wall's page.
    model sliders max 4 { label: text; v: number; span: number; shown: text; code: number }
    model vibes max 9 { id: text; name: text; hint: text }
    model hits max 18 { x: number; y: number; name: text; thumb: image 282, 158; ready: number; dims: text; slot: number }
    model dirs max 10 { name: text; slot: number }
    model swatches max 9 { name: text; hex: text; r: number; g: number; b: number }

    event set_value ->        // to the logic: code * 1000 + offset
    event pick_vibe ->        // to the logic: vibe n
    event vibe_step ->        // to the logic: -1 the one before, 1 the one after
    event step_tab ->         // to the logic: -1 / 1
    event set_tab ->          // to the logic: tab n
    event open_browse ->      // to the logic: open the source wall (and read its folder)
    event close_browse ->     // to the logic: close it
    event set_folder ->       // to the logic: read the folder written in the field
    event folder_current ->   // to the logic: read the live wallpaper's folder
    event open_picker ->      // to the logic: open the folder picker at the current folder
    event pick_dir ->         // to the logic: enter subfolder n on the page
    event pick_up ->          // to the logic: go to the parent folder
    event pick_go ->          // to the logic: go to the folder written in the field
    event pick_jump ->        // to the logic: 0 home, 1 pictures, 2 the root folder
    event pick_page ->        // to the logic: -1 / 1
    event pick_choose ->      // to the logic: read the folder the picker is in
    event pick_cancel ->      // to the logic: close the picker
    event pick_source ->      // to the logic: tile slot on the page
    event browse_page ->      // to the logic: -1 / 1
    event shuffle ->          // to the logic: pick a picture at random
    event use_current ->      // to the logic: load the wallpaper on the desk
    event apply_now ->        // to the logic: render and apply
    event reset_recipe ->     // to the logic: the picture as it is
    event close_studio ->     // to the logic: save, tidy the cache and quit
    event pan_done ->         // to the logic: the picture was dragged by pan_dx, pan_dy
    event zoom_at ->          // to the logic: the wheel's notches, at zoom_px, zoom_py
    event set_fit ->          // to the logic: fill the screen, or fit the whole picture
    event rotate_step ->      // to the logic: -1 a quarter turn back, 1 forward
    event flip_toggle ->      // to the logic: 1 mirror left to right, 2 top to bottom
    event frame_reset ->      // to the logic: no zoom, centred, unturned, unmirrored
    event save_copy ->        // to the logic: keep the edit in ~/Pictures/Lumen
    event sel_step ->         // to the logic: the next or previous tile on the source wall
    event pick_bg ->          // to the logic: backdrop 0 black, 1 the picture, 2–4 a colour, 5 typed
    event pick_swatch ->      // to the logic: a colour from the palette, by its place in it
    event use_bg_custom ->    // to the logic: take the colour in the field as the backdrop
    event undo_recipe ->      // to the logic: take the last edit back
    event redo_recipe ->      // to the logic: put it forward again
    event toggle_key ->       // to the logic: key the picture's background out, or put it back

    surface studio {
        size: full, full
        anchor: top
        reserve: -1
        level: overlay
        keyboard: exclusive

        box { from: 0, 0; size: screen.width, screen.height; color: #000000 }

        group {
            opacity: enter
            move: 0, (1 - enter) * 12

            // ── The picture ─────────────────────────────────────
            image prev { at: pan_dx, pan_dy; size: screen.width, screen.height; show: has_preview and not comparing }
            image srcpic { at: pan_dx, pan_dy; size: screen.width, screen.height; show: has_source and comparing }
            box { from: 0, 0; size: screen.width, screen.height; color: #000000; opacity: 0.08 }

            // The whole screen is the crop's target: a press puts the subject where it is,
            // the wheel zooms. Under the chrome, so a control never moves the focus.
            zone box canvas { from: 0, 0; size: screen.width, screen.height; cursor: grab; role: region
                              label: "The picture: drag to move it, the wheel zooms"; show: not browsing }
            // These keep presses on the chrome from reaching the picture underneath.
            zone box top_guard { from: 0, 0; size: screen.width, 118; role: region; label: "The studio header"; show: not chrome_off }
            zone box rail_guard { from: screen.width - 444, 118; size: 444, 660; role: region; label: "The vibes and the palette"; show: not chrome_off }
            zone box dock_guard { from: 36, screen.height - 260; size: screen.width - 72, 260; role: region; label: "The grade dock"; show: not chrome_off }

            // The frame's thirds and its middle, while FRAME is the tab or the picture is carried.
            group {
                show: (tab == 2 or canvas.pressed > 0.5) and not chrome_off
                repeat i in 1..3 {
                    line { from: screen.width * i / 3, 0; to: screen.width * i / 3, screen.height; width: 1; color: fl.phos; opacity: 0.16 }
                    line { from: 0, screen.height * i / 3; to: screen.width, screen.height * i / 3; width: 1; color: fl.phos; opacity: 0.16 }
                }
                line { from: screen.width / 2 - 14, screen.height / 2; to: screen.width / 2 + 14, screen.height / 2; width: 1; color: fl.ember; opacity: 0.7 }
                line { from: screen.width / 2, screen.height / 2 - 14; to: screen.width / 2, screen.height / 2 + 14; width: 1; color: fl.ember; opacity: 0.7 }
            }

            // While the picture loads, or when it could not be read.
            text "READING THE PICTURE…" { at: screen.width / 2, screen.height / 2; anchor: center; size: 12
                                          family: "Share Tech Mono"; color: fl.ember; show: loading and not has_preview }
            text "COULD NOT READ THAT PICTURE — PICK ANOTHER" { at: screen.width / 2, screen.height / 2; anchor: center; size: 13
                                                                family: "Share Tech Mono"; color: fl.ember; show: failed and not loading and not has_preview }
            text "THE SOURCE · UNEDITED" { at: screen.width / 2, 58; anchor: center; size: 9; family: "Share Tech Mono"
                                           color: fl.phos; shadow: 0, 1, 6, 70%, #000000; show: comparing }
            box { from: 0, 0; size: screen.width, 2; color: fl.ember; opacity: if(loading, 0.9, 0) }

            // ── The chrome: hidden with H, so the picture can be seen on its own ──
            group {
                show: not chrome_off
            // ── The header ──────────────────────────────────────
            Plate(48, 36, 318, 66, 8, mix(fl.hull, fl.ground, 0.35), fl.trace_dim, 0.9)
            text "LUMEN" { at: 68, 59; anchor: left center; size: 25; weight: 700; family: "Exo 2"; color: fl.phos
                           shadow: 0, 0, 10, 40%, fl.phos }
            text "WALLPAPER STUDIO" { at: 69, 82; anchor: left center; size: 9; family: "Share Tech Mono"; color: fl.ember }

            text src_name { at: 392, 54; anchor: left center; size: 14; weight: 600; family: "Exo 2"; color: fl.phos
                            width: 820; lines: 1; shadow: 0, 1, 8, 70%, #000000 }
            text src_meta { at: 392, 74; anchor: left center; size: 9; family: "Share Tech Mono"; color: fl.muted
                            width: 820; lines: 1; shadow: 0, 1, 6, 70%, #000000 }
            text status { at: 392, 94; anchor: left center; size: 9; family: "Share Tech Mono"; color: fl.ember
                          width: 900; lines: 1; shadow: 0, 1, 6, 70%, #000000 }

            Button(screen.width - 652, 44, 140, 38, "SOURCES", fl.trace_lit, false, open_browse, 0)
            Button(screen.width - 504, 44, 140, 38, "SAVE A COPY", fl.trace_lit, false, save_copy, 0, not loading)
            Button(screen.width - 356, 44, 96, 38, "ESC · CLOSE", fl.trace_lit, false, close_studio, 0)
            Button(screen.width - 248, 44, 200, 38, pick(applied, "APPLY TO DESKTOP", "APPLIED ✓"), if(applied, fl.phos, fl.ember), true, apply_now, 0, not loading)

            // ── The vibes and the palette, on the right ─────────
            Plate(screen.width - 420, 132, 372, 440, 10, mix(fl.hull, fl.ground, 0.4), fl.trace_dim, 0.88)
            text "VIBE" { at: screen.width - 402, 154; anchor: left center; size: 10; weight: 700; family: "Share Tech Mono"; color: fl.ember }
            text "THE LOOK OF THE PICTURE" { at: screen.width - 66, 154; anchor: right center; size: 8; family: "Share Tech Mono"; color: fl.muted }
            for v in vibes { Vibe(v, v.index == vibe_sel, pick_vibe, screen.width - 408, 176 + v.index * 40, 348) }

            Plate(screen.width - 420, 584, 372, 176, 8, mix(fl.hull, fl.ground, 0.4), fl.trace_dim, 0.88)
            text "THEME SIGNAL" { at: screen.width - 402, 602; anchor: left center; size: 10; weight: 700; family: "Share Tech Mono"; color: fl.ember }
            text pal_note { at: screen.width - 66, 602; anchor: right center; size: 8; family: "Share Tech Mono"; color: fl.muted }
            Swatch(screen.width - 402, 642, 56, 56, rgb(pal_phos_r, pal_phos_g, pal_phos_b), "SIGNAL · PHOS", pal_phos)
            Swatch(screen.width - 402, 702, 56, 56, rgb(pal_ember_r, pal_ember_g, pal_ember_b), "COUNTER · EMBER", pal_ember)

            // ── The grade dock ──────────────────────────────────
            // Its columns are measured from its width, so a slider's value never sits on the next
            // slider, and the history and compare controls keep the right end of the tab row.
            let dw = screen.width - 492
            let dr = 48 + dw - 24
            let colw = (dw - 48) / 4
            Plate(48, screen.height - 248, dw, 200, 10, mix(fl.hull, fl.ground, 0.42), fl.trace_dim, 0.9)
            Tab(72, screen.height - 230, 104, "TONE", set_tab, 0, tab == 0)
            Tab(184, screen.height - 230, 104, "COLOUR", set_tab, 1, tab == 1)
            Tab(296, screen.height - 230, 104, "FRAME", set_tab, 2, tab == 2)
            Tab(408, screen.height - 230, 104, "FX", set_tab, 3, tab == 3)
            Tab(520, screen.height - 230, 130, "BACKDROP", set_tab, 4, tab == 4)

            zone box cmp { from: dr - 404, screen.height - 230; size: 128, 30; cursor: pointer; role: button; label: "Hold to see the source" }
            Plate(dr - 404, screen.height - 230, 128, 30, 6, mix(fl.hull_raised, fl.well, 0.5 * cmp.hover + if(comparing, 0.5, 0)), if(comparing, fl.phos, fl.trace), 0.95)
            text "HOLD · SOURCE" { at: dr - 340, screen.height - 215; anchor: center; size: 9; weight: 600; family: "Share Tech Mono"; color: mix(fl.engrave, fl.phos, max(cmp.hover, if(comparing, 1, 0))) }
            Button(dr - 268, screen.height - 230, 84, 30, "UNDO", fl.trace_lit, false, undo_recipe, 0, can_undo > 0)
            Button(dr - 176, screen.height - 230, 84, 30, "REDO", fl.trace_lit, false, redo_recipe, 0, can_redo > 0)
            Button(dr - 84, screen.height - 230, 84, 30, "RESET", fl.trace_lit, false, reset_recipe, 0)

            // the look the grade is, under the tabs (the frame and the backdrop use this row)
            text "VIBE · {vibe_name}" { at: 72, screen.height - 188; anchor: left center; size: 11; weight: 600; family: "Exo 2"; color: fl.phos
                                       show: tab == 0 or tab == 1 or tab == 3 }
            text vibe_hint { at: 72 + 260, screen.height - 188; anchor: left center; size: 8; family: "Share Tech Mono"; color: fl.muted
                             width: 560; lines: 1; show: tab == 0 or tab == 1 or tab == 3 }

            // ── The frame's switches ────────────────────────────
            group {
                show: tab == 2
                Button(72, screen.height - 198, 92, 26, "FILL", fl.phos, not fit_on, set_fit, 0)
                Button(170, screen.height - 198, 92, 26, "FIT", fl.phos, fit_on, set_fit, 0)
                Button(286, screen.height - 198, 92, 26, "↺ 90°", fl.trace_lit, false, rotate_step, -1)
                Button(384, screen.height - 198, 92, 26, "↻ 90°", fl.trace_lit, false, rotate_step, 1)
                Button(500, screen.height - 198, 110, 26, "MIRROR ⇆", fl.phos, flip_h, flip_toggle, 1)
                Button(616, screen.height - 198, 110, 26, "FLIP ⇅", fl.phos, flip_v, flip_toggle, 2)
                Button(750, screen.height - 198, 130, 26, "RESET FRAME", fl.trace_lit, false, frame_reset, 0)
                text "ZOOM {zoom_now, 0}%  ·  TURNED {rot * 90, 0}°" { at: 900, screen.height - 185; anchor: left center; size: 9
                     family: "Share Tech Mono"; color: fl.engrave }
            }

            // ── The backdrop ────────────────────────────────────
            // The matte's fill: black, the picture itself blurred, one of the three colours read
            // from its corners, its edges or both, or a colour typed in (D62). REPLACE BG keys the
            // picture's own background out into whichever fill is chosen. The sliders beneath set
            // the matte and the fill's blur and dim.
            group {
                show: tab == 4
                BGMode(72, screen.height - 198, 104, 24, rgb(0.0, 0.0, 0.0), "BLACK", "", bg_sel == 0, pick_bg, 0)
                BGMode(184, screen.height - 198, 156, 24, rgb(0.12, 0.14, 0.15), "PICTURE", "BLURRED", bg_sel == 1, pick_bg, 1)
                BGMode(348, screen.height - 198, 200, 24, rgb(bg_c0_r, bg_c0_g, bg_c0_b), "CORNERS", bg_hex0, bg_sel == 2, pick_bg, 2)
                BGMode(556, screen.height - 198, 200, 24, rgb(bg_c1_r, bg_c1_g, bg_c1_b), "EDGES", bg_hex1, bg_sel == 3, pick_bg, 3)
                BGMode(764, screen.height - 198, 200, 24, rgb(bg_c2_r, bg_c2_g, bg_c2_b), "BOTH", bg_hex2, bg_sel == 4, pick_bg, 4)
                KeyToggle(972, screen.height - 198, 162, 24, "REPLACE BG", key_on == 1, toggle_key)
                BGMode(1142, screen.height - 198, 200, 24, rgb(bg_cu_r, bg_cu_g, bg_cu_b), "CUSTOM", bg_custom_hex, bg_sel == 5, pick_bg, 5)
                Plate(1350, screen.height - 198, 100, 24, 4, mix(fl.hull, fl.ground, 0.3), fl.trace_dim, 0.92)
                input bg_custom_hex { at: 1356, screen.height - 192; width: 88; size: 10; family: "Share Tech Mono"; color: fl.phos
                                        placeholder: "#RRGGBB"; selection: fl.well
                                        label: "The colour the CUSTOM backdrop fills with — press Enter to use it" }
                // the field is taken through this zone, so the studio knows a colour is being typed
                zone box hex_take { from: 1350, screen.height - 198; size: 100, 24; cursor: text; role: region
                                    label: "Type a backdrop colour"; show: not typing }
                text bg_note { at: 72, screen.height - 207; anchor: left center; size: 8
                                family: "Share Tech Mono"; color: fl.trace }

                // The palette (D63): the shell's own colours, a press to fill with one, and the same
                // colour in the field above, so picking and typing are one thing.
                text "PALETTE · CLICK A COLOUR, OR TYPE ONE ABOVE" { at: 72, screen.height - 159; anchor: left center; size: 8
                                                                   family: "Share Tech Mono"; color: fl.muted }
                for s in swatches { ColorSwatch(180 + s.index * 40, screen.height - 170, 34, 22, rgb(s.r, s.g, s.b), s.hex,
                                                sw_sel == s.index, pick_swatch, s.index) }
            }


            for s in sliders { Slider(72 + s.index * colw, screen.height - 140, colw - 100, s.label, s.v, s.span, set_value, s.code, s.shown) }

            text "DRAG THE PICTURE TO MOVE IT · WHEEL ZOOMS · ← → TABS · 1–9 VIBES · H HIDES THE STUDIO · C COMPARES · F FITS · A APPLIES · CTRL+S SAVES A COPY · ESC CLOSES" { at: 72, screen.height - 72; anchor: left center
                 size: 8; family: "Share Tech Mono"; color: fl.trace; width: dw - 48; lines: 1 }
            }
            text "H · SHOW THE STUDIO" { at: screen.width - 48, screen.height - 36; anchor: right center; size: 9
                                         family: "Share Tech Mono"; color: fl.phos; shadow: 0, 1, 6, 80%, #000000; show: chrome_off }

            // ── The source wall ─────────────────────────────────
            group {
                show: browsing
                zone box browse_guard { from: 0, 0; size: screen.width, screen.height; role: region; label: "The source wall" }
                box { from: 0, 0; size: screen.width, screen.height; color: fl.ground; opacity: 0.965 }

                text "SOURCE WALL" { at: 48, 58; anchor: left center; size: 30; weight: 700; family: "Exo 2"; color: fl.phos
                                    shadow: 0, 0, 12, 40%, fl.phos }
                text "PICK A PICTURE · {count_label}" { at: 48, 86; anchor: left center; size: 9; family: "Share Tech Mono"; color: fl.ember }
                text "THE PICTURE IS NEVER CHANGED · A NEW STILL IS SAVED ON APPLY" { at: 48, 104; anchor: left center; size: 8; family: "Share Tech Mono"; color: fl.trace }

                zone box bx { from: screen.width - 88, 40; size: 40, 40; cursor: pointer; role: button; label: "Close the source wall" }
                box { from: screen.width - 88, 40; size: 40, 40; corner: 5; color: mix(fl.hull_raised, fl.well, bx.hover); opacity: 0.9 }
                line { from: screen.width - 76, 52; to: screen.width - 60, 68; width: 1.5; color: mix(fl.muted, fl.ember, bx.hover) }
                line { from: screen.width - 60, 52; to: screen.width - 76, 68; width: 1.5; color: mix(fl.muted, fl.ember, bx.hover) }

                // The folder: typed, scanned, remembered in wallpapers.json. The live wallpaper's own
                // folder is one press away, and the current wallpaper itself is at the foot.
                text "WALLPAPER FOLDER · {folder_show}" { at: 48, 128; anchor: left center; size: 8
                                                          family: "Share Tech Mono"; color: fl.muted
                                                          width: 600; lines: 1 }
                Plate(48, 140, 600, 44, 6, mix(fl.hull, fl.ground, 0.3), fl.trace_dim, 0.92)
                input src_folder { at: 64, 152; width: 568; size: 13; family: "Exo 2"; color: fl.phos
                                    placeholder: "~/Pictures/wallpapers"; selection: fl.well
                                    label: "The folder the pictures are read from — press Enter to read it" }
                Button(660, 146, 100, 32, "SCAN", fl.trace_lit, false, set_folder, 0)
                Button(768, 146, 212, 32, "LIVE WALLPAPER'S FOLDER", fl.trace_lit, false, folder_current, 0)
                Button(988, 146, 108, 32, "BROWSE…", fl.trace_lit, false, open_picker, 0)

                text "FILTER" { at: screen.width - 348, 128; anchor: left center; size: 8; family: "Share Tech Mono"; color: fl.muted }
                Plate(screen.width - 348, 140, 300, 44, 6, mix(fl.hull, fl.ground, 0.3), fl.trace_dim, 0.92)
                input src_query { at: screen.width - 332, 152; width: 268; size: 14; family: "Exo 2"; color: fl.phos
                                  placeholder: "Filter by name…"; selection: fl.well; label: "Filter the pictures" }

                for h in hits { SourceTile(h, sel == h.slot, pick_source) }
                text "NOTHING MATCHES THAT FILTER" { at: 48, 210; anchor: left center; size: 12; family: "Share Tech Mono"; color: fl.ember; show: hit_count == 0 }

                text page_label { at: 48, screen.height - 174; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.engrave }
                Button(300, screen.height - 190, 88, 30, "‹ PREV", fl.trace_lit, false, browse_page, -1, page > 0)
                Button(400, screen.height - 190, 88, 30, "NEXT ›", fl.trace_lit, false, browse_page, 1, page < pages - 1)
                Button(500, screen.height - 190, 120, 30, "SHUFFLE", fl.trace_lit, false, shuffle, 0)
                Button(632, screen.height - 190, 220, 30, "USE THE CURRENT WALLPAPER", fl.trace_lit, false, use_current, 0)
                text "ESC CLOSES" { at: screen.width - 48, screen.height - 174; anchor: right center; size: 9; family: "Share Tech Mono"; color: fl.trace }

                // ── The folder picker ───────────────────────────
                // A folder is chosen by walking to it: the subfolders of the folder it is in, A→Z,
                // twelve to a page, and USE THIS FOLDER reads the one it has arrived at.
                group {
                    show: picking
                    let pkx = (screen.width - 760) / 2
                    let pky = (screen.height - 520) / 2
                    zone box pick_guard { from: 0, 0; size: screen.width, screen.height; role: region; label: "The folder picker" }
                    box { from: 0, 0; size: screen.width, screen.height; color: #000000; opacity: 0.55 }
                    Plate(pkx, pky, 760, 520, 10, mix(fl.hull, fl.ground, 0.25), fl.trace_dim, 0.99)
                    text "CHOOSE A WALLPAPER FOLDER" { at: pkx + 28, pky + 28; anchor: left center; size: 10; weight: 700
                                                     family: "Share Tech Mono"; color: fl.ember }
                    text pick_count { at: pkx + 732, pky + 28; anchor: right center; size: 8; family: "Share Tech Mono"; color: fl.muted }

                    // The folder itself, written out: a folder anywhere — on another disk, under a
                    // link, deep in the home folder — is typed and taken, and the rows below walk
                    // from it. HOME, PICTURES and the root are one press away.
                    Plate(pkx + 28, pky + 44, 704, 32, 6, mix(fl.hull, fl.ground, 0.3), fl.trace_dim, 0.92)
                    input pick_typed { at: pkx + 40, pky + 52; width: 580; size: 12; family: "Share Tech Mono"; color: fl.phos
                                       placeholder: "~/Pictures, /mnt/disk/pics…"; selection: fl.well
                                       label: "The folder to go to — press Enter or GO" }
                    Button(pkx + 630, pky + 44, 102, 32, "GO", fl.phos, true, pick_go, 0)

                    Button(pkx + 28, pky + 86, 92, 26, "HOME", fl.trace_lit, false, pick_jump, 0)
                    Button(pkx + 128, pky + 86, 112, 26, "PICTURES", fl.trace_lit, false, pick_jump, 1)
                    Button(pkx + 248, pky + 86, 88, 26, "ROOT /", fl.trace_lit, false, pick_jump, 2)
                    Button(pkx + 344, pky + 86, 100, 26, "↑ PARENT", fl.trace_lit, false, pick_up, 0)
                    box { from: pkx + 28, pky + 120; size: 704, 1; color: fl.trace_dim; opacity: 0.8 }

                    for d in dirs { DirRow(d, pick_dir, pkx + 28, pky + 130 + d.index * 30) }

                    Button(pkx + 28, pky + 456, 84, 30, "‹ PREV", fl.trace_lit, false, pick_page, -1, pick_page > 0)
                    text pick_page_l { at: pkx + 122, pky + 471; anchor: left center; size: 9; family: "Share Tech Mono"; color: fl.engrave }
                    Button(pkx + 260, pky + 456, 84, 30, "NEXT ›", fl.trace_lit, false, pick_page, 1, pick_page < pick_pages - 1)
                    Button(pkx + 360, pky + 456, 96, 30, "CANCEL", fl.trace_lit, false, pick_cancel, 0)
                    Button(pkx + 470, pky + 456, 206, 30, "USE THIS FOLDER", fl.phos, true, pick_choose, 0)
                }
            }
        }
    }

    // ── What the hands do ───────────────────────────────────────
    on press canvas { typing = false; blur }
    on drag canvas { pan_dx = drag.dx; pan_dy = drag.dy }
    on release canvas { emit pan_done }
    on scroll canvas { zoom_px = pointer.x; zoom_py = pointer.y; emit zoom_at(wheel) }
    on press hex_take { typing = true; focus bg_custom_hex }
    on submit bg_custom_hex { typing = false; blur }
    on press cmp { comparing = true }
    on release cmp { comparing = false }
    on press bx { emit close_browse }
    // The picker is walked with the pointer and Enter: the field it was opened from gives up the
    // caret, so Enter means USE THIS FOLDER and not a submit into a box behind the picker.
    on open_picker { blur }


    // While a colour is typed, Escape only leaves the field and no letter or digit is a shortcut.
    on key Escape while typing { typing = false; blur }
    on key Escape while picking and not typing { emit pick_cancel }
    on key Escape while browsing and not picking and not typing { emit close_browse }
    on key Escape while not browsing and not typing { emit close_studio }
    on key a while not browsing and not typing { emit apply_now }
    on key r while not browsing and not typing { emit reset_recipe }
    on key h while not browsing and not typing { toggle chrome_off }
    on key c while not browsing and not typing { toggle comparing }
    on key f while not browsing and not typing { emit set_fit }
    on key Ctrl+s while not browsing { emit save_copy }
    on key Ctrl+z while not browsing and not typing { emit undo_recipe }
    on key Ctrl+y while not browsing and not typing { emit redo_recipe }
    on key Left while not browsing and not typing { emit step_tab(-1) }
    on key Right while not browsing and not typing { emit step_tab(1) }
    on key Up while not browsing and not typing { emit vibe_step(-1) }
    on key Down while not browsing and not typing { emit vibe_step(1) }
    on key Up while browsing and not picking { emit sel_step(-1) }
    on key Down while browsing and not picking { emit sel_step(1) }
    on key one while not browsing and not typing { emit pick_vibe(0) }
    on key two while not browsing and not typing { emit pick_vibe(1) }
    on key three while not browsing and not typing { emit pick_vibe(2) }
    on key four while not browsing and not typing { emit pick_vibe(3) }
    on key five while not browsing and not typing { emit pick_vibe(4) }
    on key six while not browsing and not typing { emit pick_vibe(5) }
    on key seven while not browsing and not typing { emit pick_vibe(6) }
    on key eight while not browsing and not typing { emit pick_vibe(7) }
    on key nine while not browsing and not typing { emit pick_vibe(8) }
    on submit src_query { emit pick_source(sel) }
    // The two text fields' Enter is handled in the logic (`submit:src_folder`,
    // `submit:bg_custom_hex`, `submit:pick_typed`), which is given the text itself.
    // The wall opens with the cursor in the filter, ready to type.
    on open_browse { browsing = true; focus src_query }
}
