language 0.4
import "theme/tokens.plm"
import "theme/ferrolume.plm"
import "ui/loom.plm"

// mooi's Control Nexus (D65) — the system command centre, a program of its own. A full-screen
// surface that holds the keyboard while it is up, so the bar's scene keeps its own keyboard
// clause and the bar remains the place the Nexus opens from and closes back to. `mooi-nexus.luau`
// paints the shell's colours from palette.json, keeps `nexus.pinned`, and carries the controls
// to the real services. `settings.json` is mooi's own (bin/mooi links the data folder).
//
// The plate is right-anchored under the bar: it unfolds from a strip at the Arch mark's corner
// and settles into a structured board. Its readings are the system's own; where a service cannot
// answer, the card says so rather than drawing a number.

scene Nexus {
    permissions {
        run: "pleamar", "cat", "df", "uname", "hostname", "sensors", "hyprctl", "mooi", "zenity", "cava", "curl", "magick"
        services: "workspaces", "clock", "audio", "audio.*", "brightness", "brightness.*", "battery", "network", "bluetooth", "bluetooth.*", "media", "media.*", "files", "files.write", "env"
    }

    // The same facts and springs the bar wears: the logic paints them from palette.json, and
    // the studio re-lights with the desktop when the palette changes after an apply.
    fact fr_ground_r = 0.000000
    fact fr_ground_g = 0.000000
    fact fr_ground_b = 0.000000
    fact fr_hull_r = 0.015686
    fact fr_hull_g = 0.035294
    fact fr_hull_b = 0.031373
    fact fr_hull_raised_r = 0.027451
    fact fr_hull_raised_g = 0.074510
    fact fr_hull_raised_b = 0.066667
    fact fr_well_r = 0.019608
    fact fr_well_g = 0.164706
    fact fr_well_b = 0.145098
    fact fr_trace_dim_r = 0.121569
    fact fr_trace_dim_g = 0.219608
    fact fr_trace_dim_b = 0.200000
    fact fr_trace_r = 0.239216
    fact fr_trace_g = 0.415686
    fact fr_trace_b = 0.376471
    fact fr_trace_lit_r = 0.423529
    fact fr_trace_lit_g = 0.788235
    fact fr_trace_lit_b = 0.682353
    fact fr_phos_r = 0.498039
    fact fr_phos_g = 0.811765
    fact fr_phos_b = 0.713725
    fact fr_phos_fill_r = 0.090196
    fact fr_phos_fill_g = 0.603922
    fact fr_phos_fill_b = 0.533333
    fact fr_ember_r = 0.878431
    fact fr_ember_g = 0.482353
    fact fr_ember_b = 0.180392
    fact fr_ember_fill_r = 0.823529
    fact fr_ember_fill_g = 0.411765
    fact fr_ember_fill_b = 0.117647
    fact fr_flare_r = 0.956863
    fact fr_flare_g = 0.713725
    fact fr_flare_b = 0.235294
    fact fr_muted_r = 0.352941
    fact fr_muted_g = 0.541176
    fact fr_muted_b = 0.494118
    fact fr_ink_r = 0.015686
    fact fr_ink_g = 0.129412
    fact fr_ink_b = 0.113725
    fact fr_steel_900_r = 0.082353
    fact fr_steel_900_g = 0.098039
    fact fr_steel_900_b = 0.105882
    fact fr_steel_700_r = 0.164706
    fact fr_steel_700_g = 0.192157
    fact fr_steel_700_b = 0.203922
    fact fr_steel_500_r = 0.290196
    fact fr_steel_500_g = 0.329412
    fact fr_steel_500_b = 0.349020
    fact fr_steel_300_r = 0.545098
    fact fr_steel_300_g = 0.592157
    fact fr_steel_300_b = 0.611765
    fact fr_engrave_r = 0.603922
    fact fr_engrave_g = 0.650980
    fact fr_engrave_b = 0.670588
    prop pr_ground_r = 0.000000 ~fl.relight
    follow pr_ground_r = fr_ground_r
    prop pr_ground_g = 0.000000 ~fl.relight
    follow pr_ground_g = fr_ground_g
    prop pr_ground_b = 0.000000 ~fl.relight
    follow pr_ground_b = fr_ground_b
    prop pr_hull_r = 0.015686 ~fl.relight
    follow pr_hull_r = fr_hull_r
    prop pr_hull_g = 0.035294 ~fl.relight
    follow pr_hull_g = fr_hull_g
    prop pr_hull_b = 0.031373 ~fl.relight
    follow pr_hull_b = fr_hull_b
    prop pr_hull_raised_r = 0.027451 ~fl.relight
    follow pr_hull_raised_r = fr_hull_raised_r
    prop pr_hull_raised_g = 0.074510 ~fl.relight
    follow pr_hull_raised_g = fr_hull_raised_g
    prop pr_hull_raised_b = 0.066667 ~fl.relight
    follow pr_hull_raised_b = fr_hull_raised_b
    prop pr_well_r = 0.019608 ~fl.relight
    follow pr_well_r = fr_well_r
    prop pr_well_g = 0.164706 ~fl.relight
    follow pr_well_g = fr_well_g
    prop pr_well_b = 0.145098 ~fl.relight
    follow pr_well_b = fr_well_b
    prop pr_trace_dim_r = 0.121569 ~fl.relight
    follow pr_trace_dim_r = fr_trace_dim_r
    prop pr_trace_dim_g = 0.219608 ~fl.relight
    follow pr_trace_dim_g = fr_trace_dim_g
    prop pr_trace_dim_b = 0.200000 ~fl.relight
    follow pr_trace_dim_b = fr_trace_dim_b
    prop pr_trace_r = 0.239216 ~fl.relight
    follow pr_trace_r = fr_trace_r
    prop pr_trace_g = 0.415686 ~fl.relight
    follow pr_trace_g = fr_trace_g
    prop pr_trace_b = 0.376471 ~fl.relight
    follow pr_trace_b = fr_trace_b
    prop pr_trace_lit_r = 0.423529 ~fl.relight
    follow pr_trace_lit_r = fr_trace_lit_r
    prop pr_trace_lit_g = 0.788235 ~fl.relight
    follow pr_trace_lit_g = fr_trace_lit_g
    prop pr_trace_lit_b = 0.682353 ~fl.relight
    follow pr_trace_lit_b = fr_trace_lit_b
    prop pr_phos_r = 0.498039 ~fl.relight
    follow pr_phos_r = fr_phos_r
    prop pr_phos_g = 0.811765 ~fl.relight
    follow pr_phos_g = fr_phos_g
    prop pr_phos_b = 0.713725 ~fl.relight
    follow pr_phos_b = fr_phos_b
    prop pr_phos_fill_r = 0.090196 ~fl.relight
    follow pr_phos_fill_r = fr_phos_fill_r
    prop pr_phos_fill_g = 0.603922 ~fl.relight
    follow pr_phos_fill_g = fr_phos_fill_g
    prop pr_phos_fill_b = 0.533333 ~fl.relight
    follow pr_phos_fill_b = fr_phos_fill_b
    prop pr_ember_r = 0.878431 ~fl.relight
    follow pr_ember_r = fr_ember_r
    prop pr_ember_g = 0.482353 ~fl.relight
    follow pr_ember_g = fr_ember_g
    prop pr_ember_b = 0.180392 ~fl.relight
    follow pr_ember_b = fr_ember_b
    prop pr_ember_fill_r = 0.823529 ~fl.relight
    follow pr_ember_fill_r = fr_ember_fill_r
    prop pr_ember_fill_g = 0.411765 ~fl.relight
    follow pr_ember_fill_g = fr_ember_fill_g
    prop pr_ember_fill_b = 0.117647 ~fl.relight
    follow pr_ember_fill_b = fr_ember_fill_b
    prop pr_flare_r = 0.956863 ~fl.relight
    follow pr_flare_r = fr_flare_r
    prop pr_flare_g = 0.713725 ~fl.relight
    follow pr_flare_g = fr_flare_g
    prop pr_flare_b = 0.235294 ~fl.relight
    follow pr_flare_b = fr_flare_b
    prop pr_muted_r = 0.352941 ~fl.relight
    follow pr_muted_r = fr_muted_r
    prop pr_muted_g = 0.541176 ~fl.relight
    follow pr_muted_g = fr_muted_g
    prop pr_muted_b = 0.494118 ~fl.relight
    follow pr_muted_b = fr_muted_b
    prop pr_ink_r = 0.015686 ~fl.relight
    follow pr_ink_r = fr_ink_r
    prop pr_ink_g = 0.129412 ~fl.relight
    follow pr_ink_g = fr_ink_g
    prop pr_ink_b = 0.113725 ~fl.relight
    follow pr_ink_b = fr_ink_b
    prop pr_steel_900_r = 0.082353 ~fl.relight
    follow pr_steel_900_r = fr_steel_900_r
    prop pr_steel_900_g = 0.098039 ~fl.relight
    follow pr_steel_900_g = fr_steel_900_g
    prop pr_steel_900_b = 0.105882 ~fl.relight
    follow pr_steel_900_b = fr_steel_900_b
    prop pr_steel_700_r = 0.164706 ~fl.relight
    follow pr_steel_700_r = fr_steel_700_r
    prop pr_steel_700_g = 0.192157 ~fl.relight
    follow pr_steel_700_g = fr_steel_700_g
    prop pr_steel_700_b = 0.203922 ~fl.relight
    follow pr_steel_700_b = fr_steel_700_b
    prop pr_steel_500_r = 0.290196 ~fl.relight
    follow pr_steel_500_r = fr_steel_500_r
    prop pr_steel_500_g = 0.329412 ~fl.relight
    follow pr_steel_500_g = fr_steel_500_g
    prop pr_steel_500_b = 0.349020 ~fl.relight
    follow pr_steel_500_b = fr_steel_500_b
    prop pr_steel_300_r = 0.545098 ~fl.relight
    follow pr_steel_300_r = fr_steel_300_r
    prop pr_steel_300_g = 0.592157 ~fl.relight
    follow pr_steel_300_g = fr_steel_300_g
    prop pr_steel_300_b = 0.611765 ~fl.relight
    follow pr_steel_300_b = fr_steel_300_b
    prop pr_engrave_r = 0.603922 ~fl.relight
    follow pr_engrave_r = fr_engrave_r
    prop pr_engrave_g = 0.650980 ~fl.relight
    follow pr_engrave_g = fr_engrave_g
    prop pr_engrave_b = 0.670588 ~fl.relight
    follow pr_engrave_b = fr_engrave_b

    // The islands' semantic tokens, which theme/tokens defines over these facts.
    fact c_bg_primary_r = 0.062745
    fact c_bg_primary_g = 0.078431
    fact c_bg_primary_b = 0.086275
    fact c_bg_secondary_r = 0.086275
    fact c_bg_secondary_g = 0.105882
    fact c_bg_secondary_b = 0.117647
    fact c_surface_primary_r = 0.098039
    fact c_surface_primary_g = 0.121569
    fact c_surface_primary_b = 0.133333
    fact c_surface_elevated_r = 0.133333
    fact c_surface_elevated_g = 0.160784
    fact c_surface_elevated_b = 0.176471
    fact c_border_subtle_r = 0.172549
    fact c_border_subtle_g = 0.207843
    fact c_border_subtle_b = 0.223529
    fact c_fg_primary_r = 0.890196
    fact c_fg_primary_g = 0.913725
    fact c_fg_primary_b = 0.921569
    fact c_fg_secondary_r = 0.639216
    fact c_fg_secondary_g = 0.690196
    fact c_fg_secondary_b = 0.709804
    fact c_fg_muted_r = 0.541176
    fact c_fg_muted_g = 0.592157
    fact c_fg_muted_b = 0.611765
    fact c_accent_primary_r = 0.650980
    fact c_accent_primary_g = 0.952941
    fact c_accent_primary_b = 0.819608
    fact c_accent_secondary_r = 1.000000
    fact c_accent_secondary_g = 0.572549
    fact c_accent_secondary_b = 0.372549
    fact c_status_ok_r = 0.650980
    fact c_status_ok_g = 0.952941
    fact c_status_ok_b = 0.819608
    fact c_status_error_r = 1.000000
    fact c_status_error_g = 0.572549
    fact c_status_error_b = 0.372549
    fact c_focus_ring_r = 0.650980
    fact c_focus_ring_g = 0.952941
    fact c_focus_ring_b = 0.819608
    fact c_selection_bg_r = 0.164706
    fact c_selection_bg_g = 0.227451
    fact c_selection_bg_b = 0.211765
    // What theme/ferrolume reads for its geometry; the studio uses the colour, not the bar's
    // strip, so these are only the values the tokens are defined against.
    fact st_offset = 0
    fact st_notch = false
    fact bar_rail = true
    fact st_height = 30
    fact st_radius = 8
    fact st_res = 46
    // ── The workspace (D76) ──────────────────────────────────
    // The plate's eleven modules are catalogue nodes now. The logic publishes one row per
    // node that can be drawn; the scene paints the rows and hands a press, a drag or a key
    // back as an event. Node coordinates are canvas-relative, so changing the banner's
    // height never moves a node.
    model nws max 16 { id: number; windows: number; active: bool }
    service workspaces as ws { active: number; list: nws }
    service clock { time: text = "--:--"; date: text; weekday: number }
    service audio { volume: number; muted: bool; input: number; input_muted: bool }
    service brightness { present: bool; level: number }
    service battery { present: bool; percent: number; charging: bool }
    service network { online: bool; kind: none | wired | wifi; name: text; strength: number }
    service bluetooth { present: bool; powered: bool; discovering: bool }
    service media as med { playing: bool; title: text; artist: text; album: text; length: number; position: number; rate: number; player: text }

    // One row per slot (lib/nexusnode.SLOTS), drawn or not, always in the same order: row i
    // is slot i + 1, so its springs stay with its type through every arrangement.
    model nx_nodes max 14 { on: bool; code: number; key: text; title: text; value: text; note: text;
        x: number; y: number; w: number; h: number; tone: number; bar: number; baron: bool;
        mini: bool; sel: bool; focus: bool; minw: number; minh: number; maxw: number; maxh: number;
        kind: number; rows: number; endsel: bool;
        sub: text; bar2: number; bar2on: bool; bar2l: text; ser: bool;
        s1: number; s2: number; s3: number; s4: number; s5: number; s6: number;
        s7: number; s8: number; s9: number; s10: number; s11: number; s12: number;
        r1l: text; r1v: text; r2l: text; r2v: text; r3l: text; r3v: text; r4l: text; r4v: text;
        r5l: text; r5v: text; r6l: text; r6v: text; r7l: text; r7v: text; r8l: text; r8v: text }
    // The traces: authored in lib/nexusgraph, one row per drawable edge in authored order.
    // `a` and `b` are the two slots (0-based); the scene routes between their drawn boxes.
    model nx_edges max 13 { on: bool; a: number; b: number; trunk: bool; active: bool; level: number;
        dim: bool; label: text; meaning: text }
    model nx_removed max 16 { id: number; slot: number; key: text; title: text }
    // The module library: every type the catalogue declares, the state it is in and why.
    model nx_lib max 24 { slot: number; id: number; code: number; key: text; title: text; category: text; state: number; note: text; tone: number }
    // The traces the user put away, one row each so any of them can come back alone.
    model nx_hidden max 24 { id: number; key: text; label: text; meaning: text }
    // The panel's own tab strip is a fact, so Escape and the header and the strip agree.
    model nx_arrs max 8 { id: number; name: text; active: bool }
    model nx_mix max 8 { id: number; sid: number; name: text; note: text; level: number; muted: bool }
    model nx_ws max 10 { id: number; slot: number; label: text; windows: number; active: number }
    // The hub's four gauges (CPU, MEM, TEMP, DISK): the reading, its bar and its history.
    model nx_tel max 4 { id: number; on: bool; tone: number; label: text; value: text; sub: text; bar: number;
        s1: number; s2: number; s3: number; s4: number; s5: number; s6: number;
        s7: number; s8: number; s9: number; s10: number; s11: number; s12: number }

    // How the Nexus is showing: the compact hub under the mark, or the whole workspace. The
    // logic keeps the choice in `nexus.view`, so it opens the way it was left.
    fact nx_view: hub | full = hub
    // Where the hub hangs: under the bar's reserve, worked out by the logic from its settings.
    fact nx_top = 48
    // The Arch mark's centre along the bar (the bar writes it as it starts this program); -1
    // centres the hub on the screen.
    fact nx_hub_cx = -1
    // The bar's own switches, as the hub's tiles show them (read from the bar each reading).
    fact nx_dnd = false
    fact nx_caffeine = false
    fact nx_rec = false
    // The hub's own arrangement (lib/nexushub, published by the logic): the plate's width and
    // height, the hero's face and height, and where each section under it starts. A section that
    // takes no room is `nx_hon_* = false`. While customising, `nx_hub_edit_y` is the strip's place.
    fact nx_hub_w = 452
    fact nx_hub_h = 520
    fact nx_hub_hero: identity | player | reactor | both | minimal = identity
    fact nx_hub_hero_h = 92
    fact nx_hub_edit = false
    fact nx_hub_edit_y = -1
    fact nx_hub_wide = false
    fact nx_hy_tiles = 102
    fact nx_hy_levels = 216
    fact nx_hy_media = 296
    fact nx_hy_gauges = 368
    fact nx_hy_spaces = 432
    fact nx_hy_places = 466
    fact nx_hon_tiles = true
    fact nx_hon_levels = true
    fact nx_hon_media = false
    fact nx_hon_gauges = true
    fact nx_hon_spaces = true
    fact nx_hon_places = true
    // One row per section in the user's order, for the customise controls drawn over them.
    model nx_hsec max 6 { id: number; name: text; y: number; h: number; on: bool; stub: bool; hidden: bool;
        first: bool; last: bool; shown: bool }
    // The core's face at the centre of the workspace (`nexus.centre`).
    fact nx_centre: core | identity | player | both = core

    // System facts are populated by a bounded, optional Linux collector in the logic.
    fact nx_identity_edit_on = false
    text nx_identity_draft = "mooi system"
    fact nx_telemetry_on = false
    fact nx_cpu_on = false
    fact nx_cpu = 0
    text nx_cpu_label = "CPU LOAD"
    fact nx_gpu_on = false
    fact nx_gpu = 0
    text nx_gpu_value = "N/A"
    text nx_display_value = "DISPLAY INFO N/A"
    text nx_out_name = "—"
    text nx_in_name = "—"
    fact nx_ram_on = false
    fact nx_ram = 0
    fact nx_ram_used_gib = 0
    fact nx_ram_total_gib = 0
    fact nx_disk_on = false
    fact nx_disk = 0
    fact nx_net_on = false
    fact nx_rx = 0
    fact nx_tx = 0
    fact nx_temp_on = false
    fact nx_temp = 0
    text nx_cpu_value = "—"
    text nx_cpu_clock = "—"
    text nx_ram_value = "—"
    text nx_ram_avail = "—"
    text nx_swap = "—"
    text nx_load = "—"
    text nx_tasks = "—"
    text nx_disk_value = "—"
    text nx_disk_free = "—"
    text nx_disk_fs = "—"
    text nx_rx_value = "—"
    text nx_tx_value = "—"
    text nx_temp_value = "N/A"
    text nx_distro = "Reading system…"
    text nx_os_version = ""
    text nx_os_id = ""
    text nx_kernel = "—"
    text nx_uptime = "—"
    text nx_cpu_model = "—"
    fact nx_open = 0
    fact nx_pinned = false

    // What the workspace is showing: the arrangement, the selection, the mode and every
    // number a rule branches on. A text field can be drawn but not compared, so anything
    // conditional arrives as a fact.
    fact nx_arrangement_count = 0
    fact nx_node_count = 0
    fact nx_node_total = 0
    fact nx_removed_count = 0
    fact nx_mix_count = 0
    fact nx_ws_count = 0
    fact nx_focus: core | system | cpu | memory | gpu | thermal | storage | network | audio | display | workspaces | media | clock | power | applications | projects | notifications | quickactions | files = core
    fact nx_mode: circuit | minimal = circuit
    fact nx_banner_mode: full | compact | strip | hidden = compact
    fact nx_sel = 0
    fact nx_cw = 0
    fact nx_ch = 0
    fact nx_grid = true
    fact nx_app_sid = 0
    fact nx_app_lvl = 0
    text nx_status = ""
    text nx_arrangement_name = "FULL"
    text nx_focus_name = "Nexus Core"
    text nx_mode_name = "CIRCUIT"
    text nx_banner_name = "COMPACT"

    // The gestures the scene owns while a node is being carried or resized. The logic reads
    // the proposed geometry from the facts beside the event, the way the board does.
    fact nx_press = 0
    fact nx_drag = 0
    fact nx_gx = 0
    fact nx_gy = 0
    fact nx_rz = 0
    fact nx_rw = 0
    fact nx_rh = 0
    fact nx_menu = 0
    fact nx_undo_depth = 0
    fact nx_redo_depth = 0
    fact nx_edge_count = 0
    fact nx_edges_hidden = 0
    fact nx_edge_width = 1
    fact nx_edge_labels = true
    fact nx_edge_sel = 0
    fact nx_edge_speed = 1
    fact nx_show_trunk = true
    fact nx_hover = 0
    fact nx_clear = false
    fact nx_hover_edge = 0
    // Where a picked trace's chip is, so its card opens beside it.
    fact nx_ex = 0
    fact nx_ey = 0
    text nx_edge_label = ""
    text nx_edge_meaning = ""
    // One beat per reading from the logic; the traces' packets ride it (see `pz`).
    fact nx_beat = 0
    fact nx_signals = true
    text nx_menu_title = ""
    text nx_menu_min = "MINIMIZE"

    // ── The shell's surfaces (S5) ────────────────────────────
    // The panel docked on the right, the appearance the appearance panel edits, and the
    // selected node's own line, so the node panel says what it is acting on.
    fact nx_panel: none | library | node | look | layout = none
    // Where the panel was dragged to. Zero means "where it docks itself": the right edge
    // under the banner. The logic keeps it, so it is the same place next time it opens.
    fact nx_panel_x = 0
    fact nx_panel_y = 0
    fact nx_panel_dx = 0
    fact nx_panel_dy = 0
    fact nx_panel_gx = 0
    fact nx_panel_gy = 0
    fact nx_panel_carry = 0
    fact nx_lib_count = 0
    fact nx_lib_total = 19
    fact nx_lib_page = 1
    fact nx_lib_pages = 1
    fact nx_lib_page_size = 10
    fact nx_hidden_count = 0
    fact nx_sel_on = 0
    fact nx_sel_kind = 0
    text nx_sel_title = "NO NODE SELECTED"
    text nx_sel_note = "PRESS A NODE"
    text nx_lib_query = ""
    text nx_arr_draft = "FULL"
    fact nx_accent = 1
    fact nx_glow = 60
    fact nx_bright = 100
    fact nx_contrast = 100
    fact nx_opacity = 100
    fact nx_edge_style = 1
    fact nx_motion = true
    text nx_accent_name = "PHOS"
    fact nx_look_key = 0
    fact nx_look_val = 0

    fact st_glow = 1
    // The player's own fields, kept by the logic: a text field can be drawn and interpolated, but
    // it is not a number the scene can compare, so what is there to show arrives as facts.
    fact nx_has = false
    fact nx_playing = false
    fact nx_album_on = false
    fact nx_player_on = false
    fact nx_progress = 0
    fact nx_media_time_on = false
    text nx_elapsed = ""
    text nx_duration = ""
    fact nx_notice = false
    text nx_notice_text = ""
    text nx_identity_name = "mooi system"
    text nx_initial = "M"
    text nx_avatar_path = ""
    text nx_banner_path = ""
    fact nx_avatar_on = false
    fact nx_banner_on = false

    image nx_avatar = from nx_avatar_path, 42, 42
    image nx_banner = from nx_banner_path, 640, 74
    // The same pictures at the sizes the centre's faces draw them, so they stay sharp there.
    image nx_avatar_big = from nx_avatar_path, 120, 120
    image nx_banner_big = from nx_banner_path, 840, 300
    // The player's cover (the logic fetches one on the web into the data folder).
    text nx_art = ""
    fact nx_art_on = false
    image nx_cover = from nx_art, 240, 240
    // The visualiser: cava's twenty-four bands, eased on a quick spring; at rest they lie low.
    fact nv0 = 0.04
    fact nv1 = 0.04
    fact nv2 = 0.04
    fact nv3 = 0.04
    fact nv4 = 0.04
    fact nv5 = 0.04
    fact nv6 = 0.04
    fact nv7 = 0.04
    fact nv8 = 0.04
    fact nv9 = 0.04
    fact nv10 = 0.04
    fact nv11 = 0.04
    fact nv12 = 0.04
    fact nv13 = 0.04
    fact nv14 = 0.04
    fact nv15 = 0.04
    fact nv16 = 0.04
    fact nv17 = 0.04
    fact nv18 = 0.04
    fact nv19 = 0.04
    fact nv20 = 0.04
    fact nv21 = 0.04
    fact nv22 = 0.04
    fact nv23 = 0.04
    text nx_user = "operator"
    text nx_host = "Arch Linux"
    text nx_session = "Hyprland"
    text nx_title = ""
    text nx_artist = ""
    text nx_album = ""
    text nx_player = ""
    figure nx_mark = file "icons/nexus.svg"
    // The hub's glyphs: the shell's own line icons, tinted by the state they stand for.
    figure ic_wifi = file "icons/wifi.svg"
    figure ic_wifi_off = file "icons/wifi-off.svg"
    figure ic_eth = file "icons/ethernet.svg"
    figure ic_bt = file "icons/bluetooth.svg"
    figure ic_bt_off = file "icons/bluetooth-off.svg"
    figure ic_vol = file "icons/volume.svg"
    figure ic_vol_off = file "icons/volume-mute.svg"
    figure ic_mic = file "icons/mic.svg"
    figure ic_mic_off = file "icons/mic-off.svg"
    figure ic_bat = file "icons/battery.svg"
    figure ic_bolt = file "icons/bolt.svg"
    figure ic_sun = file "icons/sun.svg"
    figure ic_clip = file "icons/clipboard.svg"
    figure ic_music = file "icons/music.svg"
    figure ic_ws = file "icons/workspace.svg"
    figure ic_set = file "icons/settings.svg"
    figure ic_bell = file "icons/bell.svg"
    figure ic_caf = file "icons/caffeine.svg"
    figure ic_rec = file "icons/recorder.svg"
    figure ic_pow = file "icons/power.svg"
    figure ic_arr = file "icons/arrange.svg"
    shader field = file "shaders/nexus-field.wgsl"

    event nx_out_cycle ->        // to the logic: make the next output device the default
    event nx_in_cycle ->         // to the logic: make the next input device the default
    event nx_mic ->              // to the logic: mute or unmute the microphone
    event nx_mic_level ->        // to the logic: the microphone level, 0 … 1
    event nx_bt ->               // to the logic: the Bluetooth radio, 0 … 1
    event nx_diagnostics_copy ->
    event nx_identity_edit ->
    event nx_identity_save ->
    event nx_identity_cancel ->
    event nx_identity_avatar ->
    event nx_identity_banner ->
    event nx_close ->            // to the logic: put the Nexus away (× or Escape)
    event nx_pin ->              // to the logic: lock the arrangement (persisted in settings.json)
    event nx_vol ->              // to the logic: the output volume, 0 … 1
    event nx_mute ->             // to the logic: mute or unmute the output
    event nx_bri ->              // to the logic: the backlight, 0 … 1
    event nx_media ->            // to the logic: 1 previous · 0 play/pause · 2 next
    // The node workspace: every one of these carries a node's arrangement index.
    event nx_select ->           // to the logic: the pressed node
    event nx_drop ->             // to the logic: let go (nx_gx, nx_gy, nx_cw, nx_ch)
    event nx_resize ->           // to the logic: the grip let go (nx_rw, nx_rh)
    event nx_min ->              // to the logic: minimize or restore the node's body
    event nx_focus_node ->       // to the logic: bring the node to the centre
    event nx_remove ->           // to the logic: remove it from the layout
    event nx_restore ->          // to the logic: put a removed node back
    event nx_lib_add ->          // to the logic: add a library type to this arrangement (catalogue index)
    event nx_lib_page ->         // to the logic: turn a page of the library (-1 back, 1 on)
    event nx_panel_move ->       // to the logic: keep the panel where it was dropped (nx_panel_gx/gy)
    event nx_panel_dock ->       // to the logic: put the panel back on its default edge
    event nx_move ->             // to the logic: 1 left · 2 right · 3 up · 4 down
    event nx_move_fast ->        // to the logic: the same, four steps (Shift+arrow)
    event nx_cycle_sel_back ->   // to the logic: Shift+Tab, the previous node on the canvas
    event nx_mode_switch ->      // to the logic: 0 circuit · 1 minimal
    event nx_banner_cycle ->     // to the logic: full → compact → strip → hidden
    event nx_arrangement ->      // to the logic: show the arrangement at this index
    event nx_cycle_sel ->        // to the logic: Tab, the next node on the canvas
    event nx_tidy ->             // to the logic: repack the arrangement on the grid
    event nx_restore_centre ->   // to the logic: put the core back at the centre
    event nx_edge_pick ->        // to the logic: pick a trace, or put it down
    event nx_edge_hide ->        // to the logic: hide the picked trace
    event nx_edges_restore ->    // to the logic: bring every hidden trace back
    event nx_undo ->             // to the logic: step back one layout edit
    event nx_redo ->             // to the logic: step forward again
    event nx_app_mute ->         // to the logic: mute the stream with this id
    event nx_app_vol ->          // to the logic: set the stream's level (nx_app_sid, nx_app_lvl)
    event nx_ws_focus ->         // to the logic: go to the workspace with this id
    event nx_look ->             // to the logic: appearance control (nx_look_key, nx_look_val)
    event nx_node_preset ->      // to the logic: 1 S · 2 M · 3 L · 4 detail, for the selection
    event nx_node_reset ->       // to the logic: the selected node's shipped size and slot
    event nx_edge_show ->        // to the logic: bring back the hidden trace in this slot
    event nx_arr_new ->          // to the logic: keep the current arrangement under a new name
    event nx_arr_dup ->          // to the logic: a copy of the current arrangement
    event nx_arr_rename ->       // to the logic: name the current arrangement (nx_arr_draft)
    event nx_arr_del ->          // to the logic: drop the current arrangement
    event nx_canvas ->           // to the logic: the canvas the scene is drawing on settled
    event nx_hub_act ->          // to the logic: a hub tile or shortcut (1 quiet … 11 system island)
    event nx_view_set ->         // to the logic: 0 the compact hub · 1 the whole workspace
    event nx_hub_edit ->         // to the logic: customising the hub, on or off
    event nx_hub_hero ->         // to the logic: the hero's face (1 identity … 5 minimal)
    event nx_hub_size ->         // to the logic: the compact plate or the wide one
    event nx_hub_move ->         // to the logic: section * 10 + 1 up, + 2 down
    event nx_hub_toggle ->       // to the logic: hide the section, or show it again
    event nx_hub_reset ->        // to the logic: every section back, in the shipped order
    event nx_centre_set ->       // to the logic: the core's face (0 reactor · 1 identity · 2 player · 3 both)

    // A drawer row: a label on the left, the system's own answer on the right.
    component NRow(x: number, y: number, w: number, label: text, value: text, tone: color) {
        size: w, 22
        text label { at: x, y; anchor: left center; size: 8; family: "Share Tech Mono"; color: fl.muted }
        text value { at: x + w, y; anchor: right center; size: 10; family: "Exo 2"; width: w - 120; lines: 1; color: tone }
    }

    // A chip: one state, one press. The header's mode switch and the arrangements share it.
    component NChip(x: number, y: number, w: number, word: text, on: number, tone: color) {
        size: w, 20
        box { from: x, y; size: w, 20; corner: 3; color: mix(fl.ground, tone, 0.16); opacity: if(on, 0.9, 0.45) }
        box { from: x, y; size: w, 20; corner: 3; stroke: 1; color: if(on, tone, fl.trace); opacity: if(on, 0.9, 0.55) }
        text word { at: x + w / 2, y + 10; anchor: center; size: 8; weight: 700; family: "Share Tech Mono"
                    color: if(on, tone, fl.muted) }
    }

    // A caption with a rule running to its right: the panels and the canvas use it to group
    // what is under it without a box around everything.
    component NCaption(x: number, y: number, w: number, word: text, tone: color) {
        size: w, 12
        text "{upper(word)}" { at: x, y; anchor: left center; size: 7.5; weight: 700; family: "Share Tech Mono"; color: tone }
        box { from: x + min(w - 40, 104), y - 0.5; size: max(0, w - min(w - 40, 104)), 1; color: tone; opacity: 0.16 }
    }

    // A cut-corner plate with a word: the shell's one button, lit when it is the current
    // state and lifted when it is pointed at.
    component NButton(x: number, y: number, w: number, h: number, word: text, lit: number, tone: color, hot: number) {
        size: w, h
        let k = 4
        path { color: mix(fl.hull_raised, tone, 0.04 + hot * 0.1 + lit * 0.13); opacity: 0.96
               move x + k, y; line x + w - k, y; line x + w, y + k; line x + w, y + h - k
               line x + w - k, y + h; line x + k, y + h; line x, y + h - k; line x, y + k; close }
        path { stroke: 1; color: mix(fl.trace, tone, 0.25 + hot * 0.45 + lit * 0.3)
               move x + k, y; line x + w - k, y; line x + w, y + k; line x + w, y + h - k
               line x + w - k, y + h; line x + k, y + h; line x, y + h - k; line x, y + k; close }
        text "{upper(word)}" { at: x + w / 2, y + h / 2 + 0.5; anchor: center; size: 8; weight: 700
                              family: "Share Tech Mono"; width: w - 10; lines: 1
                              color: mix(fl.muted, tone, 0.18 + hot * 0.5 + lit * 0.66) }
        box { from: x + 6, y + h - 2; size: max(0, w - 12), 1.5; color: tone; opacity: 0.16 + lit * 0.78 }
    }

    // Four L-shaped brackets: the mark of a selected or centred frame.
    component NCorner(x: number, y: number, w: number, h: number, len: number, tone: color, op: number) {
        size: w, h
        line { from: x, y; to: x + len, y; width: 2; color: tone; opacity: op }
        line { from: x, y; to: x, y + len; width: 2; color: tone; opacity: op }
        line { from: x + w, y; to: x + w - len, y; width: 2; color: tone; opacity: op }
        line { from: x + w, y; to: x + w, y + len; width: 2; color: tone; opacity: op }
        line { from: x, y + h; to: x + len, y + h; width: 2; color: tone; opacity: op }
        line { from: x, y + h; to: x, y + h - len; width: 2; color: tone; opacity: op }
        line { from: x + w, y + h; to: x + w - len, y + h; width: 2; color: tone; opacity: op }
        line { from: x + w, y + h; to: x + w, y + h - len; width: 2; color: tone; opacity: op }
    }

    // The visualiser: twenty-four bands of cava's, standing on a baseline. `lit` dims it while
    // the player is paused (the bands lie low then anyway).
    component NViz(x: number, y: number, w: number, h: number, tone: color, lit: number) {
        size: w, h
        let bw = w / 24
        repeat k in 0..24 {
            let v = clamp(pick(k, nvp0, nvp1, nvp2, nvp3, nvp4, nvp5, nvp6, nvp7, nvp8, nvp9, nvp10, nvp11,
                               nvp12, nvp13, nvp14, nvp15, nvp16, nvp17, nvp18, nvp19, nvp20, nvp21, nvp22, nvp23), 0.04, 1)
            box { from: x + k * bw + bw * 0.18, y + h - max(1.5, v * h); size: bw * 0.64, max(1.5, v * h); corner: 1
                  color: mix(tone, fl.flare, v * 0.45); opacity: 0.35 + lit * 0.55 }
        }
        box { from: x, y + h + 1; size: w, 1; color: tone; opacity: 0.25 }
    }

    // The entrance settles rather than appears.
    spring nx.ext = 900, 51
    prop nx_a = 0 ~nx.ext
    on change nx_open while nx_open {
        nx_a: 1 ~nx.ext
        hh_p: nx_hub_h ~1ms; hy_tiles: nx_hy_tiles ~1ms; hy_levels: nx_hy_levels ~1ms; hy_media: nx_hy_media ~1ms
        hy_gauges: nx_hy_gauges ~1ms; hy_spaces: nx_hy_spaces ~1ms; hy_places: nx_hy_places ~1ms
    }
    on change nx_open while not nx_open { nx_a: 0 ~nx.ext }

    // A node travels with a little weight and settles; one that leaves or arrives fades.
    spring nx.move = 300, 30
    spring nx.fade = 600, 49
    // The packet's place along every live trace: one finite gesture per reading, so the
    // scene animates for 700 ms when the machine reports and rests until the next beat.
    pose nx_pk = 0
    gesture nx_packet asked {
        700ms in_out_sine { nx_pk: 1 }
        1ms
    }
    // the hub draws no traces, so it does not pay for their packets
    on change nx_beat while nx_view != hub { play nx_packet }

    // The core's reactor: each ring eases to its reading instead of jumping every 2 s, and
    // rests once it arrives (no frame clock while nothing changes).
    prop rc_cpu = 0 ~nx.move
    follow rc_cpu = nx_cpu
    prop rc_mem = 0 ~nx.move
    follow rc_mem = nx_ram
    prop rc_tmp = 0 ~nx.move
    follow rc_tmp = clamp(nx_temp / 100, 0, 1)
    prop rc_dsk = 0 ~nx.move
    follow rc_dsk = nx_disk

    // The visualiser's bands, quick to rise and quick to fall, as the bar's are.
    spring nx.level = 1200, 60
    prop nvp0 = 0.04 ~nx.level
    follow nvp0 = nv0
    prop nvp1 = 0.04 ~nx.level
    follow nvp1 = nv1
    prop nvp2 = 0.04 ~nx.level
    follow nvp2 = nv2
    prop nvp3 = 0.04 ~nx.level
    follow nvp3 = nv3
    prop nvp4 = 0.04 ~nx.level
    follow nvp4 = nv4
    prop nvp5 = 0.04 ~nx.level
    follow nvp5 = nv5
    prop nvp6 = 0.04 ~nx.level
    follow nvp6 = nv6
    prop nvp7 = 0.04 ~nx.level
    follow nvp7 = nv7
    prop nvp8 = 0.04 ~nx.level
    follow nvp8 = nv8
    prop nvp9 = 0.04 ~nx.level
    follow nvp9 = nv9
    prop nvp10 = 0.04 ~nx.level
    follow nvp10 = nv10
    prop nvp11 = 0.04 ~nx.level
    follow nvp11 = nv11
    prop nvp12 = 0.04 ~nx.level
    follow nvp12 = nv12
    prop nvp13 = 0.04 ~nx.level
    follow nvp13 = nv13
    prop nvp14 = 0.04 ~nx.level
    follow nvp14 = nv14
    prop nvp15 = 0.04 ~nx.level
    follow nvp15 = nv15
    prop nvp16 = 0.04 ~nx.level
    follow nvp16 = nv16
    prop nvp17 = 0.04 ~nx.level
    follow nvp17 = nv17
    prop nvp18 = 0.04 ~nx.level
    follow nvp18 = nv18
    prop nvp19 = 0.04 ~nx.level
    follow nvp19 = nv19
    prop nvp20 = 0.04 ~nx.level
    follow nvp20 = nv20
    prop nvp21 = 0.04 ~nx.level
    follow nvp21 = nv21
    prop nvp22 = 0.04 ~nx.level
    follow nvp22 = nv22
    prop nvp23 = 0.04 ~nx.level
    follow nvp23 = nv23

    // The hub's column glides when a section moves, hides or comes back; it opens already in place.
    prop hh_p = 520 ~nx.move
    follow hh_p = nx_hub_h
    prop hy_tiles = 102 ~nx.move
    follow hy_tiles = nx_hy_tiles
    prop hy_levels = 216 ~nx.move
    follow hy_levels = nx_hy_levels
    prop hy_media = 296 ~nx.move
    follow hy_media = nx_hy_media
    prop hy_gauges = 368 ~nx.move
    follow hy_gauges = nx_hy_gauges
    prop hy_spaces = 432 ~nx.move
    follow hy_spaces = nx_hy_spaces
    prop hy_places = 466 ~nx.move
    follow hy_places = nx_hy_places

    // Each slot's own springs: where its node is drawn while it travels, and how present
    // it is (a node leaving or arriving fades in place). They start at the canvas's
    // middle, so the arrangement unfolds from the core when the Nexus opens.
    prop nd_x.0 = 840 ~nx.move
    follow nd_x.0 = if(nx_drag == 1, nx_gx, nx_nodes.0.x)
    prop nd_y.0 = 380 ~nx.move
    follow nd_y.0 = if(nx_drag == 1, nx_gy, nx_nodes.0.y)
    prop nd_w.0 = 200 ~nx.move
    follow nd_w.0 = if(nx_rz == 1, nx_rw, nx_nodes.0.w)
    prop nd_h.0 = 120 ~nx.move
    follow nd_h.0 = if(nx_rz == 1, nx_rh, if(nx_nodes.0.mini, 34, nx_nodes.0.h))
    prop nd_o.0 = 0 ~nx.fade
    follow nd_o.0 = if(nx_nodes.0.on, 1, 0)
    prop nd_x.1 = 840 ~nx.move
    follow nd_x.1 = if(nx_drag == 2, nx_gx, nx_nodes.1.x)
    prop nd_y.1 = 380 ~nx.move
    follow nd_y.1 = if(nx_drag == 2, nx_gy, nx_nodes.1.y)
    prop nd_w.1 = 200 ~nx.move
    follow nd_w.1 = if(nx_rz == 2, nx_rw, nx_nodes.1.w)
    prop nd_h.1 = 120 ~nx.move
    follow nd_h.1 = if(nx_rz == 2, nx_rh, if(nx_nodes.1.mini, 34, nx_nodes.1.h))
    prop nd_o.1 = 0 ~nx.fade
    follow nd_o.1 = if(nx_nodes.1.on, 1, 0)
    prop nd_x.2 = 840 ~nx.move
    follow nd_x.2 = if(nx_drag == 3, nx_gx, nx_nodes.2.x)
    prop nd_y.2 = 380 ~nx.move
    follow nd_y.2 = if(nx_drag == 3, nx_gy, nx_nodes.2.y)
    prop nd_w.2 = 200 ~nx.move
    follow nd_w.2 = if(nx_rz == 3, nx_rw, nx_nodes.2.w)
    prop nd_h.2 = 120 ~nx.move
    follow nd_h.2 = if(nx_rz == 3, nx_rh, if(nx_nodes.2.mini, 34, nx_nodes.2.h))
    prop nd_o.2 = 0 ~nx.fade
    follow nd_o.2 = if(nx_nodes.2.on, 1, 0)
    prop nd_x.3 = 840 ~nx.move
    follow nd_x.3 = if(nx_drag == 4, nx_gx, nx_nodes.3.x)
    prop nd_y.3 = 380 ~nx.move
    follow nd_y.3 = if(nx_drag == 4, nx_gy, nx_nodes.3.y)
    prop nd_w.3 = 200 ~nx.move
    follow nd_w.3 = if(nx_rz == 4, nx_rw, nx_nodes.3.w)
    prop nd_h.3 = 120 ~nx.move
    follow nd_h.3 = if(nx_rz == 4, nx_rh, if(nx_nodes.3.mini, 34, nx_nodes.3.h))
    prop nd_o.3 = 0 ~nx.fade
    follow nd_o.3 = if(nx_nodes.3.on, 1, 0)
    prop nd_x.4 = 840 ~nx.move
    follow nd_x.4 = if(nx_drag == 5, nx_gx, nx_nodes.4.x)
    prop nd_y.4 = 380 ~nx.move
    follow nd_y.4 = if(nx_drag == 5, nx_gy, nx_nodes.4.y)
    prop nd_w.4 = 200 ~nx.move
    follow nd_w.4 = if(nx_rz == 5, nx_rw, nx_nodes.4.w)
    prop nd_h.4 = 120 ~nx.move
    follow nd_h.4 = if(nx_rz == 5, nx_rh, if(nx_nodes.4.mini, 34, nx_nodes.4.h))
    prop nd_o.4 = 0 ~nx.fade
    follow nd_o.4 = if(nx_nodes.4.on, 1, 0)
    prop nd_x.5 = 840 ~nx.move
    follow nd_x.5 = if(nx_drag == 6, nx_gx, nx_nodes.5.x)
    prop nd_y.5 = 380 ~nx.move
    follow nd_y.5 = if(nx_drag == 6, nx_gy, nx_nodes.5.y)
    prop nd_w.5 = 200 ~nx.move
    follow nd_w.5 = if(nx_rz == 6, nx_rw, nx_nodes.5.w)
    prop nd_h.5 = 120 ~nx.move
    follow nd_h.5 = if(nx_rz == 6, nx_rh, if(nx_nodes.5.mini, 34, nx_nodes.5.h))
    prop nd_o.5 = 0 ~nx.fade
    follow nd_o.5 = if(nx_nodes.5.on, 1, 0)
    prop nd_x.6 = 840 ~nx.move
    follow nd_x.6 = if(nx_drag == 7, nx_gx, nx_nodes.6.x)
    prop nd_y.6 = 380 ~nx.move
    follow nd_y.6 = if(nx_drag == 7, nx_gy, nx_nodes.6.y)
    prop nd_w.6 = 200 ~nx.move
    follow nd_w.6 = if(nx_rz == 7, nx_rw, nx_nodes.6.w)
    prop nd_h.6 = 120 ~nx.move
    follow nd_h.6 = if(nx_rz == 7, nx_rh, if(nx_nodes.6.mini, 34, nx_nodes.6.h))
    prop nd_o.6 = 0 ~nx.fade
    follow nd_o.6 = if(nx_nodes.6.on, 1, 0)
    prop nd_x.7 = 840 ~nx.move
    follow nd_x.7 = if(nx_drag == 8, nx_gx, nx_nodes.7.x)
    prop nd_y.7 = 380 ~nx.move
    follow nd_y.7 = if(nx_drag == 8, nx_gy, nx_nodes.7.y)
    prop nd_w.7 = 200 ~nx.move
    follow nd_w.7 = if(nx_rz == 8, nx_rw, nx_nodes.7.w)
    prop nd_h.7 = 120 ~nx.move
    follow nd_h.7 = if(nx_rz == 8, nx_rh, if(nx_nodes.7.mini, 34, nx_nodes.7.h))
    prop nd_o.7 = 0 ~nx.fade
    follow nd_o.7 = if(nx_nodes.7.on, 1, 0)
    prop nd_x.8 = 840 ~nx.move
    follow nd_x.8 = if(nx_drag == 9, nx_gx, nx_nodes.8.x)
    prop nd_y.8 = 380 ~nx.move
    follow nd_y.8 = if(nx_drag == 9, nx_gy, nx_nodes.8.y)
    prop nd_w.8 = 200 ~nx.move
    follow nd_w.8 = if(nx_rz == 9, nx_rw, nx_nodes.8.w)
    prop nd_h.8 = 120 ~nx.move
    follow nd_h.8 = if(nx_rz == 9, nx_rh, if(nx_nodes.8.mini, 34, nx_nodes.8.h))
    prop nd_o.8 = 0 ~nx.fade
    follow nd_o.8 = if(nx_nodes.8.on, 1, 0)
    prop nd_x.9 = 840 ~nx.move
    follow nd_x.9 = if(nx_drag == 10, nx_gx, nx_nodes.9.x)
    prop nd_y.9 = 380 ~nx.move
    follow nd_y.9 = if(nx_drag == 10, nx_gy, nx_nodes.9.y)
    prop nd_w.9 = 200 ~nx.move
    follow nd_w.9 = if(nx_rz == 10, nx_rw, nx_nodes.9.w)
    prop nd_h.9 = 120 ~nx.move
    follow nd_h.9 = if(nx_rz == 10, nx_rh, if(nx_nodes.9.mini, 34, nx_nodes.9.h))
    prop nd_o.9 = 0 ~nx.fade
    follow nd_o.9 = if(nx_nodes.9.on, 1, 0)
    prop nd_x.10 = 840 ~nx.move
    follow nd_x.10 = if(nx_drag == 11, nx_gx, nx_nodes.10.x)
    prop nd_y.10 = 380 ~nx.move
    follow nd_y.10 = if(nx_drag == 11, nx_gy, nx_nodes.10.y)
    prop nd_w.10 = 200 ~nx.move
    follow nd_w.10 = if(nx_rz == 11, nx_rw, nx_nodes.10.w)
    prop nd_h.10 = 120 ~nx.move
    follow nd_h.10 = if(nx_rz == 11, nx_rh, if(nx_nodes.10.mini, 34, nx_nodes.10.h))
    prop nd_o.10 = 0 ~nx.fade
    follow nd_o.10 = if(nx_nodes.10.on, 1, 0)
    prop nd_x.11 = 840 ~nx.move
    follow nd_x.11 = if(nx_drag == 12, nx_gx, nx_nodes.11.x)
    prop nd_y.11 = 380 ~nx.move
    follow nd_y.11 = if(nx_drag == 12, nx_gy, nx_nodes.11.y)
    prop nd_w.11 = 200 ~nx.move
    follow nd_w.11 = if(nx_rz == 12, nx_rw, nx_nodes.11.w)
    prop nd_h.11 = 120 ~nx.move
    follow nd_h.11 = if(nx_rz == 12, nx_rh, if(nx_nodes.11.mini, 34, nx_nodes.11.h))
    prop nd_o.11 = 0 ~nx.fade
    follow nd_o.11 = if(nx_nodes.11.on, 1, 0)
    prop nd_x.12 = 840 ~nx.move
    follow nd_x.12 = if(nx_drag == 13, nx_gx, nx_nodes.12.x)
    prop nd_y.12 = 380 ~nx.move
    follow nd_y.12 = if(nx_drag == 13, nx_gy, nx_nodes.12.y)
    prop nd_w.12 = 200 ~nx.move
    follow nd_w.12 = if(nx_rz == 13, nx_rw, nx_nodes.12.w)
    prop nd_h.12 = 120 ~nx.move
    follow nd_h.12 = if(nx_rz == 13, nx_rh, if(nx_nodes.12.mini, 34, nx_nodes.12.h))
    prop nd_o.12 = 0 ~nx.fade
    follow nd_o.12 = if(nx_nodes.12.on, 1, 0)
    prop nd_x.13 = 840 ~nx.move
    follow nd_x.13 = if(nx_drag == 14, nx_gx, nx_nodes.13.x)
    prop nd_y.13 = 380 ~nx.move
    follow nd_y.13 = if(nx_drag == 14, nx_gy, nx_nodes.13.y)
    prop nd_w.13 = 200 ~nx.move
    follow nd_w.13 = if(nx_rz == 14, nx_rw, nx_nodes.13.w)
    prop nd_h.13 = 120 ~nx.move
    follow nd_h.13 = if(nx_rz == 14, nx_rh, if(nx_nodes.13.mini, 34, nx_nodes.13.h))
    prop nd_o.13 = 0 ~nx.fade
    follow nd_o.13 = if(nx_nodes.13.on, 1, 0)

    surface nexus {
        size: full, full
        anchor: top
        reserve: -1
        level: overlay
        // This scene's only surface: the Nexus holds the keyboard while it is up. The bar lets go
        // of its own before it starts this program (D65).
        keyboard: exclusive

        let sw = screen.width
        let sh = screen.height
        // Three sizes of the same shell: tight drops the banner's extra lines, small keeps
        // only the controls that act on the workspace, tiny folds the banner to its strip and
        // gives the canvas the status strip's room.
        let tiny = sw < 760 or sh < 500
        let small = sw < 1060
        let tight = sw < 1360
        let head = if(tiny, 38, 46)
        let foot = if(tiny, 0, 32)
        let banner_want = if(nx_banner_mode == full, 118, if(nx_banner_mode == compact, 78, if(nx_banner_mode == strip, 46, 0)))
        let banner = if(tiny and banner_want > 0, 46, banner_want)
        let cy = head + banner
        let ch = max(140, sh - cy - foot)
        let cx = if(tiny, 8, 20)
        let cw = max(300, sw - cx * 2)
        let rail = if(tiny, 24, 30)
        // The shell's accent is the appearance's accent role: one colour, chosen in LOOK.
        // A colour named from the roles by number, so the accent follows the palette's own
        // springs: the appearance panel picks a role, never a hex.
        let ac = rgb(
            if(nx_accent == 1, pr_phos_r, if(nx_accent == 2, pr_flare_r, if(nx_accent == 3, pr_ember_r, pr_trace_lit_r))),
            if(nx_accent == 1, pr_phos_g, if(nx_accent == 2, pr_flare_g, if(nx_accent == 3, pr_ember_g, pr_trace_lit_g))),
            if(nx_accent == 1, pr_phos_b, if(nx_accent == 2, pr_flare_b, if(nx_accent == 3, pr_ember_b, pr_trace_lit_b))))
        let ac_soft = mix(fl.trace, ac, 0.6)
        let glow_amt = nx_glow / 100
        // How solid the plate is. It is applied to the fills one by one rather than to the
        // whole group: a group opacity of its own makes the renderer keep the entire
        // 1920-wide scene in an offscreen layer and repaint all of it whenever anything
        // moves, which cost ~100 ms a frame — the whole program's lag (D86).
        let nx_fill = clamp(nx_opacity / 100, 0.25, 1)

        // ── the hub: the Nexus folded to a plate under the mark ──
        // The everyday command centre (iNiR's control panel, in the Ferrolume hand): a hero face
        // of the user's choosing — who you are, what is playing, the machine, or both of the
        // first two — then the sections under it in the user's order (lib/nexushub): the switches
        // as tiles, the levels, what is playing, the machine in four gauges, the workspaces and
        // the places one press away. CUSTOMISE puts the controls for all of that on the plate.
        // It hangs under the mark and leaves the desktop visible around it; a press anywhere
        // outside puts it away, as the bar's islands do.
        let hw = if(sw < nx_hub_w + 40, sw - 20, nx_hub_w)
        let hx = clamp(if(nx_hub_cx > 0, nx_hub_cx - hw / 2, (sw - hw) / 2), 10, sw - hw - 10)
        let hy = nx_top
        let hmx = clamp(if(nx_hub_cx > 0, nx_hub_cx, sw / 2) - hx, 24, hw - 24)
        let hband = nx_hub_hero_h
        let hh = hh_p
        let htw = (hw - 24 - 3 * 6) / 4
        let hgw = (hw - 24 - 3 * 6) / 4
        let hedit = nx_hub_edit
        group {
            show: nx_a > 0.004 and nx_view == hub

            // a press outside the plate puts the hub away (it is under everything the plate holds)
            zone box nx_hub_away { from: 0, 0; size: sw, sh; label: "Close Control Nexus"; agent: hidden }
            on press nx_hub_away { emit nx_close }

            group {
                move: hx, hy - (1 - nx_a) * 14
                scale: 0.97 + nx_a * 0.03
                // the plate swallows its own presses, so only the outside closes it
                zone box nx_hub_body { from: 0, 0; size: hw, hh; agent: hidden }

                // the plate: solid whatever the workspace's own opacity (a popover over live
                // windows must not let their text through), a lit rim, the tab to the mark
                group {
                    glow: 18, 26% * glow_amt, ac
                    Chamfer(0, 0, hw, hh, 10, fl.hull, mix(fl.trace, ac, 0.35), 1, 1)
                }
                path { color: ac; opacity: 0.9
                       move hmx - 18, 0; line hmx + 18, 0; line hmx + 12, 3; line hmx - 12, 3; close }

                // ── the hero's ground: the banner (or the cover, for the player) under a scrim ──
                group {
                    clip box { from: 1, 1; size: hw - 2, hband }
                    body { gradient: 0, 0 to 0, hband, fl.hull_raised, fl.hull
                           box { from: 0, 0; size: hw, hband } }
                    image nx_banner { at: (hw - 797) / 2, 0; size: 797, max(hband, 92); opacity: 0.9
                                      show: nx_banner_on and nx_hub_hero != player }
                    // the player's ground is its own cover, enlarged and out of focus
                    group {
                        show: nx_art_on and (nx_hub_hero == player or nx_hub_hero == both)
                        blur: 22
                        image nx_cover { at: -20, hband / 2 - (hw + 40) / 2; size: hw + 40, hw + 40; opacity: 0.55 }
                    }
                    // the scrim: dark under the words (left and foot), the picture clear at the top right
                    body { gradient: 0, 0 to hw * 0.75, 0, fl.hull, fl.hull_raised
                           box { from: 0, 0; size: hw * 0.75, hband }; opacity: 0.55 }
                    body { gradient: 0, hband * 0.45 to 0, hband, fl.hull_raised, fl.hull
                           box { from: 0, hband * 0.45; size: hw, hband * 0.55 }; opacity: 0.6 }
                }
                box { from: 1, hband; size: hw - 2, 1; color: mix(fl.trace, ac, 0.5); opacity: 0.8 }

                // ── the plate's own controls, the same on every face: customise, settings,
                //    the whole workspace, close ──
                zone box nx_hub_cus { from: hw - 150, 8; size: 26, 22; cursor: pointer; role: toggle; checked: hedit
                                      label: "Customise the hub" }
                NButton(hw - 150, 8, 26, 22, "", if(hedit, 1, 0), ac, nx_hub_cus.hover)
                figure ic_arr { at: hw - 137, 19; size: 13, 13; color: if(hedit, ac, mix(fl.muted, ac, 0.4 + nx_hub_cus.hover * 0.6)) }
                on press nx_hub_cus { emit nx_hub_edit }
                zone box nx_hub_set { from: hw - 120, 8; size: 26, 22; cursor: pointer; role: button; label: "Open mooi's settings" }
                NButton(hw - 120, 8, 26, 22, "", 0, ac, nx_hub_set.hover)
                figure ic_set { at: hw - 107, 19; size: 14, 14; color: mix(fl.muted, ac, 0.4 + nx_hub_set.hover * 0.6) }
                on press nx_hub_set { emit nx_hub_act(6) }
                zone box nx_hub_full { from: hw - 90, 8; size: 46, 22; cursor: pointer; role: button
                                       label: "Open the whole Nexus workspace" }
                NButton(hw - 90, 8, 46, 22, "FULL", 0, ac, nx_hub_full.hover)
                on press nx_hub_full { emit nx_view_set(1) }
                zone box nx_hub_x { from: hw - 40, 8; size: 26, 22; cursor: pointer; role: button; label: "Close Control Nexus" }
                NButton(hw - 40, 8, 26, 22, "×", 0, fl.ember, nx_hub_x.hover)
                on press nx_hub_x { emit nx_close }

                // ── IDENTITY: the avatar, the name, user@host, the uptime, the time ──
                group {
                    show: nx_hub_hero == identity
                    Chamfer(14, 24, 54, 54, 8, fl.well, mix(fl.trace, ac, 0.6), 1, 1)
                    image nx_avatar { at: 20, 30; size: 42, 42; show: nx_avatar_on }
                    text nx_initial { at: 41, 51; anchor: center; size: 20; weight: 700; family: "Exo 2"; color: ac; show: not nx_avatar_on }
                    box { from: 14, 76; size: 54, 2; color: ac; opacity: 0.85 }
                    text nx_identity_name { at: 80, 44; anchor: left center; size: 14; weight: 700; family: "Exo 2"
                                            width: hw - 240; lines: 1; color: fl.engrave }
                    text "{upper(nx_user)}@{upper(nx_host)}  ·  {upper(nx_session)}" { at: 80, 62; anchor: left center; size: 7.2
                          family: "Share Tech Mono"; width: hw - 210; lines: 1; color: mix(fl.muted, ac, 0.3) }
                    text "UP {upper(nx_uptime)}" { at: 80, 75; anchor: left center; size: 6.8; family: "Share Tech Mono"
                                                   width: hw - 210; lines: 1; color: fl.muted }
                    text clock.time { at: hw - 14, 58; anchor: right center; size: 22; weight: 700; family: "Exo 2"
                                      color: mix(fl.engrave, ac, 0.35) }
                    text "{upper(clock.date)}" { at: hw - 14, 77; anchor: right center; size: 7; family: "Share Tech Mono"; color: fl.muted }
                }

                // ── MINIMAL: one line — the avatar, the name, the time ──
                group {
                    show: nx_hub_hero == minimal
                    Chamfer(12, 9, 28, 28, 5, fl.well, mix(fl.trace, ac, 0.6), 1, 1)
                    image nx_avatar { at: 14, 11; size: 24, 24; show: nx_avatar_on }
                    text nx_initial { at: 26, 23; anchor: center; size: 12; weight: 700; family: "Exo 2"; color: ac; show: not nx_avatar_on }
                    text nx_identity_name { at: 50, 18; anchor: left center; size: 11; weight: 700; family: "Exo 2"
                                            width: hw - 270; lines: 1; color: fl.engrave }
                    text "{upper(nx_user)}@{upper(nx_host)}" { at: 50, 31; anchor: left center; size: 6.6; family: "Share Tech Mono"
                          width: hw - 270; lines: 1; color: fl.muted }
                    text clock.time { at: hw - 160, 23; anchor: right center; size: 15; weight: 700; family: "Exo 2"
                                      color: mix(fl.engrave, ac, 0.35) }
                }

                // ── REACTOR: the machine's four rings, the host, and the readings beside them ──
                group {
                    show: nx_hub_hero == reactor
                    let rcx = 62
                    let rcy = 60
                    arc { at: rcx, rcy; radius: 40; width: 5; span: 360deg; color: fl.well; opacity: 0.9 }
                    arc { at: rcx, rcy; radius: 32; width: 5; span: 360deg; color: fl.well; opacity: 0.9 }
                    arc { at: rcx, rcy; radius: 24; width: 5; span: 360deg; color: fl.well; opacity: 0.9 }
                    arc { at: rcx, rcy; radius: 16; width: 5; span: 360deg; color: fl.well; opacity: 0.9 }
                    group {
                        glow: 8, 40% * glow_amt, ac
                        arc { at: rcx, rcy; radius: 40; width: 5; span: rc_cpu * 360deg; rotate: rc_cpu * 180deg; color: ac; show: nx_cpu_on }
                        arc { at: rcx, rcy; radius: 32; width: 5; span: rc_mem * 360deg; rotate: rc_mem * 180deg; color: fl.trace_lit; show: nx_ram_on }
                        arc { at: rcx, rcy; radius: 24; width: 5; span: rc_tmp * 360deg; rotate: rc_tmp * 180deg; color: fl.ember; show: nx_temp_on }
                        arc { at: rcx, rcy; radius: 16; width: 5; span: rc_dsk * 360deg; rotate: rc_dsk * 180deg; color: fl.flare; show: nx_disk_on }
                    }
                    text "{upper(nx_host)}" { at: 120, 44; anchor: left center; size: 15; weight: 700; family: "Exo 2"
                                              width: hw - 290; lines: 1; color: fl.engrave }
                    text "{upper(nx_distro)}  ·  UP {upper(nx_uptime)}" { at: 120, 60; anchor: left center; size: 7
                          family: "Share Tech Mono"; width: hw - 140; lines: 1; color: mix(fl.muted, ac, 0.3) }
                    repeat k in 0..4 {
                        let rx = 120 + k * (hw - 134) / 4
                        box { from: rx, 76; size: 10, 2.5; color: pick(k, ac, fl.trace_lit, fl.ember, fl.flare) }
                        text pick(k, "LOAD", "MEM", "TEMP", "DISK") { at: rx, 86; anchor: left center; size: 6.4; weight: 700
                              family: "Share Tech Mono"; color: fl.muted }
                    }
                    text "{rc_cpu * 100, 0}%" { at: 120, 99; anchor: left center; size: 12; weight: 700; family: "Exo 2"; color: ac }
                    text "{rc_mem * 100, 0}%" { at: 120 + (hw - 134) / 4, 99; anchor: left center; size: 12; weight: 700; family: "Exo 2"; color: fl.trace_lit }
                    text nx_temp_value { at: 120 + (hw - 134) / 2, 99; anchor: left center; size: 12; weight: 700; family: "Exo 2"; color: fl.ember }
                    text "{rc_dsk * 100, 0}%" { at: 120 + (hw - 134) * 3 / 4, 99; anchor: left center; size: 12; weight: 700; family: "Exo 2"; color: fl.flare }
                    text clock.time { at: hw - 14, 44; anchor: right center; size: 15; weight: 700; family: "Exo 2"; color: mix(fl.engrave, ac, 0.35) }
                }

                // ── ID + PLAYER: who you are on a line, then the player under it ──
                group {
                    show: nx_hub_hero == both
                    Chamfer(14, 10, 40, 40, 6, fl.well, mix(fl.trace, ac, 0.6), 1, 1)
                    image nx_avatar { at: 17, 13; size: 34, 34; show: nx_avatar_on }
                    text nx_initial { at: 34, 30; anchor: center; size: 16; weight: 700; family: "Exo 2"; color: ac; show: not nx_avatar_on }
                    text nx_identity_name { at: 64, 22; anchor: left center; size: 12.5; weight: 700; family: "Exo 2"
                                            width: hw - 240; lines: 1; color: fl.engrave }
                    text "{upper(nx_user)}@{upper(nx_host)}  ·  {clock.time}" { at: 64, 39; anchor: left center; size: 7
                          family: "Share Tech Mono"; width: hw - 240; lines: 1; color: mix(fl.muted, ac, 0.3) }
                    box { from: 14, 58; size: hw - 28, 1; color: mix(fl.trace, ac, 0.3); opacity: 0.6 }
                }

                // ── PLAYER (and the lower half of ID + PLAYER): the cover, the track, the
                //    transport, the visualiser and the time ──
                group {
                    show: nx_hub_hero == player or nx_hub_hero == both
                    let py = if(nx_hub_hero == both, 66, 34)
                    let pa = if(nx_hub_hero == both, 72, 84)
                    let ptx = 14 + pa + 12
                    text "NOW PLAYING  ·  {upper(nx_player)}" { at: 14, 19; anchor: left center; size: 7
                          weight: 700; family: "Share Tech Mono"; width: hw - 180; lines: 1; color: mix(fl.muted, ac, 0.5)
                          show: nx_hub_hero == player and nx_player_on }
                    text "NOW PLAYING" { at: 14, 19; anchor: left center; size: 7; weight: 700; family: "Share Tech Mono"
                          color: mix(fl.muted, ac, 0.5); show: nx_hub_hero == player and not nx_player_on }
                    Chamfer(14, py, pa, pa, 7, fl.well, mix(fl.trace, ac, if(nx_playing, 0.7, 0.35)), 1, 1)
                    image nx_cover { at: 17, py + 3; size: pa - 6, pa - 6; show: nx_art_on and nx_has }
                    figure ic_music { at: 14 + pa / 2, py + pa / 2; size: 24, 24; color: if(nx_playing, ac, fl.muted); show: not (nx_art_on and nx_has) }
                    text pick(nx_has, "NOTHING PLAYING", nx_title) { at: ptx, py + 9; anchor: left center; size: 12; weight: 700
                          family: "Exo 2"; width: hw - ptx - 14; lines: 1; color: fl.engrave }
                    text pick(nx_has, "START A PLAYER TO SEE IT HERE", "{upper(nx_artist)}") { at: ptx, py + 25; anchor: left center
                          size: 7.4; family: "Share Tech Mono"; width: hw - ptx - 14; lines: 1; color: mix(fl.muted, ac, 0.35) }
                    // the transport
                    group {
                        show: nx_has
                        zone box nx_hub_prev { from: ptx, py + 34; size: 28, 22; cursor: pointer; role: button; label: "Previous track" }
                        NButton(ptx, py + 34, 28, 22, "‹‹", 0, ac, nx_hub_prev.hover)
                        on press nx_hub_prev { emit nx_media(1) }
                        zone box nx_hub_play { from: ptx + 32, py + 33; size: 36, 24; cursor: pointer; role: button
                                               label: pick(med.playing, "Play", "Pause") }
                        group { show: not med.playing
                            NButton(ptx + 32, py + 33, 36, 24, "▶", 0, ac, nx_hub_play.hover) }
                        group { show: med.playing
                            NButton(ptx + 32, py + 33, 36, 24, "❚❚", 1, ac, nx_hub_play.hover) }
                        on press nx_hub_play { emit nx_media(0) }
                        zone box nx_hub_next { from: ptx + 72, py + 34; size: 28, 22; cursor: pointer; role: button; label: "Next track" }
                        NButton(ptx + 72, py + 34, 28, 22, "››", 0, ac, nx_hub_next.hover)
                        on press nx_hub_next { emit nx_media(2) }
                    }
                    // the visualiser beside the transport
                    NViz(ptx + 112, py + 32, hw - ptx - 112 - 14, 26, ac, if(nx_playing, 1, 0))
                    // the time
                    box { from: ptx, py + pa - 12; size: hw - ptx - 14, 2; color: fl.trace; opacity: 0.5 }
                    box { from: ptx, py + pa - 12; size: (hw - ptx - 14) * clamp(nx_progress, 0, 1), 2; color: ac; opacity: 0.9; show: nx_has }
                    text nx_elapsed { at: ptx, py + pa - 2; anchor: left center; size: 6.4; family: "Share Tech Mono"; color: fl.muted
                                      show: nx_media_time_on and nx_has }
                    text nx_duration { at: hw - 14, py + pa - 2; anchor: right center; size: 6.4; family: "Share Tech Mono"; color: fl.muted
                                       show: nx_media_time_on and nx_has }
                }

                // ── the customise strip: the hero's face, the width, reset, done ──
                group {
                    show: hedit and nx_hub_edit_y >= 0
                    let hey = nx_hub_edit_y
                    let ecw = (hw - 24 - 4 * 4) / 5
                    Chamfer(12, hey, hw - 24, 62, 6, mix(fl.well, ac, 0.06), mix(fl.trace, ac, 0.6), 0.95, 1)
                    text "CUSTOMISE · THE FACE ON TOP" { at: 20, hey + 11; anchor: left center; size: 6.6; weight: 700
                                                        family: "Share Tech Mono"; color: ac }
                    text "▲ ▼ MOVE A SECTION · ◉ HIDES IT" { at: hw - 20, hey + 11; anchor: right center; size: 6.4
                                                             family: "Share Tech Mono"; color: fl.muted }
                    zone box nx_he_1 { from: 16, hey + 18; size: ecw, 20; cursor: pointer; role: tab; selected: nx_hub_hero == identity; label: "Identity face" }
                    NChip(16, hey + 18, ecw, "IDENTITY", if(nx_hub_hero == identity, 1, 0), ac)
                    on press nx_he_1 { emit nx_hub_hero(1) }
                    zone box nx_he_2 { from: 16 + (ecw + 4), hey + 18; size: ecw, 20; cursor: pointer; role: tab; selected: nx_hub_hero == player; label: "Player face" }
                    NChip(16 + (ecw + 4), hey + 18, ecw, "PLAYER", if(nx_hub_hero == player, 1, 0), ac)
                    on press nx_he_2 { emit nx_hub_hero(2) }
                    zone box nx_he_3 { from: 16 + (ecw + 4) * 2, hey + 18; size: ecw, 20; cursor: pointer; role: tab; selected: nx_hub_hero == reactor; label: "Reactor face" }
                    NChip(16 + (ecw + 4) * 2, hey + 18, ecw, "REACTOR", if(nx_hub_hero == reactor, 1, 0), ac)
                    on press nx_he_3 { emit nx_hub_hero(3) }
                    zone box nx_he_4 { from: 16 + (ecw + 4) * 3, hey + 18; size: ecw, 20; cursor: pointer; role: tab; selected: nx_hub_hero == both; label: "Identity and player face" }
                    NChip(16 + (ecw + 4) * 3, hey + 18, ecw, "ID + PLAYER", if(nx_hub_hero == both, 1, 0), ac)
                    on press nx_he_4 { emit nx_hub_hero(4) }
                    zone box nx_he_5 { from: 16 + (ecw + 4) * 4, hey + 18; size: ecw, 20; cursor: pointer; role: tab; selected: nx_hub_hero == minimal; label: "Minimal face" }
                    NChip(16 + (ecw + 4) * 4, hey + 18, ecw, "MINIMAL", if(nx_hub_hero == minimal, 1, 0), ac)
                    on press nx_he_5 { emit nx_hub_hero(5) }
                    let ebw = (hw - 24 - 2 * 6) / 3
                    zone box nx_he_size { from: 16, hey + 42; size: ebw - 4, 16; cursor: pointer; role: toggle; checked: nx_hub_wide
                                          label: "Wide or compact plate" }
                    NChip(16, hey + 42, ebw - 4, pick(nx_hub_wide, "WIDTH · COMPACT", "WIDTH · WIDE"), 0, ac)
                    on press nx_he_size { emit nx_hub_size }
                    zone box nx_he_reset { from: 16 + ebw + 2, hey + 42; size: ebw - 4, 16; cursor: pointer; role: button
                                           label: "Every section back, in the shipped order" }
                    NChip(16 + ebw + 2, hey + 42, ebw - 4, "RESET SECTIONS", 0, fl.flare)
                    on press nx_he_reset { emit nx_hub_reset }
                    zone box nx_he_done { from: 16 + (ebw + 2) * 2, hey + 42; size: ebw - 4, 16; cursor: pointer; role: button; label: "Done customising" }
                    NChip(16 + (ebw + 2) * 2, hey + 42, ebw - 4, "DONE", 1, ac)
                    on press nx_he_done { emit nx_hub_edit }
                }

                // ── SWITCHES: eight tiles, lit while on ──
                // row 1: network, Bluetooth, sound, microphone · row 2: quiet, awake, record, power
                group {
                    show: nx_hon_tiles
                    move: 0, hy_tiles
                    let htile_y = 0
                    let htx0 = 12 + 0 * (htw + 6)
                    let hty0 = htile_y + 0
                    let htx1 = 12 + 1 * (htw + 6)
                    let hty1 = htile_y + 0
                    let htx2 = 12 + 2 * (htw + 6)
                    let hty2 = htile_y + 0
                    let htx3 = 12 + 3 * (htw + 6)
                    let hty3 = htile_y + 0
                    let htx4 = 12 + 0 * (htw + 6)
                    let hty4 = htile_y + 56
                    let htx5 = 12 + 1 * (htw + 6)
                    let hty5 = htile_y + 56
                    let htx6 = 12 + 2 * (htw + 6)
                    let hty6 = htile_y + 56
                    let htx7 = 12 + 3 * (htw + 6)
                    let hty7 = htile_y + 56
                // NETWORK — its link; a press opens the system island (Wi-Fi, Bluetooth, sound)
                zone box nx_t_net { from: htx0, hty0; size: htw, 50; cursor: pointer; role: button
                                    label: "Network — open the system controls" }
                Chamfer(htx0, hty0, htw, 50, 6, mix(fl.well, ac, if(network.online, 0.16, 0) + nx_t_net.hover * 0.08),
                        if(network.online, mix(fl.trace, ac, 0.7), fl.trace), 0.95, 1)
                figure ic_wifi { at: htx0 + 16, hty0 + 16; size: 14, 14; color: ac; show: network.online and network.kind == wifi }
                figure ic_eth { at: htx0 + 16, hty0 + 16; size: 14, 14; color: ac; show: network.online and network.kind != wifi }
                figure ic_wifi_off { at: htx0 + 16, hty0 + 16; size: 14, 14; color: fl.ember; show: not network.online }
                text "NETWORK" { at: htx0 + 10, hty0 + 33; anchor: left center; size: 7; weight: 700; family: "Share Tech Mono"; color: fl.engrave }
                text pick(network.online, "OFFLINE", "{upper(network.name)}") { at: htx0 + 10, hty0 + 43; anchor: left center; size: 6.4
                      family: "Share Tech Mono"; width: htw - 16; lines: 1; color: if(network.online, ac, fl.ember) }
                repeat q in 0..4 {
                    box { from: htx0 + htw - 30 + q * 5, hty0 + 20 - q * 3; size: 3, 4 + q * 3
                          color: ac; opacity: if(network.online and network.strength > q * 25, 0.9, 0.18); show: network.kind == wifi }
                }
                on press nx_t_net { emit nx_hub_act(11) }
                // BLUETOOTH
                zone box nx_t_bt { from: htx1, hty1; size: htw, 50; cursor: pointer; role: toggle; checked: bluetooth.powered
                                   label: "Bluetooth"; show: bluetooth.present }
                Chamfer(htx1, hty1, htw, 50, 6, mix(fl.well, ac, if(bluetooth.powered, 0.16, 0) + nx_t_bt.hover * 0.08),
                        if(bluetooth.powered, mix(fl.trace, ac, 0.7), fl.trace), if(bluetooth.present, 0.95, 0.45), 1)
                figure ic_bt { at: htx1 + 16, hty1 + 16; size: 14, 14; color: ac; show: bluetooth.powered }
                figure ic_bt_off { at: htx1 + 16, hty1 + 16; size: 14, 14; color: fl.muted; show: not bluetooth.powered }
                text "BLUETOOTH" { at: htx1 + 10, hty1 + 33; anchor: left center; size: 7; weight: 700; family: "Share Tech Mono"; color: fl.engrave }
                text pick(bluetooth.powered, "OFF", "ON") { at: htx1 + 10, hty1 + 43; anchor: left center; size: 6.4
                      family: "Share Tech Mono"; color: if(bluetooth.powered, ac, fl.muted) }
                on press nx_t_bt { emit nx_bt(if(bluetooth.powered, 0, 1)) }
                // SOUND
                zone box nx_t_snd { from: htx2, hty2; size: htw, 50; cursor: pointer; role: toggle; checked: not audio.muted
                                    label: "Mute or unmute the output" }
                Chamfer(htx2, hty2, htw, 50, 6, mix(fl.well, if(audio.muted, fl.ember, ac), 0.16 + nx_t_snd.hover * 0.08),
                        mix(fl.trace, if(audio.muted, fl.ember, ac), 0.7), 0.95, 1)
                figure ic_vol { at: htx2 + 16, hty2 + 16; size: 14, 14; color: ac; show: not audio.muted }
                figure ic_vol_off { at: htx2 + 16, hty2 + 16; size: 14, 14; color: fl.ember; show: audio.muted }
                text "SOUND" { at: htx2 + 10, hty2 + 33; anchor: left center; size: 7; weight: 700; family: "Share Tech Mono"; color: fl.engrave }
                text pick(audio.muted, "{audio.volume * 100, 0}%", "MUTED") { at: htx2 + 10, hty2 + 43; anchor: left center; size: 6.4
                      family: "Share Tech Mono"; color: if(audio.muted, fl.ember, ac) }
                on press nx_t_snd { emit nx_mute }
                // MICROPHONE
                zone box nx_t_mic { from: htx3, hty3; size: htw, 50; cursor: pointer; role: toggle; checked: not audio.input_muted
                                    label: "Mute or unmute the microphone" }
                Chamfer(htx3, hty3, htw, 50, 6, mix(fl.well, if(audio.input_muted, fl.ember, ac), 0.16 + nx_t_mic.hover * 0.08),
                        mix(fl.trace, if(audio.input_muted, fl.ember, ac), 0.7), 0.95, 1)
                figure ic_mic { at: htx3 + 16, hty3 + 16; size: 14, 14; color: ac; show: not audio.input_muted }
                figure ic_mic_off { at: htx3 + 16, hty3 + 16; size: 14, 14; color: fl.ember; show: audio.input_muted }
                text "MIC" { at: htx3 + 10, hty3 + 33; anchor: left center; size: 7; weight: 700; family: "Share Tech Mono"; color: fl.engrave }
                text pick(audio.input_muted, "LIVE", "MUTED") { at: htx3 + 10, hty3 + 43; anchor: left center; size: 6.4
                      family: "Share Tech Mono"; color: if(audio.input_muted, fl.ember, ac) }
                on press nx_t_mic { emit nx_mic }
                // DO NOT DISTURB (the bar's: only urgent signals unfold)
                zone box nx_t_dnd { from: htx4, hty4; size: htw, 50; cursor: pointer; role: toggle; checked: nx_dnd
                                    label: "Do not disturb" }
                Chamfer(htx4, hty4, htw, 50, 6, mix(fl.well, fl.flare, if(nx_dnd, 0.18, 0) + nx_t_dnd.hover * 0.08),
                        if(nx_dnd, mix(fl.trace, fl.flare, 0.75), fl.trace), 0.95, 1)
                figure ic_bell { at: htx4 + 16, hty4 + 16; size: 14, 14; color: if(nx_dnd, fl.flare, fl.muted) }
                line { from: htx4 + 9, hty4 + 23; to: htx4 + 23, hty4 + 9; width: 1.4; color: fl.flare; show: nx_dnd }
                text "QUIET" { at: htx4 + 10, hty4 + 33; anchor: left center; size: 7; weight: 700; family: "Share Tech Mono"; color: fl.engrave }
                text pick(nx_dnd, "OFF", "ON") { at: htx4 + 10, hty4 + 43; anchor: left center; size: 6.4
                      family: "Share Tech Mono"; color: if(nx_dnd, fl.flare, fl.muted) }
                on press nx_t_dnd { emit nx_hub_act(1) }
                // KEEP AWAKE (the bar's caffeine: no idle lock, no sleep)
                zone box nx_t_caf { from: htx5, hty5; size: htw, 50; cursor: pointer; role: toggle; checked: nx_caffeine
                                    label: "Keep the machine awake" }
                Chamfer(htx5, hty5, htw, 50, 6, mix(fl.well, fl.flare, if(nx_caffeine, 0.18, 0) + nx_t_caf.hover * 0.08),
                        if(nx_caffeine, mix(fl.trace, fl.flare, 0.75), fl.trace), 0.95, 1)
                figure ic_caf { at: htx5 + 16, hty5 + 16; size: 14, 14; color: if(nx_caffeine, fl.flare, fl.muted) }
                text "AWAKE" { at: htx5 + 10, hty5 + 33; anchor: left center; size: 7; weight: 700; family: "Share Tech Mono"; color: fl.engrave }
                text pick(nx_caffeine, "IDLE", "HELD") { at: htx5 + 10, hty5 + 43; anchor: left center; size: 6.4
                      family: "Share Tech Mono"; color: if(nx_caffeine, fl.flare, fl.muted) }
                on press nx_t_caf { emit nx_hub_act(2) }
                // RECORD the screen (again: stop)
                zone box nx_t_rec { from: htx6, hty6; size: htw, 50; cursor: pointer; role: toggle; checked: nx_rec
                                    label: "Record the screen" }
                Chamfer(htx6, hty6, htw, 50, 6, mix(fl.well, fl.ember, if(nx_rec, 0.22, 0) + nx_t_rec.hover * 0.08),
                        if(nx_rec, fl.ember, fl.trace), 0.95, 1)
                figure ic_rec { at: htx6 + 16, hty6 + 16; size: 14, 14; color: if(nx_rec, fl.ember, fl.muted) }
                text "RECORD" { at: htx6 + 10, hty6 + 33; anchor: left center; size: 7; weight: 700; family: "Share Tech Mono"; color: fl.engrave }
                text pick(nx_rec, "READY", "● LIVE") { at: htx6 + 10, hty6 + 43; anchor: left center; size: 6.4
                      family: "Share Tech Mono"; color: if(nx_rec, fl.ember, fl.muted) }
                on press nx_t_rec { emit nx_hub_act(3) }
                // POWER: the session menu; its right half locks at once
                zone box nx_t_pow { from: htx7, hty7; size: htw / 2, 50; cursor: pointer; role: button; label: "Power: the session menu" }
                zone box nx_t_lock { from: htx7 + htw / 2, hty7; size: htw / 2, 50; cursor: pointer; role: button; label: "Lock the screen" }
                Chamfer(htx7, hty7, htw, 50, 6, mix(fl.well, fl.ember, max(nx_t_pow.hover, nx_t_lock.hover) * 0.12),
                        mix(fl.trace, fl.ember, max(nx_t_pow.hover, nx_t_lock.hover) * 0.7), 0.95, 1)
                box { from: htx7 + htw / 2, hty7 + 8; size: 1, 34; color: fl.trace; opacity: 0.5 }
                figure ic_pow { at: htx7 + htw / 4, hty7 + 19; size: 14, 14; color: mix(fl.muted, fl.ember, nx_t_pow.hover) }
                text "POWER" { at: htx7 + htw / 4, hty7 + 38; anchor: center; size: 6.4; weight: 700; family: "Share Tech Mono"; color: fl.engrave }
                text "LOCK" { at: htx7 + htw * 3 / 4, hty7 + 38; anchor: center; size: 6.4; weight: 700; family: "Share Tech Mono"; color: fl.engrave }
                box { from: htx7 + htw * 3 / 4 - 5, hty7 + 18; size: 10, 8; corner: 1.5; color: mix(fl.muted, ac, nx_t_lock.hover) }
                arc { at: htx7 + htw * 3 / 4, hty7 + 18; radius: 3.5; width: 1.4; span: 180deg; color: mix(fl.muted, ac, nx_t_lock.hover) }
                on press nx_t_pow { emit nx_hub_act(4) }
                on press nx_t_lock { emit nx_hub_act(5) }

                }

                // ── LEVELS: a press or a drag sets them, the wheel nudges them ──
                group {
                    show: nx_hon_levels
                    move: 0, hy_levels
                    let hlev_y = 0
                let ltx = 40
                let ltw = hw - 40 - 58
                // output volume
                figure ic_vol { at: 22, hlev_y + 10; size: 13, 13; color: mix(fl.muted, ac, 0.7) }
                box { from: ltx, hlev_y + 9; size: ltw, 3; corner: 1.5; color: fl.well; opacity: 0.95 }
                box { from: ltx, hlev_y + 9; size: ltw * clamp(audio.volume, 0, 1), 3; corner: 1.5
                      color: if(audio.muted, fl.muted, ac); opacity: 0.95 }
                box { from: ltx + ltw * clamp(audio.volume, 0, 1) - 1.5, hlev_y + 4; size: 3, 13; corner: 1
                      color: mix(fl.engrave, ac, 0.4 + nx_hub_vol.hover * 0.6) }
                text "{audio.volume * 100, 0}%" { at: hw - 14, hlev_y + 10; anchor: right center; size: 9
                      weight: 700; family: "Share Tech Mono"; color: if(audio.muted, fl.muted, mix(fl.muted, ac, 0.8)) }
                zone box nx_hub_vol { from: ltx - 6, hlev_y; size: ltw + 12, 20; cursor: pointer; role: slider
                                      label: "Output volume"; value: audio.volume }
                on press nx_hub_vol { emit nx_vol(clamp((local.x - ltx) / ltw, 0, 1)) }
                on drag nx_hub_vol { emit nx_vol(clamp((local.x - ltx) / ltw, 0, 1)) }
                on scroll nx_hub_vol { emit nx_vol(clamp(audio.volume + wheel * 0.05, 0, 1)) }
                // microphone level
                figure ic_mic { at: 22, hlev_y + 34; size: 13, 13; color: mix(fl.muted, ac, 0.7) }
                box { from: ltx, hlev_y + 33; size: ltw, 3; corner: 1.5; color: fl.well; opacity: 0.95 }
                box { from: ltx, hlev_y + 33; size: ltw * clamp(audio.input, 0, 1), 3; corner: 1.5
                      color: if(audio.input_muted, fl.muted, fl.trace_lit); opacity: 0.95 }
                box { from: ltx + ltw * clamp(audio.input, 0, 1) - 1.5, hlev_y + 28; size: 3, 13; corner: 1
                      color: mix(fl.engrave, fl.trace_lit, 0.4 + nx_hub_micl.hover * 0.6) }
                text "{audio.input * 100, 0}%" { at: hw - 14, hlev_y + 34; anchor: right center; size: 9; weight: 700
                      family: "Share Tech Mono"; color: if(audio.input_muted, fl.muted, mix(fl.muted, fl.trace_lit, 0.8)) }
                zone box nx_hub_micl { from: ltx - 6, hlev_y + 24; size: ltw + 12, 20; cursor: pointer; role: slider
                                       label: "Microphone level"; value: audio.input }
                on press nx_hub_micl { emit nx_mic_level(clamp((local.x - ltx) / ltw, 0, 1)) }
                on drag nx_hub_micl { emit nx_mic_level(clamp((local.x - ltx) / ltw, 0, 1)) }
                on scroll nx_hub_micl { emit nx_mic_level(clamp(audio.input + wheel * 0.05, 0, 1)) }
                // backlight, where the machine has one
                group {
                    show: brightness.present
                    figure ic_sun { at: 22, hlev_y + 58; size: 13, 13; color: mix(fl.muted, fl.flare, 0.7) }
                    box { from: ltx, hlev_y + 57; size: ltw, 3; corner: 1.5; color: fl.well; opacity: 0.95 }
                    box { from: ltx, hlev_y + 57; size: ltw * clamp(brightness.level, 0, 1), 3; corner: 1.5; color: fl.flare; opacity: 0.9 }
                    box { from: ltx + ltw * clamp(brightness.level, 0, 1) - 1.5, hlev_y + 52; size: 3, 13; corner: 1
                          color: mix(fl.engrave, fl.flare, 0.4 + nx_hub_bri.hover * 0.6) }
                    text "{brightness.level * 100, 0}%" { at: hw - 14, hlev_y + 58; anchor: right center; size: 9; weight: 700
                          family: "Share Tech Mono"; color: mix(fl.muted, fl.flare, 0.8) }
                    zone box nx_hub_bri { from: ltx - 6, hlev_y + 48; size: ltw + 12, 20; cursor: pointer; role: slider
                                          label: "Display brightness"; value: brightness.level }
                    on press nx_hub_bri { emit nx_bri(clamp((local.x - ltx) / ltw, 0.01, 1)) }
                    on drag nx_hub_bri { emit nx_bri(clamp((local.x - ltx) / ltw, 0.01, 1)) }
                    on scroll nx_hub_bri { emit nx_bri(clamp(brightness.level + wheel * 0.05, 0.01, 1)) }
                }

                }

                // ── NOW PLAYING: only while a player owns the session (and not under a player face) ──
                group {
                    show: nx_hon_media
                    move: 0, hy_media
                    let hmed_y = 0
                    let hmed_h = 64
                    Chamfer(12, hmed_y, hw - 24, hmed_h, 8, mix(fl.well, ac, if(med.playing, 0.08, 0)), mix(fl.trace, ac, if(med.playing, 0.5, 0)), 0.9, 1)
                    Chamfer(20, hmed_y + 8, 48, 48, 6, fl.hull, mix(fl.trace, ac, 0.5), 1, 1)
                    image nx_cover { at: 22, hmed_y + 10; size: 44, 44; show: nx_art_on and nx_has }
                    figure ic_music { at: 44, hmed_y + 32; size: 20, 20; color: if(med.playing, ac, fl.muted); show: not (nx_art_on and nx_has) }
                    text pick(nx_has, "NOTHING PLAYING", nx_title) { at: 80, hmed_y + 17; anchor: left center; size: 10.5; weight: 700; family: "Exo 2"
                                    width: hw - 80 - 128; lines: 1; color: fl.engrave }
                    text pick(nx_has, "THIS SECTION SHOWS WHILE A PLAYER RUNS", nx_artist) { at: 80, hmed_y + 32; anchor: left center; size: 7.5
                                     family: "Share Tech Mono"; width: hw - 80 - 128; lines: 1; color: fl.muted }
                    NViz(80, hmed_y + 38, hw - 80 - 128, 8, ac, if(nx_playing, 1, 0))
                    box { from: 80, hmed_y + 49; size: hw - 80 - 128, 2; color: fl.trace; opacity: 0.5 }
                    box { from: 80, hmed_y + 49; size: (hw - 80 - 128) * clamp(nx_progress, 0, 1), 2; color: ac; opacity: 0.9 }
                    text "{nx_elapsed}  /  {nx_duration}" { at: 80, hmed_y + 57; anchor: left center; size: 6.2
                          family: "Share Tech Mono"; color: fl.muted; show: nx_media_time_on and nx_has }
                    group {
                        show: nx_has
                        zone box nx_hub_mprev { from: hw - 120, hmed_y + 20; size: 30, 24; cursor: pointer; role: button; label: "Previous track" }
                        NButton(hw - 120, hmed_y + 20, 30, 24, "‹‹", 0, ac, nx_hub_mprev.hover)
                        on press nx_hub_mprev { emit nx_media(1) }
                        zone box nx_hub_mplay { from: hw - 86, hmed_y + 18; size: 38, 28; cursor: pointer; role: button
                                                label: pick(med.playing, "Play", "Pause") }
                        group { show: not med.playing
                            NButton(hw - 86, hmed_y + 18, 38, 28, "▶", 0, ac, nx_hub_mplay.hover) }
                        group { show: med.playing
                            NButton(hw - 86, hmed_y + 18, 38, 28, "❚❚", 1, ac, nx_hub_mplay.hover) }
                        on press nx_hub_mplay { emit nx_media(0) }
                        zone box nx_hub_mnext { from: hw - 44, hmed_y + 20; size: 30, 24; cursor: pointer; role: button; label: "Next track" }
                        NButton(hw - 44, hmed_y + 20, 30, 24, "››", 0, ac, nx_hub_mnext.hover)
                        on press nx_hub_mnext { emit nx_media(2) }
                    }
                }

                // ── MACHINE: four gauges with their last twelve readings ──
                group {
                    show: nx_hon_gauges
                    move: 0, hy_gauges
                    let hgau_y = 0
                for t in nx_tel {
                    let gx0 = 12 + (t.id - 1) * (hgw + 6)
                    let lit = if(t.on, 1, 0)
                    let sw0 = hgw - 16
                    Chamfer(gx0, hgau_y, hgw, 56, 6, fl.well, fl.trace, 0.42 + lit * 0.18, 1)
                    box { from: gx0, hgau_y + 6; size: 2, 44; color: if(t.tone == 3, fl.ember, if(t.tone == 2, fl.flare, ac)); opacity: 0.25 + lit * 0.65 }
                    text t.label { at: gx0 + 9, hgau_y + 11; anchor: left center; size: 6.6; weight: 700
                                   family: "Share Tech Mono"; color: fl.muted }
                    text t.value { at: gx0 + hgw - 8, hgau_y + 13; anchor: right center; size: 12; weight: 700
                                   family: "Exo 2"; color: if(t.on, mix(fl.engrave, if(t.tone == 3, fl.ember, if(t.tone == 2, fl.flare, ac)), 0.75), fl.muted) }
                    group {
                        show: t.on
                        path { stroke: 1.1; color: if(t.tone == 3, fl.ember, if(t.tone == 2, fl.flare, ac)); opacity: 0.85
                               move gx0 + 8, hgau_y + 46 - t.s1 * 18
                               line gx0 + 8 + sw0 * 1 / 11, hgau_y + 46 - t.s2 * 18
                               line gx0 + 8 + sw0 * 2 / 11, hgau_y + 46 - t.s3 * 18
                               line gx0 + 8 + sw0 * 3 / 11, hgau_y + 46 - t.s4 * 18
                               line gx0 + 8 + sw0 * 4 / 11, hgau_y + 46 - t.s5 * 18
                               line gx0 + 8 + sw0 * 5 / 11, hgau_y + 46 - t.s6 * 18
                               line gx0 + 8 + sw0 * 6 / 11, hgau_y + 46 - t.s7 * 18
                               line gx0 + 8 + sw0 * 7 / 11, hgau_y + 46 - t.s8 * 18
                               line gx0 + 8 + sw0 * 8 / 11, hgau_y + 46 - t.s9 * 18
                               line gx0 + 8 + sw0 * 9 / 11, hgau_y + 46 - t.s10 * 18
                               line gx0 + 8 + sw0 * 10 / 11, hgau_y + 46 - t.s11 * 18
                               line gx0 + 8 + sw0, hgau_y + 46 - t.s12 * 18 }
                        ellipse { at: gx0 + 8 + sw0, hgau_y + 46 - t.s12 * 18; radius: 1.6; color: if(t.tone == 3, fl.ember, if(t.tone == 2, fl.flare, ac)) }
                    }
                    box { from: gx0 + 8, hgau_y + 50; size: sw0, 1.5; color: fl.trace; opacity: 0.4 }
                    box { from: gx0 + 8, hgau_y + 50; size: sw0 * t.bar, 1.5; color: if(t.tone == 3, fl.ember, if(t.tone == 2, fl.flare, ac)); opacity: 0.9 * lit }
                }

                }

                // ── WORKSPACES: one cell each, a press goes there ──
                group {
                    show: nx_hon_spaces
                    move: 0, hy_spaces
                    let hsp_y = 0
                group {
                    let ncell = max(1, nx_ws_count)
                    let cw0 = min(38, (hw - 24 - (ncell - 1) * 4) / ncell)
                    text "SPACES" { at: 12, hsp_y + 13; anchor: left center; size: 6.6; weight: 700; family: "Share Tech Mono"; color: fl.muted }
                    text "NO WORKSPACES REPORTED" { at: 64, hsp_y + 13; anchor: left center; size: 8; family: "Share Tech Mono"
                                                    color: fl.muted; show: nx_ws_count < 1 }
                    for s in nx_ws {
                        let wx = 64 + (s.slot - 1) * (cw0 + 4)
                        let on_ws = s.active > 0
                        zone box nx_hub_ws { from: wx, hsp_y; size: cw0, 26; cursor: pointer; role: button
                                             selected: on_ws; label: "Go to workspace {s.label}" }
                        Chamfer(wx, hsp_y, cw0, 26, 4, mix(fl.well, ac, if(on_ws, 0.22, nx_hub_ws.hover * 0.12)),
                                if(on_ws, ac, mix(fl.trace, ac, nx_hub_ws.hover * 0.6)), 0.95, 1)
                        text s.label { at: wx + cw0 / 2, hsp_y + 12; anchor: center; size: 10; weight: 700; family: "Exo 2"
                                       width: cw0 - 4; lines: 1; color: if(on_ws, ac, mix(fl.muted, fl.engrave, if(s.windows > 0, 0.6, 0))) }
                        box { from: wx + cw0 / 2 - min(s.windows, 4) * 2.5, hsp_y + 21; size: min(s.windows, 4) * 5 - 2, 1.5
                              color: if(on_ws, ac, fl.trace_lit); opacity: 0.8; show: s.windows > 0 }
                        on press nx_hub_ws { emit nx_ws_focus(s.id) }
                    }
                }

                }

                // ── SHORTCUTS: places one press away ──
                group {
                    show: nx_hon_places
                    move: 0, hy_places
                    let hsc_y = 0
                let hsw = (hw - 24 - 4 * 5) / 5
                zone box nx_s_wall { from: 12, hsc_y; size: hsw, 24; cursor: pointer; role: button; label: "Open the wallpaper studio" }
                NButton(12, hsc_y, hsw, 24, "WALLPAPER", 0, ac, nx_s_wall.hover)
                on press nx_s_wall { emit nx_hub_act(7) }
                zone box nx_s_notes { from: 12 + (hsw + 5), hsc_y; size: hsw, 24; cursor: pointer; role: button; label: "Open the notices" }
                NButton(12 + (hsw + 5), hsc_y, hsw, 24, "NOTICES", 0, ac, nx_s_notes.hover)
                on press nx_s_notes { emit nx_hub_act(8) }
                zone box nx_s_board { from: 12 + (hsw + 5) * 2, hsc_y; size: hsw, 24; cursor: pointer; role: button; label: "Open the board" }
                NButton(12 + (hsw + 5) * 2, hsc_y, hsw, 24, "BOARD", 0, ac, nx_s_board.hover)
                on press nx_s_board { emit nx_hub_act(9) }
                zone box nx_s_over { from: 12 + (hsw + 5) * 3, hsc_y; size: hsw, 24; cursor: pointer; role: button; label: "Open the overview" }
                NButton(12 + (hsw + 5) * 3, hsc_y, hsw, 24, "OVERVIEW", 0, ac, nx_s_over.hover)
                on press nx_s_over { emit nx_hub_act(10) }
                zone box nx_hub_diag { from: 12 + (hsw + 5) * 4, hsc_y; size: hsw, 24; cursor: pointer; role: button
                                       label: "Copy system diagnostics" }
                NButton(12 + (hsw + 5) * 4, hsc_y, hsw, 24, "COPY DIAG", 0, ac, nx_hub_diag.hover)
                on press nx_hub_diag { emit nx_diagnostics_copy }
                }

                // ── customising: each section dimmed under its own controls, and the hidden
                //    ones as stubs that can be shown again ──
                group {
                    show: hedit
                    for r in nx_hsec {
                        let sy = r.y
                        group {
                            show: r.shown
                            // the section's presses are held while it is being arranged
                            zone box nx_hs_guard { from: 8, sy - 3; size: hw - 16, r.h + 6; agent: hidden }
                            box { from: 8, sy - 3; size: hw - 16, r.h + 6; corner: 5; color: fl.hull; opacity: if(r.stub, 0.0, 0.66) }
                            box { from: 8, sy - 3; size: hw - 16, r.h + 6; corner: 5; stroke: 1
                                  color: if(r.stub, fl.trace, mix(fl.trace, ac, 0.7)); opacity: 0.8 }
                            group {
                                show: r.stub
                                text pick(r.hidden, "{r.name}  ·  NOT DRAWN UNDER A PLAYER FACE", "{r.name}  ·  HIDDEN") { at: 18, sy + 12; anchor: left center
                                      size: 7; weight: 700; family: "Share Tech Mono"; color: fl.muted }
                            }
                            group {
                                show: not r.stub
                                Chamfer(12, sy - 1, 96, 18, 4, fl.hull_raised, mix(fl.trace, ac, 0.7), 1, 1)
                                text r.name { at: 20, sy + 8; anchor: left center; size: 6.6; weight: 700; family: "Share Tech Mono"; color: ac }
                            }
                            // ▲ ▼ ◉ at the section's top right
                            zone box nx_hs_up { from: hw - 92, sy + 1; size: 24, 20; cursor: pointer; role: button
                                                label: "Move {r.name} up"; active: not r.first }
                            NButton(hw - 92, sy + 1, 24, 20, "▲", 0, ac, nx_hs_up.hover * if(r.first, 0, 1))
                            on press nx_hs_up { emit nx_hub_move(r.id * 10 + 1) }
                            zone box nx_hs_dn { from: hw - 64, sy + 1; size: 24, 20; cursor: pointer; role: button
                                                label: "Move {r.name} down"; active: not r.last }
                            NButton(hw - 64, sy + 1, 24, 20, "▼", 0, ac, nx_hs_dn.hover * if(r.last, 0, 1))
                            on press nx_hs_dn { emit nx_hub_move(r.id * 10 + 2) }
                            zone box nx_hs_eye { from: hw - 36, sy + 1; size: 24, 20; cursor: pointer; role: toggle; checked: not r.hidden
                                                 label: pick(r.hidden, "Hide {r.name}", "Show {r.name}") }
                            group { show: not r.hidden
                                NButton(hw - 36, sy + 1, 24, 20, "◉", 1, ac, nx_hs_eye.hover) }
                            group { show: r.hidden
                                NButton(hw - 36, sy + 1, 24, 20, "○", 0, fl.muted, nx_hs_eye.hover) }
                            on press nx_hs_eye { emit nx_hub_toggle(r.id) }
                        }
                    }
                }
            }
        }

        group {
            move: 0, (1 - nx_a) * 16
            show: nx_a > 0.004 and nx_view != hub

            // The canvas the logic has to know before it can clamp, fit or restore onto it:
            // sent once the entrance has settled, and again whenever the screen changes size.
            on change cw { nx_cw = cw; nx_ch = ch; emit nx_canvas }
            on change ch { nx_cw = cw; nx_ch = ch; emit nx_canvas }
            on change nx_a while nx_a > 0.96 { nx_cw = cw; nx_ch = ch; emit nx_canvas }

            // ── the header: the workspace's own controls, never the desktop's ──
            // A machined rail: a gradient hull, a lit lower edge, the mark in its own plate,
            // the wordmark, the mode as a segmented switch, the arrangements beside it, and
            // the acting controls on the right, all on one line at every width.
            body {
                gradient: 0, 0 to 0, head, fl.hull_raised, fl.hull
                rim: 5%
                border: 1, fl.trace
                opacity: nx_fill
                box { from: 0, 0; size: sw, head }
            }
            box { from: 0, head - 1; size: sw, 1; color: fl.trace; opacity: 0.7 }
            box { from: 0, head - 4; size: sw, 1; color: ac; opacity: 0.16 }

            let act_y = if(tiny, 6, 10)
            let act_h = if(tiny, 24, 26)
            let x_close = sw - 12 - 30
            // LOCK stays at every width — it is the one control that changes what a press
            // does. TIDY and CENTRE need the room, so they are drawn only where it exists,
            // and the right-hand steps are measured from the last button actually drawn.
            let x_lock = x_close - 8 - 58
            let x_tidy = x_lock - 8 - 54
            let x_centre = x_tidy - 8 - 70
            let x_arr = (if(small, x_lock, x_centre)) - 8 - 50
            let x_look = x_arr - 8 - 48
            let x_node = x_look - 8 - 54
            let x_lib = x_node - 8 - 44
            // the arrangement chips only where they fit between the mode switch and the panels
            let chips_fit = 372 + nx_arrangement_count * 84 < x_lib

            // the mark, lit from its own plate
            Chamfer(12, if(tiny, 4, 8), 30, act_h, 6, fl.well, mix(fl.trace, ac, 0.5), 1, 1)
            box { from: 12, if(tiny, 4, 8); size: 30, 2; color: ac; opacity: 0.9 }
            figure nx_mark { at: 27, if(tiny, 4, 8) + act_h / 2; size: 16, 16; color: ac }
            zone box nx_to_hub { from: 12, if(tiny, 4, 8); size: 30, act_h; cursor: pointer; role: button
                                 label: "Fold the Nexus back to the compact hub" }
            on press nx_to_hub { emit nx_view_set(0) }

            text "CONTROL NEXUS" { at: 52, 16; anchor: left center; size: 11; weight: 700
                                  family: "Exo 2"; color: mix(fl.ink, ac, 0.92); show: not tiny }
            text "CONTROL NEXUS" { at: 52, 15; anchor: left center; size: 9.5; weight: 700
                                  family: "Exo 2"; color: mix(fl.ink, ac, 0.92); show: tiny }
            group {
                show: not tiny
                box { at: 54, 27; size: 3, 3; corner: 2; color: ac; opacity: 0.9 }
                text "{nx_arrangement_name}  /  {nx_mode_name}  /  {nx_node_count, 0} NODES" {
                    at: 62, 28; anchor: left center; size: 7.5; family: "Share Tech Mono"; color: fl.muted }
            }

            // the mode as one segmented control: two wells, the current one lit. At the
            // narrowest width it becomes one button that swaps them, which still fits.
            group {
                show: not tiny
                Chamfer(196, act_y - 1, 152, act_h + 2, 4, fl.ground, fl.trace, 0.5, 1)
                zone box nx_mode_circuit { from: 198, act_y; size: 74, act_h; cursor: pointer; role: toggle; checked: nx_mode == circuit
                                           label: "Show the full circuit" }
                NButton(198, act_y, 74, act_h, "CIRCUIT", nx_mode == circuit, ac, nx_mode_circuit.hover)
                on press nx_mode_circuit { emit nx_mode_switch(0) }
                zone box nx_mode_minimal { from: 274, act_y; size: 72, act_h; cursor: pointer; role: toggle; checked: nx_mode == minimal
                                           label: "Show only the essential nodes" }
                NButton(274, act_y, 72, act_h, "MINIMAL", nx_mode == minimal, fl.flare, nx_mode_minimal.hover)
                on press nx_mode_minimal { emit nx_mode_switch(1) }
            }
            group {
                show: tiny
                zone box nx_mode_toggle { from: 196, act_y; size: 64, act_h; cursor: pointer; role: toggle
                                          checked: nx_mode == minimal; label: "Switch between CIRCUIT and MINIMAL" }
                NButton(196, act_y, 64, act_h, "MODE", 1, ac, nx_mode_toggle.hover)
                on press nx_mode_toggle { emit nx_mode_switch(if(nx_mode == circuit, 1, 0)) }
            }

            // the arrangements, in the order the settings file holds them
            for a in nx_arrs {
                let ax = 364 + (a.id - 1) * 84
                zone box nx_arr_chip { from: ax, act_y; size: 78, act_h; cursor: pointer; role: toggle
                                       checked: a.active; label: "Show the {a.name} arrangement"; show: chips_fit }
                group { show: chips_fit
                    NButton(ax, act_y, 78, act_h, a.name, a.active, ac, nx_arr_chip.hover) }
                on press nx_arr_chip { emit nx_arrangement(a.id) }
            }

            // ── the header's own instrument cluster ──
            // Four readings the workspace is about, on one line where the header has room for
            // them: load, memory, temperature and traffic, each with the bar its number fills.
            // They are the same facts the nodes read, so the header and the canvas never
            // disagree about what the machine is doing.
            let tel_x = 364 + nx_arrangement_count * 84 + 30
            let tel_fit = sw > 1500 and not tiny and not small
            group {
                show: tel_fit
                repeat t in 0..3 {
                    box { from: tel_x + t * 78, act_y + 3; size: 1, act_h - 6; color: fl.trace; opacity: 0.22 }
                }
                text "LOAD" { at: tel_x + 8, act_y + 9; anchor: left center; size: 5.8; family: "Share Tech Mono"; color: fl.muted }
                text "{nx_cpu * 100, 0}%" { at: tel_x + 70, act_y + 9; anchor: right center; size: 9.5; weight: 700
                                              family: "Exo 2"; color: mix(fl.muted, ac, 0.9) }
                box { from: tel_x + 8, act_y + 17; size: 62, 2; color: fl.ground; opacity: 0.9 }
                box { from: tel_x + 8, act_y + 17; size: 62 * clamp(nx_cpu, 0, 1), 2; color: ac; show: nx_cpu_on }

                text "MEM" { at: tel_x + 86, act_y + 9; anchor: left center; size: 5.8; family: "Share Tech Mono"; color: fl.muted }
                text "{nx_ram * 100, 0}%" { at: tel_x + 148, act_y + 9; anchor: right center; size: 9.5; weight: 700
                                              family: "Exo 2"; color: mix(fl.muted, fl.trace_lit, 0.9) }
                box { from: tel_x + 86, act_y + 17; size: 62, 2; color: fl.ground; opacity: 0.9 }
                box { from: tel_x + 86, act_y + 17; size: 62 * clamp(nx_ram, 0, 1), 2; color: fl.trace_lit; show: nx_ram_on }

                text "TEMP" { at: tel_x + 164, act_y + 9; anchor: left center; size: 5.8; family: "Share Tech Mono"; color: fl.muted }
                text "{nx_temp, 0}°C" { at: tel_x + 226, act_y + 9; anchor: right center; size: 9.5; weight: 700
                                             family: "Exo 2"; color: mix(fl.muted, fl.ember, 0.9) }
                box { from: tel_x + 164, act_y + 17; size: 62, 2; color: fl.ground; opacity: 0.9 }
                box { from: tel_x + 164, act_y + 17; size: 62 * clamp(nx_temp / 100, 0, 1), 2; color: fl.ember; show: nx_temp_on }

                text "NET" { at: tel_x + 242, act_y + 9; anchor: left center; size: 5.8; family: "Share Tech Mono"; color: fl.muted }
                text "{nx_rx_value}" { at: tel_x + 304, act_y + 9; anchor: right center; size: 9.5; weight: 700
                                         family: "Share Tech Mono"; color: mix(fl.muted, fl.flare, 0.9) }
                box { from: tel_x + 242, act_y + 17; size: 62, 2; color: fl.ground; opacity: 0.9 }
                box { from: tel_x + 242, act_y + 17; size: 62 * clamp(nx_rx / 1048576, 0, 1), 2; color: fl.flare; show: nx_net_on }
            }

            // the panels: one docked surface, four faces
            zone box nx_pane_lib { from: x_lib, act_y; size: 44, act_h; cursor: pointer; role: tab
                                   selected: nx_panel == library; label: "Open the module library" }
            NButton(x_lib, act_y, 44, act_h, "LIB", nx_panel == library, ac, nx_pane_lib.hover)
            on press nx_pane_lib { nx_panel = if(nx_panel == library, none, library) }

            zone box nx_pane_node { from: x_node, act_y; size: 54, act_h; cursor: pointer; role: tab
                                    selected: nx_panel == node; label: "Open the selected node's settings" }
            NButton(x_node, act_y, 54, act_h, "NODE", nx_panel == node, ac, nx_pane_node.hover)
            on press nx_pane_node { nx_panel = if(nx_panel == node, none, node) }

            zone box nx_pane_look { from: x_look, act_y; size: 48, act_h; cursor: pointer; role: tab
                                    selected: nx_panel == look; label: "Open the appearance panel" }
            NButton(x_look, act_y, 48, act_h, "LOOK", nx_panel == look, ac, nx_pane_look.hover)
            on press nx_pane_look { nx_panel = if(nx_panel == look, none, look) }

            zone box nx_pane_layout { from: x_arr, act_y; size: 50, act_h; cursor: pointer; role: tab
                                      selected: nx_panel == layout; label: "Open the arrangement panel" }
            NButton(x_arr, act_y, 50, act_h, "ARR", nx_panel == layout, fl.flare, nx_pane_layout.hover)
            on press nx_pane_layout { nx_panel = if(nx_panel == layout, none, layout) }

            // RESTORE CENTRE: only offered while something else is in the middle
            zone box nx_centre { from: x_centre, act_y; size: 70, act_h; cursor: pointer; role: button
                                 label: "Put the core back at the centre"; show: not small and nx_focus != core }
            group { show: not small and nx_focus != core
                NButton(x_centre, act_y, 70, act_h, "CENTRE", 0, ac, nx_centre.hover) }
            on press nx_centre { emit nx_restore_centre }

            zone box nx_tidy { from: x_tidy, act_y; size: 54, act_h; cursor: pointer; role: button
                               label: "Orbit: the centre node in the middle, the rest in a ring around it"; show: not small }
            group { show: not small
                NButton(x_tidy, act_y, 54, act_h, "ORBIT", 0, ac, nx_tidy.hover) }
            on press nx_tidy { emit nx_tidy }

            // LOCK holds the arrangement still: drag and resize are refused while it is on
            zone box nx_pinbtn { from: x_lock, act_y; size: 58, act_h; cursor: pointer; role: toggle; checked: nx_pinned
                                 label: "Lock the arrangement against drag and resize" }
            group { show: nx_pinned
                NButton(x_lock, act_y, 58, act_h, "LOCKED", 1, ac, nx_pinbtn.hover) }
            group { show: not nx_pinned
                NButton(x_lock, act_y, 58, act_h, "LOCK", 0, ac, nx_pinbtn.hover) }
            on press nx_pinbtn { emit nx_pin }

            zone box nx_closebtn { from: x_close, if(tiny, 3, 6); size: 30, act_h + 4; cursor: pointer; role: button
                                   label: "Close Control Nexus" }
            path { stroke: 1.6; color: mix(fl.muted, fl.ember, nx_closebtn.hover)
                   move x_close + 11, if(tiny, 3, 6) + act_h / 2 - 5
                   line x_close + 19, if(tiny, 3, 6) + act_h / 2 + 3 }
            path { stroke: 1.6; color: mix(fl.muted, fl.ember, nx_closebtn.hover)
                   move x_close + 19, if(tiny, 3, 6) + act_h / 2 - 5
                   line x_close + 11, if(tiny, 3, 6) + act_h / 2 + 3 }
            on press nx_closebtn { emit nx_close }

            // ── the identity banner: one mode at a time, the setting is the truth ──
            // Four heights of one portrait: the image (when there is one) under a scrim, the
            // avatar in its own plate, the name and what the machine is, and the clock at the
            // right end. Every line but the name is gated on the band's height.
            group {
                show: banner > 0
                let av = if(banner > 100, 56, if(banner > 60, 44, 30))
                let avy = head + (banner - av) / 2
                let avx = if(tiny, 10, 24)
                let tx = avx + av + 16

                body {
                    gradient: 0, head to 0, head + banner, fl.hull_raised, fl.hull
                    rim: 4%
                    opacity: nx_fill
                    box { from: 0, head; size: sw, banner }
                }
                image nx_banner { at: 0, head; size: sw, banner; opacity: 0.34; show: nx_banner_on }
                // the scrim: one even veil over the picture, so it never shows a seam where the
                // words stop and the portrait begins. No picture, no veil — the plate's own
                // gradient is the backdrop then, and a flat dark band would only flatten it.
                box { from: 0, head; size: sw, banner; color: fl.ground; opacity: 0.32; show: nx_banner_on }
                // with no portrait the band is engraved instead: a rule every 24 px, a lit one
                // every 96, clipped to the band, so an empty banner still reads as a plate
                clip box { from: 0, head; size: sw, banner; show: not nx_banner_on and banner > 0 }
                repeat h in 0..80 {
                    let hx = h * 24
                    line { from: hx, head; to: hx, head + banner; width: 1; color: fl.trace
                           opacity: 0.06; show: not nx_banner_on and hx < sw }
                }
                repeat h4 in 0..20 {
                    let hx4 = h4 * 96
                    line { from: hx4, head; to: hx4, head + banner; width: 1; color: fl.trace
                           opacity: 0.1; show: not nx_banner_on and hx4 < sw }
                }
                box { from: 0, head; size: sw, 1; color: ac; opacity: 0.4 }
                box { from: 0, head + banner - 1; size: sw, 1; color: fl.trace; opacity: 0.55 }
                box { from: 0, head; size: 3, banner; color: fl.ember }
                // a measured tick along the band's lower edge, a scale rather than a border
                repeat t in 0..26 {
                    box { from: 40 + t * 56, head + banner - 5; size: 1, 3; color: fl.trace; opacity: 0.3; show: not tiny }
                }

                // the avatar: an engraved plate, lit at its corners
                Chamfer(avx, avy, av, av, 7, fl.well, ac_soft, 1, 1)
                NCorner(avx + 3, avy + 3, av - 6, av - 6, 7, ac, 0.45)
                image nx_avatar { at: avx, avy; size: av, av; show: nx_avatar_on }
                text "{nx_initial}" { at: avx + av / 2, avy + av / 2 + 1; anchor: center; size: 22; weight: 700
                                      family: "Exo 2"; color: mix(fl.well, ac, 0.85); show: not nx_avatar_on and banner > 100 }
                text "{nx_initial}" { at: avx + av / 2, avy + av / 2 + 1; anchor: center; size: 15; weight: 700
                                      family: "Exo 2"; color: mix(fl.well, ac, 0.85); show: not nx_avatar_on and banner <= 100 }
                zone box nx_avatar_edit { from: avx, avy; size: av, av; cursor: pointer; role: button
                                          label: "Edit system identity" }
                on press nx_avatar_edit { emit nx_identity_edit }

                // the name: the one line every height keeps
                text "{nx_identity_name}" { at: tx, head + if(banner > 100, 36, if(banner > 60, 26, 15)); anchor: left center
                                             size: 20; weight: 700; family: "Exo 2"; color: mix(fl.hull, fl.engrave, 0.92)
                                             width: max(120, sw - tx - 420); lines: 1; show: banner > 100 }
                text "{nx_identity_name}" { at: tx, head + if(banner > 60, 25, 14); anchor: left center
                                             size: 15; weight: 700; family: "Exo 2"; color: mix(fl.hull, fl.engrave, 0.92)
                                             width: max(100, sw - tx - 340); lines: 1; show: banner <= 100 and banner > 46 }
                text "{nx_identity_name}" { at: tx, head + 23; anchor: left center; size: 12; weight: 700; family: "Exo 2"
                                             color: mix(fl.hull, fl.engrave, 0.92); width: max(80, sw - tx - 300); lines: 1
                                             show: banner <= 46 }
                text "OPERATOR  {nx_user}  ·  HOST  {nx_host}" { at: tx, head + 58; anchor: left center; size: 8.5
                     family: "Share Tech Mono"; color: fl.trace_lit; width: max(100, sw - tx - 420); lines: 1; show: banner > 100 }
                text "{nx_session}  ·  {nx_distro}" { at: tx, head + 78; anchor: left center; size: 8
                     family: "Share Tech Mono"; color: fl.muted; width: max(100, sw - tx - 420); lines: 1; show: banner > 100 }
                text "{nx_user}  ·  {nx_host}" { at: tx, head + 45; anchor: left center; size: 8; family: "Share Tech Mono"
                     color: fl.trace_lit; width: max(80, sw - tx - 340); lines: 1; show: banner > 46 and banner <= 100 }
                text "{nx_session}" { at: tx, head + 38; anchor: left center; size: 7.5; family: "Share Tech Mono"
                     color: fl.muted; width: max(60, sw - tx - 300); lines: 1; show: banner <= 46 }

                // the right end: the clock, the date and the workspace it belongs to
                text "{clock.time}" { at: sw - 24, head + if(banner > 100, 40, if(banner > 60, 30, 15)); anchor: right center
                                       size: 26; weight: 600; family: "Share Tech Mono"; color: mix(fl.hull, ac, 0.9)
                                       show: banner > 100 }
                text "{clock.time}" { at: sw - 24, head + if(banner > 60, 26, 14); anchor: right center
                                       size: 16; weight: 600; family: "Share Tech Mono"; color: mix(fl.hull, ac, 0.9)
                                       show: banner <= 100 and banner > 46 }
                text "{clock.time}" { at: sw - 24, head + 23; anchor: right center; size: 12; weight: 600
                                       family: "Share Tech Mono"; color: mix(fl.hull, ac, 0.9); show: banner <= 46 }
                text "{clock.date}" { at: sw - 24, head + 66; anchor: right center; size: 8.5; family: "Share Tech Mono"
                                       color: fl.muted; show: banner > 100 }
                box { from: sw - 152, head + 28; size: 1, 62; color: fl.trace; opacity: 0.4; show: banner > 100 }
                text "WORKSPACE" { at: sw - 136, head + 40; anchor: left center; size: 7.5; family: "Share Tech Mono"
                                    color: fl.muted; show: banner > 100 }
                text "{ws.active, 0}" { at: sw - 136, head + 62; anchor: left center; size: 22; weight: 700
                                        family: "Exo 2"; color: fl.trace_lit; show: banner > 100 }
                text "{ws.active, 0}" { at: sw - 120, head + 47; anchor: right center; size: 14; weight: 700
                                        family: "Exo 2"; color: fl.trace_lit; show: banner > 46 and banner <= 100 }
                text "WS" { at: sw - 136, head + 47; anchor: left center; size: 7.5; family: "Share Tech Mono"
                            color: fl.muted; show: banner > 46 and banner <= 100 }

                // the band's own height control, where the band is tall enough to hold it
                zone box nx_banner_hit { from: sw - 168, head + banner - 22; size: 144, 16; cursor: pointer; role: button
                                         label: "Change the banner height"; show: banner > 100 }
                text "BANNER {nx_banner_name}" { at: sw - 28, head + banner - 13; anchor: right center; size: 7
                                                 family: "Share Tech Mono"; color: mix(fl.muted, ac, nx_banner_hit.hover)
                                                 show: banner > 100 }
                on press nx_banner_hit { emit nx_banner_cycle }
            }

            // ── the canvas: one node per slot, one trace per drawable edge (D87) ──
            // Every slot keeps its own springs (nd_*), so a node that moves, swaps with the
            // centre, leaves or arrives is animated here and never re-sent frame by frame.
            // gx.N … gh.N are where slot N is drawn now, canvas-relative: the carried place
            // while it is in the hand, else its spring, else (motion off) the row itself.
            let gx.0 = if(nx_drag == 1, nx_gx, if(nx_motion, nd_x.0, nx_nodes.0.x))
            let gy.0 = if(nx_drag == 1, nx_gy, if(nx_motion, nd_y.0, nx_nodes.0.y))
            let gw.0 = if(nx_rz == 1, nx_rw, if(nx_motion, nd_w.0, nx_nodes.0.w))
            let gh.0 = if(nx_rz == 1, nx_rh, if(nx_motion, nd_h.0, if(nx_nodes.0.mini, 34, nx_nodes.0.h)))
            let zz.0 = if(nx_drag == 1 or nx_rz == 1, 4, if(nx_nodes.0.sel, 3, if(nx_nodes.0.focus, 2, 0)))
            let gx.1 = if(nx_drag == 2, nx_gx, if(nx_motion, nd_x.1, nx_nodes.1.x))
            let gy.1 = if(nx_drag == 2, nx_gy, if(nx_motion, nd_y.1, nx_nodes.1.y))
            let gw.1 = if(nx_rz == 2, nx_rw, if(nx_motion, nd_w.1, nx_nodes.1.w))
            let gh.1 = if(nx_rz == 2, nx_rh, if(nx_motion, nd_h.1, if(nx_nodes.1.mini, 34, nx_nodes.1.h)))
            let zz.1 = if(nx_drag == 2 or nx_rz == 2, 4, if(nx_nodes.1.sel, 3, if(nx_nodes.1.focus, 2, 0)))
            let gx.2 = if(nx_drag == 3, nx_gx, if(nx_motion, nd_x.2, nx_nodes.2.x))
            let gy.2 = if(nx_drag == 3, nx_gy, if(nx_motion, nd_y.2, nx_nodes.2.y))
            let gw.2 = if(nx_rz == 3, nx_rw, if(nx_motion, nd_w.2, nx_nodes.2.w))
            let gh.2 = if(nx_rz == 3, nx_rh, if(nx_motion, nd_h.2, if(nx_nodes.2.mini, 34, nx_nodes.2.h)))
            let zz.2 = if(nx_drag == 3 or nx_rz == 3, 4, if(nx_nodes.2.sel, 3, if(nx_nodes.2.focus, 2, 0)))
            let gx.3 = if(nx_drag == 4, nx_gx, if(nx_motion, nd_x.3, nx_nodes.3.x))
            let gy.3 = if(nx_drag == 4, nx_gy, if(nx_motion, nd_y.3, nx_nodes.3.y))
            let gw.3 = if(nx_rz == 4, nx_rw, if(nx_motion, nd_w.3, nx_nodes.3.w))
            let gh.3 = if(nx_rz == 4, nx_rh, if(nx_motion, nd_h.3, if(nx_nodes.3.mini, 34, nx_nodes.3.h)))
            let zz.3 = if(nx_drag == 4 or nx_rz == 4, 4, if(nx_nodes.3.sel, 3, if(nx_nodes.3.focus, 2, 0)))
            let gx.4 = if(nx_drag == 5, nx_gx, if(nx_motion, nd_x.4, nx_nodes.4.x))
            let gy.4 = if(nx_drag == 5, nx_gy, if(nx_motion, nd_y.4, nx_nodes.4.y))
            let gw.4 = if(nx_rz == 5, nx_rw, if(nx_motion, nd_w.4, nx_nodes.4.w))
            let gh.4 = if(nx_rz == 5, nx_rh, if(nx_motion, nd_h.4, if(nx_nodes.4.mini, 34, nx_nodes.4.h)))
            let zz.4 = if(nx_drag == 5 or nx_rz == 5, 4, if(nx_nodes.4.sel, 3, if(nx_nodes.4.focus, 2, 0)))
            let gx.5 = if(nx_drag == 6, nx_gx, if(nx_motion, nd_x.5, nx_nodes.5.x))
            let gy.5 = if(nx_drag == 6, nx_gy, if(nx_motion, nd_y.5, nx_nodes.5.y))
            let gw.5 = if(nx_rz == 6, nx_rw, if(nx_motion, nd_w.5, nx_nodes.5.w))
            let gh.5 = if(nx_rz == 6, nx_rh, if(nx_motion, nd_h.5, if(nx_nodes.5.mini, 34, nx_nodes.5.h)))
            let zz.5 = if(nx_drag == 6 or nx_rz == 6, 4, if(nx_nodes.5.sel, 3, if(nx_nodes.5.focus, 2, 0)))
            let gx.6 = if(nx_drag == 7, nx_gx, if(nx_motion, nd_x.6, nx_nodes.6.x))
            let gy.6 = if(nx_drag == 7, nx_gy, if(nx_motion, nd_y.6, nx_nodes.6.y))
            let gw.6 = if(nx_rz == 7, nx_rw, if(nx_motion, nd_w.6, nx_nodes.6.w))
            let gh.6 = if(nx_rz == 7, nx_rh, if(nx_motion, nd_h.6, if(nx_nodes.6.mini, 34, nx_nodes.6.h)))
            let zz.6 = if(nx_drag == 7 or nx_rz == 7, 4, if(nx_nodes.6.sel, 3, if(nx_nodes.6.focus, 2, 0)))
            let gx.7 = if(nx_drag == 8, nx_gx, if(nx_motion, nd_x.7, nx_nodes.7.x))
            let gy.7 = if(nx_drag == 8, nx_gy, if(nx_motion, nd_y.7, nx_nodes.7.y))
            let gw.7 = if(nx_rz == 8, nx_rw, if(nx_motion, nd_w.7, nx_nodes.7.w))
            let gh.7 = if(nx_rz == 8, nx_rh, if(nx_motion, nd_h.7, if(nx_nodes.7.mini, 34, nx_nodes.7.h)))
            let zz.7 = if(nx_drag == 8 or nx_rz == 8, 4, if(nx_nodes.7.sel, 3, if(nx_nodes.7.focus, 2, 0)))
            let gx.8 = if(nx_drag == 9, nx_gx, if(nx_motion, nd_x.8, nx_nodes.8.x))
            let gy.8 = if(nx_drag == 9, nx_gy, if(nx_motion, nd_y.8, nx_nodes.8.y))
            let gw.8 = if(nx_rz == 9, nx_rw, if(nx_motion, nd_w.8, nx_nodes.8.w))
            let gh.8 = if(nx_rz == 9, nx_rh, if(nx_motion, nd_h.8, if(nx_nodes.8.mini, 34, nx_nodes.8.h)))
            let zz.8 = if(nx_drag == 9 or nx_rz == 9, 4, if(nx_nodes.8.sel, 3, if(nx_nodes.8.focus, 2, 0)))
            let gx.9 = if(nx_drag == 10, nx_gx, if(nx_motion, nd_x.9, nx_nodes.9.x))
            let gy.9 = if(nx_drag == 10, nx_gy, if(nx_motion, nd_y.9, nx_nodes.9.y))
            let gw.9 = if(nx_rz == 10, nx_rw, if(nx_motion, nd_w.9, nx_nodes.9.w))
            let gh.9 = if(nx_rz == 10, nx_rh, if(nx_motion, nd_h.9, if(nx_nodes.9.mini, 34, nx_nodes.9.h)))
            let zz.9 = if(nx_drag == 10 or nx_rz == 10, 4, if(nx_nodes.9.sel, 3, if(nx_nodes.9.focus, 2, 0)))
            let gx.10 = if(nx_drag == 11, nx_gx, if(nx_motion, nd_x.10, nx_nodes.10.x))
            let gy.10 = if(nx_drag == 11, nx_gy, if(nx_motion, nd_y.10, nx_nodes.10.y))
            let gw.10 = if(nx_rz == 11, nx_rw, if(nx_motion, nd_w.10, nx_nodes.10.w))
            let gh.10 = if(nx_rz == 11, nx_rh, if(nx_motion, nd_h.10, if(nx_nodes.10.mini, 34, nx_nodes.10.h)))
            let zz.10 = if(nx_drag == 11 or nx_rz == 11, 4, if(nx_nodes.10.sel, 3, if(nx_nodes.10.focus, 2, 0)))
            let gx.11 = if(nx_drag == 12, nx_gx, if(nx_motion, nd_x.11, nx_nodes.11.x))
            let gy.11 = if(nx_drag == 12, nx_gy, if(nx_motion, nd_y.11, nx_nodes.11.y))
            let gw.11 = if(nx_rz == 12, nx_rw, if(nx_motion, nd_w.11, nx_nodes.11.w))
            let gh.11 = if(nx_rz == 12, nx_rh, if(nx_motion, nd_h.11, if(nx_nodes.11.mini, 34, nx_nodes.11.h)))
            let zz.11 = if(nx_drag == 12 or nx_rz == 12, 4, if(nx_nodes.11.sel, 3, if(nx_nodes.11.focus, 2, 0)))
            let gx.12 = if(nx_drag == 13, nx_gx, if(nx_motion, nd_x.12, nx_nodes.12.x))
            let gy.12 = if(nx_drag == 13, nx_gy, if(nx_motion, nd_y.12, nx_nodes.12.y))
            let gw.12 = if(nx_rz == 13, nx_rw, if(nx_motion, nd_w.12, nx_nodes.12.w))
            let gh.12 = if(nx_rz == 13, nx_rh, if(nx_motion, nd_h.12, if(nx_nodes.12.mini, 34, nx_nodes.12.h)))
            let zz.12 = if(nx_drag == 13 or nx_rz == 13, 4, if(nx_nodes.12.sel, 3, if(nx_nodes.12.focus, 2, 0)))
            let gx.13 = if(nx_drag == 14, nx_gx, if(nx_motion, nd_x.13, nx_nodes.13.x))
            let gy.13 = if(nx_drag == 14, nx_gy, if(nx_motion, nd_y.13, nx_nodes.13.y))
            let gw.13 = if(nx_rz == 14, nx_rw, if(nx_motion, nd_w.13, nx_nodes.13.w))
            let gh.13 = if(nx_rz == 14, nx_rh, if(nx_motion, nd_h.13, if(nx_nodes.13.mini, 34, nx_nodes.13.h)))
            let zz.13 = if(nx_drag == 14 or nx_rz == 14, 4, if(nx_nodes.13.sel, 3, if(nx_nodes.13.focus, 2, 0)))
            // A packet's place along its trace, 0 … 1: one beat per reading from the logic,
            // and a 700 ms gesture that carries every live trace's packet from end to end.
            // Between readings nothing moves, so the scene rests.
            let pz = clamp(nx_pk, 0, 1)
            let pulsing = nx_signals and pz > 0.004 and pz < 0.985

            group {
                clip box { from: 0, cy; size: sw, ch }

                // the ground: graphite falling from the banner into the strip
                body {
                    gradient: 0, cy to 0, cy + ch, fl.hull_raised, fl.ground
                    opacity: nx_fill
                    box { from: 0, cy; size: sw, ch }
                    show: not nx_clear
                }
                // the measured field in one pass, with a lamp under the hand (shaders/nexus-field)
                shader field { at: cx + cw / 2, cy + ch / 2; size: cw, ch; values: if(nx_grid, 1, 0), 0.4 + glow_amt * 0.6, nx_bright / 140
                               colors: fl.trace_dim, fl.trace }

                // the field's own corner marks, and what it measures
                line { from: cx, cy; to: cx + 20, cy; width: 1; color: fl.trace; opacity: 0.55 }
                line { from: cx, cy; to: cx, cy + 20; width: 1; color: fl.trace; opacity: 0.55 }
                line { from: cx + cw, cy; to: cx + cw - 20, cy; width: 1; color: fl.trace; opacity: 0.55 }
                line { from: cx + cw, cy; to: cx + cw, cy + 20; width: 1; color: fl.trace; opacity: 0.55 }
                line { from: cx, cy + ch; to: cx + 20, cy + ch; width: 1; color: fl.trace; opacity: 0.55 }
                line { from: cx, cy + ch; to: cx, cy + ch - 20; width: 1; color: fl.trace; opacity: 0.55 }
                line { from: cx + cw, cy + ch; to: cx + cw - 20, cy + ch; width: 1; color: fl.trace; opacity: 0.55 }
                line { from: cx + cw, cy + ch; to: cx + cw, cy + ch - 20; width: 1; color: fl.trace; opacity: 0.55 }
                text "NX FIELD   {cw, 0} × {ch, 0}" { at: cx + 2, cy + ch - 8; anchor: left center; size: 6.5
                     family: "Share Tech Mono"; color: fl.muted; opacity: 0.55; show: not tiny }
                text "GRID 36 / 180" { at: cx + cw - 2, cy + ch - 8; anchor: right center; size: 6.5
                     family: "Share Tech Mono"; color: fl.muted; opacity: 0.55; show: nx_grid and not tiny }

                // ── the traces: routed here from the two nodes' drawn boxes (the same sums as
                //    lib/nexusgraph.trace), so a trace follows a node while it is carried or
                //    springing, and drawn before the nodes so a node sits on its own trace ──
                repeat j in 0..13 {
                    let ea = nx_edges.$j.a
                    let eb = nx_edges.$j.b
                    let ax = cx + pick(ea, gx.0, gx.1, gx.2, gx.3, gx.4, gx.5, gx.6, gx.7, gx.8, gx.9, gx.10, gx.11, gx.12, gx.13)
                    let ay = cy + pick(ea, gy.0, gy.1, gy.2, gy.3, gy.4, gy.5, gy.6, gy.7, gy.8, gy.9, gy.10, gy.11, gy.12, gy.13)
                    let aw = pick(ea, gw.0, gw.1, gw.2, gw.3, gw.4, gw.5, gw.6, gw.7, gw.8, gw.9, gw.10, gw.11, gw.12, gw.13)
                    let ah = pick(ea, gh.0, gh.1, gh.2, gh.3, gh.4, gh.5, gh.6, gh.7, gh.8, gh.9, gh.10, gh.11, gh.12, gh.13)
                    let bx = cx + pick(eb, gx.0, gx.1, gx.2, gx.3, gx.4, gx.5, gx.6, gx.7, gx.8, gx.9, gx.10, gx.11, gx.12, gx.13)
                    let by = cy + pick(eb, gy.0, gy.1, gy.2, gy.3, gy.4, gy.5, gy.6, gy.7, gy.8, gy.9, gy.10, gy.11, gy.12, gy.13)
                    let bw = pick(eb, gw.0, gw.1, gw.2, gw.3, gw.4, gw.5, gw.6, gw.7, gw.8, gw.9, gw.10, gw.11, gw.12, gw.13)
                    let bh = pick(eb, gh.0, gh.1, gh.2, gh.3, gh.4, gh.5, gh.6, gh.7, gh.8, gh.9, gh.10, gh.11, gh.12, gh.13)
                    let hz = max(bx - (ax + aw), ax - (bx + bw)) >= max(by - (ay + ah), ay - (by + bh))
                    let oy = min(ay + ah, by + bh) - max(ay, by)
                    let ox = min(ax + aw, bx + bw) - max(ax, bx)
                    let x1 = if(hz, if(bx + bw / 2 >= ax + aw / 2, ax + aw, ax),
                                if(ox >= 24, (max(ax, bx) + min(ax + aw, bx + bw)) / 2, clamp(bx + bw / 2, ax + 12, ax + aw - 12)))
                    let x2 = if(hz, if(bx + bw / 2 >= ax + aw / 2, bx, bx + bw),
                                if(ox >= 24, (max(ax, bx) + min(ax + aw, bx + bw)) / 2, clamp(ax + aw / 2, bx + 12, bx + bw - 12)))
                    let y1 = if(hz, if(oy >= 24, (max(ay, by) + min(ay + ah, by + bh)) / 2, clamp(by + bh / 2, ay + 12, ay + ah - 12)),
                                if(by + bh / 2 >= ay + ah / 2, ay + ah, ay))
                    let y2 = if(hz, if(oy >= 24, (max(ay, by) + min(ay + ah, by + bh)) / 2, clamp(ay + ah / 2, by + 12, by + bh - 12)),
                                if(by + bh / 2 >= ay + ah / 2, by, by + bh))
                    let m = if(hz, (x1 + x2) / 2, (y1 + y2) / 2)
                    // the two corners, and the chamfer that turns them
                    let qx1 = if(hz, m, x1)
                    let qy1 = if(hz, y1, m)
                    let qx2 = if(hz, m, x2)
                    let qy2 = if(hz, y2, m)
                    let su = if(hz, if(x2 >= x1, 1, -1), if(y2 >= y1, 1, -1))
                    let sv = if(hz, if(y2 >= y1, 1, -1), if(x2 >= x1, 1, -1))
                    let ck = min(10, min(if(hz, abs(y2 - y1), abs(x2 - x1)) / 2, if(hz, abs(m - x1), abs(m - y1))))
                    let mx = if(hz, m, (x1 + x2) / 2)
                    let my = if(hz, (y1 + y2) / 2, m)
                    let picked = nx_edge_sel == j + 1
                    let hot = nx_hover_edge == j + 1 or (nx_hover > 0 and (ea + 1 == nx_hover or eb + 1 == nx_hover))
                    let lit = hot or picked
                    // its colour is written out where it is used: a colour let in a repeat
                    // cannot name the scene's own colour lets
                    let tw = if(lit, 2.2, nx_edge_width + if(nx_edges.$j.trunk, 0.4, 0))
                    let top = if(nx_edges.$j.dim and not lit, 0.22, 1)
                    // where the packet is, on whichever route the style draws
                    let l1 = abs(if(hz, m - x1, m - y1))
                    let l2 = abs(if(hz, y2 - y1, x2 - x1))
                    let l3 = abs(if(hz, x2 - m, y2 - m))
                    let dd = pz * max(1, l1 + l2 + l3)
                    let u = pz * 2 - if(pz < 0.5, 0, 1)
                    let kx = if(nx_edge_style == 3, x1 + (x2 - x1) * pz,
                             if(nx_edge_style == 2,
                                if(pz < 0.5, (1 - u) * (1 - u) * x1 + 2 * (1 - u) * u * qx1 + u * u * mx,
                                             (1 - u) * (1 - u) * mx + 2 * (1 - u) * u * qx2 + u * u * x2),
                                if(dd < l1, x1 + (qx1 - x1) * dd / max(l1, 0.001),
                                if(dd < l1 + l2, qx1 + (qx2 - qx1) * (dd - l1) / max(l2, 0.001),
                                                 qx2 + (x2 - qx2) * (dd - l1 - l2) / max(l3, 0.001)))))
                    let ky = if(nx_edge_style == 3, y1 + (y2 - y1) * pz,
                             if(nx_edge_style == 2,
                                if(pz < 0.5, (1 - u) * (1 - u) * y1 + 2 * (1 - u) * u * qy1 + u * u * my,
                                             (1 - u) * (1 - u) * my + 2 * (1 - u) * u * qy2 + u * u * y2),
                                if(dd < l1, y1 + (qy1 - y1) * dd / max(l1, 0.001),
                                if(dd < l1 + l2, qy1 + (qy2 - qy1) * (dd - l1) / max(l2, 0.001),
                                                 qy2 + (y2 - qy2) * (dd - l1 - l2) / max(l3, 0.001)))))
                    group {
                        show: nx_edges.$j.on
                        // the trace's own shadow, then the trace: two passes make the line
                        // sit in the field instead of on it
                        path { stroke: tw + 3; color: fl.ground; opacity: 0.5 * top; show: nx_edge_style == 1
                               move x1, y1; line qx1 - (if(hz, su, 0)) * ck, qy1 - (if(hz, 0, su)) * ck
                               line qx1 + (if(hz, 0, sv)) * ck, qy1 + (if(hz, sv, 0)) * ck
                               line qx2 - (if(hz, 0, sv)) * ck, qy2 - (if(hz, sv, 0)) * ck
                               line qx2 + (if(hz, su, 0)) * ck, qy2 + (if(hz, 0, su)) * ck; line x2, y2 }
                        path { stroke: tw; color: if(lit, ac, if(nx_edges.$j.active, mix(fl.trace, ac, 0.2 + nx_edges.$j.level * 0.45), if(nx_edges.$j.trunk, fl.trace, fl.trace_dim))); opacity: top; show: nx_edge_style == 1
                               move x1, y1; line qx1 - (if(hz, su, 0)) * ck, qy1 - (if(hz, 0, su)) * ck
                               line qx1 + (if(hz, 0, sv)) * ck, qy1 + (if(hz, sv, 0)) * ck
                               line qx2 - (if(hz, 0, sv)) * ck, qy2 - (if(hz, sv, 0)) * ck
                               line qx2 + (if(hz, su, 0)) * ck, qy2 + (if(hz, 0, su)) * ck; line x2, y2 }
                        path { stroke: tw + 3; color: fl.ground; opacity: 0.5 * top; show: nx_edge_style == 2
                               move x1, y1; curve mx, my via qx1, qy1; curve x2, y2 via qx2, qy2 }
                        path { stroke: tw; color: if(lit, ac, if(nx_edges.$j.active, mix(fl.trace, ac, 0.2 + nx_edges.$j.level * 0.45), if(nx_edges.$j.trunk, fl.trace, fl.trace_dim))); opacity: top; show: nx_edge_style == 2
                               move x1, y1; curve mx, my via qx1, qy1; curve x2, y2 via qx2, qy2 }
                        line { from: x1, y1; to: x2, y2; width: tw + 3; color: fl.ground; opacity: 0.5 * top; show: nx_edge_style == 3 }
                        line { from: x1, y1; to: x2, y2; width: tw; color: if(lit, ac, if(nx_edges.$j.active, mix(fl.trace, ac, 0.2 + nx_edges.$j.level * 0.45), if(nx_edges.$j.trunk, fl.trace, fl.trace_dim))); opacity: top; show: nx_edge_style == 3 }
                        // the pads where it leaves and lands: the node's port, drawn by its trace
                        box { at: x1, y1; size: 7, 7; corner: 1; color: fl.hull; opacity: top }
                        box { at: x1, y1; size: 7, 7; corner: 1; stroke: 1.2; color: if(lit, ac, if(nx_edges.$j.active, mix(fl.trace, ac, 0.2 + nx_edges.$j.level * 0.45), if(nx_edges.$j.trunk, fl.trace, fl.trace_dim))); opacity: top }
                        box { at: x2, y2; size: 7, 7; corner: 1; color: fl.hull; opacity: top }
                        box { at: x2, y2; size: 7, 7; corner: 1; stroke: 1.2; color: if(lit, ac, if(nx_edges.$j.active, mix(fl.trace, ac, 0.2 + nx_edges.$j.level * 0.45), if(nx_edges.$j.trunk, fl.trace, fl.trace_dim))); opacity: top }
                        box { at: x2, y2; size: 3, 3; color: if(lit, ac, if(nx_edges.$j.active, mix(fl.trace, ac, 0.2 + nx_edges.$j.level * 0.45), if(nx_edges.$j.trunk, fl.trace, fl.trace_dim))); opacity: top }

                        // a packet per reading, from the satellite into what it feeds
                        group {
                            show: pulsing and nx_edges.$j.active
                            box { at: kx, ky; size: 15, 15; corner: 8; color: ac; opacity: 0.16 * min(1, sin(pz * 180) * 2) * (0.5 + glow_amt * 0.5) }
                            box { at: kx, ky; size: 6, 6; corner: 3; color: mix(ac, fl.engrave, 0.35); opacity: min(1, sin(pz * 180) * 2.5) }
                        }

                        // the chip on the trace: what it carries, at its middle
                        group {
                            show: nx_edge_labels and (nx_edges.$j.trunk or lit or nx_edges.$j.active)
                            box { at: mx, my; size: 46, 15; corner: 2; color: fl.hull; opacity: 0.96 * top }
                            box { at: mx, my; size: 46, 15; corner: 2; stroke: 1; color: if(lit, ac, if(nx_edges.$j.active, mix(fl.trace, ac, 0.2 + nx_edges.$j.level * 0.45), if(nx_edges.$j.trunk, fl.trace, fl.trace_dim))); opacity: 0.85 * top }
                            text nx_edges.$j.label { at: mx, my + 0.5; anchor: center; size: 6.8; weight: 700; family: "Share Tech Mono"
                                                     color: mix(fl.muted, if(lit, ac, if(nx_edges.$j.active, mix(fl.trace, ac, 0.2 + nx_edges.$j.level * 0.45), if(nx_edges.$j.trunk, fl.trace, fl.trace_dim))), 0.85); opacity: top }
                        }
                        // hover inspection: what this connection means, in its own plate
                        group {
                            show: nx_hover_edge == j + 1 and not picked
                            let lx = min(mx + 30, max(cx + 4, cx + cw - 168))
                            Chamfer(lx, my + 10, 164, 38, 6, fl.hull, ac, 0.97, 1)
                            box { from: lx, my + 10; size: 164, 2; color: ac }
                            text nx_edges.$j.label { at: lx + 10, my + 22; anchor: left center; size: 7.5; weight: 700
                                                     family: "Share Tech Mono"; color: ac }
                            text nx_edges.$j.meaning { at: lx + 10, my + 36; anchor: left center; size: 7.5; family: "Share Tech Mono"
                                                       width: 146; lines: 1; color: fl.trace_lit }
                        }

                        // the trace is touched at its chip or anywhere on its middle run
                        zone box nec.$j { at: mx, my; size: 52, 20; cursor: pointer; role: button
                                          label: "Trace {nx_edges.$j.label}: {nx_edges.$j.meaning}" }
                        zone box nem.$j { from: min(qx1, qx2) - 5, min(qy1, qy2) - 5
                                          size: abs(qx2 - qx1) + 10, abs(qy2 - qy1) + 10; cursor: pointer; role: button
                                          label: "Trace {nx_edges.$j.label}" }
                        on enter nec.$j { nx_hover_edge = j + 1 }
                        on leave nec.$j { nx_hover_edge = 0 }
                        on enter nem.$j { nx_hover_edge = j + 1 }
                        on leave nem.$j { nx_hover_edge = 0 }
                        on press nec.$j { nx_ex = mx; nx_ey = my; emit nx_edge_pick(j + 1) }
                        on press nem.$j { nx_ex = mx; nx_ey = my; emit nx_edge_pick(j + 1) }
                    }
                }

                // the empty field: an invitation, not a blank canvas
                group {
                    show: nx_node_count < 1
                    Chamfer(cx + cw / 2 - 176, cy + ch / 2 - 62, 352, 124, 10, fl.hull, fl.trace, 0.94, 1)
                    NCorner(cx + cw / 2 - 170, cy + ch / 2 - 56, 340, 112, 12, ac, 0.4)
                    text "THE FIELD IS EMPTY" { at: cx + cw / 2, cy + ch / 2 - 26; anchor: center; size: 15; weight: 700
                                                family: "Exo 2"; color: fl.trace_lit }
                    text "Every module is in the library. Bring one back to begin." { at: cx + cw / 2, cy + ch / 2 - 2;
                         anchor: center; size: 8.5; family: "Share Tech Mono"; color: fl.muted }
                    zone box nx_empty_lib { from: cx + cw / 2 - 86, cy + ch / 2 + 22; size: 172, 26; cursor: pointer
                                            role: button; label: "Open the module library" }
                    NButton(cx + cw / 2 - 86, cy + ch / 2 + 22, 172, 26, "OPEN THE LIBRARY", 0, ac, nx_empty_lib.hover)
                    on press nx_empty_lib { nx_panel = library }
                }

                // ── the nodes: one per slot, the carried one and the centre drawn on top ──
                repeat i in 0..14 {  // the slots
                    let nx = cx + gx.$i
                    let ny = cy + gy.$i
                    let nw = gw.$i
                    let nh = gh.$i
                    let n_on = nx_nodes.$i.on
                    let n_foc = nx_nodes.$i.focus
                    let n_sel = nx_nodes.$i.sel
                    let n_min = nx_nodes.$i.mini
                    // the category tone, as a role the palette already owns: a signal colour
                    // rather than a hex, so the frame follows the wallpaper with everything else
                    let tone = rgb(
                        if(nx_nodes.$i.tone < 0.5, pr_muted_r, if(nx_nodes.$i.tone < 1.5, pr_phos_r, if(nx_nodes.$i.tone < 2.5, pr_flare_r, pr_ember_r))),
                        if(nx_nodes.$i.tone < 0.5, pr_muted_g, if(nx_nodes.$i.tone < 1.5, pr_phos_g, if(nx_nodes.$i.tone < 2.5, pr_flare_g, pr_ember_g))),
                        if(nx_nodes.$i.tone < 0.5, pr_muted_b, if(nx_nodes.$i.tone < 1.5, pr_phos_b, if(nx_nodes.$i.tone < 2.5, pr_flare_b, pr_ember_b))))
                    let big = nh >= 200 and nw >= 300
                    let spark = nx_nodes.$i.ser and nh >= 176
                    let row0 = ny + rail + if(spark, 114, 78)
                    let compact = not n_min and not n_foc
                    let detail = n_foc and not n_min
                    // the core at the centre is the reactor (drawn below), not a table of rows
                    let hero = detail and i == 0
                    group {
                        z: zz.$i
                        show: nd_o.$i > 0.01
                        opacity: nd_o.$i

                        // the frame's whole face is the hit area: the controls inside are
                        // declared after it, so they still take their own presses
                        zone box nf.$i { from: nx, ny; size: nw, nh; cursor: grab; role: item; selected: n_sel
                                         label: "{nx_nodes.$i.title}: {nx_nodes.$i.value}"; show: n_on }

                        // Shapes first and words last: the renderer draws a run of one kind in
                        // one go, and every switch between shapes and text costs a pass, so a
                        // card is all its plates, rules and bars, then all its words (D87).

                        // the housing: a cast plate under it (a hard offset, not a blur: no
                        // offscreen pass per node), the centred node's light drawn as rings
                        path { color: fl.ink; opacity: 0.5; show: not n_foc
                               move nx + 16, ny + 6; line nx + nw + 2, ny + 6; line nx + nw + 6, ny + 10
                               line nx + nw + 6, ny + nh - 6; line nx + nw - 6, ny + nh + 6
                               line nx + 10, ny + nh + 6; line nx + 6, ny + nh + 2; line nx + 6, ny + 16; close }
                        group {
                            show: n_foc or n_sel
                            path { stroke: 7; color: tone; opacity: (if(n_foc, 0.07, 0.05)) * (0.4 + glow_amt)
                                   move nx + 10, ny - 5; line nx + nw - 2, ny - 5; line nx + nw + 5, ny + 2
                                   line nx + nw + 5, ny + nh - 10; line nx + nw - 10, ny + nh + 5
                                   line nx + 2, ny + nh + 5; line nx - 5, ny + nh - 2; line nx - 5, ny + 10; close }
                            path { stroke: 1; color: tone; opacity: (if(n_foc, 0.3, 0.2)) * (0.4 + glow_amt)
                                   move nx + 11, ny - 8; line nx + nw - 1, ny - 8; line nx + nw + 8, ny + 1
                                   line nx + nw + 8, ny + nh - 11; line nx + nw - 11, ny + nh + 8
                                   line nx + 1, ny + nh + 8; line nx - 8, ny + nh - 1; line nx - 8, ny + 11; close }
                        }
                        body {
                            gradient: nx, ny to nx, ny + min(nh, 160), mix(fl.hull_raised, tone, 0.05 + nf.$i.hover * 0.04), mix(fl.hull, fl.well, if(n_foc, 0.16, 0.04))
                            rim: 6%
                            border: if(n_sel or n_foc, 1.4, 1), mix(fl.trace, tone, 0.28 + nf.$i.hover * 0.25 + if(n_sel, 0.35, 0) + if(n_foc, 0.3, 0))
                            opacity: max(nx_fill, 0.92)
                            path { move nx + 12, ny; line nx + nw - 4, ny; line nx + nw, ny + 4
                                   line nx + nw, ny + nh - 12; line nx + nw - 12, ny + nh
                                   line nx + 4, ny + nh; line nx, ny + nh - 4; line nx, ny + 12; close }
                        }
                        // the rail: a band of the node's own colour, its lower edge drawn
                        path { color: tone; opacity: 0.07 + nf.$i.hover * 0.05
                               move nx + 12, ny + 1; line nx + nw - 4, ny + 1; line nx + nw - 1, ny + 4
                               line nx + nw - 1, ny + rail; line nx + 1, ny + rail; line nx + 1, ny + 12; close }
                        box { from: nx + 1, ny + rail; size: max(0, nw - 2), 1; color: tone; opacity: 0.3; show: not n_min }
                        box { from: nx, ny + 12; size: 2.5, max(0, rail - 16); color: tone; opacity: 0.95 }
                        box { at: nx + nw - 30, ny + rail / 2; size: 6, 6; corner: 3
                              color: if(nx_nodes.$i.endsel, fl.flare, tone); opacity: 0.9 }
                        repeat d in 0..3 {
                            box { at: nx + nw - 16 + d * 4, ny + rail / 2; size: 2, 2; corner: 1
                                  color: mix(fl.muted, tone, nmh.$i.hover * 0.9) }
                        }

                        // the compact body's plates: its monitor and its bar
                        group {
                            show: compact
                            group {
                                show: spark
                                box { from: nx + 14, row0 - 10; size: max(0, nw - 28), 1; color: tone; opacity: 0.22 }
                                box { from: nx + 14, row0 - 24; size: max(0, nw - 28), 1; color: fl.trace; opacity: 0.08 }
                                path { color: tone; opacity: 0.09
                                       move (nx + 14), (ny + rail + 76) + 28
                                       line (nx + 14), (ny + rail + 76) + 28 - nx_nodes.$i.s1 * 28
                                       line (nx + 14) + (nw - 28) * 1 / 11, (ny + rail + 76) + 28 - nx_nodes.$i.s2 * 28
                                       line (nx + 14) + (nw - 28) * 2 / 11, (ny + rail + 76) + 28 - nx_nodes.$i.s3 * 28
                                       line (nx + 14) + (nw - 28) * 3 / 11, (ny + rail + 76) + 28 - nx_nodes.$i.s4 * 28
                                       line (nx + 14) + (nw - 28) * 4 / 11, (ny + rail + 76) + 28 - nx_nodes.$i.s5 * 28
                                       line (nx + 14) + (nw - 28) * 5 / 11, (ny + rail + 76) + 28 - nx_nodes.$i.s6 * 28
                                       line (nx + 14) + (nw - 28) * 6 / 11, (ny + rail + 76) + 28 - nx_nodes.$i.s7 * 28
                                       line (nx + 14) + (nw - 28) * 7 / 11, (ny + rail + 76) + 28 - nx_nodes.$i.s8 * 28
                                       line (nx + 14) + (nw - 28) * 8 / 11, (ny + rail + 76) + 28 - nx_nodes.$i.s9 * 28
                                       line (nx + 14) + (nw - 28) * 9 / 11, (ny + rail + 76) + 28 - nx_nodes.$i.s10 * 28
                                       line (nx + 14) + (nw - 28) * 10 / 11, (ny + rail + 76) + 28 - nx_nodes.$i.s11 * 28
                                       line (nx + 14) + (nw - 28) * 11 / 11, (ny + rail + 76) + 28 - nx_nodes.$i.s12 * 28
                                       line (nx + 14) + (nw - 28), (ny + rail + 76) + 28; close }
                                path { stroke: 1.3; color: tone; opacity: 0.8
                                       move (nx + 14), (ny + rail + 76) + 28 - nx_nodes.$i.s1 * 28
                                       line (nx + 14) + (nw - 28) * 1 / 11, (ny + rail + 76) + 28 - nx_nodes.$i.s2 * 28
                                       line (nx + 14) + (nw - 28) * 2 / 11, (ny + rail + 76) + 28 - nx_nodes.$i.s3 * 28
                                       line (nx + 14) + (nw - 28) * 3 / 11, (ny + rail + 76) + 28 - nx_nodes.$i.s4 * 28
                                       line (nx + 14) + (nw - 28) * 4 / 11, (ny + rail + 76) + 28 - nx_nodes.$i.s5 * 28
                                       line (nx + 14) + (nw - 28) * 5 / 11, (ny + rail + 76) + 28 - nx_nodes.$i.s6 * 28
                                       line (nx + 14) + (nw - 28) * 6 / 11, (ny + rail + 76) + 28 - nx_nodes.$i.s7 * 28
                                       line (nx + 14) + (nw - 28) * 7 / 11, (ny + rail + 76) + 28 - nx_nodes.$i.s8 * 28
                                       line (nx + 14) + (nw - 28) * 8 / 11, (ny + rail + 76) + 28 - nx_nodes.$i.s9 * 28
                                       line (nx + 14) + (nw - 28) * 9 / 11, (ny + rail + 76) + 28 - nx_nodes.$i.s10 * 28
                                       line (nx + 14) + (nw - 28) * 10 / 11, (ny + rail + 76) + 28 - nx_nodes.$i.s11 * 28
                                       line (nx + 14) + (nw - 28) * 11 / 11, (ny + rail + 76) + 28 - nx_nodes.$i.s12 * 28 }
                            }
                            box { from: nx + 14, ny + nh - 17; size: max(0, nw - 28), 4; corner: 1; color: fl.ground; opacity: 0.85 }
                            box { from: nx + 14, ny + nh - 17; size: max(0, (nw - 28) * clamp(nx_nodes.$i.bar, 0, 1)), 4; corner: 1
                                  color: tone; opacity: 0.9; show: nx_nodes.$i.baron }
                            box { from: nx + 14 + max(0, (nw - 28) * clamp(nx_nodes.$i.bar, 0, 1)) - 2, ny + nh - 20
                                  size: 2, 10; color: mix(fl.hull, tone, 0.7); show: nx_nodes.$i.baron }
                            repeat t in 0..4 {
                                box { from: nx + 14 + (nw - 28) * (t + 1) / 5, ny + nh - 17; size: 1, 4; color: fl.hull; opacity: 0.45 }
                            }
                        }
                        // the detail body's plates: a margin rule, two bars and the monitor
                        group {
                            show: detail and not (i == 0 and nx_centre != core)
                            box { from: nx + 11, ny + rail + 18; size: 1, max(0, nh - rail - 34); color: tone; opacity: 0.16 }
                            box { from: nx + 18, ny + rail + 74; size: max(0, nw - 36), 4; corner: 1; color: fl.ground; opacity: 0.85 }
                            box { from: nx + 18, ny + rail + 74; size: max(0, (nw - 36) * clamp(nx_nodes.$i.bar, 0, 1)), 4; corner: 1
                                  color: tone; opacity: 0.9; show: nx_nodes.$i.baron }
                            repeat t in 0..9 {
                                box { from: nx + 18 + (nw - 36) * (t + 1) / 10, ny + rail + 74; size: 1, 4; color: fl.hull; opacity: 0.4 }
                            }
                            box { from: nx + 84, ny + rail + 87; size: max(0, nw - 102), 2; color: fl.ground
                                  opacity: 0.85; show: nx_nodes.$i.bar2on }
                            box { from: nx + 84, ny + rail + 87; size: max(0, (nw - 102) * clamp(nx_nodes.$i.bar2, 0, 1)), 2
                                  color: tone; opacity: 0.65; show: nx_nodes.$i.bar2on }
                            group {
                                show: nx_nodes.$i.ser
                                box { from: (nx + 18 + (nw - 36) * 0.46), (ny + rail + 20) + 48; size: ((nw - 36) * 0.54), 1; color: tone; opacity: 0.25 }
                                box { from: (nx + 18 + (nw - 36) * 0.46), (ny + rail + 20); size: 1, 48; color: tone; opacity: 0.16 }
                                box { from: (nx + 18 + (nw - 36) * 0.46), (ny + rail + 20) + 48 / 2; size: ((nw - 36) * 0.54), 1; color: fl.trace; opacity: 0.1 }
                                path { color: tone; opacity: 0.1
                                       move (nx + 18 + (nw - 36) * 0.46), (ny + rail + 20) + 48
                                       line (nx + 18 + (nw - 36) * 0.46), (ny + rail + 20) + 48 - nx_nodes.$i.s1 * 48
                                       line (nx + 18 + (nw - 36) * 0.46) + ((nw - 36) * 0.54) * 1 / 11, (ny + rail + 20) + 48 - nx_nodes.$i.s2 * 48
                                       line (nx + 18 + (nw - 36) * 0.46) + ((nw - 36) * 0.54) * 2 / 11, (ny + rail + 20) + 48 - nx_nodes.$i.s3 * 48
                                       line (nx + 18 + (nw - 36) * 0.46) + ((nw - 36) * 0.54) * 3 / 11, (ny + rail + 20) + 48 - nx_nodes.$i.s4 * 48
                                       line (nx + 18 + (nw - 36) * 0.46) + ((nw - 36) * 0.54) * 4 / 11, (ny + rail + 20) + 48 - nx_nodes.$i.s5 * 48
                                       line (nx + 18 + (nw - 36) * 0.46) + ((nw - 36) * 0.54) * 5 / 11, (ny + rail + 20) + 48 - nx_nodes.$i.s6 * 48
                                       line (nx + 18 + (nw - 36) * 0.46) + ((nw - 36) * 0.54) * 6 / 11, (ny + rail + 20) + 48 - nx_nodes.$i.s7 * 48
                                       line (nx + 18 + (nw - 36) * 0.46) + ((nw - 36) * 0.54) * 7 / 11, (ny + rail + 20) + 48 - nx_nodes.$i.s8 * 48
                                       line (nx + 18 + (nw - 36) * 0.46) + ((nw - 36) * 0.54) * 8 / 11, (ny + rail + 20) + 48 - nx_nodes.$i.s9 * 48
                                       line (nx + 18 + (nw - 36) * 0.46) + ((nw - 36) * 0.54) * 9 / 11, (ny + rail + 20) + 48 - nx_nodes.$i.s10 * 48
                                       line (nx + 18 + (nw - 36) * 0.46) + ((nw - 36) * 0.54) * 10 / 11, (ny + rail + 20) + 48 - nx_nodes.$i.s11 * 48
                                       line (nx + 18 + (nw - 36) * 0.46) + ((nw - 36) * 0.54) * 11 / 11, (ny + rail + 20) + 48 - nx_nodes.$i.s12 * 48
                                       line (nx + 18 + (nw - 36) * 0.46) + ((nw - 36) * 0.54), (ny + rail + 20) + 48; close }
                                path { stroke: 1.6; color: tone; opacity: 1
                                       move (nx + 18 + (nw - 36) * 0.46), (ny + rail + 20) + 48 - nx_nodes.$i.s1 * 48
                                       line (nx + 18 + (nw - 36) * 0.46) + ((nw - 36) * 0.54) * 1 / 11, (ny + rail + 20) + 48 - nx_nodes.$i.s2 * 48
                                       line (nx + 18 + (nw - 36) * 0.46) + ((nw - 36) * 0.54) * 2 / 11, (ny + rail + 20) + 48 - nx_nodes.$i.s3 * 48
                                       line (nx + 18 + (nw - 36) * 0.46) + ((nw - 36) * 0.54) * 3 / 11, (ny + rail + 20) + 48 - nx_nodes.$i.s4 * 48
                                       line (nx + 18 + (nw - 36) * 0.46) + ((nw - 36) * 0.54) * 4 / 11, (ny + rail + 20) + 48 - nx_nodes.$i.s5 * 48
                                       line (nx + 18 + (nw - 36) * 0.46) + ((nw - 36) * 0.54) * 5 / 11, (ny + rail + 20) + 48 - nx_nodes.$i.s6 * 48
                                       line (nx + 18 + (nw - 36) * 0.46) + ((nw - 36) * 0.54) * 6 / 11, (ny + rail + 20) + 48 - nx_nodes.$i.s7 * 48
                                       line (nx + 18 + (nw - 36) * 0.46) + ((nw - 36) * 0.54) * 7 / 11, (ny + rail + 20) + 48 - nx_nodes.$i.s8 * 48
                                       line (nx + 18 + (nw - 36) * 0.46) + ((nw - 36) * 0.54) * 8 / 11, (ny + rail + 20) + 48 - nx_nodes.$i.s9 * 48
                                       line (nx + 18 + (nw - 36) * 0.46) + ((nw - 36) * 0.54) * 9 / 11, (ny + rail + 20) + 48 - nx_nodes.$i.s10 * 48
                                       line (nx + 18 + (nw - 36) * 0.46) + ((nw - 36) * 0.54) * 10 / 11, (ny + rail + 20) + 48 - nx_nodes.$i.s11 * 48
                                       line (nx + 18 + (nw - 36) * 0.46) + ((nw - 36) * 0.54) * 11 / 11, (ny + rail + 20) + 48 - nx_nodes.$i.s12 * 48 }
                            }
                        }
                        // the rules under the readings
                        box { from: nx + if(n_foc, 18, 14), if(n_foc, ny + rail + 92, row0 + 0); size: max(0, nw - if(n_foc, 36, 28)), 1; color: if(1 == 1, tone, fl.trace); opacity: if(1 == 1, 0.22, 0.12); show: not n_min and not hero and nx_nodes.$i.rows >= 1 }
                        box { from: nx + if(n_foc, 18, 14), if(n_foc, ny + rail + 118, row0 + 22); size: max(0, nw - if(n_foc, 36, 28)), 1; color: if(2 == 1, tone, fl.trace); opacity: if(2 == 1, 0.22, 0.12); show: not n_min and not hero and nx_nodes.$i.rows >= 2 }
                        box { from: nx + if(n_foc, 18, 14), if(n_foc, ny + rail + 144, row0 + 44); size: max(0, nw - if(n_foc, 36, 28)), 1; color: if(3 == 1, tone, fl.trace); opacity: if(3 == 1, 0.22, 0.12); show: not n_min and not hero and nx_nodes.$i.rows >= 3 }
                        box { from: nx + if(n_foc, 18, 14), if(n_foc, ny + rail + 170, row0 + 66); size: max(0, nw - if(n_foc, 36, 28)), 1; color: if(4 == 1, tone, fl.trace); opacity: if(4 == 1, 0.22, 0.12); show: not n_min and not hero and nx_nodes.$i.rows >= 4 }
                        box { from: nx + if(n_foc, 18, 14), if(n_foc, ny + rail + 196, row0 + 88); size: max(0, nw - if(n_foc, 36, 28)), 1; color: if(5 == 1, tone, fl.trace); opacity: if(5 == 1, 0.22, 0.12); show: not n_min and not hero and nx_nodes.$i.rows >= 5 }
                        box { from: nx + if(n_foc, 18, 14), if(n_foc, ny + rail + 222, row0 + 110); size: max(0, nw - if(n_foc, 36, 28)), 1; color: if(6 == 1, tone, fl.trace); opacity: if(6 == 1, 0.22, 0.12); show: not n_min and not hero and nx_nodes.$i.rows >= 6 }
                        box { from: nx + if(n_foc, 18, 14), if(n_foc, ny + rail + 248, row0 + 132); size: max(0, nw - if(n_foc, 36, 28)), 1; color: if(7 == 1, tone, fl.trace); opacity: if(7 == 1, 0.22, 0.12); show: not n_min and not hero and nx_nodes.$i.rows >= 7 }
                        box { from: nx + if(n_foc, 18, 14), if(n_foc, ny + rail + 274, row0 + 154); size: max(0, nw - if(n_foc, 36, 28)), 1; color: if(8 == 1, tone, fl.trace); opacity: if(8 == 1, 0.22, 0.12); show: not n_min and not hero and nx_nodes.$i.rows >= 8 }

                        // the selected frame wears its brackets, over its own controls
                        group {
                            show: n_sel or n_foc
                            NCorner(nx - 4, ny - 4, nw + 8, nh + 8, 12, if(nx_nodes.$i.endsel, fl.flare, tone), if(n_sel, 0.85, 0.45))
                        }
                        group {
                            show: n_sel
                            box { from: nx + 2, ny - 15; size: 92, 13; corner: 2; color: fl.hull; opacity: 0.94 }
                            box { from: nx + 2, ny - 15; size: 92, 13; corner: 2; stroke: 1; color: tone; opacity: 0.6 }
                        }
                        group {
                            show: not n_min and n_on
                            line { from: nx + nw - 14, ny + nh - 4; to: nx + nw - 4, ny + nh - 14; width: 1.4
                                   color: mix(fl.trace, tone, ngr.$i.hover * 0.8) }
                            line { from: nx + nw - 8, ny + nh - 4; to: nx + nw - 4, ny + nh - 8; width: 1.4
                                   color: mix(fl.trace, tone, ngr.$i.hover * 0.8) }
                        }

                        // ── the words ──
                        text "N{nx_nodes.$i.code, 0}" { at: nx + 12, ny + rail / 2; anchor: left center; size: 6.5
                                                        family: "Share Tech Mono"; color: mix(fl.muted, tone, 0.55) }
                        text nx_nodes.$i.title { at: nx + 34, ny + rail / 2; anchor: left center; size: 9.5; weight: 700; family: "Exo 2"
                                                 width: max(40, nw - if(n_min, 170, 100)); lines: 1; color: mix(fl.muted, tone, 0.95) }
                        text pick(n_foc, "{upper(nx_nodes.$i.key)}", "CENTRE") { at: nx + nw - 40, ny + rail / 2; anchor: right center
                             size: 6.5; family: "Share Tech Mono"; color: mix(fl.muted, tone, if(n_foc, 0.9, 0.35)); show: not n_min and not (i == 0 and n_foc) }
                        // a closed module keeps its reading on the rail
                        text nx_nodes.$i.value { at: nx + nw - 40, ny + rail / 2; anchor: right center; size: 9; weight: 700
                                                 family: "Exo 2"; width: 110; lines: 1; color: mix(fl.hull, tone, 0.85); show: n_min }
                        group {
                            show: compact
                            text nx_nodes.$i.value { at: nx + 14, ny + rail + 27; anchor: left center; size: 26; weight: 700
                                                     family: "Exo 2"; width: max(40, nw - 28); lines: 1; color: mix(fl.hull, tone, 0.96); show: big }
                            text nx_nodes.$i.value { at: nx + 14, ny + rail + 27; anchor: left center; size: 20; weight: 700
                                                     family: "Exo 2"; width: max(40, nw - 28); lines: 1; color: mix(fl.hull, tone, 0.96); show: not big }
                            text nx_nodes.$i.note { at: nx + 14, ny + rail + 49; anchor: left center; size: 7.5; family: "Share Tech Mono"
                                                    width: max(40, nw - 28); lines: 1; color: fl.muted }
                            text nx_nodes.$i.sub { at: nx + 14, ny + rail + 64; anchor: left center; size: 7; family: "Share Tech Mono"
                                                   width: max(40, nw - 28); lines: 1; color: fl.trace_lit; opacity: 0.8; show: nh >= 118 }
                        }
                        group {
                            show: detail and not (i == 0 and nx_centre != core)
                            text nx_nodes.$i.value { at: nx + 18, ny + rail + 32; anchor: left center; size: 28; weight: 700; family: "Exo 2"
                                                     width: if(nx_nodes.$i.ser, max(60, (nw - 36) * 0.44), max(60, nw - 36)); lines: 1
                                                     color: mix(fl.hull, tone, 0.97) }
                            text nx_nodes.$i.note { at: nx + 18, ny + rail + 60; anchor: left center; size: 8.5; family: "Share Tech Mono"
                                                    width: if(nx_nodes.$i.ser, max(60, (nw - 36) * 0.44), max(60, nw - 36)); lines: 1
                                                    color: fl.trace_lit }
                            text nx_nodes.$i.bar2l { at: nx + 18, ny + rail + 88; anchor: left center; size: 5.8; family: "Share Tech Mono"
                                                     width: 64; lines: 1; color: fl.trace_lit; opacity: 0.7; show: nx_nodes.$i.bar2on }
                            text "LAST 24 S" { at: nx + nw - 18, ny + rail + 12; anchor: right center; size: 5.8
                                               family: "Share Tech Mono"; color: fl.muted; show: nx_nodes.$i.ser }
                        }
                        text nx_nodes.$i.r1l { at: nx + if(n_foc, 18, 14), if(n_foc, ny + rail + 104, row0 + 11); anchor: left center; size: 7
                                               family: "Share Tech Mono"; color: fl.muted; show: not n_min and not hero and nx_nodes.$i.rows >= 1 }
                        text nx_nodes.$i.r1v { at: nx + nw - if(n_foc, 18, 14), if(n_foc, ny + rail + 104, row0 + 11); anchor: right center; size: 10
                                               family: "Exo 2"; width: max(60, nw - 112); lines: 1; color: mix(fl.hull, tone, 0.9); show: not n_min and not hero and nx_nodes.$i.rows >= 1 }
                        text nx_nodes.$i.r2l { at: nx + if(n_foc, 18, 14), if(n_foc, ny + rail + 130, row0 + 33); anchor: left center; size: 7
                                               family: "Share Tech Mono"; color: fl.muted; show: not n_min and not hero and nx_nodes.$i.rows >= 2 }
                        text nx_nodes.$i.r2v { at: nx + nw - if(n_foc, 18, 14), if(n_foc, ny + rail + 130, row0 + 33); anchor: right center; size: 10
                                               family: "Exo 2"; width: max(60, nw - 112); lines: 1; color: mix(fl.hull, tone, 0.9); show: not n_min and not hero and nx_nodes.$i.rows >= 2 }
                        text nx_nodes.$i.r3l { at: nx + if(n_foc, 18, 14), if(n_foc, ny + rail + 156, row0 + 55); anchor: left center; size: 7
                                               family: "Share Tech Mono"; color: fl.muted; show: not n_min and not hero and nx_nodes.$i.rows >= 3 }
                        text nx_nodes.$i.r3v { at: nx + nw - if(n_foc, 18, 14), if(n_foc, ny + rail + 156, row0 + 55); anchor: right center; size: 10
                                               family: "Exo 2"; width: max(60, nw - 112); lines: 1; color: mix(fl.hull, tone, 0.9); show: not n_min and not hero and nx_nodes.$i.rows >= 3 }
                        text nx_nodes.$i.r4l { at: nx + if(n_foc, 18, 14), if(n_foc, ny + rail + 182, row0 + 77); anchor: left center; size: 7
                                               family: "Share Tech Mono"; color: fl.muted; show: not n_min and not hero and nx_nodes.$i.rows >= 4 }
                        text nx_nodes.$i.r4v { at: nx + nw - if(n_foc, 18, 14), if(n_foc, ny + rail + 182, row0 + 77); anchor: right center; size: 10
                                               family: "Exo 2"; width: max(60, nw - 112); lines: 1; color: mix(fl.hull, tone, 0.9); show: not n_min and not hero and nx_nodes.$i.rows >= 4 }
                        text nx_nodes.$i.r5l { at: nx + if(n_foc, 18, 14), if(n_foc, ny + rail + 208, row0 + 99); anchor: left center; size: 7
                                               family: "Share Tech Mono"; color: fl.muted; show: not n_min and not hero and nx_nodes.$i.rows >= 5 }
                        text nx_nodes.$i.r5v { at: nx + nw - if(n_foc, 18, 14), if(n_foc, ny + rail + 208, row0 + 99); anchor: right center; size: 10
                                               family: "Exo 2"; width: max(60, nw - 112); lines: 1; color: mix(fl.hull, tone, 0.9); show: not n_min and not hero and nx_nodes.$i.rows >= 5 }
                        text nx_nodes.$i.r6l { at: nx + if(n_foc, 18, 14), if(n_foc, ny + rail + 234, row0 + 121); anchor: left center; size: 7
                                               family: "Share Tech Mono"; color: fl.muted; show: not n_min and not hero and nx_nodes.$i.rows >= 6 }
                        text nx_nodes.$i.r6v { at: nx + nw - if(n_foc, 18, 14), if(n_foc, ny + rail + 234, row0 + 121); anchor: right center; size: 10
                                               family: "Exo 2"; width: max(60, nw - 112); lines: 1; color: mix(fl.hull, tone, 0.9); show: not n_min and not hero and nx_nodes.$i.rows >= 6 }
                        text nx_nodes.$i.r7l { at: nx + if(n_foc, 18, 14), if(n_foc, ny + rail + 260, row0 + 143); anchor: left center; size: 7
                                               family: "Share Tech Mono"; color: fl.muted; show: not n_min and not hero and nx_nodes.$i.rows >= 7 }
                        text nx_nodes.$i.r7v { at: nx + nw - if(n_foc, 18, 14), if(n_foc, ny + rail + 260, row0 + 143); anchor: right center; size: 10
                                               family: "Exo 2"; width: max(60, nw - 112); lines: 1; color: mix(fl.hull, tone, 0.9); show: not n_min and not hero and nx_nodes.$i.rows >= 7 }
                        text nx_nodes.$i.r8l { at: nx + if(n_foc, 18, 14), if(n_foc, ny + rail + 286, row0 + 165); anchor: left center; size: 7
                                               family: "Share Tech Mono"; color: fl.muted; show: not n_min and not hero and nx_nodes.$i.rows >= 8 }
                        text nx_nodes.$i.r8v { at: nx + nw - if(n_foc, 18, 14), if(n_foc, ny + rail + 286, row0 + 165); anchor: right center; size: 10
                                               family: "Exo 2"; width: max(60, nw - 112); lines: 1; color: mix(fl.hull, tone, 0.9); show: not n_min and not hero and nx_nodes.$i.rows >= 8 }
                        text "N{nx_nodes.$i.code, 0}  SELECTED" { at: nx + 9, ny - 8.5; anchor: left center; size: 6
                             family: "Share Tech Mono"; color: tone; show: n_sel }

                        // the frame's own gesture: press to select, drag to carry
                        on press nf.$i { nx_press = i + 1; nx_menu = 0 }
                        on enter nf.$i { nx_hover = i + 1 }
                        on leave nf.$i { nx_hover = 0 }
                        on drag nf.$i while nx_press == i + 1 and not nx_pinned {
                            nx_cw = cw; nx_ch = ch
                            nx_gx = clamp(nx_nodes.$i.x + drag.dx, 0, max(0, cw - nx_nodes.$i.w))
                            nx_gy = clamp(nx_nodes.$i.y + drag.dy, 0, max(0, ch - nh))
                            nx_drag = if(abs(drag.dx) + abs(drag.dy) > 4, i + 1, nx_drag)
                        }
                        // the logic lets go of the carried node once its answer is out
                        on release nf.$i while nx_drag == i + 1 { emit nx_drop(i + 1); nx_press = 0 }
                        on release nf.$i while nx_drag != i + 1 and nx_press == i + 1 { emit nx_select(i + 1); nx_press = 0 }

                        zone box nmh.$i { from: nx + nw - 22, ny + 2; size: 20, rail - 3; cursor: pointer; role: button
                                          label: "Actions for {nx_nodes.$i.title}"; show: n_on }
                        on press nmh.$i { nx_menu = if(nx_menu == i + 1, 0, i + 1) }

                        zone box ngr.$i { from: nx + nw - 18, ny + nh - 18; size: 18, 18; cursor: pointer; role: item
                                          label: "Resize {nx_nodes.$i.title}"; show: not n_min and n_on }
                        on press ngr.$i { nx_rz = i + 1; nx_rw = nx_nodes.$i.w; nx_rh = nx_nodes.$i.h }
                        on drag ngr.$i while nx_rz == i + 1 and not nx_pinned {
                            nx_cw = cw; nx_ch = ch
                            nx_rw = clamp(nx_nodes.$i.w + drag.dx, nx_nodes.$i.minw, min(nx_nodes.$i.maxw, max(0, cw - nx_nodes.$i.x)))
                            nx_rh = clamp(nx_nodes.$i.h + drag.dy, nx_nodes.$i.minh, min(nx_nodes.$i.maxh, max(0, ch - nx_nodes.$i.y)))
                        }
                        on release ngr.$i while nx_rz == i + 1 { emit nx_resize(i + 1) }
                    }
                }

                // ── what only one node does, drawn over that node's own slot ──
                // CORE (slot 0) at the centre: the reactor — four live rings (load, memory,
                // temperature, disk) round the load, the machine's name above, a legend under it
                group {
                    z: zz.0
                    show: nx_nodes.0.focus and not nx_nodes.0.mini and nd_o.0 > 0.5 and nx_centre == core
                    let rtop = cy + gy.0 + rail + 76
                    let rleg = cy + gy.0 + gh.0 - 46
                    let rr = max(40, min(gw.0 / 2 - 44, (rleg - rtop) / 2 - 8))
                    let rx0 = cx + gx.0 + gw.0 / 2
                    let ry0 = (rtop + rleg) / 2
                    // the dial: 60 ticks, every fifth long
                    repeat k in 0..60 {
                        line { from: rx0 + sin(k * 6) * (rr + 10), ry0 - cos(k * 6) * (rr + 10)
                               to: rx0 + sin(k * 6) * (rr + if(mod(k, 5) == 0, 18, 14)), ry0 - cos(k * 6) * (rr + if(mod(k, 5) == 0, 18, 14))
                               width: if(mod(k, 5) == 0, 1.4, 0.8); color: fl.trace; opacity: if(mod(k, 5) == 0, 0.7, 0.35) }
                    }
                    // the tracks
                    arc { at: rx0, ry0; radius: rr; width: 8; span: 360deg; color: fl.well; opacity: 0.9 }
                    arc { at: rx0, ry0; radius: rr - 15; width: 8; span: 360deg; color: fl.well; opacity: 0.9 }
                    arc { at: rx0, ry0; radius: rr - 30; width: 8; span: 360deg; color: fl.well; opacity: 0.9 }
                    arc { at: rx0, ry0; radius: rr - 45; width: 8; span: 360deg; color: fl.well; opacity: 0.9 }
                    // the readings, lit
                    group {
                        glow: 10, 40% * glow_amt, ac
                        arc { at: rx0, ry0; radius: rr; width: 8; span: rc_cpu * 360deg; rotate: rc_cpu * 180deg; color: ac; show: nx_cpu_on }
                        arc { at: rx0, ry0; radius: rr - 15; width: 8; span: rc_mem * 360deg; rotate: rc_mem * 180deg; color: fl.trace_lit; show: nx_ram_on }
                        arc { at: rx0, ry0; radius: rr - 30; width: 8; span: rc_tmp * 360deg; rotate: rc_tmp * 180deg; color: fl.ember; show: nx_temp_on }
                        arc { at: rx0, ry0; radius: rr - 45; width: 8; span: rc_dsk * 360deg; rotate: rc_dsk * 180deg; color: fl.flare; show: nx_disk_on }
                    }
                    // the hub of it
                    ellipse { at: rx0, ry0; radius: rr - 56; color: fl.hull; opacity: 0.95 }
                    ellipse { at: rx0, ry0; radius: rr - 56; stroke: 1; color: mix(fl.trace, ac, 0.4) }
                    text "{rc_cpu * 100, 0}%" { at: rx0, ry0 - 4; anchor: center; size: 26; weight: 700; family: "Exo 2"
                                                 color: mix(fl.engrave, ac, 0.6) }
                    text "LOAD" { at: rx0, ry0 + rr * 0.2; anchor: center; size: 7; weight: 700; family: "Share Tech Mono"; color: fl.muted }
                    // the legend: one cell per ring, its colour, its word, its reading
                    repeat k in 0..4 {
                        box { from: cx + gx.0 + 18 + k * (gw.0 - 36) / 4, rleg + 8; size: 10, 3
                              color: pick(k, ac, fl.trace_lit, fl.ember, fl.flare) }
                        text pick(k, "LOAD", "MEMORY", "TEMP", "DISK") { at: cx + gx.0 + 18 + k * (gw.0 - 36) / 4, rleg + 20
                              anchor: left center; size: 6.6; weight: 700; family: "Share Tech Mono"; color: fl.muted }
                    }
                    text nx_cpu_value { at: cx + gx.0 + 18, rleg + 33; anchor: left center; size: 11; weight: 700; family: "Exo 2"; color: ac }
                    text "{nx_ram * 100, 0}%" { at: cx + gx.0 + 18 + (gw.0 - 36) / 4, rleg + 33; anchor: left center; size: 11; weight: 700
                                                family: "Exo 2"; color: fl.trace_lit }
                    text nx_temp_value { at: cx + gx.0 + 18 + (gw.0 - 36) / 2, rleg + 33; anchor: left center; size: 11; weight: 700
                                         family: "Exo 2"; color: fl.ember }
                    text "{nx_disk * 100, 0}%" { at: cx + gx.0 + 18 + (gw.0 - 36) * 3 / 4, rleg + 33; anchor: left center; size: 11; weight: 700
                                                 family: "Exo 2"; color: fl.flare }
                }
                // CORE's other faces at the centre (`nexus.centre`): who you are over the banner,
                // the player with its cover and visualiser, or both. FACE on the rail cycles them.
                group {
                    z: zz.0
                    show: nx_nodes.0.focus and not nx_nodes.0.mini and nd_o.0 > 0.5
                    let cf_fx0 = cx + gx.0
                    let cf_fy0 = cy + gy.0
                    let cf_fw = gw.0
                    let cf_fh = gh.0
                    zone box nx_face { from: cf_fx0 + cf_fw - 150, cf_fy0 + 4; size: 120, rail - 8; cursor: pointer; role: button
                                       label: "Change the centre's face" }
                    group { show: nx_centre == core
                        NChip(cf_fx0 + cf_fw - 150, cf_fy0 + (rail - 20) / 2, 120, "FACE · REACTOR ›", nx_face.hover, ac) }
                    group { show: nx_centre == identity
                        NChip(cf_fx0 + cf_fw - 150, cf_fy0 + (rail - 20) / 2, 120, "FACE · IDENTITY ›", nx_face.hover, ac) }
                    group { show: nx_centre == player
                        NChip(cf_fx0 + cf_fw - 150, cf_fy0 + (rail - 20) / 2, 120, "FACE · PLAYER ›", nx_face.hover, ac) }
                    group { show: nx_centre == both
                        NChip(cf_fx0 + cf_fw - 150, cf_fy0 + (rail - 20) / 2, 120, "FACE · ID + PLAYER ›", nx_face.hover, ac) }
                    on press nx_face { emit nx_centre_set(if(nx_centre == core, 1, if(nx_centre == identity, 2, if(nx_centre == player, 3, 0)))) }

                    // ── IDENTITY, and the cf_top of ID + PLAYER: the banner, the avatar on its edge,
                    //    the name and the machine ──
                    group {
                        show: nx_centre == identity or nx_centre == both
                        let cf_solo = nx_centre == identity
                        let cf_bh = if(cf_solo, max(90, cf_fh * 0.34), 74)
                        let cf_av = if(cf_solo, 104, 60)
                        let cf_ay = cf_fy0 + rail + cf_bh - if(cf_solo, cf_av / 2, cf_av - 10)
                        let cf_ax = if(cf_solo, cf_fx0 + cf_fw / 2 - cf_av / 2, cf_fx0 + 18)
                        group {
                            clip box { from: cf_fx0 + 1, cf_fy0 + rail; size: cf_fw - 2, cf_bh }
                            body { gradient: cf_fx0, cf_fy0 + rail to cf_fx0 + cf_fw, cf_fy0 + rail + cf_bh, mix(fl.hull_raised, ac, 0.22), fl.hull
                                   box { from: cf_fx0, cf_fy0 + rail; size: cf_fw, cf_bh } }
                            image nx_banner_big { at: cf_fx0 + 1, cf_fy0 + rail + cf_bh / 2 - (cf_fw - 2) * 300 / 840 / 2; size: cf_fw - 2, (cf_fw - 2) * 300 / 840
                                                  show: nx_banner_on }
                            body { gradient: 0, cf_fy0 + rail + cf_bh * 0.4 to 0, cf_fy0 + rail + cf_bh, fl.hull_raised, fl.hull
                                   box { from: cf_fx0, cf_fy0 + rail + cf_bh * 0.4; size: cf_fw, cf_bh * 0.6 }; opacity: 0.7 }
                        }
                        box { from: cf_fx0 + 1, cf_fy0 + rail + cf_bh; size: cf_fw - 2, 1; color: mix(fl.trace, ac, 0.6) }
                        group {
                            glow: 14, 30% * glow_amt, ac
                            Chamfer(cf_ax - 4, cf_ay - 4, cf_av + 8, cf_av + 8, 10, fl.hull, mix(fl.trace, ac, 0.8), 1, 1.4)
                        }
                        image nx_avatar_big { at: cf_ax, cf_ay; size: cf_av, cf_av; show: nx_avatar_on }
                        text nx_initial { at: cf_ax + cf_av / 2, cf_ay + cf_av / 2; anchor: center; align: center; size: 44; weight: 700; family: "Exo 2"
                                          color: ac; show: not nx_avatar_on and cf_solo }
                        text nx_initial { at: cf_ax + cf_av / 2, cf_ay + cf_av / 2; anchor: center; align: center; size: 26; weight: 700; family: "Exo 2"
                                          color: ac; show: not nx_avatar_on and not cf_solo }
                        group {
                            show: cf_solo
                            text nx_identity_name { at: cf_fx0 + cf_fw / 2, cf_ay + cf_av + 26; anchor: center; size: 22; align: center; weight: 700; family: "Exo 2"
                                                    width: cf_fw - 40; lines: 1; color: fl.engrave }
                            text "{upper(nx_user)}@{upper(nx_host)}  ·  {upper(nx_session)}" { at: cf_fx0 + cf_fw / 2, cf_ay + cf_av + 48; anchor: center
                                  size: 8.5; family: "Share Tech Mono"; width: cf_fw - 40; lines: 1; color: mix(fl.muted, ac, 0.45) }
                            text "{upper(nx_distro)}  ·  {nx_kernel}" { at: cf_fx0 + cf_fw / 2, cf_ay + cf_av + 64; anchor: center; align: center; size: 7.5
                                  family: "Share Tech Mono"; width: cf_fw - 40; lines: 1; color: fl.muted }
                            // three readings along the foot
                            box { from: cf_fx0 + 18, cf_fy0 + cf_fh - 58; size: cf_fw - 36, 1; color: fl.trace; opacity: 0.4 }
                            text "UPTIME" { at: cf_fx0 + 18, cf_fy0 + cf_fh - 42; anchor: left center; size: 6.6; weight: 700; family: "Share Tech Mono"; color: fl.muted }
                            text "{upper(nx_uptime)}" { at: cf_fx0 + 18, cf_fy0 + cf_fh - 26; anchor: left center; size: 11; weight: 700; family: "Exo 2"
                                  width: cf_fw / 3 - 20; lines: 1; color: ac }
                            text "WORKSPACE" { at: cf_fx0 + cf_fw / 2, cf_fy0 + cf_fh - 42; anchor: center; align: center; size: 6.6; weight: 700; family: "Share Tech Mono"; color: fl.muted }
                            text "{ws.active, 0}" { at: cf_fx0 + cf_fw / 2, cf_fy0 + cf_fh - 26; anchor: center; align: center; size: 11; weight: 700; family: "Exo 2"; color: fl.trace_lit }
                            text "TIME" { at: cf_fx0 + cf_fw - 18, cf_fy0 + cf_fh - 42; anchor: right center; size: 6.6; weight: 700; family: "Share Tech Mono"; color: fl.muted }
                            text clock.time { at: cf_fx0 + cf_fw - 18, cf_fy0 + cf_fh - 26; anchor: right center; size: 11; weight: 700; family: "Exo 2"; color: fl.flare }
                        }
                        group {
                            show: not cf_solo
                            text nx_identity_name { at: cf_ax + cf_av + 14, cf_fy0 + rail + cf_bh - 30; anchor: left center; size: 16; weight: 700; family: "Exo 2"
                                                    width: cf_fw - cf_av - 60; lines: 1; color: fl.engrave }
                            text "{upper(nx_user)}@{upper(nx_host)}  ·  UP {upper(nx_uptime)}" { at: cf_ax + cf_av + 14, cf_fy0 + rail + cf_bh - 12
                                  anchor: left center; size: 7.4; family: "Share Tech Mono"; width: cf_fw - cf_av - 60; lines: 1; color: mix(fl.muted, ac, 0.45) }
                        }
                        zone box nx_face_edit { from: cf_fx0 + cf_fw - 104, cf_fy0 + rail + 8; size: 92, 20; cursor: pointer; role: button
                                                label: "Edit the name and pictures" }
                        NChip(cf_fx0 + cf_fw - 104, cf_fy0 + rail + 8, 92, "EDIT IDENTITY", nx_face_edit.hover, ac)
                        on press nx_face_edit { emit nx_identity_edit }
                    }

                    // ── PLAYER, and the bottom of ID + PLAYER: the cover, the track, the
                    //    visualiser across the face, the time and the transport ──
                    group {
                        show: nx_centre == player or nx_centre == both
                        let cf_psolo = nx_centre == player
                        let cf_top = cf_fy0 + rail + if(cf_psolo, 16, 74 + 18)
                        let cf_room = cf_fy0 + cf_fh - cf_top
                        let cf_art = clamp(if(cf_psolo, min(cf_fw * 0.46, cf_room - 190), min(110, cf_room - 150)), 64, 220)
                        let cf_artx = if(cf_psolo, cf_fx0 + cf_fw / 2 - cf_art / 2, cf_fx0 + 18)
                        let cf_tx = if(cf_psolo, cf_fx0 + cf_fw / 2, cf_fx0 + 18 + cf_art + 16)
                        let cf_ty = if(cf_psolo, cf_top + cf_art + 26, cf_top + 14)
                        group {
                            glow: 16, 30% * glow_amt * if(nx_playing, 1, 0.3), ac
                            Chamfer(cf_artx - 3, cf_top - 3, cf_art + 6, cf_art + 6, 9, fl.well, mix(fl.trace, ac, if(nx_playing, 0.8, 0.4)), 1, 1.2)
                        }
                        image nx_cover { at: cf_artx, cf_top; size: cf_art, cf_art; show: nx_art_on and nx_has }
                        figure ic_music { at: cf_artx + cf_art / 2, cf_top + cf_art / 2; size: cf_art * 0.3, cf_art * 0.3; color: if(nx_playing, ac, fl.muted)
                                          show: not (nx_art_on and nx_has) }
                        group {
                            show: cf_psolo
                            text pick(nx_has, "NOTHING PLAYING", nx_title) { at: cf_tx, cf_ty; anchor: center; size: 17; align: center; weight: 700; family: "Exo 2"
                                  width: cf_fw - 40; lines: 1; color: fl.engrave }
                            text pick(nx_has, "START A PLAYER AND IT SHOWS HERE", "{upper(nx_artist)}") { at: cf_tx, cf_ty + 20; anchor: center; align: center; size: 8.5
                                  family: "Share Tech Mono"; width: cf_fw - 40; lines: 1; color: mix(fl.muted, ac, 0.5) }
                            text nx_album { at: cf_tx, cf_ty + 34; anchor: center; size: 7.5; align: center; family: "Share Tech Mono"; width: cf_fw - 40; lines: 1
                                            color: fl.muted; show: nx_album_on and nx_has }
                        }
                        group {
                            show: not cf_psolo
                            text pick(nx_has, "NOTHING PLAYING", nx_title) { at: cf_tx, cf_ty; anchor: left center; size: 15; weight: 700; family: "Exo 2"
                                  width: cf_fx0 + cf_fw - cf_tx - 18; lines: 1; color: fl.engrave }
                            text pick(nx_has, "START A PLAYER AND IT SHOWS HERE", "{upper(nx_artist)}") { at: cf_tx, cf_ty + 18; anchor: left center; size: 8
                                  family: "Share Tech Mono"; width: cf_fx0 + cf_fw - cf_tx - 18; lines: 1; color: mix(fl.muted, ac, 0.5) }
                            text nx_album { at: cf_tx, cf_ty + 32; anchor: left center; size: 7.2; family: "Share Tech Mono"; width: cf_fx0 + cf_fw - cf_tx - 18
                                            lines: 1; color: fl.muted; show: nx_album_on and nx_has }
                        }
                        // the visualiser, the width of the face
                        let cf_vy = cf_fy0 + cf_fh - 112
                        NViz(cf_fx0 + 18, cf_vy, cf_fw - 36, 40, ac, if(nx_playing, 1, 0))
                        // the time
                        box { from: cf_fx0 + 18, cf_vy + 52; size: cf_fw - 36, 3; corner: 1.5; color: fl.well }
                        box { from: cf_fx0 + 18, cf_vy + 52; size: (cf_fw - 36) * clamp(nx_progress, 0, 1), 3; corner: 1.5; color: ac; show: nx_has }
                        text nx_elapsed { at: cf_fx0 + 18, cf_vy + 64; anchor: left center; size: 7; family: "Share Tech Mono"; color: fl.muted
                                          show: nx_media_time_on and nx_has }
                        text nx_duration { at: cf_fx0 + cf_fw - 18, cf_vy + 64; anchor: right center; size: 7; family: "Share Tech Mono"; color: fl.muted
                                           show: nx_media_time_on and nx_has }
                        // the transport, centred under the time
                        group {
                            show: nx_has
                            let cf_bx = cf_fx0 + cf_fw / 2
                            zone box nx_fprev { from: cf_bx - 74, cf_vy + 72; size: 40, 28; cursor: pointer; role: button; label: "Previous track" }
                            NButton(cf_bx - 74, cf_vy + 72, 40, 28, "‹‹", 0, ac, nx_fprev.hover)
                            on press nx_fprev { emit nx_media(1) }
                            zone box nx_fplay { from: cf_bx - 26, cf_vy + 70; size: 52, 32; cursor: pointer; role: button
                                                label: pick(med.playing, "Play", "Pause") }
                            group { show: not med.playing
                                NButton(cf_bx - 26, cf_vy + 70, 52, 32, "▶", 0, ac, nx_fplay.hover) }
                            group { show: med.playing
                                NButton(cf_bx - 26, cf_vy + 70, 52, 32, "❚❚", 1, ac, nx_fplay.hover) }
                            on press nx_fplay { emit nx_media(0) }
                            zone box nx_fnext { from: cf_bx + 34, cf_vy + 72; size: 40, 28; cursor: pointer; role: button; label: "Next track" }
                            NButton(cf_bx + 34, cf_vy + 72, 40, 28, "››", 0, ac, nx_fnext.hover)
                            on press nx_fnext { emit nx_media(2) }
                        }
                    }

                    // the reactor's face shows its switch too (drawn here, over the rail)
                }
                // SYSTEM (slot 1): the overview's diagnostics
                group {
                    z: zz.1
                    show: nx_nodes.1.focus and not nx_nodes.1.mini and nd_o.1 > 0.5
                    zone box nx_about_copy { from: cx + gx.1 + 18, cy + gy.1 + gh.1 - 48; size: 168, 26; cursor: pointer; role: button
                                             label: "Copy system diagnostics" }
                    CutButton(cx + gx.1 + 18, cy + gy.1 + gh.1 - 47, 168, "COPY DIAGNOSTICS", fl.phos, nx_about_copy.hover)
                    on press nx_about_copy { emit nx_diagnostics_copy }
                }
                // AUDIO (slot 8): routing, microphone, radio, and the streams below them
                group {
                    z: zz.8
                    show: nx_nodes.8.focus and not nx_nodes.8.mini and nd_o.8 > 0.5
                    let ax0 = cx + gx.8
                    let ay0 = cy + gy.8
                    let aw0 = gw.8
                    zone box nx_out_hit { from: ax0 + 12, ay0 + rail + 92; size: aw0 - 24, 26; cursor: pointer; role: button; label: "Cycle output device" }
                    on press nx_out_hit { emit nx_out_cycle }
                    zone box nx_in_hit { from: ax0 + 12, ay0 + rail + 118; size: aw0 - 24, 26; cursor: pointer; role: button; label: "Cycle input device" }
                    on press nx_in_hit { emit nx_in_cycle }
                    zone box nx_mic_hit { from: ax0 + 12, ay0 + rail + 144; size: aw0 - 24, 26; cursor: pointer; role: slider; label: "Microphone volume"; value: audio.input }
                    on press nx_mic_hit { emit nx_mic }
                    on scroll nx_mic_hit { emit nx_mic_level(clamp(audio.input + wheel * 0.05, 0, 1)) }
                    zone box nx_bt_hit { from: ax0 + 12, ay0 + rail + 170; size: aw0 - 24, 26; cursor: pointer; role: toggle
                                         checked: bluetooth.powered; label: "Toggle the Bluetooth radio" }
                    on press nx_bt_hit { emit nx_bt(if(bluetooth.powered, 0, 1)) }
                    group {
                        show: gh.8 > rail + 250
                        text "APPLICATION STREAMS" { at: ax0 + 18, ay0 + rail + 222; anchor: left center; size: 8; family: "Share Tech Mono"; color: fl.muted }
                        text "NONE PLAYING" { at: ax0 + 18, ay0 + rail + 244; anchor: left center; size: 9; family: "Exo 2"; color: fl.muted; show: nx_mix_count < 1 }
                        for m in nx_mix {
                            text m.name { at: ax0 + 18, ay0 + rail + 244 + (m.id - 1) * 22; anchor: left center; size: 9; family: "Exo 2"
                                          width: max(40, aw0 - 120); lines: 1; color: if(m.muted, fl.ember, fl.phos)
                                          show: ay0 + rail + 244 + (m.id - 1) * 22 < cy + gy.8 + gh.8 - 14 }
                            text pick(m.muted, "{m.level * 100, 0}%", "MUTED") { at: ax0 + aw0 - 18, ay0 + rail + 244 + (m.id - 1) * 22
                                  anchor: right center; size: 8; family: "Share Tech Mono"; color: if(m.muted, fl.ember, fl.trace_lit)
                                  show: ay0 + rail + 244 + (m.id - 1) * 22 < cy + gy.8 + gh.8 - 14 }
                            zone box nx_mix_hit { from: ax0 + 12, ay0 + rail + 234 + (m.id - 1) * 22; size: aw0 - 24, 20; cursor: pointer
                                                  role: button; label: "Mute {m.name}"; show: ay0 + rail + 244 + (m.id - 1) * 22 < cy + gy.8 + gh.8 - 14 }
                            on press nx_mix_hit { emit nx_app_mute(m.sid) }
                            on scroll nx_mix_hit { nx_app_sid = m.sid; nx_app_lvl = clamp(m.level + wheel * 0.05, 0, 1); emit nx_app_vol }
                        }
                    }
                }
                // DISPLAY (slot 9): the backlight answers the wheel over its own row
                group {
                    z: zz.9
                    show: nx_nodes.9.focus and not nx_nodes.9.mini and nd_o.9 > 0.5
                    zone box nx_bri_hit { from: cx + gx.9 + 12, cy + gy.9 + rail + 92; size: gw.9 - 24, 26; cursor: pointer; role: slider
                                          label: "Display brightness"; value: brightness.level; show: brightness.present }
                    on scroll nx_bri_hit { emit nx_bri(clamp(brightness.level + wheel * 0.05, 0.01, 1)) }
                }
                // MEDIA (slot 11): transport, if a player owns the session
                group {
                    z: zz.11
                    show: nx_nodes.11.focus and not nx_nodes.11.mini and nx_has and nd_o.11 > 0.5
                    let mx0 = cx + gx.11
                    let my1 = cy + gy.11 + gh.11
                    zone box nx_prev { from: mx0 + 18, my1 - 46; size: 64, 26; cursor: pointer; role: button; label: "Previous track" }
                    CutButton(mx0 + 18, my1 - 45, 64, "Prev", fl.phos, nx_prev.hover)
                    on press nx_prev { emit nx_media(1) }
                    zone box nx_play { from: mx0 + 90, my1 - 46; size: 64, 26; cursor: pointer; role: button; label: "Play or pause" }
                    group { show: not med.playing
                        CutButton(mx0 + 90, my1 - 45, 64, "Play", fl.phos, nx_play.hover) }
                    group { show: med.playing
                        CutButton(mx0 + 90, my1 - 45, 64, "Pause", fl.flare, nx_play.hover) }
                    on press nx_play { emit nx_media(0) }
                    zone box nx_next { from: mx0 + 162, my1 - 46; size: 64, 26; cursor: pointer; role: button; label: "Next track" }
                    CutButton(mx0 + 162, my1 - 45, 64, "Next", fl.phos, nx_next.hover)
                    on press nx_next { emit nx_media(2) }
                }
                // WORKSPACES (slot 10): the compositor's own grid, one press to go there
                group {
                    z: zz.10
                    show: nx_nodes.10.focus and not nx_nodes.10.mini and nd_o.10 > 0.5
                    let wx0 = cx + gx.10
                    let wy0 = cy + gy.10
                    let ww0 = gw.10
                    box { from: wx0 + 12, wy0 + rail + 92; size: ww0 - 24, gh.10 - rail - 108; color: fl.hull; opacity: 0.97 }
                    text "NO WORKSPACES REPORTED" { at: wx0 + 18, wy0 + rail + 104; anchor: left center; size: 9; family: "Exo 2"
                         color: fl.muted; show: nx_ws_count < 1 }
                    for s in nx_ws {
                        let wsy = wy0 + rail + 92 + (s.slot - 1) * 24
                        zone box nx_ws_hit { from: wx0 + 12, wsy; size: ww0 - 24, 22; cursor: pointer; role: button
                                             label: "Go to workspace {s.label}"; show: wsy + 22 < wy0 + gh.10 - 12 }
                        box { from: wx0 + 12, wsy; size: ww0 - 24, 22; corner: 2; color: fl.phos
                              opacity: nx_ws_hit.hover * 0.1 + if(s.active > 0, 0.06, 0); show: wsy + 22 < wy0 + gh.10 - 12 }
                        text s.label { at: wx0 + 18, wsy + 11; anchor: left center; size: 12; weight: 700
                                       family: "Exo 2"; color: if(s.active > 0, fl.phos, fl.muted); show: wsy + 22 < wy0 + gh.10 - 12 }
                        text "{s.windows, 0} WIN" { at: wx0 + 60, wsy + 11; anchor: left center; size: 7; family: "Share Tech Mono"
                                                    color: fl.muted; show: wsy + 22 < wy0 + gh.10 - 12 }
                        text pick(s.active, "GO THERE", "CURRENT") { at: wx0 + ww0 - 18, wsy + 11
                              anchor: right center; size: 8; family: "Share Tech Mono"; color: if(s.active > 0, fl.phos, fl.trace_lit)
                              show: wsy + 22 < wy0 + gh.10 - 12 }
                        on press nx_ws_hit { emit nx_ws_focus(s.id) }
                    }
                }

                // ── the node menu: one plate, for whichever slot asked ──
                group {
                    z: 9
                    show: nx_menu > 0
                    let mx = clamp(cx + pick(max(0, nx_menu - 1), gx.0, gx.1, gx.2, gx.3, gx.4, gx.5, gx.6, gx.7, gx.8, gx.9, gx.10, gx.11, gx.12, gx.13) + pick(max(0, nx_menu - 1), gw.0, gw.1, gw.2, gw.3, gw.4, gw.5, gw.6, gw.7, gw.8, gw.9, gw.10, gw.11, gw.12, gw.13) - 156, 8, max(8, sw - 164))
                    let my = clamp(cy + pick(max(0, nx_menu - 1), gy.0, gy.1, gy.2, gy.3, gy.4, gy.5, gy.6, gy.7, gy.8, gy.9, gy.10, gy.11, gy.12, gy.13) + rail + 6, cy + 4, max(cy + 4, cy + ch - 152))
                    body {
                        gradient: mx, my to mx, my + 146, fl.hull_raised, fl.hull
                        rim: 6%
                        border: 1, mix(fl.trace, ac, 0.45)
                        opacity: max(nx_fill, 0.96)
                        path { move mx + 8, my; line mx + 156 - 8, my; line mx + 156, my + 8
                               line mx + 156, my + 146 - 8; line mx + 156 - 8, my + 146
                               line mx + 8, my + 146; line mx, my + 146 - 8; line mx, my + 8; close }
                    }
                    path { color: fl.ink; opacity: 0.4
                           move mx + 14, my + 150; line mx + 160, my + 150; line mx + 160, my + 12; line mx + 156, my + 8
                           line mx + 156, my + 138; line mx + 148, my + 146; line mx + 8, my + 146; close }
                    box { from: mx, my; size: 152, 2; color: ac }
                    text "{nx_menu_title}" { at: mx + 12, my + 16; anchor: left center; size: 8; weight: 700
                                             family: "Share Tech Mono"; color: ac; width: 112; lines: 1 }
                    line { from: mx + 10, my + 28; to: mx + 146, my + 28; width: 1; color: ac; opacity: 0.25 }

                    zone box nx_act_focus { from: mx, my + 30; size: 156, 24; cursor: pointer; role: button
                                            label: "Focus at the centre" }
                    box { from: mx + 1, my + 31; size: 154, 22; color: ac; opacity: nx_act_focus.hover * 0.12 }
                    box { from: mx + 6, my + 41; size: 3, 3; corner: 2; color: ac; opacity: 0.6 }
                    text "FOCUS AT CENTRE" { at: mx + 16, my + 42; anchor: left center; size: 8; family: "Share Tech Mono"
                                             color: mix(fl.muted, ac, nx_act_focus.hover) }
                    on press nx_act_focus { emit nx_focus_node(nx_menu); nx_menu = 0 }

                    zone box nx_act_min { from: mx, my + 54; size: 156, 24; cursor: pointer; role: button
                                          label: "Minimize or restore the node" }
                    box { from: mx + 1, my + 55; size: 154, 22; color: ac; opacity: nx_act_min.hover * 0.12 }
                    box { from: mx + 6, my + 65; size: 3, 3; corner: 2; color: ac; opacity: 0.6 }
                    text "{nx_menu_min}" { at: mx + 16, my + 66; anchor: left center; size: 8
                                           family: "Share Tech Mono"; color: mix(fl.muted, ac, nx_act_min.hover) }
                    on press nx_act_min { emit nx_min(nx_menu); nx_menu = 0 }

                    zone box nx_act_config { from: mx, my + 78; size: 156, 24; cursor: pointer; role: button
                                             label: "Open the node's settings" }
                    box { from: mx + 1, my + 79; size: 154, 22; color: ac; opacity: nx_act_config.hover * 0.12 }
                    box { from: mx + 6, my + 89; size: 3, 3; corner: 2; color: ac; opacity: 0.6 }
                    text "NODE SETTINGS" { at: mx + 16, my + 90; anchor: left center; size: 8; family: "Share Tech Mono"
                                           color: mix(fl.muted, ac, nx_act_config.hover) }
                    on press nx_act_config while nx_sel != nx_menu { emit nx_select(nx_menu); nx_panel = node; nx_menu = 0 }
                    on press nx_act_config while nx_sel == nx_menu { nx_panel = node; nx_menu = 0 }

                    line { from: mx + 10, my + 106; to: mx + 146, my + 106; width: 1; color: fl.trace; opacity: 0.18 }
                    zone box nx_act_remove { from: mx, my + 110; size: 156, 26; cursor: pointer; role: button
                                             label: "Remove the node from the layout" }
                    box { from: mx + 1, my + 111; size: 154, 24; color: fl.ember; opacity: nx_act_remove.hover * 0.14 }
                    box { from: mx + 6, my + 123; size: 3, 3; corner: 2; color: fl.ember; opacity: 0.7 }
                    text "REMOVE FROM LAYOUT" { at: mx + 16, my + 124; anchor: left center; size: 8; family: "Share Tech Mono"
                                                color: mix(fl.muted, fl.ember, nx_act_remove.hover) }
                    on press nx_act_remove { emit nx_remove(nx_menu); nx_menu = 0 }

                    zone box nx_act_close { from: mx + 128, my + 4; size: 24, 20; cursor: pointer; role: button
                                            label: "Close the node menu" }
                    line { from: mx + 136, my + 9; to: mx + 143, my + 16; width: 1.2
                           color: mix(fl.muted, ac, nx_act_close.hover) }
                    line { from: mx + 143, my + 9; to: mx + 136, my + 16; width: 1.2
                           color: mix(fl.muted, ac, nx_act_close.hover) }
                    on press nx_act_close { nx_menu = 0 }
                }
            }

            // ── a picked trace: what it means, and what to do with it ──
            // The card also lists the traces that were put away, so a single hidden line can
            // come back without restoring the whole network. It opens where the trace's chip is.
            group {
                show: nx_edge_sel > 0
                let ph = 146 + min(nx_hidden_count, 3) * 22 + if(nx_hidden_count > 0, 20, 0)
                let ex = clamp(nx_ex + 30, cx + 8, max(cx + 8, cx + cw - 268))
                let ey = clamp(nx_ey - 60, cy + 8, max(cy + 8, cy + ch - ph - 8))
                body {
                    gradient: ex, ey to ex, ey + ph, fl.hull_raised, fl.hull
                    rim: 6%
                    border: 1, mix(fl.trace, ac, 0.5)
                    opacity: max(nx_fill, 0.96)
                    path { move ex + 8, ey; line ex + 260 - 8, ey; line ex + 260, ey + 8
                           line ex + 260, ey + ph - 8; line ex + 260 - 8, ey + ph
                           line ex + 8, ey + ph; line ex, ey + ph - 8; line ex, ey + 8; close }
                }
                box { from: ex, ey; size: 256, 2; color: ac }
                text "CONNECTION" { at: ex + 12, ey + 15; anchor: left center; size: 6.5; family: "Share Tech Mono"
                                    color: fl.muted }
                text "{nx_edge_label}" { at: ex + 12, ey + 34; anchor: left center; size: 13; weight: 700; family: "Exo 2"
                                         color: ac; width: 236; lines: 1 }
                text "{nx_edge_meaning}" { at: ex + 12, ey + 52; anchor: left center; size: 8; family: "Share Tech Mono"
                                           width: 236; lines: 1; color: fl.trace_lit }
                line { from: ex + 10, ey + 64; to: ex + 250, ey + 64; width: 1; color: fl.trace; opacity: 0.2 }

                zone box nx_edge_hidebtn { from: ex + 10, ey + 72; size: 116, 24; cursor: pointer; role: button
                                           label: "Hide this trace" }
                CutButton(ex + 10, ey + 73, 116, "HIDE TRACE", fl.ember, nx_edge_hidebtn.hover)
                on press nx_edge_hidebtn { emit nx_edge_hide }
                zone box nx_edge_closebtn { from: ex + 134, ey + 72; size: 116, 24; cursor: pointer; role: button
                                            label: "Close the trace menu" }
                CutButton(ex + 134, ey + 73, 116, "CLOSE", ac, nx_edge_closebtn.hover)
                on press nx_edge_closebtn { emit nx_edge_pick(0) }

                // what was put away, one line each
                group {
                    show: nx_hidden_count > 0
                    line { from: ex + 10, ey + 106; to: ex + 250, ey + 106; width: 1; color: fl.trace; opacity: 0.16 }
                    text "PUT AWAY  ·  {nx_hidden_count, 0}" { at: ex + 12, ey + 120; anchor: left center; size: 6.5
                         family: "Share Tech Mono"; color: fl.muted }
                    for h in nx_hidden {
                        let hy = ey + 132 + (h.id - 1) * 22
                        zone box nx_edge_back { from: ex + 10, hy; size: 240, 20; cursor: pointer; role: button
                                                label: "Bring the {h.label} trace back"; show: h.id < 4 }
                        box { from: ex + 10, hy; size: 240, 20; color: ac; opacity: nx_edge_back.hover * 0.14; show: h.id < 4 }
                        box { at: ex + 17, hy + 10; size: 3, 3; corner: 2; color: ac; opacity: 0.6; show: h.id < 4 }
                        text h.label { at: ex + 28, hy + 10; anchor: left center; size: 7.5; family: "Share Tech Mono"
                                       color: mix(fl.muted, fl.trace_lit, 0.5 + nx_edge_back.hover * 0.5); show: h.id < 4 }
                        text "RESTORE" { at: ex + 242, hy + 10; anchor: right center; size: 7; family: "Share Tech Mono"
                                         color: mix(fl.trace, ac, 0.4 + nx_edge_back.hover * 0.6); show: h.id < 4 }
                        on press nx_edge_back { emit nx_edge_show(h.id) }
                    }
                    zone box nx_edge_restorebtn { from: ex + 10, ey + 132 + min(nx_hidden_count, 3) * 22
                                                 size: 240, 18; cursor: pointer; role: button
                                                 label: "Bring every hidden trace back" }
                    text "RESTORE FULL NETWORK" { at: ex + 12, ey + 141 + min(nx_hidden_count, 3) * 22; anchor: left center
                                                   size: 6.5; family: "Share Tech Mono"
                                                   color: mix(fl.muted, ac, 0.3 + nx_edge_restorebtn.hover * 0.7) }
                    on press nx_edge_restorebtn { emit nx_edges_restore }
                }
            }

            // ── the status strip: what is showing, and what the machine is doing ──
            group {
                show: not tiny
                let mid = sh - foot / 2
                body {
                    gradient: 0, sh - foot to 0, sh, fl.hull_raised, fl.hull
                    rim: 4%
                    opacity: nx_fill
                    box { from: 0, sh - foot; size: sw, foot }
                }
                box { from: 0, sh - foot; size: sw, 1; color: fl.trace; opacity: 0.65 }
                box { from: 0, sh - foot; size: 3, foot; color: ac; opacity: 0.85 }

                // where the centre is
                box { at: 22, mid; size: 5, 5; corner: 3; color: ac }
                text "CENTRE" { at: 34, mid; anchor: left center; size: 6.5; family: "Share Tech Mono"; color: fl.muted }
                text "{nx_focus_name}" { at: 78, mid; anchor: left center; size: 8; weight: 700; family: "Share Tech Mono"; color: ac }
                box { from: 190, sh - foot + 9; size: 1, foot - 18; color: fl.trace; opacity: 0.3 }

                // what there is
                text "NODES" { at: 202, mid; anchor: left center; size: 6.5; family: "Share Tech Mono"; color: fl.muted }
                text "{nx_node_count, 0}" { at: 236, mid; anchor: left center; size: 8.5; weight: 700; family: "Share Tech Mono"; color: fl.trace_lit }
                text "TRACES" { at: 262, mid; anchor: left center; size: 6.5; family: "Share Tech Mono"; color: fl.muted }
                text "{nx_edge_count, 0}" { at: 302, mid; anchor: left center; size: 8.5; weight: 700; family: "Share Tech Mono"; color: fl.trace_lit }
                group {
                    show: nx_edges_hidden > 0
                    text "AWAY" { at: 328, mid; anchor: left center; size: 6.5; family: "Share Tech Mono"; color: fl.ember }
                    text "{nx_edges_hidden, 0}" { at: 358, mid; anchor: left center; size: 8.5; weight: 700; family: "Share Tech Mono"; color: fl.ember }
                }

                // what the machine is doing, in the middle where it can be read at a glance
                box { from: sw / 2 - 128, sh - foot + 8; size: 1, foot - 16; color: fl.trace; opacity: 0.22 }
                text "{nx_status}" { at: sw / 2, mid; anchor: center; size: 7.5; family: "Share Tech Mono"; color: fl.trace_lit }

                // the keys, or the last thing that was refused
                text "TAB SELECTS · ARROWS MOVE · ENTER FOCUS · ESC CLOSES" { at: sw - 20, mid; anchor: right center
                     size: 7; family: "Share Tech Mono"; color: fl.muted; show: not nx_notice and sw > 1180 }
                text "{nx_mode_name} · {nx_accent_name} · EDGE {nx_edge_style, 0}/3" { at: sw - 20, mid; anchor: right center
                     size: 7; family: "Share Tech Mono"; color: fl.muted; show: not nx_notice and sw <= 1180 }
                text "{nx_notice_text}" { at: sw - 20, mid; anchor: right center; size: 7; weight: 700; family: "Share Tech Mono"
                     color: fl.ember; show: nx_notice }
            }

            // ── the panel: one docked surface, four faces (S5) ──
            // The module library, the selected node's settings, the appearance, and the
            // arrangements live on the same plate, so the shell has one place to look.
            let panel_w = if(tiny, sw - 20, min(376, sw - 48))
            let panel_h = min(ch - 24, if(tiny, ch - 20, 512))
            // the dock: right edge under the banner, unless the panel was carried somewhere
            let dock_x = if(nx_panel_x > 0, min(nx_panel_x, max(0, sw - panel_w)), sw - panel_w - if(tiny, 10, 20))
            let dock_y = if(nx_panel_y > 0, min(nx_panel_y, max(0, sh - panel_h)), cy + 12)
            let panel_x = clamp(dock_x + nx_panel_dx, 0, max(0, sw - panel_w))
            let panel_y = clamp(dock_y + nx_panel_dy, 0, max(0, sh - panel_h))
            let px0 = panel_x + 16
            let pwi = panel_w - 32
            let py0 = panel_y + 92

            group {
                show: nx_panel != none
                body {
                    gradient: panel_x, panel_y to panel_x, panel_y + panel_h, fl.hull_raised, fl.hull
                    rim: 5%
                    border: 1, mix(fl.trace, ac, 0.4)
                    shadow: 0, 14, 34, 0.5, fl.ink
                    opacity: nx_fill
                    path { move panel_x + 10, panel_y; line panel_x + panel_w - 10, panel_y
                           line panel_x + panel_w, panel_y + 10; line panel_x + panel_w, panel_y + panel_h - 10
                           line panel_x + panel_w - 10, panel_y + panel_h; line panel_x + 10, panel_y + panel_h
                           line panel_x, panel_y + panel_h - 10; line panel_x, panel_y + 10; close }
                }
                box { from: panel_x, panel_y; size: panel_w, 2; color: ac }
                NCorner(panel_x + 6, panel_y + 6, panel_w - 12, panel_h - 12, 10, ac, 0.3)

                // the panel's own head: what it is, the grip that carries it, and the way out
                zone box nx_panel_head { from: panel_x + 10, panel_y + 8; size: panel_w - 56, 42
                                          cursor: pointer; role: button
                                          label: "Drag the panel by its head; a press puts it back on the right" }
                repeat gd in 0..1 {
                    repeat ge in 0..2 {
                        box { at: panel_x + panel_w - 47 + gd * 5, panel_y + 15 + ge * 5
                              size: 2, 2; corner: 1; color: mix(fl.muted, ac, 0.35 + nx_panel_head.hover * 0.65) }
                    }
                }
                on press nx_panel_head { nx_panel_carry = 1; nx_panel_dx = 0; nx_panel_dy = 0 }
                on drag nx_panel_head while nx_panel_carry == 1 {
                    nx_panel_gx = clamp(dock_x + drag.dx, 0, max(0, sw - panel_w))
                    nx_panel_gy = clamp(dock_y + drag.dy, 0, max(0, sh - panel_h))
                    nx_panel_dx = nx_panel_gx - dock_x
                    nx_panel_dy = nx_panel_gy - dock_y
                }
                on release nx_panel_head while nx_panel_carry == 1 and abs(nx_panel_dx) + abs(nx_panel_dy) > 4 {
                    emit nx_panel_move; nx_panel_carry = 0; nx_panel_dx = 0; nx_panel_dy = 0
                }
                on release nx_panel_head while nx_panel_carry == 1 and abs(nx_panel_dx) + abs(nx_panel_dy) <= 4 {
                    emit nx_panel_dock; nx_panel_carry = 0; nx_panel_dx = 0; nx_panel_dy = 0
                }

                text "MODULE LIBRARY" { at: px0, panel_y + 26; anchor: left center; size: 11; weight: 700; family: "Exo 2"
                                        color: ac; show: nx_panel == library }
                text "NODE SETTINGS" { at: px0, panel_y + 26; anchor: left center; size: 11; weight: 700; family: "Exo 2"
                                       color: ac; show: nx_panel == node }
                text "APPEARANCE" { at: px0, panel_y + 26; anchor: left center; size: 11; weight: 700; family: "Exo 2"
                                    color: ac; show: nx_panel == look }
                text "ARRANGEMENTS" { at: px0, panel_y + 26; anchor: left center; size: 11; weight: 700; family: "Exo 2"
                                      color: ac; show: nx_panel == layout }
                text "CONTROL NEXUS  ·  {nx_arrangement_name}  ·  {nx_mode_name}" { at: px0, panel_y + 41; anchor: left center
                     size: 6.5; family: "Share Tech Mono"; color: fl.muted }

                zone box nx_panel_close { from: panel_x + panel_w - 34, panel_y + 12; size: 22, 22; cursor: pointer
                                          role: button; label: "Close the panel" }
                line { from: panel_x + panel_w - 27, panel_y + 18; to: panel_x + panel_w - 19, panel_y + 26; width: 1.4
                       color: mix(fl.muted, fl.ember, nx_panel_close.hover) }
                line { from: panel_x + panel_w - 19, panel_y + 18; to: panel_x + panel_w - 27, panel_y + 26; width: 1.4
                       color: mix(fl.muted, fl.ember, nx_panel_close.hover) }
                on press nx_panel_close { nx_panel = none }

                // the tabs, so the four faces are one press apart
                zone box nx_tab_lib { from: px0, panel_y + 54; size: 78, 22; cursor: pointer; role: tab
                                      selected: nx_panel == library; label: "The module library" }
                NButton(px0, panel_y + 54, 78, 22, "LIBRARY", nx_panel == library, ac, nx_tab_lib.hover)
                on press nx_tab_lib { nx_panel = library }
                zone box nx_tab_node { from: px0 + 82, panel_y + 54; size: 70, 22; cursor: pointer; role: tab
                                       selected: nx_panel == node; label: "The selected node's settings" }
                NButton(px0 + 82, panel_y + 54, 70, 22, "NODE", nx_panel == node, ac, nx_tab_node.hover)
                on press nx_tab_node { nx_panel = node }
                zone box nx_tab_look { from: px0 + 156, panel_y + 54; size: 70, 22; cursor: pointer; role: tab
                                       selected: nx_panel == look; label: "The appearance" }
                NButton(px0 + 156, panel_y + 54, 70, 22, "LOOK", nx_panel == look, ac, nx_tab_look.hover)
                on press nx_tab_look { nx_panel = look }
                zone box nx_tab_layout { from: px0 + 230, panel_y + 54; size: 82, 22; cursor: pointer; role: tab
                                         selected: nx_panel == layout; label: "The arrangements" }
                NButton(px0 + 230, panel_y + 54, 82, 22, "ARRANGE", nx_panel == layout, fl.flare, nx_tab_layout.hover)
                on press nx_tab_layout { nx_panel = layout }
                line { from: px0, panel_y + 84; to: panel_x + panel_w - 16, panel_y + 84; width: 1; color: ac; opacity: 0.22 }

                // ── LIBRARY: every module, what it is doing, and one press ──
                group {
                    show: nx_panel == library
                    // the filter reads as a field: a well, a caret and a rule under the text
                    NCaption(px0, py0 + 2, pwi, "filter", fl.muted)
                    box { from: px0, py0 + 8; size: pwi, 26; corner: 3; color: fl.ground; opacity: 0.45 }
                    box { from: px0, py0 + 8; size: pwi, 26; corner: 3; stroke: 1; color: fl.trace; opacity: 0.35 }
                    text "›" { at: px0 + 9, py0 + 21; anchor: center; size: 12; family: "Share Tech Mono"; color: ac }
                    line { from: px0, py0 + 33; to: px0 + pwi, py0 + 33; width: 1; color: ac; opacity: 0.4 }
                    input nx_lib_query { at: px0 + 18, py0 + 14; width: pwi - 26; size: 12; color: fl.trace_lit
                                         family: "Share Tech Mono"; placeholder: "Module name or category"; selection: ac }
                    for r in nx_lib {
                        // a page at a time; how many fit is the panel's business, so the
                        // logic publishes the count and the footer walks to the rest
                        let off = (nx_lib_page - 1) * nx_lib_page_size
                        let ry = py0 + 44 + (r.slot - 1 - off) * 28
                        group {
                            show: r.slot > off and r.slot <= off + nx_lib_page_size
                            box { from: px0, ry; size: pwi, 26; corner: 3; color: fl.ground
                                  opacity: if(r.state == 0, 0.28, 0.14) }
                            box { from: px0, ry; size: 2, 26; color: if(r.state == 2, fl.muted, if(r.state == 1, fl.ember, if(r.state == 3, mix(fl.trace, ac, 0.5), fl.trace_lit))) }
                            text r.title { at: px0 + 12, ry + 9; anchor: left center; size: 9.5; weight: 700; family: "Exo 2"
                                           width: pwi - 24; lines: 1
                                           color: if(r.state == 2, fl.muted, if(r.state == 1, mix(fl.muted, fl.ember, 0.7), fl.trace_lit)) }
                            text "{r.category}  ·  {r.note}" { at: px0 + 12, ry + 20; anchor: left center; size: 6; family: "Share Tech Mono"
                                  width: pwi - 24; lines: 1; color: if(r.state == 2, fl.muted, fl.trace) }
                            text pick(r.state, "ON", "BACK", "N/A", "ADD") { at: px0 + pwi - 8, ry + 13; anchor: right center; size: 6.5
                                  weight: 700; family: "Share Tech Mono"
                                  color: if(r.state == 2, fl.muted, if(r.state == 1, fl.ember, fl.trace_lit)) }
                            zone box nx_lib_row { from: px0, ry; size: pwi, 26; cursor: pointer; role: button
                                                  label: "{r.title}, {r.note}"
                                                  show: r.state != 2 }
                            box { from: px0, ry; size: pwi, 26; corner: 3; stroke: 1; color: ac
                                  opacity: nx_lib_row.hover * 0.5; show: r.state != 2 }
                            on press nx_lib_row while r.state == 1 { emit nx_restore(r.id) }
                            on press nx_lib_row while r.state == 0 { emit nx_focus_node(r.id) }
                            on press nx_lib_row while r.state == 3 { emit nx_lib_add(r.code) }
                        }
                    }
                    // the footer: how many rows the filter found, and a page at a time
                    text "{nx_lib_count, 0} OF {nx_lib_total, 0} MODULES" { at: px0, panel_y + panel_h - 18
                         anchor: left center; size: 6.5; family: "Share Tech Mono"; color: fl.muted }
                    let fw = 30
                    let fh = 20
                    let fy = panel_y + panel_h - 29
                    let fx = panel_x + panel_w - 16 - fw * 2 - 6
                    group {
                        show: nx_lib_pages > 1
                        // back: lit while there is a page behind this one
                        zone box nx_lib_prev { from: fx, fy; size: fw, fh; cursor: pointer; role: button
                                               label: "The previous page of modules" }
                        box { from: fx, fy; size: fw, fh; corner: 3
                              color: if(nx_lib_page > 1, ac, fl.ground); opacity: if(nx_lib_page > 1, 0.18, 0.12) }
                        box { from: fx, fy; size: fw, fh; corner: 3; stroke: 1
                              color: if(nx_lib_page > 1, ac, fl.trace); opacity: if(nx_lib_page > 1, 0.8, 0.3) }
                        text "‹" { at: fx + fw / 2, fy + fh / 2 - 0.5; anchor: center; size: 13; family: "Share Tech Mono"
                                   color: if(nx_lib_page > 1, ac, fl.muted) }
                        on press nx_lib_prev { emit nx_lib_page(-1) }
                        // on: lit while a page follows this one
                        zone box nx_lib_next { from: fx + fw + 6, fy; size: fw, fh; cursor: pointer; role: button
                                               label: "The next page of modules" }
                        box { from: fx + fw + 6, fy; size: fw, fh; corner: 3
                              color: if(nx_lib_page < nx_lib_pages, ac, fl.ground); opacity: if(nx_lib_page < nx_lib_pages, 0.18, 0.12) }
                        box { from: fx + fw + 6, fy; size: fw, fh; corner: 3; stroke: 1
                              color: if(nx_lib_page < nx_lib_pages, ac, fl.trace); opacity: if(nx_lib_page < nx_lib_pages, 0.8, 0.3) }
                        text "›" { at: fx + fw + 6 + fw / 2, fy + fh / 2 - 0.5; anchor: center; size: 13; family: "Share Tech Mono"
                                   color: if(nx_lib_page < nx_lib_pages, ac, fl.muted) }
                        on press nx_lib_next { emit nx_lib_page(1) }
                    }
                }

                // ── NODE: the selection's size, its slot and its fate ──
                group {
                    show: nx_panel == node
                    text "{nx_sel_title}" { at: px0, py0 + 22; anchor: left center; size: 19; weight: 700; family: "Exo 2"
                                            width: pwi; lines: 1; color: mix(fl.hull, ac, 0.9) }
                    text "{nx_sel_note}  ·  NODE {nx_sel, 0}" { at: px0, py0 + 42; anchor: left center; size: 7.5
                          family: "Share Tech Mono"; color: fl.muted }
                    group {
                        show: nx_sel_on < 1
                        text "NOTHING IS SELECTED" { at: px0, py0 + 76; anchor: left center; size: 9; family: "Share Tech Mono"
                                                     color: fl.ember }
                        text "Press a node on the field, or Tab to walk them." { at: px0, py0 + 94; anchor: left center
                             size: 7.5; family: "Share Tech Mono"; color: fl.muted }
                    }
                    group {
                        show: nx_sel_on > 0
                        NCaption(px0, py0 + 64, pwi, "size preset", fl.muted)
                        zone box nx_pre_s { from: px0, py0 + 74; size: 78, 28; cursor: pointer; role: button
                                            label: "Small size" }
                        NButton(px0, py0 + 74, 78, 28, "S", 0, ac, nx_pre_s.hover)
                        on press nx_pre_s { emit nx_node_preset(1) }
                        zone box nx_pre_m { from: px0 + 84, py0 + 74; size: 78, 28; cursor: pointer; role: button
                                            label: "Medium size" }
                        NButton(px0 + 84, py0 + 74, 78, 28, "M", 0, ac, nx_pre_m.hover)
                        on press nx_pre_m { emit nx_node_preset(2) }
                        zone box nx_pre_l { from: px0 + 168, py0 + 74; size: 78, 28; cursor: pointer; role: button
                                            label: "Large size" }
                        NButton(px0 + 168, py0 + 74, 78, 28, "L", 0, ac, nx_pre_l.hover)
                        on press nx_pre_l { emit nx_node_preset(3) }
                        zone box nx_pre_d { from: px0 + 252, py0 + 74; size: 78, 28; cursor: pointer; role: button
                                            label: "The size it takes at the centre" }
                        NButton(px0 + 252, py0 + 74, 78, 28, "DETAIL", 0, fl.flare, nx_pre_d.hover)
                        on press nx_pre_d { emit nx_node_preset(4) }

                        NCaption(px0, py0 + 120, pwi, "actions", fl.muted)
                        zone box nx_act2_focus { from: px0, py0 + 130; size: pwi, 30; cursor: pointer; role: button
                                                 label: "Focus the selected node at the centre" }
                        NButton(px0, py0 + 130, pwi, 30, "FOCUS AT CENTRE", 0, ac, nx_act2_focus.hover)
                        on press nx_act2_focus { emit nx_focus_node(nx_sel) }
                        zone box nx_act2_min { from: px0, py0 + 166; size: pwi, 30; cursor: pointer; role: button
                                               label: "Minimize or restore the selected node" }
                        NButton(px0, py0 + 166, pwi, 30, "MINIMIZE / RESTORE", 0, ac, nx_act2_min.hover)
                        on press nx_act2_min { emit nx_min(nx_sel) }
                        zone box nx_act2_reset { from: px0, py0 + 202; size: 164, 30; cursor: pointer; role: button
                                                 label: "Reset the node's size and slot" }
                        NButton(px0, py0 + 202, 164, 30, "RESET NODE", 0, fl.flare, nx_act2_reset.hover)
                        on press nx_act2_reset { emit nx_node_reset }
                        zone box nx_act2_remove { from: px0 + 172, py0 + 202; size: pwi - 172, 30; cursor: pointer; role: button
                                                  label: "Remove the node from the layout" }
                        NButton(px0 + 172, py0 + 202, pwi - 172, 30, "REMOVE", 0, fl.ember, nx_act2_remove.hover)
                        on press nx_act2_remove { emit nx_remove(nx_sel) }

                        NCaption(px0, py0 + 252, pwi, "the keys", fl.muted)
                        text "TAB WALKS THE FIELD · ARROWS MOVE ONE STEP · ENTER CENTRES · DELETE REMOVES" {
                            at: px0, py0 + 268; anchor: left top; size: 7; family: "Share Tech Mono"; width: pwi; lines: 2
                            color: fl.muted }
                        text "CTRL+Z STEPS BACK · CTRL+SHIFT+Z FORWARD" { at: px0, py0 + 290; anchor: left top; size: 7
                             family: "Share Tech Mono"; width: pwi; lines: 1; color: fl.muted }
                    }
                }

                // ── LOOK: the appearance, as roles and numbers, never a hex ──
                group {
                    show: nx_panel == look
                    NCaption(px0, py0 + 2, pwi, "accent role", fl.muted)
                    zone box nx_look_phos { from: px0, py0 + 12; size: 78, 26; cursor: pointer; role: toggle
                                            checked: nx_accent == 1; label: "Phosphor accent" }
                    NButton(px0, py0 + 12, 78, 26, "PHOS", nx_accent == 1, fl.phos, nx_look_phos.hover)
                    on press nx_look_phos { nx_look_key = 1; nx_look_val = 0; emit nx_look }
                    zone box nx_look_flare { from: px0 + 84, py0 + 12; size: 78, 26; cursor: pointer; role: toggle
                                             checked: nx_accent == 2; label: "Amber accent" }
                    NButton(px0 + 84, py0 + 12, 78, 26, "FLARE", nx_accent == 2, fl.flare, nx_look_flare.hover)
                    on press nx_look_flare { nx_look_key = 1; nx_look_val = 1; emit nx_look }
                    zone box nx_look_ember { from: px0 + 168, py0 + 12; size: 78, 26; cursor: pointer; role: toggle
                                             checked: nx_accent == 3; label: "Ember accent" }
                    NButton(px0 + 168, py0 + 12, 78, 26, "EMBER", nx_accent == 3, fl.ember, nx_look_ember.hover)
                    on press nx_look_ember { nx_look_key = 1; nx_look_val = 2; emit nx_look }
                    zone box nx_look_trace { from: px0 + 252, py0 + 12; size: 78, 26; cursor: pointer; role: toggle
                                             checked: nx_accent == 4; label: "Trace accent" }
                    NButton(px0 + 252, py0 + 12, 78, 26, "TRACE", nx_accent == 4, fl.trace_lit, nx_look_trace.hover)
                    on press nx_look_trace { nx_look_key = 1; nx_look_val = 3; emit nx_look }

                    NCaption(px0, py0 + 50, pwi, "light", fl.muted)
                    text "GLOW" { at: px0, py0 + 72; anchor: left center; size: 7.5; family: "Share Tech Mono"; color: fl.muted }
                    text "{nx_glow, 0}%" { at: px0 + pwi - 62, py0 + 72; anchor: center; size: 8.5; weight: 700
                                           family: "Share Tech Mono"; color: fl.trace_lit }
                    zone box nx_glow_dn { from: px0 + pwi - 118, py0 + 62; size: 30, 20; cursor: pointer; role: button
                                          label: "Less glow" }
                    NButton(px0 + pwi - 118, py0 + 62, 30, 20, "-", 0, ac, nx_glow_dn.hover)
                    on press nx_glow_dn { nx_look_key = 4; nx_look_val = -10; emit nx_look }
                    zone box nx_glow_up { from: px0 + pwi - 24, py0 + 62; size: 30, 20; cursor: pointer; role: button
                                          label: "More glow" }
                    NButton(px0 + pwi - 24, py0 + 62, 30, 20, "+", 0, ac, nx_glow_up.hover)
                    on press nx_glow_up { nx_look_key = 4; nx_look_val = 10; emit nx_look }

                    text "BRIGHTNESS" { at: px0, py0 + 100; anchor: left center; size: 7.5; family: "Share Tech Mono"; color: fl.muted }
                    text "{nx_bright, 0}%" { at: px0 + pwi - 62, py0 + 100; anchor: center; size: 8.5; weight: 700
                                             family: "Share Tech Mono"; color: fl.trace_lit }
                    zone box nx_bri_dn { from: px0 + pwi - 118, py0 + 90; size: 30, 20; cursor: pointer; role: button
                                         label: "Dimmer" }
                    NButton(px0 + pwi - 118, py0 + 90, 30, 20, "-", 0, ac, nx_bri_dn.hover)
                    on press nx_bri_dn { nx_look_key = 2; nx_look_val = -10; emit nx_look }
                    zone box nx_bri_up { from: px0 + pwi - 24, py0 + 90; size: 30, 20; cursor: pointer; role: button
                                         label: "Brighter" }
                    NButton(px0 + pwi - 24, py0 + 90, 30, 20, "+", 0, ac, nx_bri_up.hover)
                    on press nx_bri_up { nx_look_key = 2; nx_look_val = 10; emit nx_look }

                    text "SURFACE OPACITY" { at: px0, py0 + 128; anchor: left center; size: 7.5; family: "Share Tech Mono"; color: fl.muted }
                    text "{nx_opacity, 0}%" { at: px0 + pwi - 62, py0 + 128; anchor: center; size: 8.5; weight: 700
                                              family: "Share Tech Mono"; color: fl.trace_lit }
                    zone box nx_op_dn { from: px0 + pwi - 118, py0 + 118; size: 30, 20; cursor: pointer; role: button
                                        label: "More transparent" }
                    NButton(px0 + pwi - 118, py0 + 118, 30, 20, "-", 0, ac, nx_op_dn.hover)
                    on press nx_op_dn { nx_look_key = 10; nx_look_val = -10; emit nx_look }
                    zone box nx_op_up { from: px0 + pwi - 24, py0 + 118; size: 30, 20; cursor: pointer; role: button
                                        label: "More solid" }
                    NButton(px0 + pwi - 24, py0 + 118, 30, 20, "+", 0, ac, nx_op_up.hover)
                    on press nx_op_up { nx_look_key = 10; nx_look_val = 10; emit nx_look }

                    NCaption(px0, py0 + 154, pwi, "field", fl.muted)
                    zone box nx_grid_toggle { from: px0, py0 + 164; size: 104, 26; cursor: pointer; role: toggle
                                              checked: nx_grid; label: "Show the measured grid" }
                    NButton(px0, py0 + 164, 104, 26, "GRID", nx_grid, ac, nx_grid_toggle.hover)
                    on press nx_grid_toggle { nx_look_key = 5; nx_look_val = 1; emit nx_look }
                    zone box nx_motion_toggle { from: px0 + 110, py0 + 164; size: 104, 26; cursor: pointer; role: toggle
                                                checked: nx_motion; label: "Animate layout changes" }
                    NButton(px0 + 110, py0 + 164, 104, 26, "MOTION", nx_motion, ac, nx_motion_toggle.hover)
                    zone box nx_clear_toggle { from: px0, py0 + 196; size: 104, 26; cursor: pointer; role: toggle
                                               checked: nx_clear; label: "Draw the cards over the wallpaper, with no plate behind them" }
                    NButton(px0, py0 + 196, 104, 26, "CLEAR", nx_clear, ac, nx_clear_toggle.hover)
                    on press nx_clear_toggle { nx_look_key = 11; nx_look_val = 1; emit nx_look }
                    on press nx_motion_toggle { nx_look_key = 9; nx_look_val = 1; emit nx_look }
                    zone box nx_labels_toggle { from: px0 + 220, py0 + 164; size: pwi - 220, 26; cursor: pointer; role: toggle
                                                checked: nx_edge_labels; label: "Show trace labels" }
                    NButton(px0 + 220, py0 + 164, pwi - 220, 26, "LABELS", nx_edge_labels, ac, nx_labels_toggle.hover)
                    on press nx_labels_toggle { nx_look_key = 8; nx_look_val = 1; emit nx_look }

                    NCaption(px0, py0 + 204, pwi, "traces", fl.muted)
                    zone box nx_style_toggle { from: px0, py0 + 214; size: pwi - 118, 26; cursor: pointer; role: button
                                               label: "Change how traces are routed" }
                    NButton(px0, py0 + 214, pwi - 118, 26, "ROUTE", 0, ac, nx_style_toggle.hover)
                    text "CIRCUIT" { at: px0 + pwi - 126, py0 + 227; anchor: right center; size: 7; weight: 700
                                     family: "Share Tech Mono"; color: ac; show: nx_edge_style == 1 }
                    text "CURVED" { at: px0 + pwi - 126, py0 + 227; anchor: right center; size: 7; weight: 700
                                    family: "Share Tech Mono"; color: ac; show: nx_edge_style == 2 }
                    text "DIRECT" { at: px0 + pwi - 126, py0 + 227; anchor: right center; size: 7; weight: 700
                                    family: "Share Tech Mono"; color: ac; show: nx_edge_style == 3 }
                    on press nx_style_toggle { nx_look_key = 7; nx_look_val = 1; emit nx_look }
                    zone box nx_width_toggle { from: px0 + pwi - 110, py0 + 214; size: 110, 26; cursor: pointer; role: button
                                               label: "Change the thickness of traces" }
                    group { show: nx_edge_width == 1
                        NButton(px0 + pwi - 110, py0 + 214, 110, 26, "1 PX", 1, ac, nx_width_toggle.hover) }
                    group { show: nx_edge_width == 2
                        NButton(px0 + pwi - 110, py0 + 214, 110, 26, "2 PX", 1, ac, nx_width_toggle.hover) }
                    on press nx_width_toggle { nx_look_key = 6; nx_look_val = 1; emit nx_look }
                    zone box nx_speed_toggle { from: px0, py0 + 250; size: pwi - 118, 26; cursor: pointer; role: button
                                               label: "Change signal marker speed" }
                    NButton(px0, py0 + 250, pwi - 118, 26, "SPEED", 0, ac, nx_speed_toggle.hover)
                    text "0.5X" { at: px0 + pwi - 126, py0 + 263; anchor: right center; size: 7; weight: 700
                                    family: "Share Tech Mono"; color: ac; show: nx_edge_speed == 0.5 }
                    text "1X" { at: px0 + pwi - 126, py0 + 263; anchor: right center; size: 7; weight: 700
                                    family: "Share Tech Mono"; color: ac; show: nx_edge_speed == 1 }
                    text "2X" { at: px0 + pwi - 126, py0 + 263; anchor: right center; size: 7; weight: 700
                                    family: "Share Tech Mono"; color: ac; show: nx_edge_speed == 2 }
                    on press nx_speed_toggle { nx_look_key = 12; nx_look_val = 1; emit nx_look }
                    zone box nx_trunk_toggle { from: px0, py0 + 286; size: pwi - 118, 26; cursor: pointer; role: toggle
                                               checked: nx_show_trunk; label: "Show the core bus traces" }
                    NButton(px0, py0 + 286, pwi - 118, 26, "CORE BUS", nx_show_trunk, ac, nx_trunk_toggle.hover)
                    on press nx_trunk_toggle { nx_look_key = 13; nx_look_val = 1; emit nx_look }
                    text "APPEARANCE IS SAVED WITH THE ARRANGEMENT" { at: px0, panel_y + panel_h - 18; anchor: left center
                         size: 6.5; family: "Share Tech Mono"; color: fl.muted }
                }

                // ── ARRANGE: the arrangements, their names and the band ──
                group {
                    show: nx_panel == layout
                    NCaption(px0, py0 + 2, pwi, "arrangements", fl.muted)
                    for a in nx_arrs {
                        let ay = py0 + 12 + (a.id - 1) * 26
                        group {
                            box { from: px0, ay; size: pwi, 24; corner: 3; color: fl.ground
                                  opacity: if(a.active, 0.4, 0.16) }
                            box { from: px0, ay; size: 2, 24; color: if(a.active, fl.flare, fl.trace) }
                            text a.name { at: px0 + 12, ay + 12; anchor: left center; size: 9; weight: 700; family: "Exo 2"
                                          width: pwi - 90; lines: 1; color: if(a.active, fl.flare, fl.trace_lit) }
                            text pick(a.active, "SHOW", "SHOWING") { at: px0 + pwi - 8, ay + 12; anchor: right center; size: 6.5
                                  family: "Share Tech Mono"; color: if(a.active, fl.flare, fl.muted) }
                            zone box nx_arr_pick { from: px0, ay; size: pwi, 24; cursor: pointer; role: tab
                                                   selected: a.active; label: "Show the {a.name} arrangement" }
                            box { from: px0, ay; size: pwi, 24; corner: 3; stroke: 1; color: ac
                                  opacity: nx_arr_pick.hover * 0.5 }
                            on press nx_arr_pick { emit nx_arrangement(a.id) }
                        }
                    }
                    let ah = py0 + 22 + nx_arrangement_count * 26
                    zone box nx_arr_add { from: px0, ah; size: 104, 26; cursor: pointer; role: button
                                          label: "Keep this arrangement under a new name" }
                    NButton(px0, ah, 104, 26, "NEW", 0, ac, nx_arr_add.hover)
                    on press nx_arr_add { emit nx_arr_new }
                    zone box nx_arr_dup { from: px0 + 110, ah; size: 104, 26; cursor: pointer; role: button
                                          label: "Duplicate this arrangement" }
                    NButton(px0 + 110, ah, 104, 26, "COPY", 0, ac, nx_arr_dup.hover)
                    on press nx_arr_dup { emit nx_arr_dup }
                    zone box nx_arr_del { from: px0 + 220, ah; size: pwi - 220, 26; cursor: pointer; role: button
                                          label: "Delete this arrangement" }
                    NButton(px0 + 220, ah, pwi - 220, 26, "DELETE", 0, fl.ember, nx_arr_del.hover)
                    on press nx_arr_del { emit nx_arr_del }

                    NCaption(px0, ah + 38, pwi, "rename", fl.muted)
                    input nx_arr_draft { at: px0, ah + 50; width: pwi - 76; size: 13; color: fl.trace_lit
                                         family: "Share Tech Mono"; placeholder: "Arrangement name"; selection: ac }
                    zone box nx_arr_name_btn { from: px0 + pwi - 68, ah + 42; size: 68, 24; cursor: pointer; role: button
                                               label: "Apply the arrangement name" }
                    NButton(px0 + pwi - 68, ah + 42, 68, 24, "APPLY", 0, ac, nx_arr_name_btn.hover)
                    on press nx_arr_name_btn { emit nx_arr_rename }

                    NCaption(px0, ah + 82, pwi, "mode", fl.muted)
                    zone box nx_mode_c2 { from: px0, ah + 92; size: 104, 26; cursor: pointer; role: toggle
                                          checked: nx_mode == circuit; label: "Show the full circuit" }
                    NButton(px0, ah + 92, 104, 26, "CIRCUIT", nx_mode == circuit, ac, nx_mode_c2.hover)
                    on press nx_mode_c2 { emit nx_mode_switch(0) }
                    zone box nx_mode_m2 { from: px0 + 110, ah + 92; size: 104, 26; cursor: pointer; role: toggle
                                          checked: nx_mode == minimal; label: "Show only the essential nodes" }
                    NButton(px0 + 110, ah + 92, 104, 26, "MINIMAL", nx_mode == minimal, fl.flare, nx_mode_m2.hover)
                    on press nx_mode_m2 { emit nx_mode_switch(1) }

                    NCaption(px0, ah + 132, pwi, "band", fl.muted)
                    zone box nx_banner_btn2 { from: px0, ah + 142; size: 150, 26; cursor: pointer; role: button
                                              label: "Change the banner height" }
                    NButton(px0, ah + 142, 76, 26, "BANNER", 0, ac, nx_banner_btn2.hover)
                    text "{nx_banner_name}" { at: px0 + 112, ah + 155; anchor: center; size: 7.5; weight: 700
                                              family: "Share Tech Mono"; color: fl.trace_lit }
                    on press nx_banner_btn2 { emit nx_banner_cycle }
                    zone box nx_identity_btn2 { from: px0 + 156, ah + 142; size: pwi - 156, 26; cursor: pointer; role: button
                                                label: "Edit the system identity" }
                    NButton(px0 + 156, ah + 142, pwi - 156, 26, "IDENTITY", 0, fl.flare, nx_identity_btn2.hover)
                    on press nx_identity_btn2 { emit nx_identity_edit }
                }
            }
            // ── the identity editor: the banner's fields, on the panel's own plate ──
            group {
                show: nx_identity_edit_on
                let ix = max(12, sw - 356 - if(nx_panel == none, 0, panel_w + 12))
                let iw = 336
                let iy = cy + 12
                body {
                    gradient: ix, iy to ix, iy + 236, fl.hull_raised, fl.hull
                    rim: 5%
                    border: 1, mix(fl.trace, fl.ember, 0.4)
                    shadow: 0, 14, 34, 0.5, fl.ink
                    opacity: nx_fill
                    path { move ix + 10, iy; line ix + iw - 10, iy; line ix + iw, iy + 10
                           line ix + iw, iy + 236 - 10; line ix + iw - 10, iy + 236
                           line ix + 10, iy + 236; line ix, iy + 236 - 10; line ix, iy + 10; close }
                }
                box { from: ix, iy; size: iw - 2, 2; color: fl.ember }
                text "IDENTITY" { at: ix + 16, iy + 24; anchor: left center; size: 11; weight: 700; family: "Exo 2"
                                 color: mix(fl.hull, fl.ember, 0.85) }
                text "THE BANNER'S NAME AND PICTURES" { at: ix + 16, iy + 39; anchor: left center; size: 6.5
                                                       family: "Share Tech Mono"; color: fl.muted }
                NCaption(ix + 16, iy + 56, iw - 32, "display name", fl.muted)
                input nx_identity_draft { at: ix + 16, iy + 68; width: iw - 32; size: 15; color: fl.trace_lit
                                          family: "Exo 2"; placeholder: "Name this system"; selection: ac }
                line { from: ix + 16, iy + 84; to: ix + iw - 16, iy + 84; width: 1; color: ac; opacity: 0.3 }

                zone box nx_identity_avatar_btn { from: ix + 16, iy + 96; size: 148, 30; cursor: pointer; role: button
                                                   label: "Choose profile avatar" }
                NButton(ix + 16, iy + 96, 148, 30, "AVATAR", 0, ac, nx_identity_avatar_btn.hover)
                on press nx_identity_avatar_btn { emit nx_identity_avatar }
                zone box nx_identity_banner_btn { from: ix + 172, iy + 96; size: iw - 188, 30; cursor: pointer; role: button
                                                   label: "Choose system banner" }
                NButton(ix + 172, iy + 96, iw - 188, 30, "BANNER", 0, ac, nx_identity_banner_btn.hover)
                on press nx_identity_banner_btn { emit nx_identity_banner }
                text "PNG · JPG · WEBP · AVIF  ·  48 CHARACTERS AT MOST" { at: ix + 16, iy + 142; anchor: left center
                     size: 6.5; family: "Share Tech Mono"; color: fl.muted }

                NCaption(ix + 16, iy + 160, iw - 32, "band", fl.muted)
                zone box nx_identity_banner_height { from: ix + 16, iy + 170; size: iw - 32, 26; cursor: pointer; role: button
                                                      label: "Change the banner height" }
                NButton(ix + 16, iy + 170, iw - 32, 26, "BAND HEIGHT", 0, fl.flare, nx_identity_banner_height.hover)
                on press nx_identity_banner_height { emit nx_banner_cycle }

                zone box nx_identity_save_btn { from: ix + 16, iy + 204; size: 150, 24; cursor: pointer; role: button
                                                label: "Save system identity" }
                NButton(ix + 16, iy + 204, 150, 24, "SAVE IDENTITY", 0, ac, nx_identity_save_btn.hover)
                on press nx_identity_save_btn { emit nx_identity_save }
                zone box nx_identity_cancel_btn { from: ix + 174, iy + 204; size: iw - 190, 24; cursor: pointer; role: button
                                                  label: "Cancel identity editing" }
                NButton(ix + 174, iy + 204, iw - 190, 24, "CLOSE", 0, fl.ember, nx_identity_cancel_btn.hover)
                on press nx_identity_cancel_btn { emit nx_identity_cancel }
            }
        }
    }

    // Escape resolves in the order the spec gives it (§4): the identity editor, else the
    // docked panel, else the node menu, else an active drag, else the selection, else Nexus.
    // Tab walks the canvas; arrows move the selected node one grid step.
    on key Escape while nx_identity_edit_on { emit nx_identity_cancel }
    on key Escape while not nx_identity_edit_on and nx_panel != none { nx_panel = none }
    on key Escape while nx_menu > 0 and nx_panel == none { nx_menu = 0 }
    on key Escape while nx_menu < 1 and nx_panel == none and nx_drag > 0 { nx_drag = 0; nx_press = 0 }
    on key Escape while nx_menu < 1 and nx_panel == none and nx_drag < 1 and nx_sel > 0 { emit nx_select(nx_sel) }
    on key Escape while nx_menu < 1 and nx_panel == none and nx_drag < 1 and nx_sel < 1 { emit nx_close }
    on key Ctrl+z while nx_view != hub { emit nx_undo }
    on key Ctrl+Shift+z while nx_view != hub { emit nx_redo }
    on key Tab while nx_view != hub and not nx_identity_edit_on and nx_panel == none { emit nx_cycle_sel }
    on key Delete while nx_view != hub and nx_sel > 0 { emit nx_remove(nx_sel) }
    on key Return while nx_view != hub and nx_sel > 0 { emit nx_focus_node(nx_sel) }
    on key Left while nx_view != hub and nx_sel > 0 and not nx_pinned { emit nx_move(1) }
    on key Right while nx_view != hub and nx_sel > 0 and not nx_pinned { emit nx_move(2) }
    on key Up while nx_view != hub and nx_sel > 0 and not nx_pinned { emit nx_move(3) }
    on key Down while nx_view != hub and nx_sel > 0 and not nx_pinned { emit nx_move(4) }
    // Shift and an arrow is four grid steps, as §5.4 asks
    on key Shift+Left while nx_view != hub and nx_sel > 0 and not nx_pinned { emit nx_move_fast(1) }
    on key Shift+Right while nx_view != hub and nx_sel > 0 and not nx_pinned { emit nx_move_fast(2) }
    on key Shift+Up while nx_view != hub and nx_sel > 0 and not nx_pinned { emit nx_move_fast(3) }
    on key Shift+Down while nx_view != hub and nx_sel > 0 and not nx_pinned { emit nx_move_fast(4) }
    on key Shift+Tab while nx_view != hub and not nx_identity_edit_on and nx_panel == none { emit nx_cycle_sel_back }
}
