language 0.9
import "theme/tokens.plm"
import "theme/ferrolume.plm"
import "ui/loom.plm"
import "ui/island.plm"
import "ui/deck.plm"

// mooi's Control Nexus as a deck (D102): one low strip along the bottom or the top of the screen,
// or a column down either side (nexus.edge), that never dims or covers the desktop. Scenes and what
// is waiting run along its head; the window you are in has its own controls; your workspaces are
// miniatures with their windows in them; the mixer, the switches, the machine and the music share
// the console. What needs more room grows out of the deck, away from its edge, while it is pointed
// at — a scene says what it would change, a workspace opens into a preview you can read. It closes
// on Esc, its ×, the bar's mark again, or a workspace change. mooi-nexus.luau reads what it shows
// and places it (lib/nexusdeck); every press goes to the system or to the bar.

scene Nexus {
    permissions {
        run: "pleamar", "cat", "df", "sensors", "hyprctl", "mooi", "curl", "magick", "kitty", "btop", "hostname", "whoami", "zenity"
        services: "workspaces", "clock", "audio", "audio.*", "brightness", "brightness.*", "battery", "network", "network.*", "bluetooth", "bluetooth.*", "media", "media.*", "files", "files.write", "env", "thumbnails", "thumbnails.want"
    }


    // The same facts and springs the bar wears: the logic paints them from palette.json, and
    // the studio re-lights with the desktop when the palette changes after an apply.
    // corners on every plate (look.corners: 0 chamfer · 1 bevel · 2 rounded · 3 square; look.corner_size as a scale)
    fact cn_kind = 0
    fact cn_scale = 1
    fact fr_ground_r = 0.000000
    fact fr_ground_g = 0.000000
    fact fr_ground_b = 0.000000
    fact fr_hull_r = 0.015686
    fact fr_hull_g = 0.035294
    fact fr_hull_b = 0.031373
    fact fr_hull_raised_r = 0.027451
    fact fr_hull_raised_g = 0.074510
    fact fr_hull_raised_b = 0.066667
    fact fr_well_r = 0.019608
    fact fr_well_g = 0.164706
    fact fr_well_b = 0.145098
    fact fr_trace_dim_r = 0.121569
    fact fr_trace_dim_g = 0.219608
    fact fr_trace_dim_b = 0.200000
    fact fr_trace_r = 0.239216
    fact fr_trace_g = 0.415686
    fact fr_trace_b = 0.376471
    fact fr_trace_lit_r = 0.423529
    fact fr_trace_lit_g = 0.788235
    fact fr_trace_lit_b = 0.682353
    fact fr_phos_r = 0.498039
    fact fr_phos_g = 0.811765
    fact fr_phos_b = 0.713725
    fact fr_phos_fill_r = 0.090196
    fact fr_phos_fill_g = 0.603922
    fact fr_phos_fill_b = 0.533333
    fact fr_ember_r = 0.878431
    fact fr_ember_g = 0.482353
    fact fr_ember_b = 0.180392
    fact fr_ember_fill_r = 0.823529
    fact fr_ember_fill_g = 0.411765
    fact fr_ember_fill_b = 0.117647
    fact fr_flare_r = 0.956863
    fact fr_flare_g = 0.713725
    fact fr_flare_b = 0.235294
    fact fr_muted_r = 0.352941
    fact fr_muted_g = 0.541176
    fact fr_muted_b = 0.494118
    fact fr_ink_r = 0.015686
    fact fr_ink_g = 0.129412
    fact fr_ink_b = 0.113725
    fact fr_steel_900_r = 0.082353
    fact fr_steel_900_g = 0.098039
    fact fr_steel_900_b = 0.105882
    fact fr_steel_700_r = 0.164706
    fact fr_steel_700_g = 0.192157
    fact fr_steel_700_b = 0.203922
    fact fr_steel_500_r = 0.290196
    fact fr_steel_500_g = 0.329412
    fact fr_steel_500_b = 0.349020
    fact fr_steel_300_r = 0.545098
    fact fr_steel_300_g = 0.592157
    fact fr_steel_300_b = 0.611765
    fact fr_engrave_r = 0.603922
    fact fr_engrave_g = 0.650980
    fact fr_engrave_b = 0.670588
    prop pr_ground_r = 0.000000 ~fl.relight
    follow pr_ground_r = fr_ground_r
    prop pr_ground_g = 0.000000 ~fl.relight
    follow pr_ground_g = fr_ground_g
    prop pr_ground_b = 0.000000 ~fl.relight
    follow pr_ground_b = fr_ground_b
    prop pr_hull_r = 0.015686 ~fl.relight
    follow pr_hull_r = fr_hull_r
    prop pr_hull_g = 0.035294 ~fl.relight
    follow pr_hull_g = fr_hull_g
    prop pr_hull_b = 0.031373 ~fl.relight
    follow pr_hull_b = fr_hull_b
    prop pr_hull_raised_r = 0.027451 ~fl.relight
    follow pr_hull_raised_r = fr_hull_raised_r
    prop pr_hull_raised_g = 0.074510 ~fl.relight
    follow pr_hull_raised_g = fr_hull_raised_g
    prop pr_hull_raised_b = 0.066667 ~fl.relight
    follow pr_hull_raised_b = fr_hull_raised_b
    prop pr_well_r = 0.019608 ~fl.relight
    follow pr_well_r = fr_well_r
    prop pr_well_g = 0.164706 ~fl.relight
    follow pr_well_g = fr_well_g
    prop pr_well_b = 0.145098 ~fl.relight
    follow pr_well_b = fr_well_b
    prop pr_trace_dim_r = 0.121569 ~fl.relight
    follow pr_trace_dim_r = fr_trace_dim_r
    prop pr_trace_dim_g = 0.219608 ~fl.relight
    follow pr_trace_dim_g = fr_trace_dim_g
    prop pr_trace_dim_b = 0.200000 ~fl.relight
    follow pr_trace_dim_b = fr_trace_dim_b
    prop pr_trace_r = 0.239216 ~fl.relight
    follow pr_trace_r = fr_trace_r
    prop pr_trace_g = 0.415686 ~fl.relight
    follow pr_trace_g = fr_trace_g
    prop pr_trace_b = 0.376471 ~fl.relight
    follow pr_trace_b = fr_trace_b
    prop pr_trace_lit_r = 0.423529 ~fl.relight
    follow pr_trace_lit_r = fr_trace_lit_r
    prop pr_trace_lit_g = 0.788235 ~fl.relight
    follow pr_trace_lit_g = fr_trace_lit_g
    prop pr_trace_lit_b = 0.682353 ~fl.relight
    follow pr_trace_lit_b = fr_trace_lit_b
    prop pr_phos_r = 0.498039 ~fl.relight
    follow pr_phos_r = fr_phos_r
    prop pr_phos_g = 0.811765 ~fl.relight
    follow pr_phos_g = fr_phos_g
    prop pr_phos_b = 0.713725 ~fl.relight
    follow pr_phos_b = fr_phos_b
    prop pr_phos_fill_r = 0.090196 ~fl.relight
    follow pr_phos_fill_r = fr_phos_fill_r
    prop pr_phos_fill_g = 0.603922 ~fl.relight
    follow pr_phos_fill_g = fr_phos_fill_g
    prop pr_phos_fill_b = 0.533333 ~fl.relight
    follow pr_phos_fill_b = fr_phos_fill_b
    prop pr_ember_r = 0.878431 ~fl.relight
    follow pr_ember_r = fr_ember_r
    prop pr_ember_g = 0.482353 ~fl.relight
    follow pr_ember_g = fr_ember_g
    prop pr_ember_b = 0.180392 ~fl.relight
    follow pr_ember_b = fr_ember_b
    prop pr_ember_fill_r = 0.823529 ~fl.relight
    follow pr_ember_fill_r = fr_ember_fill_r
    prop pr_ember_fill_g = 0.411765 ~fl.relight
    follow pr_ember_fill_g = fr_ember_fill_g
    prop pr_ember_fill_b = 0.117647 ~fl.relight
    follow pr_ember_fill_b = fr_ember_fill_b
    prop pr_flare_r = 0.956863 ~fl.relight
    follow pr_flare_r = fr_flare_r
    prop pr_flare_g = 0.713725 ~fl.relight
    follow pr_flare_g = fr_flare_g
    prop pr_flare_b = 0.235294 ~fl.relight
    follow pr_flare_b = fr_flare_b
    prop pr_muted_r = 0.352941 ~fl.relight
    follow pr_muted_r = fr_muted_r
    prop pr_muted_g = 0.541176 ~fl.relight
    follow pr_muted_g = fr_muted_g
    prop pr_muted_b = 0.494118 ~fl.relight
    follow pr_muted_b = fr_muted_b
    prop pr_ink_r = 0.015686 ~fl.relight
    follow pr_ink_r = fr_ink_r
    prop pr_ink_g = 0.129412 ~fl.relight
    follow pr_ink_g = fr_ink_g
    prop pr_ink_b = 0.113725 ~fl.relight
    follow pr_ink_b = fr_ink_b
    prop pr_steel_900_r = 0.082353 ~fl.relight
    follow pr_steel_900_r = fr_steel_900_r
    prop pr_steel_900_g = 0.098039 ~fl.relight
    follow pr_steel_900_g = fr_steel_900_g
    prop pr_steel_900_b = 0.105882 ~fl.relight
    follow pr_steel_900_b = fr_steel_900_b
    prop pr_steel_700_r = 0.164706 ~fl.relight
    follow pr_steel_700_r = fr_steel_700_r
    prop pr_steel_700_g = 0.192157 ~fl.relight
    follow pr_steel_700_g = fr_steel_700_g
    prop pr_steel_700_b = 0.203922 ~fl.relight
    follow pr_steel_700_b = fr_steel_700_b
    prop pr_steel_500_r = 0.290196 ~fl.relight
    follow pr_steel_500_r = fr_steel_500_r
    prop pr_steel_500_g = 0.329412 ~fl.relight
    follow pr_steel_500_g = fr_steel_500_g
    prop pr_steel_500_b = 0.349020 ~fl.relight
    follow pr_steel_500_b = fr_steel_500_b
    prop pr_steel_300_r = 0.545098 ~fl.relight
    follow pr_steel_300_r = fr_steel_300_r
    prop pr_steel_300_g = 0.592157 ~fl.relight
    follow pr_steel_300_g = fr_steel_300_g
    prop pr_steel_300_b = 0.611765 ~fl.relight
    follow pr_steel_300_b = fr_steel_300_b
    prop pr_engrave_r = 0.603922 ~fl.relight
    follow pr_engrave_r = fr_engrave_r
    prop pr_engrave_g = 0.650980 ~fl.relight
    follow pr_engrave_g = fr_engrave_g
    prop pr_engrave_b = 0.670588 ~fl.relight
    follow pr_engrave_b = fr_engrave_b

    // The islands' semantic tokens, which theme/tokens defines over these facts.
    fact c_bg_primary_r = 0.062745
    fact c_bg_primary_g = 0.078431
    fact c_bg_primary_b = 0.086275
    fact c_bg_secondary_r = 0.086275
    fact c_bg_secondary_g = 0.105882
    fact c_bg_secondary_b = 0.117647
    fact c_surface_primary_r = 0.098039
    fact c_surface_primary_g = 0.121569
    fact c_surface_primary_b = 0.133333
    fact c_surface_elevated_r = 0.133333
    fact c_surface_elevated_g = 0.160784
    fact c_surface_elevated_b = 0.176471
    fact c_border_subtle_r = 0.172549
    fact c_border_subtle_g = 0.207843
    fact c_border_subtle_b = 0.223529
    fact c_fg_primary_r = 0.890196
    fact c_fg_primary_g = 0.913725
    fact c_fg_primary_b = 0.921569
    fact c_fg_secondary_r = 0.639216
    fact c_fg_secondary_g = 0.690196
    fact c_fg_secondary_b = 0.709804
    fact c_fg_muted_r = 0.541176
    fact c_fg_muted_g = 0.592157
    fact c_fg_muted_b = 0.611765
    fact c_accent_primary_r = 0.650980
    fact c_accent_primary_g = 0.952941
    fact c_accent_primary_b = 0.819608
    fact c_accent_secondary_r = 1.000000
    fact c_accent_secondary_g = 0.572549
    fact c_accent_secondary_b = 0.372549
    fact c_status_ok_r = 0.650980
    fact c_status_ok_g = 0.952941
    fact c_status_ok_b = 0.819608
    fact c_status_error_r = 1.000000
    fact c_status_error_g = 0.572549
    fact c_status_error_b = 0.372549
    fact c_focus_ring_r = 0.650980
    fact c_focus_ring_g = 0.952941
    fact c_focus_ring_b = 0.819608
    fact c_selection_bg_r = 0.164706
    fact c_selection_bg_g = 0.227451
    fact c_selection_bg_b = 0.211765
    // What theme/ferrolume reads for its geometry; the studio uses the colour, not the bar's
    // strip, so these are only the values the tokens are defined against.
    fact st_offset = 0
    fact st_notch = false
    fact bar_rail = true
    fact st_height = 30
    fact st_radius = 8
    fact st_res = 46

    fact st_glow = 1
    fact ch_on = false           // D152: the deck drawn by the frame as part of its body (frame.islands)
    // the deck as the frame grows it (D152): the same count and springs as the frame's `dk` place, the
    // band's width and where this surface starts on the screen (it begins under the bar's reserve)
    fact nm_n = 0
    fact nm_on = false           // the deck out, as the frame was told (a little after dk_open: see the logic)
    fact nm_band = 6
    fact nm_off = 34
    prop nm_q = 0 ~m.isl
    follow nm_q = nm_n
    prop nm_c = 0 ~m.isl_out
    follow nm_c = if(nm_on, 1, 0)
    let nm_rv = min(clamp(nm_q - (nm_n - 1), 0, 1), nm_c)
    event pl_xy ->
    event pl_wh ->
    event pl_t ->
    fact isl_style = 0           // island.style: 0 plate · 1 tether (the island kit reads it)

    // ── What the services report ──
    model apps max 8 { id: text; name: text; volume: number; muted: bool; playing: bool }
    service audio { volume: number; muted: bool; input: number; input_muted: bool; apps: apps }
    service brightness { present: bool; level: number }
    service battery { present: bool; percent: number; charging: bool }
    service media as med { playing: bool; title: text; artist: text; player: text }
    service clock { time: text = "--:--"; date: text }

    // ── Where the deck is (lib/nexusdeck): the screen's and its own; the cards in it ──
    fact dk_open = false         // in (true) or sliding away
    fact dk_edge = 0             // 0 bottom · 1 top · 2 left · 3 right (nexus.edge)
    fact dk_vert = false         // down a side: a column
    fact dk_rows = 1             // one row of cards, or two (down a side: two columns) — nexus.rows
    fact dk_canvas = false       // two rows: the band is a free canvas (D122, D124): carry a card anywhere in it, pull its corner
    fact dk_rid = -1             // the card whose corner is being pulled (its code)
    fact dk_rdx = 0              // how far
    fact dk_rdy = 0
    fact dk_lon = false          // the landing (D125): where the card in the hand would settle, from the logic
    fact dk_lx = 0
    fact dk_ly = 0
    fact dk_lw = 0
    fact dk_lh = 0
    fact dk_l2on = false         // and, dropped on another card, where that one goes (they change places)
    fact dk_l2x = 0
    fact dk_l2y = 0
    fact dk_l2w = 0
    fact dk_l2h = 0
    fact nx_large = false        // the profile's large size (nexus.profile)
    fact dk_x = 120
    fact dk_y = 830
    fact dk_w = 1680
    fact dk_h = 252
    fact dk_ox = 0               // the way out of the screen, which it slides in from
    fact dk_oy = 1
    // the cards (codes: 0 window · 1 spaces · 2 mixer · 3 quick · 4 music · 5 machine · 6 today · 7 profile · 8 scenes · 9 waiting · 10 activity): shown or not, where, their number in your order
    fact pw_on = false
    fact pw_x = 0
    fact pw_y = 30
    fact pw_w = 200
    fact pw_h = 214
    text pw_n = "01"
    text pw_sz = "M"
    fact ps_on = false
    fact ps_x = 0
    fact ps_y = 30
    fact ps_w = 200
    fact ps_h = 214
    text ps_n = "02"
    text ps_sz = "M"
    fact pm_on = false
    fact pm_x = 0
    fact pm_y = 30
    fact pm_w = 200
    fact pm_h = 214
    text pm_n = "03"
    text pm_sz = "M"
    fact pq_on = false
    fact pq_x = 0
    fact pq_y = 30
    fact pq_w = 200
    fact pq_h = 214
    text pq_n = "04"
    text pq_sz = "M"
    fact pu_on = false
    fact pu_x = 0
    fact pu_y = 30
    fact pu_w = 200
    fact pu_h = 214
    text pu_n = "05"
    text pu_sz = "M"
    fact pc_on = false
    fact pc_x = 0
    fact pc_y = 30
    fact pc_w = 200
    fact pc_h = 214
    text pc_n = "06"
    text pc_sz = "M"
    fact pt_on = false
    fact pt_x = 0
    fact pt_y = 30
    fact pt_w = 200
    fact pt_h = 214
    text pt_n = "07"
    text pt_sz = "M"
    fact pf_on = false
    fact pf_x = 0
    fact pf_y = 30
    fact pf_w = 200
    fact pf_h = 214
    text pf_n = "08"
    text pf_sz = "M"
    fact pn_on = false
    fact pn_x = 0
    fact pn_y = 30
    fact pn_w = 200
    fact pn_h = 214
    text pn_n = "09"
    text pn_sz = "M"
    fact pa_on = false
    fact pa_x = 0
    fact pa_y = 30
    fact pa_w = 200
    fact pa_h = 214
    text pa_n = "10"
    text pa_sz = "M"
    fact py_on = false
    fact py_x = 0
    fact py_y = 30
    fact py_w = 200
    fact py_h = 214
    text py_n = "11"
    text py_sz = "M"
    // the circuit: each card's node wired up to the bus along the rail, and traces between neighbours
    model nodes max 12 { x: number; y: number; bx: number; by: number }
    model traces max 40 { x1: number; y1: number; x2: number; y2: number }
    // arranging: the panel that grows out of the deck while ✎ is on
    fact ga_x = 0
    fact ga_y = 0
    // the Music card's visualiser: sixteen bands of the bar's feed, while the deck is open
    fact dv0 = 0
    fact dv1 = 0
    fact dv2 = 0
    fact dv3 = 0
    fact dv4 = 0
    fact dv5 = 0
    fact dv6 = 0
    fact dv7 = 0
    fact dv8 = 0
    fact dv9 = 0
    fact dv10 = 0
    fact dv11 = 0
    fact dv12 = 0
    fact dv13 = 0
    fact dv14 = 0
    fact dv15 = 0
    // the activity map (activity.json, which the bar writes): seven days of 24 hours, the apps most used
    model heat max 168 { v: number }
    model aday max 7 { label: text }
    model topa max 4 { word: text; v: number; t: text }
    text act_t = ""
    text nx_banner = ""
    fact nx_banner_on = false
    image banner = from nx_banner, 960, 540

    // ── Status, HUD-fashion: each part's lamp (0 standby · 1 active · 2 caution · 3 alert), and the
    // master caution lit while something pressing waits (recording, a low battery, a hot machine) ──
    fact lp_w = 0
    fact lp_s = 1
    fact lp_m = 1
    fact lp_q = 1
    fact lp_u = 0
    fact lp_c = 1
    fact lp_t = 1
    fact lp_f = 1
    fact lp_n = 1
    fact lp_a = 0
    fact lp_y = 1
    fact dk_caution = false
    text dk_caution_t = ""

    // ── Arranging it (✎): parts moved by hand, hidden, shown again; the edge chosen here too ──
    fact dk_edit = false
    fact dk_gid = -1             // the part being carried (its code)
    fact dk_gdx = 0              // how far it has been carried
    fact dk_gdy = 0
    model hid max 12 { word: text; code: number; room: bool }   // hidden cards (room: no room for it here)


    // ── Who you are ──
    text nx_name = "mooi"
    text nx_who = ""
    text nx_avatar = ""
    fact nx_avatar_on = false
    text nx_initial = "M"
    text nx_notice = ""          // a word after a scene is saved or removed
    fact nx_noticed = false      // and it is showing

    // ── Scenes, and what is waiting ──
    model scn max 8 { word: text; live: bool; save: bool; env: bool; x: number; y: number; w: number }
    model wait max 6 { word: text; act: text; hot: bool; x: number; y: number; w: number }
    fact dk_hsc = -1             // the scene pointed at: what it would change grows out
    model diff max 8 { word: text; w: number }
    text diff_t = ""             // "FOCUS WOULD →"
    fact gs_x = 0                // where that grows to (the screen's)
    fact gs_y = 0
    fact gs_w = 420
    // naming a new scene: its name, and a saved environment to restore with it
    fact dk_naming = false
    text dk_name_in = ""
    model envs max 8 { word: text; on: bool; w: number }
    fact gn_x = 0
    fact gn_y = 0

    // ── The window you are in ──
    fact w_ok = false
    text w_app = ""
    text w_title = ""
    text w_where = ""
    text w_initial = ""
    text w_note = ""
    fact w_noted = false
    fact w_snd = false           // it plays something: its own level
    fact w_vol = 0
    fact w_floating = false
    fact w_pinned = false
    fact w_full = false

    // ── Your workspaces as miniatures ──
    text dk_wall = ""
    fact dk_wall_on = false
    image wall = from dk_wall, 480, 270
    model tiles max 12 { id: number; label: text; n: text; active: bool; plus: bool; x: number; y: number; w: number; h: number }
    model wins max 48 { x: number; y: number; w: number; h: number; focused: bool; app: text; pic: image 320, 180; pictured: bool }
    fact dk_wd = -1              // a miniature window being carried to another workspace
    fact dk_wdx = 0
    fact dk_wdy = 0
    fact dk_hws = -1             // the tile pointed at: its preview grows out
    model big max 16 { x: number; y: number; w: number; h: number; focused: bool; app: text; pic: image 480, 270; pictured: bool }
    text big_t = ""
    fact gw_x = 0
    fact gw_y = 0
    fact gw_w = 520
    fact gw_h = 336
    fact gw_free = false         // the tile pointed at is "+"

    // ── The mixer, quick settings, the machine, the music, today ──
    model faders max 6 { word: text; shown: text; v: number; code: number; hot: bool }
    model quick max 12 { word: text; state: text; on: bool; hot: bool; glyph: number; code: number }
    model sp_cpu max 40 { x1: number; y1: number; x2: number; y2: number }
    model sp_mem max 40 { x1: number; y1: number; x2: number; y2: number }
    model days max 7 { label: text; day: number; today: bool }
    fact m_cpu = 0
    fact m_temp = 0
    fact m_mem = 0
    fact m_disk = 0
    text m_cpu_t = "0%"
    text m_mem_t = "0%"
    text m_bat_t = "AC"
    text m_disk_t = "0%"
    text m_temp_t = ""
    text m_up_t = ""
    fact m_bat = 1
    fact m_bat_hot = false
    text nx_art = ""
    fact nx_art_on = false
    fact nx_prog = 0
    text nx_elapsed = ""
    text nx_length = ""
    fact mus_on = false          // a player has a song
    image cover = from nx_art, 96, 96
    image avatar = from nx_avatar, 96, 96
    text td_day = ""             // today: the date, big
    text td_month = ""
    text td_week = ""
    fact wx_ok = false
    fact wx_kind = 2
    text wx_t = ""
    text wx_word = ""

    event nx_toggle ->           // from the bar (the mark, `mooi nexus`): open it, or send it away
    event nx_close ->            // to the logic: slide away and end
    event nx_tog ->              // to the logic: quick setting n (mooi-nexus.luau QUICK)
    event nx_go ->               // to the logic: open something (codes in mooi-nexus.luau GO)
    event nx_media ->            // to the logic: 0 previous · 1 play/pause · 2 next
    event dk_level ->            // to the logic: 1000 · fader code + level (0..1000)
    event dk_win ->              // to the logic: this window — 0 float · 1 fullscreen · 2 pin · 3 close
    event dk_wait ->             // to the logic: what is waiting, item n's action
    event dk_scene ->            // to the logic: switch to scene n
    event dk_unscene ->          // to the logic: remove scene n (a right press)
    event dk_hov_scene ->        // to the logic: scene n is pointed at (say what it would change)
    event dk_naming_on ->        // to the logic: "+ Save" pressed: the naming panel opens
    event dk_save_named ->       // to the logic: save the setup under the name typed
    event dk_env ->              // to the logic: environment n for the scene being named (again: none)
    event dk_ws ->               // to the logic: go to tile n's workspace
    event dk_send ->             // to the logic: send this window to tile n's workspace
    event dk_hov_ws ->           // to the logic: tile n is pointed at (its preview)
    event dk_big ->              // to the logic: window n of the preview — focus it
    event dk_wdrop ->            // to the logic: a miniature window let go at 10000 · x + y (the screen's)
    event dk_edit_on ->          // to the logic: ✎ — arranging, on or off
    event dk_resize ->           // to the logic: a card's corner let go on the canvas (1000000 · code + 1000 · w/4 + h/4)
    event dk_drag ->             // to the logic: a card carried, its middle here (as dk_drop): where would it land?
    event dk_sizing ->           // to the logic: a card's corner being pulled (as dk_resize): what size would it settle at?
    event dk_drop ->             // to the logic: the part carried let go at this place along the deck
    event dk_hide ->             // to the logic: hide part n
    event dk_show ->             // to the logic: show hidden part n again
    event dk_edge_set ->         // to the logic: the deck to edge n (0 bottom · 1 top · 2 left · 3 right)
    event dk_reset ->            // to the logic: every part back, in the first order
    event dk_rows_set ->         // to the logic: one row of cards or two
    event dk_large_set ->        // to the logic: the profile small (0) or large (1)
    event nx_pick ->             // to the logic: choose a picture — 0 the avatar · 1 the banner
    event dk_size ->             // to the logic: card n to its next size (small, medium, large)
    event dk_notch ->            // to the logic: notch tab n off the deck's end (0 Claude · 1 Music · 2 Weather · 3 Workspaces · 4 Wallpapers · 5 GitHub)

    figure i_set = file "icons/cog.svg"
    figure i_lock = file "icons/lock.svg"
    figure i_power = file "icons/power.svg"
    figure i_wifi = file "icons/wifi.svg"
    figure i_bt = file "icons/bluetooth.svg"
    figure i_vol = file "icons/volume.svg"
    figure i_mute = file "icons/volume-mute.svg"
    figure i_mic = file "icons/mic.svg"
    figure i_bell = file "icons/bell.svg"
    figure i_night = file "icons/night.svg"
    figure i_caf = file "icons/caffeine.svg"
    figure i_bolt = file "icons/bolt.svg"
    figure i_sun = file "icons/sun.svg"
    figure i_rec = file "icons/recorder.svg"
    figure i_shot = file "icons/screenshot.svg"
    figure i_clip = file "icons/clipboard.svg"
    figure i_clear = file "icons/clear.svg"
    figure i_cloud = file "icons/cloud.svg"
    figure i_fog = file "icons/fog.svg"
    figure i_rain = file "icons/rain.svg"
    figure i_snow = file "icons/snow.svg"
    figure i_storm = file "icons/storm.svg"
    figure i_cpu = file "icons/cpu.svg"
    figure i_ram = file "icons/ram.svg"
    figure i_music = file "icons/music.svg"
    figure i_window = file "icons/window.svg"
    figure i_ws = file "icons/workspace.svg"
    figure i_cal = file "icons/calendar.svg"
    figure i_arrange = file "icons/arrange.svg"
    figure i_claude = file "icons/claude.svg"
    figure i_git = file "icons/git.svg"
    figure i_wallp = file "icons/wallpaper.svg"
    fact dk_ntab = -1            // the notch tab off the deck last pointed at
    fact dk_notches = true       // the notches off the deck are shown (nexus.notches)
    // A notch tab's glyph (0 Claude · 1 Music · 2 Weather · 3 Workspaces · 4 Wallpapers · 5 GitHub).
    component NGlyph(x: number, y: number, g: number, c: color) {
        size: 14, 14
        figure i_claude { at: x, y; size: 13, 13; color: c; show: g < 0.5 }
        figure i_music { at: x, y; size: 13, 13; color: c; show: g > 0.5 and g < 1.5 }
        figure i_cloud { at: x, y; size: 13, 13; color: c; show: g > 1.5 and g < 2.5 }
        figure i_ws { at: x, y; size: 13, 13; color: c; show: g > 2.5 and g < 3.5 }
        figure i_wallp { at: x, y; size: 13, 13; color: c; show: g > 3.5 and g < 4.5 }
        figure i_git { at: x, y; size: 13, 13; color: c; show: g > 4.5 }
    }

    // ── Motion ──
    // ~420 ms in: long enough to be seen arriving (it was 220 ms and read as a blink, D118);
    // a touch under critical damping, so it settles with the faintest give and no bounce
    spring nx.slide = 260, 30
    prop nx_in = 0 ~nx.slide
    follow nx_in = if(dk_open, 1, 0)
    prop gs_in = 0 ~m.expand         // what grows out: a scene's changes, a workspace's preview, naming
    follow gs_in = if(dk_hsc >= 0 and dk_open and not dk_naming, 1, 0)
    prop gw_in = 0 ~m.expand
    follow gw_in = if(dk_hws >= 0 and dk_open and dk_wd < 0 and not dk_edit, 1, 0)
    prop gn_in = 0 ~m.expand
    follow gn_in = if(dk_naming and dk_open, 1, 0)
    prop ed_in = 0 ~m.expand         // arranging: the handles and the edit bar
    follow ed_in = if(dk_edit, 1, 0)
    // Powering on: a scan line sweeps the deck once as it opens, and each part comes online after it
    // (springs settle at once with reduced motion, so it is simply there)
    prop scan = 0 ~760ms
    spring nx.part = 420, 34         // ~320 ms: each card coming online
    prop rp.0 = 0 ~nx.part
    prop rp.1 = 0 ~nx.part
    prop rp.2 = 0 ~nx.part
    prop rp.3 = 0 ~nx.part
    prop rp.4 = 0 ~nx.part
    prop rp.5 = 0 ~nx.part
    prop rp.6 = 0 ~nx.part
    prop rp.7 = 0 ~nx.part
    prop rp.8 = 0 ~nx.part
    prop rp.9 = 0 ~nx.part
    prop rp.10 = 0 ~nx.part
    // The Nexus stays running while it is away (D118), so every opening starts from nothing:
    // the deck slides in, the scan sweeps it once it is most of the way in, and the cards come
    // online one after another behind the scan.
    on change dk_open while dk_open {
        scan: 0 ~0ms; rp.0: 0 ~0ms; rp.1: 0 ~0ms; rp.2: 0 ~0ms; rp.3: 0 ~0ms; rp.4: 0 ~0ms; rp.5: 0 ~0ms; rp.6: 0 ~0ms; rp.7: 0 ~0ms; rp.8: 0 ~0ms; rp.9: 0 ~0ms; rp.10: 0 ~0ms
        // (D154: from 100 ms, 25 ms apart — it was 240 to 790 ms, and the deck stood empty most of a
        // second after its body had grown)
        scan: 1 after 80ms
        rp.0: 1 after 100ms; rp.1: 1 after 125ms; rp.2: 1 after 150ms; rp.3: 1 after 175ms
        rp.4: 1 after 200ms; rp.5: 1 after 225ms; rp.6: 1 after 250ms; rp.7: 1 after 275ms
        rp.8: 1 after 300ms; rp.9: 1 after 325ms; rp.10: 1 after 350ms
    }
    // the landing glides between the places it is offered, so it reads as one outline and not a flicker
    prop lg_x = 0 ~m.select
    follow lg_x = dk_lx
    prop lg_y = 0 ~m.select
    follow lg_y = dk_ly
    prop lg_w = 0 ~m.select
    follow lg_w = dk_lw
    prop lg_h = 0 ~m.select
    follow lg_h = dk_lh
    on change dk_lon { lg_x: dk_lx ~0ms; lg_y: dk_ly ~0ms; lg_w: dk_lw ~0ms; lg_h: dk_lh ~0ms }
    // the lock-on: brackets that close on the workspace pointed at, again for each new one
    prop lk = 0 ~m.select
    follow lk = if(dk_hws >= 0, 1, 0)
    on change dk_hws { lk: 0 ~0ms }
    prop rc_cpu = 0 ~m.reflow
    follow rc_cpu = m_cpu
    prop rc_mem = 0 ~m.reflow
    follow rc_mem = m_mem
    prop rc_song = 0 ~m.reflow
    follow rc_song = nx_prog

    // A quick setting's or a shelf's glyph `g` (mooi-nexus.luau QUICK's), centred at (x, y).
    component QGlyph(x: number, y: number, g: number, c: color, sz: number = 16) {
        size: sz, sz
        figure i_wifi { at: x, y; size: sz, sz; color: c; show: g < 0.5 }
        figure i_bt { at: x, y; size: sz, sz; color: c; show: g > 0.5 and g < 1.5 }
        figure i_vol { at: x, y; size: sz, sz; color: c; show: g > 1.5 and g < 2.5 }
        figure i_mic { at: x, y; size: sz, sz; color: c; show: g > 2.5 and g < 3.5 }
        figure i_bell { at: x, y; size: sz, sz; color: c; show: g > 3.5 and g < 4.5 }
        figure i_night { at: x, y; size: sz, sz; color: c; show: g > 4.5 and g < 5.5 }
        figure i_caf { at: x, y; size: sz, sz; color: c; show: g > 5.5 and g < 6.5 }
        figure i_bolt { at: x, y; size: sz, sz; color: c; show: g > 6.5 and g < 7.5 }
        figure i_sun { at: x, y; size: sz, sz; color: c; show: g > 7.5 and g < 8.5 }
        figure i_rec { at: x, y; size: sz, sz; color: c; show: g > 8.5 and g < 9.5 }
        figure i_shot { at: x, y; size: sz, sz; color: c; show: g > 9.5 and g < 10.5 }
        figure i_clip { at: x, y; size: sz, sz; color: c; show: g > 10.5 and g < 11.5 }
        figure i_mute { at: x, y; size: sz, sz; color: c; show: g > 11.5 }
    }
    // A weather glyph of kind `k` (lib/sysinfo WEATHER_KINDS), centred at (x, y).
    component WGlyph(x: number, y: number, sz: number, k: number) {
        size: sz, sz
        figure i_clear { at: x, y; size: sz, sz; color: fl.flare; show: k < 0.5 }
        figure i_night { at: x, y; size: sz, sz; color: dk.ink; show: k > 0.5 and k < 1.5 }
        figure i_cloud { at: x, y; size: sz, sz; color: dk.ink; show: k > 1.5 and k < 2.5 }
        figure i_fog { at: x, y; size: sz, sz; color: dk.ink; show: k > 2.5 and k < 3.5 }
        figure i_rain { at: x, y; size: sz, sz; color: dk.acc; show: k > 3.5 and k < 4.5 }
        figure i_snow { at: x, y; size: sz, sz; color: dk.ink; show: k > 4.5 and k < 5.5 }
        figure i_storm { at: x, y; size: sz, sz; color: dk.hot; show: k > 5.5 }
    }
    // ── A card on the deck (D125): one wrapper for all eleven ──
    // Its place glides when it moves (its own spring), it rises in from the deck's open side, it
    // follows the hand while carried, and what it shows is the copy's block (`children`). While
    // arranging it wears its frame: MOVE to carry it, × to hide it, the s/m/l size and, on the canvas,
    // a corner to pull it to any size. Each move asks the logic where it would settle (dk_drag,
    // dk_sizing: 1000000 · code + 1000 · x/4 + y/4, exact in a float32), drawn as the landing.
    component Part(code: number, on: bool, x: number, y: number, w: number, h: number, rise: number,
                   n: text, word: text, meta: text, lamp: number, sz: text) {
        size: w, h
        prop px = 0 ~m.reflow
        follow px = x
        prop py = 0 ~m.reflow
        follow py = y
        let held = if(dk_gid == code, 1, 0)
        group {
            show: on
            move: px + dk_gdx * held - dk_ox * (1 - rise) * 34, py + dk_gdy * held - dk_oy * (1 - rise) * 34
            opacity: smooth(0, 1, rise)
            Card(w, h, held)
            PartHead(w, n, word, meta, lamp: lamp)
            children
            zone box eg { from: w - 122, 8; size: 82, 20; cursor: grab; role: button; label: "Move {word}"; active: dk_edit }
            zone box ee { from: w - 34, 8; size: 24, 20; cursor: pointer; role: button; label: "Hide {word}"; active: dk_edit }
            zone box es { from: w - 166, 8; size: 38, 20; cursor: pointer; role: button; label: "Resize {word}"; active: dk_edit }
            zone box er { from: w - 22, h - 22; size: 22, 22; cursor: nwse_resize; role: button; label: "Resize {word} freely"; active: dk_edit and dk_canvas }
            group {
                show: ed_in > 0.01
                opacity: ed_in
                box { from: 4, 4; size: w - 8, h - 8; corner: dk.r; color: dk.acc; opacity: 0.05 + 0.06 * eg.hover }
                box { from: 4, 4; size: w - 8, h - 8; corner: dk.r; stroke: 1.2; color: dk.acc; opacity: 0.5 + 0.5 * max(held, eg.hover) }
                // the grip: six dots, and the word
                box { from: w - 122, 8; size: 82, 20; corner: 10; color: mix(dk.well, dk.acc, 0.25 + 0.35 * eg.hover) }
                repeat g in 0..6 {
                    ellipse { at: w - 112 + mod(g, 2) * 5, 13 + floor(g / 2) * 5; radius: 1.3; color: dk.acc }
                }
                text "MOVE" { at: w - 76, 18.5; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: dk.acc }
                box { from: w - 34, 8; size: 24, 20; corner: 10; color: mix(dk.well, dk.hot, 0.2 + 0.4 * ee.hover) }
                text "×" { at: w - 22, 18; anchor: center; align: center; size: 13; color: dk.hot }
                box { from: w - 166, 8; size: 38, 20; corner: 10; color: mix(dk.well, dk.acc, 0.25 + 0.35 * es.hover) }
                text "⇔ {sz}" { at: w - 147, 18.5; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: dk.acc }
                group {
                    show: dk_canvas
                    line { from: w - 16, h - 5; to: w - 5, h - 16; width: 1.4; color: mix(dk.line, dk.acc, 0.4 + 0.6 * er.hover) }
                    line { from: w - 10, h - 5; to: w - 5, h - 10; width: 1.4; color: mix(dk.line, dk.acc, 0.4 + 0.6 * er.hover) }
                }
            }
            // the size in the hand while the corner is pulled (the landing shows where it settles)
            box { from: 0, 0; size: max(168, w + dk_rdx), max(96, h + dk_rdy); corner: dk.r; stroke: 1.4; color: dk.acc; opacity: 0.6; show: dk_rid == code }
        }
        on press es { emit dk_size(code) }
        on press ee { emit dk_hide(code) }
        on drag eg while dk_edit {
            dk_gid = code; dk_gdx = drag.dx; dk_gdy = drag.dy
            emit dk_drag(code * 1000000 + min(999, round(max(0, px + drag.dx + w / 2) / 4)) * 1000 + min(999, round(max(0, py + drag.dy + h / 2) / 4)))
        }
        on release eg while dk_edit and dk_gid == code {
            emit dk_drop(code * 1000000 + min(999, round(max(0, px + dk_gdx + w / 2) / 4)) * 1000 + min(999, round(max(0, py + dk_gdy + h / 2) / 4)))
            // where the hand left it, so it glides from there to where it settles (not back first)
            px: px + dk_gdx ~0ms
            py: py + dk_gdy ~0ms
            dk_gid = -1; dk_gdx = 0; dk_gdy = 0
        }
        on drag er while dk_edit and dk_canvas {
            dk_rid = code; dk_rdx = drag.dx; dk_rdy = drag.dy
            emit dk_sizing(code * 1000000 + min(999, round(max(1, w + drag.dx) / 4)) * 1000 + min(999, round(max(1, h + drag.dy) / 4)))
        }
        on release er while dk_rid == code {
            emit dk_resize(code * 1000000 + min(999, round(max(1, w + dk_rdx) / 4)) * 1000 + min(999, round(max(1, h + dk_rdy) / 4)))
            dk_rid = -1; dk_rdx = 0; dk_rdy = 0
        }
    }

    // the bars' pitch along the deck's open side: one bar each of (nexus.bars) across its length

    // ── The deck's frame: its outline is the visualiser ──────────
    // The deck is one plate. Its open side (the one facing the desktop) carries the visualiser: bars
    // cut from its own border, standing on that line and lifting with the music, filled with the
    // deck's own hull and stroked with its own edge. They break where the notches leave the deck and
    // go on round each notch's outer face (the notch group below), so the border is followed all the
    // way round. At rest every bar is 0 tall and it is the plain border it always was.
    // `children` is the deck's content, clipped to it as IslandFrame clipped it.
    component DeckFrame(w: number, h: number) {
        size: w, h
        let r = if(cn_kind > 2.5, 0, (st_radius + 6) * cn_scale)
        let edgec = mix(fl.trace, mix(dk.t_border_subtle, dk.t_accent_primary, 0.35), isl_style)
        let topc = mix(fl.hull, mix(dk.t_surface_elevated, dk.t_accent_primary, 0.05), isl_style)
        let botc = mix(fl.hull, dk.t_bg_primary, isl_style)
        // the plate's own colour where the bars leave it: the gradient's end their edge lies on
        let fillc = mix(topc, botc, if(dk_edge == 1, 1, 0))

        // the plate, as one body (under the chassis the frame draws it, D152)
        body {
            show: not ch_on
            gradient: 0, 0 to 0, h, topc, botc
            shadow: 0, 7, 24, 44%
            box { from: 0, 0; size: w, h; corner: r }
        }
        // its edge, the plain line the bars stand on and cover where they rise
        path { show: not ch_on; stroke: 1; color: edgec
               move r, 0; line w - r, 0; curve w, r via w, 0; line w, h - r; curve w - r, h via w, h
               line r, h; curve 0, h - r via 0, h; line 0, r; curve r, 0 via 0, 0 }

        // the deck's two short sides: the border lifts there too, so the music is round the plate
        // and not only on its open edge. (The other long side is the screen's own edge.)

        // the open side, in the stretches the notches leave free (or all of it with them off)

        // the lit run along the top when the top is not the open side (a bottom deck's is)
        group {
            show: dk_edge != 0
            glow: 5, mix(0.8, 0.5, isl_style) * st_glow, mix(fl.phos, dk.t_accent_primary, isl_style)
            line { from: r + 2, 0.75; to: w - r - 1, 0.75; width: 1.2; color: mix(fl.phos, dk.t_accent_primary, isl_style); opacity: mix(0.85, 0.5, isl_style) }
        }
        group {
            clip box { from: 0, 0; size: w, h; corner: r }
            children
        }
    }

    surface nexus {
        // the whole screen: where nothing is drawn a press goes through to what is under it
        size: full, full
        anchor: top_left
        level: overlay
        keyboard: on_demand
        // the program stays running while the Nexus is away (D118): the surface is there only while
        // it is open or still sliding out, so nothing of it takes a press or a key when it is gone
        open: dk_open or nx_in > 0.004 or nm_rv > 0.002

        on key Escape while dk_naming { dk_naming = false; blur }
        on key Escape while not dk_naming and dk_edit { emit dk_edit_on(0) }
        on key Escape while not dk_naming and not dk_edit { emit nx_close }

        // ═══ The deck ═══
        // Under the chassis (D152) the frame draws the deck's body, grown out of the band along its edge
        // (shell/mooi-frame.plm, the `dk` place); here only its content, clipped to the same shape from the
        // same numbers, riding its leading edge, fading in over the first third.
        let nm_hz = dk_edge >= 2
        let nm_W = screen.width
        let nm_H = screen.height + nm_off
        let nm_X = dk_x
        let nm_Y = dk_y + nm_off
        let nm_sx = if(dk_edge == 3, nm_W - nm_band - 12, if(dk_edge == 2, nm_band, nm_X + dk_w * 0.35))
        let nm_sw = if(nm_hz, 12, dk_w * 0.3)
        let nm_sy = if(dk_edge == 0, nm_H - nm_band - 12, if(dk_edge == 1, nm_band, nm_Y + dk_h * 0.35))
        let nm_sh = if(nm_hz, dk_h * 0.3, 12)
        let nm_px = if(nm_hz, nm_rv * nm_rv, nm_rv)
        let nm_py = if(nm_hz, nm_rv, nm_rv * nm_rv)
        let nm_bx = nm_sx + (nm_X - nm_sx) * nm_px
        let nm_bw = nm_sw + (dk_w - nm_sw) * nm_px
        let nm_by = nm_sy + (nm_Y - nm_sy) * nm_py
        let nm_bh = nm_sh + (dk_h - nm_sh) * nm_py
        let nm_br = min(min(nm_bw, nm_bh) / 2, 6 + (14 - 6) * nm_rv)
        // the content's shift: its leading edge on the body's
        let nm_ox = if(dk_edge == 3, nm_bx - nm_X, if(dk_edge == 2, nm_bx + nm_bw - nm_X - dk_w, 0))
        let nm_oy = if(dk_edge == 0, nm_by - nm_Y, if(dk_edge == 1, nm_by + nm_bh - nm_Y - dk_h, 0))
        // the notch tabs stand outside the deck (D157: the clip had cut them off since D152b): as the
        // body settles the clip opens past it by their reach, so they rise out of the deck's edge
        let nm_m = 56 * smooth(0.86, 1, nm_rv)
        group {
            move: dk_x + if(ch_on, nm_ox, dk_ox * (1 - nx_in) * (dk_w + 40)), dk_y + if(ch_on, nm_oy, dk_oy * (1 - nx_in) * (dk_h + 40))
            opacity: if(ch_on, smooth(0.08, 0.38, nm_rv * nm_rv), smooth(0, 0.5, nx_in))
            clip box { from: if(ch_on, nm_bx - nm_X - nm_ox - nm_m, -4000), if(ch_on, nm_by - nm_Y - nm_oy - nm_m, -4000); size: if(ch_on, max(1, nm_bw + 2 * nm_m), 8000), if(ch_on, max(1, nm_bh + 2 * nm_m), 8000); corner: if(ch_on, nm_br, 0) }
            zone box deck { from: 0, 0; size: dk_w, dk_h; role: region; label: "The Control Nexus" }

            DeckFrame(dk_w, dk_h) {
                // registration marks at the deck's corners
                repeat c in 0..4 {
                    let rx.$c = if(mod(c, 2) == 0, 4, dk_w - 4)
                    let ry.$c = if(c < 2, 4, dk_h - 4)
                    let sx.$c = if(mod(c, 2) == 0, 1, -1)
                    let sy.$c = if(c < 2, 1, -1)
                    line { from: rx.$c, ry.$c; to: rx.$c + 10 * sx.$c, ry.$c; width: 1.2; color: dk.acc; opacity: 0.55 }
                    line { from: rx.$c, ry.$c; to: rx.$c, ry.$c + 10 * sy.$c; width: 1.2; color: dk.acc; opacity: 0.55 }
                }

                // ── The rail: the circuit's bus, the time, ✎ and the ways out ──
                // the bus: a trace along the rail, its pads where each card is wired to it
                line { from: 8, 23; to: dk_w - 8, 23; width: 1.4; color: dk.acc; opacity: 0.55 }
                line { from: 8, 26; to: dk_w * 0.3, 26; width: 1; color: dk.acc; opacity: 0.25 }
                group {
                    show: scan > 0.01 and scan < 0.99
                    glow: 8, 0.9 * st_glow, dk.acc
                    ellipse { at: 8 + scan * (dk_w - 16), 23; radius: 3; color: dk.acc }
                }
                text "CONTROL NEXUS" { at: 14, 12; anchor: left center; size: 10; weight: 700; family: "Share Tech Mono"; color: dk.acc }
                text clock.date { at: 118, 12; anchor: left center; size: 10; family: "Share Tech Mono"; color: dk.mute; show: dk_w >= 560 }
                // the traces from each card's lamp up to the bus, a via where they meet; and between neighbours
                // lit as the cards they join come online (D154): not lines standing in an empty deck
                for nd in nodes {
                    line { from: nd.x, nd.y - 6; to: nd.bx, nd.by + 7; width: 1.4; color: dk.acc; opacity: 0.6 * clamp(rp.2 * 1.5 - 0.5, 0, 1) }
                    group {
                        glow: 5, 0.6 * st_glow, dk.acc
                        ellipse { at: nd.bx, nd.by + 7; radius: 2.6; color: dk.acc }
                    }
                    ellipse { at: nd.bx, nd.by + 7; radius: 4.6; stroke: 1; color: dk.acc; opacity: 0.5 }
                }
                // between neighbours: out of one card, down the gap, into the next, a via at each turn
                for tr in traces {
                    line { from: tr.x1, tr.y1; to: tr.x2, tr.y2; width: 1.4; color: dk.acc; opacity: 0.6 * clamp(rp.4 * 1.5 - 0.5, 0, 1) }
                    ellipse { at: tr.x2, tr.y2; radius: 1.8; color: dk.acc; opacity: 0.8 * clamp(rp.4 * 1.5 - 0.5, 0, 1) }
                }
                group {
                    move: dk_w - 168, 0
                    text clock.time { at: 26, 12; anchor: right center; size: 11; family: "Share Tech Mono"; color: dk.ink2; show: not dk_caution }
                    group {
                        show: dk_caution
                        glow: 7, 0.9 * st_glow, dk.alert
                        box { from: -40, 4; size: 68, 16; corner: 2; color: dk.alert; opacity: 0.18 }
                        box { from: -40, 4; size: 68, 16; corner: 2; stroke: 1.2; color: dk.alert }
                        text dk_caution_t { at: -6, 12.5; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: dk.alert; width: 64; lines: 1 }
                    }
                    // and, to their left, Hyprland: its config again, then the bar on it (bin/mooi
                    // restart-hypr). A press is not the end of anything: windows stay open
                    zone box hyr { from: -58, 1; size: 24, 22; cursor: pointer; role: button; label: "Restart Hyprland and the bar" }
                    box { from: -58, 2; size: 22, 19; corner: if(isl_style > 0.5, 6, 2); color: dk.well; opacity: 0.7 * hyr.hover }
                    text "↻" { at: -47, 12; anchor: center; align: center; size: 13; color: mix(dk.ink2, dk.acc, hyr.hover) }
                    on press hyr { emit nx_go(60) }
                    repeat b in 0..5 {
                        zone box hb.$b { from: 34 + b * 26, 1; size: 24, 22; cursor: pointer; role: button
                                         label: pick(b, "Arrange the deck", "mooi's settings", "Lock the screen", "The session menu", "Close the Nexus") }
                        box { from: 35 + b * 26, 2; size: 22, 19; corner: if(isl_style > 0.5, 6, 2); color: if(b == 0 and dk_edit, dk.acc, dk.well); opacity: if(b == 0 and dk_edit, 0.9, 0.7 * hb.$b.hover) }
                    }
                    text "✎" { at: 46, 12; anchor: center; align: center; size: 12; color: if(dk_edit, dk.well, mix(dk.ink2, dk.acc, hb.0.hover)) }
                    figure i_set { at: 72, 12; size: 12, 12; color: mix(dk.ink2, dk.acc, hb.1.hover) }
                    figure i_lock { at: 98, 12; size: 12, 12; color: mix(dk.ink2, dk.acc, hb.2.hover) }
                    figure i_power { at: 124, 12; size: 12, 12; color: mix(dk.ink2, dk.hot, hb.3.hover) }
                    text "×" { at: 150, 12; anchor: center; align: center; size: 15; color: mix(dk.mute, dk.ink, hb.4.hover) }
                    on press hb.0 { emit dk_edit_on(if(dk_edit, 0, 1)) }
                    on press hb.1 { emit nx_go(1) }
                    on press hb.2 { emit nx_go(2) }
                    on press hb.3 { emit nx_go(3) }
                    on press hb.4 { emit nx_close }
                }

                // ── This window ──
                Part(0, pw_on, pw_x, pw_y, pw_w, pw_h, rp.0, pw_n, "This window", "", lp_w, pw_sz) {
                    group {
                        show: w_ok
                        box { from: 14, 34; size: 42, 42; corner: if(isl_style > 0.5, 10 * cn_scale, 2); color: mix(dk.well, dk.acc, 0.24) }
                        box { from: 14, 34; size: 42, 42; corner: if(isl_style > 0.5, 10 * cn_scale, 2); stroke: 1; color: dk.acc; opacity: 0.7 }
                        line { from: 18, 72; to: 52, 72; width: 2; color: dk.acc; opacity: 0.5 }
                        text w_initial { at: 35, 54; anchor: center; align: center; size: 18; weight: 700; family: "Exo 2"; color: dk.acc }
                        text w_app { at: 66, 46; anchor: left center; size: 14; weight: 600; family: "Exo 2"; color: dk.ink; width: pw_w - 80; lines: 1 }
                        text w_title { at: 66, 64; anchor: left center; size: 10; family: "Exo 2"; color: dk.ink2; width: pw_w - 80; lines: 1 }
                        text w_where { at: 14, 90; anchor: left center; size: 10; family: "Share Tech Mono"; color: dk.mute; width: pw_w - 28; lines: 1 }
                        text "SOUND" { at: 14, 108; anchor: left center; size: 10; family: "Share Tech Mono"; color: dk.mute }
                        group {
                            show: w_snd
                            zone box wsz { from: 60, 100; size: pw_w - 112, 16; cursor: pointer; role: slider; value: w_vol; label: "{w_app} volume" }
                            box { from: 60, 106; size: pw_w - 112, 4; corner: 2; color: dk.well }
                            group {
                                glow: 5, 0.45 * st_glow, dk.acc
                                box { from: 60, 106; size: (pw_w - 112) * clamp(w_vol, 0, 1), 4; corner: 2; color: dk.acc }
                            }
                            ellipse { at: 60 + (pw_w - 112) * clamp(w_vol, 0, 1), 108; radius: 4.5 + wsz.hover; color: dk.ink }
                            text "{round(w_vol * 100), 0}%" { at: pw_w - 14, 108; anchor: right center; size: 10; family: "Share Tech Mono"; color: dk.ink2 }
                            on press wsz { emit dk_level(9000 + round(clamp((local.x - 60) / (pw_w - 112), 0, 1) * 1000)) }
                            on drag wsz { emit dk_level(9000 + round(clamp((local.x - 60) / (pw_w - 112), 0, 1) * 1000)) }
                            on scroll wsz { emit dk_level(9000 + round(clamp(w_vol + wheel * 0.05, 0, 1) * 1000)) }
                        }
                        text "plays nothing" { at: 60, 108; anchor: left center; size: 10; family: "Share Tech Mono"; color: dk.mute; show: not w_snd }
                        let aw = (pw_w - 28 - 3 * 6) / 4
                        repeat a in 0..4 {
                            let ax.$a = 14 + a * (aw + 6)
                            let alit.$a = pick(a, w_floating, w_full, w_pinned, 0)
                            zone box wa.$a { from: ax.$a, 124; size: aw, 24; cursor: pointer; role: button; label: pick(a, "Float {w_app}", "Fullscreen {w_app}", "Pin {w_app}", "Close {w_app}") }
                            box { from: ax.$a, 124; size: aw, 24; corner: dk.r; color: if(alit.$a, mix(dk.well, dk.acc, 0.18), dk.well); opacity: 0.92 }
                            box { from: ax.$a, 124; size: aw, 24; corner: dk.r; stroke: 1; color: if(a == 3, mix(dk.line, dk.hot, 0.4 + 0.6 * wa.$a.hover), if(alit.$a, dk.acc, mix(dk.line, dk.acc, 0.6 * wa.$a.hover))) }
                            text pick(a, "FLOAT", "FULL", "PIN", "CLOSE") { at: ax.$a + aw / 2, 136.5; anchor: center; align: center; size: 9; weight: 700; family: "Share Tech Mono"
                                color: if(a == 3, mix(dk.ink2, dk.hot, wa.$a.hover), if(alit.$a, dk.acc, mix(dk.ink2, dk.ink, wa.$a.hover))) }
                            on press wa.$a { emit dk_win(a) }
                        }
                        text w_note { at: 14, 170; anchor: left center; size: 10; family: "Share Tech Mono"; color: dk.ink2; width: pw_w - 28; lines: 1; show: w_noted and pw_h > 180 }
                    }
                    group {
                        show: not w_ok
                        figure i_window { at: pw_w / 2, pw_h / 2 - 8; size: 26, 26; color: dk.mute }
                        text "NO WINDOW HERE" { at: pw_w / 2, pw_h / 2 + 20; anchor: center; align: center; size: 10; family: "Share Tech Mono"; color: dk.mute }
                    }
                }

                // ── Workspaces ──
                Part(1, ps_on, ps_x, ps_y, ps_w, ps_h, rp.1, ps_n, "Workspaces", "POINT TO LOOK IN · DRAG A WINDOW TO MOVE IT", lp_s, ps_sz) {
                    zone box wsbay { from: 0, 0; size: ps_w, ps_h; role: region; label: "Workspaces" }
                    for t in tiles {
                        zone box tlz { from: t.x, t.y; size: t.w, t.h + 16; cursor: pointer; role: item; selected: t.active
                                       label: pick(t.plus, "Workspace {t.id}", "A new workspace") }
                        group {
                            show: not t.plus
                            group {
                                clip box { from: t.x, t.y; size: t.w, t.h; corner: dk.r }
                                box { from: t.x, t.y; size: t.w, t.h; color: dk.well }
                                image wall { at: t.x, t.y; size: t.w, t.h; opacity: 0.85; show: dk_wall_on }
                                box { from: t.x, t.y; size: t.w, t.h; color: #000000; opacity: if(t.active, 0.12, 0.36 - 0.14 * tlz.hover) }
                            }
                        }
                        group {
                            show: t.plus
                            box { from: t.x, t.y; size: t.w, t.h; corner: dk.r; color: dk.well; opacity: 0.5 + 0.4 * tlz.hover }
                            text "+" { at: t.x + t.w / 2, t.y + t.h / 2; anchor: center; align: center; size: 22; weight: 300; family: "Exo 2"; color: mix(dk.mute, dk.acc, tlz.hover) }
                        }
                        group {
                            glow: 7, if(t.active, 0.6, 0) * st_glow, dk.acc
                            box { from: t.x, t.y; size: t.w, t.h; corner: dk.r; stroke: if(t.active, 1.6, 1)
                                  color: if(t.active, dk.acc, mix(dk.line, dk.acc, tlz.hover + if(dk_hws == t.index, 1, 0))) }
                        }
                        text t.label { at: t.x + 2, t.y + t.h + 9; anchor: left center; size: 10; family: "Share Tech Mono"; color: if(t.active, dk.acc, dk.ink2); width: t.w - 20; lines: 1 }
                        text t.n { at: t.x + t.w - 2, t.y + t.h + 9; anchor: right center; size: 10; family: "Share Tech Mono"; color: dk.mute }
                        group {
                            show: dk_hws == t.index
                            opacity: lk
                            glow: 6, 0.8 * st_glow, dk.acc
                            repeat c in 0..4 {
                                let bx.$c = if(mod(c, 2) == 0, t.x - 4 - (1 - lk) * 10, t.x + t.w + 4 + (1 - lk) * 10)
                                let by.$c = if(c < 2, t.y - 4 - (1 - lk) * 10, t.y + t.h + 4 + (1 - lk) * 10)
                                let bs.$c = if(mod(c, 2) == 0, 1, -1)
                                let bt.$c = if(c < 2, 1, -1)
                                line { from: bx.$c, by.$c; to: bx.$c + 9 * bs.$c, by.$c; width: 1.6; color: dk.acc }
                                line { from: bx.$c, by.$c; to: bx.$c, by.$c + 9 * bt.$c; width: 1.6; color: dk.acc }
                            }
                            text "LOCK" { at: t.x + t.w, t.y - 11; anchor: right center; size: 10; weight: 700; family: "Share Tech Mono"; color: dk.acc; show: lk > 0.9 }
                        }
                        on hover tlz for 260ms while dk_wd < 0 { dk_hws = t.index; emit dk_hov_ws(t.index) }
                        on press tlz { emit dk_ws(t.index) }
                    }
                    // the windows, placed in their tiles by the logic; carried by hand to another one
                    for w in wins {
                        let wl = if(dk_wd == w.index, 1, 0)
                        zone box wz { from: w.x, w.y; size: w.w, w.h; cursor: grab; role: item; label: "A window: drag it to another workspace" }
                        group {
                            move: dk_wdx * wl, dk_wdy * wl
                            glow: 8, 0.8 * wl * st_glow, dk.acc
                            box { from: w.x, w.y; size: w.w, w.h; corner: 1; color: mix(dk.raised, #000000, 0.25); opacity: if(w.pictured, 0.95, 0.72) }
                            image w.pic { at: w.x, w.y; size: w.w, w.h; show: w.pictured }
                            box { from: w.x, w.y; size: w.w, min(5, w.h); color: mix(dk.line, dk.acc, if(w.focused, 0.6, 0)); show: not w.pictured }
                            text "{upper(w.app)}" { at: w.x + w.w / 2, w.y + w.h / 2 + 2; anchor: center; align: center; size: 10; family: "Share Tech Mono"; color: dk.ink2; width: w.w - 6; lines: 1; show: not w.pictured and w.w > 34 and w.h > 18 }
                            box { from: w.x, w.y; size: w.w, w.h; corner: 1; stroke: 1 + wl; color: if(w.focused or wl > 0.5, dk.acc, mix(dk.line, dk.acc, wz.hover)); opacity: 0.95 }
                        }
                        on drag wz { dk_wd = w.index; dk_wdx = drag.dx; dk_wdy = drag.dy; dk_hws = -1 }
                        on release wz { emit dk_wdrop(w.index * 100000000 + round(pointer.x) * 10000 + round(pointer.y)); dk_wd = -1; dk_wdx = 0; dk_wdy = 0 }
                    }
                }

                // ── Mixer ──
                Part(2, pm_on, pm_x, pm_y, pm_w, pm_h, rp.2, pm_n, "Mixer", "", lp_m, pm_sz) {
                    let fh = pm_h - 84
                    let f0 = (pm_w - max(1, faders.count) * 36) / 2 + 18
                    for f in faders {
                        Fader(f, f0 + f.index * 36, 38, fh, dk_level)
                    }
                }

                // ── Quick settings ──
                Part(3, pq_on, pq_x, pq_y, pq_w, pq_h, rp.3, pq_n, "Quick settings", "", lp_q, pq_sz) {
                    // the same restart as the rail's ↻, put where the toggles are
                    group {
                        show: ed_in < 0.01
                        zone box hqr { from: pq_w - 108, 6; size: 94, 24; cursor: pointer; role: button; label: "Restart Hyprland and the bar" }
                        Act(pq_w - 108, 6, 94, "↻ Hyprland", false, false, hqr.hover)
                        on press hqr { emit nx_go(60) }
                        // the desktop widgets' edit mode (D137), beside it
                        zone box hwe { from: pq_w - 208, 6; size: 94, 24; cursor: pointer; role: button; label: "Place the desktop widgets" }
                        Act(pq_w - 208, 6, 94, "✎ Widgets", false, false, hwe.hover)
                        on press hwe { emit nx_go(61) }
                    }
                    let qw = (pq_w - 28 - 3 * 6) / 4
                    for q in quick {
                        let qx = 14 + mod(q.index, 4) * (qw + 6)
                        let qy = 34 + floor(q.index / 4) * 52
                        zone box qz { from: qx, qy; size: qw, 46; cursor: pointer; role: toggle; checked: q.on; label: "{q.word}: {q.state}" }
                        box { from: qx, qy; size: qw, 46; corner: dk.r; color: if(q.on, mix(dk.well, mix(dk.acc, dk.hot, q.hot), 0.18), mix(dk.well, dk.acc, 0.06 * qz.hover)) }
                        box { from: qx, qy; size: qw, 46; corner: dk.r; stroke: 1; color: if(q.on, mix(dk.line, mix(dk.acc, dk.hot, q.hot), 0.75), mix(dk.line, dk.acc, 0.6 * qz.hover)) }
                        group {
                            glow: 6, if(q.on, 0.7, 0) * st_glow, mix(dk.acc, dk.hot, q.hot)
                            box { from: qx + 8, qy; size: qw - 16, 2; color: mix(dk.acc, dk.hot, q.hot); show: q.on }
                            QGlyph(qx + 15, qy + 33, q.glyph, if(q.on, mix(dk.acc, dk.hot, q.hot), mix(dk.ink2, dk.ink, qz.hover)), 13)
                        }
                        // the name has the tile's whole width (with the glyph beside it, "BLUETOOTH" and
                        // "SCREENSHOT" were cut to "BLUETO…"); the glyph sits with the state below
                        text "{upper(q.word)}" { at: qx + 9, qy + 15.5; anchor: left center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(q.on, mix(dk.acc, dk.hot, q.hot), dk.ink); width: qw - 14; lines: 1 }
                        text q.state { at: qx + 27, qy + 33; anchor: left center; size: 10; family: "Exo 2"; color: if(q.on, dk.ink, dk.mute); width: qw - 32; lines: 1 }
                        on press qz { emit nx_tog(q.code) }
                    }
                }

                // ── Music ──
                Part(4, pu_on, pu_x, pu_y, pu_w, pu_h, rp.4, pu_n, "Music", "", lp_u, pu_sz) {
                    // the cover behind everything, faint, and the song's own visualiser
                    group {
                        show: mus_on and nx_art_on
                        clip box { from: 1, 1; size: pu_w - 2, pu_h - 2; corner: dk.r }
                        image cover { at: 0, (pu_h - pu_w) / 2; size: pu_w, pu_w; opacity: 0.2 }
                        repeat f in 0..5 {
                            box { from: 0, pu_h * f / 5; size: pu_w, pu_h / 5 + 1; color: mix(dk.raised, #000000, 0.5); opacity: 0.25 + f * 0.1 }
                        }
                    }
                    group {
                        show: mus_on
                        // laid out by its own size, not by the deck's edge (D125): short, the controls go up
                        // beside the title and the rest tightens, but nothing is left out
                        let ucomp = pu_h < 196
                        let ua = if(ucomp, 64, 84)
                        let utw = pu_w - 14 - 14 - ua - 14 - if(ucomp, 108, 0)
                        let ux = 14 + ua + 14
                        zone box uart { from: 14, 34; size: ua, ua; cursor: pointer; role: button; label: "Open the music player" }
                        body {
                            color: dk.well
                            shadow: 0, 6, 16, 50%
                            box { from: 14, 34; size: ua, ua; corner: dk.r }
                        }
                        image cover { at: 14, 34; size: ua, ua; show: nx_art_on }
                        figure i_music { at: 14 + ua / 2, 34 + ua / 2; size: 22, 22; color: dk.mute; show: not nx_art_on }
                        box { from: 14, 34; size: ua, ua; corner: dk.r; stroke: 1; color: mix(dk.line, dk.hot, uart.hover) }
                        on press uart { emit nx_go(20) }
                        text "{upper(med.player)}" { at: ux, 40; anchor: left center; size: 10; weight: 700; family: "Share Tech Mono"; color: dk.hot; width: utw; lines: 1 }
                        text med.title { at: ux, 58; anchor: left center; size: 13; weight: 600; family: "Exo 2"; color: dk.ink; width: utw; lines: 1 }
                        text med.artist { at: ux, 76; anchor: left center; size: 10; family: "Exo 2"; color: dk.ink2; width: utw; lines: 1 }
                        // the song's own visualiser, inside the card (D118: the deck's border no longer moves)
                        let vbase = if(ucomp, 96, 112)
                        let vtall = if(ucomp, 12, 18)
                        group {
                            glow: 5, 0.5 * st_glow, dk.hot
                            repeat v in 0..16 {
                                let vv.$v = pick(v, dv0, dv1, dv2, dv3, dv4, dv5, dv6, dv7, dv8, dv9, dv10, dv11, dv12, dv13, dv14, dv15)
                                box { from: ux + v * ((pu_w - ux - 14) / 16), vbase - vtall * clamp(vv.$v, 0.04, 1); size: max(2, (pu_w - ux - 14) / 16 - 2), vtall * clamp(vv.$v, 0.04, 1); corner: 1; color: dk.hot; opacity: 0.45 + 0.55 * vv.$v }
                            }
                        }
                        let uy = if(ucomp, 108, 134)
                        let upx = 14
                        box { from: upx, uy; size: pu_w - upx - 14, 3; corner: 1; color: dk.well }
                        group {
                            glow: 5, 0.6 * st_glow, dk.hot
                            box { from: upx, uy; size: (pu_w - upx - 14) * clamp(rc_song, 0, 1), 3; corner: 1; color: dk.hot }
                        }
                        ellipse { at: upx + (pu_w - upx - 14) * clamp(rc_song, 0, 1), uy + 1.5; radius: 3; color: dk.ink }
                        text nx_elapsed { at: upx, uy + 12; anchor: left center; size: 10; family: "Share Tech Mono"; color: dk.mute; show: pu_h >= uy + 22 }
                        text nx_length { at: pu_w - 14, uy + 12; anchor: right center; size: 10; family: "Share Tech Mono"; color: dk.mute; show: pu_h >= uy + 22 }
                        let ucx = if(ucomp, pu_w - 60, pu_w / 2)
                        let ucy = if(ucomp, 58, 176)
                        zone box mb.0 { from: ucx - 46, ucy - 14; size: 28, 28; cursor: pointer; role: button; label: "Previous" }
                        zone box mb.1 { from: ucx - 14, ucy - 14; size: 28, 28; cursor: pointer; role: button; label: "Play or pause" }
                        zone box mb.2 { from: ucx + 18, ucy - 14; size: 28, 28; cursor: pointer; role: button; label: "Next" }
                        box { from: ucx - 14, ucy - 14; size: 28, 28; corner: if(isl_style > 0.5, 14, 2); color: mix(dk.well, dk.hot, 0.18 + 0.2 * mb.1.hover) }
                        box { from: ucx - 14, ucy - 14; size: 28, 28; corner: if(isl_style > 0.5, 14, 2); stroke: 1; color: dk.hot }
                        text "⏮" { at: ucx - 32, ucy; anchor: center; align: center; size: 13; color: mix(dk.ink2, dk.ink, mb.0.hover) }
                        text pick(med.playing, "▶", "⏸") { at: ucx, ucy; anchor: center; align: center; size: 14; color: mix(dk.hot, dk.ink, mb.1.hover) }
                        text "⏭" { at: ucx + 32, ucy; anchor: center; align: center; size: 13; color: mix(dk.ink2, dk.ink, mb.2.hover) }
                        on press mb.0 { emit nx_media(0) }
                        on press mb.1 { emit nx_media(1) }
                        on press mb.2 { emit nx_media(2) }
                    }
                    group {
                        show: not mus_on
                        zone box mopen { from: 14, 34; size: pu_w - 28, pu_h - 48; cursor: pointer; role: button; label: "Open the music player" }
                        figure i_music { at: pu_w / 2, pu_h / 2 - 4; size: 26, 26; color: mix(dk.mute, dk.acc, mopen.hover) }
                        text "NOTHING PLAYING · OPEN THE PLAYER" { at: pu_w / 2, pu_h / 2 + 24; anchor: center; align: center; size: 10; family: "Share Tech Mono"; color: mix(dk.mute, dk.acc, mopen.hover) }
                        on press mopen { emit nx_go(20) }
                    }
                }

                // ── Machine ──
                Part(5, pc_on, pc_x, pc_y, pc_w, pc_h, rp.5, pc_n, "Machine", m_up_t, lp_c, pc_sz) {
                    zone box mcz { from: 0, 30; size: pc_w, pc_h - 30; cursor: pointer; role: button; label: "The machine: open btop" }
                    on press mcz { emit nx_go(10) }
                    // two graphs side by side when the card is short, one over the other when it is tall (its own shape, D125)
                    let mside = pc_h < 190
                    let spw = if(mside, (pc_w - 42) / 2, pc_w - 28)
                    repeat r in 0..2 {
                        let sx.$r = if(mside, 14 + r * (spw + 14), 14)
                        let sy.$r = if(mside, 36, 36 + r * 52)
                        let hot.$r = pick(r, m_cpu > 0.85 or m_temp > 85, m_mem > 0.9)
                        figure i_cpu { at: sx.$r + 6, sy.$r + 6; size: 11, 11; color: dk.mute; show: r == 0 }
                        figure i_ram { at: sx.$r + 6, sy.$r + 6; size: 11, 11; color: dk.mute; show: r == 1 }
                        text pick(r, "CPU", "MEMORY") { at: sx.$r + 16, sy.$r + 6; anchor: left center; size: 8.5; weight: 700; family: "Share Tech Mono"; color: dk.mute }
                        text pick(r, m_cpu_t, m_mem_t) { at: sx.$r + spw, sy.$r + 6; anchor: right center; size: 12; weight: 600; family: "Exo 2"; color: if(hot.$r, dk.hot, dk.ink) }
                        box { from: sx.$r, sy.$r + 14; size: spw, 28; corner: dk.r; color: dk.well; opacity: 0.8 }
                        repeat g in 1..4 {
                            line { from: sx.$r, sy.$r + 14 + 7 * g; to: sx.$r + spw, sy.$r + 14 + 7 * g; width: 1; color: dk.line; opacity: 0.25 }
                        }
                    }
                    // each second a bar, the newest on the right; the top of each lit
                    let bw = spw / 40
                    for p in sp_cpu {
                        box { from: 14 + p.x2 * (spw - bw), 50 + (1 - max(0.04, p.y2)) * 26; size: max(1, bw - 1), max(0.04, p.y2) * 26; color: if(m_cpu > 0.85, dk.hot, dk.acc); opacity: 0.25 + 0.5 * p.x2 }
                        box { from: 14 + p.x2 * (spw - bw), 50 + (1 - max(0.04, p.y2)) * 26; size: max(1, bw - 1), 1.5; color: if(m_cpu > 0.85, dk.hot, dk.acc) }
                    }
                    for p in sp_mem {
                        box { from: if(mside, 28 + spw, 14) + p.x2 * (spw - bw), if(mside, 50, 102) + (1 - max(0.04, p.y2)) * 26; size: max(1, bw - 1), max(0.04, p.y2) * 26; color: if(m_mem > 0.9, dk.hot, dk.acc); opacity: 0.25 + 0.5 * p.x2 }
                        box { from: if(mside, 28 + spw, 14) + p.x2 * (spw - bw), if(mside, 50, 102) + (1 - max(0.04, p.y2)) * 26; size: max(1, bw - 1), 1.5; color: if(m_mem > 0.9, dk.hot, dk.acc) }
                    }
                    let my = if(mside, 100, 152)
                    let mw = (pc_w - 28) / 3
                    Reading(14, my, mw, "Heat", m_temp_t, clamp((m_temp - 30) / 70, 0, 1), m_temp > 85)
                    Reading(14 + mw, my, mw, "Disk", m_disk_t, m_disk, m_disk > 0.9)
                    Reading(14 + 2 * mw, my, mw, "Battery", m_bat_t, m_bat, m_bat_hot)
                }

                // ── Today ──
                Part(6, pt_on, pt_x, pt_y, pt_w, pt_h, rp.6, pt_n, "Today", clock.time, lp_t, pt_sz) {
                    zone box tdz { from: 0, 30; size: pt_w, pt_h - 30; cursor: pointer; role: button; label: "The calendar" }
                    on press tdz { emit nx_go(11) }
                    text td_day { at: 12, 62; anchor: left center; size: 40; weight: 300; family: "Exo 2"; color: dk.ink }
                    text td_week { at: 70, 52; anchor: left center; size: 10; weight: 700; family: "Share Tech Mono"; color: dk.acc }
                    text td_month { at: 70, 68; anchor: left center; size: 10; family: "Exo 2"; color: dk.ink2 }
                    group {
                        show: wx_ok
                        WGlyph(pt_w - 30, 50, 22, wx_kind)
                        text wx_t { at: pt_w - 46, 50; anchor: right center; size: 15; weight: 600; family: "Exo 2"; color: dk.ink }
                        text wx_word { at: pt_w - 14, 72; anchor: right center; size: 10; family: "Share Tech Mono"; color: dk.mute; width: pt_w - 120; lines: 1; align: right }
                    }
                    let dyy = pt_h - 46
                    let dcw = (pt_w - 28) / 7
                    for dd in days {
                        let dx = 14 + dd.index * dcw
                        box { from: dx + 1, dyy; size: dcw - 2, 34; corner: dk.r; color: if(dd.today, mix(dk.well, dk.acc, 0.22), dk.well); opacity: if(dd.today, 1, 0.55) }
                        box { from: dx + 1, dyy; size: dcw - 2, 34; corner: dk.r; stroke: 1; color: dk.acc; show: dd.today }
                        text dd.label { at: dx + dcw / 2, dyy + 10; anchor: center; align: center; size: 10; family: "Share Tech Mono"; color: if(dd.today, dk.acc, dk.mute) }
                        text "{dd.day, 0}" { at: dx + dcw / 2, dyy + 24; anchor: center; align: center; size: 11; weight: 600; family: "Exo 2"; color: if(dd.today, dk.ink, dk.ink2) }
                    }
                }

                // ── Profile ──
                Part(7, pf_on, pf_x, pf_y, pf_w, pf_h, rp.7, pf_n, "Profile", "", lp_f, pf_sz) {
                    // the banner across the top (your picture, or a circuit of the deck's own), you over its edge
                    let bnh = pf_h * if(nx_large, 0.5, 0.46)
                    let av = if(nx_large, 74, 54)
                    zone box pfb { from: 0, 0; size: pf_w, bnh; cursor: pointer; role: button; label: "Change the banner" }
                    group {
                        clip box { from: 1, 1; size: pf_w - 2, bnh; corner: dk.r }
                        box { from: 0, 0; size: pf_w, bnh; color: mix(dk.well, dk.acc, 0.22) }
                        repeat g in 0..14 {
                            line { from: g * 28 - 20, bnh; to: g * 28 + 30, 0; width: 1; color: dk.acc; opacity: 0.12 }
                        }
                        image banner { at: 0, (bnh - pf_w * 0.5625) / 2; size: pf_w, pf_w * 0.5625; show: nx_banner_on }
                        repeat f in 0..5 {
                            box { from: 0, bnh * (0.5 + f * 0.1); size: pf_w, bnh * 0.1 + 1; color: mix(dk.raised, #000000, 0.45); opacity: 0.12 + f * 0.16 }
                        }
                        text "CHANGE BANNER" { at: pf_w - 12, 14; anchor: right center; size: 10; weight: 700; family: "Share Tech Mono"; color: #ffffff; opacity: 0.9 * pfb.hover }
                    }
                    on press pfb { emit nx_pick(1) }
                    zone box pfa { from: 12, bnh - av * 0.5; size: av, av; cursor: pointer; role: button; label: "Change your picture" }
                    body {
                        color: mix(dk.well, dk.acc, 0.2)
                        shadow: 0, 4, 14, 55%
                        box { from: 12, bnh - av * 0.5; size: av, av; corner: if(isl_style > 0.5, av / 2, 4 * cn_scale) }
                    }
                    group {
                        clip box { from: 12, bnh - av * 0.5; size: av, av; corner: if(isl_style > 0.5, av / 2, 4 * cn_scale) }
                        image avatar { at: 12, bnh - av * 0.5; size: av, av; show: nx_avatar_on }
                    }
                    text nx_initial { at: 12 + av / 2, bnh; anchor: center; align: center; size: 22; weight: 700; family: "Exo 2"; color: dk.acc; show: not nx_avatar_on and not nx_large }
                    text nx_initial { at: 12 + av / 2, bnh; anchor: center; align: center; size: 30; weight: 700; family: "Exo 2"; color: dk.acc; show: not nx_avatar_on and nx_large }
                    group {
                        glow: 6, (0.5 + 0.5 * pfa.hover) * st_glow, dk.acc
                        box { from: 12, bnh - av * 0.5; size: av, av; corner: if(isl_style > 0.5, av / 2, 4 * cn_scale); stroke: 1.6; color: dk.acc }
                    }
                    on press pfa { emit nx_pick(0) }
                    text pick(nx_noticed, nx_name, nx_notice) { at: 22 + av, bnh + 13; anchor: left center; size: 14; weight: 600; family: "Exo 2"; color: if(nx_noticed, dk.acc, dk.ink); width: pf_w - av - 34; lines: 1; show: not nx_large }
                    text pick(nx_noticed, nx_name, nx_notice) { at: 22 + av, bnh + 18; anchor: left center; size: 19; weight: 600; family: "Exo 2"; color: if(nx_noticed, dk.acc, dk.ink); width: pf_w - av - 34; lines: 1; show: nx_large }
                    text nx_who { at: 22 + av, bnh + if(nx_large, 38, 29); anchor: left center; size: 10; family: "Share Tech Mono"; color: dk.mute; width: pf_w - av - 34; lines: 1 }
                    let pfy = pf_h - 24
                    line { from: 12, pfy - 10; to: pf_w - 12, pfy - 10; width: 1; color: dk.line; opacity: 0.6 }
                    figure i_cpu { at: 18, pfy + 3; size: 10, 10; color: dk.mute }
                    text m_up_t { at: 28, pfy + 3; anchor: left center; size: 10; family: "Share Tech Mono"; color: dk.ink2; width: pf_w - 120; lines: 1 }
                    text "{tiles.count - 1, 0} WS · {wins.count, 0} WIN" { at: pf_w - 12, pfy + 3; anchor: right center; size: 10; family: "Share Tech Mono"; color: dk.acc }
                }

                // ── Scenes ──
                Part(8, pn_on, pn_x, pn_y, pn_w, pn_h, rp.8, pn_n, "Scenes", "ONE PRESS, WHOLE SETUP", lp_n, pn_sz) {
                    zone box scbay { from: 0, 0; size: pn_w, pn_h; role: region; label: "Scenes" }
                    for s in scn {
                        zone box sz { from: s.x, s.y; size: s.w, 24; cursor: pointer; role: button; selected: s.live
                                      label: pick(s.save, "Switch to {s.word}", "Save this setup as a scene") }
                        box { from: s.x, s.y; size: s.w, 24; corner: dk.r; color: if(s.live, mix(dk.well, dk.hot, 0.16), mix(dk.well, dk.acc, 0.14 * sz.hover)); opacity: 0.92 }
                        box { from: s.x, s.y; size: s.w, 24; corner: dk.r; stroke: 1
                              color: if(s.live, dk.hot, mix(dk.line, dk.acc, sz.hover + if(dk_hsc == s.index, 1, 0))); opacity: if(s.save, 0.7, 1) }
                        group {
                            show: s.live
                            glow: 5, 0.7 * st_glow, dk.hot
                            ellipse { at: s.x + 10, s.y + 12; radius: 2.6; color: dk.hot }
                        }
                        box { from: s.x + s.w - 9, s.y + 4; size: 5, 5; corner: 1; color: dk.acc; opacity: 0.8; show: s.env }
                        text "{upper(s.word)}" { at: s.x + s.w / 2 + if(s.live, 5, 0), s.y + 12.5; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"
                                                 color: if(s.live, dk.hot, if(s.save, dk.mute, mix(dk.ink2, dk.ink, sz.hover))); width: s.w - 14; lines: 1 }
                        on hover sz for 220ms while not s.save { dk_hsc = s.index; emit dk_hov_scene(s.index) }
                        on press sz while not s.save { emit dk_scene(s.index) }
                        on press sz while s.save { dk_naming = true; dk_hsc = -1; emit dk_naming_on(s.index); focus dk_name_in }
                        on press right sz while not s.save { emit dk_unscene(s.index) }
                    }
                }

                // ── Waiting ──
                Part(9, pa_on, pa_x, pa_y, pa_w, pa_h, rp.9, pa_n, "Waiting", "", lp_a, pa_sz) {
                    group {
                        clip box { from: 4, 28; size: pa_w - 8, pa_h - 32 }
                        for t in wait {
                            zone box tz { from: t.x, t.y; size: t.w, 26; cursor: pointer; role: button; label: "{t.word}: {t.act}" }
                            box { from: t.x - 4, t.y; size: t.w + 4, 26; corner: dk.r; color: dk.acc; opacity: 0.08 * tz.hover }
                            group {
                                glow: 5, if(t.hot, 0.7, 0) * st_glow, dk.hot
                                ellipse { at: t.x + 4, t.y + 13; radius: 2.6; color: if(t.hot, dk.hot, dk.mute) }
                            }
                            text t.word { at: t.x + 13, t.y + 13.5; anchor: left center; size: 10; family: "Share Tech Mono"; color: mix(dk.ink2, dk.ink, tz.hover); width: t.w - 72; lines: 1 }
                            box { from: t.x + t.w - 54, t.y + 4; size: 52, 18; corner: dk.r; color: if(t.hot, dk.hot, dk.acc); opacity: 0.12 + 0.2 * tz.hover }
                            box { from: t.x + t.w - 54, t.y + 4; size: 52, 18; corner: dk.r; stroke: 1; color: if(t.hot, dk.hot, dk.acc) }
                            text t.act { at: t.x + t.w - 28, t.y + 13.5; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(t.hot, dk.hot, dk.acc) }
                            on press tz { emit dk_wait(t.index) }
                        }
                    }
                }

                // ── Activity ──
                Part(10, py_on, py_x, py_y, py_w, py_h, rp.10, py_n, "Activity", act_t, lp_y, py_sz) {
                    // the last seven days hour by hour (the bar keeps it: activity.json), the apps most used
                    let hc = (py_w - 40 - 23) / 24
                    let hy0 = 34
                    for dd in aday {
                        text dd.label { at: 12, hy0 + dd.index * (hc + 1) + hc / 2; anchor: left center; size: 10; family: "Share Tech Mono"; color: if(dd.index == 6, dk.acc, dk.mute) }
                    }
                    for c in heat {
                        let hx = 30 + mod(c.index, 24) * (hc + 1)
                        let hy = hy0 + floor(c.index / 24) * (hc + 1)
                        box { from: hx, hy; size: hc, hc; corner: 1; color: if(c.v > 0.01, mix(mix(dk.well, dk.acc, 0.25), dk.acc, c.v), dk.well); opacity: if(c.v > 0.01, 0.35 + 0.65 * c.v, 0.6) }
                    }
                    repeat q in 0..5 {
                        text pick(q, "00", "06", "12", "18", "24") { at: 30 + q * 6 * (hc + 1) - if(q == 4, 1, 0), hy0 + 7 * (hc + 1) + 6; anchor: center; align: center; size: 6.5; family: "Share Tech Mono"; color: dk.mute }
                    }
                    let ty0 = hy0 + 7 * (hc + 1) + 18
                    for a in topa {
                        let ay = ty0 + a.index * 16
                        text "{upper(a.word)}" { at: 12, ay + 5; anchor: left center; size: 10; weight: 700; family: "Share Tech Mono"; color: dk.ink2; width: 92; lines: 1 }
                        box { from: 108, ay + 2; size: py_w - 170, 5; corner: 2; color: dk.well }
                        group {
                            glow: 4, 0.4 * st_glow, dk.acc
                            box { from: 108, ay + 2; size: (py_w - 170) * clamp(a.v, 0, 1), 5; corner: 2; color: dk.acc }
                        }
                        text a.t { at: py_w - 12, ay + 5; anchor: right center; size: 10; family: "Share Tech Mono"; color: dk.mute }
                    }
                    text "THE BAR STARTS COUNTING NOW: A WEEK FILLS THIS" { at: py_w / 2, py_h / 2 + 30; anchor: center; align: center; size: 10; family: "Share Tech Mono"; color: dk.mute; show: topa.count == 0 }
                }

                // the landing (D125), over the cards so it shows on the one it would change places with: where the
                // card in the hand settles — the grid, a neighbour's edge, never on one
                group {
                    show: dk_lon and dk_edit and dk_canvas
                    box { from: lg_x, lg_y; size: lg_w, lg_h; corner: dk.r; color: dk.acc; opacity: 0.1 }
                    box { from: lg_x, lg_y; size: lg_w, lg_h; corner: dk.r; stroke: 1.2; color: dk.acc; opacity: 0.85 }
                    // dropped on a card, the two change places: where that one goes, in the warm tone
                    box { from: dk_l2x, dk_l2y; size: dk_l2w, dk_l2h; corner: dk.r; color: dk.hot; opacity: 0.08; show: dk_l2on }
                    box { from: dk_l2x, dk_l2y; size: dk_l2w, dk_l2h; corner: dk.r; stroke: 1.2; color: dk.hot; opacity: 0.7; show: dk_l2on }
                }
                // the power-on sweep: a lit line crossing the deck once
                group {
                    show: scan > 0.01 and scan < 0.99
                    glow: 10, 0.9 * st_glow, dk.acc
                    line { from: if(dk_vert, 6, scan * dk_w), if(dk_vert, scan * dk_h, 30); to: if(dk_vert, dk_w - 6, scan * dk_w), if(dk_vert, scan * dk_h, dk_h - 6)
                           width: 1.6; color: dk.acc; opacity: 1 - abs(scan - 0.5) * 1.6 }
                }
            }
            // the notches off the deck's ends (nexus.notches): cut tabs rising from its corners along a strip
            // (hanging under it at the top), from its open side down a column, three hexagons each —
            // Claude · Music · Weather, Workspaces · Wallpapers · GitHub; pointed at, the side notch opens
            // that panel beside the deck, clear of the notch. The deck's bars break where a tab leaves it
            // and run on along the tab's own outer face, so the visualiser follows the border round it.
            group {
                show: dk_notches
                opacity: smooth(0, 1, rp.7)
                repeat e in 0..2 {
                    // a strip's: 168 × 34 over the corner; a column's: 34 × 168 on its open side
                    let ex.$e = if(dk_vert, if(dk_edge == 3, 0, dk_w), if(e == 0, 22, dk_w - 190))
                    let ey.$e = if(dk_vert, 40 + e * 184, if(dk_edge == 1, dk_h, 0))
                    let eo.$e = if(dk_vert, if(dk_edge == 3, -1, 1), if(dk_edge == 1, 1, -1))   // the way it sticks out
                    group {
                        show: not dk_vert
                        path { color: mix(dk.raised, #000000, 0.35)
                               move ex.$e, ey.$e; line ex.$e + 14, ey.$e + 34 * eo.$e; line ex.$e + 154, ey.$e + 34 * eo.$e; line ex.$e + 168, ey.$e; close }
                        path { stroke: 1.1; color: mix(dk.line, dk.acc, 0.55)
                               move ex.$e, ey.$e; line ex.$e + 14, ey.$e + 34 * eo.$e; line ex.$e + 154, ey.$e + 34 * eo.$e; line ex.$e + 168, ey.$e }
                        group {
                            glow: 4, 0.5 * st_glow, dk.acc
                            line { from: ex.$e + 20, ey.$e + 34 * eo.$e; to: ex.$e + 64, ey.$e + 34 * eo.$e; width: 1.6; color: dk.acc; opacity: 0.8 }
                        }
                    }
                    group {
                        show: dk_vert
                        path { color: mix(dk.raised, #000000, 0.35)
                               move ex.$e, ey.$e; line ex.$e + 34 * eo.$e, ey.$e + 14; line ex.$e + 34 * eo.$e, ey.$e + 154; line ex.$e, ey.$e + 168; close }
                        path { stroke: 1.1; color: mix(dk.line, dk.acc, 0.55)
                               move ex.$e, ey.$e; line ex.$e + 34 * eo.$e, ey.$e + 14; line ex.$e + 34 * eo.$e, ey.$e + 154; line ex.$e, ey.$e + 168 }
                        group {
                            glow: 4, 0.5 * st_glow, dk.acc
                            line { from: ex.$e + 34 * eo.$e, ey.$e + 20; to: ex.$e + 34 * eo.$e, ey.$e + 64; width: 1.6; color: dk.acc; opacity: 0.8 }
                        }
                    }
                }
                repeat t in 0..6 {
                    let te.$t = floor(t / 3)
                    let tx.$t = if(dk_vert, if(dk_edge == 3, -17, dk_w + 17), if(te.$t == 0, 22, dk_w - 190) + 36 + mod(t, 3) * 48)
                    let ty.$t = if(dk_vert, 40 + te.$t * 184 + 36 + mod(t, 3) * 48, if(dk_edge == 1, dk_h + 17, -17))
                    zone box nz.$t { from: tx.$t - 18, ty.$t - 17; size: 36, 34; cursor: pointer; role: button; label: pick(t, "Claude", "Music", "Weather", "Workspaces", "Wallpapers", "GitHub") }
                    group {
                        glow: 6, (0.25 + 0.6 * max(nz.$t.hover, if(dk_ntab == t, 1, 0))) * st_glow, dk.acc
                        path { color: mix(dk.raised, dk.acc, 0.1 + 0.35 * max(nz.$t.hover, if(dk_ntab == t, 1, 0)))
                               move tx.$t, ty.$t - 13; line tx.$t + 11.3, ty.$t - 6.5; line tx.$t + 11.3, ty.$t + 6.5; line tx.$t, ty.$t + 13; line tx.$t - 11.3, ty.$t + 6.5; line tx.$t - 11.3, ty.$t - 6.5; close }
                        path { stroke: 1.1; color: mix(dk.line, dk.acc, 0.5 + 0.5 * nz.$t.hover)
                               move tx.$t, ty.$t - 13; line tx.$t + 11.3, ty.$t - 6.5; line tx.$t + 11.3, ty.$t + 6.5; line tx.$t, ty.$t + 13; line tx.$t - 11.3, ty.$t + 6.5; line tx.$t - 11.3, ty.$t - 6.5; close }
                    }
                    NGlyph(tx.$t, ty.$t, t, mix(dk.ink2, dk.acc, nz.$t.hover))
                    on hover nz.$t for 160ms { dk_ntab = t; emit dk_notch(t) }
                    on press nz.$t { dk_ntab = t; emit dk_notch(t) }
                }
            }

        }

        // ═══ Arranging: what grows out of the deck while ✎ is on ═══
        group {
            show: ed_in > 0.01
            move: ga_x - dk_ox * (1 - ed_in) * 14, ga_y - dk_oy * (1 - ed_in) * 14
            opacity: smooth(0, 0.8, ed_in)
            zone box keep_ar { from: 0, 0; size: 620, 116; role: region; label: "Arranging the deck" }
            IslandFrame(1, 620, 116, centre: true) {
                text "ARRANGE · CARRY A CARD BY MOVE, × PUTS IT ON THE SHELF" { at: 16, 17; anchor: left center; size: 10; weight: 700; family: "Share Tech Mono"; color: dk.acc }
                text "EDGE" { at: 16, 46; anchor: left center; size: 10; weight: 700; family: "Share Tech Mono"; color: dk.mute }
                repeat e in 0..4 {
                    let ex.$e = 54 + e * 32
                    zone box ez.$e { from: ex.$e, 34; size: 28, 24; cursor: pointer; role: tab; selected: dk_edge == e; label: pick(e, "Along the bottom", "Along the top", "Down the left", "Down the right") }
                    box { from: ex.$e, 34; size: 28, 24; corner: dk.r; color: if(dk_edge == e, mix(dk.well, dk.acc, 0.2), dk.well) }
                    box { from: ex.$e, 34; size: 28, 24; corner: dk.r; stroke: 1; color: if(dk_edge == e, dk.acc, mix(dk.line, dk.acc, ez.$e.hover)) }
                    box { from: ex.$e + 6, 39; size: 16, 14; corner: 1; stroke: 1; color: dk.mute }
                    box { from: ex.$e + pick(e, 6, 6, 6, 19), 34 + pick(e, 16, 5, 5, 5); size: pick(e, 16, 16, 3, 3), pick(e, 3, 3, 14, 14); color: if(dk_edge == e, dk.acc, dk.ink2) }
                    on press ez.$e { emit dk_edge_set(e) }
                }
                text "ROWS" { at: 194, 46; anchor: left center; size: 10; weight: 700; family: "Share Tech Mono"; color: dk.mute }
                repeat r in 0..2 {
                    zone box rz.$r { from: 232 + r * 32, 34; size: 28, 24; cursor: pointer; role: tab; selected: dk_rows == r + 1; label: pick(r, "One row of cards", "Two rows of cards") }
                    box { from: 232 + r * 32, 34; size: 28, 24; corner: dk.r; stroke: 1; color: if(dk_rows == r + 1, dk.acc, mix(dk.line, dk.acc, rz.$r.hover)) }
                    text pick(r, "1", "2") { at: 246 + r * 32, 46.5; anchor: center; align: center; size: 10; family: "Share Tech Mono"; color: if(dk_rows == r + 1, dk.acc, dk.ink2) }
                    on press rz.$r { emit dk_rows_set(r + 1) }
                }
                text "PROFILE" { at: 310, 46; anchor: left center; size: 10; weight: 700; family: "Share Tech Mono"; color: dk.mute }
                repeat r in 0..2 {
                    zone box pz.$r { from: 366 + r * 56, 34; size: 52, 24; cursor: pointer; role: tab; selected: if(nx_large, 1, 0) == r; label: pick(r, "A small profile", "A large profile") }
                    box { from: 366 + r * 56, 34; size: 52, 24; corner: dk.r; stroke: 1; color: if(if(nx_large, 1, 0) == r, dk.acc, mix(dk.line, dk.acc, pz.$r.hover)) }
                    text pick(r, "SMALL", "LARGE") { at: 392 + r * 56, 46.5; anchor: center; align: center; size: 8.5; weight: 700; family: "Share Tech Mono"; color: if(if(nx_large, 1, 0) == r, dk.acc, dk.ink2) }
                    on press pz.$r { emit dk_large_set(r) }
                }
                zone box az.0 { from: 486, 34; size: 60, 24; cursor: pointer; role: button; label: "Put every card back" }
                Act(486, 34, 60, "Reset", false, false, az.0.hover)
                zone box az.1 { from: 552, 34; size: 54, 24; cursor: pointer; role: button; label: "Done arranging" }
                Act(552, 34, 54, "Done", true, false, az.1.hover)
                on press az.0 { emit dk_reset }
                on press az.1 { emit dk_edit_on(0) }
                text pick(hid.count > 0, "EVERY CARD IS ON THE DECK", "ON THE SHELF") { at: 16, 84; anchor: left center; size: 8.5; weight: 700; family: "Share Tech Mono"; color: dk.mute }
                for h in hid {
                    let hx = 104 + h.index * 86
                    group {
                        show: h.index < 6
                        zone box hz { from: hx, 72; size: 82, 24; cursor: pointer; role: button; label: "Show {h.word}"; active: not h.room }
                        box { from: hx, 72; size: 82, 24; corner: dk.r; color: dk.well; opacity: 0.9 }
                        box { from: hx, 72; size: 82, 24; corner: dk.r; stroke: 1; color: if(h.room, dk.line, mix(dk.line, dk.acc, 0.4 + 0.6 * hz.hover)) }
                        text "+ {upper(h.word)}" { at: hx + 41, 84.5; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(h.room, dk.mute, dk.ink); width: 78; lines: 1 }
                        on press hz { emit dk_show(h.code) }
                    }
                }
            }
        }

        // ═══ What grows out of the deck ═══
        // A scene's changes, beside its chip.
        group {
            show: gs_in > 0.01
            move: gs_x - dk_ox * (1 - gs_in) * 14, gs_y - dk_oy * (1 - gs_in) * 14
            opacity: smooth(0, 0.7, gs_in)
            zone box keep_sc { from: 0, 0; size: gs_w, 86; role: region; label: "What the scene would change" }
            IslandFrame(1, gs_w, 86, centre: true) {
                text diff_t { at: 16, 18; anchor: left center; size: 10; weight: 700; family: "Share Tech Mono"; color: dk.hot; width: gs_w - 150 }
                text "PRESS TO SWITCH · RIGHT PRESS REMOVES" { at: gs_w - 16, 18; anchor: right center; size: 10; family: "Share Tech Mono"; color: dk.mute }
                row { at: 16, 40; gap: 6
                    for c in diff {
                        group {
                            size: c.w, 24
                            box { from: 0, 0; size: c.w, 24; corner: dk.r; color: dk.well }
                            box { from: 0, 0; size: c.w, 24; corner: dk.r; stroke: 1; color: dk.acc; opacity: 0.7 }
                            text c.word { at: 8, 12.5; anchor: left center; size: 10; family: "Share Tech Mono"; color: dk.ink }
                        }
                    }
                }
                text "ALREADY LIKE THIS" { at: 16, 52; anchor: left center; size: 10; family: "Share Tech Mono"; color: dk.mute; show: diff.count == 0 }
            }
        }
        // A workspace's preview, beside its tile: big enough to read, a press on a window focuses it.
        group {
            show: gw_in > 0.01
            move: gw_x - dk_ox * (1 - gw_in) * 14, gw_y - dk_oy * (1 - gw_in) * 14
            opacity: smooth(0, 0.7, gw_in)
            zone box keep_ws { from: 0, 0; size: gw_w, gw_h; role: region; label: "The workspace's preview" }
            IslandFrame(1, gw_w, gw_h, centre: true) {
                let pw = gw_w - 20
                let ph = gw_h - 54
                group {
                    show: not gw_free
                    group {
                        clip box { from: 10, 10; size: pw, ph; corner: dk.r }
                        box { from: 10, 10; size: pw, ph; color: dk.well }
                        image wall { at: 10, 10; size: pw, ph; opacity: 0.85; show: dk_wall_on }
                        box { from: 10, 10; size: pw, ph; color: #000000; opacity: 0.25 }
                    }
                    for b in big {
                        zone box bz { from: b.x, b.y; size: b.w, b.h; cursor: pointer; role: item; label: "Focus {b.app}" }
                        box { from: b.x, b.y; size: b.w, b.h; corner: 2; color: mix(dk.raised, #000000, 0.15) }
                        image b.pic { at: b.x, b.y; size: b.w, b.h; show: b.pictured }
                        text b.app { at: b.x + b.w / 2, b.y + b.h / 2; anchor: center; align: center; size: 11; family: "Share Tech Mono"; color: dk.ink2; width: b.w - 8; lines: 1; show: not b.pictured }
                        box { from: b.x, b.y; size: b.w, b.h; corner: 2; stroke: 1 + bz.hover; color: if(b.focused, dk.acc, mix(dk.line, dk.acc, bz.hover)) }
                        on press bz { emit dk_big(b.index) }
                    }
                    box { from: 10, 10; size: pw, ph; corner: dk.r; stroke: 1; color: dk.line }
                }
                text "AN EMPTY WORKSPACE, READY" { at: gw_w / 2, 10 + ph / 2; anchor: center; align: center; size: 11; family: "Share Tech Mono"; color: dk.mute; show: gw_free }
                text big_t { at: 14, gw_h - 22; anchor: left center; size: 11; family: "Share Tech Mono"; color: dk.ink; width: gw_w - 240; lines: 1 }
                zone box bgo { from: gw_w - 216, gw_h - 34; size: 70, 24; cursor: pointer; role: button; label: "Go there" }
                Act(gw_w - 216, gw_h - 34, 70, "Go", true, false, bgo.hover)
                on press bgo { emit dk_ws(dk_hws) }
                zone box bsend { from: gw_w - 140, gw_h - 34; size: 128, 24; cursor: pointer; role: button; label: "Send this window there"; active: w_ok }
                group {
                    opacity: if(w_ok, 1, 0.4)
                    Act(gw_w - 140, gw_h - 34, 128, "Send window here", false, false, bsend.hover)
                }
                on press bsend while w_ok { emit dk_send(dk_hws) }
            }
        }

        // Naming a new scene: its name typed, and a saved environment (D43) to restore with it if wanted.
        group {
            show: gn_in > 0.01
            move: gn_x - dk_ox * (1 - gn_in) * 14, gn_y - dk_oy * (1 - gn_in) * 14
            opacity: smooth(0, 0.7, gn_in)
            zone box keep_nm { from: 0, 0; size: 440, 132; role: region; label: "Naming a scene" }
            IslandFrame(1, 440, 132, centre: true) {
                text "SAVE THIS SETUP AS A SCENE" { at: 16, 18; anchor: left center; size: 10; weight: 700; family: "Share Tech Mono"; color: dk.acc }
                text "ENTER SAVES · ESC LEAVES IT" { at: 424, 18; anchor: right center; size: 10; family: "Share Tech Mono"; color: dk.mute }
                box { from: 16, 32; size: 408, 30; corner: dk.r; color: dk.well }
                box { from: 16, 32; size: 408, 30; corner: dk.r; stroke: 1; color: dk.acc; opacity: 0.8 }
                input dk_name_in { at: 26, 47; width: 390; size: 13; family: "Exo 2"; color: dk.ink; placeholder: "Its name (twelve letters)"; selection: dk.well; label: "The scene's name" }
                on submit dk_name_in { emit dk_save_named; dk_naming = false; blur }
                text "WITH" { at: 16, 82; anchor: left center; size: 10; weight: 700; family: "Share Tech Mono"; color: dk.mute }
                text "NO SAVED ENVIRONMENTS YET (THE OVERVIEW SAVES THEM)" { at: 54, 82; anchor: left center; size: 10; family: "Share Tech Mono"; color: dk.mute; show: envs.count == 0 }
                row { at: 54, 71; gap: 6
                    for e in envs {
                        group {
                            size: e.w, 22
                            zone box enz { from: 0, 0; size: e.w, 22; cursor: pointer; role: toggle; checked: e.on; label: "Restore {e.word} with it" }
                            box { from: 0, 0; size: e.w, 22; corner: dk.r; color: if(e.on, mix(dk.well, dk.acc, 0.2), dk.well) }
                            box { from: 0, 0; size: e.w, 22; corner: dk.r; stroke: 1; color: if(e.on, dk.acc, mix(dk.line, dk.acc, enz.hover)) }
                            text e.word { at: e.w / 2, 11.5; anchor: center; align: center; size: 10; family: "Share Tech Mono"; color: if(e.on, dk.acc, dk.ink2) }
                            on press enz { emit dk_env(e.index) }
                        }
                    }
                }
                zone box nsave { from: 284, 98; size: 66, 24; cursor: pointer; role: button; label: "Save the scene" }
                Act(284, 98, 66, "Save", true, false, nsave.hover)
                on press nsave { emit dk_save_named; dk_naming = false; blur }
                zone box ncan { from: 358, 98; size: 66, 24; cursor: pointer; role: button; label: "Leave it" }
                Act(358, 98, 66, "Cancel", false, false, ncan.hover)
                on press ncan { dk_naming = false; blur }
            }
        }

        // What grows out folds back once the pointer has been off it and off what it grew from for a moment.
        on still max(scbay.hover, keep_sc.hover) for 380ms while dk_hsc >= 0 and max(scbay.hover, keep_sc.hover) < 0.5 { dk_hsc = -1 }
        on still max(wsbay.hover, keep_ws.hover) for 420ms while dk_hws >= 0 and max(wsbay.hover, keep_ws.hover) < 0.5 { dk_hws = -1 }
    }
}
