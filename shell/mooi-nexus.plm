language 0.4
import "theme/tokens.plm"
import "theme/ferrolume.plm"
import "ui/loom.plm"

// mooi's Control Nexus (D65) — the system command centre, a program of its own. A full-screen
// surface that holds the keyboard while it is up, so the bar's scene keeps its own keyboard
// clause and the bar remains the place the Nexus opens from and closes back to. `mooi-nexus.luau`
// paints the shell's colours from palette.json, keeps `nexus.pinned`, and carries the controls
// to the real services. `settings.json` is mooi's own (bin/mooi links the data folder).
//
// The plate is right-anchored under the bar: it unfolds from a strip at the Arch mark's corner
// and settles into a structured board. Its readings are the system's own; where a service cannot
// answer, the card says so rather than drawing a number.

scene Nexus {
    permissions {
        run: "pleamar"
        services: "workspaces", "clock", "audio", "audio.*", "brightness", "brightness.*", "battery", "network", "bluetooth", "media", "media.*", "files", "files.write", "env"
    }

    // The same facts and springs the bar wears: the logic paints them from palette.json, and
    // the studio re-lights with the desktop when the palette changes after an apply.
    fact fr_ground_r = 0.000000
    fact fr_ground_g = 0.000000
    fact fr_ground_b = 0.000000
    fact fr_hull_r = 0.015686
    fact fr_hull_g = 0.035294
    fact fr_hull_b = 0.031373
    fact fr_hull_raised_r = 0.027451
    fact fr_hull_raised_g = 0.074510
    fact fr_hull_raised_b = 0.066667
    fact fr_well_r = 0.019608
    fact fr_well_g = 0.164706
    fact fr_well_b = 0.145098
    fact fr_trace_dim_r = 0.121569
    fact fr_trace_dim_g = 0.219608
    fact fr_trace_dim_b = 0.200000
    fact fr_trace_r = 0.239216
    fact fr_trace_g = 0.415686
    fact fr_trace_b = 0.376471
    fact fr_trace_lit_r = 0.423529
    fact fr_trace_lit_g = 0.788235
    fact fr_trace_lit_b = 0.682353
    fact fr_phos_r = 0.498039
    fact fr_phos_g = 0.811765
    fact fr_phos_b = 0.713725
    fact fr_phos_fill_r = 0.090196
    fact fr_phos_fill_g = 0.603922
    fact fr_phos_fill_b = 0.533333
    fact fr_ember_r = 0.878431
    fact fr_ember_g = 0.482353
    fact fr_ember_b = 0.180392
    fact fr_ember_fill_r = 0.823529
    fact fr_ember_fill_g = 0.411765
    fact fr_ember_fill_b = 0.117647
    fact fr_flare_r = 0.956863
    fact fr_flare_g = 0.713725
    fact fr_flare_b = 0.235294
    fact fr_muted_r = 0.352941
    fact fr_muted_g = 0.541176
    fact fr_muted_b = 0.494118
    fact fr_ink_r = 0.015686
    fact fr_ink_g = 0.129412
    fact fr_ink_b = 0.113725
    fact fr_steel_900_r = 0.082353
    fact fr_steel_900_g = 0.098039
    fact fr_steel_900_b = 0.105882
    fact fr_steel_700_r = 0.164706
    fact fr_steel_700_g = 0.192157
    fact fr_steel_700_b = 0.203922
    fact fr_steel_500_r = 0.290196
    fact fr_steel_500_g = 0.329412
    fact fr_steel_500_b = 0.349020
    fact fr_steel_300_r = 0.545098
    fact fr_steel_300_g = 0.592157
    fact fr_steel_300_b = 0.611765
    fact fr_engrave_r = 0.603922
    fact fr_engrave_g = 0.650980
    fact fr_engrave_b = 0.670588
    prop pr_ground_r = 0.000000 ~fl.relight
    follow pr_ground_r = fr_ground_r
    prop pr_ground_g = 0.000000 ~fl.relight
    follow pr_ground_g = fr_ground_g
    prop pr_ground_b = 0.000000 ~fl.relight
    follow pr_ground_b = fr_ground_b
    prop pr_hull_r = 0.015686 ~fl.relight
    follow pr_hull_r = fr_hull_r
    prop pr_hull_g = 0.035294 ~fl.relight
    follow pr_hull_g = fr_hull_g
    prop pr_hull_b = 0.031373 ~fl.relight
    follow pr_hull_b = fr_hull_b
    prop pr_hull_raised_r = 0.027451 ~fl.relight
    follow pr_hull_raised_r = fr_hull_raised_r
    prop pr_hull_raised_g = 0.074510 ~fl.relight
    follow pr_hull_raised_g = fr_hull_raised_g
    prop pr_hull_raised_b = 0.066667 ~fl.relight
    follow pr_hull_raised_b = fr_hull_raised_b
    prop pr_well_r = 0.019608 ~fl.relight
    follow pr_well_r = fr_well_r
    prop pr_well_g = 0.164706 ~fl.relight
    follow pr_well_g = fr_well_g
    prop pr_well_b = 0.145098 ~fl.relight
    follow pr_well_b = fr_well_b
    prop pr_trace_dim_r = 0.121569 ~fl.relight
    follow pr_trace_dim_r = fr_trace_dim_r
    prop pr_trace_dim_g = 0.219608 ~fl.relight
    follow pr_trace_dim_g = fr_trace_dim_g
    prop pr_trace_dim_b = 0.200000 ~fl.relight
    follow pr_trace_dim_b = fr_trace_dim_b
    prop pr_trace_r = 0.239216 ~fl.relight
    follow pr_trace_r = fr_trace_r
    prop pr_trace_g = 0.415686 ~fl.relight
    follow pr_trace_g = fr_trace_g
    prop pr_trace_b = 0.376471 ~fl.relight
    follow pr_trace_b = fr_trace_b
    prop pr_trace_lit_r = 0.423529 ~fl.relight
    follow pr_trace_lit_r = fr_trace_lit_r
    prop pr_trace_lit_g = 0.788235 ~fl.relight
    follow pr_trace_lit_g = fr_trace_lit_g
    prop pr_trace_lit_b = 0.682353 ~fl.relight
    follow pr_trace_lit_b = fr_trace_lit_b
    prop pr_phos_r = 0.498039 ~fl.relight
    follow pr_phos_r = fr_phos_r
    prop pr_phos_g = 0.811765 ~fl.relight
    follow pr_phos_g = fr_phos_g
    prop pr_phos_b = 0.713725 ~fl.relight
    follow pr_phos_b = fr_phos_b
    prop pr_phos_fill_r = 0.090196 ~fl.relight
    follow pr_phos_fill_r = fr_phos_fill_r
    prop pr_phos_fill_g = 0.603922 ~fl.relight
    follow pr_phos_fill_g = fr_phos_fill_g
    prop pr_phos_fill_b = 0.533333 ~fl.relight
    follow pr_phos_fill_b = fr_phos_fill_b
    prop pr_ember_r = 0.878431 ~fl.relight
    follow pr_ember_r = fr_ember_r
    prop pr_ember_g = 0.482353 ~fl.relight
    follow pr_ember_g = fr_ember_g
    prop pr_ember_b = 0.180392 ~fl.relight
    follow pr_ember_b = fr_ember_b
    prop pr_ember_fill_r = 0.823529 ~fl.relight
    follow pr_ember_fill_r = fr_ember_fill_r
    prop pr_ember_fill_g = 0.411765 ~fl.relight
    follow pr_ember_fill_g = fr_ember_fill_g
    prop pr_ember_fill_b = 0.117647 ~fl.relight
    follow pr_ember_fill_b = fr_ember_fill_b
    prop pr_flare_r = 0.956863 ~fl.relight
    follow pr_flare_r = fr_flare_r
    prop pr_flare_g = 0.713725 ~fl.relight
    follow pr_flare_g = fr_flare_g
    prop pr_flare_b = 0.235294 ~fl.relight
    follow pr_flare_b = fr_flare_b
    prop pr_muted_r = 0.352941 ~fl.relight
    follow pr_muted_r = fr_muted_r
    prop pr_muted_g = 0.541176 ~fl.relight
    follow pr_muted_g = fr_muted_g
    prop pr_muted_b = 0.494118 ~fl.relight
    follow pr_muted_b = fr_muted_b
    prop pr_ink_r = 0.015686 ~fl.relight
    follow pr_ink_r = fr_ink_r
    prop pr_ink_g = 0.129412 ~fl.relight
    follow pr_ink_g = fr_ink_g
    prop pr_ink_b = 0.113725 ~fl.relight
    follow pr_ink_b = fr_ink_b
    prop pr_steel_900_r = 0.082353 ~fl.relight
    follow pr_steel_900_r = fr_steel_900_r
    prop pr_steel_900_g = 0.098039 ~fl.relight
    follow pr_steel_900_g = fr_steel_900_g
    prop pr_steel_900_b = 0.105882 ~fl.relight
    follow pr_steel_900_b = fr_steel_900_b
    prop pr_steel_700_r = 0.164706 ~fl.relight
    follow pr_steel_700_r = fr_steel_700_r
    prop pr_steel_700_g = 0.192157 ~fl.relight
    follow pr_steel_700_g = fr_steel_700_g
    prop pr_steel_700_b = 0.203922 ~fl.relight
    follow pr_steel_700_b = fr_steel_700_b
    prop pr_steel_500_r = 0.290196 ~fl.relight
    follow pr_steel_500_r = fr_steel_500_r
    prop pr_steel_500_g = 0.329412 ~fl.relight
    follow pr_steel_500_g = fr_steel_500_g
    prop pr_steel_500_b = 0.349020 ~fl.relight
    follow pr_steel_500_b = fr_steel_500_b
    prop pr_steel_300_r = 0.545098 ~fl.relight
    follow pr_steel_300_r = fr_steel_300_r
    prop pr_steel_300_g = 0.592157 ~fl.relight
    follow pr_steel_300_g = fr_steel_300_g
    prop pr_steel_300_b = 0.611765 ~fl.relight
    follow pr_steel_300_b = fr_steel_300_b
    prop pr_engrave_r = 0.603922 ~fl.relight
    follow pr_engrave_r = fr_engrave_r
    prop pr_engrave_g = 0.650980 ~fl.relight
    follow pr_engrave_g = fr_engrave_g
    prop pr_engrave_b = 0.670588 ~fl.relight
    follow pr_engrave_b = fr_engrave_b

    // The islands' semantic tokens, which theme/tokens defines over these facts.
    fact c_bg_primary_r = 0.062745
    fact c_bg_primary_g = 0.078431
    fact c_bg_primary_b = 0.086275
    fact c_bg_secondary_r = 0.086275
    fact c_bg_secondary_g = 0.105882
    fact c_bg_secondary_b = 0.117647
    fact c_surface_primary_r = 0.098039
    fact c_surface_primary_g = 0.121569
    fact c_surface_primary_b = 0.133333
    fact c_surface_elevated_r = 0.133333
    fact c_surface_elevated_g = 0.160784
    fact c_surface_elevated_b = 0.176471
    fact c_border_subtle_r = 0.172549
    fact c_border_subtle_g = 0.207843
    fact c_border_subtle_b = 0.223529
    fact c_fg_primary_r = 0.890196
    fact c_fg_primary_g = 0.913725
    fact c_fg_primary_b = 0.921569
    fact c_fg_secondary_r = 0.639216
    fact c_fg_secondary_g = 0.690196
    fact c_fg_secondary_b = 0.709804
    fact c_fg_muted_r = 0.541176
    fact c_fg_muted_g = 0.592157
    fact c_fg_muted_b = 0.611765
    fact c_accent_primary_r = 0.650980
    fact c_accent_primary_g = 0.952941
    fact c_accent_primary_b = 0.819608
    fact c_accent_secondary_r = 1.000000
    fact c_accent_secondary_g = 0.572549
    fact c_accent_secondary_b = 0.372549
    fact c_status_ok_r = 0.650980
    fact c_status_ok_g = 0.952941
    fact c_status_ok_b = 0.819608
    fact c_status_error_r = 1.000000
    fact c_status_error_g = 0.572549
    fact c_status_error_b = 0.372549
    fact c_focus_ring_r = 0.650980
    fact c_focus_ring_g = 0.952941
    fact c_focus_ring_b = 0.819608
    fact c_selection_bg_r = 0.164706
    fact c_selection_bg_g = 0.227451
    fact c_selection_bg_b = 0.211765
    // What theme/ferrolume reads for its geometry; the studio uses the colour, not the bar's
    // strip, so these are only the values the tokens are defined against.
    fact st_offset = 0
    fact st_notch = false
    fact bar_rail = true
    fact st_height = 30
    fact st_radius = 8
    fact st_res = 46

    // ── The Nexus (D65) ──────────────────────────────────────
    // Its own state: open is the entrance and the way out; pinned keeps it while a press lands
    // outside it. The readings below are services; the controls call the system through the logic.
    model nws max 16 { id: number; windows: number; active: bool }
    service workspaces as ws { active: number; list: nws }
    service clock { time: text = "--:--"; date: text; weekday: number }
    service audio { volume: number; muted: bool; input: number; input_muted: bool }
    service brightness { present: bool; level: number }
    service battery { present: bool; percent: number; charging: bool }
    service network { online: bool; kind: none | wired | wifi; name: text; strength: number }
    service bluetooth { present: bool; powered: bool; discovering: bool }
    service media as med { playing: bool; title: text; artist: text; album: text; length: number; position: number; rate: number; player: text }

    fact nx_open = 0
    fact nx_pinned = false
    fact st_glow = 1
    // The player's own fields, kept by the logic: a text field can be drawn and interpolated, but
    // it is not a number the scene can compare, so what is there to show arrives as facts.
    fact nx_has = false
    fact nx_playing = false
    fact nx_album_on = false
    fact nx_player_on = false
    fact nx_progress = 0
    fact nx_media_time_on = false
    text nx_elapsed = ""
    text nx_duration = ""
    fact nx_notice = false
    text nx_notice_text = ""
    text nx_user = "operator"
    text nx_host = "Arch Linux"
    text nx_session = "Hyprland"
    text nx_title = ""
    text nx_artist = ""
    text nx_album = ""
    text nx_player = ""
    figure nx_mark = file "icons/arch.svg"

    event nx_close ->           // to the logic: put the Nexus away (×, Escape, or an outside press)
    event nx_pin ->             // to the logic: pin or unpin (persisted in settings.json)
    event nx_vol ->             // to the logic: the output volume, 0 … 1
    event nx_mute ->            // to the logic: mute or unmute the output
    event nx_bri ->             // to the logic: the backlight, 0 … 1
    event nx_media ->           // to the logic: 1 previous · 0 play/pause · 2 next

    // A card: its code, its reading, and a line that says what the reading is or why it is absent.
    component NTile(x: number, y: number, w: number, h: number, code: text, value: text, note: text, tone: color) {
        size: w, h
        Chamfer(x, y, w, h, 10, fl.hull_raised, fl.trace, 0.9, 1)
        text code { at: x + 14, y + 17; anchor: left center; size: 9; family: "Share Tech Mono"; color: fl.muted }
        text value { at: x + 14, y + 43; anchor: left center; size: 22; weight: 700; family: "Exo 2"; width: w - 28; lines: 1; color: tone }
        text note { at: x + 14, y + h - 15; anchor: left center; size: 9; family: "Share Tech Mono"; width: w - 28; lines: 1; color: fl.trace_lit }
    }

    // The entrance: a strip under the mark, unfolding left and down into the full plate.
    spring nx.ext = 900, 51
    spring nx.unf = 700, 48
    prop nx_a = 0 ~nx.ext
    prop nx_b = 0 ~nx.unf
    on change nx_open while nx_open { nx_a: 1 ~nx.ext; nx_b: 1 ~nx.unf after 80ms }
    on change nx_open while not nx_open { nx_a: 0 ~nx.ext; nx_b: 0 ~nx.unf }

    surface nexus {
        size: full, full
        anchor: top
        reserve: -1
        level: overlay
        // This scene's only surface: the Nexus holds the keyboard while it is up. The bar lets go
        // of its own before it starts this program (D65).
        keyboard: exclusive

        // A press anywhere outside the plate closes it, unless it is pinned. The plate itself
        // catches its own presses first, so a control never reaches this.
        zone box nx_away { from: 0, 0; size: screen.width, screen.height; role: region
                           label: "Close Control Nexus"; show: nx_a > 0.004 }
        on press nx_away while not nx_pinned { emit nx_close }

        let nw0 = min(780, screen.width - 48)
        let nh0 = min(660, screen.height - 82)
        let pw = 260 + (nw0 - 260) * nx_a
        let ph = 44 + (nh0 - 44) * nx_b
        let px = screen.width - 24 - pw
        let py = 49
        let cw = pw - 52
        let tw = (cw - 14) / 2
        let med_h = 118
        let ny = 158
        zone box nx_catch { from: px, py; size: pw, ph; show: nx_a > 0.004 }
        group {
            show: nx_a > 0.004
            group {
                glow: 26, 0.42 * st_glow, fl.phos
                Chamfer(px, py, pw, ph, 18, fl.hull, fl.trace, 0.985, 1.5)
            }
            group {
                clip box { from: px, py; size: pw, ph }
                group {
                    move: px + 26, py + 18
                    opacity: min(1, nx_a * 1.3)

                    // ── the head ──
                    figure nx_mark { at: 0, 7; size: 24, 24; color: fl.phos }
                    text "CONTROL NEXUS" { at: 34, 13; anchor: left center; size: 14; weight: 700; family: "Exo 2"; color: fl.phos }
                    text "SYSTEM COMMAND CENTRE" { at: 34, 30; anchor: left center; size: 9; family: "Share Tech Mono"; color: fl.muted }
                    zone box nx_pinbtn { from: cw - 112, 0; size: 84, 28; cursor: pointer; role: toggle; checked: nx_pinned
                                          label: "Pin Control Nexus open" }
                    box { from: cw - 112, 0; size: 84, 28; corner: 4; color: fl.well; opacity: if(nx_pinned, 0.7, 0.25 * nx_pinbtn.hover) }
                    box { from: cw - 112, 0; size: 84, 28; corner: 4; stroke: 1; color: if(nx_pinned, fl.phos, fl.trace); opacity: 0.9 }
                    text pick(nx_pinned, "PINNED", "PIN") { at: cw - 70, 14; anchor: center; size: 9; weight: 700; family: "Share Tech Mono"
                                                            color: if(nx_pinned, fl.phos, mix(fl.muted, fl.phos, nx_pinbtn.hover)) }
                    on press nx_pinbtn { emit nx_pin }
                    zone box nx_closebtn { from: cw - 24, 0; size: 24, 28; cursor: pointer; role: button; label: "Close Control Nexus" }
                    line { from: cw - 16, 6; to: cw - 4, 18; width: 1.6; color: mix(fl.muted, fl.ember, nx_closebtn.hover) }
                    line { from: cw - 4, 6; to: cw - 16, 18; width: 1.6; color: mix(fl.muted, fl.ember, nx_closebtn.hover) }
                    on press nx_closebtn { emit nx_close }
                    line { from: 0, 38; to: cw, 38; width: 1; color: fl.trace; opacity: 0.65 }

                    // ── identity ──
                    Chamfer(0, 52, cw, 74, 10, fl.hull_raised, fl.trace, 0.9, 1)
                    box { from: 0, 68; size: 3, 42; color: fl.ember }
                    text "OPERATOR" { at: 16, 68; anchor: left center; size: 8; family: "Share Tech Mono"; color: fl.muted }
                    text "{nx_user}" { at: 16, 85; anchor: left center; size: 15; weight: 600; family: "Exo 2"; color: fl.phos }
                    text "{nx_host}" { at: 16, 105; anchor: left center; size: 9; family: "Share Tech Mono"; color: fl.trace_lit }
                    text "{nx_session}" { at: cw - 16, 68; anchor: right center; size: 9; family: "Share Tech Mono"; color: fl.muted }
                    text "{clock.time}  ·  {clock.date}" { at: cw - 16, 84; anchor: right center; size: 11; weight: 600; family: "Share Tech Mono"; color: fl.flare }
                    text "WORKSPACE {ws.active, 0}" { at: cw - 16, 104; anchor: right center; size: 9; family: "Share Tech Mono"; color: fl.trace_lit }

                    // ── four instruments ──
                    zone box nx_volhit { from: 0, ny; size: tw, 84; cursor: pointer; role: slider; label: "Output volume"
                                         value: audio.volume }
                    NTile(0, ny, tw, 84, "OUTPUT", pick(audio.muted, "MUTED", "{audio.volume * 100, 0}%"),
                          pick(audio.muted, "CLICK TO UNMUTE", "WHEEL TO SET · CLICK TO MUTE"),
                          if(audio.muted, fl.ember, fl.phos))
                    on press nx_volhit { emit nx_mute }
                    on scroll nx_volhit { emit nx_vol(clamp(audio.volume + wheel * 0.05, 0, 1)) }
                    box { from: 52, ny + 58; size: tw - 66, 2; color: fl.ground }
                    box { from: 52, ny + 58; size: max(0, (tw - 66) * clamp(audio.volume, 0, 1)), 2; color: if(audio.muted, fl.ember, fl.phos) }

                    zone box nx_brihit { from: tw + 14, ny; size: tw, 84; cursor: pointer; role: slider; label: "Display brightness"
                                         value: brightness.level }
                    NTile(tw + 14, ny, tw, 84, "DISPLAY", pick(brightness.present, "{brightness.level * 100, 0}%", "N/A"),
                          pick(brightness.present, "WHEEL TO SET", "NO BACKLIGHT"),
                          if(brightness.present, fl.phos, fl.muted))
                    on scroll nx_brihit { emit nx_bri(clamp(brightness.level + wheel * 0.05, 0.01, 1)) }
                    box { from: tw + 66, ny + 58; size: tw - 66, 2; color: fl.ground; show: brightness.present }
                    box { from: tw + 66, ny + 58; size: max(0, (tw - 66) * clamp(brightness.level, 0, 1)), 2; color: fl.phos; show: brightness.present }

                    let ry = ny + 98
                    NTile(0, ry, tw, 84, "NETWORK", pick(network.online, network.name, "OFFLINE"),
                          pick(if(network.online and network.kind == wifi, 2, if(network.online, 1, 0)),
                               "NO LINK", "WIRED", "WIFI · {network.strength, 0}%"),
                          if(network.online, fl.phos, fl.ember))
                    NTile(tw + 14, ry, tw, 84, "POWER", pick(battery.present, "{battery.percent, 0}%", "N/A"),
                          pick(if(not battery.present, 0, if(battery.charging, 2, 1)),
                               "NO BATTERY", "ON BATTERY", "CHARGING"),
                          if(not battery.present, fl.muted, if(battery.charging, fl.flare, fl.phos)))

                    // ── the player ──
                    let my0 = ry + 98
                    Chamfer(0, my0, cw, med_h, 10, fl.hull_raised, fl.trace, 0.9, 1)
                    box { from: 0, my0 + 18; size: 3, med_h - 36; color: if(nx_has, if(med.playing, fl.phos, fl.flare), fl.muted) }
                    text "PLAYER" { at: 16, my0 + 17; anchor: left center; size: 8; family: "Share Tech Mono"; color: fl.muted }
                    text "{nx_title}" { at: 16, my0 + 38; anchor: left center; size: 16; weight: 600; family: "Exo 2"; width: cw - 220; lines: 1
                                        color: fl.phos; show: nx_has }
                    text "No media session" { at: 16, my0 + 38; anchor: left center; size: 16; weight: 600; family: "Exo 2"; color: fl.muted; show: not nx_has }
                    text "{nx_artist}" { at: 16, my0 + 59; anchor: left center; size: 11; family: "Exo 2"; width: cw - 220; lines: 1; color: fl.trace_lit; show: nx_has }
                    text "Nothing is playing" { at: 16, my0 + 59; anchor: left center; size: 11; family: "Exo 2"; color: fl.muted; show: not nx_has }
                    text "{nx_album}" { at: 16, my0 + 77; anchor: left center; size: 9; family: "Share Tech Mono"; width: cw - 220; lines: 1; color: fl.muted; show: nx_album_on }
                    text "{nx_elapsed}" { at: 16, my0 + med_h - 10; anchor: left center; size: 8; family: "Share Tech Mono"; color: fl.trace_lit; show: nx_media_time_on }
                    text "{nx_duration}" { at: cw - 16, my0 + med_h - 10; anchor: right center; size: 8; family: "Share Tech Mono"; color: fl.trace_lit; show: nx_media_time_on }
                    line { from: 16, my0 + med_h - 22; to: cw - 16, my0 + med_h - 22; width: 2; color: fl.ground }
                    box { from: 16, my0 + med_h - 22; size: max(0, (cw - 32) * clamp(nx_progress, 0, 1)), 2
                          color: if(nx_playing, fl.phos, fl.trace); show: nx_progress > 0 }

                    let bx0 = cw - 196
                    zone box nx_prev { from: bx0, my0 + 34; size: 54, 26; cursor: pointer; role: button; label: "Previous track"; show: nx_has }
                    CutButton(bx0, my0 + 37, 54, "Prev", fl.phos, nx_prev.hover)
                    on press nx_prev { emit nx_media(1) }
                    zone box nx_play { from: bx0 + 62, my0 + 34; size: 58, 26; cursor: pointer; role: button; label: "Play or pause"; show: nx_has }
                    group { show: not med.playing
                        CutButton(bx0 + 62, my0 + 37, 58, "Play", fl.phos, nx_play.hover) }
                    group { show: med.playing
                        CutButton(bx0 + 62, my0 + 37, 58, "Pause", fl.flare, nx_play.hover) }
                    on press nx_play { emit nx_media(0) }
                    zone box nx_next { from: bx0 + 128, my0 + 34; size: 54, 26; cursor: pointer; role: button; label: "Next track"; show: nx_has }
                    CutButton(bx0 + 128, my0 + 37, 54, "Next", fl.phos, nx_next.hover)
                    on press nx_next { emit nx_media(2) }
                    text "{nx_player}" { at: cw - 16, my0 + 17; anchor: right center; size: 9; family: "Share Tech Mono"; color: fl.muted; show: nx_player_on }
                    text pick(nx_playing, "PLAYING", "PAUSED") { at: cw - 16, my0 + 33; anchor: right center; size: 8; weight: 700; family: "Share Tech Mono"; color: if(nx_playing, fl.phos, fl.flare); show: nx_has }

                    // ── the foot ──
                    let fy = my0 + med_h + 14
                    line { from: 0, fy; to: cw, fy; width: 1; color: fl.trace; opacity: 0.55 }
                    text pick(bluetooth.present, pick(bluetooth.powered, "BLUETOOTH ON", "BLUETOOTH OFF"), "BLUETOOTH N/A") { at: 0, fy + 18; anchor: left center; size: 9; family: "Share Tech Mono"
                                                                                 color: if(not bluetooth.present, fl.muted, if(bluetooth.powered, fl.phos, fl.flare)) }
                    text "WHEEL · VOLUME / BRIGHTNESS" { at: 160, fy + 18; anchor: left center; size: 9; family: "Share Tech Mono"; color: fl.muted; show: not nx_notice }
                    text "{nx_notice_text}" { at: 160, fy + 18; anchor: left center; size: 9; weight: 700; family: "Share Tech Mono"; color: fl.ember; show: nx_notice }
                    text "ESC CLOSES" { at: cw, fy + 18; anchor: right center; size: 9; family: "Share Tech Mono"; color: fl.trace_lit }
                }
            }
        }
    }

    on key Escape { emit nx_close }
}
