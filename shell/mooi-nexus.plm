language 0.4
import "theme/tokens.plm"
import "theme/ferrolume.plm"
import "ui/loom.plm"
import "ui/island.plm"

// mooi's Control Nexus (D98) — a drawer on the right edge, under the bar, the screen's height
// below it: everything that matters in one scrolling column, every tile doing something. It
// never dims or covers the desktop; it closes on Esc, its ×, the bar's mark again, or a workspace
// change — not when the focus moves (with focus following the mouse, that is every mouse move). Drawn in the island style (island.style) with the island kit, so the
// Nexus and the islands are one family. mooi-nexus.luau reads what the drawer shows while it is
// open, and carries every press to the system or to the bar (`pleamar --say mooi`). The column's
// geometry is lib/nexusdrawer's.

scene Nexus {
    permissions {
        run: "pleamar", "cat", "df", "sensors", "hyprctl", "mooi", "cava", "curl", "magick", "kitty", "btop", "hostname", "whoami", "zenity"
        services: "workspaces", "clock", "audio", "audio.*", "brightness", "brightness.*", "battery", "network", "network.*", "bluetooth", "bluetooth.*", "media", "media.*", "files", "files.write", "env"
    }

    // The same facts and springs the bar wears: the logic paints them from palette.json, and
    // the studio re-lights with the desktop when the palette changes after an apply.
    // corners on every plate (look.corners: 0 chamfer · 1 bevel · 2 rounded · 3 square; look.corner_size as a scale)
    fact cn_kind = 0
    fact cn_scale = 1
    fact fr_ground_r = 0.000000
    fact fr_ground_g = 0.000000
    fact fr_ground_b = 0.000000
    fact fr_hull_r = 0.015686
    fact fr_hull_g = 0.035294
    fact fr_hull_b = 0.031373
    fact fr_hull_raised_r = 0.027451
    fact fr_hull_raised_g = 0.074510
    fact fr_hull_raised_b = 0.066667
    fact fr_well_r = 0.019608
    fact fr_well_g = 0.164706
    fact fr_well_b = 0.145098
    fact fr_trace_dim_r = 0.121569
    fact fr_trace_dim_g = 0.219608
    fact fr_trace_dim_b = 0.200000
    fact fr_trace_r = 0.239216
    fact fr_trace_g = 0.415686
    fact fr_trace_b = 0.376471
    fact fr_trace_lit_r = 0.423529
    fact fr_trace_lit_g = 0.788235
    fact fr_trace_lit_b = 0.682353
    fact fr_phos_r = 0.498039
    fact fr_phos_g = 0.811765
    fact fr_phos_b = 0.713725
    fact fr_phos_fill_r = 0.090196
    fact fr_phos_fill_g = 0.603922
    fact fr_phos_fill_b = 0.533333
    fact fr_ember_r = 0.878431
    fact fr_ember_g = 0.482353
    fact fr_ember_b = 0.180392
    fact fr_ember_fill_r = 0.823529
    fact fr_ember_fill_g = 0.411765
    fact fr_ember_fill_b = 0.117647
    fact fr_flare_r = 0.956863
    fact fr_flare_g = 0.713725
    fact fr_flare_b = 0.235294
    fact fr_muted_r = 0.352941
    fact fr_muted_g = 0.541176
    fact fr_muted_b = 0.494118
    fact fr_ink_r = 0.015686
    fact fr_ink_g = 0.129412
    fact fr_ink_b = 0.113725
    fact fr_steel_900_r = 0.082353
    fact fr_steel_900_g = 0.098039
    fact fr_steel_900_b = 0.105882
    fact fr_steel_700_r = 0.164706
    fact fr_steel_700_g = 0.192157
    fact fr_steel_700_b = 0.203922
    fact fr_steel_500_r = 0.290196
    fact fr_steel_500_g = 0.329412
    fact fr_steel_500_b = 0.349020
    fact fr_steel_300_r = 0.545098
    fact fr_steel_300_g = 0.592157
    fact fr_steel_300_b = 0.611765
    fact fr_engrave_r = 0.603922
    fact fr_engrave_g = 0.650980
    fact fr_engrave_b = 0.670588
    prop pr_ground_r = 0.000000 ~fl.relight
    follow pr_ground_r = fr_ground_r
    prop pr_ground_g = 0.000000 ~fl.relight
    follow pr_ground_g = fr_ground_g
    prop pr_ground_b = 0.000000 ~fl.relight
    follow pr_ground_b = fr_ground_b
    prop pr_hull_r = 0.015686 ~fl.relight
    follow pr_hull_r = fr_hull_r
    prop pr_hull_g = 0.035294 ~fl.relight
    follow pr_hull_g = fr_hull_g
    prop pr_hull_b = 0.031373 ~fl.relight
    follow pr_hull_b = fr_hull_b
    prop pr_hull_raised_r = 0.027451 ~fl.relight
    follow pr_hull_raised_r = fr_hull_raised_r
    prop pr_hull_raised_g = 0.074510 ~fl.relight
    follow pr_hull_raised_g = fr_hull_raised_g
    prop pr_hull_raised_b = 0.066667 ~fl.relight
    follow pr_hull_raised_b = fr_hull_raised_b
    prop pr_well_r = 0.019608 ~fl.relight
    follow pr_well_r = fr_well_r
    prop pr_well_g = 0.164706 ~fl.relight
    follow pr_well_g = fr_well_g
    prop pr_well_b = 0.145098 ~fl.relight
    follow pr_well_b = fr_well_b
    prop pr_trace_dim_r = 0.121569 ~fl.relight
    follow pr_trace_dim_r = fr_trace_dim_r
    prop pr_trace_dim_g = 0.219608 ~fl.relight
    follow pr_trace_dim_g = fr_trace_dim_g
    prop pr_trace_dim_b = 0.200000 ~fl.relight
    follow pr_trace_dim_b = fr_trace_dim_b
    prop pr_trace_r = 0.239216 ~fl.relight
    follow pr_trace_r = fr_trace_r
    prop pr_trace_g = 0.415686 ~fl.relight
    follow pr_trace_g = fr_trace_g
    prop pr_trace_b = 0.376471 ~fl.relight
    follow pr_trace_b = fr_trace_b
    prop pr_trace_lit_r = 0.423529 ~fl.relight
    follow pr_trace_lit_r = fr_trace_lit_r
    prop pr_trace_lit_g = 0.788235 ~fl.relight
    follow pr_trace_lit_g = fr_trace_lit_g
    prop pr_trace_lit_b = 0.682353 ~fl.relight
    follow pr_trace_lit_b = fr_trace_lit_b
    prop pr_phos_r = 0.498039 ~fl.relight
    follow pr_phos_r = fr_phos_r
    prop pr_phos_g = 0.811765 ~fl.relight
    follow pr_phos_g = fr_phos_g
    prop pr_phos_b = 0.713725 ~fl.relight
    follow pr_phos_b = fr_phos_b
    prop pr_phos_fill_r = 0.090196 ~fl.relight
    follow pr_phos_fill_r = fr_phos_fill_r
    prop pr_phos_fill_g = 0.603922 ~fl.relight
    follow pr_phos_fill_g = fr_phos_fill_g
    prop pr_phos_fill_b = 0.533333 ~fl.relight
    follow pr_phos_fill_b = fr_phos_fill_b
    prop pr_ember_r = 0.878431 ~fl.relight
    follow pr_ember_r = fr_ember_r
    prop pr_ember_g = 0.482353 ~fl.relight
    follow pr_ember_g = fr_ember_g
    prop pr_ember_b = 0.180392 ~fl.relight
    follow pr_ember_b = fr_ember_b
    prop pr_ember_fill_r = 0.823529 ~fl.relight
    follow pr_ember_fill_r = fr_ember_fill_r
    prop pr_ember_fill_g = 0.411765 ~fl.relight
    follow pr_ember_fill_g = fr_ember_fill_g
    prop pr_ember_fill_b = 0.117647 ~fl.relight
    follow pr_ember_fill_b = fr_ember_fill_b
    prop pr_flare_r = 0.956863 ~fl.relight
    follow pr_flare_r = fr_flare_r
    prop pr_flare_g = 0.713725 ~fl.relight
    follow pr_flare_g = fr_flare_g
    prop pr_flare_b = 0.235294 ~fl.relight
    follow pr_flare_b = fr_flare_b
    prop pr_muted_r = 0.352941 ~fl.relight
    follow pr_muted_r = fr_muted_r
    prop pr_muted_g = 0.541176 ~fl.relight
    follow pr_muted_g = fr_muted_g
    prop pr_muted_b = 0.494118 ~fl.relight
    follow pr_muted_b = fr_muted_b
    prop pr_ink_r = 0.015686 ~fl.relight
    follow pr_ink_r = fr_ink_r
    prop pr_ink_g = 0.129412 ~fl.relight
    follow pr_ink_g = fr_ink_g
    prop pr_ink_b = 0.113725 ~fl.relight
    follow pr_ink_b = fr_ink_b
    prop pr_steel_900_r = 0.082353 ~fl.relight
    follow pr_steel_900_r = fr_steel_900_r
    prop pr_steel_900_g = 0.098039 ~fl.relight
    follow pr_steel_900_g = fr_steel_900_g
    prop pr_steel_900_b = 0.105882 ~fl.relight
    follow pr_steel_900_b = fr_steel_900_b
    prop pr_steel_700_r = 0.164706 ~fl.relight
    follow pr_steel_700_r = fr_steel_700_r
    prop pr_steel_700_g = 0.192157 ~fl.relight
    follow pr_steel_700_g = fr_steel_700_g
    prop pr_steel_700_b = 0.203922 ~fl.relight
    follow pr_steel_700_b = fr_steel_700_b
    prop pr_steel_500_r = 0.290196 ~fl.relight
    follow pr_steel_500_r = fr_steel_500_r
    prop pr_steel_500_g = 0.329412 ~fl.relight
    follow pr_steel_500_g = fr_steel_500_g
    prop pr_steel_500_b = 0.349020 ~fl.relight
    follow pr_steel_500_b = fr_steel_500_b
    prop pr_steel_300_r = 0.545098 ~fl.relight
    follow pr_steel_300_r = fr_steel_300_r
    prop pr_steel_300_g = 0.592157 ~fl.relight
    follow pr_steel_300_g = fr_steel_300_g
    prop pr_steel_300_b = 0.611765 ~fl.relight
    follow pr_steel_300_b = fr_steel_300_b
    prop pr_engrave_r = 0.603922 ~fl.relight
    follow pr_engrave_r = fr_engrave_r
    prop pr_engrave_g = 0.650980 ~fl.relight
    follow pr_engrave_g = fr_engrave_g
    prop pr_engrave_b = 0.670588 ~fl.relight
    follow pr_engrave_b = fr_engrave_b

    // The islands' semantic tokens, which theme/tokens defines over these facts.
    fact c_bg_primary_r = 0.062745
    fact c_bg_primary_g = 0.078431
    fact c_bg_primary_b = 0.086275
    fact c_bg_secondary_r = 0.086275
    fact c_bg_secondary_g = 0.105882
    fact c_bg_secondary_b = 0.117647
    fact c_surface_primary_r = 0.098039
    fact c_surface_primary_g = 0.121569
    fact c_surface_primary_b = 0.133333
    fact c_surface_elevated_r = 0.133333
    fact c_surface_elevated_g = 0.160784
    fact c_surface_elevated_b = 0.176471
    fact c_border_subtle_r = 0.172549
    fact c_border_subtle_g = 0.207843
    fact c_border_subtle_b = 0.223529
    fact c_fg_primary_r = 0.890196
    fact c_fg_primary_g = 0.913725
    fact c_fg_primary_b = 0.921569
    fact c_fg_secondary_r = 0.639216
    fact c_fg_secondary_g = 0.690196
    fact c_fg_secondary_b = 0.709804
    fact c_fg_muted_r = 0.541176
    fact c_fg_muted_g = 0.592157
    fact c_fg_muted_b = 0.611765
    fact c_accent_primary_r = 0.650980
    fact c_accent_primary_g = 0.952941
    fact c_accent_primary_b = 0.819608
    fact c_accent_secondary_r = 1.000000
    fact c_accent_secondary_g = 0.572549
    fact c_accent_secondary_b = 0.372549
    fact c_status_ok_r = 0.650980
    fact c_status_ok_g = 0.952941
    fact c_status_ok_b = 0.819608
    fact c_status_error_r = 1.000000
    fact c_status_error_g = 0.572549
    fact c_status_error_b = 0.372549
    fact c_focus_ring_r = 0.650980
    fact c_focus_ring_g = 0.952941
    fact c_focus_ring_b = 0.819608
    fact c_selection_bg_r = 0.164706
    fact c_selection_bg_g = 0.227451
    fact c_selection_bg_b = 0.211765
    // What theme/ferrolume reads for its geometry; the studio uses the colour, not the bar's
    // strip, so these are only the values the tokens are defined against.
    fact st_offset = 0
    fact st_notch = false
    fact bar_rail = true
    fact st_height = 30
    fact st_radius = 8
    fact st_res = 46

    fact st_glow = 1
    fact isl_style = 0           // island.style: 0 plate · 1 tether (the island kit reads it)

    // ── What the services report (the rows are drawn straight from them) ──
    model nets max 8 { ssid: text; strength: number; secure: bool; known: bool; active: bool }
    service network { online: bool; kind: text; name: text; strength: number; wifi: bool; networks: nets }
    model btd max 8 { name: text; address: text; paired: bool; connected: bool; battery: number }
    service bluetooth { present: bool; powered: bool; devices: btd }
    model outs max 8 { id: text; name: text; default: bool }
    model apps max 8 { id: text; name: text; volume: number; muted: bool; playing: bool }
    service audio { volume: number; muted: bool; input: number; input_muted: bool; outputs: outs; apps: apps }
    service brightness { present: bool; level: number }
    service battery { present: bool; percent: number; charging: bool }
    service media as med { playing: bool; title: text; artist: text; player: text }
    model wss max 16 { id: number; windows: number; active: bool }
    service workspaces as wks { list: wss }
    service clock { time: text = "--:--"; date: text }

    // ── What the logic tells the drawer ──
    fact nx_open = false         // in (true) or sliding away
    fact nx_h = 900              // the drawer's height (the screen below the bar)
    fact nx_top = 46             // the bar's reserve: the drawer starts under it
    fact nx_sy = 0               // how far the column is scrolled
    fact nx_total = 900          // the column's full height (lib/nexusdrawer)
    text nx_name = "mooi"
    text nx_who = ""
    text nx_avatar = ""
    fact nx_avatar_on = false
    text nx_banner = ""
    fact nx_banner_on = false
    text nx_uptime = ""
    fact nx_naming = false       // the name is being typed
    text nx_name_in = ""         // what is typed there
    text nx_notice = ""          // a word after an import (or why it failed)
    text nx_initial = "M"
    // the column: each section's top and height, and whether it is folded
    fact y_levels = 0
    fact y_media = 0
    fact y_notes = 0
    fact y_connections = 0
    fact y_sound = 0
    fact y_machine = 0
    fact y_today = 0
    fact y_updates = 0
    fact y_workspaces = 0
    fact y_shortcuts = 0
    fact f_levels = false
    fact f_media = false
    fact f_notes = false
    fact f_connections = false
    fact f_sound = false
    fact f_machine = false
    fact f_today = false
    fact f_updates = false
    fact f_workspaces = false
    fact f_shortcuts = false
    // the bar's own switches, asked of the bar every 2 s while the drawer is open
    fact b_dnd = false
    fact b_awake = false
    fact b_rec = false
    fact b_night = false
    fact b_saver = false
    text bt_empty = "No devices paired"
    // ── The orbit (D99, lib/nexusorbit): its nodes, the rest as chips, the arcs, the backdrop ──
    model orbit max 8 { word: text; state: text; on: bool; glyph: number; x: number; y: number; p1x: number; p1y: number; p2x: number; p2y: number; p3x: number; p3y: number }
    model rest max 12 { word: text; on: bool }
    fact orb_bg = 0              // 0 banner · 1 circuit · 2 plain
    fact nx_bw2 = 386            // the banner drawn to cover the board
    fact nx_bh2 = 452
    fact arc_v0 = 0
    fact arc_v1 = 0
    fact arc_v2 = 0
    text arc_l0 = ""
    text arc_l1 = ""
    text arc_l2 = ""
    fact pulse_n = -1            // the node whose pulse is running home
    fact nx_custom = false       // the customise sheet is open
    model cus_nodes max 12 { word: text; on: bool }
    model cus_arcs max 8 { word: text; on: bool }
    // now playing
    text nx_art = ""
    fact nx_art_on = false
    fact nx_prog = 0
    text nx_elapsed = ""
    text nx_length = ""
    // notifications (the bar's nexus-feed.json)
    model feed max 5 { app: text; title: text; ago: text }
    fact feed_n = 0
    fact feed_ok = false
    // machine
    fact m_cpu = 0
    fact m_temp = 0
    fact m_mem = 0
    text m_mem_t = ""
    fact m_disk = 0
    text m_disk_t = ""
    fact m_gpu = 0
    fact m_gpu_ok = false
    text m_bat_t = ""
    // today
    model days max 7 { label: text; day: number; today: bool }
    fact wx_ok = false
    fact wx_kind = 2
    fact wx_temp = 0
    text wx_word = ""
    text wx_place = ""
    // updates (the bar's updates.json)
    fact upd_n = 0
    fact upd_ok = false
    text upd_t = "No word from the bar yet"

    event nx_close ->            // to the logic: slide away and end
    event nx_node ->             // to the logic: node n of the orbit pressed (flip it, or open it)
    event nx_rest ->             // to the logic: chip n (the toggles not in the orbit) pressed
    event nx_cus ->              // to the logic: customise — 100 + n a node in or out · 200 + n an arc · 300 + n the backdrop
    event nx_pulse               // a node was pressed: its trace carries a pulse home
    event nx_pick ->             // to the logic: choose a picture — 0 the avatar · 1 the banner (a file picker, then `mooi identity`)
    event nx_rename ->           // to the logic: the name typed (read from the field)
    event nx_fold ->             // to the logic: fold or unfold section n (lib/nexusdrawer ORDER, from 0)
    event nx_tog ->              // to the logic: quick toggle n (0 Wi-Fi … 8 record)
    event nx_go ->               // to the logic: open something (codes in mooi-nexus.luau GO)
    event nx_media ->            // to the logic: 0 previous · 1 play/pause · 2 next
    event nx_net ->              // to the logic: join network n (its place in network.networks)
    event nx_bt ->               // to the logic: connect or disconnect device n
    event nx_out ->              // to the logic: make output n the default
    event nx_app ->              // to the logic: 1000 · app + level (0..1000)
    event nx_ws ->               // to the logic: go to workspace n
    event vol ->                 // to the logic: the output level (0..1)
    event mic ->                 // to the logic: the microphone's level (0..1)
    event bri ->                 // to the logic: the brightness (0..1)

    figure i_nexus = file "icons/nexus.svg"
    figure i_set = file "icons/cog.svg"
    figure i_lock = file "icons/lock.svg"
    figure i_power = file "icons/power.svg"
    figure i_wifi = file "icons/wifi.svg"
    figure i_wifi_off = file "icons/wifi-off.svg"
    figure i_bt = file "icons/bluetooth.svg"
    figure i_bt_off = file "icons/bluetooth-off.svg"
    figure i_vol = file "icons/volume.svg"
    figure i_vol_off = file "icons/volume-mute.svg"
    figure i_mic = file "icons/mic.svg"
    figure i_mic_off = file "icons/mic-off.svg"
    figure i_bell = file "icons/bell.svg"
    figure i_night = file "icons/night.svg"
    figure i_caf = file "icons/caffeine.svg"
    figure i_rec = file "icons/recorder.svg"
    figure i_shot = file "icons/screenshot.svg"
    figure i_bolt = file "icons/bolt.svg"
    figure i_clear = file "icons/clear.svg"
    figure i_cloud = file "icons/cloud.svg"
    figure i_fog = file "icons/fog.svg"
    figure i_rain = file "icons/rain.svg"
    figure i_snow = file "icons/snow.svg"
    figure i_storm = file "icons/storm.svg"
    image avatar = from nx_avatar, 72, 72
    image banner = from nx_banner, 960, 540
    image cover = from nx_art, 84, 84

    // ── Motion ───────────────────────────────────────────────
    spring nx.slide = 900, 62        // ~220 ms in and out
    prop nx_in = 0 ~nx.slide
    follow nx_in = if(nx_open, 1, 0)
    prop sv = 0 ~m.select
    follow sv = nx_sy
    spring nx.rail = 160, 26         // ~500 ms, soft
    // the arcs, gliding; the pulse, running home along a trace in 550 ms
    prop ra0 = 0 ~nx.rail
    follow ra0 = arc_v0
    prop ra1 = 0 ~nx.rail
    follow ra1 = arc_v1
    prop ra2 = 0 ~nx.rail
    follow ra2 = arc_v2
    prop pulse_p = 0
    layer pulse ~1ms {
        go for 600ms after nx_pulse { pulse_p: 1 ~550ms }
        idle                         { pulse_p: 0 ~1ms }
    }
    // the rail's channels, gliding to each reading
    prop rc_cpu = 0 ~nx.rail
    follow rc_cpu = m_cpu
    prop rc_mem = 0 ~nx.rail
    follow rc_mem = m_mem
    prop rc_gpu = 0 ~nx.rail
    follow rc_gpu = if(m_gpu_ok, m_gpu, 0)
    prop rc_tmp = 0 ~nx.rail
    follow rc_tmp = clamp((m_temp - 30) / 70, 0, 1)
    prop rc_song = 0 ~nx.rail
    follow rc_song = nx_prog

    // A section's header line at its top `y`: its name, a short line on the right, the fold
    // chevron; a press folds or unfolds it.
    component SecHead(y: number, title: text, sub: text, folded: bool, code: number) {
        size: 388, 30
        zone box h { from: 16, y; size: 388, 26; cursor: pointer; role: toggle; checked: not folded; label: "{title} — fold or unfold" }
        group {
            show: isl_style < 0.5
            text "{upper(title)}" { at: 30, y + 13; anchor: left center; size: 10; weight: 700; family: "Share Tech Mono"; color: mix(fl.phos, fl.engrave, 0.3 * h.hover) }
            line { from: 30, y + 25; to: 52, y + 25; width: 1.2; color: fl.phos; opacity: 0.7 }
            text sub { at: 380, y + 13; anchor: right center; align: right; size: 9.5; family: "Share Tech Mono"; color: fl.muted; width: 220; lines: 1 }
        }
        group {
            show: isl_style > 0.5
            text title { at: 30, y + 13; anchor: left center; size: 13; weight: 600; family: "Exo 2"; color: mix(fg.primary, accent.primary, 0.4 * h.hover) }
            text sub { at: 380, y + 13; anchor: right center; align: right; size: 10.5; family: "Exo 2"; color: fg.secondary; width: 220; lines: 1 }
        }
        path { stroke: 1.4; color: if(isl_style > 0.5, fg.secondary, fl.muted)
               move 391, y + if(folded, 9, 11); line 395, y + if(folded, 13, 15); line 399, y + if(folded, 9, 11) }
        on press h { emit nx_fold(code) }
    }

    // A node's glyph `g` (lib/nexusorbit NODES' glyph), centred at (x, y), in colour `c`.
    component Gl(x: number, y: number, g: number, c: color) {
        size: 16, 16
        figure i_wifi { at: x, y; size: 16, 16; color: c; show: g < 0.5 }
        figure i_bt { at: x, y; size: 16, 16; color: c; show: g > 0.5 and g < 1.5 }
        figure i_vol { at: x, y; size: 16, 16; color: c; show: g > 1.5 and g < 2.5 }
        figure i_mic { at: x, y; size: 16, 16; color: c; show: g > 2.5 and g < 3.5 }
        figure i_bell { at: x, y; size: 16, 16; color: c; show: g > 3.5 and g < 4.5 }
        figure i_night { at: x, y; size: 16, 16; color: c; show: g > 4.5 and g < 5.5 }
        figure i_caf { at: x, y; size: 16, 16; color: c; show: g > 5.5 and g < 6.5 }
        figure i_bolt { at: x, y; size: 16, 16; color: c; show: g > 6.5 and g < 7.5 }
        figure i_rec { at: x, y; size: 16, 16; color: c; show: g > 7.5 and g < 8.5 }
        figure i_lock { at: x, y; size: 16, 16; color: c; show: g > 8.5 and g < 9.5 }
        figure i_set { at: x, y; size: 16, 16; color: c; show: g > 9.5 and g < 10.5 }
        figure i_shot { at: x, y; size: 16, 16; color: c; show: g > 10.5 }
    }

    // A weather glyph of kind `k` (lib/sysinfo WEATHER_KINDS), centred at (x, y), `sz` across.
    component Glyph(x: number, y: number, sz: number, k: number) {
        size: sz, sz
        figure i_clear { at: x, y; size: sz, sz; color: fl.flare; show: k < 0.5 }
        figure i_night { at: x, y; size: sz, sz; color: if(isl_style > 0.5, fg.primary, fl.engrave); show: k > 0.5 and k < 1.5 }
        figure i_cloud { at: x, y; size: sz, sz; color: if(isl_style > 0.5, fg.primary, fl.engrave); show: k > 1.5 and k < 2.5 }
        figure i_fog { at: x, y; size: sz, sz; color: if(isl_style > 0.5, fg.primary, fl.engrave); show: k > 2.5 and k < 3.5 }
        figure i_rain { at: x, y; size: sz, sz; color: if(isl_style > 0.5, fg.primary, fl.engrave); show: k > 3.5 and k < 4.5 }
        figure i_snow { at: x, y; size: sz, sz; color: if(isl_style > 0.5, fg.primary, fl.engrave); show: k > 4.5 and k < 5.5 }
        figure i_storm { at: x, y; size: sz, sz; color: fl.ember; show: k > 5.5 }
    }

    surface nexus {
        // the whole height: nothing is drawn above nx_top, and where nothing is drawn a press goes
        // through to the bar under it
        size: 440, full
        anchor: top_right
        level: top
        keyboard: on_demand

        on key Escape while not nx_naming { emit nx_close }

        group {
            move: 460 * (1 - nx_in) + 22, nx_top
            opacity: smooth(0, 0.6, nx_in)
            IslandFrame(1, 404, nx_h - 8) {
                // the viewport: the column scrolls under the head
                zone box view { from: 0, 0; size: 404, nx_h; role: region; label: "The Control Nexus" }
                on scroll view { nx_sy = clamp(nx_sy - wheel * 64, 0, max(0, nx_total - nx_h + 24)) }
            }
        }

        // ── The rail: the machine's pulse down the drawer's edge ──
        // Five channels — processor, memory, graphics, temperature, and the song's place — each
        // filling from the bottom on a slow spring, hot ones in the warning colour. They move only
        // when a reading changes (every 2 s), so the drawer still rests between readings.
        group {
            move: 460 * (1 - nx_in) + 3, nx_top + 10
            opacity: smooth(0.2, 0.9, nx_in)
            let rch = (nx_h - 36 - 4 * 10) / 5
            repeat c in 0..5 {
                let rv = pick(c, rc_cpu, rc_mem, rc_gpu, rc_tmp, rc_song)
                let hot = pick(c, m_cpu > 0.85, m_mem > 0.9, m_gpu > 0.9, m_temp > 85, false)
                let ry = c * (rch + 10)
                box { from: 0, ry; size: 12, rch; corner: if(isl_style > 0.5, 6, 2); color: if(isl_style > 0.5, bg.primary, fl.well); opacity: 0.85 }
                box { from: 0, ry; size: 12, rch; corner: if(isl_style > 0.5, 6, 2); stroke: 1; color: if(isl_style > 0.5, border.subtle, fl.trace_dim) }
                group {
                    glow: 7, (0.55 + 0.45 * rv) * st_glow, if(hot, fl.ember, if(isl_style > 0.5, accent.primary, fl.phos))
                    box { from: 2, ry + rch - 2 - (rch - 4) * clamp(rv, 0, 1); size: 8, (rch - 4) * clamp(rv, 0, 1); corner: if(isl_style > 0.5, 4, 1)
                          color: if(hot, fl.ember, if(isl_style > 0.5, accent.primary, fl.phos)) }
                }
                // plate: the instrument's ticks every tenth
                repeat t in 1..10 {
                    box { from: 0, ry + rch * t / 10; size: 3, 1; color: fl.trace_dim; opacity: 0.8; show: isl_style < 0.5 }
                }
                zone box rz.$c { from: -2, ry; size: 16, rch; role: region; label: pick(c, "Processor", "Memory", "Graphics", "Temperature", "The song") }
            }
        }

        group {
            move: 460 * (1 - nx_in) + 14, nx_top
            opacity: smooth(0, 0.6, nx_in)
            group {
                // what scrolls stays under the head
                clip box { from: 0, 0; size: 440, nx_h - 8 }

            // ── The orbit (D99): you at the core of a circuit board, your nodes wired to you ──
            group {
                move: 0, -sv
                // the board behind it: your banner, a circuit pattern, or nothing (nexus.orbit.backdrop)
                group {
                    clip box { from: 17, 9; size: 386, 464; corner: if(isl_style > 0.5, 16, 0) }
                    group {
                        show: orb_bg < 0.5
                        body {
                            gradient: 17, 9 to 403, 473, mix(if(isl_style > 0.5, accent.primary, fl.phos), #000000, 0.55), mix(if(isl_style > 0.5, accent.secondary, fl.ember), #000000, 0.7)
                            box { from: 17, 9; size: 386, 464 }
                        }
                        image banner { at: 210 - nx_bw2 / 2, 235 - nx_bh2 / 2; size: nx_bw2, nx_bh2; opacity: 0.55; show: nx_banner_on }
                    }
                    group {
                        show: orb_bg > 0.5 and orb_bg < 1.5
                        box { from: 17, 9; size: 386, 464; color: mix(if(isl_style > 0.5, bg.primary, fl.hull), if(isl_style > 0.5, accent.primary, fl.phos), 0.06) }
                        // a board's copper: a grid, and runs between pads, fixed (random by place, never moving)
                        repeat g in 0..16 {
                            line { from: 17 + g * 26, 9; to: 17 + g * 26, 461; width: 1; color: if(isl_style > 0.5, accent.primary, fl.phos); opacity: 0.09 }
                        }
                        repeat g in 0..18 {
                            line { from: 17, 9 + g * 26; to: 403, 9 + g * 26; width: 1; color: if(isl_style > 0.5, accent.primary, fl.phos); opacity: 0.09 }
                        }
                        repeat q in 0..22 {
                            let qx = 30 + floor(random(q) * 14) * 26
                            let qy = 22 + floor(random(q + 50) * 16) * 26
                            path { stroke: 1.3; color: if(isl_style > 0.5, accent.primary, fl.phos); opacity: 0.26
                                   move qx, qy; line qx + 26 * (1 + floor(random(q + 9) * 3)), qy; line qx + 26 * (1 + floor(random(q + 9) * 3)) + 13, qy + 13 }
                            ellipse { at: qx, qy; radius: 2.4; color: if(isl_style > 0.5, accent.primary, fl.phos); opacity: 0.4 }
                        }
                    }
                    box { from: 17, 9; size: 386, 464; color: if(isl_style > 0.5, bg.primary, fl.hull); opacity: if(orb_bg > 1.5, 0.9, 0.35) }
                    box { from: 17, 404; size: 386, 30; color: if(isl_style > 0.5, bg.primary, fl.hull); opacity: 0.35 }
                    box { from: 17, 434; size: 386, 39; color: if(isl_style > 0.5, bg.primary, fl.hull); opacity: 0.7 }
                    zone box bz { from: 17, 9; size: 386, 464; cursor: pointer; role: button; label: "Change the banner" }
                    on press bz { emit nx_pick(1) }
                }

                // the time, and the ways out
                text clock.time { at: 34, 40; anchor: left center; size: 30; weight: 300; family: "Exo 2"; color: #ffffff; shadow: 0, 1, 8, 70%, #000000 }
                text clock.date { at: 36, 64; anchor: left center; size: 10.5; family: "Share Tech Mono"; color: #ffffff; opacity: 0.8; shadow: 0, 1, 6, 70%, #000000 }
                box { from: 226, 20; size: 168, 30; corner: 15; color: #000000; opacity: 0.45 }
                zone box hcus { from: 230, 22; size: 28, 26; cursor: pointer; role: toggle; checked: nx_custom; label: "Customise the orbit" }
                text "✎" { at: 244, 35; anchor: center; align: center; size: 14; color: if(nx_custom, if(isl_style > 0.5, accent.primary, fl.phos), #ffffff); opacity: 0.75 + 0.25 * hcus.hover }
                on press hcus { nx_custom = not nx_custom }
                zone box hset { from: 262, 22; size: 28, 26; cursor: pointer; role: button; label: "mooi's settings" }
                figure i_set { at: 276, 35; size: 15, 15; color: #ffffff; opacity: 0.75 + 0.25 * hset.hover }
                on press hset { emit nx_go(1) }
                zone box hlock { from: 294, 22; size: 28, 26; cursor: pointer; role: button; label: "Lock the screen" }
                figure i_lock { at: 308, 35; size: 15, 15; color: #ffffff; opacity: 0.75 + 0.25 * hlock.hover }
                on press hlock { emit nx_go(2) }
                zone box hpow { from: 326, 22; size: 28, 26; cursor: pointer; role: button; label: "The session menu" }
                figure i_power { at: 340, 35; size: 15, 15; color: #ffffff; opacity: 0.75 + 0.25 * hpow.hover }
                on press hpow { emit nx_go(3) }
                zone box hx { from: 358, 22; size: 28, 26; cursor: pointer; role: button; label: "Close the Control Nexus" }
                text "×" { at: 372, 35; anchor: center; align: center; size: 17; weight: 600; color: #ffffff; opacity: 0.75 + 0.25 * hx.hover }
                on press hx { emit nx_close }

                // the bus: a dashed ring the traces cross
                repeat d in 0..48 {
                    arc { at: 210, 236; radius: 122; width: 1.2; span: 3deg; rotate: d * 7.5deg; color: if(isl_style > 0.5, accent.primary, fl.phos); opacity: 0.35 }
                }
                // the arcs: three readings round the core (nexus.orbit.arcs)
                repeat k in 0..3 {
                    let ar = 70 + k * 11
                    let av = pick(k, ra0, ra1, ra2)
                    arc { at: 210, 236; radius: ar; width: 6; span: 300deg; rotate: 0deg; color: #ffffff; opacity: 0.07 }
                    group {
                        glow: 6, (0.6) * st_glow, pick(k, if(isl_style > 0.5, accent.primary, fl.phos), mix(if(isl_style > 0.5, accent.primary, fl.phos), #ffffff, 0.45), mix(if(isl_style > 0.5, accent.primary, fl.phos), if(isl_style > 0.5, accent.secondary, fl.ember), 0.35))
                        arc { at: 210, 236; radius: ar; width: 6; span: max(1, 300 * clamp(av, 0, 1)) * 1deg; rotate: (-150 + 150 * clamp(av, 0, 1)) * 1deg; color: pick(k, if(isl_style > 0.5, accent.primary, fl.phos), mix(if(isl_style > 0.5, accent.primary, fl.phos), #ffffff, 0.45), mix(if(isl_style > 0.5, accent.primary, fl.phos), if(isl_style > 0.5, accent.secondary, fl.ember), 0.35)) }
                    }
                }
                // the traces, their vias, and a pulse running home from a pressed node
                for o in orbit {
                    path { stroke: if(o.on, 2, 1.4); color: if(o.on, if(isl_style > 0.5, accent.primary, fl.phos), if(isl_style > 0.5, fg.muted, fl.muted)); opacity: if(o.on, 0.95, 0.45)
                           move o.p1x, o.p1y; line o.p2x, o.p2y; line o.p3x, o.p3y }
                    ellipse { at: o.p2x, o.p2y; radius: 3; color: if(isl_style > 0.5, bg.primary, fl.hull) }
                    ellipse { at: o.p2x, o.p2y; radius: 3; stroke: 1.2; color: if(o.on, if(isl_style > 0.5, accent.primary, fl.phos), if(isl_style > 0.5, fg.muted, fl.muted)) }
                    ellipse { at: o.p1x, o.p1y; radius: 2.2; color: if(o.on, if(isl_style > 0.5, accent.primary, fl.phos), if(isl_style > 0.5, fg.muted, fl.muted)) }
                    group {
                        show: pulse_n == o.index and pulse_p > 0.01 and pulse_p < 0.99
                        glow: 8, (1) * st_glow, if(isl_style > 0.5, accent.secondary, fl.ember)
                        ellipse { at: if(pulse_p < 0.5, o.p3x + (o.p2x - o.p3x) * pulse_p * 2, o.p2x + (o.p1x - o.p2x) * (pulse_p - 0.5) * 2), if(pulse_p < 0.5, o.p3y + (o.p2y - o.p3y) * pulse_p * 2, o.p2y + (o.p1y - o.p2y) * (pulse_p - 0.5) * 2); radius: 3.5; color: #ffffff }
                    }
                }
                // the nodes: hexagonal pads, lit when on, a press flips or opens
                for o in orbit {
                    zone box nzo { from: o.x - 22, o.y - 22; size: 44, 44; cursor: pointer; role: toggle; checked: o.on; label: "{o.word} — {o.state}" }
                    group {
                        glow: 7, (if(o.on, 0.8, 0)) * st_glow, if(isl_style > 0.5, accent.primary, fl.phos)
                        path { color: if(o.on, if(isl_style > 0.5, accent.primary, fl.phos), mix(if(isl_style > 0.5, bg.primary, fl.hull), if(isl_style > 0.5, accent.primary, fl.phos), 0.12 + 0.18 * nzo.hover))
                               move o.x + 20, o.y; line o.x + 10, o.y + 17.3; line o.x - 10, o.y + 17.3; line o.x - 20, o.y; line o.x - 10, o.y - 17.3; line o.x + 10, o.y - 17.3; close }
                    }
                    path { stroke: 1.3; color: if(o.on, if(isl_style > 0.5, accent.primary, fl.phos), mix(if(isl_style > 0.5, fg.muted, fl.muted), if(isl_style > 0.5, accent.primary, fl.phos), nzo.hover))
                           move o.x + 20, o.y; line o.x + 10, o.y + 17.3; line o.x - 10, o.y + 17.3; line o.x - 20, o.y; line o.x - 10, o.y - 17.3; line o.x + 10, o.y - 17.3; close }
                    Gl(o.x, o.y, o.glyph, if(o.on, if(isl_style > 0.5, bg.primary, fl.hull), #ffffff))
                    text o.word { at: o.x, o.y + 29; anchor: center; align: center; size: 9; weight: 600; family: "Exo 2"; color: #ffffff; opacity: 0.85; width: 70; lines: 1
                                  shadow: 0, 1, 4, 80%, #000000 }
                    on press nzo { pulse_n = o.index; emit nx_pulse; emit nx_node(o.index) }
                }
                // the core: you, ringed
                zone box az { from: 156, 182; size: 108, 108; cursor: pointer; role: button; label: "Change the profile picture" }
                group {
                    glow: 10, (0.8) * st_glow, if(isl_style > 0.5, accent.primary, fl.phos)
                    ellipse { at: 210, 236; radius: 55; color: if(isl_style > 0.5, accent.primary, fl.phos) }
                }
                ellipse { at: 210, 236; radius: 52.5; color: if(isl_style > 0.5, bg.primary, fl.hull) }
                group {
                    clip box { from: 160, 186; size: 100, 100; corner: 50 }
                    box { from: 160, 186; size: 100, 100; color: if(isl_style > 0.5, surface.elevated, fl.well) }
                    image avatar { at: 160, 186; size: 100, 100; show: nx_avatar_on }
                    text nx_initial { at: 210, 236; anchor: center; align: center; size: 36; weight: 700; family: "Exo 2"; color: if(isl_style > 0.5, accent.primary, fl.phos); show: not nx_avatar_on }
                    box { from: 160, 262; size: 100, 24; color: #000000; opacity: 0.6 * az.hover }
                    text "edit" { at: 210, 273; anchor: center; align: center; size: 10; family: "Exo 2"; color: #ffffff; opacity: az.hover }
                }
                on press az { emit nx_pick(0) }
                // the arcs' legend: one line under the name
                repeat k in 0..3 {
                    let lx = 70 + k * 140
                    ellipse { at: lx - 10, 458; radius: 3; color: pick(k, if(isl_style > 0.5, accent.primary, fl.phos), mix(if(isl_style > 0.5, accent.primary, fl.phos), #ffffff, 0.45), mix(if(isl_style > 0.5, accent.primary, fl.phos), if(isl_style > 0.5, accent.secondary, fl.ember), 0.35)) }
                    text pick(k, arc_l0, arc_l1, arc_l2) { at: lx - 2, 458; anchor: left center; size: 9.5; family: "Share Tech Mono"; color: #ffffff; opacity: 0.85
                         width: 120; lines: 1; shadow: 0, 1, 4, 80%, #000000 }
                }
                // the name (a press renames), who, how long
                zone box nz { from: 110, 412; size: 200, 26; cursor: text; role: button; label: "Rename" }
                text nx_name { at: 210, 424; anchor: center; align: center; size: 19; weight: 700; family: "Exo 2"; color: #ffffff; width: 260; lines: 1; show: not nx_naming
                               shadow: 0, 1, 6, 70%, #000000 }
                group {
                    show: nx_naming
                    box { from: 100, 411; size: 220, 26; corner: 6; color: if(isl_style > 0.5, surface.elevated, fl.well) }
                    box { from: 100, 411; size: 220, 26; corner: 6; stroke: 1; color: if(isl_style > 0.5, accent.primary, fl.phos) }
                    input nx_name_in { at: 106, 416; width: 208; size: 14; family: "Exo 2"; color: if(isl_style > 0.5, fg.primary, fl.engrave); selection: if(isl_style > 0.5, selection.bg, fl.well)
                                       placeholder: "Your name, then Enter" }
                }
                on press nz while not nx_naming { nx_naming = true; focus nx_name_in }
                on submit nx_name_in { nx_naming = false; emit nx_rename; blur }
                on key Escape while nx_naming { nx_naming = false; blur }
                text "{nx_who}{?  ·  {nx_uptime}}" { at: 210, 442; anchor: center; align: center; size: 10; family: "Share Tech Mono"; color: #ffffff; opacity: 0.75; width: 360; lines: 1 }
                text nx_notice { at: 392, 72; anchor: right center; align: right; size: 9.5; family: "Share Tech Mono"; color: if(isl_style > 0.5, accent.primary, fl.phos); width: 300; lines: 1 }
                // what is not in the orbit: chips under it
                for r in rest {
                    let rx = 18 + mod(r.index, 4) * 97
                    let ry = 480
                    group {
                        show: r.index < 4
                        zone box rzo { from: rx, ry; size: 92, 22; cursor: pointer; role: toggle; checked: r.on; label: r.word }
                        IsleBtn(rx, ry, 92, r.word, if(r.on, 1, 0), rzo.hover, 22)
                        on press rzo { emit nx_rest(r.index) }
                    }
                }
            }

            // ── Levels ──
            group {
                show: y_levels > 0
                move: 0, y_levels - sv
                SecHead(0, "Levels", pick(audio.muted, "{round(audio.volume * 100), 0} %", "muted"), f_levels, 0)
                group {
                    show: not f_levels
                    group { move: 30, 34
                            Level("Volume", pick(audio.muted, "{round(audio.volume * 100), 0} %", "Muted"), audio.volume * (1 - audio.muted), false, vol, 360) }
                    group { move: 30, 74
                            Level("Microphone", pick(audio.input_muted, "{round(audio.input * 100), 0} %", "Muted"), audio.input * (1 - audio.input_muted), false, mic, 360) }
                    group { show: brightness.present
                            move: 30, 114
                            Level("Brightness", "{round(brightness.level * 100), 0} %", brightness.level, false, bri, 360) }
                }
            }
            // ── Now playing ──
            group {
                show: y_media > 0
                move: 0, y_media - sv
                SecHead(0, "Now playing", med.player, f_media, 1)
                group {
                    show: not f_media
                    zone box mcov { from: 30, 34; size: 84, 84; cursor: pointer; role: button; label: "Open the music player" }
                    box { from: 30, 34; size: 84, 84; corner: 6; color: if(isl_style > 0.5, surface.elevated, fl.well) }
                    image cover { at: 30, 34; size: 84, 84; show: nx_art_on }
                    on press mcov { emit nx_go(20) }
                    text med.title { at: 128, 46; anchor: left center; size: 13; weight: 600; family: "Exo 2"; color: if(isl_style > 0.5, fg.primary, fl.engrave); width: 248; lines: 1 }
                    text med.artist { at: 128, 64; anchor: left center; size: 11; family: "Exo 2"; color: if(isl_style > 0.5, fg.secondary, fl.muted); width: 248; lines: 1 }
                    zone box mprev { from: 128, 78; size: 40, 24; cursor: pointer; role: button; label: "Previous" }
                    IsleBtn(128, 78, 40, "‹‹", 0, mprev.hover)
                    zone box mplay { from: 174, 78; size: 56, 24; cursor: pointer; role: button; label: "Play or pause" }
                    group { show: med.playing
                            IsleBtn(174, 78, 56, "Pause", 1, mplay.hover) }
                    group { show: not med.playing
                            IsleBtn(174, 78, 56, "Play", 0, mplay.hover) }
                    zone box mnext { from: 236, 78; size: 40, 24; cursor: pointer; role: button; label: "Next" }
                    IsleBtn(236, 78, 40, "››", 0, mnext.hover)
                    on press mprev { emit nx_media(0) }
                    on press mplay { emit nx_media(1) }
                    on press mnext { emit nx_media(2) }
                    IsleMeter(128, 110, 248, nx_prog)
                    text nx_elapsed { at: 128, 124; anchor: left center; size: 9; family: "Share Tech Mono"; color: if(isl_style > 0.5, fg.muted, fl.muted) }
                    text nx_length { at: 376, 124; anchor: right center; size: 9; family: "Share Tech Mono"; color: if(isl_style > 0.5, fg.muted, fl.muted) }
                }
            }
            // ── Notifications ──
            group {
                show: y_notes > 0
                move: 0, y_notes - sv
                SecHead(0, "Notifications", pick(feed_n > 0, "none", "{feed_n, 0} waiting"), f_notes, 2)
                group {
                    show: not f_notes
                    text pick(feed_ok, "The bar has not said yet", "Nothing waiting") { at: 30, 44; anchor: left center; size: 12; family: "Exo 2"; color: if(isl_style > 0.5, fg.muted, fl.muted); show: feed_n < 1 }
                    for f in feed {
                        let fy = 30 + f.index * 30
                        zone box fz { from: 16, fy; size: 388, 28; cursor: pointer; role: item; label: "{f.app}: {f.title}" }
                        box { from: 18, fy + 1; size: 384, 26; corner: if(isl_style > 0.5, 8, 2); color: if(isl_style > 0.5, selection.bg, fl.well); opacity: 0.6 * fz.hover }
                        text f.app { at: 30, fy + 14; anchor: left center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(isl_style > 0.5, accent.primary, fl.phos); width: 96; lines: 1 }
                        text f.title { at: 132, fy + 14; anchor: left center; size: 12; family: "Exo 2"; color: if(isl_style > 0.5, fg.primary, fl.engrave); width: 210; lines: 1 }
                        text f.ago { at: 392, fy + 14; anchor: right center; size: 9.5; family: "Share Tech Mono"; color: if(isl_style > 0.5, fg.muted, fl.muted) }
                        on press fz { emit nx_go(30) }
                    }
                    zone box nfield { from: 30, 36 + max(1, min(5, feed_n)) * 30; size: 170, 24; cursor: pointer; role: button; label: "Open the Signal Field" }
                    IsleBtn(30, 36 + max(1, min(5, feed_n)) * 30, 170, "All notifications", 0, nfield.hover)
                    on press nfield { emit nx_go(30) }
                    group { show: feed_n > 0
                            zone box nclear { from: 216, 36 + max(1, min(5, feed_n)) * 30; size: 160, 24; cursor: pointer; role: button; label: "Clear every notification" }
                            IsleBtn(216, 36 + max(1, min(5, feed_n)) * 30, 160, "Clear all", 0, nclear.hover)
                            on press nclear { emit nx_go(31) } }
                }
            }
            // ── Connections ──
            group {
                show: y_connections > 0
                move: 0, y_connections - sv
                SecHead(0, "Connections", pick(network.online, "offline", network.name), f_connections, 3)
                group {
                    show: not f_connections
                    text "WI-FI" { at: 30, 42; anchor: left center; size: 9; weight: 700; family: "Share Tech Mono"; color: if(isl_style > 0.5, fg.secondary, fl.muted) }
                    text pick(network.wifi, "Wi-Fi is off", "No networks in reach") { at: 30, 68; anchor: left center; size: 12; family: "Exo 2"; color: if(isl_style > 0.5, fg.muted, fl.muted); show: nets.count < 1 }
                    for w in nets {
                        let wy = 54 + w.index * 30
                        group {
                            show: w.index < 5
                            zone box wz { from: 16, wy; size: 388, 28; cursor: pointer; role: item; selected: w.active; label: "Join {w.ssid}" }
                            box { from: 18, wy + 1; size: 384, 26; corner: if(isl_style > 0.5, 8, 2); color: if(isl_style > 0.5, selection.bg, fl.well); opacity: max(if(w.active, 0.9, 0), 0.6 * wz.hover) }
                            repeat b in 0..4 {
                                box { from: 30 + b * 4, wy + 19 - b * 3; size: 3, 3 + b * 3; corner: 1
                                      color: if(w.strength > b * 25, if(isl_style > 0.5, accent.primary, fl.phos), if(isl_style > 0.5, fg.muted, fl.muted)); opacity: if(w.strength > b * 25, 1, 0.4) }
                            }
                            text w.ssid { at: 56, wy + 14; anchor: left center; size: 12; family: "Exo 2"; width: 250; lines: 1; color: if(w.active, if(isl_style > 0.5, accent.primary, fl.phos), if(isl_style > 0.5, fg.primary, fl.engrave)) }
                            text "connected" { at: 392, wy + 14; anchor: right center; size: 9.5; family: "Share Tech Mono"; color: if(isl_style > 0.5, fg.muted, fl.muted); show: w.active }
                            text "saved" { at: 392, wy + 14; anchor: right center; size: 9.5; family: "Share Tech Mono"; color: if(isl_style > 0.5, fg.muted, fl.muted); show: not w.active and w.known }
                            text "locked" { at: 392, wy + 14; anchor: right center; size: 9.5; family: "Share Tech Mono"; color: if(isl_style > 0.5, fg.muted, fl.muted); show: not w.active and not w.known and w.secure }
                            text "open" { at: 392, wy + 14; anchor: right center; size: 9.5; family: "Share Tech Mono"; color: if(isl_style > 0.5, fg.muted, fl.muted); show: not w.active and not w.known and not w.secure }
                            on press wz { emit nx_net(w.index) }
                        }
                    }
                    let by0 = 54 + max(1, min(5, nets.count)) * 30
                    text "BLUETOOTH" { at: 30, by0 + 12; anchor: left center; size: 9; weight: 700; family: "Share Tech Mono"; color: if(isl_style > 0.5, fg.secondary, fl.muted) }
                    text bt_empty { at: 30, by0 + 38; anchor: left center; size: 12; family: "Exo 2"; color: if(isl_style > 0.5, fg.muted, fl.muted); show: btd.count < 1 }
                    for d in btd {
                        let dy = by0 + 24 + d.index * 30
                        group {
                            show: d.index < 6
                            zone box dz { from: 16, dy; size: 388, 28; cursor: pointer; role: item; selected: d.connected; label: "Connect or disconnect {d.name}" }
                            box { from: 18, dy + 1; size: 384, 26; corner: if(isl_style > 0.5, 8, 2); color: if(isl_style > 0.5, selection.bg, fl.well); opacity: max(if(d.connected, 0.9, 0), 0.6 * dz.hover) }
                            ellipse { at: 34, dy + 14; radius: 3.5; color: if(d.connected, if(isl_style > 0.5, accent.primary, fl.phos), if(isl_style > 0.5, fg.muted, fl.muted)) }
                            text d.name { at: 48, dy + 14; anchor: left center; size: 12; family: "Exo 2"; width: 240; lines: 1; color: if(d.connected, if(isl_style > 0.5, accent.primary, fl.phos), if(isl_style > 0.5, fg.primary, fl.engrave)) }
                            text "{round(d.battery * 100), 0} %" { at: 392, dy + 14; anchor: right center; size: 9.5; family: "Share Tech Mono"; color: if(isl_style > 0.5, fg.muted, fl.muted); show: d.battery >= 0 }
                            text "connected" { at: 392, dy + 14; anchor: right center; size: 9.5; family: "Share Tech Mono"; color: if(isl_style > 0.5, fg.muted, fl.muted); show: d.battery < 0 and d.connected }
                            text "paired" { at: 392, dy + 14; anchor: right center; size: 9.5; family: "Share Tech Mono"; color: if(isl_style > 0.5, fg.muted, fl.muted); show: d.battery < 0 and not d.connected }
                            on press dz { emit nx_bt(d.index) }
                        }
                    }
                }
            }
            // ── Sound ──
            group {
                show: y_sound > 0
                move: 0, y_sound - sv
                SecHead(0, "Sound", "", f_sound, 4)
                group {
                    show: not f_sound
                    for o in outs {
                        let oy = 30 + o.index * 28
                        group {
                            show: o.index < 6
                            zone box oz { from: 16, oy; size: 388, 26; cursor: pointer; role: item; selected: o.default; label: "Play on {o.name}" }
                            box { from: 18, oy + 1; size: 384, 24; corner: if(isl_style > 0.5, 8, 2); color: if(isl_style > 0.5, selection.bg, fl.well); opacity: max(if(o.default, 0.9, 0), 0.6 * oz.hover) }
                            ellipse { at: 34, oy + 13; radius: 3.5; color: if(o.default, if(isl_style > 0.5, accent.primary, fl.phos), if(isl_style > 0.5, fg.muted, fl.muted)) }
                            text o.name { at: 48, oy + 13; anchor: left center; size: 12; family: "Exo 2"; width: 330; lines: 1; color: if(o.default, if(isl_style > 0.5, accent.primary, fl.phos), if(isl_style > 0.5, fg.primary, fl.engrave)) }
                            on press oz { emit nx_out(o.index) }
                        }
                    }
                    let ay0 = 34 + max(1, min(6, outs.count)) * 28
                    for a in apps {
                        let ay = ay0 + a.index * 40
                        group {
                            show: a.index < 6
                            text a.name { at: 30, ay + 8; anchor: left center; size: 11.5; family: "Exo 2"; color: if(isl_style > 0.5, fg.primary, fl.engrave); width: 260; lines: 1 }
                            text pick(a.muted, "{round(a.volume * 100), 0} %", "muted") { at: 390, ay + 8; anchor: right center; size: 9.5; family: "Share Tech Mono"; color: if(isl_style > 0.5, fg.muted, fl.muted) }
                            zone box az { from: 30, ay + 14; size: 360, 18; cursor: pointer; role: slider; value: a.volume; label: "{a.name} volume" }
                            IsleMeter(30, ay + 19, 360, a.volume * (1 - a.muted))
                            on press az { emit nx_app(a.index * 1000 + round(clamp(local.x / 360, 0, 1) * 1000)) }
                            on drag az { emit nx_app(a.index * 1000 + round(clamp(local.x / 360, 0, 1) * 1000)) }
                            on scroll az { emit nx_app(a.index * 1000 + round(clamp(a.volume + wheel * 0.05, 0, 1) * 1000)) }
                        }
                    }
                }
            }
            // ── Machine ──
            group {
                show: y_machine > 0
                move: 0, y_machine - sv
                SecHead(0, "Machine", "{round(m_cpu * 100), 0} % CPU", f_machine, 5)
                group {
                    show: not f_machine
                    zone box mz { from: 16, 30; size: 388, 76; cursor: pointer; role: button; label: "Open btop" }
                    IsleGauge(30, 32, 170, "CPU", "{round(m_cpu * 100), 0} % · {round(m_temp), 0}°", m_cpu, m_cpu > 0.85 or m_temp > 85)
                    IsleGauge(220, 32, 170, "Memory", m_mem_t, m_mem, m_mem > 0.9)
                    IsleGauge(30, 70, 170, "Disk", m_disk_t, m_disk, m_disk > 0.9)
                    group { show: m_gpu_ok
                            IsleGauge(220, 70, 170, "Graphics", "{round(m_gpu * 100), 0} %", m_gpu, m_gpu > 0.9) }
                    on press mz { emit nx_go(10) }
                    text m_bat_t { at: 30, 120; anchor: left center; size: 11; family: "Exo 2"; color: if(isl_style > 0.5, fg.secondary, fl.muted); width: 360; lines: 1; show: battery.present }
                }
            }
            // ── Today ──
            group {
                show: y_today > 0
                move: 0, y_today - sv
                SecHead(0, "Today", clock.date, f_today, 6)
                group {
                    show: not f_today
                    zone box tz { from: 16, 30; size: 388, 58; cursor: pointer; role: button; label: "Open the calendar" }
                    for d in days {
                        let dx = 44 + d.index * 54
                        group {
                            show: d.today
                            glow: 6, (0.5) * st_glow, if(isl_style > 0.5, accent.primary, fl.phos)
                            box { at: dx, 60; size: 44, 52; corner: if(isl_style > 0.5, 12, 2); color: if(isl_style > 0.5, accent.primary, fl.phos); opacity: 0.9 }
                        }
                        text d.label { at: dx, 46; anchor: center; align: center; size: 9; family: "Share Tech Mono"; color: if(d.today, if(isl_style > 0.5, bg.primary, fl.ink), if(isl_style > 0.5, fg.muted, fl.muted)) }
                        text "{d.day, 0}" { at: dx, 70; anchor: center; align: center; size: 16; weight: 600; family: "Exo 2"; color: if(d.today, if(isl_style > 0.5, bg.primary, fl.ink), if(isl_style > 0.5, fg.primary, fl.engrave)) }
                    }
                    on press tz { emit nx_go(11) }
                    zone box wz2 { from: 16, 92; size: 388, 40; cursor: pointer; role: button; label: "Open the weather" }
                    group { show: wx_ok
                            Glyph(44, 112, 24, wx_kind)
                            text "{round(wx_temp), 0}°" { at: 66, 112; anchor: left center; size: 18; weight: 600; family: "Exo 2"; color: if(isl_style > 0.5, fg.primary, fl.engrave) }
                            text wx_word { at: 114, 112; anchor: left center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(isl_style > 0.5, accent.primary, fl.phos) }
                            text wx_place { at: 392, 112; anchor: right center; size: 10.5; family: "Exo 2"; color: if(isl_style > 0.5, fg.muted, fl.muted); width: 160; lines: 1; align: right } }
                    text "Weather: no answer yet" { at: 30, 112; anchor: left center; size: 11; family: "Exo 2"; color: if(isl_style > 0.5, fg.muted, fl.muted); show: not wx_ok }
                    on press wz2 { emit nx_go(12) }
                }
            }
            // ── System updates ──
            group {
                show: y_updates > 0
                move: 0, y_updates - sv
                SecHead(0, "System updates", pick(upd_n > 0, "up to date", "{upd_n, 0} waiting"), f_updates, 7)
                group {
                    show: not f_updates
                    text upd_t { at: 30, 50; anchor: left center; size: 11.5; family: "Exo 2"; color: if(upd_n > 0, if(isl_style > 0.5, fg.primary, fl.engrave), if(isl_style > 0.5, fg.secondary, fl.muted)); width: 250; lines: 1 }
                    group { show: upd_n > 0
                            zone box uz { from: 296, 38; size: 94, 24; cursor: pointer; role: button; label: "Run the updater" }
                            IsleBtn(296, 38, 94, "Update", 1, uz.hover)
                            on press uz { emit nx_go(13) } }
                }
            }
            // ── Workspaces ──
            group {
                show: y_workspaces > 0
                move: 0, y_workspaces - sv
                SecHead(0, "Workspaces", "", f_workspaces, 8)
                group {
                    show: not f_workspaces
                    for w in wss {
                        let wx = 30 + w.index * 46
                        group {
                            show: w.id > 0 and w.index < 8
                            zone box wsz { from: wx, 32; size: 40, 34; cursor: pointer; role: button; selected: w.active; label: "Go to workspace {w.id, 0}" }
                            IsleBtn(wx, 32, 40, "", if(w.active, 1, 0), wsz.hover, 34)
                            text "{w.id, 0}" { at: wx + 20, 49; anchor: center; align: center; size: 13; weight: 700; family: "Exo 2"
                                               color: if(w.active, if(isl_style > 0.5, bg.primary, fl.ink), if(isl_style > 0.5, fg.primary, fl.engrave)) }
                            on press wsz { emit nx_ws(w.id) }
                        }
                    }
                }
            }
            // ── Shortcuts ──
            group {
                show: y_shortcuts > 0
                move: 0, y_shortcuts - sv
                SecHead(0, "Shortcuts", "", f_shortcuts, 9)
                group {
                    show: not f_shortcuts
                    zone box sc40 { from: 30, 32; size: 86, 28; cursor: pointer; role: button; label: "Wallpaper" }
                    IsleBtn(30, 32, 86, "Wallpaper", 0, sc40.hover, 28)
                    on press sc40 { emit nx_go(40) }
                    zone box sc41 { from: 122, 32; size: 86, 28; cursor: pointer; role: button; label: "Notes" }
                    IsleBtn(122, 32, 86, "Notes", 0, sc41.hover, 28)
                    on press sc41 { emit nx_go(41) }
                    zone box sc42 { from: 214, 32; size: 86, 28; cursor: pointer; role: button; label: "Board" }
                    IsleBtn(214, 32, 86, "Board", 0, sc42.hover, 28)
                    on press sc42 { emit nx_go(42) }
                    zone box sc43 { from: 306, 32; size: 86, 28; cursor: pointer; role: button; label: "Overview" }
                    IsleBtn(306, 32, 86, "Overview", 0, sc43.hover, 28)
                    on press sc43 { emit nx_go(43) }
                    zone box sc44 { from: 30, 68; size: 86, 28; cursor: pointer; role: button; label: "Screenshot" }
                    IsleBtn(30, 68, 86, "Screenshot", 0, sc44.hover, 28)
                    on press sc44 { emit nx_go(44) }
                    zone box sc45 { from: 122, 68; size: 86, 28; cursor: pointer; role: button; label: "Clipboard" }
                    IsleBtn(122, 68, 86, "Clipboard", 0, sc45.hover, 28)
                    on press sc45 { emit nx_go(45) }
                    zone box sc46 { from: 214, 68; size: 86, 28; cursor: pointer; role: button; label: "Diagnostics" }
                    IsleBtn(214, 68, 86, "Diagnostics", 0, sc46.hover, 28)
                    on press sc46 { emit nx_go(46) }
                }
            }
            }


            // ── Customise the orbit: which nodes, which arcs, which board ──
            group {
                show: nx_custom
                box { from: 17, 70; size: 386, 330; corner: if(isl_style > 0.5, 16, 2); color: if(isl_style > 0.5, bg.primary, fl.hull); opacity: 0.96 }
                box { from: 17, 70; size: 386, 330; corner: if(isl_style > 0.5, 16, 2); stroke: 1; color: if(isl_style > 0.5, accent.primary, fl.phos); opacity: 0.6 }
                zone box cussheet { from: 17, 70; size: 386, 330; role: region; label: "Customise the orbit" }
                text "NODES · UP TO EIGHT" { at: 32, 92; anchor: left center; size: 9; weight: 700; family: "Share Tech Mono"; color: if(isl_style > 0.5, fg.secondary, fl.muted) }
                for c in cus_nodes {
                    let cx2 = 30 + mod(c.index, 4) * 92
                    let cy2 = 104 + floor(c.index / 4) * 30
                    zone box cn { from: cx2, cy2; size: 86, 24; cursor: pointer; role: toggle; checked: c.on; label: "{c.word} in the orbit" }
                    IsleBtn(cx2, cy2, 86, c.word, if(c.on, 1, 0), cn.hover)
                    on press cn { emit nx_cus(100 + c.index) }
                }
                text "ARCS · UP TO THREE" { at: 32, 210; anchor: left center; size: 9; weight: 700; family: "Share Tech Mono"; color: if(isl_style > 0.5, fg.secondary, fl.muted) }
                for c in cus_arcs {
                    let ax2 = 30 + mod(c.index, 4) * 92
                    let ay2 = 222 + floor(c.index / 4) * 30
                    zone box ca { from: ax2, ay2; size: 86, 24; cursor: pointer; role: toggle; checked: c.on; label: "{c.word} on an arc" }
                    IsleBtn(ax2, ay2, 86, c.word, if(c.on, 1, 0), ca.hover)
                    on press ca { emit nx_cus(200 + c.index) }
                }
                text "BOARD" { at: 32, 298; anchor: left center; size: 9; weight: 700; family: "Share Tech Mono"; color: if(isl_style > 0.5, fg.secondary, fl.muted) }
                zone box cb0 { from: 30, 310; size: 110, 24; cursor: pointer; role: tab; selected: orb_bg == 0; label: "Your banner" }
                IsleBtn(30, 310, 110, "Banner", if(orb_bg == 0, 1, 0), cb0.hover)
                on press cb0 { emit nx_cus(300) }
                zone box cb1 { from: 148, 310; size: 110, 24; cursor: pointer; role: tab; selected: orb_bg == 1; label: "A circuit board" }
                IsleBtn(148, 310, 110, "Circuit", if(orb_bg == 1, 1, 0), cb1.hover)
                on press cb1 { emit nx_cus(301) }
                zone box cb2 { from: 266, 310; size: 110, 24; cursor: pointer; role: tab; selected: orb_bg == 2; label: "Plain" }
                IsleBtn(266, 310, 110, "Plain", if(orb_bg == 2, 1, 0), cb2.hover)
                on press cb2 { emit nx_cus(302) }
                zone box cdone { from: 290, 356; size: 100, 26; cursor: pointer; role: button; label: "Done" }
                IsleBtn(290, 356, 100, "Done", 1, cdone.hover, 26)
                on press cdone { nx_custom = false }
            }
        }
    }
}
