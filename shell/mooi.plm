    on release ez_settings while ed_drag < 0 and ed_press == 25 { ed_sel = if(ed_sel == 25, -1, 25); ed_press = -1 }
    group {
        show: bar_edit and p_notes
        zone box ez_notes { from: xs_notes, fl.top; size: ws_notes, fl.mod_h; cursor: grab; role: button; label: "Move Quick notes" }
        box { from: xs_notes + 1, fl.top + 1; size: ws_notes - 2, fl.mod_h - 2; corner: 5; color: if(ed_drag == 26 and ed_merge, fl.ember_fill, fl.well)
              opacity: if(ed_drag == 26, 0.6, if(ed_sel == 26, 0.4, 0.2 * ez_notes.hover)) }
        box { from: xs_notes + 1, fl.top + 1; size: ws_notes - 2, fl.mod_h - 2; corner: 5; stroke: if(ed_sel == 26, 2, 1.2)
              color: if(ed_sel == 26 or ed_drag == 26, fl.flare, mix(fl.trace_lit, fl.flare, ez_notes.hover)); opacity: if(ed_drag >= 0 and ed_drag != 26, 0.45, 0.85) }
    }
    on press ez_notes while bar_edit { ed_press = 26; ed_px = pointer.x; ed_x = pointer.x; ed_y = pointer.y }
    on drag ez_notes while ed_press == 26 and ed_drag < 0 and abs(pointer.x - ed_px) > 5 { ed_drag = 26; ed_sel = -1 }
    on release ez_notes while ed_drag == 26 { emit edit_drop(ed_drag * 100000 + round(clamp(ed_x, 0, 49999)) + if(ed_y > st_res + 4, 50000, 0)); ed_drag = -1; ed_press = -1 }
    on release ez_notes while ed_drag < 0 and ed_press == 26 { ed_sel = if(ed_sel == 26, -1, 26); ed_press = -1 }
    group {
        show: bar_edit and p_wallpaper
        zone box ez_wallpaper { from: xs_wallpaper, fl.top; size: ws_wallpaper, fl.mod_h; cursor: grab; role: button; label: "Move Wallpaper studio" }
        box { from: xs_wallpaper + 1, fl.top + 1; size: ws_wallpaper - 2, fl.mod_h - 2; corner: 5; color: if(ed_drag == 27 and ed_merge, fl.ember_fill, fl.well)
              opacity: if(ed_drag == 27, 0.6, if(ed_sel == 27, 0.4, 0.2 * ez_wallpaper.hover)) }
        box { from: xs_wallpaper + 1, fl.top + 1; size: ws_wallpaper - 2, fl.mod_h - 2; corner: 5; stroke: if(ed_sel == 27, 2, 1.2)
              color: if(ed_sel == 27 or ed_drag == 27, fl.flare, mix(fl.trace_lit, fl.flare, ez_wallpaper.hover)); opacity: if(ed_drag >= 0 and ed_drag != 27, 0.45, 0.85) }
    }
    on press ez_wallpaper while bar_edit { ed_press = 27; ed_px = pointer.x; ed_x = pointer.x; ed_y = pointer.y }
    on drag ez_wallpaper while ed_press == 27 and ed_drag < 0 and abs(pointer.x - ed_px) > 5 { ed_drag = 27; ed_sel = -1 }
    on release ez_wallpaper while ed_drag == 27 { emit edit_drop(ed_drag * 100000 + round(clamp(ed_x, 0, 49999)) + if(ed_y > st_res + 4, 50000, 0)); ed_drag = -1; ed_press = -1 }
    on release ez_wallpaper while ed_drag < 0 and ed_press == 27 { ed_sel = if(ed_sel == 27, -1, 27); ed_press = -1 }
    group {
        show: bar_edit and p_nexus
        zone box ez_nexus { from: xs_nexus, fl.top; size: ws_nexus, fl.mod_h; cursor: grab; role: button; label: "Move Control Nexus" }
        box { from: xs_nexus + 1, fl.top + 1; size: ws_nexus - 2, fl.mod_h - 2; corner: 5; color: if(ed_drag == 28 and ed_merge, fl.ember_fill, fl.well)
              opacity: if(ed_drag == 28, 0.6, if(ed_sel == 28, 0.4, 0.2 * ez_nexus.hover)) }
        box { from: xs_nexus + 1, fl.top + 1; size: ws_nexus - 2, fl.mod_h - 2; corner: 5; stroke: if(ed_sel == 28, 2, 1.2)
              color: if(ed_sel == 28 or ed_drag == 28, fl.flare, mix(fl.trace_lit, fl.flare, ez_nexus.hover)); opacity: if(ed_drag >= 0 and ed_drag != 28, 0.45, 0.85) }
    }
    on press ez_nexus while bar_edit { ed_press = 28; ed_px = pointer.x; ed_x = pointer.x; ed_y = pointer.y }
    on drag ez_nexus while ed_press == 28 and ed_drag < 0 and abs(pointer.x - ed_px) > 5 { ed_drag = 28; ed_sel = -1 }
    on release ez_nexus while ed_drag == 28 { emit edit_drop(ed_drag * 100000 + round(clamp(ed_x, 0, 49999)) + if(ed_y > st_res + 4, 50000, 0)); ed_drag = -1; ed_press = -1 }
    on release ez_nexus while ed_drag < 0 and ed_press == 28 { ed_sel = if(ed_sel == 28, -1, 28); ed_press = -1 }
    group {
        show: bar_edit and p_updates
        zone box ez_updates { from: xs_updates, fl.top; size: ws_updates, fl.mod_h; cursor: grab; role: button; label: "Move System updates" }
        box { from: xs_updates + 1, fl.top + 1; size: ws_updates - 2, fl.mod_h - 2; corner: 5; color: if(ed_drag == 29 and ed_merge, fl.ember_fill, fl.well)
              opacity: if(ed_drag == 29, 0.6, if(ed_sel == 29, 0.4, 0.2 * ez_updates.hover)) }
        box { from: xs_updates + 1, fl.top + 1; size: ws_updates - 2, fl.mod_h - 2; corner: 5; stroke: if(ed_sel == 29, 2, 1.2)
              color: if(ed_sel == 29 or ed_drag == 29, fl.flare, mix(fl.trace_lit, fl.flare, ez_updates.hover)); opacity: if(ed_drag >= 0 and ed_drag != 29, 0.45, 0.85) }
    }
    on press ez_updates while bar_edit { ed_press = 29; ed_px = pointer.x; ed_x = pointer.x; ed_y = pointer.y }
    on drag ez_updates while ed_press == 29 and ed_drag < 0 and abs(pointer.x - ed_px) > 5 { ed_drag = 29; ed_sel = -1 }
    on release ez_updates while ed_drag == 29 { emit edit_drop(ed_drag * 100000 + round(clamp(ed_x, 0, 49999)) + if(ed_y > st_res + 4, 50000, 0)); ed_drag = -1; ed_press = -1 }
    on release ez_updates while ed_drag < 0 and ed_press == 29 { ed_sel = if(ed_sel == 29, -1, 29); ed_press = -1 }
    group {
        show: bar_edit and p_claude
        zone box ez_claude { from: xs_claude, fl.top; size: ws_claude, fl.mod_h; cursor: grab; role: button; label: "Move Claude" }
        box { from: xs_claude + 1, fl.top + 1; size: ws_claude - 2, fl.mod_h - 2; corner: 5; color: if(ed_drag == 30 and ed_merge, fl.ember_fill, fl.well)
              opacity: if(ed_drag == 30, 0.6, if(ed_sel == 30, 0.4, 0.2 * ez_claude.hover)) }
        box { from: xs_claude + 1, fl.top + 1; size: ws_claude - 2, fl.mod_h - 2; corner: 5; stroke: if(ed_sel == 30, 2, 1.2)
              color: if(ed_sel == 30 or ed_drag == 30, fl.flare, mix(fl.trace_lit, fl.flare, ez_claude.hover)); opacity: if(ed_drag >= 0 and ed_drag != 30, 0.45, 0.85) }
    }
    on press ez_claude while bar_edit { ed_press = 30; ed_px = pointer.x; ed_x = pointer.x; ed_y = pointer.y }
    on drag ez_claude while ed_press == 30 and ed_drag < 0 and abs(pointer.x - ed_px) > 5 { ed_drag = 30; ed_sel = -1 }
    on release ez_claude while ed_drag == 30 { emit edit_drop(ed_drag * 100000 + round(clamp(ed_x, 0, 49999)) + if(ed_y > st_res + 4, 50000, 0)); ed_drag = -1; ed_press = -1 }
    on release ez_claude while ed_drag < 0 and ed_press == 30 { ed_sel = if(ed_sel == 30, -1, 30); ed_press = -1 }
    group {
        show: bar_edit and p_github
        zone box ez_github { from: xs_github, fl.top; size: ws_github, fl.mod_h; cursor: grab; role: button; label: "Move GitHub" }
        box { from: xs_github + 1, fl.top + 1; size: ws_github - 2, fl.mod_h - 2; corner: 5; color: if(ed_drag == 31 and ed_merge, fl.ember_fill, fl.well)
              opacity: if(ed_drag == 31, 0.6, if(ed_sel == 31, 0.4, 0.2 * ez_github.hover)) }
        box { from: xs_github + 1, fl.top + 1; size: ws_github - 2, fl.mod_h - 2; corner: 5; stroke: if(ed_sel == 31, 2, 1.2)
              color: if(ed_sel == 31 or ed_drag == 31, fl.flare, mix(fl.trace_lit, fl.flare, ez_github.hover)); opacity: if(ed_drag >= 0 and ed_drag != 31, 0.45, 0.85) }
    }
    on press ez_github while bar_edit { ed_press = 31; ed_px = pointer.x; ed_x = pointer.x; ed_y = pointer.y }
    on drag ez_github while ed_press == 31 and ed_drag < 0 and abs(pointer.x - ed_px) > 5 { ed_drag = 31; ed_sel = -1 }
    on release ez_github while ed_drag == 31 { emit edit_drop(ed_drag * 100000 + round(clamp(ed_x, 0, 49999)) + if(ed_y > st_res + 4, 50000, 0)); ed_drag = -1; ed_press = -1 }
    on release ez_github while ed_drag < 0 and ed_press == 31 { ed_sel = if(ed_sel == 31, -1, 31); ed_press = -1 }
    // The ghost's word: what letting go now will do.
    text pick(max(ed_drag, 0), "Workspaces", "Window title", "Media player", "Resources", "Bandwidth", "Keyboard layout", "Weather", "Tray", "Notifications", "Microphone", "Volume", "Brightness", "Battery", "Network", "Bluetooth", "Clock", "Keep awake", "Screen recorder", "Screenshot", "Clipboard", "Session", "Window actions", "Overview", "Search", "Focus timer", "Settings", "Quick notes", "Wallpaper studio", "Control Nexus", "System updates", "Claude", "GitHub") { at: ed_x, ed_y - 4; anchor: center; size: 12; weight: 700; family: "Exo 2"; color: fl.ink; show: ed_drag >= 0 }
    text pick(if(ed_y > st_res + 4, 2, if(ed_merge, 1, 0)), "MOVE HERE", "JOIN THIS GROUP", "HIDE") { at: ed_x, ed_y + 8; anchor: center; size: 10; family: "Share Tech Mono"; color: fl.ink; show: ed_drag >= 0 }
    // The inspector, under the chosen module: what it is, its outline, and what can be done with it.
    let ed_ix = clamp(pick(max(ed_sel, 0), xs_workspaces, xs_window, xs_media, xs_resources, xs_bandwidth, xs_keyboard, xs_weather, xs_tray, xs_notifications, xs_mic, xs_volume, xs_brightness, xs_battery, xs_network, xs_bluetooth, xs_clock, xs_caffeine, xs_recorder, xs_screenshot, xs_clipboard, xs_power, xs_actions, xs_overview, xs_core, xs_focus, xs_settings, xs_notes, xs_wallpaper, xs_nexus, xs_updates, xs_claude, xs_github) + pick(max(ed_sel, 0), ws_workspaces, ws_window, ws_media, ws_resources, ws_bandwidth, ws_keyboard, ws_weather, ws_tray, ws_notifications, ws_mic, ws_volume, ws_brightness, ws_battery, ws_network, ws_bluetooth, ws_clock, ws_caffeine, ws_recorder, ws_screenshot, ws_clipboard, ws_power, ws_actions, ws_overview, ws_core, ws_focus, ws_settings, ws_notes, ws_wallpaper, ws_nexus, ws_updates, ws_claude, ws_github) / 2 - 170, 12, screen.width - 352)
    let ed_fi = pick(max(ed_sel, 0), fi_workspaces, fi_window, fi_media, fi_resources, fi_bandwidth, fi_keyboard, fi_weather, fi_tray, fi_notifications, fi_mic, fi_volume, fi_brightness, fi_battery, fi_network, fi_bluetooth, fi_clock, fi_caffeine, fi_recorder, fi_screenshot, fi_clipboard, fi_power, fi_actions, fi_overview, fi_core, fi_focus, fi_settings, fi_notes, fi_wallpaper, fi_nexus, fi_updates, fi_claude, fi_github)
    let ed_g = pick(max(ed_sel, 0), g_workspaces, g_window, g_media, g_resources, g_bandwidth, g_keyboard, g_weather, g_tray, g_notifications, g_mic, g_volume, g_brightness, g_battery, g_network, g_bluetooth, g_clock, g_caffeine, g_recorder, g_screenshot, g_clipboard, g_power, g_actions, g_overview, g_core, g_focus, g_settings, g_notes, g_wallpaper, g_nexus, g_updates, g_claude, g_github)
    group {
        show: bar_edit and ed_sel >= 0 and ed_drag < 0
        move: ed_ix, st_res + 92
        FlPlate(340, 128) {
            text pick(max(ed_sel, 0), "Workspaces", "Window title", "Media player", "Resources", "Bandwidth", "Keyboard layout", "Weather", "Tray", "Notifications", "Microphone", "Volume", "Brightness", "Battery", "Network", "Bluetooth", "Clock", "Keep awake", "Screen recorder", "Screenshot", "Clipboard", "Session", "Window actions", "Overview", "Search", "Focus timer", "Settings", "Quick notes", "Wallpaper studio", "Control Nexus", "System updates", "Claude", "GitHub") { at: 14, 18; anchor: left center; size: 14; weight: 600; family: "Exo 2"; color: fl.phos }
            text pick(ed_g, "ON ITS OWN", "IN A GROUP") { at: 326, 18; anchor: right center; size: 10; family: "Share Tech Mono"; color: fl.ember }
            text "OUTLINE" { at: 14, 46; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.muted }
            SChoice(80, 32, 64, "Default", ed_fi == 0, set_value, (200 + ed_sel) * 1000 + 0)
            SChoice(144, 32, 64, "Line", ed_fi == 1, set_value, (200 + ed_sel) * 1000 + 1)
            SChoice(208, 32, 64, "Corners", ed_fi == 2, set_value, (200 + ed_sel) * 1000 + 2)
            SChoice(272, 32, 64, "None", ed_fi == 3, set_value, (200 + ed_sel) * 1000 + 3)
            SButton(14, 72, 40, "◀", edit_op, ed_sel * 10 + 0)
            SButton(58, 72, 40, "▶", edit_op, ed_sel * 10 + 1)
            SButton(106, 72, 70, "Join ◀", edit_op, ed_sel * 10 + 2)
            SButton(180, 72, 70, "Join ▶", edit_op, ed_sel * 10 + 3)
            SButton(254, 72, 72, "Hide", edit_op, ed_sel * 10 + 5, true)
            group {
                opacity: if(ed_g, 1, 0.35)
                SButton(106, 104, 144, "Split from group", edit_op, ed_sel * 10 + 4)
            }
            text "← → MOVE · DEL HIDE" { at: 326, 115; anchor: right center; size: 10; family: "Share Tech Mono"; color: fl.muted }
        }
    }
    on key Left while bar_edit and ed_sel >= 0 { emit edit_op(ed_sel * 10 + 0) }
    on key Right while bar_edit and ed_sel >= 0 { emit edit_op(ed_sel * 10 + 1) }
    on key Delete while bar_edit and ed_sel >= 0 { emit edit_op(ed_sel * 10 + 5); ed_sel = -1 }
    on edit_op(v) while v - floor(v / 10) * 10 == 5 { ed_sel = -1 }
    // </gen:edit>

    // ── Quick notes: the dropdown (D51, D52) ──────────────────
    // Under the notes module, in the bar's own surface, cut from the loom's chamfered plate and
    // unfolding like it (its head runs out from the module, then its body drops). A rail down its
    // left: the pad (here) and the board (a press opens it). The pad: an input (Enter saves), the
    // notes — pinned first — each with pin, send to the board, change and forget (a press on the
    // row copies it), and a word for what just happened. ↑↓ choose a row; Alt+C/E/P/B/Delete act
    // on it.
    let qn_w = 468
    let qn_h = 404
    let qn_x = clamp(xs_notes + ws_notes - qn_w, 12, screen.width - qn_w - 12)
    let qn_y = st_res + 8
    let qn_pw = 120 + (qn_w - 120) * qu_a
    let qn_ph = 36 + (qn_h - 36) * qu_b
    let qn_px = qn_x + qn_w - qn_pw
    group {
        show: qu_a > 0.004
        // the plate takes every press on it, so none reaches the window under it
        zone box qcatch { from: qn_px, qn_y; size: qn_pw, qn_ph }
        group {
            glow: 12, 0.3 * st_glow, fl.phos
            Chamfer(qn_px, qn_y, qn_pw, qn_ph, 10, fl.hull, fl.trace, 0.98, 1.4)
        }
        group {
            clip box { from: qn_px, qn_y; size: qn_pw, qn_ph }
            group {
                move: qn_x, qn_y
                opacity: min(1, qu_a * 1.5)
                // the rail: the pad, and the board
                box { from: 1, 1; size: 43, qn_h - 2; color: fl.ground; opacity: 0.7 }
                line { from: 44, 8; to: 44, qn_h - 8; width: 1; color: fl.trace_dim }
                box { from: 2, 12; size: 3, 40; color: fl.ember }
                path { stroke: 1.3; color: fl.phos
                       move 15, 20; line 26, 20; line 30, 24; line 30, 38; line 15, 38; close }
                line { from: 18, 28; to: 27, 28; width: 1; color: fl.phos }
                line { from: 18, 32; to: 27, 32; width: 1; color: fl.phos }
                text "PAD" { at: 22, 48; anchor: center; size: 10; family: "Share Tech Mono"; color: fl.trace_lit }
                zone box qrail_board { from: 4, 62; size: 37, 46; cursor: pointer; role: button
                                       label: pick(kb_count > 0, "Open the board", "Open the board — {kb_count, 0} cards") }
                Chamfer(4, 62, 37, 46, 5, mix(fl.ground, fl.well, qrail_board.hover), mix(fl.trace_dim, fl.phos, qrail_board.hover), 0.9)
                box { from: 13, 72; size: 5, 16; corner: 1; color: mix(fl.trace_lit, fl.phos, qrail_board.hover) }
                box { from: 20, 72; size: 5, 11; corner: 1; color: mix(fl.trace_lit, fl.flare, qrail_board.hover) }
                box { from: 27, 72; size: 5, 20; corner: 1; color: mix(fl.trace_lit, fl.ember, qrail_board.hover) }
                text "BOARD" { at: 22, 100; anchor: center; size: 10; family: "Share Tech Mono"; color: mix(fl.trace_lit, fl.phos, qrail_board.hover) }
                group {
                    show: kb_late > 0
                    ellipse { at: 37, 66; radius: 6; color: fl.ember_fill }
                    text "{min(kb_late, 9), 0}" { at: 37, 66; anchor: center; size: 10; weight: 700; family: "Exo 2"; color: fl.ink }
                }
                on press qrail_board { qn_open = false; emit board_show }

                text "QUICK NOTES" { at: 58, 18; anchor: left center; size: 11; family: "Share Tech Mono"; color: fl.ember }
                // the search, beside the name: what is typed narrows the rows
                zone box qfind { from: 168, 6; size: qn_w - 290, 24; cursor: text; role: region; label: "Search the notes" }
                Chamfer(168, 6, qn_w - 290, 24, 5, fl.ground, mix(fl.trace_dim, fl.phos, max(qfind.hover, if(qn_searching, 1, 0))), 1, 1)
                ellipse { at: 180, 17; radius: 4; stroke: 1.2; color: mix(fl.trace_lit, fl.phos, qfind.hover) }
                line { from: 183, 20; to: 187, 24; width: 1.2; color: mix(fl.trace_lit, fl.phos, qfind.hover) }
                input qn_query { at: 193, 11; width: qn_w - 330; size: 10.5; family: "Exo 2"; color: fl.phos; selection: fl.well; placeholder: "Search…" }
                on press qfind { focus qn_query }
                text "{qn_count, 0}" { at: qn_w - 52, 18; anchor: right center; size: 11; family: "Share Tech Mono"; color: fl.muted; show: qn_count <= 6 }
                text "{qn_from, 0}–{qn_to, 0}/{qn_count, 0}" { at: qn_w - 52, 18; anchor: right center; size: 10; family: "Share Tech Mono"; color: fl.muted; show: qn_count > 6 }
                zone box qclose { from: qn_w - 42, 4; size: 30, 28; corner: 5; cursor: pointer; role: button; label: "Close quick notes" }
                line { from: qn_w - 32, 12; to: qn_w - 22, 22; width: 1.4; color: mix(fl.muted, fl.ember, qclose.hover) }
                line { from: qn_w - 22, 12; to: qn_w - 32, 22; width: 1.4; color: mix(fl.muted, fl.ember, qclose.hover) }
                on press qclose { qn_open = false }

                // the input's well
                Chamfer(56, 38, qn_w - 136, 34, 6, fl.ground, if(qn_editing, fl.ember, mix(fl.trace, fl.phos, 0.3)), 1, if(qn_editing, 1.4, 1))
                text pick(qn_editing, "Write a note — the first line is its name · Enter saves", "Editing — Enter saves, Esc cancels") { at: 66, 55; anchor: left center; size: 11; family: "Exo 2"; color: fl.muted
                     width: qn_w - 160; lines: 1; show: not qn_drafting }
                input qn_draft { at: 66, 47; width: qn_w - 156; size: 12; family: "Exo 2"; color: fl.phos; selection: fl.well }
                SButton(qn_w - 72, 39, 60, qn_add_label, qn_add, 0)
                on qn_focus { focus qn_draft }

                // the wheel moves through what is not on the six rows; the rows themselves sit on top
                zone box qscroll { from: 56, 80; size: qn_w - 68, 270; role: region; label: "Notes — scroll for more" }
                on scroll qscroll { emit qn_scroll(wheel) }
                for r in qn {
                    let qry = 82 + r.n * 45
                    let qbx = qn_w - 124
                    zone box qrow { from: 92, qry; size: qbx - 96, 41; corner: 4; cursor: pointer; role: button; selected: r.sel; label: "Copy note: {r.text}" }
                    Chamfer(56, qry, qn_w - 68, 41, 6, mix(fl.hull_raised, fl.well, if(qn_edit_id == r.id, 0.9, max(0.55 * qrow.hover, if(r.sel, 0.45, 0.12)))),
                            if(r.sel, focus.ring, mix(fl.trace_dim, fl.trace, qrow.hover)), 0.95, if(r.sel, 1.3, 1))
                    // the colour: a stripe down the row's edge; a press gives it the next
                    zone box qtag { from: 56, qry; size: 12, 41; cursor: pointer; role: button; label: "Colour note {r.n + 1}" }
                    group {
                        glow: 6, 50% * if(r.tag > 0, 1, 0), pick(r.tag, fl.trace_dim, fl.phos, fl.flare, fl.ember, fl.trace_lit)
                        box { from: 58, qry + 6; size: 3 + qtag.hover * 2, 29; corner: 1.5; color: pick(r.tag, fl.trace_dim, fl.phos, fl.flare, fl.ember, fl.trace_lit)
                              opacity: if(r.tag > 0, 1, 0.5 + 0.5 * qtag.hover) }
                    }
                    // the tick
                    zone box qdone { from: 68, qry + 10; size: 20, 20; cursor: pointer; role: toggle; checked: r.done; label: pick(r.done, "Tick note {r.n + 1} off", "Open note {r.n + 1} again") }
                    box { from: 71, qry + 13; size: 14, 14; corner: 3; stroke: 1.3; color: if(r.done, fl.phos, mix(fl.trace_lit, fl.phos, qdone.hover)) }
                    box { from: 71, qry + 13; size: 14, 14; corner: 3; color: fl.phos; opacity: 0.25; show: r.done }
                    line { from: 74, qry + 20; to: 77, qry + 23; width: 1.6; color: fl.phos; show: r.done }
                    line { from: 77, qry + 23; to: 82, qry + 16; width: 1.6; color: fl.phos; show: r.done }
                    // pinned: a small flare mark by the name
                    text r.text { at: 96, qry + if(r.two, 14, 20); anchor: left center; size: 11; weight: 600; family: "Exo 2"; width: qbx - 140; lines: 1
                                  color: if(r.done, fl.muted, mix(fl.engrave, fl.phos, qrow.hover)) }
                    text r.more { at: 96, qry + 29; anchor: left center; size: 10; family: "Exo 2"; width: qbx - 140; lines: 1; color: fl.muted
                                  opacity: if(r.done, 0.6, 1) }
                    text r.when { at: qbx - 6, qry + 20; anchor: right center; size: 10; family: "Share Tech Mono"; color: fl.muted }
                    // pin
                    zone box qpin { from: qbx, qry + 9; size: 26, 22; corner: 4; cursor: pointer; role: toggle; checked: r.pinned; label: pick(r.pinned, "Pin note {r.n + 1}", "Unpin note {r.n + 1}") }
                    line { from: qbx + 7, qry + 26; to: qbx + 12, qry + 20; width: 1.4; color: if(r.pinned, fl.flare, mix(fl.trace_lit, fl.phos, qpin.hover)) }
                    ellipse { at: qbx + 15, qry + 17; radius: 3.6; color: fl.flare; show: r.pinned }
                    ellipse { at: qbx + 15, qry + 17; radius: 3.6; stroke: 1.3; color: mix(fl.trace_lit, fl.phos, qpin.hover); show: not r.pinned }
                    // to the board
                    zone box qtoboard { from: qbx + 28, qry + 9; size: 26, 22; corner: 4; cursor: pointer; role: button; label: "Send note {r.n + 1} to the board" }
                    box { from: qbx + 33, qry + 14; size: 4, 12; corner: 1; color: mix(fl.trace_lit, fl.phos, qtoboard.hover) }
                    box { from: qbx + 39, qry + 14; size: 4, 8; corner: 1; color: mix(fl.trace_lit, fl.phos, qtoboard.hover) }
                    box { from: qbx + 45, qry + 14; size: 4, 12; corner: 1; color: mix(fl.trace_lit, fl.phos, qtoboard.hover) }
                    // change
                    zone box qedit { from: qbx + 56, qry + 9; size: 26, 22; corner: 4; cursor: pointer; role: button; label: "Change note {r.n + 1}" }
                    line { from: qbx + 62, qry + 24; to: qbx + 73, qry + 13; width: 2; color: mix(fl.trace_lit, fl.phos, qedit.hover) }
                    line { from: qbx + 64, qry + 26; to: qbx + 75, qry + 15; width: 1; color: mix(fl.trace_lit, fl.phos, qedit.hover); opacity: 0.6 }
                    // forget
                    zone box qdel { from: qbx + 86, qry + 9; size: 26, 22; corner: 4; cursor: pointer; role: button; label: "Forget note {r.n + 1}" }
                    line { from: qbx + 94, qry + 15; to: qbx + 104, qry + 25; width: 1.3; color: mix(fl.trace_lit, fl.ember, qdel.hover) }
                    line { from: qbx + 104, qry + 15; to: qbx + 94, qry + 25; width: 1.3; color: mix(fl.trace_lit, fl.ember, qdel.hover) }
                    on press qrow { emit qn_copy(r.id) }
                    on press qtag { emit qn_tag(r.id) }
                    on press qdone { emit qn_done(r.id) }
                    on press qpin { emit qn_pin(r.id) }
                    on press qtoboard { emit qn_board(r.id) }
                    on press qedit { emit qn_edit(r.id) }
                    on press qdel { emit qn_del(r.id) }
                }
                text pick(qn_searching, "No notes yet — write one above.", "No note says that.") { at: qn_w / 2 + 22, 160; anchor: center; size: 12; family: "Exo 2"; color: fl.muted; show: qn_count < 1 }
                line { from: 56, qn_h - 34; to: qn_w - 12, qn_h - 34; width: 1; color: fl.trace_dim }
                text pick(qn_editing, "↑↓ · ALT+C COPY · ALT+E EDIT · ALT+P PIN · ALT+B BOARD · STRIPE: COLOUR · BOX: DONE", "ESC CANCELS · ENTER SAVES") { at: 58, qn_h - 18; anchor: left center; size: 8; family: "Share Tech Mono"; width: qn_w - 120; lines: 1; color: fl.muted; show: not qn_saying }
                text qn_said { at: 58, qn_h - 18; anchor: left center; size: 10; family: "Share Tech Mono"; width: qn_w - 120; lines: 1
                               color: fl.ember; show: qn_saying }
                text "UNDO" { at: qn_w - 12, qn_h - 18; anchor: right center; size: 10; family: "Share Tech Mono"; color: fl.ember; show: qn_can_undo }
                zone box qundo { from: qn_w - 48, qn_h - 30; size: 36, 22; corner: 4; cursor: pointer; role: button; label: "Put the forgotten note back"; show: qn_can_undo }
                on press qundo { emit qn_undo }
            }
        }
    }
    on change qn_open while qn_open { focus qn_draft }
    on change qn_open while not qn_open { blur }
    on key Escape while qn_open and qn_editing { emit qn_cancel }
    on key Escape while qn_open and not qn_editing { qn_open = false }
    on key Up while qn_open { emit qn_nav(0) }
    on key Down while qn_open { emit qn_nav(1) }
    on key Alt+c while qn_open { emit qn_act(1) }
    on key Alt+e while qn_open { emit qn_act(2) }
    on key Alt+p while qn_open { emit qn_act(3) }
    on key Alt+b while qn_open { emit qn_act(4) }
    on key Alt+Delete while qn_open { emit qn_act(5) }
    on key Ctrl+b while qn_open { qn_open = false; emit board_show }
    on idle for 45s while qn_open { qn_open = false }
    on change open while open != none { qn_open = false }
    on change side while side != none { qn_open = false }
    on change mark_open while mark_open { qn_open = false }
    on change bar_edit while bar_edit { qn_open = false }
    on bar_menu { qn_open = false }
    // The board, from the rail, a key or `mooi board`: its own program (D64), so the bar lets go
    // of what it is showing and of the keyboard first, and the logic starts it.
    on open_board { qn_open = false; side = none; open = none; mark_open = false; emit board_show }

    // ── The bar's rules ───────────────────────────────────────
    // The mark (and a right press on search) opens mooi's settings — the shell's home, where
    // everything the bar has is switched: a program of its own (shell/mooi-settings.plm), which
    // the logic starts and, pressed again, closes.
    on bar_menu { emit open_settings }
    // The wheel walks the chain as it is drawn: it grows past the setting to reach the focus (lib/spaces
    // rows), so its end is the chain's last (ws_last) — clamped to the setting alone, a turn from 9 landed on 5.
    on scroll chain while bar_wheel == step { emit ws_pick(clamp(active_row + 1 - wheel, 1, ws_last)) }
    on scroll chain while bar_wheel == invert { emit ws_pick(clamp(active_row + 1 + wheel, 1, ws_last)) }
    on key Escape while mark_open { mark_open = false }
    on key Escape while side != none { side = none }
    on loom_field { side = notes; mark_open = false; open = none }
    on key Down while side == notes { emit fld_pick(min(fld_sel + 1, max(fclus.count - 1, 0))) }
    on key Up while side == notes { emit fld_pick(max(fld_sel - 1, 0)) }
    on key Shift+Down while side == notes { emit fld_choose(min(fld_item + 1, max(fitems.count - 1, 0))) }
    on key Shift+Up while side == notes { emit fld_choose(max(fld_item - 1, 0)) }
    on key Return while side == notes { emit fld_open(fld_item) }
    on key Delete while side == notes { emit fld_dismiss(fld_item) }
    on key s while side == notes { emit fld_snooze(fld_item) }
    on key m while side == notes { emit fld_mute }
    on idle for 30s while mark_open { mark_open = false }
    on clip_pick { side = none }

    // ══ The islands (D53): each under the module that opens it, drawn here in the bar's own surface ═
    // (a closed full-width surface of their own kept its last picture on the screen).
    // ── side_island (drawn in the bar's own surface, under the bar's strip: D53) ──
    group {
        move: 0, st_res + 6

        // Under the module that opens it (D53): a strip as wide as the screen whose panel sits
        // under the module's middle, kept on the screen; the strip's empty parts let presses through.
        let si_ox = clamp((if(p_clipboard, xs_clipboard + ws_clipboard / 2, screen.width - 200)) - 190, 8, screen.width - 388)
        // nothing drawn for its last frames open, so the picture a closed full-screen surface keeps is empty
        group {
            show: rv.side > 0.03
            move: si_ox, 0

            group {
                show: rv.side > 0.004
                opacity: rv.side
                move: 0, -8 * (1 - rv.side)
                FlPlate(370, 460) {
                    text "CLIPBOARD" { at: 14, 16; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.ember }
                    box { from: 10, 30; size: 350, 1; color: fl.trace_dim }
                    column {
                        at: 10, 36
                        gap: 2
                        for c in clips { ClipRow(c, clip_pick) }
                    }
                }
            }
        }
    }
    // ── field_island (drawn in the bar's own surface, under the bar's strip: D53) ──
    group {
        move: 0, st_res + 4

        // Its width is the loom's size (signals.density): compact, a narrow Field; comfortable, a
        // wide one. It hangs under the bar's bell (signals at the top) and unfolds outward from it;
        // with the signals at a bottom corner, or no bell on the bar, it opens from that corner.
        let fd_W = if(loom_comfy, 740, 520)
        let fd_H = 540
        let fd_cw = if(loom_comfy, 238, 170)           // the clusters' column
        let fd_iw = fd_W - fd_cw - 36                  // the notices' column
        let fd_bell = p_notifications and not loom_bottom
        let fd_cx = if(fd_bell, xs_notifications + ws_notifications / 2, if(loom_left, 10 + fd_W / 2, screen.width - 10 - fd_W / 2))
        let fd_xo = clamp(fd_cx - fd_W / 2, 10, screen.width - fd_W - 10)
        let fd_yo = if(loom_bottom, (screen.height - st_res - 4) - fd_H - 10, 0)
        let fd_r = clamp((fd_cx - fd_xo) / fd_W, 0, 1)    // where along it the bell is: it grows from there
        let fd_pw = 140 + (fd_W - 140) * fu_a
        let fd_ph = 38 + (fd_H - 38) * fu_b
        let fd_px = fd_xo + (fd_W - fd_pw) * fd_r
        let fd_py = if(loom_bottom, fd_yo + fd_H - fd_ph, fd_yo)
        // the plate takes every press on it, so none reaches the window under it
        zone box fcatch { from: fd_px, fd_py; size: fd_pw, fd_ph; show: fu_a > 0.03 }
        // nothing drawn for its last frames open, so the picture a closed full-screen surface keeps is empty
        group {
            show: fu_a > 0.03
            group {
                glow: 14, 0.25 * if(loom_fx, st_glow, 0), fl.phos
                Chamfer(fd_px, fd_py, fd_pw, fd_ph, loom_chamfer + 4, fl.hull, fl.trace, 0.98, 1.4)
            }
            group {
                clip box { from: fd_px, fd_py; size: fd_pw, fd_ph }
                group {
                    move: fd_xo, fd_yo
                    opacity: min(1, fu_a * 1.4)
                    text "SIGNAL FIELD" { at: 18, 19; anchor: left center; size: 11; family: "Share Tech Mono"; color: fl.ember }
                    text "{note_count, 0} WAITING" { at: 132, 19; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.muted }
                    // do not disturb, at a press: a lamp and its word
                    zone box fdnd { from: fd_W - 292, 9; size: 134, 20; cursor: pointer; role: toggle; checked: dnd_now; label: "Do not disturb"; show: notes_on }
                    group {
                        show: notes_on
                        Chamfer(fd_W - 292, 9, 134, 20, 4, if(dnd_now, fl.ember_fill, fl.hull_raised), if(dnd_now, fl.ember, fl.trace), if(dnd_now, 0.95, 0.6 + 0.4 * if(fdnd.hover, 1, 0)))
                        text "DO NOT DISTURB" { at: fd_W - 225, 19; anchor: center; size: 10; family: "Share Tech Mono"; color: if(dnd_now, fl.ink, mix(fl.muted, fl.trace_lit, if(fdnd.hover, 1, 0))) }
                    }
                    on press fdnd { emit note_dnd }
                    zone box fclear { from: fd_W - 150, 9; size: 96, 20; cursor: pointer; role: button; label: "Clear all notices"; show: note_count + note_missed > 0 }
                    group { show: note_count + note_missed > 0; CutButton(fd_W - 150, 9, 96, "Clear all", fl.ember, if(fclear.hover, 1, 0)) }
                    on press fclear { emit note_clear }
                    zone box fclose { from: fd_W - 40, 7; size: 26, 24; cursor: pointer; role: button; label: "Close the Signal Field" }
                    line { from: fd_W - 33, 13; to: fd_W - 21, 25; width: 1.5; color: mix(fl.muted, fl.ember, if(fclose.hover, 1, 0)) }
                    line { from: fd_W - 21, 13; to: fd_W - 33, 25; width: 1.5; color: mix(fl.muted, fl.ember, if(fclose.hover, 1, 0)) }
                    on press fclose { side = none }
                    group {
                        opacity: fu_b
                        line { from: 12, 38; to: fd_W - 12, 38; width: 1; color: fl.trace_dim }
                        // ── the summary: what waits, from how many, how urgent; and each app's share ──
                        group {
                            show: note_count + note_missed > 0
                            text "{note_count, 0} WAITING" { at: 18, 52; anchor: left center; size: 10; weight: 700; family: "Share Tech Mono"; color: fl.phos }
                            text "{fld_apps, 0} APPS" { at: 112, 52; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.trace_lit }
                            text "{fld_urgent, 0} URGENT" { at: 184, 52; anchor: left center; size: 10; weight: 700; family: "Share Tech Mono"
                                                           color: if(fld_urgent > 0, fl.ember, fl.muted) }
                            text "{note_missed, 0} MISSED" { at: 272, 52; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.muted }
                            // the share bar: one segment per app, the chosen one lit, an urgent one in ember
                            row {
                                at: 360, 48
                                gap: 2
                                for p in fshare {
                                    box { size: max(4, (fd_W - 380 - 16) * p.part), 8; corner: 2
                                          color: if(p.critical, fl.ember, if(p.sel, fl.phos, fl.trace)); opacity: if(p.sel, 1, 0.65) }
                                }
                            }
                        }
                        // nothing waiting: a quiet scope, its rings still
                        group {
                            show: note_count + note_missed < 1
                            let fq_x = fd_W / 2
                            let fq_y = 200
                            ellipse { at: fq_x, fq_y; radius: 70; stroke: 1; color: fl.trace_dim }
                            ellipse { at: fq_x, fq_y; radius: 46; stroke: 1; color: fl.trace_dim }
                            ellipse { at: fq_x, fq_y; radius: 22; stroke: 1.2; color: mix(fl.trace, fl.phos, 0.4) }
                            line { from: fq_x - 84, fq_y; to: fq_x + 84, fq_y; width: 1; color: fl.trace_dim; opacity: 0.6 }
                            line { from: fq_x, fq_y - 84; to: fq_x, fq_y + 84; width: 1; color: fl.trace_dim; opacity: 0.6 }
                            group {
                                glow: 8, 60% * st_glow, fl.phos
                                ellipse { at: fq_x, fq_y; radius: 3.5; color: fl.phos }
                            }
                            text pick(notes_on, "Notifications go to another program while mooi runs beside it.", "ALL QUIET") { at: fq_x, fq_y + 108; anchor: center; size: 13; weight: 700; family: "Exo 2"; color: fl.trace_lit; width: fd_W - 40; lines: 2 }
                            text "Signals unfold here as they arrive." { at: fq_x, fq_y + 130; anchor: center; size: 10; family: "Exo 2"; color: fl.muted; show: notes_on }
                        }
                        // the clusters
                        column fcl {
                            at: 12, 70
                            gap: 6
                            view: fd_cw, 382
                            for c in fclus { FieldCluster(c, fld_sel, loom_chamfer, fld_pick, fd_cw - 2) }
                        }
                        // the chosen cluster: its app, and what can be done with all of it
                        group {
                            show: fclus.count > 0
                            text fld_app { at: fd_cw + 26, 80; anchor: left center; size: 11; family: "Share Tech Mono"; color: fl.trace_lit; width: fd_iw - 200; lines: 1 }
                            zone box fmute { from: fd_W - 200, 70; size: 84, 20; cursor: pointer; role: toggle; checked: fld_muted
                                             label: pick(fld_muted, "Mute {fld_app}: its notices whisper", "Unmute {fld_app}"); show: not fld_lost }
                            group { show: not fld_lost and not fld_muted; CutButton(fd_W - 200, 70, 84, "Mute app", fl.flare, if(fmute.hover, 1, 0)) }
                            group { show: not fld_lost and fld_muted; CutButton(fd_W - 200, 70, 84, "Unmute", fl.flare, 1) }
                            on press fmute { emit fld_mute }
                            zone box fall { from: fd_W - 110, 70; size: 98, 20; cursor: pointer; role: button; label: "Dismiss all of {fld_app}" }
                            group { show: not fld_lost; CutButton(fd_W - 110, 70, 98, "Dismiss all", fl.ember, if(fall.hover, 1, 0)) }
                            group { show: fld_lost; CutButton(fd_W - 110, 70, 98, "Forget all", fl.ember, if(fall.hover, 1, 0)) }
                            on press fall { emit fld_dismiss_all }
                        }
                        column fit {
                            at: fd_cw + 24, 98
                            gap: 6
                            view: fd_iw, 354
                            for n in fitems { FieldItem(n, fld_item, loom_chamfer, fld_choose, fld_open, fld_act, fld_snooze, fld_dismiss, fd_iw) }
                        }
                        // the activity rail: the last six hours, now at the right
                        line { from: 12, 462; to: fd_W - 12, 462; width: 1; color: fl.trace_dim }
                        text "ACTIVITY" { at: 18, 476; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.muted }
                        line { from: 16, 502; to: fd_W - 16, 502; width: 1; color: fl.trace }
                        text "6 H" { at: 16, 520; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.muted }
                        text "3 H" { at: 16 + (fd_W - 32) * 0.293, 520; anchor: center; size: 10; family: "Share Tech Mono"; color: fl.muted }
                        text "1 H" { at: 16 + (fd_W - 32) * 0.592, 520; anchor: center; size: 10; family: "Share Tech Mono"; color: fl.muted }
                        text "NOW" { at: fd_W - 16, 520; anchor: right center; size: 10; family: "Share Tech Mono"; color: fl.muted }
                        for r in frail { RailTick(r, 16, fd_W - 32, 502, fld_pick) }
                        text "↑↓ CLUSTERS · SHIFT ↑↓ NOTICES · ⏎ OPEN · DEL DISMISS · S SNOOZE · M MUTE · ESC" { at: fd_W - 18, 476; anchor: right center; size: 10
                             family: "Share Tech Mono"; color: fl.muted; show: loom_comfy }
                        text "↑↓ · SHIFT ↑↓ · ⏎ · DEL · S · M · ESC" { at: fd_W - 18, 476; anchor: right center; size: 10; family: "Share Tech Mono"; color: fl.muted; show: not loom_comfy }
                    }
                }
            }
        }
    }
    // ── window_island (drawn in the bar's own surface, under the bar's strip: D53) ──
    group {
        move: 0, st_res + 6

        // Under the module that opens it (D53): a strip as wide as the screen whose panel sits
        // under the module's middle, kept on the screen; the strip's empty parts let presses through.
        let wi_ox = clamp((if(p_actions, xs_actions + ws_actions / 2, screen.width / 2)) - 180, 8, screen.width - 368)
        // nothing drawn for its last frames open, so the picture a closed full-screen surface keeps is empty
        group {
            show: rv.window > 0.03
            move: wi_ox, 0

            IslandFrame(rv.window, 340, 132 + 80 * depth, tx: if(p_actions, xs_actions + ws_actions / 2 - wi_ox, -1)) {
                text "{upper(tgt_class)}" { at: 16, 20; anchor: left center; size: 10; weight: 700; color: fg.secondary; width: 280; lines: 1 }
                text tgt_title { at: 16, 38; anchor: left center; size: 13; color: fg.primary; width: 290; lines: 1 }

                zone box xbtn { at: 322, 20; size: 24, 24; corner: 6; cursor: pointer; label: "Close panel" }
                group { move: 310, 8; opacity: xbtn.hover; BtnFace(24, 24, xbtn.hover, 0) }
                line { from: 317, 15; to: 327, 25; width: 1.4; color: fg.secondary }
                line { from: 327, 15; to: 317, 25; width: 1.4; color: fg.secondary }
                on press xbtn { open = none }

                // Actions: 0 float · 1 fullscreen · 2 pin · 3 move · 4 close
                repeat k in 0..5 {
                    group {
                        move: 12 + k * 64, 58
                        let on_k = pick(k, floating, fullscreen, pinned, 0, arming)
                        let usable_k = target_ok and not busy and (k != 2 or floating)
                        prop lit = 0 ~m.select
                        follow lit = if(sel == k, 1, 0)

                        zone box act.$k { from: 0, 0; size: 60, 48; corner: g.radius.item; cursor: pointer; active: usable_k
                                          label: pick(k, "Float", "Fullscreen", "Pin", "Move to workspace", "Close window") }
                        BtnFace(60, 48, act.$k.hover, lit, arming * (k == 4), not usable_k)
                        ellipse { at: 52, 8; radius: 2.5; color: accent.primary; opacity: if(k < 3, on_k, 0) }

                        group {
                            opacity: if(usable_k, 1, 0.4)
                            group { show: k == 0
                                box { at: 27, 18; size: 16, 11; corner: 2; stroke: 1.3; color: fg.primary }
                                box { at: 33, 23; size: 16, 11; corner: 2; color: surface.elevated }
                                box { at: 33, 23; size: 16, 11; corner: 2; stroke: 1.3; color: fg.primary } }
                            group { show: k == 1
                                box { at: 30, 20; size: 20, 14; corner: 2; stroke: 1.3; color: fg.primary }
                                box { at: 30, 20; size: 10, 6; corner: 1; color: fg.primary; opacity: 1 - fullscreen } }
                            group { show: k == 2
                                ellipse { at: 30, 15; radius: 4.5; stroke: 1.3; color: fg.primary }
                                line { from: 30, 20; to: 30, 28; width: 1.3; color: fg.primary } }
                            group { show: k == 3
                                line { from: 21, 20; to: 38, 20; width: 1.3; color: fg.primary }
                                line { from: 33, 15; to: 38, 20; width: 1.3; color: fg.primary }
                                line { from: 33, 25; to: 38, 20; width: 1.3; color: fg.primary } }
                            group { show: k == 4
                                line { from: 25, 15; to: 35, 25; width: 1.4; color: if(arming, accent.secondary, fg.primary) }
                                line { from: 35, 15; to: 25, 25; width: 1.4; color: if(arming, accent.secondary, fg.primary) } }
                            text pick(k * 2 + on_k, "Float", "Tile", "Full", "Exit", "Pin", "Unpin", "Move", "Move", "Close", "Sure?") { at: 30, 38; anchor: center; size: 10; color: fg.secondary }
                        }
                        on press act.$k { sel = k; emit activate(k) }
                    }
                }

                // Expanded: move the window to a workspace.
                group {
                    opacity: depth
                    show: depth > 0.02
                    move: 0, -8 * (1 - depth)
                    repeat j in 0..10 {
                        group {
                            move: 12 + mod(j, 5) * 64, 118 + floor(j / 5) * 36
                            zone box wsb.$j { from: 0, 0; size: 60, 30; corner: 6; cursor: pointer; active: phase == expanded; label: "Workspace {j + 1}" }
                            BtnFace(60, 30, wsb.$j.hover, if(wsel == j + 1, 1, 0))
                            text "{j + 1}" { at: 30, 15; anchor: center; size: 12; weight: 600
                                             color: if(ws_target == j + 1, fg.muted, fg.primary) }
                            box { at: 30, 25; size: 10, 2; corner: 1; color: fg.muted; show: ws_target == j + 1 }   // where it is now
                            on press wsb.$j { wsel = j + 1; emit pick_ws(j + 1) }
                        }
                    }
                }

                let hint_y = 120 + 80 * depth
                let hint_k = if(busy, 3, if(phase == expanded, 2, if(arming, 1, 0)))
                text pick(hint_k, "←→ select   ↵ apply   esc close", "↵ again to close   esc keeps it", "←→ ↵ move   esc back", "Waiting for Hyprland…") {
                     at: 16, hint_y; anchor: left center; size: 10.5; color: if(arming, accent.secondary, fg.muted); opacity: 1 - fb }
                text feedback { at: 16, hint_y; anchor: left center; size: 10; width: 310; lines: 1
                                color: if(note.failed, status.error, status.ok); opacity: fb }
            }
        }
    }
    // ── system_island (drawn in the bar's own surface, under the bar's strip: D53) ──
    group {
        move: 0, st_res + 6

        // Under the module that opens it (D53): a strip as wide as the screen whose panel sits
        // under the module's middle, kept on the screen; the strip's empty parts let presses through.
        let sy_ox = clamp((if(sys_cx > 0, sys_cx, if(p_network, xs_network + ws_network / 2, screen.width / 2))) - 160, 8, screen.width - 328)
        // nothing drawn for its last frames open, so the picture a closed full-screen surface keeps is empty
        group {
            show: rv.system > 0.03
            move: sy_ox, 0

            // It hangs under the module that opened it and grows down from the bar; inside, y
            // counts from the island's top.
            let sh = 144 + 52 * brightness.present
            group {
                move: 0, 0
                IslandFrame(rv.system, 300, sh, tx: if(sys_cx > 0, sys_cx, if(p_network, xs_network + ws_network / 2, -1)) - sy_ox) {
                    text "SYSTEM" { at: 16, 20; anchor: left center; size: 10; weight: 700; color: fg.secondary }
                    text "{? {network.name} · }{network.strength, 0}%" { at: 284, 20; anchor: right center; size: 10; color: fg.secondary; show: network.online and network.kind == wifi }
                    text "Wired" { at: 284, 20; anchor: right center; size: 10; color: fg.secondary; show: network.online and network.kind == wired }
                    text "Offline" { at: 284, 20; anchor: right center; size: 10; color: status.error; show: not network.online }

                    // Bluetooth is a state here, not a control: the bar's rune reports it and
                    // this line names it, so a widget that only ever opens this surface never
                    // offers something the surface cannot do.
                    text pick(bluetooth.present and bluetooth.powered, "Bluetooth off", "Bluetooth on") {
                        at: 284, 36; anchor: right center; size: 10.5; color: fg.secondary; show: bluetooth.present }
                    text "No Bluetooth" { at: 284, 36; anchor: right center; size: 10; color: fg.muted; show: not bluetooth.present }

                    group {
                        move: 16, 52
                        Level("Volume", pick(audio.muted, "{audio.volume * 100, 0} %", "Muted"), audio.volume * (1 - audio.muted), srow == 0, vol)
                    }
                    group {
                        show: brightness.present
                        move: 16, 104
                        Level("Brightness", "{brightness.level * 100, 0} %", brightness.level, srow == 1, bri)
                    }

                    text pick(battery.charging, "{battery.percent, 0} % · on battery", "{battery.percent, 0} % · charging") { at: 16, sh - 20; anchor: left center; size: 10.5; color: if(low, status.error, fg.secondary); show: battery.present }
                    text "↑↓  ←→  m mute  esc" { at: 284, sh - 20; anchor: right center; size: 10; color: fg.muted }
                }
            }
        }
    }
    // ── calendar_island (D97): the month under the clock ──
    group {
        move: 0, if(isl_shelf, clamp(isl_sy - 26, st_res + 6, screen.height - (292) - 20), st_res + 6)
        let ca_ox = if(isl_shelf, screen.width - 56 - 300, clamp(isl_cx - 150, 8, screen.width - 308))
        group {
            show: rv.calendar > 0.03
            move: ca_ox, 0
            IslandFrame(rv.calendar, 300, 292, tx: if(isl_shelf, -1, isl_cx - ca_ox)) {
                zone box keep_calendar { from: 0, 0; size: 300, 292; role: region; agent: hidden }
                IsleHead(300, cal_title, cal_sub)
                repeat k in 0..7 {
                    text pick(k, "MO", "TU", "WE", "TH", "FR", "SA", "SU") { at: 33 + k * 39, 46; anchor: center; align: center; size: 9
                         family: "Share Tech Mono"; color: if(k > 4, if(isl_style > 0.5, fg.muted, fl.ember), if(isl_style > 0.5, fg.secondary, fl.muted)) }
                }
                zone box calgrid { from: 12, 56; size: 276, 180; role: region; label: "The month — the wheel turns it" }
                on scroll calgrid { emit cal_shift(if(wheel > 0, 2, 0)) }
                for c in cal {
                    let ccx = 33 + mod(c.n, 7) * 39
                    let ccy = 70 + floor(c.n / 7) * 29
                    group {
                        show: c.today
                        glow: 6, (0.6) * st_glow, if(isl_style > 0.5, accent.primary, fl.phos)
                        box { at: ccx, ccy; size: 30, 24; corner: if(isl_style > 0.5, 12, 2); color: if(isl_style > 0.5, accent.primary, fl.phos) }
                    }
                    text "{c.day, 0}" { at: ccx, ccy; anchor: center; align: center; size: 12; weight: 600; family: "Exo 2"
                         color: if(c.today, if(isl_style > 0.5, bg.primary, fl.ink),
                                if(c.cur, if(c.weekend, if(isl_style > 0.5, fg.secondary, fl.ember), if(isl_style > 0.5, fg.primary, fl.engrave)),
                                   if(isl_style > 0.5, fg.muted, fl.trace_dim)))
                         opacity: if(c.cur, 1, 0.45) }
                }
                IsleRule(300, 250)
                zone box calprev { from: 16, 258; size: 40, 24; cursor: pointer; role: button; label: "The month before" }
                IsleBtn(16, 258, 40, "‹", 0, calprev.hover)
                zone box calnow { from: 110, 258; size: 80, 24; cursor: pointer; role: button; label: "This month" }
                IsleBtn(110, 258, 80, "Today", if(cal_home, 0, 1), calnow.hover)
                zone box calnext { from: 244, 258; size: 40, 24; cursor: pointer; role: button; label: "The month after" }
                IsleBtn(244, 258, 40, "›", 0, calnext.hover)
                on press calprev { emit cal_shift(0) }
                on press calnow { emit cal_shift(1) }
                on press calnext { emit cal_shift(2) }
            }
        }
    }

    // ── stats_island (D97): the machine under the resources module ──
    group {
        move: 0, if(isl_shelf, clamp(isl_sy - 26, st_res + 6, screen.height - (300 + if(st_gpu_ok, 30, 0)) - 20), st_res + 6)
        let so_ox = if(isl_shelf, screen.width - 56 - 320, clamp(isl_cx - 160, 8, screen.width - 328))
        let sgh = if(st_gpu_ok, 30, 0)
        group {
            show: rv.stats > 0.03
            move: so_ox, 0
            IslandFrame(rv.stats, 320, 300 + sgh, tx: if(isl_shelf, -1, isl_cx - so_ox)) {
                zone box keep_stats { from: 0, 0; size: 320, 300 + if(st_gpu_ok, 30, 0); role: region; agent: hidden }
                IsleHead(320, "System", st_load)
                IsleGauge(16, 40, 288, "Processor", "{round(res_cpu * 100), 0} % · {round(res_temp), 0} °C", res_cpu, res_cpu > 0.85 or res_temp > 85)
                IsleGauge(16, 72, 288, "Memory", st_mem_t, st_mem_f, st_mem_f > 0.9)
                group { show: st_gpu_ok
                        IsleGauge(16, 104, 288, "Graphics", "{round(st_gpu_f * 100), 0} %", st_gpu_f, st_gpu_f > 0.9) }
                IsleGauge(16, 104 + sgh, 288, "Disk  /", st_disk_t, st_disk_f, st_disk_f > 0.9)
                text st_swap_t { at: 16, 146 + sgh; anchor: left center; size: 10; family: "Share Tech Mono"; color: if(isl_style > 0.5, fg.muted, fl.muted) }
                IsleRule(320, 158 + sgh)
                text "BUSIEST" { at: 16, 172 + sgh; anchor: left center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(isl_style > 0.5, fg.secondary, fl.muted) }
                for t in st_top {
                    let ty = 192 + sgh + t.index * 20
                    text t.name { at: 16, ty; anchor: left center; size: 12; family: "Exo 2"; color: if(isl_style > 0.5, fg.primary, fl.engrave); width: 220; lines: 1 }
                    text "{t.cpu, 1} %" { at: 304, ty; anchor: right center; size: 11; family: "Share Tech Mono"; color: if(t.cpu > 50, if(isl_style > 0.5, status.error, fl.ember), if(isl_style > 0.5, fg.secondary, fl.phos)) }
                }
                IsleRule(320, 254 + sgh)
                zone box stbtop { from: 16, 264 + sgh; size: 136, 24; cursor: pointer; role: button; label: "Open btop in a terminal" }
                IsleBtn(16, 264 + sgh, 136, "btop", 0, stbtop.hover)
                on press stbtop { emit st_open(0); open = none }
                group {
                    show: st_nvtop
                    zone box stnv { from: 168, 264 + sgh; size: 136, 24; cursor: pointer; role: button; label: "Open nvtop in a terminal" }
                    IsleBtn(168, 264 + sgh, 136, "nvtop", 0, stnv.hover)
                    on press stnv { emit st_open(1); open = none }
                }
            }
        }
    }

    // ── weather_island (D97): now, the next hours and the days ahead ──
    group {
        move: 0, if(isl_shelf, clamp(isl_sy - 26, st_res + 6, screen.height - (356) - 20), st_res + 6)
        let wi_x = if(isl_shelf, screen.width - 56 - 340, clamp(isl_cx - 170, 8, screen.width - 348))
        group {
            show: rv.weather > 0.03
            move: wi_x, 0
            IslandFrame(rv.weather, 340, 356, tx: if(isl_shelf, -1, isl_cx - wi_x)) {
                zone box keep_weather { from: 0, 0; size: 340, 356; role: region; agent: hidden }
                IsleHead(340, wxi_title, wxi_sub)
                group {
                    show: not wxi_ok
                    text pick(wxi_busy, "No forecast — offline, or open-meteo did not answer", "Fetching the forecast…") { at: 170, 120; anchor: center; align: center
                         size: 12; family: "Exo 2"; color: if(isl_style > 0.5, fg.secondary, fl.muted); width: 300; lines: 2 }
                }
                group {
                    show: wxi_ok
                    WxGlyph(46, 68, 46, wxi_kind)
                    text "{round(wxi_temp), 0}°" { at: 82, 62; anchor: left center; size: 34; weight: 600; family: "Exo 2"; color: if(isl_style > 0.5, fg.primary, fl.phos) }
                    text wxi_word { at: 84, 88; anchor: left center; size: 11; weight: 700; family: "Share Tech Mono"; color: if(isl_style > 0.5, fg.secondary, fl.phos) }
                    text wxi_hilo { at: 324, 56; anchor: right center; size: 12; family: "Exo 2"; color: if(isl_style > 0.5, fg.primary, fl.engrave) }
                    text wxi_line { at: 324, 78; anchor: right center; size: 10; family: "Exo 2"; color: if(isl_style > 0.5, fg.secondary, fl.muted); width: 190; lines: 2; align: right }
                    IsleRule(340, 108)
                    for h in wx_hours {
                        let hx = 40 + h.n * 52
                        text h.label { at: hx, 122; anchor: center; align: center; size: 10; family: "Share Tech Mono"; color: if(isl_style > 0.5, fg.secondary, fl.muted) }
                        WxGlyph(hx, 144, 20, h.kind)
                        text "{round(h.temp), 0}°" { at: hx, 166; anchor: center; align: center; size: 12; family: "Exo 2"; color: if(isl_style > 0.5, fg.primary, fl.engrave) }
                    }
                    IsleRule(340, 182)
                    for d in wx_days {
                        let dy = 198 + d.n * 25
                        text d.label { at: 16, dy; anchor: left center; size: 12; family: "Exo 2"; color: if(isl_style > 0.5, fg.primary, fl.engrave); width: 60; lines: 1 }
                        WxGlyph(96, dy, 17, d.kind)
                        text "{round(d.lo), 0}°" { at: 146, dy; anchor: right center; size: 11; family: "Exo 2"; color: if(isl_style > 0.5, fg.secondary, fl.muted) }
                        box { from: 156, dy - 2; size: 128, 4; corner: 2; color: if(isl_style > 0.5, bg.primary, fl.well) }
                        box { from: 156 + 128 * d.a, dy - 2; size: max(4, 128 * (d.b - d.a)), 4; corner: 2
                              color: if(isl_style > 0.5, accent.primary, fl.phos) }
                        text "{round(d.hi), 0}°" { at: 324, dy; anchor: right center; size: 11; family: "Exo 2"; color: if(isl_style > 0.5, fg.primary, fl.engrave) }
                    }
                }
                IsleRule(340, 318)
                zone box wxref { from: 16, 326; size: 100, 24; cursor: pointer; role: button; label: "Fetch the forecast again" }
                IsleBtn(16, 326, 100, "Refresh", if(wxi_busy, 1, 0), wxref.hover)
                on press wxref { emit wx_refresh }
                text "open-meteo.com" { at: 324, 338; anchor: right center; size: 10; family: "Share Tech Mono"; color: if(isl_style > 0.5, fg.secondary, fl.muted); opacity: 0.7 }
            }
        }
    }

    // ── sound_island (D97): the level, the microphone, where it plays ──
    group {
        move: 0, if(isl_shelf, clamp(isl_sy - 26, st_res + 6, screen.height - (214 + 26 * min(aouts.count, 6)) - 20), st_res + 6)
        let sn_x = if(isl_shelf, screen.width - 56 - 320, clamp(isl_cx - 160, 8, screen.width - 328))
        let snh = 214 + 26 * min(aouts.count, 6)
        group {
            show: rv.sound > 0.03
            move: sn_x, 0
            IslandFrame(rv.sound, 320, snh, tx: if(isl_shelf, -1, isl_cx - sn_x)) {
                zone box keep_sound { from: 0, 0; size: 320, 214 + 26 * min(aouts.count, 6); role: region; agent: hidden }
                IsleHead(320, "Sound", pick(audio.muted, "{round(audio.volume * 100), 0} %", "Muted"))
                group { move: 16, 40
                        Level("Output", pick(audio.muted, "{round(audio.volume * 100), 0} %", "Muted"), audio.volume * (1 - audio.muted), false, vol, 288) }
                group { move: 16, 92
                        Level("Microphone", pick(audio.input_muted, "{round(audio.input * 100), 0} %", "Muted"), audio.input * (1 - audio.input_muted), false, mic_vol, 288) }
                zone box snmute { from: 16, 142; size: 90, 24; cursor: pointer; role: toggle; checked: audio.muted; label: "Mute the output" }
                IsleBtn(16, 142, 90, "Mute", if(audio.muted, 1, 0), snmute.hover)
                on press snmute { emit mute }
                zone box snmic { from: 115, 142; size: 90, 24; cursor: pointer; role: toggle; checked: audio.input_muted; label: "Mute the microphone" }
                IsleBtn(115, 142, 90, "Mic off", if(audio.input_muted, 1, 0), snmic.hover)
                on press snmic { emit mic_mute }
                zone box snmix { from: 214, 142; size: 90, 24; cursor: pointer; role: button; label: "Open the mixer" }
                IsleBtn(214, 142, 90, "Mixer", 0, snmix.hover)
                on press snmix { emit snd_mixer; open = none }
                IsleRule(320, 178)
                text "PLAYS ON" { at: 16, 192; anchor: left center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(isl_style > 0.5, fg.secondary, fl.muted) }
                for o in aouts {
                    let oy = 206 + o.index * 26
                    zone box sno { from: 10, oy; size: 300, 24; cursor: pointer; role: item; selected: o.default; label: "Play on {o.name}" }
                    box { from: 10, oy; size: 300, 24; corner: if(isl_style > 0.5, 8, 2); color: if(isl_style > 0.5, selection.bg, fl.well)
                          opacity: max(if(o.default, 0.9, 0), 0.6 * sno.hover) }
                    group {
                        show: o.default
                        glow: 5, (0.7) * st_glow, if(isl_style > 0.5, accent.primary, fl.phos)
                        ellipse { at: 22, oy + 12; radius: 3.5; color: if(isl_style > 0.5, accent.primary, fl.phos) }
                    }
                    ellipse { at: 22, oy + 12; radius: 3.5; stroke: 1; color: if(isl_style > 0.5, fg.muted, fl.trace); show: not o.default }
                    text o.name { at: 36, oy + 12; anchor: left center; size: 12; family: "Exo 2"; width: 264; lines: 1
                                  color: if(o.default, if(isl_style > 0.5, fg.primary, fl.phos), if(isl_style > 0.5, fg.secondary, fl.engrave)) }
                    on press sno { emit snd_out(o.index) }
                }
            }
        }
    }

    // ── display_island (D97): brightness, the night light, dark or light ──
    group {
        move: 0, if(isl_shelf, clamp(isl_sy - 26, st_res + 6, screen.height - (150 + if(brightness.present, 52, 0)) - 20), st_res + 6)
        let dp_x = if(isl_shelf, screen.width - 56 - 300, clamp(isl_cx - 150, 8, screen.width - 308))
        let dbh = if(brightness.present, 52, 0)
        group {
            show: rv.display > 0.03
            move: dp_x, 0
            IslandFrame(rv.display, 300, 150 + dbh, tx: if(isl_shelf, -1, isl_cx - dp_x)) {
                zone box keep_display { from: 0, 0; size: 300, 150 + if(brightness.present, 52, 0); role: region; agent: hidden }
                IsleHead(300, "Display", pick(brightness.present, "No backlight", "{round(brightness.level * 100), 0} %"))
                group { show: brightness.present
                        move: 16, 40
                        Level("Brightness", "{round(brightness.level * 100), 0} %", brightness.level, false, bri, 268) }
                text "Night light" { at: 16, 56 + dbh; anchor: left center; size: 12; family: "Exo 2"; color: if(isl_style > 0.5, fg.primary, fl.engrave) }
                text "warmer colours, 4000 K" { at: 16, 72 + dbh; anchor: left center; size: 10; family: "Exo 2"; color: if(isl_style > 0.5, fg.muted, fl.muted) }
                zone box dpnl { from: 204, 50 + dbh; size: 80, 24; cursor: pointer; role: toggle; checked: nl_on; label: "The night light" }
                group { show: not nl_on
                        IsleBtn(204, 50 + dbh, 80, "Off", 0, dpnl.hover) }
                group { show: nl_on
                        IsleBtn(204, 50 + dbh, 80, "On", 1, dpnl.hover) }
                on press dpnl { emit night_light }
                IsleRule(300, 90 + dbh)
                text "Mode" { at: 16, 112 + dbh; anchor: left center; size: 12; family: "Exo 2"; color: if(isl_style > 0.5, fg.primary, fl.engrave) }
                zone box dpm0 { from: 92, 100 + dbh; size: 62, 24; cursor: pointer; role: tab; selected: th_mode == 0; label: "Dark" }
                IsleBtn(92, 100 + dbh, 62, "Dark", if(th_mode == 0, 1, 0), dpm0.hover)
                on press dpm0 { emit set_mode(0) }
                zone box dpm1 { from: 158, 100 + dbh; size: 62, 24; cursor: pointer; role: tab; selected: th_mode == 1; label: "Light" }
                IsleBtn(158, 100 + dbh, 62, "Light", if(th_mode == 1, 1, 0), dpm1.hover)
                on press dpm1 { emit set_mode(1) }
                zone box dpm2 { from: 224, 100 + dbh; size: 62, 24; cursor: pointer; role: tab; selected: th_mode == 2; label: "Light by day, dark by night" }
                IsleBtn(224, 100 + dbh, 62, "Auto", if(th_mode == 2, 1, 0), dpm2.hover)
                on press dpm2 { emit set_mode(2) }
            }
        }
    }

    // ── power_island (D97): the battery, how long it lasts, what saves it ──
    group {
        move: 0, if(isl_shelf, clamp(isl_sy - 26, st_res + 6, screen.height - (252 + if(pw_ppd, 40, 0)) - 20), st_res + 6)
        let pw_x = if(isl_shelf, screen.width - 56 - 320, clamp(isl_cx - 160, 8, screen.width - 328))
        let pph = if(pw_ppd, 40, 0)
        group {
            show: rv.power > 0.03
            move: pw_x, 0
            IslandFrame(rv.power, 320, 252 + pph, tx: if(isl_shelf, -1, isl_cx - pw_x)) {
                zone box keep_power { from: 0, 0; size: 320, 252 + if(pw_ppd, 40, 0); role: region; agent: hidden }
                IsleHead(320, "Power", pw_state)
                text "{round(battery.percent), 0}%" { at: 16, 62; anchor: left center; size: 34; weight: 600; family: "Exo 2"
                     color: if(battery.percent < 15 and not battery.charging, if(isl_style > 0.5, status.error, fl.ember), if(isl_style > 0.5, fg.primary, fl.phos)) }
                text pw_time { at: 304, 52; anchor: right center; size: 12; family: "Exo 2"; color: if(isl_style > 0.5, fg.primary, fl.engrave); width: 180; lines: 1; align: right }
                text pw_rate { at: 304, 72; anchor: right center; size: 10; family: "Exo 2"; color: if(isl_style > 0.5, fg.secondary, fl.muted); width: 190; lines: 1; align: right }
                IsleMeter(16, 90, 288, battery.percent / 100, battery.percent < 15 and not battery.charging)
                IsleRule(320, 112)
                text "Battery saver" { at: 16, 132; anchor: left center; size: 12; family: "Exo 2"; color: if(isl_style > 0.5, fg.primary, fl.engrave) }
                text "less glow and motion" { at: 16, 147; anchor: left center; size: 10; family: "Exo 2"; color: if(isl_style > 0.5, fg.muted, fl.muted) }
                zone box pws0 { from: 124, 122; size: 56, 24; cursor: pointer; role: tab; selected: pw_saver == 0; label: "Battery saver off" }
                IsleBtn(124, 122, 56, "Off", if(pw_saver == 0, 1, 0), pws0.hover)
                on press pws0 { emit pw_set(0) }
                zone box pws1 { from: 184, 122; size: 64, 24; cursor: pointer; role: tab; selected: pw_saver == 1; label: "Battery saver on battery" }
                IsleBtn(184, 122, 64, "Battery", if(pw_saver == 1, 1, 0), pws1.hover)
                on press pws1 { emit pw_set(1) }
                zone box pws2 { from: 252, 122; size: 52, 24; cursor: pointer; role: tab; selected: pw_saver == 2; label: "Battery saver always" }
                IsleBtn(252, 122, 52, "Always", if(pw_saver == 2, 1, 0), pws2.hover)
                on press pws2 { emit pw_set(2) }
                group {
                    show: pw_ppd
                    text "Profile" { at: 16, 174; anchor: left center; size: 12; family: "Exo 2"; color: if(isl_style > 0.5, fg.primary, fl.engrave) }
                    zone box pwp1 { from: 92, 162; size: 68, 24; cursor: pointer; role: tab; selected: pw_prof == 1; label: "Power saver" }
                    IsleBtn(92, 162, 68, "Saver", if(pw_prof == 1, 1, 0), pwp1.hover)
                    on press pwp1 { emit pw_set(11) }
                    zone box pwp2 { from: 164, 162; size: 68, 24; cursor: pointer; role: tab; selected: pw_prof == 2; label: "Balanced" }
                    IsleBtn(164, 162, 68, "Balanced", if(pw_prof == 2, 1, 0), pwp2.hover)
                    on press pwp2 { emit pw_set(12) }
                    zone box pwp3 { from: 236, 162; size: 68, 24; cursor: pointer; role: tab; selected: pw_prof == 3; label: "Performance" }
                    IsleBtn(236, 162, 68, "Perform", if(pw_prof == 3, 1, 0), pwp3.hover)
                    on press pwp3 { emit pw_set(13) }
                }
                text "Keep awake" { at: 16, 174 + pph; anchor: left center; size: 12; family: "Exo 2"; color: if(isl_style > 0.5, fg.primary, fl.engrave) }
                text "no sleep, no screen-off" { at: 16, 189 + pph; anchor: left center; size: 10; family: "Exo 2"; color: if(isl_style > 0.5, fg.muted, fl.muted) }
                zone box pwcaf { from: 224, 164 + pph; size: 80, 24; cursor: pointer; role: toggle; checked: caffeine_on; label: "Keep awake" }
                group { show: not caffeine_on
                        IsleBtn(224, 164 + pph, 80, "Off", 0, pwcaf.hover) }
                group { show: caffeine_on
                        IsleBtn(224, 164 + pph, 80, "On", 1, pwcaf.hover) }
                on press pwcaf { emit caffeine }
                IsleRule(320, 206 + pph)
                zone box pwlock { from: 16, 216 + pph; size: 140, 24; cursor: pointer; role: button; label: "Lock the screen" }
                IsleBtn(16, 216 + pph, 140, "Lock", 0, pwlock.hover)
                on press pwlock { emit power(1); open = none }
                zone box pwsess { from: 164, 216 + pph; size: 140, 24; cursor: pointer; role: button; label: "The session menu" }
                IsleBtn(164, 216 + pph, 140, "Session", 0, pwsess.hover)
                on press pwsess { emit power(0); open = none }
            }
        }
    }


    // ── shnet shelf (D100): beside the spine only ──
    group {
        move: 0, clamp(isl_sy - 26, st_res + 6, screen.height - (112 + 28 * max(1, min(5, nets.count)) + 28 * max(1, min(5, btd.count))) - 20)
        group {
            show: rv.shnet > 0.03
            move: screen.width - 56 - 300, 0
            IslandFrame(rv.shnet, 300, 112 + 28 * max(1, min(5, nets.count)) + 28 * max(1, min(5, btd.count))) {
                zone box keep_shnet { from: 0, 0; size: 300, 112 + 28 * max(1, min(5, nets.count)) + 28 * max(1, min(5, btd.count)); role: region; agent: hidden }
                IsleHead(300, "Connections", pick(network.online, "offline", network.name))
                zone box snw { from: 204, 36; size: 80, 22; cursor: pointer; role: toggle; checked: network.wifi; label: "Wi-Fi on or off" }
                group { show: network.wifi
                        IsleBtn(204, 36, 80, "Wi-Fi on", 1, snw.hover, 22) }
                group { show: not network.wifi
                        IsleBtn(204, 36, 80, "Wi-Fi off", 0, snw.hover, 22) }
                on press snw { emit sh_net(-1) }
                text "WI-FI" { at: 16, 47; anchor: left center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(isl_style > 0.5, fg.secondary, fl.muted) }
                for w in nets {
                    let wy = 64 + w.index * 28
                    group {
                        show: w.index < 5
                        zone box snz { from: 8, wy; size: 284, 26; cursor: pointer; role: item; selected: w.active; label: "Join {w.ssid}" }
                        box { from: 8, wy; size: 284, 26; corner: if(isl_style > 0.5, 8, 2); color: if(isl_style > 0.5, selection.bg, fl.well); opacity: max(if(w.active, 0.9, 0), 0.6 * snz.hover) }
                        repeat b in 0..4 {
                            box { from: 18 + b * 4, wy + 19 - b * 3; size: 3, 3 + b * 3; corner: 1; color: if(w.strength > b * 25, if(isl_style > 0.5, accent.primary, fl.phos), if(isl_style > 0.5, fg.muted, fl.muted)); opacity: if(w.strength > b * 25, 1, 0.4) }
                        }
                        text w.ssid { at: 42, wy + 13; anchor: left center; size: 12; family: "Exo 2"; width: 180; lines: 1; color: if(w.active, if(isl_style > 0.5, accent.primary, fl.phos), if(isl_style > 0.5, fg.primary, fl.engrave)) }
                        text "connected" { at: 284, wy + 13; anchor: right center; size: 10; family: "Share Tech Mono"; color: if(isl_style > 0.5, fg.muted, fl.muted); show: w.active }
                        text "saved" { at: 284, wy + 13; anchor: right center; size: 10; family: "Share Tech Mono"; color: if(isl_style > 0.5, fg.muted, fl.muted); show: not w.active and w.known }
                        text "locked" { at: 284, wy + 13; anchor: right center; size: 10; family: "Share Tech Mono"; color: if(isl_style > 0.5, fg.muted, fl.muted); show: not w.active and not w.known and w.secure }
                        on press snz { emit sh_net(w.index) }
                    }
                }
                text "No networks in reach" { at: 16, 78; anchor: left center; size: 12; family: "Exo 2"; color: if(isl_style > 0.5, fg.muted, fl.muted); show: nets.count < 1 }
                let sby = 70 + max(1, min(5, nets.count)) * 28
                IsleRule(300, sby)
                text "BLUETOOTH" { at: 16, sby + 16; anchor: left center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(isl_style > 0.5, fg.secondary, fl.muted) }
                zone box sbp { from: 204, sby + 6; size: 80, 22; cursor: pointer; role: toggle; checked: bluetooth.powered; label: "Bluetooth on or off" }
                group { show: bluetooth.powered
                        IsleBtn(204, sby + 6, 80, "On", 1, sbp.hover, 22) }
                group { show: not bluetooth.powered
                        IsleBtn(204, sby + 6, 80, "Off", 0, sbp.hover, 22) }
                on press sbp { emit sh_bt(-1) }
                for d in btd {
                    let dy = sby + 34 + d.index * 28
                    group {
                        show: d.index < 5
                        zone box sdz { from: 8, dy; size: 284, 26; cursor: pointer; role: item; selected: d.connected; label: "Connect or disconnect {d.name}" }
                        box { from: 8, dy; size: 284, 26; corner: if(isl_style > 0.5, 8, 2); color: if(isl_style > 0.5, selection.bg, fl.well); opacity: max(if(d.connected, 0.9, 0), 0.6 * sdz.hover) }
                        ellipse { at: 22, dy + 13; radius: 3.5; color: if(d.connected, if(isl_style > 0.5, accent.primary, fl.phos), if(isl_style > 0.5, fg.muted, fl.muted)) }
                        text d.name { at: 34, dy + 13; anchor: left center; size: 12; family: "Exo 2"; width: 190; lines: 1; color: if(d.connected, if(isl_style > 0.5, accent.primary, fl.phos), if(isl_style > 0.5, fg.primary, fl.engrave)) }
                        text "{round(d.battery * 100), 0} %" { at: 284, dy + 13; anchor: right center; size: 10; family: "Share Tech Mono"; color: if(isl_style > 0.5, fg.muted, fl.muted); show: d.battery >= 0 }
                        text "connected" { at: 284, dy + 13; anchor: right center; size: 10; family: "Share Tech Mono"; color: if(isl_style > 0.5, fg.muted, fl.muted); show: d.battery < 0 and d.connected }
                        on press sdz { emit sh_bt(d.index) }
                    }
                }
            }
        }
    }

    // ── shalert shelf (D100): beside the spine only ──
    group {
        move: 0, clamp(isl_sy - 26, st_res + 6, screen.height - (152) - 20)
        group {
            show: rv.shalert > 0.03
            move: screen.width - 56 - 300, 0
            IslandFrame(rv.shalert, 300, 152) {
                zone box keep_shalert { from: 0, 0; size: 300, 152; role: region; agent: hidden }
                IsleHead(300, "Notifications", pick(dnd_now, "", "quiet"))
                text "{note_count, 0}" { at: 16, 66; anchor: left center; size: 30; weight: 600; family: "Exo 2"; color: if(note_count > 0, if(isl_style > 0.5, accent.primary, fl.phos), if(isl_style > 0.5, fg.muted, fl.muted)) }
                text pick(note_count == 1, "notifications waiting", "notification waiting") { at: 16, 90; anchor: left center; size: 11; family: "Exo 2"; color: if(isl_style > 0.5, fg.secondary, fl.muted) }
                zone box sad { from: 184, 52; size: 100, 24; cursor: pointer; role: toggle; checked: dnd_now; label: "Do not disturb" }
                group { show: dnd_now
                        IsleBtn(184, 52, 100, "Quiet on", 1, sad.hover) }
                group { show: not dnd_now
                        IsleBtn(184, 52, 100, "Quiet off", 0, sad.hover) }
                on press sad { emit note_dnd }
                IsleRule(300, 108)
                zone box sao { from: 16, 118; size: 130, 24; cursor: pointer; role: button; label: "Open the Signal Field" }
                IsleBtn(16, 118, 130, "Open all", 0, sao.hover)
                on press sao { open = none; side = notes; mark_open = false }
                zone box sac { from: 154, 118; size: 130, 24; cursor: pointer; role: button; label: "Clear every notification" }
                IsleBtn(154, 118, 130, "Clear all", 0, sac.hover)
                on press sac { emit note_clear }
            }
        }
    }

    // ── shupd shelf (D100): beside the spine only ──
    group {
        move: 0, clamp(isl_sy - 26, st_res + 6, screen.height - (114) - 20)
        group {
            show: rv.shupd > 0.03
            move: screen.width - 56 - 300, 0
            IslandFrame(rv.shupd, 300, 114) {
                zone box keep_shupd { from: 0, 0; size: 300, 114; role: region; agent: hidden }
                IsleHead(300, "System updates", pick(upd_n > 0, "up to date", "{upd_n, 0} waiting"))
                text upd_t { at: 16, 52; anchor: left center; size: 12; family: "Exo 2"; color: if(upd_n > 0, if(isl_style > 0.5, fg.primary, fl.engrave), if(isl_style > 0.5, fg.secondary, fl.muted)); width: 268; lines: 2 }
                group { show: upd_n > 0
                        zone box suu { from: 16, 76; size: 268, 26; cursor: pointer; role: button; label: "Run the updater" }
                        IsleBtn(16, 76, 268, "Update now", 1, suu.hover, 26)
                        on press suu { open = none; emit run_updates } }
            }
        }
    }

    // ── The spine (D100): tabs down the right edge; hover one and its shelf slides out beside it ──
    // A press pins the shelf; the pointer resting on the desktop for a moment puts it away. The
    // shelves are the islands (and three of their own), drawn beside the spine instead of under the bar.
    // Autohide (shelves.autohide): the tabs slide off the edge; touching the edge brings them back, and
    // they go again once the pointer has been off them (and no shelf is out) for 700 ms. While hidden a
    // hairline keeps their place, warm when notifications or updates are waiting.
    group {
        show: shelves_on and shelves_hide
        let spe0 = (screen.height - 320) / 2
        zone box sp_edge { from: screen.width - 3, spe0 - 40; size: 3, 400; role: region; label: "The spine (hidden): touch the edge"; active: sp_in < 0.5 }
        zone box sp_body { from: screen.width - 46, spe0 - 26; size: 46, 372; role: region; label: "The spine"; active: sp_in > 0.5 }
        on hover sp_edge for 60ms { sp_reveal = true }
        on still max(max(sp_body.hover, sp_edge.hover), if(isl_shelf and open != none, 1, 0)) for 700ms while sp_reveal and max(max(sp_body.hover, sp_edge.hover), if(isl_shelf and open != none, 1, 0)) < 0.5 { sp_reveal = false }
        group {
            opacity: 1 - sp_in
            glow: 6, (0.4 + 0.5 * if(note_count > 0 or upd_n > 0, 1, 0)) * st_glow, if(note_count > 0 or upd_n > 0, fl.ember, if(isl_style > 0.5, accent.primary, fl.phos))
            line { from: screen.width - 1.5, spe0 - 10; to: screen.width - 1.5, spe0 + 330; width: 2
                   color: if(note_count > 0 or upd_n > 0, fl.ember, if(isl_style > 0.5, accent.primary, fl.phos)); opacity: 0.7 }
        }
    }
    group {
        show: shelves_on
        move: screen.width - 46 + (1 - sp_in) * 60, 0
        opacity: smooth(0, 0.6, sp_in)
        let sp0 = (screen.height - 320) / 2
        box { from: 4, sp0 - 26; size: 38, 372; corner: 19; color: if(isl_style > 0.5, bg.primary, fl.hull); opacity: 0.55 }
        box { from: 4, sp0 - 26; size: 38, 372; corner: 19; stroke: 1; color: if(isl_style > 0.5, border.subtle, fl.trace_dim); opacity: 0.7 }
        line { from: 23, sp0 - 14; to: 23, sp0 + 320 + 14; width: 1; color: if(isl_style > 0.5, accent.primary, fl.phos); opacity: 0.22 }
        // the open shelf's link to its tab: a short trace, a via at the shelf's edge
        group {
            show: isl_shelf and open != none
            glow: 6, (0.7) * st_glow, if(isl_style > 0.5, accent.primary, fl.phos)
            line { from: -10, isl_sy; to: 7, isl_sy; width: 1.6; color: if(isl_style > 0.5, accent.primary, fl.phos) }
            ellipse { at: -10, isl_sy; radius: 3; color: if(isl_style > 0.5, accent.primary, fl.phos) }
        }
                // Connections
                zone box sp0 { from: 6, sp0 + 0 - 17; size: 34, 34; cursor: pointer; role: toggle; checked: (open == shnet and isl_shelf); label: "Connections" }
                group {
                    glow: 7, (if((open == shnet and isl_shelf), 0.8, 0)) * st_glow, if(isl_style > 0.5, accent.primary, fl.phos)
                    path { color: if((open == shnet and isl_shelf), if(isl_style > 0.5, accent.primary, fl.phos), mix(if(isl_style > 0.5, bg.primary, fl.hull), if(isl_style > 0.5, accent.primary, fl.phos), 0.1 + 0.25 * sp0.hover))
                           move 39, sp0 + 0; line 31, sp0 + 0 + 14; line 15, sp0 + 0 + 14; line 7, sp0 + 0; line 15, sp0 + 0 - 14; line 31, sp0 + 0 - 14; close }
                }
                path { stroke: 1.2; color: if((open == shnet and isl_shelf), if(isl_style > 0.5, accent.primary, fl.phos), mix(if(isl_style > 0.5, fg.muted, fl.muted), if(isl_style > 0.5, accent.primary, fl.phos), sp0.hover)); opacity: 0.9
                       move 39, sp0 + 0; line 31, sp0 + 0 + 14; line 15, sp0 + 0 + 14; line 7, sp0 + 0; line 15, sp0 + 0 - 14; line 31, sp0 + 0 - 14; close }
                figure i_wifi { at: 23, sp0 + 0; size: 15, 15; color: if((open == shnet and isl_shelf), if(isl_style > 0.5, bg.primary, fl.hull), mix(if(isl_style > 0.5, fg.primary, fl.engrave), if(isl_style > 0.5, accent.primary, fl.phos), sp0.hover)) }
                on hover sp0 for 140ms while not (open == shnet and isl_shelf) { isl_sy = sp0 + 0; isl_shelf = true; shelf_pin = false; open = shnet; side = none; mark_open = false }
                on press sp0 while (open == shnet and isl_shelf) { shelf_pin = not shelf_pin }
                // it goes home once the pointer has been over neither the tab nor its shelf for half a second (unless pinned)
                on still max(sp0.hover, keep_shnet.hover) for 500ms while open == shnet and isl_shelf and not shelf_pin and max(sp0.hover, keep_shnet.hover) < 0.5 { open = none }
                on press sp0 while not (open == shnet and isl_shelf) { isl_sy = sp0 + 0; isl_shelf = true; shelf_pin = true; open = shnet; side = none; mark_open = false }
                // Sound
                zone box sp1 { from: 6, sp0 + 40 - 17; size: 34, 34; cursor: pointer; role: toggle; checked: (open == sound and isl_shelf); label: "Sound" }
                group {
                    glow: 7, (if((open == sound and isl_shelf), 0.8, 0)) * st_glow, if(isl_style > 0.5, accent.primary, fl.phos)
                    path { color: if((open == sound and isl_shelf), if(isl_style > 0.5, accent.primary, fl.phos), mix(if(isl_style > 0.5, bg.primary, fl.hull), if(isl_style > 0.5, accent.primary, fl.phos), 0.1 + 0.25 * sp1.hover))
                           move 39, sp0 + 40; line 31, sp0 + 40 + 14; line 15, sp0 + 40 + 14; line 7, sp0 + 40; line 15, sp0 + 40 - 14; line 31, sp0 + 40 - 14; close }
                }
                path { stroke: 1.2; color: if((open == sound and isl_shelf), if(isl_style > 0.5, accent.primary, fl.phos), mix(if(isl_style > 0.5, fg.muted, fl.muted), if(isl_style > 0.5, accent.primary, fl.phos), sp1.hover)); opacity: 0.9
                       move 39, sp0 + 40; line 31, sp0 + 40 + 14; line 15, sp0 + 40 + 14; line 7, sp0 + 40; line 15, sp0 + 40 - 14; line 31, sp0 + 40 - 14; close }
                figure i_volume { at: 23, sp0 + 40; size: 15, 15; color: if((open == sound and isl_shelf), if(isl_style > 0.5, bg.primary, fl.hull), mix(if(isl_style > 0.5, fg.primary, fl.engrave), if(isl_style > 0.5, accent.primary, fl.phos), sp1.hover)) }
                on hover sp1 for 140ms while not (open == sound and isl_shelf) { isl_sy = sp0 + 40; isl_shelf = true; shelf_pin = false; open = sound; side = none; mark_open = false }
                on press sp1 while (open == sound and isl_shelf) { shelf_pin = not shelf_pin }
                // it goes home once the pointer has been over neither the tab nor its shelf for half a second (unless pinned)
                on still max(sp1.hover, keep_sound.hover) for 500ms while open == sound and isl_shelf and not shelf_pin and max(sp1.hover, keep_sound.hover) < 0.5 { open = none }
                on press sp1 while not (open == sound and isl_shelf) { isl_sy = sp0 + 40; isl_shelf = true; shelf_pin = true; open = sound; side = none; mark_open = false }
                // Display
                zone box sp2 { from: 6, sp0 + 80 - 17; size: 34, 34; cursor: pointer; role: toggle; checked: (open == display and isl_shelf); label: "Display" }
                group {
                    glow: 7, (if((open == display and isl_shelf), 0.8, 0)) * st_glow, if(isl_style > 0.5, accent.primary, fl.phos)
                    path { color: if((open == display and isl_shelf), if(isl_style > 0.5, accent.primary, fl.phos), mix(if(isl_style > 0.5, bg.primary, fl.hull), if(isl_style > 0.5, accent.primary, fl.phos), 0.1 + 0.25 * sp2.hover))
                           move 39, sp0 + 80; line 31, sp0 + 80 + 14; line 15, sp0 + 80 + 14; line 7, sp0 + 80; line 15, sp0 + 80 - 14; line 31, sp0 + 80 - 14; close }
                }
                path { stroke: 1.2; color: if((open == display and isl_shelf), if(isl_style > 0.5, accent.primary, fl.phos), mix(if(isl_style > 0.5, fg.muted, fl.muted), if(isl_style > 0.5, accent.primary, fl.phos), sp2.hover)); opacity: 0.9
                       move 39, sp0 + 80; line 31, sp0 + 80 + 14; line 15, sp0 + 80 + 14; line 7, sp0 + 80; line 15, sp0 + 80 - 14; line 31, sp0 + 80 - 14; close }
                figure i_sun { at: 23, sp0 + 80; size: 15, 15; color: if((open == display and isl_shelf), if(isl_style > 0.5, bg.primary, fl.hull), mix(if(isl_style > 0.5, fg.primary, fl.engrave), if(isl_style > 0.5, accent.primary, fl.phos), sp2.hover)) }
                on hover sp2 for 140ms while not (open == display and isl_shelf) { isl_sy = sp0 + 80; isl_shelf = true; shelf_pin = false; open = display; side = none; mark_open = false }
                on press sp2 while (open == display and isl_shelf) { shelf_pin = not shelf_pin }
                // it goes home once the pointer has been over neither the tab nor its shelf for half a second (unless pinned)
                on still max(sp2.hover, keep_display.hover) for 500ms while open == display and isl_shelf and not shelf_pin and max(sp2.hover, keep_display.hover) < 0.5 { open = none }
                on press sp2 while not (open == display and isl_shelf) { isl_sy = sp0 + 80; isl_shelf = true; shelf_pin = true; open = display; side = none; mark_open = false }
                // Power
                zone box sp3 { from: 6, sp0 + 120 - 17; size: 34, 34; cursor: pointer; role: toggle; checked: (open == power and isl_shelf); label: "Power" }
                group {
                    glow: 7, (if((open == power and isl_shelf), 0.8, 0)) * st_glow, if(isl_style > 0.5, accent.primary, fl.phos)
                    path { color: if((open == power and isl_shelf), if(isl_style > 0.5, accent.primary, fl.phos), mix(if(isl_style > 0.5, bg.primary, fl.hull), if(isl_style > 0.5, accent.primary, fl.phos), 0.1 + 0.25 * sp3.hover))
                           move 39, sp0 + 120; line 31, sp0 + 120 + 14; line 15, sp0 + 120 + 14; line 7, sp0 + 120; line 15, sp0 + 120 - 14; line 31, sp0 + 120 - 14; close }
                }
                path { stroke: 1.2; color: if((open == power and isl_shelf), if(isl_style > 0.5, accent.primary, fl.phos), mix(if(isl_style > 0.5, fg.muted, fl.muted), if(isl_style > 0.5, accent.primary, fl.phos), sp3.hover)); opacity: 0.9
                       move 39, sp0 + 120; line 31, sp0 + 120 + 14; line 15, sp0 + 120 + 14; line 7, sp0 + 120; line 15, sp0 + 120 - 14; line 31, sp0 + 120 - 14; close }
                figure i_battery { at: 23, sp0 + 120; size: 15, 15; color: if((open == power and isl_shelf), if(isl_style > 0.5, bg.primary, fl.hull), mix(if(isl_style > 0.5, fg.primary, fl.engrave), if(isl_style > 0.5, accent.primary, fl.phos), sp3.hover)) }
                on hover sp3 for 140ms while not (open == power and isl_shelf) { isl_sy = sp0 + 120; isl_shelf = true; shelf_pin = false; open = power; side = none; mark_open = false }
                on press sp3 while (open == power and isl_shelf) { shelf_pin = not shelf_pin }
                // it goes home once the pointer has been over neither the tab nor its shelf for half a second (unless pinned)
                on still max(sp3.hover, keep_power.hover) for 500ms while open == power and isl_shelf and not shelf_pin and max(sp3.hover, keep_power.hover) < 0.5 { open = none }
                on press sp3 while not (open == power and isl_shelf) { isl_sy = sp0 + 120; isl_shelf = true; shelf_pin = true; open = power; side = none; mark_open = false }
                // Machine
                zone box sp4 { from: 6, sp0 + 160 - 17; size: 34, 34; cursor: pointer; role: toggle; checked: (open == stats and isl_shelf); label: "Machine" }
                group {
                    glow: 7, (if((open == stats and isl_shelf), 0.8, 0)) * st_glow, if(isl_style > 0.5, accent.primary, fl.phos)
                    path { color: if((open == stats and isl_shelf), if(isl_style > 0.5, accent.primary, fl.phos), mix(if(isl_style > 0.5, bg.primary, fl.hull), if(isl_style > 0.5, accent.primary, fl.phos), 0.1 + 0.25 * sp4.hover))
                           move 39, sp0 + 160; line 31, sp0 + 160 + 14; line 15, sp0 + 160 + 14; line 7, sp0 + 160; line 15, sp0 + 160 - 14; line 31, sp0 + 160 - 14; close }
                }
                path { stroke: 1.2; color: if((open == stats and isl_shelf), if(isl_style > 0.5, accent.primary, fl.phos), mix(if(isl_style > 0.5, fg.muted, fl.muted), if(isl_style > 0.5, accent.primary, fl.phos), sp4.hover)); opacity: 0.9
                       move 39, sp0 + 160; line 31, sp0 + 160 + 14; line 15, sp0 + 160 + 14; line 7, sp0 + 160; line 15, sp0 + 160 - 14; line 31, sp0 + 160 - 14; close }
                figure i_cpu { at: 23, sp0 + 160; size: 15, 15; color: if((open == stats and isl_shelf), if(isl_style > 0.5, bg.primary, fl.hull), mix(if(isl_style > 0.5, fg.primary, fl.engrave), if(isl_style > 0.5, accent.primary, fl.phos), sp4.hover)) }
                on hover sp4 for 140ms while not (open == stats and isl_shelf) { isl_sy = sp0 + 160; isl_shelf = true; shelf_pin = false; open = stats; side = none; mark_open = false }
                on press sp4 while (open == stats and isl_shelf) { shelf_pin = not shelf_pin }
                // it goes home once the pointer has been over neither the tab nor its shelf for half a second (unless pinned)
                on still max(sp4.hover, keep_stats.hover) for 500ms while open == stats and isl_shelf and not shelf_pin and max(sp4.hover, keep_stats.hover) < 0.5 { open = none }
                on press sp4 while not (open == stats and isl_shelf) { isl_sy = sp0 + 160; isl_shelf = true; shelf_pin = true; open = stats; side = none; mark_open = false }
                // Calendar
                zone box sp5 { from: 6, sp0 + 200 - 17; size: 34, 34; cursor: pointer; role: toggle; checked: (open == calendar and isl_shelf); label: "Calendar" }
                group {
                    glow: 7, (if((open == calendar and isl_shelf), 0.8, 0)) * st_glow, if(isl_style > 0.5, accent.primary, fl.phos)
                    path { color: if((open == calendar and isl_shelf), if(isl_style > 0.5, accent.primary, fl.phos), mix(if(isl_style > 0.5, bg.primary, fl.hull), if(isl_style > 0.5, accent.primary, fl.phos), 0.1 + 0.25 * sp5.hover))
                           move 39, sp0 + 200; line 31, sp0 + 200 + 14; line 15, sp0 + 200 + 14; line 7, sp0 + 200; line 15, sp0 + 200 - 14; line 31, sp0 + 200 - 14; close }
                }
                path { stroke: 1.2; color: if((open == calendar and isl_shelf), if(isl_style > 0.5, accent.primary, fl.phos), mix(if(isl_style > 0.5, fg.muted, fl.muted), if(isl_style > 0.5, accent.primary, fl.phos), sp5.hover)); opacity: 0.9
                       move 39, sp0 + 200; line 31, sp0 + 200 + 14; line 15, sp0 + 200 + 14; line 7, sp0 + 200; line 15, sp0 + 200 - 14; line 31, sp0 + 200 - 14; close }
                figure i_calendar { at: 23, sp0 + 200; size: 15, 15; color: if((open == calendar and isl_shelf), if(isl_style > 0.5, bg.primary, fl.hull), mix(if(isl_style > 0.5, fg.primary, fl.engrave), if(isl_style > 0.5, accent.primary, fl.phos), sp5.hover)) }
                on hover sp5 for 140ms while not (open == calendar and isl_shelf) { isl_sy = sp0 + 200; isl_shelf = true; shelf_pin = false; open = calendar; side = none; mark_open = false }
                on press sp5 while (open == calendar and isl_shelf) { shelf_pin = not shelf_pin }
                // it goes home once the pointer has been over neither the tab nor its shelf for half a second (unless pinned)
                on still max(sp5.hover, keep_calendar.hover) for 500ms while open == calendar and isl_shelf and not shelf_pin and max(sp5.hover, keep_calendar.hover) < 0.5 { open = none }
                on press sp5 while not (open == calendar and isl_shelf) { isl_sy = sp0 + 200; isl_shelf = true; shelf_pin = true; open = calendar; side = none; mark_open = false }
                // Weather
                zone box sp6 { from: 6, sp0 + 240 - 17; size: 34, 34; cursor: pointer; role: toggle; checked: (open == weather and isl_shelf); label: "Weather" }
                group {
                    glow: 7, (if((open == weather and isl_shelf), 0.8, 0)) * st_glow, if(isl_style > 0.5, accent.primary, fl.phos)
                    path { color: if((open == weather and isl_shelf), if(isl_style > 0.5, accent.primary, fl.phos), mix(if(isl_style > 0.5, bg.primary, fl.hull), if(isl_style > 0.5, accent.primary, fl.phos), 0.1 + 0.25 * sp6.hover))
                           move 39, sp0 + 240; line 31, sp0 + 240 + 14; line 15, sp0 + 240 + 14; line 7, sp0 + 240; line 15, sp0 + 240 - 14; line 31, sp0 + 240 - 14; close }
                }
                path { stroke: 1.2; color: if((open == weather and isl_shelf), if(isl_style > 0.5, accent.primary, fl.phos), mix(if(isl_style > 0.5, fg.muted, fl.muted), if(isl_style > 0.5, accent.primary, fl.phos), sp6.hover)); opacity: 0.9
                       move 39, sp0 + 240; line 31, sp0 + 240 + 14; line 15, sp0 + 240 + 14; line 7, sp0 + 240; line 15, sp0 + 240 - 14; line 31, sp0 + 240 - 14; close }
                figure i_cloud { at: 23, sp0 + 240; size: 15, 15; color: if((open == weather and isl_shelf), if(isl_style > 0.5, bg.primary, fl.hull), mix(if(isl_style > 0.5, fg.primary, fl.engrave), if(isl_style > 0.5, accent.primary, fl.phos), sp6.hover)) }
                on hover sp6 for 140ms while not (open == weather and isl_shelf) { isl_sy = sp0 + 240; isl_shelf = true; shelf_pin = false; open = weather; side = none; mark_open = false }
                on press sp6 while (open == weather and isl_shelf) { shelf_pin = not shelf_pin }
                // it goes home once the pointer has been over neither the tab nor its shelf for half a second (unless pinned)
                on still max(sp6.hover, keep_weather.hover) for 500ms while open == weather and isl_shelf and not shelf_pin and max(sp6.hover, keep_weather.hover) < 0.5 { open = none }
                on press sp6 while not (open == weather and isl_shelf) { isl_sy = sp0 + 240; isl_shelf = true; shelf_pin = true; open = weather; side = none; mark_open = false }
                // Notifications
                zone box sp7 { from: 6, sp0 + 280 - 17; size: 34, 34; cursor: pointer; role: toggle; checked: (open == shalert and isl_shelf); label: "Notifications" }
                group {
                    glow: 7, (if((open == shalert and isl_shelf), 0.8, 0)) * st_glow, if(isl_style > 0.5, accent.primary, fl.phos)
                    path { color: if((open == shalert and isl_shelf), if(isl_style > 0.5, accent.primary, fl.phos), mix(if(isl_style > 0.5, bg.primary, fl.hull), if(isl_style > 0.5, accent.primary, fl.phos), 0.1 + 0.25 * sp7.hover))
                           move 39, sp0 + 280; line 31, sp0 + 280 + 14; line 15, sp0 + 280 + 14; line 7, sp0 + 280; line 15, sp0 + 280 - 14; line 31, sp0 + 280 - 14; close }
                }
                path { stroke: 1.2; color: if((open == shalert and isl_shelf), if(isl_style > 0.5, accent.primary, fl.phos), mix(if(isl_style > 0.5, fg.muted, fl.muted), if(isl_style > 0.5, accent.primary, fl.phos), sp7.hover)); opacity: 0.9
                       move 39, sp0 + 280; line 31, sp0 + 280 + 14; line 15, sp0 + 280 + 14; line 7, sp0 + 280; line 15, sp0 + 280 - 14; line 31, sp0 + 280 - 14; close }
                figure i_bell { at: 23, sp0 + 280; size: 15, 15; color: if((open == shalert and isl_shelf), if(isl_style > 0.5, bg.primary, fl.hull), mix(if(isl_style > 0.5, fg.primary, fl.engrave), if(isl_style > 0.5, accent.primary, fl.phos), sp7.hover)) }
                group { show: note_count > 0
                        ellipse { at: 14, sp0 + 280 - 12; radius: 7; color: fl.ember }
                        text "{min(note_count, 9), 0}" { at: 14, sp0 + 280 - 12; anchor: center; align: center; size: 10; weight: 700; family: "Exo 2"; color: fl.ink } }
                on hover sp7 for 140ms while not (open == shalert and isl_shelf) { isl_sy = sp0 + 280; isl_shelf = true; shelf_pin = false; open = shalert; side = none; mark_open = false }
                on press sp7 while (open == shalert and isl_shelf) { shelf_pin = not shelf_pin }
                // it goes home once the pointer has been over neither the tab nor its shelf for half a second (unless pinned)
                on still max(sp7.hover, keep_shalert.hover) for 500ms while open == shalert and isl_shelf and not shelf_pin and max(sp7.hover, keep_shalert.hover) < 0.5 { open = none }
                on press sp7 while not (open == shalert and isl_shelf) { isl_sy = sp0 + 280; isl_shelf = true; shelf_pin = true; open = shalert; side = none; mark_open = false }
                // Updates
                zone box sp8 { from: 6, sp0 + 320 - 17; size: 34, 34; cursor: pointer; role: toggle; checked: (open == shupd and isl_shelf); label: "Updates" }
                group {
                    glow: 7, (if((open == shupd and isl_shelf), 0.8, 0)) * st_glow, if(isl_style > 0.5, accent.primary, fl.phos)
                    path { color: if((open == shupd and isl_shelf), if(isl_style > 0.5, accent.primary, fl.phos), mix(if(isl_style > 0.5, bg.primary, fl.hull), if(isl_style > 0.5, accent.primary, fl.phos), 0.1 + 0.25 * sp8.hover))
                           move 39, sp0 + 320; line 31, sp0 + 320 + 14; line 15, sp0 + 320 + 14; line 7, sp0 + 320; line 15, sp0 + 320 - 14; line 31, sp0 + 320 - 14; close }
                }
                path { stroke: 1.2; color: if((open == shupd and isl_shelf), if(isl_style > 0.5, accent.primary, fl.phos), mix(if(isl_style > 0.5, fg.muted, fl.muted), if(isl_style > 0.5, accent.primary, fl.phos), sp8.hover)); opacity: 0.9
                       move 39, sp0 + 320; line 31, sp0 + 320 + 14; line 15, sp0 + 320 + 14; line 7, sp0 + 320; line 15, sp0 + 320 - 14; line 31, sp0 + 320 - 14; close }
                figure i_updates { at: 23, sp0 + 320; size: 15, 15; color: if((open == shupd and isl_shelf), if(isl_style > 0.5, bg.primary, fl.hull), mix(if(isl_style > 0.5, fg.primary, fl.engrave), if(isl_style > 0.5, accent.primary, fl.phos), sp8.hover)) }
                group { show: upd_n > 0
                        ellipse { at: 14, sp0 + 320 - 12; radius: 7; color: fl.ember }
                        text "{min(upd_n, 99), 0}" { at: 14, sp0 + 320 - 12; anchor: center; align: center; size: 10; weight: 700; family: "Exo 2"; color: fl.ink } }
                on hover sp8 for 140ms while not (open == shupd and isl_shelf) { isl_sy = sp0 + 320; isl_shelf = true; shelf_pin = false; open = shupd; side = none; mark_open = false }
                on press sp8 while (open == shupd and isl_shelf) { shelf_pin = not shelf_pin }
                // it goes home once the pointer has been over neither the tab nor its shelf for half a second (unless pinned)
                on still max(sp8.hover, keep_shupd.hover) for 500ms while open == shupd and isl_shelf and not shelf_pin and max(sp8.hover, keep_shupd.hover) < 0.5 { open = none }
                on press sp8 while not (open == shupd and isl_shelf) { isl_sy = sp0 + 320; isl_shelf = true; shelf_pin = true; open = shupd; side = none; mark_open = false }
    }

    // ── command_island (drawn in the bar's own surface, under the bar's strip: D53) ──
    group {
        move: 0, st_res + 6

        // Under the module that opens it (D53): a strip as wide as the screen whose panel sits
        // under the module's middle, kept on the screen; the strip's empty parts let presses through.
        let cm_ox = clamp((if(p_core, xs_core + ws_core / 2, screen.width / 2)) - 300, 8, screen.width - 608)
        // nothing drawn for its last frames open, so the picture a closed full-screen surface keeps is empty
        group {
            show: rv.command > 0.03
            move: cm_ox, 0

            prop ch = 60 ~m.reflow
            follow ch = 60 + if(res.count > 0, rlist.height + 10, 36) + 30
            group {
                move: 10, 0
                IslandFrame(rv.command, 580, ch, centre: true, aw: 140) {
                    ellipse { at: 25, 29; radius: 6; stroke: 1.5; color: fg.secondary }
                    line { from: 29.5, 33.5; to: 34, 38; width: 1.5; color: fg.secondary }
                    input query { at: 46, 30; width: 510; size: 16; color: fg.primary; selection: selection.bg
                                  placeholder: "Search apps, windows, workspaces   @ windows   > mooi" }
                    box { from: 12, 58; size: 556, 1; color: border.subtle }

                    text cempty { at: 20, 78; anchor: left center; size: 12; color: fg.muted; show: res.count == 0 }
                    column rlist ~m.reflow {
                        at: 10, 66
                        gap: 2
                        for r in res { CRow(r) }
                    }

                    let foot = ch - 16
                    text pick(cmode == actions, "←→ choose   ↵ apply   esc back", "↑↓ select   ↵ open   tab window actions   esc close") {
                        at: 20, foot; anchor: left center; size: 10.5; color: if(carming, accent.secondary, fg.muted); opacity: 1 - fb }
                    text feedback { at: 20, foot; anchor: left center; size: 10; width: 540; lines: 1
                                    color: if(note.failed, status.error, status.ok); opacity: fb }
                }
            }
        }
    }

    // ══ The side panel: notices, the clipboard, a toast ═══════
    // Under the bar at the right. Notices: what is waiting, newest first, each dismissable,
    // and all of them at once. The clipboard: the last fourteen text entries; one pressed is
    // copied. A toast: a new notice, for five seconds, while the panel is closed.
    // The screen frame, on a surface of its own under the windows (which never cover it: it
    // lies in their outer gap). Its body spans the whole screen, and repainting it with every
    // change of the bar halved the frame rate (32 % of frames late); alone, it repaints only
    // when it moves — the music's swell. The bar's strip above it is the same colour, so the
    // two still read as one piece. `reserve: -1`: it neither reserves room nor is moved out of
    // the strip the bar reserves.
    surface frame_surface {
        size: full, full
        anchor: top
        level: bottom
        reserve: -1
        open: frame_on

        // Still (no music, or a quiet moment): the same band from plain shapes — the four
        // bands, the fillets of the inner corners as curves, the inner edge as one stroked
        // rounded box. A body costs ~16 ms a paint over the whole screen and the surface is
        // painted with every cycle of the scene; these cost next to nothing. The body below
        // takes over only while the swell moves.
        let fstill = flvl < 0.02 and fhi < 0.02
        let fr = st_frame_r                                 // the inner corners (frame.radius)
        // Glass behind the band, even the strip alone, costs a third of the frames on this
        // surface; the bands are a few pixels wide, where refraction cannot be seen. With a
        // glass or frosted bar they take its translucency instead (the bar keeps its glass).
        let fthin = if(bar_surface > 0.5 and bar_surface < 3.5, 0.72, 1)
        group {
            show: frame_on and fstill
            opacity: if(bar_ground > 1.5 and not mech, 0.86, 1) * st_frame_op
            box { from: 0, 0; size: W, st_res; color: fcol; opacity: fthin }
            box { from: 0, H - bt; size: W, bt; color: fcol; opacity: fthin }
            box { from: 0, st_res; size: bs, H - st_res - bt; color: fcol; opacity: fthin }
            box { from: W - bs, st_res; size: bs, H - st_res - bt; color: fcol; opacity: fthin }
            path { color: fcol; opacity: fthin; move bs, st_res; line bs + fr, st_res; curve bs, st_res + fr via bs, st_res; close }
            path { color: fcol; opacity: fthin; move W - bs, st_res; line W - bs, st_res + fr; curve W - bs - fr, st_res via W - bs, st_res; close }
            path { color: fcol; opacity: fthin; move bs, H - bt; line bs, H - bt - fr; curve bs + fr, H - bt via bs, H - bt; close }
            path { color: fcol; opacity: fthin; move W - bs, H - bt; line W - bs - fr, H - bt; curve W - bs, H - bt - fr via W - bs, H - bt; close }
        }
        // The inner edge, over the band (still or swelling): a quiet line, or a neon one that glows.
        group {
            show: frame_on and st_frame_edge < 1.5
            glow: 8, (if(st_frame_edge > 0.5, 0.9, 0)) * st_glow, fl.phos
            box { from: bs, st_res; size: W - 2 * bs, H - st_res - bt; corner: fr; stroke: if(st_frame_edge > 0.5, 1.6, 1)
                  color: if(st_frame_edge > 0.5, fl.phos, if(mech, fl.steel_500, fl.trace_dim)); opacity: st_frame_op }
        }
        group {
            show: frame_on and not fstill
            body {
                color: fcol
                opacity: if(bar_ground > 1.5 and not mech, 0.86, 1) * fthin * st_frame_op   // tinted like the still band, never glass
                rim: 4% + 10% * fhi + 16% * fpl * flvl
                border: 1 + fpl * flvl * 4, mix(if(mech, fl.steel_500, fl.trace_dim), fl.phos, fpl * clamp(flvl * 0.9 + fhi * 0.7, 0, 1))
                box { from: 0, 0; size: W, st_res }
                box { from: 0, H - bt; size: W, bt }
                box { from: 0, 0; size: bs, H; blend: st_frame_r + 2 }
                box { from: W - bs, 0; size: bs, H; blend: st_frame_r + 2 }
                // <gen:lobes>
            ellipse { at: W * 0.0714, st_res; radius: (W / 7 * if(frame_style == 1, 0.28, 0.62)) * clamp(aflat / 4, 0, 1); scale: 1, max(0.5, aflat * if(frame_style == 1, 1.3, 0.8) * (0.5 + 0.5 * sin(0.00 * 57.3 - fphs * 126))) / max(0.5, W / 7 * if(frame_style == 1, 0.28, 0.62)); blend: 22 * clamp(aflat / 4, 0, 1); show: aflat > 0.5 and frame_style < 1.5 }
            ellipse { at: W * 0.0714, H - bt; radius: (W / 7 * if(frame_style == 1, 0.28, 0.62)) * clamp(aflat / 4, 0, 1); scale: 1, max(0.5, aflat * if(frame_style == 1, 1.3, 0.8) * (0.5 + 0.5 * sin(0.80 * 57.3 - fphs * 126))) / max(0.5, W / 7 * if(frame_style == 1, 0.28, 0.62)); blend: 22 * clamp(aflat / 4, 0, 1); show: aflat > 0.5 and frame_style < 1.5 }
            ellipse { at: W * 0.2143, st_res; radius: (W / 7 * if(frame_style == 1, 0.28, 0.62)) * clamp(aflat / 4, 0, 1); scale: 1, max(0.5, aflat * if(frame_style == 1, 1.3, 0.8) * (0.5 + 0.5 * sin(1.15 * 57.3 - fphs * 126))) / max(0.5, W / 7 * if(frame_style == 1, 0.28, 0.62)); blend: 22 * clamp(aflat / 4, 0, 1); show: aflat > 0.5 and frame_style < 1.5 }
            ellipse { at: W * 0.2143, H - bt; radius: (W / 7 * if(frame_style == 1, 0.28, 0.62)) * clamp(aflat / 4, 0, 1); scale: 1, max(0.5, aflat * if(frame_style == 1, 1.3, 0.8) * (0.5 + 0.5 * sin(1.95 * 57.3 - fphs * 126))) / max(0.5, W / 7 * if(frame_style == 1, 0.28, 0.62)); blend: 22 * clamp(aflat / 4, 0, 1); show: aflat > 0.5 and frame_style < 1.5 }
            ellipse { at: W * 0.3571, st_res; radius: (W / 7 * if(frame_style == 1, 0.28, 0.62)) * clamp(aflat / 4, 0, 1); scale: 1, max(0.5, aflat * if(frame_style == 1, 1.3, 0.8) * (0.5 + 0.5 * sin(2.30 * 57.3 - fphs * 126))) / max(0.5, W / 7 * if(frame_style == 1, 0.28, 0.62)); blend: 22 * clamp(aflat / 4, 0, 1); show: aflat > 0.5 and frame_style < 1.5 }
            ellipse { at: W * 0.3571, H - bt; radius: (W / 7 * if(frame_style == 1, 0.28, 0.62)) * clamp(aflat / 4, 0, 1); scale: 1, max(0.5, aflat * if(frame_style == 1, 1.3, 0.8) * (0.5 + 0.5 * sin(3.10 * 57.3 - fphs * 126))) / max(0.5, W / 7 * if(frame_style == 1, 0.28, 0.62)); blend: 22 * clamp(aflat / 4, 0, 1); show: aflat > 0.5 and frame_style < 1.5 }
            ellipse { at: W * 0.5000, st_res; radius: (W / 7 * if(frame_style == 1, 0.28, 0.62)) * clamp(aflat / 4, 0, 1); scale: 1, max(0.5, aflat * if(frame_style == 1, 1.3, 0.8) * (0.5 + 0.5 * sin(3.45 * 57.3 - fphs * 126))) / max(0.5, W / 7 * if(frame_style == 1, 0.28, 0.62)); blend: 22 * clamp(aflat / 4, 0, 1); show: aflat > 0.5 and frame_style < 1.5 }
            ellipse { at: W * 0.5000, H - bt; radius: (W / 7 * if(frame_style == 1, 0.28, 0.62)) * clamp(aflat / 4, 0, 1); scale: 1, max(0.5, aflat * if(frame_style == 1, 1.3, 0.8) * (0.5 + 0.5 * sin(4.25 * 57.3 - fphs * 126))) / max(0.5, W / 7 * if(frame_style == 1, 0.28, 0.62)); blend: 22 * clamp(aflat / 4, 0, 1); show: aflat > 0.5 and frame_style < 1.5 }
            ellipse { at: W * 0.6429, st_res; radius: (W / 7 * if(frame_style == 1, 0.28, 0.62)) * clamp(aflat / 4, 0, 1); scale: 1, max(0.5, aflat * if(frame_style == 1, 1.3, 0.8) * (0.5 + 0.5 * sin(4.60 * 57.3 - fphs * 126))) / max(0.5, W / 7 * if(frame_style == 1, 0.28, 0.62)); blend: 22 * clamp(aflat / 4, 0, 1); show: aflat > 0.5 and frame_style < 1.5 }
            ellipse { at: W * 0.6429, H - bt; radius: (W / 7 * if(frame_style == 1, 0.28, 0.62)) * clamp(aflat / 4, 0, 1); scale: 1, max(0.5, aflat * if(frame_style == 1, 1.3, 0.8) * (0.5 + 0.5 * sin(5.40 * 57.3 - fphs * 126))) / max(0.5, W / 7 * if(frame_style == 1, 0.28, 0.62)); blend: 22 * clamp(aflat / 4, 0, 1); show: aflat > 0.5 and frame_style < 1.5 }
            ellipse { at: W * 0.7857, st_res; radius: (W / 7 * if(frame_style == 1, 0.28, 0.62)) * clamp(aflat / 4, 0, 1); scale: 1, max(0.5, aflat * if(frame_style == 1, 1.3, 0.8) * (0.5 + 0.5 * sin(5.75 * 57.3 - fphs * 126))) / max(0.5, W / 7 * if(frame_style == 1, 0.28, 0.62)); blend: 22 * clamp(aflat / 4, 0, 1); show: aflat > 0.5 and frame_style < 1.5 }
            ellipse { at: W * 0.7857, H - bt; radius: (W / 7 * if(frame_style == 1, 0.28, 0.62)) * clamp(aflat / 4, 0, 1); scale: 1, max(0.5, aflat * if(frame_style == 1, 1.3, 0.8) * (0.5 + 0.5 * sin(6.55 * 57.3 - fphs * 126))) / max(0.5, W / 7 * if(frame_style == 1, 0.28, 0.62)); blend: 22 * clamp(aflat / 4, 0, 1); show: aflat > 0.5 and frame_style < 1.5 }
            ellipse { at: W * 0.9286, st_res; radius: (W / 7 * if(frame_style == 1, 0.28, 0.62)) * clamp(aflat / 4, 0, 1); scale: 1, max(0.5, aflat * if(frame_style == 1, 1.3, 0.8) * (0.5 + 0.5 * sin(6.90 * 57.3 - fphs * 126))) / max(0.5, W / 7 * if(frame_style == 1, 0.28, 0.62)); blend: 22 * clamp(aflat / 4, 0, 1); show: aflat > 0.5 and frame_style < 1.5 }
            ellipse { at: W * 0.9286, H - bt; radius: (W / 7 * if(frame_style == 1, 0.28, 0.62)) * clamp(aflat / 4, 0, 1); scale: 1, max(0.5, aflat * if(frame_style == 1, 1.3, 0.8) * (0.5 + 0.5 * sin(7.70 * 57.3 - fphs * 126))) / max(0.5, W / 7 * if(frame_style == 1, 0.28, 0.62)); blend: 22 * clamp(aflat / 4, 0, 1); show: aflat > 0.5 and frame_style < 1.5 }
            ellipse { at: bs, H * 0.1250; radius: (H / 4 * if(frame_style == 1, 0.28, 0.62)) * clamp(aside / 4, 0, 1); scale: max(0.5, aside * if(frame_style == 1, 1.3, 0.8) * (0.5 + 0.5 * sin(1.60 * 57.3 - fphs * 126))) / max(0.5, H / 4 * if(frame_style == 1, 0.28, 0.62)), 1; blend: 22 * clamp(aside / 4, 0, 1); show: aside > 0.5 and frame_style < 1.5 }
            ellipse { at: W - bs, H * 0.1250; radius: (H / 4 * if(frame_style == 1, 0.28, 0.62)) * clamp(aside / 4, 0, 1); scale: max(0.5, aside * if(frame_style == 1, 1.3, 0.8) * (0.5 + 0.5 * sin(2.40 * 57.3 - fphs * 126))) / max(0.5, H / 4 * if(frame_style == 1, 0.28, 0.62)), 1; blend: 22 * clamp(aside / 4, 0, 1); show: aside > 0.5 and frame_style < 1.5 }
            ellipse { at: bs, H * 0.3750; radius: (H / 4 * if(frame_style == 1, 0.28, 0.62)) * clamp(aside / 4, 0, 1); scale: max(0.5, aside * if(frame_style == 1, 1.3, 0.8) * (0.5 + 0.5 * sin(2.75 * 57.3 - fphs * 126))) / max(0.5, H / 4 * if(frame_style == 1, 0.28, 0.62)), 1; blend: 22 * clamp(aside / 4, 0, 1); show: aside > 0.5 and frame_style < 1.5 }
            ellipse { at: W - bs, H * 0.3750; radius: (H / 4 * if(frame_style == 1, 0.28, 0.62)) * clamp(aside / 4, 0, 1); scale: max(0.5, aside * if(frame_style == 1, 1.3, 0.8) * (0.5 + 0.5 * sin(3.55 * 57.3 - fphs * 126))) / max(0.5, H / 4 * if(frame_style == 1, 0.28, 0.62)), 1; blend: 22 * clamp(aside / 4, 0, 1); show: aside > 0.5 and frame_style < 1.5 }
            ellipse { at: bs, H * 0.6250; radius: (H / 4 * if(frame_style == 1, 0.28, 0.62)) * clamp(aside / 4, 0, 1); scale: max(0.5, aside * if(frame_style == 1, 1.3, 0.8) * (0.5 + 0.5 * sin(3.90 * 57.3 - fphs * 126))) / max(0.5, H / 4 * if(frame_style == 1, 0.28, 0.62)), 1; blend: 22 * clamp(aside / 4, 0, 1); show: aside > 0.5 and frame_style < 1.5 }
            ellipse { at: W - bs, H * 0.6250; radius: (H / 4 * if(frame_style == 1, 0.28, 0.62)) * clamp(aside / 4, 0, 1); scale: max(0.5, aside * if(frame_style == 1, 1.3, 0.8) * (0.5 + 0.5 * sin(4.70 * 57.3 - fphs * 126))) / max(0.5, H / 4 * if(frame_style == 1, 0.28, 0.62)), 1; blend: 22 * clamp(aside / 4, 0, 1); show: aside > 0.5 and frame_style < 1.5 }
            ellipse { at: bs, H * 0.8750; radius: (H / 4 * if(frame_style == 1, 0.28, 0.62)) * clamp(aside / 4, 0, 1); scale: max(0.5, aside * if(frame_style == 1, 1.3, 0.8) * (0.5 + 0.5 * sin(5.05 * 57.3 - fphs * 126))) / max(0.5, H / 4 * if(frame_style == 1, 0.28, 0.62)), 1; blend: 22 * clamp(aside / 4, 0, 1); show: aside > 0.5 and frame_style < 1.5 }
            ellipse { at: W - bs, H * 0.8750; radius: (H / 4 * if(frame_style == 1, 0.28, 0.62)) * clamp(aside / 4, 0, 1); scale: max(0.5, aside * if(frame_style == 1, 1.3, 0.8) * (0.5 + 0.5 * sin(5.85 * 57.3 - fphs * 126))) / max(0.5, H / 4 * if(frame_style == 1, 0.28, 0.62)), 1; blend: 22 * clamp(aside / 4, 0, 1); show: aside > 0.5 and frame_style < 1.5 }
                // </gen:lobes>
            }
        }
    }

    // The bar's strip, reserved: seven empty surfaces whose reserves are the bits of `st_res`,
    // stacked along the top edge, so the windows leave the bar exactly its strip and follow it
    // live as its thickness or its distance from the edge changes (D31). Nothing is drawn on them.
    surface reserve_1 {
        size: full, 1
        anchor: top
        level: bottom
        reserve: 1 while mod(floor(st_res / 1), 2) > 0.5
    }
    surface reserve_2 {
        size: full, 1
        anchor: top
        level: bottom
        reserve: 2 while mod(floor(st_res / 2), 2) > 0.5
    }
    surface reserve_4 {
        size: full, 1
        anchor: top
        level: bottom
        reserve: 4 while mod(floor(st_res / 4), 2) > 0.5
    }
    surface reserve_8 {
        size: full, 1
        anchor: top
        level: bottom
        reserve: 8 while mod(floor(st_res / 8), 2) > 0.5
    }
    surface reserve_16 {
        size: full, 1
        anchor: top
        level: bottom
        reserve: 16 while mod(floor(st_res / 16), 2) > 0.5
    }
    surface reserve_32 {
        size: full, 1
        anchor: top
        level: bottom
        reserve: 32 while mod(floor(st_res / 32), 2) > 0.5
    }
    surface reserve_64 {
        size: full, 1
        anchor: top
        level: bottom
        reserve: 64 while mod(floor(st_res / 64), 2) > 0.5
    }



    // ══ Signal Loom (D50) ═════════════════════════════════════
    // The signals: each unfolds from the origin edge (signals.edge) as a mechanism would — a
    // signal (the diamond) at the edge, an arm that reaches out (`lx`), a face that opens behind
    // it (`lu`), light running once along it — and folds back the same way when it goes. A
    // whisper is a slim line; a manifest shows who, what and (pointed at) what can be done; an
    // intervention stays, an ember rail along it and its buttons always there. Signals from one
    // app sit joined by a seam. The pointer on the cluster holds them; +N says how many wait.
    // Nothing here is drawn while nothing is out: the surface closes once the last has folded.
    surface loom_surface {
        size: 420, 720
        anchor: loom_anchor
        margin: 4, 10, 10, 10
        level: overlay
        open: (loom_count > 0 or loom_tail > 0.004) and side != notes    // the Field open, they arrive in it

        let lm_W = 420
        let lm_H = 720
        let lm_SEG = if(loom_comfy, 400, 320)        // signals.density: compact, narrower
        let lm_oxe = if(loom_left, 6, lm_W - 6)                  // the origin edge, where signals come from
        let lm_clx = if(loom_left, 0, lm_W - lm_SEG - 12)
        let lm_cly = if(loom_bottom, lm_H - loom_len - 40, 0)
        // the cluster as one zone: pointed at, nothing runs out
        zone box zcluster { from: lm_clx, lm_cly; size: lm_SEG + 12, loom_len + 40; show: loom_count > 0 }
        on enter zcluster { emit loom_hover(1) }
        on leave zcluster { emit loom_hover(0) }

        repeat i in 0..6 {
            prop lx.$i = 0 ~sg.ext
            prop lu.$i = 0 ~sg.unf
            prop ls.$i = 0 ~sg.sweep
            prop lp.$i = 0 ~sg.pulse
            prop la.$i = 0 ~m.select
            prop ly.$i = 0 ~fl.flow
            follow ly.$i = loom.$i.y
            on change loom.$i.out { ly.$i: loom.$i.y ~1ms }
            on change loom.$i.pulse { impulse lp.$i 9 }
            layer lm.$i {
                out while loom.$i.out { lx.$i: 1 ~sg.ext; lu.$i: 1 ~sg.unf after 110ms; ls.$i: 1 ~sg.sweep after 170ms }
                gone                  { lu.$i: 0 ~sg.ret; lx.$i: 0 ~sg.ret after 90ms; ls.$i: 0 ~1ms after 300ms }
            }
            let lt.$i = loom.$i.tier
            let lwh.$i = lt.$i < 0.5
            let lur.$i = lt.$i > 1.5
            let lh.$i = loom.$i.h
            let lyy.$i = if(loom_bottom, lm_H - 6 - ly.$i - lh.$i, 6 + ly.$i)
            let lsl.$i = (1 - lx.$i) * 36 * loom_travel
            let lw.$i = 30 + (lm_SEG - 30) * lx.$i
            let lx0.$i = if(loom_left, 6 - lsl.$i, lm_W - 6 - lw.$i + lsl.$i)
            let fx0.$i = if(loom_left, 6 - lsl.$i, lm_W - 6 - lm_SEG + lsl.$i)     // where the face sits, opened
            let cin.$i = if(loom_left, 34, 12)                                  // the face's text, clear of the diamond
            let ring.$i = clamp(lp.$i, 0, 1)
            let dcx.$i = if(loom_left, lx0.$i + 15, lx0.$i + lw.$i - 15)
            let dcy.$i = lyy.$i + min(lh.$i, 30) / 2
            group {
                show: lx.$i > 0.003
                opacity: min(1, lx.$i * 4)
                // joined to the signal before it: a seam along the origin edge
                line { from: lm_oxe, if(loom_bottom, lyy.$i + lh.$i, lyy.$i - 5); to: lm_oxe, if(loom_bottom, lyy.$i + lh.$i + 5, lyy.$i)
                       width: 2; color: fl.trace_lit; opacity: lu.$i; show: loom.$i.linked }
                group {
                    glow: 10, (if(lur.$i, 0.7, 0.35 * ring.$i)) * if(loom_fx, st_glow, 0), if(lur.$i, fl.ember, if(lwh.$i, fl.trace_lit, fl.phos))
                    Chamfer(lx0.$i, lyy.$i, lw.$i, lh.$i, loom_chamfer, fl.hull, mix(if(lur.$i, fl.ember, fl.trace), if(lur.$i, fl.ember, if(lwh.$i, fl.trace_lit, fl.phos)), max(ring.$i, 0.5 * la.$i)), 0.97, if(lur.$i, 1.6, 1))
                }
                // an intervention's rail: ember along its inner top edge
                box { from: lx0.$i + loom_chamfer, lyy.$i + 1; size: max(lw.$i - loom_chamfer - 2, 0), 2; color: fl.ember; show: lur.$i }
                // the signal: a diamond at the origin, lit by its tier
                path { color: if(lur.$i, fl.ember, if(lwh.$i, fl.trace_lit, fl.phos))
                       move dcx.$i, dcy.$i - 6; line dcx.$i + 6, dcy.$i; line dcx.$i, dcy.$i + 6; line dcx.$i - 6, dcy.$i; close }
                path { color: fl.hull
                       move dcx.$i, dcy.$i - 2.5; line dcx.$i + 2.5, dcy.$i; line dcx.$i, dcy.$i + 2.5; line dcx.$i - 2.5, dcy.$i; close }
                // light that runs once along a new signal, from the origin outward
                line { from: if(loom_left, lx0.$i + lw.$i * ls.$i, lx0.$i + lw.$i * (1 - ls.$i)), lyy.$i
                       to: if(loom_left, lx0.$i + lw.$i * ls.$i - 40, lx0.$i + lw.$i * (1 - ls.$i) + 40), lyy.$i
                       width: 2; color: if(lur.$i, fl.ember, if(lwh.$i, fl.trace_lit, fl.phos)); opacity: (1 - ls.$i) * lu.$i * if(loom_fx, 1, 0); show: ls.$i > 0.01 and ls.$i < 0.99 }
                // the face, at its opened place, seen through the arm as it opens
                group {
                    opacity: lu.$i
                    clip box { from: lx0.$i, lyy.$i; size: lw.$i, lh.$i }
                    let tx.$i = fx0.$i + cin.$i + if(loom.$i.pictured or loom.$i.iconed, 30, 0)
                    image loom.$i.image { at: fx0.$i + cin.$i, lyy.$i + 10; size: 24, 24; show: loom.$i.pictured and not lwh.$i }
                    image loom.$i.icon { at: fx0.$i + cin.$i + 1, lyy.$i + 11; size: 22, 22; show: loom.$i.iconed and not loom.$i.pictured and not lwh.$i }
                    // a whisper: who, and what, on one line
                    group {
                        show: lwh.$i
                        text pick(loom.$i.many > 1, "{loom.$i.app} · {loom.$i.title}", "{loom.$i.app} · {loom.$i.title} ×{loom.$i.many, 0}") { at: fx0.$i + cin.$i, lyy.$i + 15; anchor: left center; size: 11; family: "Exo 2"
                                                                width: lm_SEG - cin.$i - 60; lines: 1; color: fl.trace_lit }
                    }
                    group {
                        show: not lwh.$i
                        text pick(lur.$i, "{loom.$i.app}", "URGENT · {loom.$i.app}") { at: tx.$i, lyy.$i + 13; anchor: left center; size: 10; family: "Share Tech Mono"
                                                                                       width: 220; lines: 1; color: if(lur.$i, fl.ember, fl.trace_lit) }
                        text loom.$i.title { at: tx.$i, lyy.$i + 31; anchor: left center; size: 13; weight: 600; family: "Exo 2"
                                             width: lm_SEG - (tx.$i - fx0.$i) - 40; lines: 1; color: if(lur.$i, fl.flare, fl.phos) }
                        text loom.$i.body { at: tx.$i, lyy.$i + 42; anchor: left top; size: 11; family: "Exo 2"; width: lm_SEG - (tx.$i - fx0.$i) - 40
                                            lines: 1; color: fl.muted; opacity: 1 - la.$i; show: not (loom_comfy or lur.$i) }
                        text loom.$i.body { at: tx.$i, lyy.$i + 42; anchor: left top; size: 11; family: "Exo 2"; width: lm_SEG - (tx.$i - fx0.$i) - 40
                                            lines: 2; color: fl.muted; opacity: if(lur.$i, 1, 1 - la.$i); show: loom_comfy or lur.$i }
                    }
                    text loom.$i.when { at: if(loom_left, fx0.$i + lm_SEG - 30, fx0.$i + lm_SEG - 54), lyy.$i + 13; anchor: right center; size: 9; family: "Share Tech Mono"
                                        color: fl.muted; show: not lwh.$i }
                    // how many it stands for: a thread, or an app's notices
                    group {
                        show: loom.$i.many > 1 and not lwh.$i
                        Chamfer(if(loom_left, fx0.$i + lm_SEG - 74, fx0.$i + lm_SEG - 92), lyy.$i + 22, 34, 16, 4, fl.ground, mix(fl.trace, if(lur.$i, fl.ember, if(lwh.$i, fl.trace_lit, fl.phos)), ring.$i))
                        text "×{loom.$i.many, 0}" { at: if(loom_left, fx0.$i + lm_SEG - 57, fx0.$i + lm_SEG - 75), lyy.$i + 30; anchor: center; size: 10; weight: 700; family: "Exo 2"; color: fl.trace_lit }
                    }
                    // what can be done: the app's buttons (an intervention always shows them;
                    // otherwise they come up while the signal is pointed at)
                    group {
                        show: not lwh.$i and loom.$i.acts > 0
                        opacity: if(lur.$i, 1, la.$i)
                        CutButton(tx.$i, lyy.$i + lh.$i - 26, 84, loom.$i.a1, if(lur.$i, fl.ember, if(lwh.$i, fl.trace_lit, fl.phos)), if(za1.$i.hover, 1, 0))
                        group { show: loom.$i.acts > 1; CutButton(tx.$i + 90, lyy.$i + lh.$i - 26, 84, loom.$i.a2, if(lur.$i, fl.ember, if(lwh.$i, fl.trace_lit, fl.phos)), if(za2.$i.hover, 1, 0)) }
                        group { show: loom.$i.acts > 2; CutButton(tx.$i + 180, lyy.$i + lh.$i - 26, 84, loom.$i.a3, if(lur.$i, fl.ember, if(lwh.$i, fl.trace_lit, fl.phos)), if(za3.$i.hover, 1, 0)) }
                    }
                }
                // its zones: the face (its default, or the Field at it; right: let it wait in the
                // Field), its buttons, and × to dismiss it (its whole thread)
                zone box zs.$i { from: fx0.$i, lyy.$i; size: lm_SEG, lh.$i; cursor: pointer; role: button; show: loom.$i.out
                                 label: "{loom.$i.app}: {loom.$i.title}" }
                zone box za1.$i { from: tx.$i, lyy.$i + lh.$i - 26; size: 84, 20; cursor: pointer; role: button; label: "{loom.$i.a1}"
                                  show: loom.$i.out and not lwh.$i and loom.$i.acts > 0 and (lur.$i or la.$i > 0.5) }
                zone box za2.$i { from: tx.$i + 90, lyy.$i + lh.$i - 26; size: 84, 20; cursor: pointer; role: button; label: "{loom.$i.a2}"
                                  show: loom.$i.out and not lwh.$i and loom.$i.acts > 1 and (lur.$i or la.$i > 0.5) }
                zone box za3.$i { from: tx.$i + 180, lyy.$i + lh.$i - 26; size: 84, 20; cursor: pointer; role: button; label: "{loom.$i.a3}"
                                  show: loom.$i.out and not lwh.$i and loom.$i.acts > 2 and (lur.$i or la.$i > 0.5) }
                let xx.$i = if(loom_left, fx0.$i + lm_SEG - 24, fx0.$i + lm_SEG - 50)   // beside the diamond, clear of the words
                zone box zx.$i { from: xx.$i, lyy.$i + 4; size: 18, 18; cursor: pointer; role: button; label: "Dismiss {loom.$i.title}"
                                 show: loom.$i.out and (la.$i > 0.3 or lur.$i) }
                group {
                    show: loom.$i.out and (la.$i > 0.02 or lur.$i)
                    opacity: if(lur.$i, 1, la.$i)
                    line { from: xx.$i + 5, lyy.$i + 9; to: xx.$i + 13, lyy.$i + 17; width: 1.4; color: mix(fl.muted, fl.ember, if(zx.$i.hover, 1, 0)) }
                    line { from: xx.$i + 13, lyy.$i + 9; to: xx.$i + 5, lyy.$i + 17; width: 1.4; color: mix(fl.muted, fl.ember, if(zx.$i.hover, 1, 0)) }
                }
            }
            follow la.$i = if(zs.$i.hover or za1.$i.hover or za2.$i.hover or za3.$i.hover or zx.$i.hover, 1, 0)
            on press zs.$i { emit loom_open(i) }
            on press right zs.$i { emit loom_shelve(i) }
            on press za1.$i { emit loom_act(i * 10) }
            on press za2.$i { emit loom_act(i * 10 + 1) }
            on press za3.$i { emit loom_act(i * 10 + 2) }
            on press zx.$i { emit loom_dismiss(i) }
        }

        // How many wait behind the signals: pressed, the Field opens.
        let lm_moy = if(loom_bottom, lm_H - 6 - loom_len - 32, 6 + loom_len + 8)
        let lm_mox = if(loom_left, 6, lm_W - 6 - 170)
        zone box zmore { from: lm_mox, lm_moy; size: 170, 22; cursor: pointer; role: button; label: "{loom_more, 0} more: open the Signal Field"; show: loom_more > 0 }
        group {
            show: loom_more > 0 and loom_count > 0
            Chamfer(lm_mox, lm_moy, 170, 22, 5, fl.hull, mix(fl.trace, fl.phos, if(zmore.hover, 1, 0)), 0.95)
            text "+{loom_more, 0} WAITING · FIELD" { at: lm_mox + 85, lm_moy + 11; anchor: center; size: 10; family: "Share Tech Mono"
                                                     color: mix(fl.trace_lit, fl.phos, if(zmore.hover, 1, 0)) }
        }
        on press zmore { side = notes; mark_open = false; open = none }
    }

    // ══ Signal Field (D50) ════════════════════════════════════
    // The loom opened out, at the same edge: its header runs out along it, then its body drops.
    // Left, the clusters (an app's notices, then what was missed); right, the chosen one's
    // notices with what can be done; along the bottom, the activity rail (the last six hours,
    // now at the right). Keys: ↑↓ the clusters · Shift+↑↓ the notices · Return open · Delete
    // dismiss · S snooze · M mute the app · Esc close.



    // ══ The stash (D54, D56): the little box on the left edge ═════════
    // A rail at the screen's left edge opens into a chamfered box when it is pressed, or when a
    // file is dragged to the edge. What is let go on the box is kept: links, images, videos, any
    // file, and plain text (shell/stash.luau copies files into mooi's own stash folder). A press
    // opens an item, the × or a right press removes it, a drag carries it back out, the wheel
    // pages the list. Nothing is asked of the keyboard: a press on the rail puts it out, a press
    // on its plate (or anywhere outside it) puts it away, and a file dragged to the edge opens
    // it for the drop alone.
    //
    // Why a press and not a hover (D56): a box that came out whenever the pointer crossed the
    // screen's edge was a 336 × 558 plate over the desktop, and every press it took on its way
    // out — or while it sat there — was a press the window underneath never saw. A press is
    // something the person meant.
    //
    // The pulse: a light runs once around the border while the box is out. It is stepped by a
    // rule, not by `time`, so the scene rests while the box is closed; the surface is its own
    // and small, so the ~30 fps it costs while out is the box, not the whole screen.
    surface stash_dock {
        size: 360, full
        anchor: left
        level: overlay
        reserve: -1
        // No `keyboard:` here on purpose (D54): pleamar reads the mode from the scene's FIRST
        // surface and the `while` from the LAST that declares one, so a clause on this surface
        // would take the keyboard away from the islands, the pad and the board. Naming a folder
        // is in the bar's own clause instead (`stash_naming`).

        spring fl.stashbox = 1300, 62
        prop stash_a = 0 ~fl.stashbox
        prop stash_pulse = 0 ~1ms
        // How long the pointer has been away from the box and the rail: 0 while it is on them.
        // Its ~700 ms is the hysteresis that keeps a single missed frame from closing the box
        // (and the box closing from re-opening a tick later — the flicker D54 records).
        prop stash_away = 0 ~700ms

        let sb_w = 336
        let sb_h = 614
        let sb_y = (screen.height - sb_h) / 2
        let sb_x = -346 + 356 * stash_a
        let sb_tab_h = 128
        let sb_tab_y = (screen.height - sb_tab_h) / 2
        // Closing is learned from the three zones' own springs (`ztab`, `zcatch`, `zstash`: over
        // them, or not), not from `cursor.x`: a surface is told where the mouse is only while it is
        // over it, and the mouse's place from the compositor is one more thing that can be late.
        let hot_drop = drag.over and stash_a > 0.5   // no cursor here: the drawing must not follow the mouse
        // The light's place along the border: top, right, bottom, left, in the box's own pixels.
        let sb_per = 2 * (sb_w + sb_h)
        let sb_d1 = mod(stash_pulse * sb_per, sb_per)
        let sb_d2 = mod(stash_pulse * sb_per - 9, sb_per)
        let sb_d3 = mod(stash_pulse * sb_per - 18, sb_per)
        let sb_l1x = if(sb_d1 < sb_w, sb_d1, if(sb_d1 < sb_w + sb_h, sb_w, if(sb_d1 < 2 * sb_w + sb_h, 2 * sb_w + sb_h - sb_d1, 0)))
        let sb_l1y = if(sb_d1 < sb_w, 0, if(sb_d1 < sb_w + sb_h, sb_d1 - sb_w, if(sb_d1 < 2 * sb_w + sb_h, sb_h, sb_per - sb_d1)))
        let sb_l2x = if(sb_d2 < sb_w, sb_d2, if(sb_d2 < sb_w + sb_h, sb_w, if(sb_d2 < 2 * sb_w + sb_h, 2 * sb_w + sb_h - sb_d2, 0)))
        let sb_l2y = if(sb_d2 < sb_w, 0, if(sb_d2 < sb_w + sb_h, sb_d2 - sb_w, if(sb_d2 < 2 * sb_w + sb_h, sb_h, sb_per - sb_d2)))
        let sb_l3x = if(sb_d3 < sb_w, sb_d3, if(sb_d3 < sb_w + sb_h, sb_w, if(sb_d3 < 2 * sb_w + sb_h, 2 * sb_w + sb_h - sb_d3, 0)))
        let sb_l3y = if(sb_d3 < sb_w, 0, if(sb_d3 < sb_w + sb_h, sb_d3 - sb_w, if(sb_d3 < 2 * sb_w + sb_h, sb_h, sb_per - sb_d3)))

        // The rail at the edge: steel, a notch, three ticks. It is what the pointer finds.
        //
        // Round it, a catcher: a strip 12 px wide with nothing painted on it (opacity 0.01, the
        // same trick as the Shutter's own catcher). A surface is given the mouse only where it
        // has something to see, and a file dragged to the edge arrives before the box is out:
        // without the strip the drag would pass through the empty part of the surface and the
        // box would never learn it was coming. It is the strip, too, that takes a file let go
        // right at the edge, before the box has finished sliding out. It keeps inside
        // Hyprland's gaps_out (12 px), so no click meant for a window is taken.
        // It is cut in two round the side notch's nub (nub_cut0..1), which lives on this edge too.
        let sc_h0 = max(0, min(sb_h, nub_cut0 - sb_y))
        let sc_y1 = max(sb_y, min(sb_y + sb_h, nub_cut1))
        let sc_h1 = sb_y + sb_h - sc_y1
        zone box zstash_catch { from: 0, sb_y; size: 12, sc_h0; role: region; label: "The stash's edge — drop here" }
        box { from: 0, sb_y; size: 12, sc_h0; color: fl.hull; opacity: 0.01; show: sc_h0 > 0 }
        zone box zstash_catch2 { from: 0, sc_y1; size: 12, sc_h1; role: region; label: "The stash's edge — drop here" }
        box { from: 0, sc_y1; size: 12, sc_h1; color: fl.hull; opacity: 0.01; show: sc_h1 > 0 }
        zone box zstash_tab { from: 0, sb_tab_y; size: 9, sb_tab_h; cursor: pointer; role: button; label: "Stash — drop files, links and pictures here" }
        box { from: 0, sb_tab_y; size: 9, sb_tab_h; corner: 2; color: fl.hull_raised; opacity: 0.55 }
        group {
            glow: 9, 0.12 * st_glow + 0.35 * st_glow * if(zstash_tab.hover, 1, 0), fl.phos
            box { from: 2, sb_tab_y + 10; size: 3, sb_tab_h - 20; corner: 1.5
                  color: mix(fl.trace_dim, fl.phos, max(0.34, max(zstash_tab.hover, 0.38 * stash_a))) }
        }
        repeat t in 0..3 {
            line { from: 5, sb_tab_y + sb_tab_h / 2 - 9 + t * 6; to: 9, sb_tab_y + sb_tab_h / 2 - 9 + t * 6; width: 1
                   color: mix(fl.trace_lit, fl.phos, max(zstash_tab.hover, 0.3 * stash_a)) }
        }

        // The box: a plate with a light running round it, cut from the same chamfer as the
        // Signal Loom and the board. It slides out of the left edge.
        group {
            show: stash_a > 0.004
            move: sb_x, sb_y
            group {
                glow: 26, 0.34 * st_glow, fl.phos
                Chamfer(0, 0, sb_w, sb_h, 16, if(hot_drop, fl.well, fl.hull), if(hot_drop, fl.phos, fl.trace), 0.985, 1.5)
            }
            group {
                show: stash_a > 0.35 and not saving
                glow: 11, 0.95 * st_glow, fl.phos
                ellipse { at: sb_l1x, sb_l1y; radius: 3.4; color: fl.phos }
                ellipse { at: sb_l2x, sb_l2y; radius: 2.3; color: mix(fl.phos, fl.hull, 0.3) }
                ellipse { at: sb_l3x, sb_l3y; radius: 1.6; color: mix(fl.phos, fl.hull, 0.55) }
            }

            group {
                clip box { from: 0, 0; size: sb_w, sb_h }
                // the whole plate takes a drop; the rows are on top of it, so they take it too
                zone box zstash { from: 0, 0; size: sb_w, sb_h; role: region; label: "The stash — drop anything here" }

                text "STASH" { at: 18, 26; anchor: left center; size: 11; weight: 700; family: "Share Tech Mono"; color: fl.ember }
                text "{stash_count, 0}" { at: 76, 26; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.muted }
                // which folder is being looked into, said in its own name
                text stash_here_name { at: 96, 26; anchor: left center; size: 10; family: "Exo 2"; width: 150; lines: 1
                                       color: fl.ember; show: not stash_root }
                text "{stash_from, 0}–{stash_to, 0} / {stash_count, 0}" { at: sb_w - 18, 26; anchor: right center; size: 10; family: "Share Tech Mono"
                                                                         color: fl.muted; show: stash_pages > 1 }
                text "DROP ANYTHING" { at: sb_w - 18, 26; anchor: right center; size: 10; family: "Share Tech Mono"; color: fl.muted; show: stash_pages <= 1 }
                line { from: 16, 46; to: sb_w - 16, 46; width: 1; color: fl.trace_dim }

                // ── D86: the ways in that are not a drop, and the ways to find what is here ──
                zone box zspaste { from: 12, 56; size: 72, 26; cursor: pointer; role: button; label: "Stash what is on the clipboard" }
                Chamfer(12, 56, 72, 26, 5, mix(fl.hull_raised, fl.well, zspaste.hover), mix(fl.trace, fl.phos, zspaste.hover), 0.95, 1)
                text "PASTE" { at: 48, 69; anchor: center; size: 10; weight: 700; family: "Share Tech Mono"; color: mix(fl.engrave, fl.phos, zspaste.hover) }
                on press zspaste { emit stash_paste }
                zone box zsshot { from: 90, 56; size: 66, 26; cursor: pointer; role: button; label: "Stash a screenshot of a region" }
                Chamfer(90, 56, 66, 26, 5, mix(fl.hull_raised, fl.well, zsshot.hover), mix(fl.trace, fl.ember, zsshot.hover), 0.95, 1)
                text "SHOT" { at: 123, 69; anchor: center; size: 10; weight: 700; family: "Share Tech Mono"; color: mix(fl.engrave, fl.ember, zsshot.hover) }
                on press zsshot { stash_pin = false; stash_a: 0; stash_away: 1; emit stash_shot }
                zone box zsfind { from: 162, 56; size: sb_w - 174, 26; cursor: text; role: region; label: "Search the stash" }
                Chamfer(162, 56, sb_w - 174, 26, 5, fl.ground, mix(fl.trace_dim, fl.phos, max(zsfind.hover, if(stash_searching, 1, 0))), 1, 1)
                ellipse { at: 175, 68; radius: 4; stroke: 1.2; color: mix(fl.trace_lit, fl.phos, zsfind.hover) }
                line { from: 178, 71; to: 182, 75; width: 1.2; color: mix(fl.trace_lit, fl.phos, zsfind.hover) }
                input stash_query { at: 188, 62; width: sb_w - 212; size: 10.5; family: "Exo 2"; color: fl.phos; selection: fl.well
                                    placeholder: "Search…" }
                on press zsfind { stash_naming = true; focus stash_query }
                // the chips: what kind of thing the box shows
                repeat k in 0..5 {
                    let skw = (sb_w - 24 - 4 * 4) / 5
                    let skx.$k = 12 + k * (skw + 4)
                    zone box zskind.$k { from: skx.$k, 88; size: skw, 20; cursor: pointer; role: tab; selected: stash_kind == k
                                         label: pick(k, "Everything", "Pictures and videos", "Links", "Files and songs", "Text") }
                    Chamfer(skx.$k, 88, skw, 20, 4, mix(fl.ground, fl.well, max(zskind.$k.hover * 0.6, if(stash_kind == k, 0.9, 0))),
                            mix(fl.trace_dim, fl.phos, max(zskind.$k.hover, if(stash_kind == k, 1, 0))), 0.9, 1)
                    text pick(k, "ALL", "PICTURES", "LINKS", "FILES", "TEXT") { at: skx.$k + skw / 2, 98; anchor: center; size: 7.2; weight: 700
                         family: "Share Tech Mono"; color: mix(fl.muted, fl.phos, max(zskind.$k.hover, if(stash_kind == k, 1, 0))) }
                    on press zskind.$k { emit stash_kind(k) }
                }

                group {
                    show: not stash_empty
                    for r in stash {
                        group { move: 12, 118 + r.n * 66; StashRow(r, stash_open, stash_del, stash_file) }
                    }
                }

                // Nothing yet: a reticle and what to do.
                group {
                    show: stash_empty
                    let sb_ex = 94
                    let sb_ey = 196
                    let sb_ew = sb_w - 188
                    let sb_eh = 132
                    line { from: sb_ex, sb_ey + 14; to: sb_ex, sb_ey; width: 1.2; color: fl.trace_lit }
                    line { from: sb_ex, sb_ey; to: sb_ex + 14, sb_ey; width: 1.2; color: fl.trace_lit }
                    line { from: sb_ex + sb_ew - 14, sb_ey; to: sb_ex + sb_ew, sb_ey; width: 1.2; color: fl.trace_lit }
                    line { from: sb_ex + sb_ew, sb_ey; to: sb_ex + sb_ew, sb_ey + 14; width: 1.2; color: fl.trace_lit }
                    line { from: sb_ex, sb_ey + sb_eh - 14; to: sb_ex, sb_ey + sb_eh; width: 1.2; color: fl.trace_lit }
                    line { from: sb_ex, sb_ey + sb_eh; to: sb_ex + 14, sb_ey + sb_eh; width: 1.2; color: fl.trace_lit }
                    line { from: sb_ex + sb_ew - 14, sb_ey + sb_eh; to: sb_ex + sb_ew, sb_ey + sb_eh; width: 1.2; color: fl.trace_lit }
                    line { from: sb_ex + sb_ew, sb_ey + sb_eh - 14; to: sb_ex + sb_ew, sb_ey + sb_eh; width: 1.2; color: fl.trace_lit }
                    line { from: sb_w / 2 - 10, sb_ey + sb_eh / 2; to: sb_w / 2 + 10, sb_ey + sb_eh / 2; width: 1.6; color: fl.trace_lit }
                    line { from: sb_w / 2, sb_ey + sb_eh / 2 - 10; to: sb_w / 2, sb_ey + sb_eh / 2 + 10; width: 1.6; color: fl.trace_lit }
                    text pick(stash_kind > 0 or stash_searching, "NOTHING STASHED", "NOTHING LIKE THAT HERE") { at: sb_w / 2, 268; anchor: center; size: 12; weight: 600; family: "Exo 2"; color: fl.trace_lit }
                    text "Drop a link, an image, a video or any file here. It is kept in mooi's own stash, beside settings.json." {
                         at: sb_w / 2, 292; anchor: center; size: 11; family: "Exo 2"; width: 252; lines: 3; color: fl.muted }
                }

                // ── the folders: a chip each, and the field that makes one ──
                // Everything is the first chip; the folders follow in the order they were made,
                // which is the order the logic keeps them in, so a press names one by its slot.
                zone box zall { from: 12, 458; size: 48, 22; cursor: pointer; role: tab; selected: stash_root
                                label: "Everything — {stash_all, 0} kept" }
                Chamfer(12, 458, 48, 22, 5, mix(fl.ground, fl.well, max(zall.hover, if(stash_root, 0.9, 0))), mix(fl.trace_dim, fl.phos, max(zall.hover, if(stash_root, 1, 0))), 0.9, 1)
                text "ALL" { at: 36, 469; anchor: center; size: 10; weight: 600; family: "Share Tech Mono";
                             color: mix(fl.muted, fl.phos, max(zall.hover, if(stash_root, 1, 0))) }
                on press zall { stash_naming = false; blur; emit stash_folder(0) }
                repeat i in 0..5 {
                    let fx = 64 + i * 52
                    group {
                        show: stash_folders_n > i
                        zone box zfolder.$i { from: fx, 458; size: 48, 22; cursor: pointer; role: tab
                                              selected: stash_folders.$i.lit > 0.5
                                              label: "Folder {stash_folders.$i.name} — {stash_folders.$i.held, 0} in it" }
                        Chamfer(fx, 458, 48, 22, 5, mix(fl.ground, fl.well, max(zfolder.$i.hover, 0.9 * stash_folders.$i.lit)),
                                mix(fl.trace_dim, fl.phos, max(zfolder.$i.hover, stash_folders.$i.lit)), 0.9, 1)
                        text stash_folders.$i.name { at: fx + 24, 469; anchor: center; size: 8; weight: 600; family: "Share Tech Mono"; width: 42; lines: 1
                                                    color: mix(fl.muted, fl.phos, max(zfolder.$i.hover, stash_folders.$i.lit)) }
                        on press zfolder.$i { stash_naming = false; blur; emit stash_folder(i + 1) }
                        on press right zfolder.$i { emit stash_folder_del(i + 1) }
                    }
                }

                zone box znew { from: 12, 490; size: 312, 26; cursor: text; role: region
                                label: "New folder — type a name and press Enter" }
                Chamfer(12, 490, 312, 26, 5, fl.ground, mix(fl.trace_dim, fl.ember, max(znew.hover, if(stash_naming, 1, 0))), 1, if(stash_naming, 1.4, 1))
                line { from: 22, 503; to: 30, 503; width: 1.4; color: mix(fl.trace_lit, fl.ember, znew.hover) }
                line { from: 26, 499; to: 26, 507; width: 1.4; color: mix(fl.trace_lit, fl.ember, znew.hover) }
                input stash_new { at: 36, 498; width: 278; size: 11; family: "Exo 2"; color: fl.phos; selection: fl.well
                                  placeholder: "New folder — name it, then Enter" }
                text "FOLDERS · ONE LEVEL · RIGHT PRESS A CHIP TAKES IT AWAY" { at: 12, 530; anchor: left center; size: 10
                     family: "Share Tech Mono"; width: 312; lines: 1; color: fl.muted }
                on press znew { stash_naming = true; focus stash_new }

                line { from: 16, 542; to: sb_w - 16, 542; width: 1; color: fl.trace_dim; show: not stash_empty }
                text "CLICK OPENS · TRAY FILES IT · DRAG A ROW OUT · × REMOVES" { at: sb_w / 2, 558; anchor: center; size: 10
                     family: "Share Tech Mono"; width: sb_w - 36; lines: 1; color: fl.muted; show: not stash_empty }
                text pick(stash_pages > 1, "WHEEL PAGES · PRESS A FOLDER TO LOOK INSIDE", "PRESS A FOLDER TO LOOK INSIDE · THE EDGE RAIL OPENS THIS") {
                     at: sb_w / 2, 574; anchor: center; size: 8; family: "Share Tech Mono"; width: sb_w - 36; lines: 1; color: fl.muted }
                text stash_said { at: sb_w / 2, 598; anchor: center; size: 10; family: "Share Tech Mono"; color: fl.ember; show: stash_saying }
            }
        }

        // The hands (D56). The rail is a press: hovering it lights it and opens nothing, so the
        // box can never come out over a window nobody asked it to cover. A press puts it out and
        // pins it; a second press, a press on its plate, a press anywhere outside it (the bar's
        // `dismiss` plate) or 45 s without a hand puts it away. A file dragged to the left edge
        // still opens it before it arrives, and that one closes as the pointer leaves, since a
        // drag in is not a pin. Closing is learned from the springs' own zones (`ztab`, `zcatch`,
        // `zstash`: over them, or not), never from the compositor's cursor, which can be late.
        //
        // There is no `on enter zstash`: the plate's left edge slides through the rail's own 9 px
        // on its way in and out, so a rule that opened the box on entering the plate fired while
        // the plate was on its way out — the press that closed it opened it again in the same
        // motion (D56). Being over the plate is read from its hover below, which is what keeps a
        // drag-opened box out until the pointer leaves.
        on press zstash_tab while not stash_pin { stash_pin = true; stash_a: 1; stash_away: 0 }
        on press zstash_tab while stash_pin { stash_pin = false; stash_a: 0; stash_away: 1; blur }
        on press zstash { stash_pin = false; stash_a: 0; stash_away: 1; blur }
        every 80ms while drag.over and pointer.x < 26 and not stash_pin { stash_a: 1; stash_away: 0 }
        every 100ms while zstash_tab.hover >= 0.2 or zstash_catch.hover >= 0.2 or zstash_catch2.hover >= 0.2 or zstash.hover >= 0.2 or drag.over or stash_naming or stash_pin { stash_away: 0 }
        every 100ms while stash_a > 0.5 and not stash_pin and zstash_tab.hover < 0.2 and zstash_catch.hover < 0.2 and zstash_catch2.hover < 0.2 and zstash.hover < 0.2 and not drag.over and not stash_naming { stash_away: 1 }
        every 100ms while stash_a > 0.5 and stash_away > 0.9 { stash_a: 0 }
        every 33ms while stash_a > 0.2 and not saving { stash_pulse: mod(stash_pulse + 0.0055, 1) ~1ms }
        on idle for 45s while stash_pin { stash_pin = false; stash_a: 0; stash_away: 1 }
    }
    // The folder's name, written: Enter makes it (the logic), Escape gives the keys back to the
    // window behind, and either way the field is done.
    on stash_blur { stash_naming = false; blur }
    on key Escape while stash_naming { stash_naming = false; blur }

    // ══ Window island ═════════════════════════════════════════


    // ══ System island ═════════════════════════════════════════


    // ══ Workspace Atlas ═══════════════════════════════════════
    // Every window Hyprland lists, as a preview: the compositor's own picture of it
    // where one can be had, its app and title otherwise. Choosing a tile focuses that
    // window, so the tile is built from Hyprland's clients —the address is Hyprland's—
    // and only the picture comes from the `thumbnails` service. The workspace a window
    // sits on is on the tile; the map of workspace slots is `spaces`.



    // ══ The Overview ════════════════════════════════════════
    // Every workspace of the page as a miniature of its screen — the wallpaper, its windows where
    // they are, with their pictures — in rows × columns. It opens by zooming out of the workspace
    // you are on (that miniature starts as the whole screen), and closes by zooming into the one
    // chosen, so the desktop is the same picture before, during and after. A window carried into
    // another miniature goes to that workspace; a press on a miniature goes there; arrows and Enter.
    surface overview_surface {
        size: full, full
        anchor: top
        level: overlay
        reserve: -1
        screens: each
        open: open == overview or ov_z > 0.004

        // The Overview is a camera over a world (D47). Each workspace has a rectangle in it (the
        // logic's: the grid's and the strip's are their cells on the screen; the canvas's are
        // territories the size of the screen, one unit a screen pixel, placed anywhere). The camera
        // shows the world: on the canvas you pan and zoom it; in every shape it opens on the workspace
        // you are on, filling the screen, and pulls back (and dives into the one chosen as it closes).
        // No glow: it redraws with every move of the camera or a carried window.
        prop ov_ax = 0 ~180ms     // the active workspace's rectangle, sliding to where the focus goes
        prop ov_ay = 0 ~180ms
        follow ov_ax = ov_awx
        follow ov_ay = ov_awy

        group {
            show: screen.index == ov_moni
            let ov_oa = clamp(ov_z * 1.5 - 0.3, 0, 1)           // the rest comes in: opacity leads,
            let ov_slide = (ov_z - 1) * 12                       // and it comes down 12 px (iNiR)
            let ov_pw = ov_cols * ov_cw + (ov_cols - 1) * ov_gap
            let ov_ph = ov_rows * ov_ch + (ov_rows - 1) * ov_gap
            let ov_top = st_res

            // ── the field: the grid's dim, or the canvas's near-black ground with its coordinate grid —
            // late, so the first of the pull-back is the desktop itself
            // (a layer that cannot be seen is not drawn: the whole screen, blended, is the costly part)
            box { from: 0, 0; size: ov_W, ov_H; color: mix(fl.ground, #000000, 0.5); opacity: if(ov_strip, ov_dim * 0.55, ov_dim) * ov_z * ov_z; show: not ov_canvas and ov_z > 0.05 }
            box { from: 0, 0; size: ov_W, ov_H; color: fl.ground; opacity: 0.97 * ov_z * ov_z; show: ov_canvas and ov_z > 0.05 }
            // grid lines every 240 (close), 960 or 3840 (far) of the world, quieter as it pulls back,
            // clearer while something is carried
            let ov_gs = if(cam_z > 0.25, 240, if(cam_z > 0.07, 960, 3840))
            let ov_gp = ov_gs * cam_z
            let ov_gx0 = (ceil(cam_x / ov_gs) * ov_gs - cam_x) * cam_z
            let ov_gy0 = (ceil(cam_y / ov_gs) * ov_gs - cam_y) * cam_z
            let ov_ga = ov_z * ov_z * if(bd_drag >= 0 or cd_drag >= 0, 0.22, 0.09)
            group {
                show: ov_canvas
                repeat g in 0..42 {
                    let gvx.$g = ov_gx0 + g * ov_gp
                    let gmj.$g = mod(floor(cam_x / ov_gs + 0.999) + g, 4) == 0
                    box { from: gvx.$g, 0; size: 1, ov_H; color: border.subtle; opacity: ov_ga * if(gmj.$g, 1.8, 1); show: gvx.$g < ov_W }
                }
                repeat g in 0..26 {
                    let ghy.$g = ov_gy0 + g * ov_gp
                    let gmn.$g = mod(floor(cam_y / ov_gs + 0.999) + g, 4) == 0
                    box { from: 0, ghy.$g; size: ov_W, 1; color: border.subtle; opacity: ov_ga * if(gmn.$g, 1.8, 1); show: ghy.$g < ov_H }
                }
            }

            // ── the open field: a press and let go puts the Overview away (the grid) or lets go of what
            // is selected (the canvas); on the canvas a drag pans, the wheel zooms where the pointer is,
            // and a double press makes a workspace there
            zone box ov_bg { from: 0, 0; size: ov_W, ov_H; role: region; label: "The open field" }
            on press ov_bg while open == overview and bd_drag < 0 and cd_drag < 0 and ov_mopen < 0 and ov_canvas and ov_bggate.recent > 0.5 { ov_px = local.x; ov_py = local.y; emit ov_create(1) }
            on press ov_bg while open == overview and bd_drag < 0 and cd_drag < 0 and ov_mopen < 0 { bg_press = 1; bg_moved = 0; pan_cx = ov_cx; pan_cy = ov_cy; emit ov_bgtap }
            on drag ov_bg while bg_press == 1 and ov_canvas and length(drag.dx, drag.dy) > 4 { bg_moved = 1; ov_cx = pan_cx - drag.dx / ov_cz; ov_cy = pan_cy - drag.dy / ov_cz; cam_x: ov_cx ~0ms; cam_y: ov_cy ~0ms }
            on release ov_bg while bg_press == 1 and bg_moved == 0 and not ov_canvas { bg_press = 0; open = none }
            on release ov_bg while bg_press == 1 and bg_moved == 0 and ov_canvas { bg_press = 0; ov_win = -1 }
            on release ov_bg while bg_press == 1 and bg_moved == 1 { bg_press = 0 }
            on scroll ov_bg while open == overview and ov_canvas and bd_drag < 0 and cd_drag < 0 and ov_mopen < 0 {
                ov_cx = ov_cx + local.x / ov_cz - local.x / clamp(ov_cz * pow(1.18, wheel), 0.03, 1.5)
                ov_cy = ov_cy + local.y / ov_cz - local.y / clamp(ov_cz * pow(1.18, wheel), 0.03, 1.5)
                ov_cz = clamp(ov_cz * pow(1.18, wheel), 0.03, 1.5) }

            // ── the grid's plate (the canvas has none: its territories stand on the field)
            group {
                show: not ov_canvas
                opacity: ov_oa
                move: 0, ov_slide
                // machined like the islands (ui/island.plm): lighter at the top, a lit lip, a soft shadow; the
                // corners and the opacity are the theme's (Appearance → corners, opacity)
                body {
                    gradient: 0, ov_gy - 10 - ov_search_h to 0, ov_gy + ov_ph + 34, surface.elevated, surface.primary 40%, bg.primary
                    border: 1, border.subtle
                    shadow: 0, 6, 22, 38%
                    opacity: max(st_opacity, 0.9)
                    box { from: ov_gx - 10, ov_gy - 10 - ov_search_h; size: ov_pw + 20, ov_ph + 44 + ov_search_h; corner: g.radius }
                }
                line { from: ov_gx - 10 + g.radius, ov_gy - 8.5 - ov_search_h; to: ov_gx + ov_pw + 10 - g.radius, ov_gy - 8.5 - ov_search_h; width: 1; color: fg.primary; opacity: 0.08 }
                box { from: ov_gx + 14, ov_gy - 11 - ov_search_h; size: 56, 2; color: fl.phos }
                box { from: ov_gx, ov_gy - 10; size: ov_pw, 1; color: border.subtle }
            }

            // ── the workspaces: in the grid, plain plates; on the canvas, territories — a clipped
            // perimeter, registration marks off its corners (once it is near enough to read them), a
            // nameplate over it to carry it by. Each where the camera puts its rectangle.
            repeat k in 0..18 {
                prop tx.$k = 0 ~260ms
                prop ty.$k = 0 ~260ms
                follow tx.$k = ov_cells.$k.tx
                follow ty.$k = ov_cells.$k.ty
                let cdr.$k = cd_drag == k and open == overview
                let lx.$k = if(cdr.$k, sp_hx - cd_ox, (tx.$k - cam_x) * cam_z)
                let ly.$k = if(cdr.$k, sp_hy - cd_oy, (ty.$k - cam_y) * cam_z)
                let lw.$k = ov_cells.$k.tw * cam_z
                let lh.$k = ov_cells.$k.th * cam_z
                let zc.$k = k == ov_zc and ov_z < 0.999           // the one the screen pulls back from
                let hot.$k = bd_drag >= 0 and sp_hx >= lx.$k and sp_hx <= lx.$k + lw.$k and sp_hy >= ly.$k and sp_hy <= ly.$k + lh.$k
                let lit.$k = hot.$k or (ov_searching and ov_cells.$k.hit) or (ov_canvas and ov_cells.$k.active)
                let cc.$k = clamp(min(lw.$k, lh.$k) * 0.06, 3, 6 + g.radius)  // the clipped corners, as deep as the theme's rounding allows
                group {
                    show: k < ov_cells.count
                    z: if(cdr.$k, 9, 0)
                    opacity: if(zc.$k, 1, ov_oa) * if(ov_searching and not ov_cells.$k.hit, 0.45, 1)
                    move: 0, if(zc.$k or ov_canvas, 0, ov_slide)
                    zone box ovc.$k { from: lx.$k, ly.$k; size: lw.$k, lh.$k; cursor: pointer; role: button; selected: ov_cells.$k.active
                                      label: "Workspace {ov_cells.$k.id}{? · {ov_cells.$k.windows} windows}" }
                    // the grid's plate
                    group {
                        show: not ov_canvas
                        box { from: lx.$k, ly.$k; size: lw.$k, lh.$k; corner: g.radius.item * ov_z; opacity: if(zc.$k, clamp(ov_z * 2 - 1, 0, 1), 1)
                              color: if(hot.$k, mix(surface.elevated, accent.primary, 0.16), mix(surface.elevated, fg.primary, 0.05 * ovc.$k.hover)); show: not zc.$k or ov_z > 0.5 }
                        box { from: lx.$k, ly.$k; size: lw.$k, lh.$k; corner: g.radius.item * ov_z; stroke: if(lit.$k, 2, 1); color: if(lit.$k, accent.primary, border.subtle)
                              opacity: if(zc.$k, clamp(ov_z * 2 - 1, 0, 1), 1) }
                    }
                    // the canvas's territory
                    group {
                        show: ov_canvas and (not zc.$k or ov_z > 0.5)
                        opacity: if(zc.$k, clamp(ov_z * 2 - 1, 0, 1), 1)
                        path { color: if(hot.$k, mix(surface.primary, accent.primary, 0.14), surface.primary); opacity: 0.55
                               move lx.$k + cc.$k, ly.$k; line lx.$k + lw.$k - cc.$k, ly.$k; line lx.$k + lw.$k, ly.$k + cc.$k; line lx.$k + lw.$k, ly.$k + lh.$k - cc.$k
                               line lx.$k + lw.$k - cc.$k, ly.$k + lh.$k; line lx.$k + cc.$k, ly.$k + lh.$k; line lx.$k, ly.$k + lh.$k - cc.$k; line lx.$k, ly.$k + cc.$k; close }
                        path { stroke: if(lit.$k, 1.6, 1); color: if(lit.$k, accent.primary, mix(border.subtle, fg.primary, 0.25 * ovc.$k.hover))
                               move lx.$k + cc.$k, ly.$k; line lx.$k + lw.$k - cc.$k, ly.$k; line lx.$k + lw.$k, ly.$k + cc.$k; line lx.$k + lw.$k, ly.$k + lh.$k - cc.$k
                               line lx.$k + lw.$k - cc.$k, ly.$k + lh.$k; line lx.$k + cc.$k, ly.$k + lh.$k; line lx.$k, ly.$k + lh.$k - cc.$k; line lx.$k, ly.$k + cc.$k; close }
                        // registration marks: small angles set off the corners, only near enough to read
                        group {
                            show: lw.$k > 220
                            opacity: clamp((lw.$k - 220) / 200, 0, 1)
                            path { stroke: 1; color: fl.trace_lit; move lx.$k - 7, ly.$k + 6; line lx.$k - 7, ly.$k - 7; line lx.$k + 6, ly.$k - 7 }
                            path { stroke: 1; color: fl.trace_lit; move lx.$k + lw.$k - 6, ly.$k - 7; line lx.$k + lw.$k + 7, ly.$k - 7; line lx.$k + lw.$k + 7, ly.$k + 6 }
                            path { stroke: 1; color: fl.trace_lit; move lx.$k - 7, ly.$k + lh.$k - 6; line lx.$k - 7, ly.$k + lh.$k + 7; line lx.$k + 6, ly.$k + lh.$k + 7 }
                            path { stroke: 1; color: fl.trace_lit; move lx.$k + lw.$k - 6, ly.$k + lh.$k + 7; line lx.$k + lw.$k + 7, ly.$k + lh.$k + 7; line lx.$k + lw.$k + 7, ly.$k + lh.$k - 6 }
                        }
                    }
                    text "{ov_cells.$k.id}" { at: lx.$k + lw.$k / 2, ly.$k + lh.$k / 2; anchor: center; size: 34; weight: 600
                                              family: "Share Tech Mono"; color: fg.muted; opacity: 0.4; show: ov_cells.$k.windows < 1 and not zc.$k and lw.$k > 90 }
                    on press ovc.$k while open == overview and bd_drag < 0 and cd_drag < 0 and ov_mopen < 0 and not ov_canvas { ov_zc = k; emit ov_go(k); open = none }
                    // on the canvas a press on a territory selects it; a double press goes there
                    on press ovc.$k while open == overview and bd_drag < 0 and cd_drag < 0 and ov_mopen < 0 and ov_canvas and ov_tapgate.recent > 0.5 and ov_lastt == 100 + k { ov_zc = k; emit ov_go(k); open = none }
                    on press ovc.$k while open == overview and bd_drag < 0 and cd_drag < 0 and ov_mopen < 0 and ov_canvas { ov_sel = k; ov_win = -1; emit ov_tap; ov_lastt = 100 + k }
                    on press right ovc.$k while open == overview and bd_drag < 0 { ov_sel = k; ov_win = -1; emit ov_menu_open(k) }
                }
            }

            // ── the windows: in their workspace's rectangle where they are on their screen, each gliding
            // to wherever it is told to be; a carried one under the pointer, held where it was taken; the
            // ones of a carried territory going along with it
            repeat i in 0..40 {
                let tk.$i = atlas_tiles.$i.ocell
                let car.$i = bd_drag == i and open == overview
                prop wx.$i = 0 ~260ms          // in the world
                prop wy.$i = 0 ~260ms
                follow wx.$i = atlas_tiles.$i.tx + atlas_tiles.$i.fx * atlas_tiles.$i.tw
                follow wy.$i = atlas_tiles.$i.ty + atlas_tiles.$i.fy * atlas_tiles.$i.th
                let tdr.$i = cd_drag >= 0 and tk.$i == cd_drag
                let tdx.$i = if(tdr.$i, sp_hx - cd_ox - (atlas_tiles.$i.tx - cam_x) * cam_z, 0)
                let tdy.$i = if(tdr.$i, sp_hy - cd_oy - (atlas_tiles.$i.ty - cam_y) * cam_z, 0)
                let dw.$i = max(atlas_tiles.$i.fw * atlas_tiles.$i.tw * cam_z, 8)
                let dh.$i = max(atlas_tiles.$i.fh * atlas_tiles.$i.th * cam_z, 8)
                let dx.$i = if(car.$i, sp_hx - bd_ox, (wx.$i - cam_x) * cam_z + tdx.$i)
                let dy.$i = if(car.$i, sp_hy - bd_oy, (wy.$i - cam_y) * cam_z + tdy.$i)
                let is.$i = clamp(min(dw.$i, dh.$i) * 0.35, 12, 44)
                let found.$i = ov_searching and atlas_tiles.$i.hit
                let picked.$i = ov_win == i and open == overview
                // its fade, given to each of its parts: a group's own opacity is drawn offscreen, and forty of
                // them the size of the screen as it pulls back cost frames (D47)
                let to.$i = if(tk.$i == ov_zc, clamp(ov_z * 1.6 - 0.4, 0, 1), ov_oa) * if(ov_searching and not atlas_tiles.$i.hit and not car.$i, 0.25, 1)
                group {
                    show: i < atlas_tiles.count and tk.$i >= 0 and tk.$i < ov_cells.count and to.$i > 0.01
                    z: if(car.$i, 10, if(tdr.$i or picked.$i, 9, if(atlas_tiles.$i.floating, 2, 0)))   // floating over tiled, as Hyprland shows them
                    move: 0, if(tk.$i == ov_zc or car.$i or ov_canvas, 0, ov_slide)
                    zone box otile.$i { from: dx.$i, dy.$i; size: dw.$i, dh.$i; corner: 4; cursor: grab; role: button
                                        label: "{atlas_tiles.$i.app}: {atlas_tiles.$i.title}, workspace {atlas_tiles.$i.ws}" }
                    box { from: dx.$i, dy.$i; size: dw.$i, dh.$i; corner: max(g.radius.item - 3, 2); color: surface.primary; opacity: to.$i }
                    // the picture, a little dimmed until it is pointed at, carried, found or picked (its opacity
                    // over the dark backing, not a veil over it: one full-size layer fewer for every window)
                    image atlas_tiles.$i.picture { at: dx.$i, dy.$i; size: dw.$i, dh.$i
                                                   opacity: to.$i * if(atlas_tiles.$i.stale, 0.5, 1) * if(car.$i or found.$i or picked.$i, 1, 0.74 + 0.26 * otile.$i.hover) }
                    image atlas_tiles.$i.icon { at: dx.$i + dw.$i / 2 - is.$i / 2, dy.$i + dh.$i / 2 - is.$i / 2; size: is.$i, is.$i; opacity: to.$i; show: atlas_tiles.$i.iconed }
                    // on the canvas, near enough, its title along its top (the grid's cells carry their own labels)
                    group {
                        show: ov_canvas and dw.$i > 230
                        box { from: dx.$i, dy.$i; size: dw.$i, 18; color: bg.primary; opacity: 0.78 * to.$i }
                        text "{atlas_tiles.$i.app} · {atlas_tiles.$i.title}" { at: dx.$i + 8, dy.$i + 9; anchor: left center; size: 10; color: fg.secondary; width: dw.$i - 16; lines: 1; opacity: to.$i }
                    }
                    text "PRIVATE" { at: dx.$i + dw.$i / 2, dy.$i + dh.$i / 2 + is.$i / 2 + 9; anchor: center; size: 10; family: "Share Tech Mono"; color: fg.muted
                                     opacity: to.$i; show: atlas_tiles.$i.priv and dw.$i > 56 }
                    box { from: dx.$i, dy.$i; size: dw.$i, dh.$i; corner: max(g.radius.item - 3, 2); opacity: to.$i; stroke: if(car.$i or atlas_tiles.$i.mark or found.$i or picked.$i, 1.6, 1)
                          color: if(car.$i or picked.$i, focus.ring, if(atlas_tiles.$i.mark, fl.ember, if(found.$i, accent.primary, mix(border.subtle, accent.primary, otile.$i.hover)))) }
                    // marked: an ember corner notch, so it reads without its colour too
                    path { color: fl.ember; opacity: to.$i; show: atlas_tiles.$i.mark
                           move dx.$i, dy.$i; line dx.$i + 12, dy.$i; line dx.$i, dy.$i + 12; close }
                    // picked or selected: brackets set off its corners; on the canvas, its actions under it
                    group {
                        show: picked.$i
                        path { stroke: 2.2; color: focus.ring; move dx.$i - 5, dy.$i + 18; line dx.$i - 5, dy.$i - 5; line dx.$i + 18, dy.$i - 5 }
                        path { stroke: 2.2; color: focus.ring; move dx.$i + dw.$i - 18, dy.$i - 5; line dx.$i + dw.$i + 5, dy.$i - 5; line dx.$i + dw.$i + 5, dy.$i + 18 }
                        path { stroke: 2.2; color: focus.ring; move dx.$i - 5, dy.$i + dh.$i - 18; line dx.$i - 5, dy.$i + dh.$i + 5; line dx.$i + 18, dy.$i + dh.$i + 5 }
                        path { stroke: 2.2; color: focus.ring; move dx.$i + dw.$i + 5, dy.$i + dh.$i - 18; line dx.$i + dw.$i + 5, dy.$i + dh.$i + 5; line dx.$i + dw.$i - 18, dy.$i + dh.$i + 5 }
                    }
                    group {
                        show: picked.$i and ov_canvas and not car.$i
                        let ab.$i = dy.$i + dh.$i + 10
                        box { from: dx.$i, ab.$i; size: 248, 24; color: fl.hull; opacity: 0.96 }
                        box { from: dx.$i, ab.$i; size: 248, 24; stroke: 1; color: border.subtle }
                        zone box wfocus.$i { from: dx.$i, ab.$i; size: 62, 24; cursor: pointer; role: button; label: "Focus it" }
                        zone box wfloat.$i { from: dx.$i + 62, ab.$i; size: 62, 24; cursor: pointer; role: button; label: "Float or tile it" }
                        zone box wfull.$i { from: dx.$i + 124, ab.$i; size: 62, 24; cursor: pointer; role: button; label: "Fullscreen" }
                        zone box wclose.$i { from: dx.$i + 186, ab.$i; size: 62, 24; cursor: pointer; role: button; label: "Close it" }
                        box { from: dx.$i, ab.$i; size: 62, 24; color: selection.bg; opacity: 0.8 * wfocus.$i.hover }
                        box { from: dx.$i + 62, ab.$i; size: 62, 24; color: selection.bg; opacity: 0.8 * wfloat.$i.hover }
                        box { from: dx.$i + 124, ab.$i; size: 62, 24; color: selection.bg; opacity: 0.8 * wfull.$i.hover }
                        box { from: dx.$i + 186, ab.$i; size: 62, 24; color: selection.bg; opacity: 0.8 * wclose.$i.hover }
                        box { from: dx.$i + 62, ab.$i + 5; size: 1, 14; color: border.subtle }
                        box { from: dx.$i + 124, ab.$i + 5; size: 1, 14; color: border.subtle }
                        box { from: dx.$i + 186, ab.$i + 5; size: 1, 14; color: border.subtle }
                        text "FOCUS" { at: dx.$i + 31, ab.$i + 12; anchor: center; size: 10; family: "Share Tech Mono"; color: fg.secondary }
                        text "TILE" { at: dx.$i + 93, ab.$i + 12; anchor: center; size: 10; family: "Share Tech Mono"; color: fg.secondary; show: atlas_tiles.$i.floating }
                        text "FLOAT" { at: dx.$i + 93, ab.$i + 12; anchor: center; size: 10; family: "Share Tech Mono"; color: fg.secondary; show: not atlas_tiles.$i.floating }
                        text "FULL" { at: dx.$i + 155, ab.$i + 12; anchor: center; size: 10; family: "Share Tech Mono"; color: fg.secondary }
                        text "CLOSE" { at: dx.$i + 217, ab.$i + 12; anchor: center; size: 10; family: "Share Tech Mono"; color: fl.ember; show: ov_warm != i }
                        text "AGAIN" { at: dx.$i + 217, ab.$i + 12; anchor: center; size: 10; family: "Share Tech Mono"; color: fl.ember; show: ov_warm == i }
                        on press wfocus.$i while open == overview { emit ov_wact(i * 10) }
                        on press wfloat.$i while open == overview { emit ov_wact(i * 10 + 1) }
                        on press wfull.$i while open == overview { emit ov_wact(i * 10 + 2) }
                        on press wclose.$i while open == overview and ov_warm != i { ov_warm = i }
                        on press wclose.$i while open == overview and ov_warm == i { ov_warm = -1; emit ov_wact(i * 10 + 3) }
                    }
                    // a press is a click until the pointer travels 5 px either way; then it carries, held by
                    // where it was taken. Let go, the logic says where it lands — another workspace (it goes
                    // there), its own (placed or swapped, D45), or nowhere (it glides home). Released without
                    // carrying: in the grid it is gone to; on the canvas it is selected, and a double press goes.
                    on press otile.$i while open == overview and not atlas_busy and ov_mopen < 0 and cd_drag < 0 and ov_canvas and ov_tapgate.recent > 0.5 and ov_lastt == i { bd_press = -1; ov_zc = tk.$i; emit atlas_window(i); open = none }
                    on press otile.$i while open == overview and not atlas_busy and ov_mopen < 0 and cd_drag < 0 { bd_press = i; bd_ox = local.x - dx.$i; bd_oy = local.y - dy.$i; sp_hx = local.x; sp_hy = local.y; emit ov_tap; ov_lastt = i }
                    on drag otile.$i while bd_press == i and bd_drag < 0 and length(drag.dx, drag.dy) > 5 { bd_drag = i; sp_hx = local.x; sp_hy = local.y }
                    on drag otile.$i while bd_drag == i { sp_hx = local.x; sp_hy = local.y }
                    on release otile.$i while bd_drag == i { wx.$i: (sp_hx - bd_ox) / cam_z + cam_x ~0ms; wy.$i: (sp_hy - bd_oy) / cam_z + cam_y ~0ms
                                                              ov_px = sp_hx; ov_py = sp_hy; emit ov_drop_xy(i); bd_drag = -1; bd_press = -1 }
                    on release otile.$i while bd_drag < 0 and bd_press == i and not ov_canvas { bd_press = -1; ov_zc = tk.$i; emit atlas_window(i); open = none }
                    on release otile.$i while bd_drag < 0 and bd_press == i and ov_canvas { bd_press = -1; ov_win = i; ov_sel = tk.$i; ov_warm = -1 }
                    on press right otile.$i while open == overview and not atlas_busy and bd_drag < 0 { emit ov_menu_win(i) }
                    on press middle otile.$i while open == overview and not atlas_busy and bd_drag < 0 and ov_mopen < 0 { emit ov_close(i) }
                    // its territory set down elsewhere: it lands with it, not from where it was
                    on ov_land(v) while tk.$i == v { wx.$i: (sp_hx - cd_ox) / cam_z + cam_x + atlas_tiles.$i.fx * atlas_tiles.$i.tw ~0ms
                                                     wy.$i: (sp_hy - cd_oy) / cam_z + cam_y + atlas_tiles.$i.fy * atlas_tiles.$i.th ~0ms }
                }
            }

            // ── the active workspace: in the grid a border sliding to it; on the canvas its territory is lit
            box { from: (ov_ax - cam_x) * cam_z - 1, (ov_ay - cam_y) * cam_z - 1; size: ov_aww * cam_z + 2, ov_awh * cam_z + 2; corner: (g.radius.item + 1) * ov_z; stroke: 2; color: accent.primary
                  show: ov_act >= 0 and not ov_canvas; opacity: if(ov_act == ov_zc and ov_z < 0.999, clamp(ov_z * 2 - 1, 0, 1), ov_oa) }

            // ── over each workspace: in the grid its number, name, accent, group and monitor; on the
            // canvas a nameplate over its top edge — "01 / NAME · 3 WINDOWS", its group, carried to move it
            repeat k in 0..18 {
                let lx.$k = if(cd_drag == k, sp_hx - cd_ox, (tx.$k - cam_x) * cam_z)
                let ly.$k = if(cd_drag == k, sp_hy - cd_oy, (ty.$k - cam_y) * cam_z)
                let lw.$k = ov_cells.$k.tw * cam_z
                let lh.$k = ov_cells.$k.th * cam_z
                let gc.$k = if(ov_cells.$k.gacc == 2, 2, if(ov_cells.$k.gacc == 1, 1, 0))
                group {
                    show: k < ov_cells.count
                    z: if(cd_drag == k, 9, 0)
                    opacity: if(ov_canvas, ov_oa, ov_oa * ov_oa) * if(ov_searching and not ov_cells.$k.hit, 0.45, 1)
                    move: 0, if(ov_canvas, 0, ov_slide)
                    // ·· the grid's labels
                    group {
                        show: not ov_canvas
                        box { from: lx.$k + 10, ly.$k - 1; size: min(lw.$k * 0.3, 90), 2; color: if(ov_cells.$k.acc == 2, fl.ember, fl.phos); show: ov_cells.$k.acc > 0 }
                        box { from: lx.$k + 6, ly.$k + 6; size: 24, 16; corner: 4; color: bg.primary; opacity: 0.85; show: ov_cells.$k.windows > 0 or ov_cells.$k.acc > 0 or ov_cells.$k.named }
                        text "{ov_cells.$k.id}" { at: lx.$k + 18, ly.$k + 14; anchor: center; size: 10; weight: 700; family: "Share Tech Mono"
                                                  color: if(ov_cells.$k.acc == 2, fl.ember, if(ov_cells.$k.acc == 1, fl.phos, if(ov_cells.$k.active, accent.primary, fg.primary)))
                                                  show: ov_cells.$k.windows > 0 or ov_cells.$k.acc > 0 or ov_cells.$k.named }
                        group {
                            show: ov_cells.$k.named and not (ov_naming and ov_sel == k)
                            box { from: lx.$k + 33, ly.$k + 6; size: min(lw.$k - 42, 150), 16; corner: 4; color: bg.primary; opacity: 0.85 }
                            text ov_cells.$k.name { at: lx.$k + 39, ly.$k + 14; anchor: left center; size: 10; color: fg.primary; width: min(lw.$k - 54, 138); lines: 1 }
                        }
                        group {
                            show: ov_cells.$k.grp >= 0
                            box { from: lx.$k + 4, ly.$k + lh.$k + 1.5; size: lw.$k - 8 + if(ov_cells.$k.glink, ov_gap + 8, 0), 3
                                  color: if(gc.$k == 2, fl.ember, if(gc.$k == 1, fl.phos, fg.muted)) }
                            group {
                                show: ov_cells.$k.gfirst
                                box { from: lx.$k + 6, ly.$k + lh.$k - 22; size: min(lw.$k - 12, 130), 16; corner: 4; color: bg.primary; opacity: 0.85 }
                                box { from: lx.$k + 6, ly.$k + lh.$k - 22; size: 2, 16; color: if(gc.$k == 2, fl.ember, if(gc.$k == 1, fl.phos, fg.muted)) }
                                text ov_cells.$k.gname { at: lx.$k + 13, ly.$k + lh.$k - 14; anchor: left center; size: 9.5; family: "Share Tech Mono"
                                                         color: if(gc.$k == 2, fl.ember, if(gc.$k == 1, fl.phos, fg.secondary)); width: min(lw.$k - 26, 116); lines: 1 }
                            }
                        }
                    }
                    // ·· the canvas's nameplate: its handle
                    group {
                        show: ov_canvas
                        let np.$k = min(max(lw.$k * 0.6, 150), 320)
                        zone box ovh.$k { from: lx.$k, ly.$k - 26; size: np.$k, 20; cursor: move; role: button; label: "Workspace {ov_cells.$k.id} — carry it to move it" }
                        box { from: lx.$k, ly.$k - 26; size: np.$k, 20; corner: min(g.radius.item, 6); color: fl.hull; opacity: 0.92 }
                        box { from: lx.$k, ly.$k - 26; size: np.$k, 20; corner: min(g.radius.item, 6); stroke: 1; color: if(cd_drag == k or ovh.$k.hover > 0.5, accent.primary, border.subtle) }
                        // the active one's marker, lit (the theme's glow: none while the battery saver is on)
                        group {
                            glow: 6, (if(ov_cells.$k.active, 0.8, 0)) * st_glow, accent.primary
                            box { from: lx.$k, ly.$k - 26; size: 3, 20; color: if(ov_cells.$k.active, accent.primary, if(ov_cells.$k.acc == 2, fl.ember, if(ov_cells.$k.acc == 1, fl.phos, fl.trace))) }
                        }
                        text "{ov_cells.$k.label}" { at: lx.$k + 10, ly.$k - 16; anchor: left center; size: 10; weight: 600; family: "Share Tech Mono"; width: np.$k - 16; lines: 1
                                                     color: if(ov_cells.$k.active, accent.primary, fg.primary) }
                        text "{ov_cells.$k.sub}" { at: lx.$k + np.$k - 8, ly.$k - 16; anchor: right center; size: 10; family: "Share Tech Mono"; color: fl.muted; show: np.$k > 190 }
                        // its group: a rule under it in the group's colour, the group's name at its foot
                        group {
                            show: ov_cells.$k.grp >= 0
                            box { from: lx.$k, ly.$k + lh.$k + 4; size: lw.$k, 2; color: if(gc.$k == 2, fl.ember, if(gc.$k == 1, fl.phos, fg.muted)) }
                            text ov_cells.$k.gname { at: lx.$k, ly.$k + lh.$k + 16; anchor: left center; size: 9; family: "Share Tech Mono"
                                                     color: if(gc.$k == 2, fl.ember, if(gc.$k == 1, fl.phos, fg.secondary)); show: lw.$k > 140 }
                        }
                        text "NOT OPENED YET" { at: lx.$k + lw.$k / 2, ly.$k + lh.$k / 2 + 30; anchor: center; size: 10; family: "Share Tech Mono"; color: fl.muted
                                                      show: not ov_cells.$k.exists and lw.$k > 160 }
                        on press ovh.$k while open == overview and bd_drag < 0 and cd_drag < 0 and ov_mopen < 0 { cd_press = k; cd_ox = local.x - lx.$k; cd_oy = local.y - ly.$k; sp_hx = local.x; sp_hy = local.y; ov_sel = k }
                        on drag ovh.$k while cd_press == k and cd_drag < 0 and length(drag.dx, drag.dy) > 4 { cd_drag = k; sp_hx = local.x; sp_hy = local.y }
                        on drag ovh.$k while cd_drag == k { sp_hx = local.x; sp_hy = local.y }
                        on release ovh.$k while cd_drag == k { tx.$k: (sp_hx - cd_ox) / cam_z + cam_x ~0ms; ty.$k: (sp_hy - cd_oy) / cam_z + cam_y ~0ms
                                                               ov_px = sp_hx - cd_ox; ov_py = sp_hy - cd_oy; emit ov_land(k); emit ov_place(k)
                                                               cd_drag = -1; cd_press = -1 }
                        on release ovh.$k while cd_drag < 0 and cd_press == k { cd_press = -1 }
                        on press right ovh.$k while open == overview and bd_drag < 0 { ov_sel = k; ov_win = -1; emit ov_menu_open(k) }
                    }
                    // several monitors (D44)
                    group {
                        show: ov_multi and ov_cells.$k.monned and lw.$k > 140
                        text "ON {ov_cells.$k.mon}" { at: lx.$k + lw.$k - 8, ly.$k + lh.$k - 12; anchor: right center; size: 10; family: "Share Tech Mono"
                                                      color: accent.secondary; show: ov_cells.$k.elsewhere }
                        text "{ov_cells.$k.mon}" { at: lx.$k + lw.$k - 8, ly.$k + lh.$k - 12; anchor: right center; size: 10; family: "Share Tech Mono"
                                                   color: fl.muted; show: not ov_cells.$k.elsewhere }
                        box { from: lx.$k + 2, ly.$k + 2; size: lw.$k - 4, lh.$k - 4; corner: 5; stroke: 1.6; color: accent.secondary; show: ov_cells.$k.elsewhere }
                    }
                    // the keyboard's workspace: four brackets set off its corners
                    group {
                        show: ov_sel == k and open == overview
                        path { stroke: 1.6; color: focus.ring; move lx.$k - 4, ly.$k + 14; line lx.$k - 4, ly.$k - 4; line lx.$k + 14, ly.$k - 4 }
                        path { stroke: 1.6; color: focus.ring; move lx.$k + lw.$k - 14, ly.$k - 4; line lx.$k + lw.$k + 4, ly.$k - 4; line lx.$k + lw.$k + 4, ly.$k + 14 }
                        path { stroke: 1.6; color: focus.ring; move lx.$k - 4, ly.$k + lh.$k - 14; line lx.$k - 4, ly.$k + lh.$k + 4; line lx.$k + 14, ly.$k + lh.$k + 4 }
                        path { stroke: 1.6; color: focus.ring; move lx.$k + lw.$k - 14, ly.$k + lh.$k + 4; line lx.$k + lw.$k + 4, ly.$k + lh.$k + 4; line lx.$k + lw.$k + 4, ly.$k + lh.$k - 14 }
                    }
                }
            }

            // ── the search row: on the grid's plate, or floating over the canvas's top
            let srw = if(ov_canvas, 680, ov_pw)
            let srx = if(ov_canvas, ov_W / 2 - 340, ov_gx)
            let sry = if(ov_canvas, ov_top + 34, ov_gy - 30)
            group {
                opacity: ov_oa
                move: 0, ov_slide
                body {
                    gradient: 0, sry - 18 to 0, sry + 18, surface.elevated, surface.primary 40%, bg.primary
                    border: 1, border.subtle
                    shadow: 0, 4, 16, 34%
                    show: ov_canvas
                    box { from: srx - 10, sry - 18; size: srw + 20, 36; corner: g.radius.item }
                }
                box { from: srx + 4, sry - 19; size: 48, 2; color: fl.phos; show: ov_canvas }
                ellipse { at: srx + 12, sry; radius: 5.5; stroke: 1.5; color: if(ov_searching, accent.primary, fg.secondary) }
                line { from: srx + 16, sry + 4; to: srx + 20, sry + 8; width: 1.5; color: if(ov_searching, accent.primary, fg.secondary) }
                input ov_q { at: srx + 30, sry; width: srw - 210; size: 13; color: fg.primary; selection: selection.bg
                             placeholder: "Search windows and workspaces, or type a number"; label: "Search the Overview" }
                text ov_found { at: srx + srw - 4, sry; anchor: right center; size: 10; family: "Share Tech Mono"
                                color: if(ov_nfound > 0, accent.primary, fl.ember); show: ov_searching }
                zone box envbtn { from: srx + srw - 176, sry - 11; size: 176, 22; corner: 4; cursor: pointer; role: button
                                  label: "Environments"; active: not ov_searching }
                box { from: srx + srw - 176, sry - 11; size: 176, 22; corner: 4; color: mix(fl.hull, fg.primary, 0.06 + 0.06 * envbtn.hover); show: not ov_searching }
                text "ENVIRONMENTS · CTRL+E" { at: srx + srw - 88, sry; anchor: center; size: 10; family: "Share Tech Mono"
                                              color: if(env_open > 0, accent.primary, fl.muted); show: not ov_searching }
                on press envbtn while open == overview and ov_mopen < 0 { emit env_toggle }
            }

            // ── the name field, over the keyboard's workspace (its nameplate on the canvas)
            let nx = (ov_nwx - cam_x) * cam_z
            let ny = (ov_nwy - cam_y) * cam_z
            let nw = ov_nww * cam_z
            group {
                show: ov_naming and open == overview
                box { from: nx + if(ov_canvas, 0, 33), ny + if(ov_canvas, -28, 4); size: if(ov_canvas, 260, min(nw - 40, 200)), 22; corner: 4; color: bg.primary }
                box { from: nx + if(ov_canvas, 0, 33), ny + if(ov_canvas, -28, 4); size: if(ov_canvas, 260, min(nw - 40, 200)), 22; corner: 4; stroke: 1.4; color: fl.phos }
                input ov_name { at: nx + if(ov_canvas, 8, 40), ny + if(ov_canvas, -17, 15); width: if(ov_canvas, 244, min(nw - 54, 184)); size: 10.5; color: fg.primary
                                selection: selection.bg; placeholder: "Name"; label: "Workspace name" }
            }

            // ── the hint line: in the grid's plate, at the canvas's foot
            let hy = if(ov_canvas, ov_H - 26, ov_gy + ov_ph + 17)
            let hx = ov_W / 2
            group {
                opacity: if(ov_canvas, ov_oa, ov_oa * ov_oa)
                move: 0, if(ov_canvas, 0, ov_slide)
                text "TYPE TO SEARCH · ENTER GOES · TAB ↑↓ WORKSPACES · ALT+↑↓ A WINDOW · CTRL+M MARK · MENU OR RIGHT-CLICK ACTIONS · F2 NAME · CTRL+Z UNDO · ESC BACK" {
                     at: hx, hy; anchor: center; size: 10; family: "Share Tech Mono"; color: fl.muted
                     show: not ov_said and ov_nmark == 0 and not ov_naming and not ov_canvas }
                text "DRAG THE FIELD TO PAN · WHEEL ZOOMS · DOUBLE-CLICK THE FIELD: A NEW WORKSPACE · CARRY A NAMEPLATE TO MOVE IT · CLICK A WINDOW: ITS ACTIONS · CTRL+F FIT · ESC BACK" {
                     at: ov_W / 2 - 150, hy; anchor: center; size: 10; family: "Share Tech Mono"; color: fl.muted
                     show: not ov_said and ov_nmark == 0 and not ov_naming and ov_canvas }
                text "{ov_nmark} MARKED · CARRY ONE OF THEM, OR MENU › MOVE HERE, TO MOVE THEM ALL · ESC CLEARS" {
                     at: hx, hy; anchor: center; size: 10; family: "Share Tech Mono"; color: fl.ember
                     show: not ov_said and ov_nmark > 0 and not ov_naming }
                text "NAME THIS WORKSPACE · ENTER KEEPS IT · EMPTY CLEARS IT · ESC LEAVES IT AS IT WAS" {
                     at: hx, hy; anchor: center; size: 10; family: "Share Tech Mono"; color: fl.phos; show: ov_naming and not ov_naming_group }
                text "NAME THE GROUP · ENTER KEEPS IT · ESC LEAVES IT" {
                     at: hx, hy; anchor: center; size: 10; family: "Share Tech Mono"; color: fl.phos; show: ov_naming_group }
                text ov_msg { at: hx, hy; anchor: center; size: 10; family: "Share Tech Mono"; color: if(ov_ok, fl.phos, fl.ember)
                              show: ov_said and not ov_naming }
            }

            // ── the canvas's navigation instrument, bottom right: zoom out, how near, zoom in, fit all,
            // back to the workspace you are on
            group {
                show: ov_canvas
                opacity: ov_oa
                let nvx = ov_W - 300
                let nvy = ov_H - 40
                body {
                    gradient: 0, nvy to 0, nvy + 26, surface.elevated, surface.primary 40%, bg.primary
                    border: 1, border.subtle
                    shadow: 0, 4, 16, 34%
                    box { from: nvx, nvy; size: 276, 26; corner: g.radius.item }
                }
                repeat b in 0..5 {
                    let bx.$b = nvx + pick(b, 0, 36, 108, 144, 204)
                    let bw.$b = pick(b, 36, 72, 36, 60, 72)
                    zone box nav.$b { from: bx.$b, nvy; size: bw.$b, 26; cursor: pointer; role: button; active: b != 1
                                      label: "The canvas's navigation, {b}" }
                    box { from: bx.$b, nvy; size: bw.$b, 26; color: selection.bg; opacity: 0.8 * nav.$b.hover }
                    box { from: bx.$b + bw.$b, nvy + 5; size: 1, 16; color: border.subtle; show: b < 4 }
                }
                text "−" { at: nvx + 18, nvy + 13; anchor: center; size: 14; color: fg.secondary }
                text "{round(cam_z * 100)}%" { at: nvx + 72, nvy + 13; anchor: center; size: 10; family: "Share Tech Mono"; color: accent.primary }
                text "+" { at: nvx + 126, nvy + 13; anchor: center; size: 14; color: fg.secondary }
                text "FIT" { at: nvx + 174, nvy + 13; anchor: center; size: 10; family: "Share Tech Mono"; color: fg.secondary }
                text "HERE" { at: nvx + 240, nvy + 13; anchor: center; size: 10; family: "Share Tech Mono"; color: fg.secondary }
                on press nav.0 while open == overview { ov_cx = ov_cx + ov_W / 2 / ov_cz - ov_W / 2 / clamp(ov_cz / 1.4, 0.03, 1.5); ov_cy = ov_cy + ov_H / 2 / ov_cz - ov_H / 2 / clamp(ov_cz / 1.4, 0.03, 1.5); ov_cz = clamp(ov_cz / 1.4, 0.03, 1.5) }
                on press nav.2 while open == overview { ov_cx = ov_cx + ov_W / 2 / ov_cz - ov_W / 2 / clamp(ov_cz * 1.4, 0.03, 1.5); ov_cy = ov_cy + ov_H / 2 / ov_cz - ov_H / 2 / clamp(ov_cz * 1.4, 0.03, 1.5); ov_cz = clamp(ov_cz * 1.4, 0.03, 1.5) }
                on press nav.3 while open == overview { ov_cx = ov_fx; ov_cy = ov_fy; ov_cz = ov_fz }
                on press nav.4 while open == overview { emit ov_here }
            }

            // ── a workspace's actions, beside it: a housing, a row each, the chosen one bracketed; a press
            // anywhere else puts it away
            zone box ov_mout { from: 0, 0; size: ov_W, ov_H; role: region; label: "Put the menu away"; active: ov_mopen >= 0 }
            on press ov_mout while ov_mopen >= 0 { ov_mopen = -1 }
            let ov_mw = 230
            let ov_mcx = (ov_mwx - cam_x) * cam_z
            let ov_mcw = ov_mww * cam_z
            let ov_mx = if(ov_mcx + ov_mcw + 8 + ov_mw < ov_W, ov_mcx + ov_mcw + 8, max(ov_mcx - 8 - ov_mw, 8))
            let ov_my = clamp((ov_mwy - cam_y) * cam_z, ov_top + 8, ov_H - 30 - ov_menu.count * 28 - 10)
            group {
                show: ov_mopen >= 0 and open == overview
                body {
                    gradient: 0, ov_my to 0, ov_my + 30 + ov_menu.count * 28, surface.elevated, surface.primary 40%, bg.primary
                    border: 1, border.subtle
                    shadow: 0, 6, 22, 38%
                    box { from: ov_mx, ov_my; size: ov_mw, 30 + ov_menu.count * 28; corner: g.radius }
                }
                box { from: ov_mx + 12, ov_my - 1; size: 40, 2; color: fl.phos }
                text ov_mtitle { at: ov_mx + 12, ov_my + 15; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.muted }
                repeat j in 0..8 {
                    let ry.$j = ov_my + 26 + j * 28
                    group {
                        show: j < ov_menu.count
                        zone box mrow.$j { from: ov_mx + 4, ry.$j; size: ov_mw - 8, 26; corner: 4; cursor: pointer; role: item; selected: ov_msel == j
                                           label: "{ov_menu.$j.label}" }
                        box { from: ov_mx + 4, ry.$j; size: ov_mw - 8, 26; corner: g.radius.item; color: selection.bg; opacity: if(ov_msel == j, 0.9, 0) }
                        box { from: ov_mx + 4, ry.$j + 6; size: 2, 14; color: if(ov_menu.$j.danger, fl.ember, accent.primary); show: ov_msel == j }
                        text ov_menu.$j.label { at: ov_mx + 16, ry.$j + 13; anchor: left center; size: 11.5; width: ov_mw - 28; lines: 1
                                                color: if(ov_menu.$j.danger, fl.ember, fg.primary) }
                        on enter mrow.$j while ov_mopen >= 0 { ov_msel = j }
                        on press mrow.$j while ov_mopen >= 0 { emit ov_menu_do(j) }
                    }
                }
            }

            // ── Saved environments (D43): a drawer — over the grid's plate on its right, or down the
            // canvas's right side — the list, one environment's page, or what restoring it would do
            let ov_ew = 384
            let ov_ex = if(ov_canvas, ov_W - ov_ew - 24, ov_gx + ov_pw - ov_ew)
            let ov_ey = if(ov_canvas, ov_top + 64, ov_gy)
            let ov_eh = if(ov_canvas, ov_H - ov_top - 64 - 56, ov_ph)
            let ov_elh = if(env_open == 3, env_lines.count * 19 + 10, 0)          // the plan's lines, above the rows
            let ov_erh = if(env_open == 1, 40, 30)                                 // a row: a name and what it holds, or one line
            let ov_evis = max(floor((ov_eh - 44 - ov_elh - if(env_naming, 34, 0)) / ov_erh), 1)
            let ov_eoff = max(env_sel - ov_evis + 1, 0)                            // rows scroll to keep the chosen one in view
            let ov_ery = ov_ey + 36 + ov_elh + if(env_naming, 34, 0)
            group {
                show: env_open > 0 and open == overview
                zone box envbox { from: ov_ex, ov_ey; size: ov_ew, ov_eh; role: region; label: "Environments" }
                body {
                    gradient: 0, ov_ey to 0, ov_ey + ov_eh, surface.elevated, surface.primary 40%, bg.primary
                    border: 1, border.subtle
                    shadow: 0, 6, 22, 38%
                    box { from: ov_ex, ov_ey; size: ov_ew, ov_eh; corner: g.radius }
                }
                box { from: ov_ex + 12, ov_ey - 1; size: 48, 2; color: fl.phos }
                text env_title { at: ov_ex + 14, ov_ey + 18; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.muted; width: ov_ew - 120; lines: 1 }
                text "ESC BACK" { at: ov_ex + ov_ew - 14, ov_ey + 18; anchor: right center; size: 10; family: "Share Tech Mono"; color: fl.muted }
                // the plan
                repeat j in 0..14 {
                    text env_lines.$j.text { at: ov_ex + 16, ov_ey + 44 + j * 19; anchor: left center; size: 11; width: ov_ew - 32; lines: 1
                                             color: if(env_lines.$j.tone == 1, fg.primary, if(env_lines.$j.tone == 2, fl.ember, fl.muted))
                                             show: env_open == 3 and j < env_lines.count }
                    box { from: ov_ex + 10, ov_ey + 38 + j * 19; size: 2, 12; color: accent.primary; show: env_open == 3 and j < env_lines.count and env_lines.$j.tone == 1 }
                }
                // the name field
                group {
                    show: env_naming
                    box { from: ov_ex + 10, ov_ey + 34 + ov_elh; size: ov_ew - 20, 26; corner: 4; color: bg.primary }
                    box { from: ov_ex + 10, ov_ey + 34 + ov_elh; size: ov_ew - 20, 26; corner: 4; stroke: 1.4; color: fl.phos }
                    input env_name { at: ov_ex + 20, ov_ey + 47 + ov_elh; width: ov_ew - 40; size: 12; color: fg.primary; selection: selection.bg
                                     placeholder: "Name it, then Enter"; label: "Environment name" }
                }
                // the rows
                repeat j in 0..24 {
                    let ey.$j = ov_ery + (j - ov_eoff) * ov_erh
                    group {
                        show: j < env_rows.count and j >= ov_eoff and j < ov_eoff + ov_evis
                        zone box erow.$j { from: ov_ex + 6, ey.$j; size: ov_ew - 12, ov_erh - 4; corner: 4; cursor: pointer; role: item; selected: env_sel == j
                                           label: "{env_rows.$j.label}" }
                        box { from: ov_ex + 6, ey.$j; size: ov_ew - 12, ov_erh - 4; corner: g.radius.item; color: selection.bg; opacity: if(env_sel == j, 0.9, 0.35 * erow.$j.hover) }
                        box { from: ov_ex + 6, ey.$j + 6; size: 2, ov_erh - 16; color: if(env_rows.$j.danger, fl.ember, accent.primary); show: env_sel == j }
                        text env_rows.$j.label { at: ov_ex + 18, ey.$j + if(env_open == 1, 12, (ov_erh - 4) / 2); anchor: left center; size: 12; width: ov_ew - 40; lines: 1
                                                 color: if(env_rows.$j.danger, fl.ember, fg.primary) }
                        text env_rows.$j.sub { at: ov_ex + 18, ey.$j + 27; anchor: left center; size: 9.5; family: "Share Tech Mono"; width: ov_ew - 40; lines: 1
                                               color: fl.muted; show: env_open == 1 }
                        on enter erow.$j while env_open > 0 { env_sel = j }
                        on press erow.$j while env_open > 0 { env_sel = j; emit env_do(j) }
                    }
                }
            }
        }
    }

    // ══ The Mechanical Shutter ═══════════════════════════════
    // A window's controls, unfolding from its edge (D35): a bracket on the window's corner, an
    // angular track out of it, four plates down the track, a panel sliding straight out of the plate
    // that is open and, where a choice needs it, a third level out of its row. Linear and angular,
    // never round. One copy per monitor, drawn on the window's own. While it is out, a press anywhere
    // else puts it away (an all-but-clear sheet takes that press) — and nothing else of the desktop
    // is touched.
    surface shutter_surface {
        size: full, full
        anchor: top
        level: overlay
        reserve: -1
        screens: each
        open: open == shutter or sh_d > 0.004

        group {
            show: screen.index == sh_moni
            box { from: 0, 0; size: screen.width, screen.height; color: #000000; opacity: 0.01 }
            zone box sh_out { from: 0, 0; size: screen.width, screen.height; role: region; label: "Put the shutter away" }
            on press sh_out while open == shutter { emit sh_close }

            let ka = clamp(sh_d * 3, 0, 1)                   // the anchor answers first
            let n1 = max(sh_n - 1, 0)
            let last_y = sh_py + n1 * (sh_ph + sh_pgap) + sh_ph / 2
            let act_y = sh_py + max(sh_plate, 0) * (sh_ph + sh_pgap) + sh_ph / 2
            let ty = sh_ay + 8                                // the track leaves the corner here
            let stub_x = if(sh_spine < sh_px, sh_px, sh_px + sh_pw)
            let run_y = ty + (last_y - ty) * clamp(sh_d * 1.25, 0, 1)

            // the anchor: a bracket on the window's corner, and a node where the track leaves it
            group {
                opacity: ka
                glow: 5, (0.6) * st_glow, fl.phos
                path { stroke: 1.6; color: fl.phos
                       move sh_ax - 14 * if(sh_side == 1, -1, 1), sh_ay; line sh_ax, sh_ay; line sh_ax, sh_ay + 14 }
                box { at: sh_ax, ty; size: 5, 5; color: fl.phos }
            }
            // the track: out of the corner, a right angle, down the column; a stub to each plate
            line { from: sh_ax, ty; to: sh_spine, ty; width: 1.2; color: fl.trace; opacity: ka }
            line { from: sh_spine, ty; to: sh_spine, run_y; width: 1.2; color: fl.trace }
            repeat k in 0..4 {
                let sy.$k = sh_py + k * (sh_ph + sh_pgap) + sh_ph / 2
                line { from: sh_spine, sy.$k; to: stub_x, sy.$k; width: 1.2; color: fl.trace; show: k < sh_n and run_y >= sy.$k - 1 }
                box { at: sh_spine, sy.$k; size: 4, 4; color: fl.trace_lit; show: k < sh_n and run_y >= sy.$k - 1 }
            }
            // the live path: corner → down → the plate the keyboard (or the open panel) is on
            group {
                show: sh_d > 0.9
                glow: 5, (0.7) * st_glow, fl.phos
                line { from: sh_ax, ty; to: sh_spine, ty; width: 1.6; color: fl.phos }
                line { from: sh_spine, ty; to: sh_spine, act_y; width: 1.6; color: fl.phos }
                line { from: sh_spine, act_y; to: stub_x, act_y; width: 1.6; color: fl.phos }
            }

            // the plates, each sliding down the track to its place, a beat after the one above
            for pl in sh_plates {
                let kk = clamp(sh_d * (1 + 0.16 * n1) - pl.index * 0.16, 0, 1)
                let slide = (1 - kk) * (pl.index * (sh_ph + sh_pgap) + sh_ph)
                ShPlate(pl, sh_px, sh_py + pl.index * (sh_ph + sh_pgap) - slide, sh_pw, sh_ph,
                        sh_plate == pl.index and sh_panel < 0, sh_panel == pl.index, kk, sh_pick, sh_hover)
            }

            // the panel: a bridge from its plate, then the housing sliding out of that side
            group {
                show: sh_p > 0.01 and sh_panel >= 0
                let py = sh_py + sh_panel * (sh_ph + sh_pgap) + sh_ph / 2
                let near = if(sh_brx > 0, sh_px + sh_pw, sh_px)
                let far = if(sh_brx > 0, sh_bx, sh_bx + sh_bw)
                group {
                    glow: 5, (0.7) * st_glow, fl.phos
                    line { from: near, py; to: near + (far - near) * sh_p, py; width: 1.6; color: fl.phos }
                }
                group {
                    opacity: sh_p
                    move: (1 - sh_p) * -14 * sh_brx, 0
                    clip box { from: if(sh_brx > 0, sh_bx, sh_bx + sh_bw * (1 - sh_p)), sh_by - 2; size: sh_bw * sh_p + 2, sh_bh + 4 }
                    ShHousing(sh_bx, sh_by, sh_bw, sh_bh, pick(max(sh_panel, 0), "ARRANGE", "WORKSPACE", "BEHAVIOUR", "CONNECTIONS"), sh_brx > 0)
                    text sh_title { at: sh_bx + sh_bw - 12, sh_by + 15; anchor: right center; size: 10; family: "Share Tech Mono"; color: fl.muted; width: 110; lines: 1; align: right }
                    for r in sh_rows { ShRow(r, sh_bx + 2, sh_by + 30, sh_bw - 4, sh_row_h, sh_row == r.index and not sh_ext, sh_row) }
                }
            }

            // the third level, out of its row
            group {
                show: sh_e > 0.01 and sh_ext
                opacity: sh_e
                move: (1 - sh_e) * -10 * sh_brx, 0
                ShHousing(sh_ex, sh_ey, sh_ew, sh_eh, "CHOOSE", sh_ex > sh_bx)
                for it in sh_items { ShItem(it, sh_ex + 2, sh_ey + 30, sh_ew - 4, sh_esel == it.index, sh_item) }
            }

            // what happened, under the column
            text sh_msg { at: sh_px, last_y + sh_ph / 2 + 16; anchor: left center; size: 10; family: "Share Tech Mono"
                          color: if(sh_ok, fl.phos, fl.ember); opacity: sh_m * sh_d; width: 300; lines: 1 }
        }
    }

    // ══ Command membrane ══════════════════════════════════════
    // Fixed at the top centre. Compact it is a field; it grows as results arrive, and a
    // window result opens its satellite actions inline (Tab, or the ⋯ on the row).


    // One result. A window's row opens to show its satellite actions.
    // A weather glyph of kind `k` (lib/sysinfo WEATHER_KINDS: clear, night, cloud, fog, rain, snow,
    // storm) centred at (x, y), `sz` across; the sun and the storm keep their colours.
    component WxGlyph(x: number, y: number, sz: number, k: number) {
        size: sz, sz
        figure i_clear { at: x, y; size: sz, sz; color: fl.flare; show: k < 0.5 }
        figure i_night { at: x, y; size: sz, sz; color: if(isl_style > 0.5, fg.primary, fl.phos); show: k > 0.5 and k < 1.5 }
        figure i_cloud { at: x, y; size: sz, sz; color: if(isl_style > 0.5, fg.primary, fl.phos); show: k > 1.5 and k < 2.5 }
        figure i_fog { at: x, y; size: sz, sz; color: if(isl_style > 0.5, fg.primary, fl.phos); show: k > 2.5 and k < 3.5 }
        figure i_rain { at: x, y; size: sz, sz; color: if(isl_style > 0.5, fg.primary, fl.phos); show: k > 3.5 and k < 4.5 }
        figure i_snow { at: x, y; size: sz, sz; color: if(isl_style > 0.5, fg.primary, fl.phos); show: k > 4.5 and k < 5.5 }
        figure i_storm { at: x, y; size: sz, sz; color: fl.ember; show: k > 5.5 }
    }

    component CRow(r: record) {
        let mine = csel == r.index
        let open_row = mine and cmode == actions and r.kind == win
        prop lit = 0 ~m.select
        follow lit = if(mine, 1, 0)
        prop ex = 0 ~m.expand
        follow ex = if(open_row, 1, 0)
        size: 560, 44 + 46 * (csel == r.index and cmode == actions and r.kind == win)   // the list spring moves the rows below

        zone box hit { from: 0, 0; size: 560, 44; corner: g.radius.item; cursor: pointer; label: "{r.title}"; selected: mine }
        box { from: 0, 0; size: 560, 44 + 46 * ex; corner: g.radius.item; color: selection.bg; opacity: lit * 80% }
        box { from: 0, 12; size: 2, 20; corner: 1; color: accent.primary; opacity: lit }
        image r.icon { at: 14, 12; size: 20, 20 }
        text "{upper(r.letter)}" { at: 24, 22; anchor: center; size: 12; weight: 700; color: fg.secondary }
        text r.title { at: 46, 15; anchor: left center; size: 13; width: 420; lines: 1; color: fg.primary }
        text r.sub { at: 46, 31; anchor: left center; size: 10; width: 420; lines: 1; color: fg.secondary }
        text pick(r.kind, "App", "Window", "Workspace", "mooi") { at: 548, 22; anchor: right center; size: 10; color: fg.muted; show: r.kind != win }

        zone box more { at: 538, 22; size: 28, 28; corner: 6; cursor: pointer; show: r.kind == win; label: "Actions for {r.title}" }
        box { at: 538, 22; size: 28, 28; corner: 6; color: surface.elevated; opacity: more.hover; show: r.kind == win }
        repeat d in 0..3 { ellipse { at: 532 + d * 6, 22; radius: 1.6; color: fg.secondary; show: r.kind == win } }

        on enter hit while cmode == list { csel = r.index }
        on press hit { csel = r.index; cmode = list; emit crun(r.index) }
        on press more { csel = r.index; cmode = actions; asel = 0; carming = false; blur }

        // Satellite actions for this window: 0 focus · 1 bring here · 2 float · 3 fullscreen · 4 close
        group {
            show: ex > 0.02
            opacity: ex
            repeat a in 0..5 {
                group {
                    move: 46 + a * 102, 50
                    let on_a = mine and asel == a
                    zone box chip.$a { from: 0, 0; size: 96, 32; corner: 6; cursor: pointer; active: cmode == actions and mine and not busy
                                       label: pick(a, "Focus", "Bring here", "Float", "Fullscreen", "Close window") }
                    BtnFace(96, 32, chip.$a.hover, on_a, if(a == 4 and carming, 1, 0))
                    text pick(a * 2 + if(a == 4, carming, 0), "Focus", "Focus", "Bring here", "Bring here", "Float", "Float", "Fullscreen", "Fullscreen", "Close", "Sure?") {
                        at: 48, 16; anchor: center; size: 11; color: if(a == 4 and carming, accent.secondary, fg.primary) }
                    on press chip.$a { asel = a; emit csat_try(a) }
                }
            }
        }

        on key Tab while open == command and cmode == list and mine and r.kind == win { cmode = actions; asel = 0; carming = false; blur }
    }

    // ── Rules: user intent → the slot ─────────────────────────
    on open_window while open == window { open = none }
    // target_ok first: the logic reads the window when `open` turns, and only if it has none
    on open_window while open != window { target_ok = false; phase = compact; sel = 0; arming = false; mark_open = false; open = window }
    on open_system while open == system { open = none }
    on open_system while open != system { open = system; phase = compact; mark_open = false }
    on open_command while open == command { open = none; blur }
    on open_command while open != command { open = command; cmode = list; csel = 0; carming = false; blur; mark_open = false; focus query }

    // Escape: the topmost thing goes first.
    on key Escape while open == window and phase == expanded            { phase = compact }
    on key Escape while open == window and phase == compact and arming  { arming = false }
    on key Escape while open == window and phase == compact and not arming { open = none }
    on key Escape while open == system                                  { open = none }
    on change open while open == none { isl_shelf = false; shelf_pin = false }
    on key Left while open == calendar  { emit cal_shift(0) }
    on key Right while open == calendar { emit cal_shift(2) }
    on key Home while open == calendar  { emit cal_shift(1) }
    on key Escape while open == stats or open == calendar or open == weather or open == sound or open == display or open == power or open == shnet or open == shalert or open == shupd { open = none }
    // The Overview: Super+Tab (or its key) opens it, zooming out of the workspace you are on, the
    // search row taking the keys: typing searches (D41). What the row leaves to rules: Tab, ↑ ↓, Alt,
    // Ctrl+M, Ctrl+Z, F2, Menu, Shift+F10, Escape — Enter is its submit.
    on open_notes while side == notes { side = none }
    on open_notes while side != notes { side = notes; mark_open = false; open = none }
    on open_clips while side == clips { side = none }
    on open_clips while side != clips { emit clips; side = clips; mark_open = false; open = none }
    on open_overview while open == overview { open = none }
    on open_overview while open != overview { ov_sel = ov_zc; ov_mopen = -1; ov_win = -1; ov_warm = -1; cam_x: ov_qx ~0ms; cam_y: ov_qy ~0ms; cam_z: ov_qz ~0ms
                                              open = overview; mark_open = false; focus ov_q }
    // Escape takes back one thing at a time: the menu, the name field, the search, the marks, the pick, then the Overview.
    // the Environments drawer (D43) answers first while it is out: Ctrl+E, its rows, Enter, Escape
    on key Ctrl+e while open == overview and not ov_naming and ov_mopen < 0 { emit env_toggle }
    on key Escape while open == overview and env_open > 0 and env_naming { emit env_back; focus ov_q }
    on key Escape while open == overview and env_open > 0 and not env_naming { emit env_back }
    on key Up while open == overview and env_open > 0 { env_sel = max(env_sel - 1, 0) }
    on key Down while open == overview and env_open > 0 { env_sel = min(env_sel + 1, max(env_rows.count - 1, 0)) }
    on submit ov_q while open == overview and env_open > 0 { emit env_do(env_sel) }
    on submit env_name while open == overview and env_naming { emit env_named; focus ov_q }
    on env_focus_name { focus env_name }
    on key Escape while open == overview and env_open == 0 and ov_mopen >= 0 { ov_mopen = -1 }
    on key Escape while open == overview and env_open == 0 and ov_mopen < 0 and ov_naming { ov_naming = false; ov_naming_group = false; focus ov_q }
    on key Escape while open == overview and env_open == 0 and ov_mopen < 0 and not ov_naming and ov_searching { emit ov_clear }
    on key Escape while open == overview and env_open == 0 and ov_mopen < 0 and not ov_naming and not ov_searching and ov_nmark > 0 { emit ov_unmark }
    on key Escape while open == overview and env_open == 0 and ov_mopen < 0 and not ov_naming and not ov_searching and ov_nmark == 0 and ov_win >= 0 { ov_win = -1 }
    on key Escape while open == overview and env_open == 0 and ov_mopen < 0 and not ov_naming and not ov_searching and ov_nmark == 0 and ov_win < 0 { open = none }
    // the workspaces under the keys: Tab across, ↑ ↓ between rows; in the menu, ↑ ↓ its rows
    on key Tab while open == overview and env_open == 0 and not ov_naming and ov_mopen < 0 { ov_sel = mod(ov_sel + 1, max(ov_cells.count, 1)); ov_win = -1 }
    on key Shift+Tab while open == overview and env_open == 0 and not ov_naming and ov_mopen < 0 { ov_sel = mod(ov_sel - 1 + max(ov_cells.count, 1), max(ov_cells.count, 1)); ov_win = -1 }
    on key Up while open == overview and env_open == 0 and not ov_naming and ov_mopen < 0 { emit ov_nav(-1) }
    on key Down while open == overview and env_open == 0 and not ov_naming and ov_mopen < 0 { emit ov_nav(1) }
    on key Up while open == overview and env_open == 0 and ov_mopen >= 0 { ov_msel = max(ov_msel - 1, 0) }
    on key Down while open == overview and env_open == 0 and ov_mopen >= 0 { ov_msel = min(ov_msel + 1, max(ov_menu.count - 1, 0)) }
    // Enter: the menu's row; else the window picked (or found); else the workspace under the keys
    on submit ov_q while open == overview and env_open == 0 and ov_mopen >= 0 { emit ov_menu_do(ov_msel) }
    on submit ov_q while open == overview and env_open == 0 and ov_mopen < 0 and ov_win < 0 { ov_zc = ov_sel; emit ov_go(ov_sel); open = none }
    on submit ov_q while open == overview and env_open == 0 and ov_mopen < 0 and ov_win >= 0 { ov_zc = ov_sel; emit atlas_window(ov_win); open = none }
    // The hands: Alt+↑ ↓ pick a window in the workspace, Ctrl+M marks it, Ctrl+Z takes the last move
    // back, F2 names the workspace, Menu or Shift+F10 its actions (moving what is held there among them)
    on key Alt+Down while open == overview and env_open == 0 and not ov_naming and ov_mopen < 0 and not atlas_busy { emit ov_pick(1) }
    on key Alt+Up while open == overview and env_open == 0 and not ov_naming and ov_mopen < 0 and not atlas_busy { emit ov_pick(-1) }
    on key Ctrl+m while open == overview and env_open == 0 and not ov_naming and ov_mopen < 0 and ov_win >= 0 { emit ov_mark(ov_win) }
    on key Ctrl+z while open == overview and not ov_naming and not atlas_busy { emit ov_undo }
    // the canvas's camera (D47): Ctrl+F every territory in view, Ctrl+0 back where you are, Ctrl+= / Ctrl+- nearer, further
    on key Ctrl+f while open == overview and ov_canvas { ov_cx = ov_fx; ov_cy = ov_fy; ov_cz = ov_fz }
    on key Ctrl+zero while open == overview and ov_canvas { emit ov_here }
    on key Ctrl+equal while open == overview and ov_canvas { ov_cx = ov_cx + ov_W / 2 / ov_cz - ov_W / 2 / clamp(ov_cz * 1.4, 0.03, 1.5); ov_cy = ov_cy + ov_H / 2 / ov_cz - ov_H / 2 / clamp(ov_cz * 1.4, 0.03, 1.5); ov_cz = clamp(ov_cz * 1.4, 0.03, 1.5) }
    on key Ctrl+minus while open == overview and ov_canvas { ov_cx = ov_cx + ov_W / 2 / ov_cz - ov_W / 2 / clamp(ov_cz / 1.4, 0.03, 1.5); ov_cy = ov_cy + ov_H / 2 / ov_cz - ov_H / 2 / clamp(ov_cz / 1.4, 0.03, 1.5); ov_cz = clamp(ov_cz / 1.4, 0.03, 1.5) }
    on key F2 while open == overview and env_open == 0 and not ov_naming and ov_mopen < 0 { ov_naming = true; focus ov_name }
    on key Menu while open == overview and env_open == 0 and not ov_naming and ov_mopen < 0 { emit ov_menu_open(ov_sel) }
    on key Shift+F10 while open == overview and env_open == 0 and not ov_naming and ov_mopen < 0 { emit ov_menu_open(ov_sel) }
    on ov_focus_name { focus ov_name }
    on submit ov_name while open == overview and ov_naming { emit ov_rename; focus ov_q }
    // The shutter's keys: ↑ ↓ through what is out at its deepest level, Enter or Space to act, the
    // arrow toward the panel to go in and the other way (or Escape) to come back out; Escape at the
    // plates puts it away.
    on key Escape while open == shutter { emit sh_back }
    on key Up while open == shutter and sh_ext { sh_esel = max(sh_esel - 1, 0) }
    on key Down while open == shutter and sh_ext { sh_esel = min(sh_esel + 1, max(sh_items.count - 1, 0)) }
    on key Up while open == shutter and not sh_ext and sh_panel >= 0 { sh_row = max(sh_row - 1, 0) }
    on key Down while open == shutter and not sh_ext and sh_panel >= 0 { sh_row = min(sh_row + 1, max(sh_rows.count - 1, 0)) }
    on key Up while open == shutter and sh_panel < 0 { sh_plate = max(sh_plate - 1, 0) }
    on key Down while open == shutter and sh_panel < 0 { sh_plate = min(sh_plate + 1, max(sh_n - 1, 0)) }
    on key Return while open == shutter and sh_ext { emit sh_item(sh_esel) }
    on key Return while open == shutter and not sh_ext and sh_panel >= 0 { emit sh_row(sh_row) }
    on key Return while open == shutter and sh_panel < 0 { emit sh_pick(sh_plate) }
    on key space while open == shutter and sh_ext { emit sh_item(sh_esel) }
    on key space while open == shutter and not sh_ext and sh_panel >= 0 { emit sh_row(sh_row) }
    on key space while open == shutter and sh_panel < 0 { emit sh_pick(sh_plate) }
    on key Right while open == shutter and sh_dir > 0 and sh_panel < 0 { emit sh_pick(sh_plate) }
    on key Right while open == shutter and sh_dir > 0 and sh_panel >= 0 and not sh_ext { emit sh_row(sh_row) }
    on key Left while open == shutter and sh_dir > 0 { emit sh_back }
    on key Left while open == shutter and sh_dir < 0 and sh_panel < 0 { emit sh_pick(sh_plate) }
    on key Left while open == shutter and sh_dir < 0 and sh_panel >= 0 and not sh_ext { emit sh_row(sh_row) }
    on key Right while open == shutter and sh_dir < 0 { emit sh_back }

    on key Escape while open == command and cmode == actions and carming     { carming = false }
    on key Escape while open == command and cmode == actions and not carming { cmode = list; focus query }
    on key Escape while open == command and cmode == list                    { open = none }
    on key Down while open == command and cmode == list { csel = min(csel + 1, max(res.count - 1, 0)) }
    on key Up while open == command and cmode == list   { csel = max(csel - 1, 0) }
    on key Ctrl+n while open == command and cmode == list { csel = min(csel + 1, max(res.count - 1, 0)) }
    on key Ctrl+p while open == command and cmode == list { csel = max(csel - 1, 0) }
    on key Ctrl+Left while open == command and cmode == list { csel = max(csel - 1, 0) }
    on key Ctrl+Right while open == command and cmode == list { csel = min(csel + 1, max(res.count - 1, 0)) }
    on key Right while open == command and cmode == list and csel > 0 { csel = max(csel - 1, 0) }
    on key Left while open == command and cmode == list and csel > 0 { csel = max(csel - 1, 0) }
    on submit query while open == command and cmode == list { emit crun(csel) }
    on key Down while open == command and cmode == actions { asel = mod(asel + 1, 5); carming = false }
    on key Up while open == command and cmode == actions   { asel = mod(asel - 1, 5); carming = false }
    on key Right while open == command and cmode == actions { asel = mod(asel + 1, 5); carming = false }
    on key Left while open == command and cmode == actions  { asel = mod(asel - 1, 5); carming = false }
    on key Return while open == command and cmode == actions { emit csat_try(asel) }

    // Window island keys
    on key Right while open == window and phase == compact { sel = mod(sel + 1, 5); arming = false }
    on key Left while open == window and phase == compact  { sel = mod(sel - 1, 5); arming = false }
    on key Tab while open == window and phase == compact   { sel = mod(sel + 1, 5); arming = false }
    on key Return while open == window and phase == compact { emit activate(sel) }
    on key space while open == window and phase == compact  { emit activate(sel) }

    on key Right while open == window and phase == expanded { wsel = mod(wsel, 10) + 1 }
    on key Left while open == window and phase == expanded  { wsel = mod(wsel - 2, 10) + 1 }
    on key Down while open == window and phase == expanded  { wsel = mod(wsel + 4, 10) + 1 }
    on key Up while open == window and phase == expanded    { wsel = mod(wsel - 6, 10) + 1 }
    on key Return while open == window and phase == expanded { emit pick_ws(wsel) }

    on activate(v) while v != 4 { arming = false }
    on activate(v) while v == 3 and target_ok and not busy { phase = expanded; wsel = mod(ws_target, 10) + 1 }
    on activate(v) while v == 4 and target_ok and not busy and confirm_close and not arming { arming = true }
    on activate(v) while v == 4 and target_ok and not busy and (arming or not confirm_close) { arming = false; busy = true; emit act(4) }
    on activate(v) while (v < 1.5 or (v == 2 and floating)) and target_ok and not busy { busy = true; emit act(v) }

    on pick_ws(n) while target_ok and not busy and n != ws_target { busy = true; emit send(n) }

    // System island keys (values come back through the services)
    on key Down while open == system { srow = if(brightness.present, mod(srow + 1, 2), 0) }
    on key Up while open == system   { srow = if(brightness.present, mod(srow - 1, 2), 0) }
    on key Right while open == system and srow == 0 { emit vol(clamp(audio.volume + 0.05, 0, 1)) }
    on key Left while open == system and srow == 0  { emit vol(clamp(audio.volume - 0.05, 0, 1)) }
    on key Right while open == system and srow == 1 { emit bri(clamp(brightness.level + 0.05, 0.01, 1)) }
    on key Left while open == system and srow == 1  { emit bri(clamp(brightness.level - 0.05, 0.01, 1)) }
    on key m while open == system { emit mute }

    // Command membrane keys: the field keeps whatever counts as typing; the rest arrives here.
    on key Tab while open == command and cmode == actions   { asel = mod(asel + 1, 5); carming = false }
    on key Return while open == command and cmode == actions { emit csat_try(asel) }
    on csat_try(v) while v == 4 and not carming and not busy        { carming = true }
    on csat_try(v) while (v != 4 or carming) and not busy           { carming = false; busy = true; emit csat(v) }

    // Safety net: an exclusive keyboard grab nobody is using goes away.
    on idle for 30s while open != none { open = none; arming = false }
}
