language 0.4
import "theme/tokens.plm"
import "ui/island.plm"
import "theme/ferrolume.plm"
import "ui/ferrolume.plm"
import "ui/loom.plm"
import "ui/viz.plm" as viz
import "ui/stash.plm"

// mooi — the Spine and its islands.
//
// State model (docs/ARCHITECTURE.md):
//  · ONE island slot: `open` says which island holds it, so two can never be open at once.
//    `phase` is that island's depth (compact / expanded). Opening another island while one
//    is open hands the slot over: the old one leaves on m.exit while the new one arrives.
//  · The slot is driven by the rules below on the render thread, so Escape and the Spine
//    buttons work even if the logic is stuck. The logic closes it only when its window is
//    gone or an action finished it.
//  · Hyprland owns windows and workspaces; the system owns volume and brightness. What is
//    shown is what they report back, never what was asked for.
scene Mooi {
    permissions {
        run: "hyprctl", "matugen", "powerprofilesctl", "ps", "readlink", "git", "xdg-open", "kitty", "pleamar", "cat", "sensors", "curl", "cava", "systemd-inhibit", "wf-recorder", "slurp", "grim", "wl-copy", "wl-paste", "cliphist", "wlogout", "hyprlock", "date", "mkdir", "cp", "rm", "ffmpeg", "ffprobe", "checkupdates", "paru", "yay", "flatpak", "df", "btop", "nvtop", "hyprsunset", "upower", "pavucontrol"
        services: "workspaces", "workspaces.focus", "window", "apps", "clock", "clock.seconds", "files", "files.write", "env", "audio", "audio.*", "brightness", "brightness.*", "battery", "network", "network.*", "bluetooth", "bluetooth.*", "media", "media.*", "apps.launch", "thumbnails", "thumbnails.want", "tray", "tray.*", "notifications", "notifications.*", "notification_history"
    }

    // ── The island slot ───────────────────────────────────────
    // corners on every plate (look.corners: 0 chamfer · 1 bevel · 2 rounded · 3 square; look.corner_size as a scale)
    fact cn_kind = 0
    fact cn_scale = 1
    fact isl_style = 0           // island.style: 0 plate · 1 tether (ui/island.plm reads it)
    fact clock_view = 0          // clock.view: 0 full · 1 time · 2 seconds
    fact th_mode = 0             // theme.mode: 0 dark · 1 light · 2 auto
    fact nl_on = false           // the night light (hyprsunset) is on
    fact pw_saver = 0            // motion.saver: 0 off · 1 on battery · 2 always
    fact pw_prof = 0             // power.profile: 0 keep · 1 power-saver · 2 balanced · 3 performance
    fact pw_ppd = false          // power-profiles-daemon answers
    text pw_state = ""
    text pw_time = ""
    text pw_rate = ""
    fact open: none | window | system | command | shutter | overview | stats | calendar | weather | sound | display | power | shnet | shalert | shupd = none
    fact isl_cx = 0              // the middle of the module that opened the island showing (D97)
    // The spine (D100): tabs on the right edge whose shelves slide out on hover — the islands, beside it
    fact shelves_on = true       // shelves.on
    fact shelves_hide = false    // shelves.autohide: the spine out of sight until the right edge is touched
    fact sp_reveal = false       // it was touched: the tabs are out
    prop sp_in = 1 ~m.enter
    follow sp_in = if(not shelves_hide or sp_reveal or (isl_shelf and open != none), 1, 0)
    fact isl_shelf = false       // the island showing is a shelf (beside the spine, not under the bar)
    fact isl_sy = 0              // the tab it came from, along the edge
    fact shelf_pin = false       // a press on its tab keeps it out
    // The calendar island (shell/islands.luau, lib/calendar): the month's 42 cells from Monday
    model cal max 42 { n: number; day: number; cur: bool; today: bool; weekend: bool }
    text cal_title = ""
    text cal_sub = ""
    fact cal_home = true         // the month on show is this month
    // The stats island (lib/stats): read every 2 s while it is open
    text st_load = ""
    text st_mem_t = ""
    fact st_mem_f = 0
    text st_swap_t = ""
    text st_disk_t = ""
    fact st_disk_f = 0
    fact st_gpu_f = 0
    fact st_gpu_ok = false
    fact st_nvtop = false
    model st_top max 3 { name: text; cpu: number }
    // The weather island (lib/forecast): fetched when it opens, kept 10 minutes
    fact wxi_ok = false
    fact wxi_busy = false
    fact wxi_temp = 0
    fact wxi_kind = 2
    text wxi_word = ""
    text wxi_line = ""
    text wxi_hilo = ""
    text wxi_sub = ""
    text wxi_title = "Weather"
    model wx_hours max 6 { n: number; label: text; temp: number; kind: number }
    model wx_days max 5 { n: number; label: text; lo: number; hi: number; kind: number; a: number; b: number }
    fact phase: compact | expanded = compact

    // Window island
    fact sel = 0              // selected action, 0..4
    fact wsel = 1             // selected workspace while expanded, 1..10
    fact arming = false       // close asked once, waiting for the confirming press
    fact busy = false         // an action is with Hyprland; cleared by the logic
    fact target_ok = false    // the logic has read the window the island acts on
    fact floating = false
    fact fullscreen = false
    fact pinned = false
    fact ws_target = 0
    text tgt_class = ""
    text tgt_title = "Reading window…"
    text feedback = ""

    // System island
    fact srow = 0             // 0 volume · 1 brightness

    // Workspace Atlas (Phase 4: per-window previews, grouped by workspace)
    fact atlas_busy = false
    fact previews = true      // settings: atlas.previews — off means no picture is taken or shown
    // The bounded workspace map, filled by the logic from the `workspaces` service
    // (`lib/spaces`). The Mechanism's chain draws it and the Atlas's move strip draws it:
    // it is the only place workspace state becomes rows, and it holds the positions the
    // compositor has not made yet as well as the ones it has.
    model spaces max 16 { id: number; windows: number; active: bool; exists: bool; name: text; monitor: text; label: text; icon: image 16, 16; iconed: bool; joined: bool }
    model atlas_tiles max 40 { ws: number; address: text; title: text; app: text; picture: image 400, 225; stale: bool; 
                                  ocell: number; fx: number; fy: number; fw: number; fh: number; priv: bool; mark: bool
                                  icon: image 48, 48; iconed: bool; hit: bool; tx: number; ty: number; tw: number; th: number; floating: bool }
    fact bd_press = -1        // the board's tile under a press, and the one being carried
    fact bd_drag = -1
    fact bd_px = 0
    fact sp_hx = 0            // where a carried window is, in the frame's own pixels (the zone's `local`:
    fact sp_hy = 0            // an agent's drag reports `pointer.y` offset, `local` true)
    // ── The Overview (D37): every workspace zoomed out as a miniature of its screen ──
    event open_overview        // Super+Tab
    event ov_go ->            // to the logic: go to cell n's workspace
    model ov_cells max 18 { id: number; windows: number; active: bool; exists: bool; name: text; named: bool; acc: number; hit: bool
                            grp: number; gacc: number; gname: text; gfirst: bool; glink: bool
                            mon: text; monned: bool; elsewhere: bool; tx: number; ty: number; tw: number; th: number; label: text; sub: text }
    fact ov_rows = 2
    fact ov_cols = 5
    fact ov_moni = 0          // the monitor it is drawn on (its copy of the surface)
    fact ov_zc = 0            // the cell it zooms out of, and back into
    fact ov_sel = 0           // the cell the keyboard is on
    // The grid, worked out by the logic for the monitor it opens on (lib/atlas `grid`): a chain of
    // `let`s on `screen.*` here kept the scene drawing every frame even while it was closed (D37).
    fact ov_W = 1920
    fact ov_H = 1080
    fact ov_gap = 22
    fact ov_cw = 300
    fact ov_ch = 170
    fact ov_gx = 0
    fact ov_gy = 0
    fact ov_strip = false     // settings: atlas.overview — one row under the bar, the desktop left in view (D38)
    // Its hands (D39): a window picked by the keyboard, windows marked to go together, the last move
    // undone, a workspace named and given an accent (lib/atlas; the names in mooi's workspaces.json).
    event ov_mark ->          // to the logic: mark or unmark tile n
    event ov_pick ->          // to the logic: the next (1) or previous (-1) window in the keyboard's cell
    event ov_undo ->          // to the logic: send the last move's windows back
    event ov_rename ->        // to the logic: the keyboard's cell is called what ov_name says
    event ov_unmark ->        // to the logic: every mark cleared
    fact ov_win = -1          // the tile the keyboard picked (-1: the cell itself)
    fact ov_nmark = 0         // how many windows are marked
    fact ov_naming = false    // the name field is out
    fact ov_naming_group = false  // and it names a group (D42)
    fact ov_undoable = false  // there is a move to take back
    fact ov_ok = true         // what ov_msg says went well, or not
    text ov_msg = ""          // what the last move did, for a few seconds
    fact ov_said = false      // and whether it is still being said
    text ov_name = ""
    fact ov_act = -1          // the active workspace's cell on the page (-1: on another page)
    fact ov_dim = 0.55        // settings: atlas.dim — how dark the desktop goes behind it (D44)
    fact ov_zoom = true       // settings: atlas.zoom — the workspace you are on zooms out into its place
    fact ov_multi = false     // more than one monitor: each workspace says where it lives (D44)
    // Search and the workspace menu (D41)
    text ov_q = ""            // the search row
    text ov_found = ""        // what it found, said
    fact ov_searching = false // there is something in it
    fact ov_nfound = 0
    fact ov_search_h = 40     // its height (lib/atlas SEARCH_H)
    event ov_clear ->         // to the logic: empty the search
    event ov_menu_open ->     // to the logic: cell n's menu
    event ov_menu_do ->       // to the logic: its row n
    event ov_focus_name       // from the logic: the name field takes the keys
    model ov_menu max 8 { label: text; danger: bool }
    event ov_menu_win ->      // to the logic: window n's menu (its workspace's, with its own rows first)
    fact ov_mopen = -1        // the cell whose menu is out (-1: none)
    fact ov_msel = 0          // its row under the keys
    text ov_mtitle = ""       // its heading
    // Saved environments (D43): the Overview's drawer (shell/environments.luau)
    fact env_open = 0         // 0 put away · 1 the list · 2 one environment · 3 what restoring it would do
    fact env_sel = 0          // the row under the keys
    fact env_naming = false   // the name field is out
    model env_rows max 24 { label: text; sub: text; danger: bool }
    model env_lines max 14 { text: text; tone: number }   // the restore plan: 0 plain · 1 will happen · 2 cannot · 3 note
    text env_title = ""
    text env_name = ""
    event env_toggle ->       // to the logic: the drawer out, or away
    event env_do ->           // to the logic: its row n
    event env_back ->         // to the logic: back a page (or the name field, or a delete asked once)
    event env_named ->        // to the logic: the name field's Enter
    event env_focus_name      // from the logic: the name field takes the keys
    event env_restore_at ->   // to the logic: restore environment n at once (a Nexus scene, D102)
    fact bd_ox = 0            // where a carried window was taken, from its corner
    fact bd_oy = 0
    event ov_close ->         // to the logic: close tile n's window (middle-click, as in iNiR)
    event ov_drop_xy ->       // to the logic: tile n let go at (ov_px, ov_py) (D45, D47)
    fact ov_px = 0            // where something was let go, on the screen: beside the event, not packed into it —
    fact ov_py = 0            // the scene counts in 32-bit floats, and a packed number loses its last digits
    event ov_place ->         // to the logic: territory n set down with its corner at (ov_px, ov_py) (D47)
    event ov_create ->        // to the logic: a double press on the open canvas, at (ov_px, ov_py)
    event ov_wact ->          // to the logic: 10 · tile + 0 focus · 1 float · 2 fullscreen · 3 close (the canvas's action strip)
    event ov_here ->          // to the logic: the camera back to the workspace you are on
    event ov_land             // a territory set down: its windows land with it
    event ov_nav ->           // to the logic: the nearest workspace up (-1) or down (1)
    // The camera over the world (D47): every workspace a rectangle in it, the logic's; the grid's and
    // the strip's are their cells on the screen (the camera still), the canvas's territories anywhere
    fact ov_canvas = false
    fact ov_cx = 0            // where the camera is to be (its world corner) and how near: the canvas's is yours
    fact ov_cy = 0
    fact ov_cz = 1
    fact ov_qx = 0            // the camera that fills the screen with one workspace: the way in and out
    fact ov_qy = 0
    fact ov_qz = 1
    fact ov_fx = 0            // the one that shows them all (Ctrl+F)
    fact ov_fy = 0
    fact ov_fz = 1
    fact ov_awx = 0           // the active workspace's rectangle
    fact ov_awy = 0
    fact ov_aww = 0
    fact ov_awh = 0
    fact ov_nwx = 0           // the keyboard's (the name field's place)
    fact ov_nwy = 0
    fact ov_nww = 0
    fact ov_mwx = 0           // the menu's workspace's
    fact ov_mwy = 0
    fact ov_mww = 0
    fact cd_press = -1        // a territory under a press on its nameplate, and the one being carried
    fact cd_drag = -1
    fact cd_ox = 0            // where it was taken, from its corner
    fact cd_oy = 0
    fact bg_press = 0         // the open field pressed, and whether it was dragged (a pan)
    fact bg_moved = 0
    fact pan_cx = 0           // the camera when the pan began
    fact pan_cy = 0
    fact ov_lastt = -1
    fact ov_warm = -1         // a window whose Close was pressed once
    // Command membrane
    fact cmode: list | actions = list   // results, or a window result's satellite actions
    fact csel = 0             // selected result
    fact asel = 0             // selected satellite action
    fact carming = false      // satellite close asked once
    fact max_results = 7      // settings: command.max_results
    text query = ""
    text cempty = "Type to search apps, windows, workspaces"
    model res max 10 { kind: app | win | space | mooi; title: text; sub: text; icon: image 20, 20; letter: text }

    // Spine
    fact flash_ws = 0         // the workspace a window was just moved to
    text win_icon = ""        // the focused window's icon, resolved by the logic
    text win_letter = ""      // shown when there is no icon

    // ── The Mechanism ─────────────────────────────────────────
    // The bar's own state, beside the island slot (`open`). These two are mutually
    // exclusive with it: one instrument of the bar's at a time.
    fact active_row = 0       // which position on the chain the active workspace is (the logic)
    fact mark_open = false    // the mark's menu
    fact bar_labels = true    // setting · bar.labels — names beside the marks
    fact bar_wheel: step | off | invert = step   // setting · bar.wheel — what the wheel over the chain does
    // The look (lib/style): notch layout, corner radius, outline width and colour (0 subtle ·
    // 1 bright · 2 accent), pill (0 soft · 1 outline · 2 underline · 3 glow), shadow (down,
    // blur, strength), opacity, glass frost and smoke (%), chromatic aberration (0→1), glow (×).
    fact st_notch = false
    fact st_radius = 8
    fact st_owidth = 1.4
    fact st_ocol = 0
    fact st_pill = 0
    fact st_sh_y = 0
    fact st_sh_blur = 0
    fact st_sh_a = 0
    fact st_opacity = 1
    fact st_frost = 70
    fact st_smoke = 38
    fact st_aberr = 0
    fact st_glow = 1
    fact st_wheel = 0
    fact st_width = 1         // bar.width: the share of the screen the bar spans, centred
    fact st_height = 30       // bar.height: the row's thickness
    fact st_offset = 0        // bar.offset: how far down from the screen's edge it sits
    fact st_res = 46          // the strip the windows leave it (lib/style): the reserve surfaces' sum
    fact bar_x0 = 6           // the bar's extent (shell/bar.luau)
    fact bar_x1 = 1914
    fact st_frame_r = 14      // the screen frame's inner corners (frame.radius)
    fact st_frame_edge = 0    // its inner edge: 0 line · 1 neon · 2 none
    fact st_frame_op = 1      // how solid it is
    // The notch's three pieces (shell/bar.luau, from lib/barlayout's clusters): left edge and width
    fact nl_x = 0
    fact nl_w = 0
    fact nc_x = 0
    fact nc_w = 0
    fact nr_x = 0
    fact nr_w = 0
    fact theme_wallpaper = false        // setting · theme.source, as the bar shows it (the logic)
    fact light = false                  // the palette is a day one (D91, theme.mode): what only differs by day reads it
    fact media_on = false     // there is a player with something on it at all (the logic)
    text bar_version = "mooi" // the version line of the mark's menu (the logic)
    text bar_path = ""        // where the settings file is, shortened (the logic)

    // ── The Ferrolume bar's switches ──────────────────────────
    // The logic publishes the settings (docs/FERROLUME.md) as these; choices go over as
    // their place in the setting's list.
    fact ws_style = 0         // bar.workspaces · 0 dna · 1 prism · 2 cells · 3 pills · 4 segments · 5 dots · 6 numbers · 7 compass · 8 radar
    fact bar_frame = 0        // bar.frame · 0 bezel · 1 plate · 2 bracket · 3 none
    fact bar_ground = 0       // bar.ground · 0 black · 1 tinted · 2 clear
    fact bar_rail = true      // bar.rail
    fact bar_accents = true   // bar.accents · cuts, drop ticks, slashes
    fact bar_foot_viz = true  // bar.foot_visualizer · the islands' feet step with the music
    fact bar_full = false     // bar.mode · islands, or one full panel
    fact bar_surface = 0      // bar.surface · 0 solid · 1 glass · 2 blur · 3 clear
    fact viz = 0              // bar.visualizer · 0 mirror · 1 bars · 2 line · 3 dots · 4 off
    fact viz_missing = false  // cava is not installed: the visualizer says so (shell/bar.luau)
    fact side: none | notes | clips = none   // the side panel
    fact settings_open = false  // the settings program is running (the logic)
    fact nexus_open = false     // Control Nexus is running (the logic)
    fact bar_edit = false       // the bar's edit mode
    fact ed_drag = -1           // the module being carried (its index), or −1
    fact ed_x = 0               // where the pointer is while it is carried
    fact ed_y = 0
    model shelf_items max 24 { i: number; name: text }
    model edit_gaps max 24 { x: number; w: number; own: number; fixed: bool; n: number }   // spacers and gaps (shell/bar.luau)
    // The layout (shell/bar.luau, lib/barlayout): per module its left edge (−9999: not
    // placed) and width, whether it is shown (`m_`), the frame it wears (`f_`, `inherit`
    // resolved), the frame as set (`fi_`: 0 inherit · 1 bezel · 2 plate · 3 bracket · 4 none)
    // and whether it is a member of a group (`g_`); the full panel's span; the frames and
    // the hairlines.
    fact x_workspaces = 0
    fact p_workspaces = false
    fact w_workspaces = 0
    fact m_workspaces = true
    fact f_workspaces = 0
    fact fi_workspaces = 0
    fact g_workspaces = false
    fact x_window = 0
    fact p_window = false
    fact w_window = 0
    fact m_window = true
    fact fi_window = 0
    fact g_window = false
    fact x_media = 0
    fact p_media = false
    fact w_media = 0
    fact m_media = true
    fact fi_media = 0
    fact g_media = false
    fact x_resources = 0
    fact p_resources = false
    fact w_resources = 0
    fact m_resources = true
    fact fi_resources = 0
    fact g_resources = false
    fact x_bandwidth = 0
    fact p_bandwidth = false
    fact w_bandwidth = 0
    fact m_bandwidth = true
    fact fi_bandwidth = 0
    fact g_bandwidth = false
    fact x_keyboard = 0
    fact p_keyboard = false
    fact w_keyboard = 0
    fact m_keyboard = true
    fact fi_keyboard = 0
    fact g_keyboard = false
    fact x_weather = 0
    fact p_weather = false
    fact w_weather = 0
    fact m_weather = true
    fact fi_weather = 0
    fact g_weather = false
    fact x_tray = 0
    fact p_tray = false
    fact w_tray = 0
    fact m_tray = true
    fact fi_tray = 0
    fact g_tray = false
    fact x_notifications = 0
    fact p_notifications = false
    fact w_notifications = 0
    fact m_notifications = true
    fact fi_notifications = 0
    fact g_notifications = false
    fact x_mic = 0
    fact p_mic = false
    fact w_mic = 0
    fact m_mic = true
    fact fi_mic = 0
    fact g_mic = false
    fact x_volume = 0
    fact p_volume = false
    fact w_volume = 0
    fact m_volume = true
    fact fi_volume = 0
    fact g_volume = false
    fact x_brightness = 0
    fact p_brightness = false
    fact w_brightness = 0
    fact m_brightness = true
    fact fi_brightness = 0
    fact g_brightness = false
    fact x_battery = 0
    fact p_battery = false
    fact w_battery = 0
    fact m_battery = true
    fact fi_battery = 0
    fact g_battery = false
    fact x_network = 0
    fact p_network = false
    fact w_network = 0
    fact m_network = true
    fact fi_network = 0
    fact g_network = false
    fact x_bluetooth = 0
    fact p_bluetooth = false
    fact w_bluetooth = 0
    fact m_bluetooth = true
    fact fi_bluetooth = 0
    fact g_bluetooth = false
    fact x_clock = 0
    fact p_clock = false
    fact w_clock = 0
    fact m_clock = true
    fact fi_clock = 0
    fact g_clock = false
    fact x_caffeine = 0
    fact p_caffeine = false
    fact w_caffeine = 0
    fact m_caffeine = true
    fact fi_caffeine = 0
    fact g_caffeine = false
    fact x_recorder = 0
    fact p_recorder = false
    fact w_recorder = 0
    fact m_recorder = true
    fact fi_recorder = 0
    fact g_recorder = false
    fact x_screenshot = 0
    fact p_screenshot = false
    fact w_screenshot = 0
    fact m_screenshot = true
    fact fi_screenshot = 0
    fact g_screenshot = false
    fact x_clipboard = 0
    fact p_clipboard = false
    fact w_clipboard = 0
    fact m_clipboard = true
    fact fi_clipboard = 0
    fact g_clipboard = false
    fact x_power = 0
    fact p_power = false
    fact w_power = 0
    fact m_power = true
    fact fi_power = 0
    fact g_power = false
    fact x_actions = 0
    fact p_actions = false
    fact w_actions = 0
    fact m_actions = true
    fact fi_actions = 0
    fact g_actions = false
    fact x_overview = 0
    fact p_overview = false
    fact w_overview = 0
    fact m_overview = true
    fact fi_overview = 0
    fact g_overview = false
    fact x_core = 0
    fact p_core = false
    fact w_core = 0
    fact m_core = true
    fact fi_core = 0
    fact g_core = false
    fact x_focus = 0
    fact p_focus = false
    fact w_focus = 0
    fact m_focus = true
    fact fi_focus = 0
    fact g_focus = false
    fact x_settings = 0
    fact p_settings = false
    fact w_settings = 0
    fact m_settings = true
    fact fi_settings = 0
    fact g_settings = false
    fact x_notes = 0
    fact p_notes = false
    fact w_notes = 0
    fact m_notes = true
    fact fi_notes = 0
    fact g_notes = false
    fact x_wallpaper = 0
    fact p_wallpaper = false
    fact w_wallpaper = 0
    fact m_wallpaper = true
    fact fi_wallpaper = 0
    fact g_wallpaper = false
    fact x_nexus = 0
    fact p_nexus = false
    fact w_nexus = 0
    fact m_nexus = true
    fact fi_nexus = 0
    fact g_nexus = false
    fact x_updates = 0
    fact p_updates = false
    fact w_updates = 0
    fact m_updates = true
    fact fi_updates = 0
    fact g_updates = false
    fact x_claude = 0
    fact p_claude = false
    fact w_claude = 0
    fact m_claude = true
    fact fi_claude = 0
    fact g_claude = false
    fact x_github = 0
    fact p_github = false
    fact w_github = 0
    fact m_github = true
    fact fi_github = 0
    fact g_github = false
    fact gh_unread = 0           // what waits on GitHub (the notch reads it)
    fact upd_n = 0               // system updates waiting (bar.luau, lib/updates)
    fact upd_busy = false        // looking
    fact upd_running = false     // the updater's terminal is open
    text upd_t = "Checking for updates…"
    // The focus timer (shell/bar.luau): 0 idle, 1 a focus session, 2 its break; what is left
    // of it (1 → 0), the minutes and seconds left, and the length a session will have.
    fact foc_state = 0
    fact foc_frac = 0
    fact foc_len = 25
    text foc_left = "25:00"
    fact px = 0
    fact wsf_x = 0            // the island that holds the workspaces (islands mode)
    fact wsf_w = 0
    fact wsf_a = 0            // the modules that island begins and ends with (their places in the order)
    fact wsf_b = 0
    fact tray_style = 0       // tray.style · 0 themed · 1 original
    fact ed_merge = false     // edit mode: the module carried would join a group if dropped now
    fact ed_sel = -1          // edit mode: the module chosen (the inspector is under it), or −1
    fact ed_press = -1        // edit mode: the module pressed, before it is known to be a drag
    fact ed_px = 0
    fact helix_frame = true   // bar.helix_frame
    fact media_mode = 0       // media.mode · 0 full · 1 compact · 2 art · 3 viz
    fact media_idle = 0       // media.idle · 0 collapse · 1 keep · 2 hide
    fact med_has_art = false
    text med_art = ""
    fact frame_on = true      // frame.on — the screen frame
    fact frame_band = 6
    fact frame_music = true
    fact saving = false       // the battery saver is on (motion.saver): effects that cost frames are off
    fact frame_style = 0      // frame.style · 0 swell · 1 crests · 2 pulse
    fact frame_reach = 18
    fact frame_edges = 0      // frame.edges · 0 all · 1 sides · 2 ends
    fact note_server = 0      // notifications.server · 0 takeover · 1 always · 2 never
    fact fbass = 0            // cava, for the frame's swell (shell/bar.luau)
    fact fhigh = 0
    fact fph = 0
    fact pw = 0
    model frames max 24 { x: number; w: number; style: number; a: number; b: number }
    model dividers max 40 { x: number; strong: bool; p: number; m: number }
    // What the modules read (shell/bar.luau).
    fact res_cpu = 0
    fact res_mem = 0
    fact res_temp = 0
    text res_memgb = ""
    text bw_down = "--"
    text bw_up = "--"
    text kb_code = "--"
    text kb_name = ""
    fact wx_ok = false
    fact wx_kind = 2
    fact wx_temp = 0
    text wx_word = ""
    text wx_city = ""
    fact caffeine_on = false
    fact recording = false
    fact notes_on = false
    fact note_count = 0
    fact bt_conn = 0
    // `glyph`: 0 the program's own picture, else mooi's own glyph for what it is (1 Wi-Fi, 2 wired,
    // 3 offline, 4 Bluetooth, 5 Bluetooth off; shell/bar.luau), with `level` for the Wi-Fi arcs;
    // `letter` stands in when the program names no picture at all.
    model tray_items max 16 { key: text; title: text; icon: image 16, 16; glyph: number; level: number; letter: text; lettered: number }
    fact note_missed = 0      // notices that went away on their own, unseen (the history)
    fact dnd_now = false      // do not disturb holds now (notifications.dnd): only urgent signals unfold
    // ── Signal Loom (D50): the notifications as signals (shell/signals.luau, lib/signals) ──
    // Where they unfold from (signals.edge: the surfaces move there live), how many are out and
    // how many wait, the cluster's length along its edge, and the look: the corners' cut, how far
    // a signal travels as it unfolds (0 … 1), its glow, the roomier size.
    fact loom_anchor: top_right | top_left | bottom_right | bottom_left = top_right
    fact loom_bottom = false
    fact loom_left = false
    fact loom_count = 0
    fact loom_more = 0
    fact loom_len = 0
    fact loom_chamfer = 8
    fact loom_travel = 1
    fact loom_fx = true
    fact loom_comfy = false
    // A slot each: a signal keeps its slot while it is out, so an update rings where it is.
    // `tier` 0 whisper · 1 manifest · 2 intervention; `kind` 0 event · 1 conversation · 2 alert;
    // `y`/`h` its place along the edge; `linked`: joined to the one before (same app); `pulse`
    // goes up with each update (a thread's new message, a notice the app replaced).
    model loom max 6 { out: bool; tier: number; kind: number; app: text; title: text; body: text; when: text; many: number; icon: image 22, 22; iconed: bool; image: image 28, 28; pictured: bool; acts: number; a1: text; a2: text; a3: text; y: number; h: number; linked: bool; pulse: number; has_default: bool }
    // The Signal Field: the clusters (by app, then what was missed), the chosen one's notices,
    // and every notice of the last six hours on the activity rail.
    model fclus max 13 { app: text; title: text; many: number; when: text; critical: bool; muted: bool; missed: bool }
    // D86: the Field's summary strip — each app's share of what waits, and the counts it says
    model fshare max 8 { part: number; critical: bool; sel: bool }
    fact fld_apps = 0
    fact fld_urgent = 0
    model fitems max 30 { title: text; body: text; when: text; tier: number; critical: bool; acts: number; a1: text; a2: text; a3: text; has_default: bool; missed: bool; snoozed: bool; thread: number; first: bool; image: image 28, 28; pictured: bool }
    model frail max 60 { x: number; tier: number; cluster: number }
    fact fld_sel = 0          // the chosen cluster
    fact fld_item = 0         // the chosen notice in it (the keys act on it)
    fact fld_muted = false    // the chosen cluster's app is muted
    fact fld_lost = false     // the chosen cluster is what was missed
    text fld_app = ""
    model clips max 14 { id: text; text: text }
    // ── Quick notes (D51): the pad's page in the bar and its dropdown (shell/notes.luau) ──
    // `qn_count` is what the badge says; `qn_draft` is the input's text (the logic owns the file);
    // `qn_said` is the word under the list for a moment (“SAVED”, “COPIED”, “DELETED”).
    fact qn_open = false
    fact qn_count = 0
    fact qn_drafting = false  // the input has something in it (a live text cannot be read in an expression)
    fact qn_saying = false    // `qn_said` has a word to show
    fact qn_editing = false   // the draft is a note being changed, not a new one
    fact qn_edit_id = -1      // which note that is (a row is lit while it is)
    fact qn_can_undo = false  // a note was just forgotten; Undo stands for a moment
    fact qn_page = 0          // the first row shown (the wheel moves it)
    fact qn_from = 0          // what the rows say: “from–to of count”
    fact qn_to = 0
    text qn_draft = ""
    text qn_said = ""
    text qn_add_label = "ADD" // the button's word: ADD, or SAVE while a note is being changed
    model qn max 6 { id: number; text: text; more: text; two: bool; when: text; n: number; pinned: bool; sel: bool; tag: number; done: bool }
    fact qn_searching = false
    text qn_query = ""
    fact qn_sel = -1          // the row the keys act on (an id)
    fact sys_cx = 0           // the middle of the module that last opened the system island (D53)
    // How many cards there are and how many are late (the board's own program owns the rest): the
    // pad's rail carries both, read from board.json by the logic (D64).
    fact kb_count = 0
    fact kb_late = 0
    // ── The stash (D54): the little box on the left edge (shell/stash.luau, lib/stash) ──
    // The rows it shows (a page at a time), where in the list that page is, and the word the
    // panel says for a moment after a drop or a removal. The box itself opens on a press of its
    // rail (D56), so the scene owns that; nothing here is asked of the keyboard.
    model stash max 6 { id: number; kind: number; name: text; sub: text; n: number; url: text; picture: image 48, 48; pictured: bool }
    // The folders as the chip row says them, in the order they were made: the same slot in
    // both, so a press and a drop can name one by its place.
    model stash_folders max 5 { name: text; held: number; n: number; lit: number }
    fact stash_count = 0
    // the side notch's nub and fan, top and bottom on the screen (notch-state.json; 0, 0 none): the
    // stash's edge strip is overlay and would take the pointer from them, so it leaves them that band
    fact nub_cut0 = 0
    fact nub_cut1 = 0
    fact stash_page = 0
    fact stash_pages = 1
    fact stash_from = 0
    fact stash_to = 0
    fact stash_empty = true
    fact stash_saying = false
    fact stash_here = 0        // the folder the box shows (0: everything)
    fact stash_root = true
    fact stash_all = 0         // how many are kept, wherever they are
    fact stash_folders_n = 0
    fact stash_naming = false  // the new-folder field has the caret
    fact stash_pin = false     // the box was opened by a press and stays until it is put away
    text stash_said = ""
    text stash_here_name = ""
    text stash_new = ""
    // D86: the box's chips (0 everything · 1 pictures · 2 links · 3 files · 4 text) and its search.
    fact stash_kind = 0
    fact stash_searching = false
    text stash_query = ""
    event stash_open ->        // to the logic: item id pressed (its link or file is opened)
    event stash_del ->         // to the logic: item id removed, with its copy
    event stash_scroll ->      // to the logic: the wheel over the panel (± notches)
    event stash_file ->        // to the logic: item id put away, to its next folder
    event stash_folder ->      // to the logic: folder slot pressed (0: everything)
    event stash_folder_del ->  // to the logic: folder slot taken away, its items home
    event stash_kind ->        // to the logic: which kind the box shows (0 everything … 4 text)
    event stash_paste ->       // to the logic: stash what is on the clipboard
    event stash_shot ->        // to the logic: stash a screenshot of a chosen region
    event stash_blur           // from the logic: the new-folder field is done
    fact lv0 = 0.06
    fact lv1 = 0.06
    fact lv2 = 0.06
    fact lv3 = 0.06
    fact lv4 = 0.06
    fact lv5 = 0.06
    fact lv6 = 0.06
    fact lv7 = 0.06
    fact lv8 = 0.06
    fact lv9 = 0.06
    fact lv10 = 0.06
    fact lv11 = 0.06
    fact lv12 = 0.06
    fact lv13 = 0.06
    fact lv14 = 0.06
    fact lv15 = 0.06
    fact th_scheme = 0        // theme.scheme, its place in the list (0 tonal-spot)
    fact th_index = 0         // theme.color_index · which of the wallpaper's five colours
    fact th_contrast = 1      // theme.contrast + 1 · 0 soft · 1 standard · 2 high
    fact th_signal = 0        // theme.signal · 0 auto · 1 tertiary · 2 secondary · 3 complement

    // ── The Ferrolume bar's colours ───────────────────────────
    // Nineteen roles, three facts each, painted by the logic (lib/ferro.luau) and born with
    // Ferrolume's own palette. Each channel is followed by a spring (`pr_*`, ~fl.relight) and
    // the tokens read the springs, so every palette change re-lights in one 600 ms glide.
    fact fr_ground_r = 0.000000
    fact fr_ground_g = 0.000000
    fact fr_ground_b = 0.000000
    fact fr_hull_r = 0.015686
    fact fr_hull_g = 0.035294
    fact fr_hull_b = 0.031373
    fact fr_hull_raised_r = 0.027451
    fact fr_hull_raised_g = 0.074510
    fact fr_hull_raised_b = 0.066667
    fact fr_well_r = 0.019608
    fact fr_well_g = 0.164706
    fact fr_well_b = 0.145098
    fact fr_trace_dim_r = 0.121569
    fact fr_trace_dim_g = 0.219608
    fact fr_trace_dim_b = 0.200000
    fact fr_trace_r = 0.239216
    fact fr_trace_g = 0.415686
    fact fr_trace_b = 0.376471
    fact fr_trace_lit_r = 0.423529
    fact fr_trace_lit_g = 0.788235
    fact fr_trace_lit_b = 0.682353
    fact fr_phos_r = 0.498039
    fact fr_phos_g = 0.811765
    fact fr_phos_b = 0.713725
    fact fr_phos_fill_r = 0.090196
    fact fr_phos_fill_g = 0.603922
    fact fr_phos_fill_b = 0.533333
    fact fr_ember_r = 0.878431
    fact fr_ember_g = 0.482353
    fact fr_ember_b = 0.180392
    fact fr_ember_fill_r = 0.823529
    fact fr_ember_fill_g = 0.411765
    fact fr_ember_fill_b = 0.117647
    fact fr_flare_r = 0.956863
    fact fr_flare_g = 0.713725
    fact fr_flare_b = 0.235294
    fact fr_muted_r = 0.352941
    fact fr_muted_g = 0.541176
    fact fr_muted_b = 0.494118
    fact fr_ink_r = 0.015686
    fact fr_ink_g = 0.129412
    fact fr_ink_b = 0.113725
    fact fr_steel_900_r = 0.082353
    fact fr_steel_900_g = 0.098039
    fact fr_steel_900_b = 0.105882
    fact fr_steel_700_r = 0.164706
    fact fr_steel_700_g = 0.192157
    fact fr_steel_700_b = 0.203922
    fact fr_steel_500_r = 0.290196
    fact fr_steel_500_g = 0.329412
    fact fr_steel_500_b = 0.349020
    fact fr_steel_300_r = 0.545098
    fact fr_steel_300_g = 0.592157
    fact fr_steel_300_b = 0.611765
    fact fr_engrave_r = 0.603922
    fact fr_engrave_g = 0.650980
    fact fr_engrave_b = 0.670588
    prop pr_ground_r = 0.000000 ~fl.relight
    follow pr_ground_r = fr_ground_r
    prop pr_ground_g = 0.000000 ~fl.relight
    follow pr_ground_g = fr_ground_g
    prop pr_ground_b = 0.000000 ~fl.relight
    follow pr_ground_b = fr_ground_b
    prop pr_hull_r = 0.015686 ~fl.relight
    follow pr_hull_r = fr_hull_r
    prop pr_hull_g = 0.035294 ~fl.relight
    follow pr_hull_g = fr_hull_g
    prop pr_hull_b = 0.031373 ~fl.relight
    follow pr_hull_b = fr_hull_b
    prop pr_hull_raised_r = 0.027451 ~fl.relight
    follow pr_hull_raised_r = fr_hull_raised_r
    prop pr_hull_raised_g = 0.074510 ~fl.relight
    follow pr_hull_raised_g = fr_hull_raised_g
    prop pr_hull_raised_b = 0.066667 ~fl.relight
    follow pr_hull_raised_b = fr_hull_raised_b
    prop pr_well_r = 0.019608 ~fl.relight
    follow pr_well_r = fr_well_r
    prop pr_well_g = 0.164706 ~fl.relight
    follow pr_well_g = fr_well_g
    prop pr_well_b = 0.145098 ~fl.relight
    follow pr_well_b = fr_well_b
    prop pr_trace_dim_r = 0.121569 ~fl.relight
    follow pr_trace_dim_r = fr_trace_dim_r
    prop pr_trace_dim_g = 0.219608 ~fl.relight
    follow pr_trace_dim_g = fr_trace_dim_g
    prop pr_trace_dim_b = 0.200000 ~fl.relight
    follow pr_trace_dim_b = fr_trace_dim_b
    prop pr_trace_r = 0.239216 ~fl.relight
    follow pr_trace_r = fr_trace_r
    prop pr_trace_g = 0.415686 ~fl.relight
    follow pr_trace_g = fr_trace_g
    prop pr_trace_b = 0.376471 ~fl.relight
    follow pr_trace_b = fr_trace_b
    prop pr_trace_lit_r = 0.423529 ~fl.relight
    follow pr_trace_lit_r = fr_trace_lit_r
    prop pr_trace_lit_g = 0.788235 ~fl.relight
    follow pr_trace_lit_g = fr_trace_lit_g
    prop pr_trace_lit_b = 0.682353 ~fl.relight
    follow pr_trace_lit_b = fr_trace_lit_b
    prop pr_phos_r = 0.498039 ~fl.relight
    follow pr_phos_r = fr_phos_r
    prop pr_phos_g = 0.811765 ~fl.relight
    follow pr_phos_g = fr_phos_g
    prop pr_phos_b = 0.713725 ~fl.relight
    follow pr_phos_b = fr_phos_b
    prop pr_phos_fill_r = 0.090196 ~fl.relight
    follow pr_phos_fill_r = fr_phos_fill_r
    prop pr_phos_fill_g = 0.603922 ~fl.relight
    follow pr_phos_fill_g = fr_phos_fill_g
    prop pr_phos_fill_b = 0.533333 ~fl.relight
    follow pr_phos_fill_b = fr_phos_fill_b
    prop pr_ember_r = 0.878431 ~fl.relight
    follow pr_ember_r = fr_ember_r
    prop pr_ember_g = 0.482353 ~fl.relight
    follow pr_ember_g = fr_ember_g
    prop pr_ember_b = 0.180392 ~fl.relight
    follow pr_ember_b = fr_ember_b
    prop pr_ember_fill_r = 0.823529 ~fl.relight
    follow pr_ember_fill_r = fr_ember_fill_r
    prop pr_ember_fill_g = 0.411765 ~fl.relight
    follow pr_ember_fill_g = fr_ember_fill_g
    prop pr_ember_fill_b = 0.117647 ~fl.relight
    follow pr_ember_fill_b = fr_ember_fill_b
    prop pr_flare_r = 0.956863 ~fl.relight
    follow pr_flare_r = fr_flare_r
    prop pr_flare_g = 0.713725 ~fl.relight
    follow pr_flare_g = fr_flare_g
    prop pr_flare_b = 0.235294 ~fl.relight
    follow pr_flare_b = fr_flare_b
    prop pr_muted_r = 0.352941 ~fl.relight
    follow pr_muted_r = fr_muted_r
    prop pr_muted_g = 0.541176 ~fl.relight
    follow pr_muted_g = fr_muted_g
    prop pr_muted_b = 0.494118 ~fl.relight
    follow pr_muted_b = fr_muted_b
    prop pr_ink_r = 0.015686 ~fl.relight
    follow pr_ink_r = fr_ink_r
    prop pr_ink_g = 0.129412 ~fl.relight
    follow pr_ink_g = fr_ink_g
    prop pr_ink_b = 0.113725 ~fl.relight
    follow pr_ink_b = fr_ink_b
    prop pr_steel_900_r = 0.082353 ~fl.relight
    follow pr_steel_900_r = fr_steel_900_r
    prop pr_steel_900_g = 0.098039 ~fl.relight
    follow pr_steel_900_g = fr_steel_900_g
    prop pr_steel_900_b = 0.105882 ~fl.relight
    follow pr_steel_900_b = fr_steel_900_b
    prop pr_steel_700_r = 0.164706 ~fl.relight
    follow pr_steel_700_r = fr_steel_700_r
    prop pr_steel_700_g = 0.192157 ~fl.relight
    follow pr_steel_700_g = fr_steel_700_g
    prop pr_steel_700_b = 0.203922 ~fl.relight
    follow pr_steel_700_b = fr_steel_700_b
    prop pr_steel_500_r = 0.290196 ~fl.relight
    follow pr_steel_500_r = fr_steel_500_r
    prop pr_steel_500_g = 0.329412 ~fl.relight
    follow pr_steel_500_g = fr_steel_500_g
    prop pr_steel_500_b = 0.349020 ~fl.relight
    follow pr_steel_500_b = fr_steel_500_b
    prop pr_steel_300_r = 0.545098 ~fl.relight
    follow pr_steel_300_r = fr_steel_300_r
    prop pr_steel_300_g = 0.592157 ~fl.relight
    follow pr_steel_300_g = fr_steel_300_g
    prop pr_steel_300_b = 0.611765 ~fl.relight
    follow pr_steel_300_b = fr_steel_300_b
    prop pr_engrave_r = 0.603922 ~fl.relight
    follow pr_engrave_r = fr_engrave_r
    prop pr_engrave_g = 0.650980 ~fl.relight
    follow pr_engrave_g = fr_engrave_g
    prop pr_engrave_b = 0.670588 ~fl.relight
    follow pr_engrave_b = fr_engrave_b

    // Settings (logic, from settings.json; these are the defaults)
    fact show_clock = true
    fact ws_max = 10
    fact ws_last = 10         // the chain's last workspace as drawn (lib/spaces rows: the setting, or further to reach the focus)
    fact confirm_close = true
    fact cfg_error = false

    // ── Theme ─────────────────────────────────────────────────
    // Three facts per semantic token, 0 to 1 each, which `theme/tokens.plm` hands to
    // `rgb()`: the one way Pleamar lets the logic hand over a colour that did not exist
    // when the scene was read. The values here are the brief's fixed palette; the logic
    // paints them from the settings, and from the wallpaper's Matugen palette when
    // `theme.source = wallpaper` — all fourteen or none, never half a theme.
    fact theme_error = false   // the new theme did not pass; the last good one is showing
    fact c_bg_primary_r = 0.062745
    fact c_bg_primary_g = 0.078431
    fact c_bg_primary_b = 0.086275
    fact c_bg_secondary_r = 0.086275
    fact c_bg_secondary_g = 0.105882
    fact c_bg_secondary_b = 0.117647
    fact c_surface_primary_r = 0.098039
    fact c_surface_primary_g = 0.121569
    fact c_surface_primary_b = 0.133333
    fact c_surface_elevated_r = 0.133333
    fact c_surface_elevated_g = 0.160784
    fact c_surface_elevated_b = 0.176471
    fact c_border_subtle_r = 0.172549
    fact c_border_subtle_g = 0.207843
    fact c_border_subtle_b = 0.223529
    fact c_fg_primary_r = 0.890196
    fact c_fg_primary_g = 0.913725
    fact c_fg_primary_b = 0.921569
    fact c_fg_secondary_r = 0.639216
    fact c_fg_secondary_g = 0.690196
    fact c_fg_secondary_b = 0.709804
    fact c_fg_muted_r = 0.541176
    fact c_fg_muted_g = 0.592157
    fact c_fg_muted_b = 0.611765
    fact c_accent_primary_r = 0.650980
    fact c_accent_primary_g = 0.952941
    fact c_accent_primary_b = 0.819608
    fact c_accent_secondary_r = 1.000000
    fact c_accent_secondary_g = 0.572549
    fact c_accent_secondary_b = 0.372549
    fact c_status_ok_r = 0.650980
    fact c_status_ok_g = 0.952941
    fact c_status_ok_b = 0.819608
    fact c_status_error_r = 1.000000
    fact c_status_error_g = 0.572549
    fact c_status_error_b = 0.372549
    fact c_focus_ring_r = 0.650980
    fact c_focus_ring_g = 0.952941
    fact c_focus_ring_b = 0.819608
    fact c_selection_bg_r = 0.164706
    fact c_selection_bg_g = 0.227451
    fact c_selection_bg_b = 0.211765

    // ── The bar's own marks ───────────────────────────────────
    // The colour of each mark the bar draws, three facts each and `rgb()`-ready the same way
    // the tokens are (docs/MECHANISM.md §8). They are born with the role each mark takes from
    // the brief's palette — the chain's block, the readings and the doors are the accent; the
    // clock is text; the battery and the ways out are the second accent — so a bar drawn
    // before the logic has said anything still reads. The logic paints them from the palette
    // and from `bar.tones`, which is how one icon can be given a colour of its own.

    event open_window          // Spine button · `mooi toggle` · `mooi open`
    event open_system          // Spine status button · `mooi system`
    event clock_next ->        // to the logic: the clock shows the next of clock.view's states
    event media_view ->        // to the logic: the media module shows the next of media.mode's views
    event cal_shift ->         // to the logic: 0 the month before · 1 this month · 2 the month after
    event st_open ->           // to the logic: 0 btop · 1 nvtop, in a terminal
    event wx_refresh ->        // to the logic: fetch the forecast again now
    event snd_out ->           // to the logic: make output n (its place in audio.outputs) the default
    event snd_mixer ->         // to the logic: open the mixer (pavucontrol)
    event night_light ->       // to the logic: the night light on or off
    event pw_set ->            // to the logic: 0–2 the battery saver (motion.saver) · 11–13 the power profile
    event open_command         // Super+Alt+Space · Spine search button · `mooi toggle`
    // ── The Mechanical Shutter (D35; shell/shutter.luau places it and says what it offers) ──
    event open_shutter ->      // to the logic: 0 the focused window, 1 the one under the pointer
    event sh_close ->          // to the logic: put it away
    event sh_back ->           // to the logic: one level back (the third, the panel, then all of it)
    event sh_pick ->           // to the logic: plate n pressed
    event sh_hover ->          // to the logic: plate n under the pointer (hover preview)
    event sh_row ->            // to the logic: row n of the open panel
    event sh_item ->           // to the logic: choice n of the third level
    event sh_said              // from the logic: something to say under the panel
    text sh_mon = ""           // the monitor it is on, and that monitor's copy of the surface (its
    fact sh_moni = 0           // place in Hyprland's monitors by id: the outputs' own order)
    text sh_title = ""         // the window's app
    text sh_msg = ""
    fact sh_ok = true
    fact sh_wx = 0             // the window, in its monitor's pixels
    fact sh_wy = 0
    fact sh_ww = 0
    fact sh_wh = 0
    fact sh_ax = 0             // the anchor (the window's corner) and the track's vertical run
    fact sh_ay = 0
    fact sh_spine = 0
    fact sh_px = 0             // the column of plates: its first, a plate's size, the gap
    fact sh_py = 0
    fact sh_pw = 148
    fact sh_ph = 42
    fact sh_pgap = 6
    fact sh_dir = 1            // which way panels open: +1 right, −1 left
    fact sh_side = 0           // 0 outside right · 1 outside left · 2 inside the window
    fact sh_n = 4
    fact sh_plate = 0          // the plate the keyboard is on
    fact sh_panel = -1         // the plate whose panel is out, or −1
    fact sh_row = 0
    fact sh_bx = 0             // the panel
    fact sh_by = 0
    fact sh_bw = 248
    fact sh_bh = 100
    fact sh_row_h = 34
    fact sh_brx = 1            // the panel's side of its plate
    fact sh_ext = false        // the third level is out
    fact sh_ex = 0
    fact sh_ey = 0
    fact sh_ew = 180
    fact sh_eh = 100
    fact sh_esel = 0
    model sh_plates max 4 { label: text; icon: number; acts: number }
    model sh_rows max 10 { label: text; hint: text; kind: number; on: bool; toggle: bool; armed: bool }
    model sh_items max 16 { label: text; on: bool }
    event atlas_window ->      // focus the window picked in the Overview
    event crun ->              // to the logic: open result n (launch, focus, switch, …)
    event csat_try             // a satellite action asked for, by index
    event csat ->              // to the logic: run satellite action n on result `csel`
    event activate             // a window action asked for, by index
    event pick_ws              // a workspace asked for, by id
    event act ->               // to the logic: run action n on the target
    event send ->              // to the logic: move the target to workspace n
    event ws_pick ->           // to the logic: focus workspace n
    event vol ->               // to the logic: set the volume (0..1)
    event bri ->               // to the logic: set the brightness (0..1)
    event mute ->              // to the logic: toggle mute
    event recolor              // a fresh palette is on disk (bin/mooi theme-sync, or a matugen hook)
    event op_done              // from the logic: Hyprland confirmed it
    event op_failed            // from the logic: it did not happen
    event moved                // from the logic: the target went to workspace n
    event ws_arrived           // from the logic: the focus went to another workspace (every switcher's ping)
    event media_cmd ->         // the transport was pressed: -1 previous · 0 play or pause · +1 next
    event bar_menu             // the mark was pressed: the bar's own menu
    event toggle_labels ->     // to the logic: setting · bar.labels
    event toggle_wheel ->      // to the logic: setting · bar.wheel
    event toggle_theme ->      // to the logic: setting · theme.source (fixed ↔ wallpaper)
    event set_mode ->          // to the logic: setting · theme.mode (0 dark · 1 light · 2 auto · 9 the other one now) — `mooi mode`, Super+Alt+T (D91)
    event set_value ->         // to the logic: one setting to one value (1000 · code + value; mooi.luau, SETTERS)
    event bar_join ->          // to the logic: merge a module into the entry before it, or split it out
    event tray_cmd ->          // to the logic: a tray icon pressed (4·index + 0 click, 1 menu, 2 middle)
    event loom_open ->         // to the logic: signal n pressed (its default, or the Field at it)
    event loom_act ->          // to the logic: 10 · signal + which of its buttons
    event loom_dismiss ->      // to the logic: signal n dismissed (its whole thread)
    event loom_shelve ->       // to the logic: signal n let go of; it waits in the Field
    event loom_hover ->        // to the logic: the pointer on the cluster (1) or off it (0)
    event loom_field           // from the logic: open the Signal Field
    event fld_pick ->          // to the logic: cluster n chosen
    event fld_choose ->        // to the logic: notice n chosen
    event fld_open ->          // to the logic: notice n's default
    event fld_act ->           // to the logic: 10 · notice + which of its buttons
    event fld_snooze ->        // to the logic: notice n out of sight for 15 minutes
    event fld_dismiss ->       // to the logic: notice n dismissed (a missed one forgotten)
    event fld_dismiss_all ->   // to the logic: the chosen cluster, all of it
    event fld_mute ->          // to the logic: the chosen cluster's app muted, or not
    event note_dnd ->          // to the logic: do not disturb on or off
    event note_clear ->        // to the logic: dismiss every notice
    event qn_toggle ->         // to the logic: the notes module pressed (the pad opens or closes)
    event qn_add ->            // to the logic: Add pressed (the draft's text)
    event qn_tag ->            // to the logic: note id's colour, the next one round (D86)
    event qn_done ->           // to the logic: note id ticked off, or open again
    event qn_copy ->           // to the logic: note id pressed (its text is copied)
    event qn_edit ->           // to the logic: note id chosen for changing
    event qn_cancel ->         // to the logic: stop changing it (Escape, or the button)
    event qn_del ->            // to the logic: note id forgotten
    event qn_undo ->           // to the logic: put the last forgotten one back
    event qn_scroll ->         // to the logic: the wheel over the rows (± notches)
    event qn_focus             // from the logic: the input takes the caret again
    event qn_pin ->            // to the logic: note id pinned, or let go
    event qn_board ->          // to the logic: note id sent to the board
    event qn_nav ->            // to the logic: the chosen row, up (0) or down (1)
    event qn_act ->            // to the logic: on the chosen row, 1 copy · 2 edit · 3 pin · 4 board · 5 forget
    event open_board           // from outside (`mooi board`): the board, open or closed
    event board_show ->        // to the logic: start the board's program, or close it if it runs
    event clips ->             // to the logic: read the clipboard's history
    event open_notes           // `mooi notes` (Super+L standalone): the side panel's notices, open or closed (D48)
    event open_clips           // `mooi clipboard` (Super+Shift+V standalone): its clipboard history
    event clip_pick ->         // to the logic: copy clipboard entry n
    event caffeine ->          // to the logic: keep awake, on or off
    event record ->            // to the logic: record (1 an area, 0 the screen) or stop
    event shot ->              // to the logic: screenshot (0 an area, 1 the screen)
    event focus_cmd ->         // to the logic: the focus timer (0 start or stop, 1 skip, 2 longer, 3 shorter)
    event power ->             // to the logic: the session menu (0) or lock (1)
    event mic_mute ->          // to the logic: the microphone, muted or not
    event mic_vol ->           // to the logic: the microphone's level (0..1)
    event open_settings ->     // to the logic: start the settings program, or close it
    event open_wallpaper ->    // to the logic: start Lumen, the wallpaper studio, or close it (`mooi wallpaper`)
    event open_player ->       // to the logic: start the music player, or close it — 0 the mini card (a press on the media module), 1 the panel (`mooi player`, its key)
    event open_nexus ->        // to the logic: start Control Nexus, or close it (`mooi nexus`)
    event run_updates ->       // to the logic: run the system updater in a terminal
    event open_claude ->       // to the logic: the side notch's Claude panel
    event open_github ->       // to the logic: the side notch's GitHub panel
    event sh_net ->            // to the logic: join network n (its place in network.networks); -1 the radio on or off
    event sh_bt ->             // to the logic: connect or disconnect device n; -1 the radio on or off
    event edit_mode ->         // to the logic: edit mode on (1) or off (0)
    event screen_w ->          // to the logic: the bar's surface is this wide now (a new mode or scale)
    event edit_hover ->        // to the logic: a module carried over the bar (plan the layout)
    event edit_drop ->         // to the logic: a module dropped (write the layout)
    event edit_cancel ->       // to the logic: put the layout back
    event edit_reset ->        // to the logic: the default layout
    event edit_gap ->          // to the logic: take out spacer or gap n (100 · side + entry)
    event edit_op ->           // to the logic: 10 · module + 0 left · 1 right · 2 join before · 3 join after · 4 split · 5 hide
    event edit_toggle          // `mooi edit`: edit mode on or off
    event ed_grab              // a shelf chip picked up
    event ed_release           // a shelf chip let go
    event set_action           // the edit shelf's buttons (2 reset, 3 done)

    // ── System state, no logic needed ─────────────────────────
    model wss max 16 { id: number; windows: number; active: bool }
    service workspaces as ws { active: number; list: wss }
    // Only whether it can capture: the pictures reach the board through the logic (atlas_tiles). A
    // list here was a second model of every picture, decoded on each refresh though nothing drew it —
    // the late frames under a carried window (D40).
    service thumbnails { capturing: bool }
    service clock { time: text = "--:--"; date: text; weekday: number }
    service clock.seconds as tick { second: number }
    model aouts max 8 { id: text; name: text; default: bool }
    service audio { volume: number; muted: bool; input: number; input_muted: bool; outputs: aouts }
    service window { title: text; class: text }
    service media as med { playing: bool; title: text; artist: text }
    service brightness { present: bool; level: number }
    service battery { present: bool; percent: number; charging: bool }
    model nets max 8 { ssid: text; strength: number; secure: bool; known: bool; active: bool }
    service network { online: bool; kind: none | wired | wifi; name: text; strength: number; wifi: bool; networks: nets }
    model btd max 8 { name: text; address: text; paired: bool; connected: bool; battery: number }
    service bluetooth { present: bool; powered: bool; discovering: bool; devices: btd }
    image wicon = from win_icon, 22, 22

    // ── Motion: hidden → entering → shown → exiting, per island ──
    prop rv.window = 0 ~m.enter
    prop rv.system = 0 ~m.enter
    prop rv.command = 0 ~m.enter
    prop rv.stats = 0 ~m.enter
    prop rv.calendar = 0 ~m.enter
    prop rv.weather = 0 ~m.enter
    prop rv.sound = 0 ~m.enter
    prop rv.display = 0 ~m.enter
    prop rv.power = 0 ~m.enter
    prop rv.shnet = 0 ~m.enter
    prop rv.shalert = 0 ~m.enter
    prop rv.shupd = 0 ~m.enter
    prop depth = 0 ~m.expand
    prop fb = 0 ~m.select
    prop pz = 0 ~m.confirm
    // The Overview's double presses: a second press within 350 ms of the first. Gated by layers,
    // not by `time` — naming `time` keeps the whole bar drawing 60 frames a second for ever. The
    // layers' own spring is instant: a claim eases out on the default one, and stays above 0 long
    // after its 350 ms.
    event ov_bgtap               // a press on the Overview's background (a double one makes a workspace)
    event ov_tap                 // a press on a window or territory, `ov_lastt` which (a double one goes there)
    prop ov_bgg = 0
    prop ov_tg = 0
    layer ov_bggate ~1ms {
        recent for 350ms after ov_bgtap { ov_bgg: 1 ~1ms }
        idle                            { ov_bgg: 0 ~1ms }
    }
    layer ov_tapgate ~1ms {
        recent for 350ms after ov_tap { ov_tg: 1 ~1ms }
        idle                          { ov_tg: 0 ~1ms }
    }

    layer life.window {
        shown while open == window { rv.window: 1 ~m.enter }
        gone                       { rv.window: 0 ~m.exit }
    }
    layer life.system {
        shown while open == system { rv.system: 1 ~m.enter }
        gone                       { rv.system: 0 ~m.exit }
    }
    layer life.command {
        shown while open == command { rv.command: 1 ~m.enter }
        gone                        { rv.command: 0 ~m.exit }
    }
    // the modules' own islands (D97)
    layer life.stats {
        shown while open == stats { rv.stats: 1 ~m.enter }
        gone                      { rv.stats: 0 ~m.exit }
    }
    layer life.calendar {
        shown while open == calendar { rv.calendar: 1 ~m.enter }
        gone                         { rv.calendar: 0 ~m.exit }
    }
    layer life.weather {
        shown while open == weather { rv.weather: 1 ~m.enter }
        gone                        { rv.weather: 0 ~m.exit }
    }
    layer life.sound {
        shown while open == sound { rv.sound: 1 ~m.enter }
        gone                      { rv.sound: 0 ~m.exit }
    }
    layer life.display {
        shown while open == display { rv.display: 1 ~m.enter }
        gone                        { rv.display: 0 ~m.exit }
    }
    layer life.power {
        shown while open == power { rv.power: 1 ~m.enter }
        gone                      { rv.power: 0 ~m.exit }
    }
    layer life.shnet {
        shown while open == shnet { rv.shnet: 1 ~m.enter }
        gone                      { rv.shnet: 0 ~m.exit }
    }
    layer life.shalert {
        shown while open == shalert { rv.shalert: 1 ~m.enter }
        gone                        { rv.shalert: 0 ~m.exit }
    }
    layer life.shupd {
        shown while open == shupd { rv.shupd: 1 ~m.enter }
        gone                      { rv.shupd: 0 ~m.exit }
    }
    // The shutter's motion: the anchor answers first, the plates follow down the track in a short
    // stagger, a panel slides out of its plate, the third level out of its row; going, the panel
    // folds first and the plates after it (shorter springs out than in).
    spring fl.deploy = 820, 52      // ~230 ms · the plates down the track
    spring fl.panel = 1500, 74      // ~170 ms · a panel out of its plate
    prop sh_d = 0 ~fl.deploy
    prop sh_p = 0 ~fl.panel
    prop sh_e = 0 ~fl.panel
    prop sh_m = 0 ~m.select
    layer life.shutter {
        shown while open == shutter { sh_d: 1 ~fl.deploy }
        gone                        { sh_d: 0 ~m.collapse }
    }
    follow sh_p = if(sh_panel >= 0 and open == shutter, 1, 0)
    follow sh_e = if(sh_ext and open == shutter, 1, 0)
    layer shutter_said {
        said for 1800ms after sh_said { sh_m: 1 ~m.select }
        quiet                         { sh_m: 0 ~m.exit }
    }
    // The Overview's one camera move: the workspace you are on shrinks from the whole screen into
    // its place in the grid as the others come in round it; going, the chosen one grows back out.
    spring fl.zoom = 430, 41        // ~320 ms
    prop ov_z = 0 ~fl.zoom
    // the Overview's camera (D47): where it is to be while open, the workspace chosen as it closes
    prop cam_x = 0 ~fl.zoom
    prop cam_y = 0 ~fl.zoom
    prop cam_z = 1 ~fl.zoom
    follow cam_x = if(open == overview, ov_cx, ov_qx)
    follow cam_y = if(open == overview, ov_cy, ov_qy)
    follow cam_z = if(open == overview, ov_cz, ov_qz)
    layer life.overview {
        shown while open == overview { ov_z: 1 ~fl.zoom }
        gone                         { ov_z: 0 ~fl.zoom }
    }
    layer size {
        wide while open == window and phase == expanded { depth: 1 ~m.expand }
        narrow                                          { depth: 0 ~m.collapse }
    }
    layer note {
        failed for 2600ms after op_failed { fb: 1 ~m.select }
        done for 1400ms after op_done     { fb: 1 ~m.select }
        quiet                             { fb: 0 ~m.select }
    }
    layer pulse {
        lit for 900ms after moved { pz: 1 ~m.confirm }
        rest                      { pz: 0 ~m.confirm }
    }

    // ══ The bar · Ferrolume ═══════════════════════════════════
    // mooi's bar is the Ferrolume bar (claude.ai design system "Ferrolume"; docs/FERROLUME.md):
    // a 46 px strip along the top of the screen — a telemetry rail, then one row of 30 px
    // modules. **Where** each module goes is the logic's (shell/bar.luau, lib/barlayout): three
    // lists, left, centre and right, in which modules joined with `+` share one frame; it
    // publishes each module's left edge (`x_<id>`, −9999 when it is not placed) and width
    // (`w_<id>`), the frames (`frames`) and the hairlines between members (`dividers`). The
    // scene only draws each module at its place. Two modes: **islands** — a frame per group —
    // and **full** — one panel across the screen, whose top and bottom edges twist into the
    // double helix over the workspaces.
    //
    // Nothing on the bar is asked for: it is what the services report (D7), and a control
    // with nothing to act on is drawn off and takes no press.
    let low = battery.present and battery.percent < 15 and not battery.charging
    let mech = bar_surface > 3.5               // the machined surface (bar.surface = mech)
    // ── The modules' places, gliding ─────────────────────────
    // The logic places each module (`x_`, `w_`); the scene draws it where a spring is carrying
    // it (`xs_`, `ws_`), so a module hidden, shown, moved or merged lets the others glide into
    // their new places — frames and hairlines too, which are drawn from the modules' springs.
    // A module that appears snaps to its place (it does not fly in from where it was last) and
    // fades in (`pv_`).
    spring fl.flow = 640, 46        // ~260 ms: a module moving to its new place (it was ~400)
    prop xs_workspaces = 0 ~fl.flow
    follow xs_workspaces = x_workspaces
    prop ws_workspaces = 0 ~fl.flow
    follow ws_workspaces = w_workspaces
    prop pv_workspaces = 0 ~m.enter
    follow pv_workspaces = p_workspaces
    on change p_workspaces while p_workspaces { xs_workspaces: x_workspaces ~1ms; ws_workspaces: w_workspaces ~1ms }
    prop xs_window = 0 ~fl.flow
    follow xs_window = x_window
    prop ws_window = 0 ~fl.flow
    follow ws_window = w_window
    prop pv_window = 0 ~m.enter
    follow pv_window = p_window
    on change p_window while p_window { xs_window: x_window ~1ms; ws_window: w_window ~1ms }
    prop xs_media = 0 ~fl.flow
    follow xs_media = x_media
    prop ws_media = 0 ~fl.flow
    follow ws_media = w_media
    prop pv_media = 0 ~m.enter
    follow pv_media = p_media
    on change p_media while p_media { xs_media: x_media ~1ms; ws_media: w_media ~1ms }
    prop xs_resources = 0 ~fl.flow
    follow xs_resources = x_resources
    prop ws_resources = 0 ~fl.flow
    follow ws_resources = w_resources
    prop pv_resources = 0 ~m.enter
    follow pv_resources = p_resources
    on change p_resources while p_resources { xs_resources: x_resources ~1ms; ws_resources: w_resources ~1ms }
    prop xs_bandwidth = 0 ~fl.flow
    follow xs_bandwidth = x_bandwidth
    prop ws_bandwidth = 0 ~fl.flow
    follow ws_bandwidth = w_bandwidth
    prop pv_bandwidth = 0 ~m.enter
    follow pv_bandwidth = p_bandwidth
    on change p_bandwidth while p_bandwidth { xs_bandwidth: x_bandwidth ~1ms; ws_bandwidth: w_bandwidth ~1ms }
    prop xs_keyboard = 0 ~fl.flow
    follow xs_keyboard = x_keyboard
    prop ws_keyboard = 0 ~fl.flow
    follow ws_keyboard = w_keyboard
    prop pv_keyboard = 0 ~m.enter
    follow pv_keyboard = p_keyboard
    on change p_keyboard while p_keyboard { xs_keyboard: x_keyboard ~1ms; ws_keyboard: w_keyboard ~1ms }
    prop xs_weather = 0 ~fl.flow
    follow xs_weather = x_weather
    prop ws_weather = 0 ~fl.flow
    follow ws_weather = w_weather
    prop pv_weather = 0 ~m.enter
    follow pv_weather = p_weather
    on change p_weather while p_weather { xs_weather: x_weather ~1ms; ws_weather: w_weather ~1ms }
    prop xs_tray = 0 ~fl.flow
    follow xs_tray = x_tray
    prop ws_tray = 0 ~fl.flow
    follow ws_tray = w_tray
    prop pv_tray = 0 ~m.enter
    follow pv_tray = p_tray
    on change p_tray while p_tray { xs_tray: x_tray ~1ms; ws_tray: w_tray ~1ms }
    prop xs_notifications = 0 ~fl.flow
    follow xs_notifications = x_notifications
    prop ws_notifications = 0 ~fl.flow
    follow ws_notifications = w_notifications
    prop pv_notifications = 0 ~m.enter
    follow pv_notifications = p_notifications
    on change p_notifications while p_notifications { xs_notifications: x_notifications ~1ms; ws_notifications: w_notifications ~1ms }
    prop xs_mic = 0 ~fl.flow
    follow xs_mic = x_mic
    prop ws_mic = 0 ~fl.flow
    follow ws_mic = w_mic
    prop pv_mic = 0 ~m.enter
    follow pv_mic = p_mic
    on change p_mic while p_mic { xs_mic: x_mic ~1ms; ws_mic: w_mic ~1ms }
    prop xs_volume = 0 ~fl.flow
    follow xs_volume = x_volume
    prop ws_volume = 0 ~fl.flow
    follow ws_volume = w_volume
    prop pv_volume = 0 ~m.enter
    follow pv_volume = p_volume
    on change p_volume while p_volume { xs_volume: x_volume ~1ms; ws_volume: w_volume ~1ms }
    prop xs_brightness = 0 ~fl.flow
    follow xs_brightness = x_brightness
    prop ws_brightness = 0 ~fl.flow
    follow ws_brightness = w_brightness
    prop pv_brightness = 0 ~m.enter
    follow pv_brightness = p_brightness
    on change p_brightness while p_brightness { xs_brightness: x_brightness ~1ms; ws_brightness: w_brightness ~1ms }
    prop xs_battery = 0 ~fl.flow
    follow xs_battery = x_battery
    prop ws_battery = 0 ~fl.flow
    follow ws_battery = w_battery
    prop pv_battery = 0 ~m.enter
    follow pv_battery = p_battery
    on change p_battery while p_battery { xs_battery: x_battery ~1ms; ws_battery: w_battery ~1ms }
    prop xs_network = 0 ~fl.flow
    follow xs_network = x_network
    prop ws_network = 0 ~fl.flow
    follow ws_network = w_network
    prop pv_network = 0 ~m.enter
    follow pv_network = p_network
    on change p_network while p_network { xs_network: x_network ~1ms; ws_network: w_network ~1ms }
    prop xs_bluetooth = 0 ~fl.flow
    follow xs_bluetooth = x_bluetooth
    prop ws_bluetooth = 0 ~fl.flow
    follow ws_bluetooth = w_bluetooth
    prop pv_bluetooth = 0 ~m.enter
    follow pv_bluetooth = p_bluetooth
    on change p_bluetooth while p_bluetooth { xs_bluetooth: x_bluetooth ~1ms; ws_bluetooth: w_bluetooth ~1ms }
    prop xs_clock = 0 ~fl.flow
    follow xs_clock = x_clock
    prop ws_clock = 0 ~fl.flow
    follow ws_clock = w_clock
    prop pv_clock = 0 ~m.enter
    follow pv_clock = p_clock
    on change p_clock while p_clock { xs_clock: x_clock ~1ms; ws_clock: w_clock ~1ms }
    prop xs_caffeine = 0 ~fl.flow
    follow xs_caffeine = x_caffeine
    prop ws_caffeine = 0 ~fl.flow
    follow ws_caffeine = w_caffeine
    prop pv_caffeine = 0 ~m.enter
    follow pv_caffeine = p_caffeine
    on change p_caffeine while p_caffeine { xs_caffeine: x_caffeine ~1ms; ws_caffeine: w_caffeine ~1ms }
    prop xs_recorder = 0 ~fl.flow
    follow xs_recorder = x_recorder
    prop ws_recorder = 0 ~fl.flow
    follow ws_recorder = w_recorder
    prop pv_recorder = 0 ~m.enter
    follow pv_recorder = p_recorder
    on change p_recorder while p_recorder { xs_recorder: x_recorder ~1ms; ws_recorder: w_recorder ~1ms }
    prop xs_screenshot = 0 ~fl.flow
    follow xs_screenshot = x_screenshot
    prop ws_screenshot = 0 ~fl.flow
    follow ws_screenshot = w_screenshot
    prop pv_screenshot = 0 ~m.enter
    follow pv_screenshot = p_screenshot
    on change p_screenshot while p_screenshot { xs_screenshot: x_screenshot ~1ms; ws_screenshot: w_screenshot ~1ms }
    prop xs_clipboard = 0 ~fl.flow
    follow xs_clipboard = x_clipboard
    prop ws_clipboard = 0 ~fl.flow
    follow ws_clipboard = w_clipboard
    prop pv_clipboard = 0 ~m.enter
    follow pv_clipboard = p_clipboard
    on change p_clipboard while p_clipboard { xs_clipboard: x_clipboard ~1ms; ws_clipboard: w_clipboard ~1ms }
    prop xs_power = 0 ~fl.flow
    follow xs_power = x_power
    prop ws_power = 0 ~fl.flow
    follow ws_power = w_power
    prop pv_power = 0 ~m.enter
    follow pv_power = p_power
    on change p_power while p_power { xs_power: x_power ~1ms; ws_power: w_power ~1ms }
    prop xs_actions = 0 ~fl.flow
    follow xs_actions = x_actions
    prop ws_actions = 0 ~fl.flow
    follow ws_actions = w_actions
    prop pv_actions = 0 ~m.enter
    follow pv_actions = p_actions
    on change p_actions while p_actions { xs_actions: x_actions ~1ms; ws_actions: w_actions ~1ms }
    prop xs_overview = 0 ~fl.flow
    follow xs_overview = x_overview
    prop ws_overview = 0 ~fl.flow
    follow ws_overview = w_overview
    prop pv_overview = 0 ~m.enter
    follow pv_overview = p_overview
    on change p_overview while p_overview { xs_overview: x_overview ~1ms; ws_overview: w_overview ~1ms }
    prop xs_core = 0 ~fl.flow
    follow xs_core = x_core
    prop ws_core = 0 ~fl.flow
    follow ws_core = w_core
    prop pv_core = 0 ~m.enter
    follow pv_core = p_core
    on change p_core while p_core { xs_core: x_core ~1ms; ws_core: w_core ~1ms }
    prop xs_focus = 0 ~fl.flow
    follow xs_focus = x_focus
    prop ws_focus = 0 ~fl.flow
    follow ws_focus = w_focus
    prop pv_focus = 0 ~m.enter
    follow pv_focus = p_focus
    on change p_focus while p_focus { xs_focus: x_focus ~1ms; ws_focus: w_focus ~1ms }
    prop xs_settings = 0 ~fl.flow
    follow xs_settings = x_settings
    prop ws_settings = 0 ~fl.flow
    follow ws_settings = w_settings
    prop pv_settings = 0 ~m.enter
    follow pv_settings = p_settings
    on change p_settings while p_settings { xs_settings: x_settings ~1ms; ws_settings: w_settings ~1ms }
    prop xs_notes = 0 ~fl.flow
    follow xs_notes = x_notes
    prop ws_notes = 0 ~fl.flow
    follow ws_notes = w_notes
    prop pv_notes = 0 ~m.enter
    follow pv_notes = p_notes
    on change p_notes while p_notes { xs_notes: x_notes ~1ms; ws_notes: w_notes ~1ms }
    prop xs_wallpaper = 0 ~fl.flow
    follow xs_wallpaper = x_wallpaper
    prop ws_wallpaper = 0 ~fl.flow
    follow ws_wallpaper = w_wallpaper
    prop pv_wallpaper = 0 ~m.enter
    follow pv_wallpaper = p_wallpaper
    on change p_wallpaper while p_wallpaper { xs_wallpaper: x_wallpaper ~1ms; ws_wallpaper: w_wallpaper ~1ms }
    prop xs_nexus = 0 ~fl.flow
    follow xs_nexus = x_nexus
    prop ws_nexus = 0 ~fl.flow
    follow ws_nexus = w_nexus
    prop pv_nexus = 0 ~m.enter
    follow pv_nexus = p_nexus
    on change p_nexus while p_nexus { xs_nexus: x_nexus ~1ms; ws_nexus: w_nexus ~1ms }
    prop xs_updates = 0 ~fl.flow
    follow xs_updates = x_updates
    prop ws_updates = 0 ~fl.flow
    follow ws_updates = w_updates
    prop pv_updates = 0 ~m.enter
    follow pv_updates = p_updates
    on change p_updates while p_updates { xs_updates: x_updates ~1ms; ws_updates: w_updates ~1ms }
    prop xs_claude = 0 ~fl.flow
    follow xs_claude = x_claude
    prop ws_claude = 0 ~fl.flow
    follow ws_claude = w_claude
    prop pv_claude = 0 ~m.enter
    follow pv_claude = p_claude
    on change p_claude while p_claude { xs_claude: x_claude ~1ms; ws_claude: w_claude ~1ms }
    prop xs_github = 0 ~fl.flow
    follow xs_github = x_github
    prop ws_github = 0 ~fl.flow
    follow ws_github = w_github
    prop pv_github = 0 ~m.enter
    follow pv_github = p_github
    on change p_github while p_github { xs_github: x_github ~1ms; ws_github: w_github ~1ms }
    prop upd_pulse = 0
    spin upd_pulse by if(upd_busy, 1400, 0)
    let vv = round(audio.volume * 100)
    let bb = round(battery.percent)

    // The workspace instrument's window and phase. One spring slides *and* turns it (`pos`),
    // following `active_row` alone; while it moves the DNA takes an extra turn in the
    // direction of travel (`spin`, from the spring's velocity) and settles upright.
    // The window holds up to 2·fl.reach positions, so the instrument is never longer than what
    // it carries; past that the list slides through it, the active one always on the slot.
    // `chain_x` is the focus — it is the slot, and it stays there — and the helix's phase is
    // measured from it, so the rung there always stands upright.
    let n_vis = clamp(spaces.count, 1, 2 * fl.reach)
    let chain_span = n_vis * fl.pitch + 12
    let frame_x = xs_workspaces + if(ws_style > 2.5, 8, 30)   // the everyday switchers carry no tag
    let win_c = frame_x + chain_span / 2
    let ws_body = if(ws_style > 6.5, if(ws_style > 7.5, 60, 150),
                  if(ws_style > 2.5, spaces.count * pick(clamp(ws_style - 3, 0, 3), 24, 20, 14, 22) + if(ws_style > 4.5 and ws_style < 5.5, 14, 0),
                  if(ws_style > 1.5, spaces.count * (fl.cell + fl.cell_gap) - fl.cell_gap, chain_span)))   // the switcher's own span
    prop pos = 0 ~fl.helix
    follow pos = active_row
    // Every switcher moves the same way (D31). The highlight is a liquid: its head runs on a
    // quick spring and its tail on a slow one, so it stretches toward the workspace it is going
    // to and gathers there (`ws_lo`..`ws_hi`, the rows it covers); each workspace lights by how
    // much of it the highlight covers (`lit` in the components). On arrival a ping rings out
    // from the new one (`arr`, 0 → 1 once, from the logic's `ws_arrived`).
    prop ws_hd = 0 ~fl.ws_head
    follow ws_hd = active_row
    prop ws_tl = 0 ~fl.ws_tail
    follow ws_tl = active_row
    let ws_lo = min(ws_hd, ws_tl)
    let ws_hi = max(ws_hd, ws_tl)
    prop arr = 0
    layer arrive {
        ping for 460ms after ws_arrived { arr: 1 ~fl.ping }
        calm                            { arr: 0 ~1ms }
    }
    // The focus slot is where the working workspace stands, in every position — not only in the
    // middle of the list. A camera clamped to keep the window full (`cam`, [half, count−half])
    // slid the active block off the slot at the ends of the list: at workspace 1 the seven
    // positions drawn from 1 stood with the active at the window's left edge, and the block the
    // bar called current was 78 px from the slot that is supposed to hold it (the scene suite's
    // «it sits on the focus slot»). The window is a sleeve over the shaft: at either end half of
    // it is the sleeve alone, which is what its own barrel is for (D26).
    let chain_x = win_c
    let spin = clamp(vel(pos) * 16, -170, 170)
    // With the DNA, the edges of what holds it are the helix's strands: the full panel, or
    // (bar.helix_frame) the workspaces' own island.
    let helix_edges = (bar_full or (helix_frame and not st_notch)) and ws_style < 0.5 and p_workspaces
    let amp = if(helix_edges, fl.mod_h / 2 - 1, fl.dna_amp)

    prop rv.mark = 0 ~m.enter
    layer life.mark {
        shown while mark_open { rv.mark: 1 ~m.enter }
        gone                  { rv.mark: 0 ~m.exit }
    }
    // The side panel (the clipboard).
    prop rv.side = 0 ~m.enter
    layer life.side {
        shown while side == clips { rv.side: 1 ~m.enter }
        gone                      { rv.side: 0 ~m.exit }
    }
    // Signal Loom's motion: the arm reaches out a touch under critical damping (a hint of
    // settle, no wobble), the face opens after it, and a signal folds back faster than it came.
    // An update rings (a quick impulse that dies away); light runs once along a new signal.
    spring sg.ext = 900, 51       // ~240 ms
    spring sg.unf = 700, 48       // ~280 ms
    spring sg.ret = 1600, 80      // ~150 ms, critical
    spring sg.pulse = 380, 18
    spring sg.sweep = 260, 32
    // The Signal Field unfolds the same way: its header runs out along the edge, then its body drops.
    prop fu_a = 0 ~sg.ext
    prop fu_b = 0 ~sg.unf
    layer life.fld {
        shown while side == notes { fu_a: 1 ~sg.ext; fu_b: 1 ~sg.unf after 90ms }
        gone                      { fu_b: 0 ~sg.ret; fu_a: 0 ~sg.ret after 80ms }
    }
    // The pad unfolds like the loom's Field: its head runs out from the module, then its body drops.
    prop qu_a = 0 ~sg.ext
    prop qu_b = 0 ~sg.unf
    layer life.qn {
        shown while qn_open { qu_a: 1 ~sg.ext; qu_b: 1 ~sg.unf after 80ms }
        gone                { qu_b: 0 ~sg.ret; qu_a: 0 ~sg.ret after 70ms }
    }
    // The loom's surface stays while its last signal folds back.
    prop loom_tail = 0 ~sg.ret
    layer life.loomtail {
        on while loom_count > 0 { loom_tail: 1 ~1ms }
        off                     { loom_tail: 0 ~1ms after 450ms }
    }
    // The audio levels (cava, 16 bands) glide on a quick spring; at rest they lie low.
    spring fl.level = 1200, 60
    // the visualisers' sixteen bands (shell/ui/viz.plm reads vb0…vb15): the bar's own cava
    let vb0 = lp0
    let vb1 = lp1
    let vb2 = lp2
    let vb3 = lp3
    let vb4 = lp4
    let vb5 = lp5
    let vb6 = lp6
    let vb7 = lp7
    let vb8 = lp8
    let vb9 = lp9
    let vb10 = lp10
    let vb11 = lp11
    let vb12 = lp12
    let vb13 = lp13
    let vb14 = lp14
    let vb15 = lp15
    prop lp0 = 0.06 ~fl.level
    prop lp1 = 0.06 ~fl.level
    prop lp2 = 0.06 ~fl.level
    prop lp3 = 0.06 ~fl.level
    prop lp4 = 0.06 ~fl.level
    prop lp5 = 0.06 ~fl.level
    prop lp6 = 0.06 ~fl.level
    prop lp7 = 0.06 ~fl.level
    prop lp8 = 0.06 ~fl.level
    prop lp9 = 0.06 ~fl.level
    prop lp10 = 0.06 ~fl.level
    prop lp11 = 0.06 ~fl.level
    prop lp12 = 0.06 ~fl.level
    prop lp13 = 0.06 ~fl.level
    prop lp14 = 0.06 ~fl.level
    prop lp15 = 0.06 ~fl.level
    follow lp0 = lv0
    follow lp1 = lv1
    follow lp2 = lv2
    follow lp3 = lv3
    follow lp4 = lv4
    follow lp5 = lv5
    follow lp6 = lv6
    follow lp7 = lv7
    follow lp8 = lv8
    follow lp9 = lv9
    follow lp10 = lv10
    follow lp11 = lv11
    follow lp12 = lv12
    follow lp13 = lv13
    follow lp14 = lv14
    follow lp15 = lv15

    figure i_wifi = file "icons/wifi.svg"
    figure i_wifi_off = file "icons/wifi-off.svg"
    figure i_ethernet = file "icons/ethernet.svg"
    figure i_bt = file "icons/bluetooth.svg"
    figure i_bt_off = file "icons/bluetooth-off.svg"
    figure i_volume = file "icons/volume.svg"
    figure i_volume_mute = file "icons/volume-mute.svg"
    figure i_mic = file "icons/mic.svg"
    figure i_mic_off = file "icons/mic-off.svg"
    figure i_sun = file "icons/sun.svg"
    figure i_battery = file "icons/battery.svg"
    figure i_bolt = file "icons/bolt.svg"
    figure i_bell = file "icons/bell.svg"
    figure i_cpu = file "icons/cpu.svg"
    figure i_ram = file "icons/ram.svg"
    figure i_temp = file "icons/temp.svg"
    figure i_down = file "icons/down.svg"
    figure i_up = file "icons/up.svg"
    figure i_keyboard = file "icons/keyboard.svg"
    figure i_clear = file "icons/clear.svg"
    figure i_night = file "icons/night.svg"
    figure i_cloud = file "icons/cloud.svg"
    figure i_fog = file "icons/fog.svg"
    figure i_rain = file "icons/rain.svg"
    figure i_snow = file "icons/snow.svg"
    figure i_storm = file "icons/storm.svg"
    figure i_caffeine = file "icons/caffeine.svg"
    figure i_recorder = file "icons/recorder.svg"
    figure i_screenshot = file "icons/screenshot.svg"
    figure i_clipboard = file "icons/clipboard.svg"
    figure i_power = file "icons/power.svg"
    figure i_window = file "icons/window.svg"
    figure i_overview = file "icons/overview.svg"
    figure i_music = file "icons/music.svg"
    figure i_settings = file "icons/settings.svg"
    figure i_wallpaper = file "icons/wallpaper.svg"
    figure i_nexus = file "icons/nexus.svg"
    figure i_updates = file "icons/updates.svg"
    figure i_claude = file "icons/claude.svg"
    figure i_git = file "icons/git.svg"
    figure i_calendar = file "icons/calendar.svg"

    // The surface reserves the strip alone. What opens under it — the mark's menu — floats
    // over windows, and since pleamar commits the input region from what is painted, nothing
    // under the strip takes a click (MECHANISM.md §1).
    //
    // The keyboard clause belongs to this, the scene's FIRST surface: pleamar reads the mode
    // from it and the `while` from the last surface that declares one, so no island may carry
    // one (ARCHITECTURE.md). The bar takes the keyboard only while an island, the side panel
    // or the mark's menu is up — except the command surface in its window-actions mode, where
    // the arrows and Enter belong to the actions (§13).
    // As tall as the screen, so the bar's menu and edit shelf can open below the strip.
    // Anchored to the top, it keeps the strip's reserve (a full-height surface reserves along
    // its own edge only). The screen frame is its own surface (frame_surface, under the
    // windows): its sides and foot reserve nothing, lying in the windows' own outer gap
    // (Hyprland's gaps_out, 12 px here).
    surface {
        size: full, full
        anchor: top
        // It reserves nothing itself (-1: it lies over the whole screen, whatever else keeps
        // room): the strip the windows leave it is the reserve surfaces' (below), which change
        // with the bar's thickness and its distance from the edge while it runs — pleamar's
        // own reserve is one number, read once.
        reserve: -1
        level: top
        keyboard: exclusive while (open != none or mark_open or side != none or bar_edit or qn_open or stash_naming) and not (open == command and cmode == actions)
    }

    // ── A press outside a panel closes it (D55) ───────────────
    // A layer surface does not hear what happens outside it, so a panel used to be dismissed only
    // by its own ×, Escape or the idle timer: a press on the desktop did nothing at all, which is
    // what "my clicks are not registering" felt like. The bar's surface is the whole screen in any
    // case, so this plate — under everything else drawn in it — takes the presses the open
    // panel's own controls do not. It is declared first so every panel, its rows and its buttons
    // are above it; a press inside a panel never reaches it. The overview, the shutter and the
    // Atlas are surfaces of their own (overlay), above this one: they never see it.
    group {
        show: qn_open or mark_open or side == notes or open == window or open == system or open == command or stash_pin or open == stats or open == calendar or open == weather or open == sound or open == display or open == power or open == shnet or open == shalert or open == shupd
        zone box dismiss { from: 0, 0; size: screen.width, screen.height; role: region; label: "Close the open panel" }
        on press dismiss while qn_open { qn_open = false }
        on press dismiss while mark_open { mark_open = false }
        on press dismiss while side == notes { side = none }
        on press dismiss while open == window { open = none }
        on press dismiss while open == system { open = none }
        on press dismiss while open == command { open = none }
        on press dismiss while open == stats or open == calendar or open == weather or open == sound or open == display or open == power or open == shnet or open == shalert or open == shupd { open = none }
        on press dismiss while stash_pin { stash_pin = false }
    }

    // ── The screen frame ──────────────────────────────────────
    // ArchEclipse's Tide, in mooi: one band round the screen whose top is the bar's own strip,
    // so the bar and the frame are one piece. A `body` is a smooth union of its shapes: the
    // four bands, the fillets of their inner corners, and — while music plays (frame.music) —
    // the swell: wide lobes along each edge whose heights are a wave travelling with the
    // music's phase (`swell`), narrow drops riding the band (`crests`), or the band breathing
    // and its border catching the beat (`pulse`). The levels are cava's (shell/bar.luau): the
    // bass with a fast attack and slow release, the treble, and a phase that runs faster the
    // louder it is. The band's material follows the bar's surface (translucent for glass, never
    // glass itself: see frame_surface).
    prop flvl = 0 ~fl.level
    prop fhi = 0 ~fl.level
    prop fphs = 0 ~fl.level
    follow flvl = if(frame_music and med.playing, fbass, 0)
    follow fhi = if(frame_music and med.playing, fhigh, 0)
    follow fphs = fph
    let W = screen.width
    let H = screen.height
    let famp = flvl * frame_reach * 1.6
    let aside = if(frame_edges != 2, famp, 0)          // the sides swell
    let aflat = if(frame_edges != 1, famp, 0)          // the top (under the bar) and the bottom swell
    let fpl = if(frame_style > 1.5, 1, 0)              // pulse
    let bt = frame_band + aflat * pick(frame_style, 0.6, 0.15, 0.45)
    let bs = frame_band + aside * 0.6
    let fcol = mix(mix(fl.hull, fl.ground, bar_ground < 0.5), fl.steel_900, mech)

    // ── Ground ────────────────────────────────────────────────
    // Islands mode: the strip is black, the palette's hull, or nothing. Full mode: the panel
    // is the bar's body, so the strip itself is left clear.
    let full_w = st_width > 0.995
    let rx0 = if(full_w, 12, bar_x0 + 6)          // the rail's ends: the screen's, or the bar's
    let rx1 = if(full_w, screen.width - 12, bar_x1 - 6)
    box { from: if(full_w, 0, bar_x0), st_offset; size: if(full_w, screen.width, bar_x1 - bar_x0), st_res - st_offset; corner: if(full_w or st_offset < 1, 0, st_radius); color: if(bar_ground < 0.5, fl.ground, fl.hull)
          show: bar_ground < 1.5 and not bar_full and not st_notch and not frame_on }

    // ── The telemetry rail ────────────────────────────────────
    group {
        show: bar_rail and not st_notch
        // Keep the rail texture sparse enough to be cheap on every frame. The 16 px
        // pitch still spans a 1920 px display, while avoiding 40 always-present ellipses.
        repeat k in 0..120 {
            ellipse { at: rx0 + 28 + k * 16, fl.rail_y; radius: 0.8; color: fl.trace_dim; show: rx0 + 28 + k * 16 < rx1 - 28 }
        }
        line { from: rx0 + 4, fl.rail_base; to: rx1 - 4, fl.rail_base; width: 1.2; color: fl.trace }
        ellipse { at: rx0, fl.rail_base; radius: 2.6; color: fl.ground }
        ellipse { at: rx0, fl.rail_base; radius: 2.6; stroke: 1.2; color: fl.trace }
        ellipse { at: rx1, fl.rail_base; radius: 2.6; color: fl.ground }
        ellipse { at: rx1, fl.rail_base; radius: 2.6; stroke: 1.2; color: fl.trace }
        line { from: chain_x, fl.rail_base - 3; to: chain_x, fl.top; width: 1.2; color: fl.trace_lit
               show: bar_accents and p_workspaces and ws_style < 1.5 }
        line { from: xs_clock + 27, fl.rail_base - 3; to: xs_clock + 27, fl.top; width: 1.2; color: fl.trace_lit
               show: bar_accents and p_clock }
        // A workspace switch runs a comet along the rail: it rides the focus, its tail as long
        // as the move is fast, and it is gone the moment the instrument settles.
        let sv = clamp(vel(pos) * fl.pitch * 0.14, -70, 70)
        group {
            show: bar_accents and p_workspaces and ws_style < 1.5 and abs(sv) > 0.8
            glow: 8, (90%) * st_glow, fl.flare
            line { from: chain_x - sv, fl.rail_base; to: chain_x, fl.rail_base; width: 2; color: fl.flare; opacity: clamp(abs(sv) / 8, 0, 1) }
            ellipse { at: chain_x, fl.rail_base; radius: 2.2; color: fl.flare; opacity: clamp(abs(sv) / 8, 0, 1) }
        }

        // The mark: the rail's own left end, and the way into the bar's menu.
        // Only while the Settings module is off the bar: placed, the module is the way in.
        group {
            show: not p_settings
            zone box mark { from: rx0 + 6, st_offset; size: 46, 13; cursor: pointer
                            role: toggle; checked: settings_open; label: "mooi · settings" }
            box { from: rx0 + 8, st_offset; size: 44, 10; color: fl.ground }
            figure i_settings { at: rx0 + 23, fl.rail_y; size: 12, 12; color: mix(fl.ember, fl.phos, max(mark.hover, rv.mark)) }
            on press mark { emit bar_menu }
        }

        // The workspace scale over the instrument, its knob on the instrument's own spring.
        group {
            show: p_workspaces
            let sc_l = max(frame_x - 4, rx0 + if(p_settings, 6, 56))   // never over the mark
            let sc_x0 = sc_l + 24
            let sc_len = frame_x + ws_body - 20 - sc_x0
            let knob_x = sc_x0 + sc_len * clamp(pos / max(spaces.count - 1, 1), 0, 1)
            box { from: sc_l, st_offset; size: frame_x + ws_body + 4 - sc_l, 10; color: fl.ground }
            text "01" { at: sc_x0 - 6, fl.rail_y; anchor: right center; size: 10; family: "Share Tech Mono"; color: fl.muted }
            text "{spaces.count, 0}" { at: sc_x0 + sc_len + 6, fl.rail_y; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.muted }
            box { from: sc_x0 - 3, fl.rail_y - 2.5; size: sc_len + 6, 5; corner: 2.5; color: fl.hull_raised }
            box { from: sc_x0 - 3, fl.rail_y - 2.5; size: sc_len + 6, 5; corner: 2.5; stroke: 1; color: fl.trace }
            line { from: sc_x0, fl.rail_y; to: knob_x, fl.rail_y; width: 1.5; color: fl.phos_fill }
            ellipse { at: knob_x, fl.rail_y; radius: 3.4; color: fl.ground }
            ellipse { at: knob_x, fl.rail_y; radius: 3.4; stroke: 1.2; color: fl.trace_lit }
            ellipse { at: knob_x, fl.rail_y; radius: 1.3; color: fl.trace_lit }
        }
        group {
            show: p_media and ws_media > 60
            box { from: xs_media, st_offset; size: ws_media, 10; color: fl.ground }
            text pick(media_on, "NO CARRIER", "NOW→{upper(med.title)}") { at: xs_media + 6, fl.rail_y; anchor: left center
                  size: 10; family: "Share Tech Mono"; width: ws_media - 12; lines: 1; color: mix(fl.muted, fl.ember, media_on) }
        }
        group {
            show: p_weather and wx_ok
            box { from: xs_weather, st_offset; size: ws_weather, 10; color: fl.ground }
            text wx_city { at: xs_weather + 4, fl.rail_y; anchor: left center; size: 10; family: "Share Tech Mono"
                           width: ws_weather - 8; lines: 1; color: fl.muted }
        }
    }
    // With the rail off, the mark is a tab at the bar's left edge (again only while the Settings
    // module is off the bar).
    group {
        show: (not bar_rail or st_notch) and not p_settings
        zone box marktab { from: max(0, bar_x0 - 12), fl.top; size: 11, fl.mod_h; cursor: pointer
                           role: toggle; checked: settings_open; label: "mooi · settings" }
        figure i_settings { at: max(0, bar_x0 - 12) + (fl.mod_h - 4) / 2, fl.top + (fl.mod_h - 4) / 2; size: fl.mod_h - 4, fl.mod_h - 4; color: if(marktab.hover or rv.mark, fl.phos, fl.ink) }
        on press marktab { emit bar_menu }
    }

    // ── The helix's container ─────────────────────────────────
    // The DNA's strands are the edges of what holds the workspaces: the full panel in full
    // mode, the workspaces' own frame in islands mode (bar.helix_frame). The container's
    // edges leave the straight over the instrument and twist into the two strands — the body
    // pinching to nothing where they cross — and straighten again past it.
    let hx_a = frame_x - 2                     // the twist begins after the tag, inside the window
    let hx_b = frame_x + chain_span + 2
    let pt = fl.top
    let pb = fl.top + fl.mod_h
    let hc_x = if(bar_full, px, pick(wsf_a, xs_workspaces, xs_window, xs_media, xs_resources, xs_bandwidth, xs_keyboard, xs_weather, xs_tray, xs_notifications, xs_mic, xs_volume, xs_brightness, xs_battery, xs_network, xs_bluetooth, xs_clock, xs_caffeine, xs_recorder, xs_screenshot, xs_clipboard, xs_power, xs_actions, xs_overview, xs_core, xs_focus, xs_settings, xs_notes, xs_wallpaper))
