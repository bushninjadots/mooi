            box { color: pick(bar_surface, fl.hull, fl.hull, fl.hull, fl.hull, fl.steel_700); from: (hx_a + 180), min(mix(pt, fl.cy - amp * sin((90 - ((hx_a + 180) + 2 - chain_x) / fl.pitch * fl.dna_twist + spin)), smooth(0, 1, clamp(((hx_a + 180) + 2 - hx_a) / 14, 0, 1) * clamp((hx_b - (hx_a + 180) - 2) / 14, 0, 1))), mix(pb, fl.cy + amp * sin((90 - ((hx_a + 180) + 2 - chain_x) / fl.pitch * fl.dna_twist + spin)), smooth(0, 1, clamp(((hx_a + 180) + 2 - hx_a) / 14, 0, 1) * clamp((hx_b - (hx_a + 180) - 2) / 14, 0, 1)))); size: 6.4, max(0.5, abs(mix(pb, fl.cy + amp * sin((90 - ((hx_a + 180) + 2 - chain_x) / fl.pitch * fl.dna_twist + spin)), smooth(0, 1, clamp(((hx_a + 180) + 2 - hx_a) / 14, 0, 1) * clamp((hx_b - (hx_a + 180) - 2) / 14, 0, 1))) - mix(pt, fl.cy - amp * sin((90 - ((hx_a + 180) + 2 - chain_x) / fl.pitch * fl.dna_twist + spin)), smooth(0, 1, clamp(((hx_a + 180) + 2 - hx_a) / 14, 0, 1) * clamp((hx_b - (hx_a + 180) - 2) / 14, 0, 1))))); show: helix_edges and (hx_a + 180) < hx_b }
            box { color: pick(bar_surface, fl.hull, fl.hull, fl.hull, fl.hull, fl.steel_700); from: (hx_a + 186), min(mix(pt, fl.cy - amp * sin((90 - ((hx_a + 186) + 2 - chain_x) / fl.pitch * fl.dna_twist + spin)), smooth(0, 1, clamp(((hx_a + 186) + 2 - hx_a) / 14, 0, 1) * clamp((hx_b - (hx_a + 186) - 2) / 14, 0, 1))), mix(pb, fl.cy + amp * sin((90 - ((hx_a + 186) + 2 - chain_x) / fl.pitch * fl.dna_twist + spin)), smooth(0, 1, clamp(((hx_a + 186) + 2 - hx_a) / 14, 0, 1) * clamp((hx_b - (hx_a + 186) - 2) / 14, 0, 1)))); size: 6.4, max(0.5, abs(mix(pb, fl.cy + amp * sin((90 - ((hx_a + 186) + 2 - chain_x) / fl.pitch * fl.dna_twist + spin)), smooth(0, 1, clamp(((hx_a + 186) + 2 - hx_a) / 14, 0, 1) * clamp((hx_b - (hx_a + 186) - 2) / 14, 0, 1))) - mix(pt, fl.cy - amp * sin((90 - ((hx_a + 186) + 2 - chain_x) / fl.pitch * fl.dna_twist + spin)), smooth(0, 1, clamp(((hx_a + 186) + 2 - hx_a) / 14, 0, 1) * clamp((hx_b - (hx_a + 186) - 2) / 14, 0, 1))))); show: helix_edges and (hx_a + 186) < hx_b }
            box { color: pick(bar_surface, fl.hull, fl.hull, fl.hull, fl.hull, fl.steel_700); from: (hx_a + 192), min(mix(pt, fl.cy - amp * sin((90 - ((hx_a + 192) + 2 - chain_x) / fl.pitch * fl.dna_twist + spin)), smooth(0, 1, clamp(((hx_a + 192) + 2 - hx_a) / 14, 0, 1) * clamp((hx_b - (hx_a + 192) - 2) / 14, 0, 1))), mix(pb, fl.cy + amp * sin((90 - ((hx_a + 192) + 2 - chain_x) / fl.pitch * fl.dna_twist + spin)), smooth(0, 1, clamp(((hx_a + 192) + 2 - hx_a) / 14, 0, 1) * clamp((hx_b - (hx_a + 192) - 2) / 14, 0, 1)))); size: 6.4, max(0.5, abs(mix(pb, fl.cy + amp * sin((90 - ((hx_a + 192) + 2 - chain_x) / fl.pitch * fl.dna_twist + spin)), smooth(0, 1, clamp(((hx_a + 192) + 2 - hx_a) / 14, 0, 1) * clamp((hx_b - (hx_a + 192) - 2) / 14, 0, 1))) - mix(pt, fl.cy - amp * sin((90 - ((hx_a + 192) + 2 - chain_x) / fl.pitch * fl.dna_twist + spin)), smooth(0, 1, clamp(((hx_a + 192) + 2 - hx_a) / 14, 0, 1) * clamp((hx_b - (hx_a + 192) - 2) / 14, 0, 1))))); show: helix_edges and (hx_a + 192) < hx_b }
            box { color: pick(bar_surface, fl.hull, fl.hull, fl.hull, fl.hull, fl.steel_700); from: (hx_a + 198), min(mix(pt, fl.cy - amp * sin((90 - ((hx_a + 198) + 2 - chain_x) / fl.pitch * fl.dna_twist + spin)), smooth(0, 1, clamp(((hx_a + 198) + 2 - hx_a) / 14, 0, 1) * clamp((hx_b - (hx_a + 198) - 2) / 14, 0, 1))), mix(pb, fl.cy + amp * sin((90 - ((hx_a + 198) + 2 - chain_x) / fl.pitch * fl.dna_twist + spin)), smooth(0, 1, clamp(((hx_a + 198) + 2 - hx_a) / 14, 0, 1) * clamp((hx_b - (hx_a + 198) - 2) / 14, 0, 1)))); size: 6.4, max(0.5, abs(mix(pb, fl.cy + amp * sin((90 - ((hx_a + 198) + 2 - chain_x) / fl.pitch * fl.dna_twist + spin)), smooth(0, 1, clamp(((hx_a + 198) + 2 - hx_a) / 14, 0, 1) * clamp((hx_b - (hx_a + 198) - 2) / 14, 0, 1))) - mix(pt, fl.cy - amp * sin((90 - ((hx_a + 198) + 2 - chain_x) / fl.pitch * fl.dna_twist + spin)), smooth(0, 1, clamp(((hx_a + 198) + 2 - hx_a) / 14, 0, 1) * clamp((hx_b - (hx_a + 198) - 2) / 14, 0, 1))))); show: helix_edges and (hx_a + 198) < hx_b }
            box { color: pick(bar_surface, fl.hull, fl.hull, fl.hull, fl.hull, fl.steel_700); from: (hx_a + 204), min(mix(pt, fl.cy - amp * sin((90 - ((hx_a + 204) + 2 - chain_x) / fl.pitch * fl.dna_twist + spin)), smooth(0, 1, clamp(((hx_a + 204) + 2 - hx_a) / 14, 0, 1) * clamp((hx_b - (hx_a + 204) - 2) / 14, 0, 1))), mix(pb, fl.cy + amp * sin((90 - ((hx_a + 204) + 2 - chain_x) / fl.pitch * fl.dna_twist + spin)), smooth(0, 1, clamp(((hx_a + 204) + 2 - hx_a) / 14, 0, 1) * clamp((hx_b - (hx_a + 204) - 2) / 14, 0, 1)))); size: 6.4, max(0.5, abs(mix(pb, fl.cy + amp * sin((90 - ((hx_a + 204) + 2 - chain_x) / fl.pitch * fl.dna_twist + spin)), smooth(0, 1, clamp(((hx_a + 204) + 2 - hx_a) / 14, 0, 1) * clamp((hx_b - (hx_a + 204) - 2) / 14, 0, 1))) - mix(pt, fl.cy - amp * sin((90 - ((hx_a + 204) + 2 - chain_x) / fl.pitch * fl.dna_twist + spin)), smooth(0, 1, clamp(((hx_a + 204) + 2 - hx_a) / 14, 0, 1) * clamp((hx_b - (hx_a + 204) - 2) / 14, 0, 1))))); show: helix_edges and (hx_a + 204) < hx_b }
            box { color: pick(bar_surface, fl.hull, fl.hull, fl.hull, fl.hull, fl.steel_700); from: (hx_a + 210), min(mix(pt, fl.cy - amp * sin((90 - ((hx_a + 210) + 2 - chain_x) / fl.pitch * fl.dna_twist + spin)), smooth(0, 1, clamp(((hx_a + 210) + 2 - hx_a) / 14, 0, 1) * clamp((hx_b - (hx_a + 210) - 2) / 14, 0, 1))), mix(pb, fl.cy + amp * sin((90 - ((hx_a + 210) + 2 - chain_x) / fl.pitch * fl.dna_twist + spin)), smooth(0, 1, clamp(((hx_a + 210) + 2 - hx_a) / 14, 0, 1) * clamp((hx_b - (hx_a + 210) - 2) / 14, 0, 1)))); size: 6.4, max(0.5, abs(mix(pb, fl.cy + amp * sin((90 - ((hx_a + 210) + 2 - chain_x) / fl.pitch * fl.dna_twist + spin)), smooth(0, 1, clamp(((hx_a + 210) + 2 - hx_a) / 14, 0, 1) * clamp((hx_b - (hx_a + 210) - 2) / 14, 0, 1))) - mix(pt, fl.cy - amp * sin((90 - ((hx_a + 210) + 2 - chain_x) / fl.pitch * fl.dna_twist + spin)), smooth(0, 1, clamp(((hx_a + 210) + 2 - hx_a) / 14, 0, 1) * clamp((hx_b - (hx_a + 210) - 2) / 14, 0, 1))))); show: helix_edges and (hx_a + 210) < hx_b }
            box { color: pick(bar_surface, fl.hull, fl.hull, fl.hull, fl.hull, fl.steel_700); from: (hx_a + 216), min(mix(pt, fl.cy - amp * sin((90 - ((hx_a + 216) + 2 - chain_x) / fl.pitch * fl.dna_twist + spin)), smooth(0, 1, clamp(((hx_a + 216) + 2 - hx_a) / 14, 0, 1) * clamp((hx_b - (hx_a + 216) - 2) / 14, 0, 1))), mix(pb, fl.cy + amp * sin((90 - ((hx_a + 216) + 2 - chain_x) / fl.pitch * fl.dna_twist + spin)), smooth(0, 1, clamp(((hx_a + 216) + 2 - hx_a) / 14, 0, 1) * clamp((hx_b - (hx_a + 216) - 2) / 14, 0, 1)))); size: 6.4, max(0.5, abs(mix(pb, fl.cy + amp * sin((90 - ((hx_a + 216) + 2 - chain_x) / fl.pitch * fl.dna_twist + spin)), smooth(0, 1, clamp(((hx_a + 216) + 2 - hx_a) / 14, 0, 1) * clamp((hx_b - (hx_a + 216) - 2) / 14, 0, 1))) - mix(pt, fl.cy - amp * sin((90 - ((hx_a + 216) + 2 - chain_x) / fl.pitch * fl.dna_twist + spin)), smooth(0, 1, clamp(((hx_a + 216) + 2 - hx_a) / 14, 0, 1) * clamp((hx_b - (hx_a + 216) - 2) / 14, 0, 1))))); show: helix_edges and (hx_a + 216) < hx_b }
            box { color: pick(bar_surface, fl.hull, fl.hull, fl.hull, fl.hull, fl.steel_700); from: (hx_a + 220), min(mix(pt, fl.cy - amp * sin((90 - ((hx_a + 220) + 2 - chain_x) / fl.pitch * fl.dna_twist + spin)), smooth(0, 1, clamp(((hx_a + 220) + 2 - hx_a) / 14, 0, 1) * clamp((hx_b - (hx_a + 220) - 2) / 14, 0, 1))), mix(pb, fl.cy + amp * sin((90 - ((hx_a + 220) + 2 - chain_x) / fl.pitch * fl.dna_twist + spin)), smooth(0, 1, clamp(((hx_a + 220) + 2 - hx_a) / 14, 0, 1) * clamp((hx_b - (hx_a + 220) - 2) / 14, 0, 1)))); size: 6.4, max(0.5, abs(mix(pb, fl.cy + amp * sin((90 - ((hx_a + 220) + 2 - chain_x) / fl.pitch * fl.dna_twist + spin)), smooth(0, 1, clamp(((hx_a + 220) + 2 - hx_a) / 14, 0, 1) * clamp((hx_b - (hx_a + 220) - 2) / 14, 0, 1))) - mix(pt, fl.cy - amp * sin((90 - ((hx_a + 220) + 2 - chain_x) / fl.pitch * fl.dna_twist + spin)), smooth(0, 1, clamp(((hx_a + 220) + 2 - hx_a) / 14, 0, 1) * clamp((hx_b - (hx_a + 220) - 2) / 14, 0, 1))))); show: helix_edges and (hx_a + 220) < hx_b }
            // </gen:slices>
        }
        // The edge: straight runs and rounded ends — open where they become the strands.
        group {
            show: hc_edge
            let ec = mix(mix(mix(fl.trace, fl.trace_lit, ob), fl.phos_fill, oa), fl.steel_300, mech)
            path { stroke: st_owidth; color: ec; show: not helix_edges
                   move hc_x + hc_r, pt; line hc_x + hc_w - hc_r, pt; curve hc_x + hc_w, pt + hc_r via hc_x + hc_w, pt; line hc_x + hc_w, pb - hc_r
                   curve hc_x + hc_w - hc_r, pb via hc_x + hc_w, pb; line hc_x + hc_r, pb; curve hc_x, pb - hc_r via hc_x, pb; line hc_x, pt + hc_r
                   curve hc_x + hc_r, pt via hc_x, pt }
            path { stroke: st_owidth; color: ec; show: helix_edges
                   move hx_a, pt; line hc_x + hc_r, pt; curve hc_x, pt + hc_r via hc_x, pt; line hc_x, pb - hc_r; curve hc_x + hc_r, pb via hc_x, pb; line hx_a, pb }
            path { stroke: st_owidth; color: ec; show: helix_edges
                   move hx_b, pt; line hc_x + hc_w - hc_r, pt; curve hc_x + hc_w, pt + hc_r via hc_x + hc_w, pt; line hc_x + hc_w, pb - hc_r
                   curve hc_x + hc_w - hc_r, pb via hc_x + hc_w, pb; line hx_b, pb }
        }
    }

    // The container's corners (outline = corners): four marks at its ends.
    group {
        show: (bar_full or helix_edges) and hc_corners
        path { stroke: 1.5; color: fl.trace_lit; move hc_x, pt + 7; line hc_x, pt; line hc_x + 7, pt }
        path { stroke: 1.5; color: fl.trace_lit; move hc_x, pb - 7; line hc_x, pb; line hc_x + 7, pb }
        path { stroke: 1.5; color: fl.trace_lit; move hc_x + hc_w - 7, pt; line hc_x + hc_w, pt; line hc_x + hc_w, pt + 7 }
        path { stroke: 1.5; color: fl.trace_lit; move hc_x + hc_w - 7, pb; line hc_x + hc_w, pb; line hc_x + hc_w, pb - 7 }
    }


    // ── Notch: three pieces hanging from the top edge ─────────
    // bar.mode = notch: the left and right clusters are pieces flush with the screen's corners,
    // the centre a notch; each hangs from the top edge, its foot rounded (bar.radius) and its
    // sides met by inner fillets where it leaves the edge, of the bar's material, outline and
    // shadow. The pieces glide with the modules (`nl_`/`nc_`/`nr_`, shell/bar.luau).
    prop nlx = 0 ~fl.flow
    follow nlx = nl_x
    prop nlw = 0 ~fl.flow
    follow nlw = nl_w
    prop ncx = 0 ~fl.flow
    follow ncx = nc_x
    prop ncw = 0 ~fl.flow
    follow ncw = nc_w
    prop nrx = 0 ~fl.flow
    follow nrx = nr_x
    prop nrw = 0 ~fl.flow
    follow nrw = nr_w
    let n_pad = 10                               // the piece's room round its modules
    let n_b = fl.top + fl.mod_h + 6              // its foot
    let n_r = st_radius + 4                      // the foot's corners
    let n_f = 10                                 // the fillets where it leaves the top edge
    let nl_e = nlx + nlw + n_pad                 // the left piece's right side
    let nc_a = ncx - n_pad
    let nc_e = ncx + ncw + n_pad
    let nr_a = nrx - n_pad                       // the right piece's left side
    // ── One island's foot, as the visualiser ─────────────────────
    // An island's bottom border is the visualiser: eight bars cut from that line itself, joined at
    // their feet, stepping down into the desktop with the music — the bar's sixteen cava bands, two
    // to a bar — filled with the island's hull and stroked with its own edge, so nothing is drawn
    // beside the bar. At rest every bar sits on the line and it is the plain border it was. `x0`..`x1`
    // is the straight run between the island's two foot corners; `fy` is the foot's line.
    component BarFoot(x0: number, x1: number, fy: number) {
        size: max(1, x1 - x0), 26
        let wv_w = max(1, x1 - x0)
        let steel = bar_surface > 3.5
        let ob = clamp(st_ocol, 0, 1)
        let oa = clamp(st_ocol - 1, 0, 1)
        let wv_edge = mix(mix(mix(fl.trace, fl.trace_lit, ob), fl.phos_fill, oa), fl.steel_300, steel)
        // 0 at the floor the levels rest on (0.06), 12 px at a full band
        let wa1 = 12 * clamp(((vb0 + vb1) / 2 - 0.06) / 0.5, 0, 1)
        let wa2 = 12 * clamp(((vb2 + vb3) / 2 - 0.06) / 0.5, 0, 1)
        let wa3 = 12 * clamp(((vb4 + vb5) / 2 - 0.06) / 0.5, 0, 1)
        let wa4 = 12 * clamp(((vb6 + vb7) / 2 - 0.06) / 0.5, 0, 1)
        let wa5 = 12 * clamp(((vb8 + vb9) / 2 - 0.06) / 0.5, 0, 1)
        let wa6 = 12 * clamp(((vb10 + vb11) / 2 - 0.06) / 0.5, 0, 1)
        let wa7 = 12 * clamp(((vb12 + vb13) / 2 - 0.06) / 0.5, 0, 1)
        let wa8 = 12 * clamp(((vb14 + vb15) / 2 - 0.06) / 0.5, 0, 1)
        // the bars' feet along the run, and each bar's own line above its span
        let wx0 = x0
        let wx1 = x0 + wv_w * 1 / 8
        let wx2 = x0 + wv_w * 2 / 8
        let wx3 = x0 + wv_w * 3 / 8
        let wx4 = x0 + wv_w * 4 / 8
        let wx5 = x0 + wv_w * 5 / 8
        let wx6 = x0 + wv_w * 6 / 8
        let wx7 = x0 + wv_w * 7 / 8
        let wx8 = x1
        let wy1 = fy + wa1
        let wy2 = fy + wa2
        let wy3 = fy + wa3
        let wy4 = fy + wa4
        let wy5 = fy + wa5
        let wy6 = fy + wa6
        let wy7 = fy + wa7
        let wy8 = fy + wa8
        group {
            show: bar_foot_viz
            // the fill: the island's hull, from 3 px inside its foot out to the bars' feet
            path { color: mix(fl.hull, fl.steel_700, steel); opacity: st_opacity
                   move x0, fy - 3
                   line x1, fy - 3
                   line wx8, wy8
                   line wx7, wy8
                   line wx7, wy7
                   line wx6, wy7
                   line wx6, wy6
                   line wx5, wy6
                   line wx5, wy5
                   line wx4, wy5
                   line wx4, wy4
                   line wx3, wy4
                   line wx3, wy3
                   line wx2, wy3
                   line wx2, wy2
                   line wx1, wy2
                   line wx1, wy1
                   line wx0, wy1
                   close }
            // and its edge, which is the border itself
            path { stroke: st_owidth; color: wv_edge
                   move wx0, fy
                   line wx0, wy1
                   line wx1, wy1
                   line wx1, wy2
                   line wx2, wy2
                   line wx2, wy3
                   line wx3, wy3
                   line wx3, wy4
                   line wx4, wy4
                   line wx4, wy5
                   line wx5, wy5
                   line wx5, wy6
                   line wx6, wy6
                   line wx6, wy7
                   line wx7, wy7
                   line wx7, wy8
                   line wx8, wy8
                   line wx8, fy
                   }
        }
    }

    // At full width the side pieces sit flush in the corners; a narrower bar hangs them free.
    // The pieces are flush with the screen's corners, so their outer edge runs past it. The body
    // unions every shape it holds, so the ends go to the edge itself and the fillets' outer arms
    // stop there: off the surface, they were invisible anyway and the renderer reported the body
    // as cut by n_r + n_f on each side.
    let nl_a = max(0, if(full_w, -n_r, nlx - n_pad))
    let nr_e = min(screen.width, if(full_w, screen.width + n_r, nrx + nrw + n_pad))
    group {
        show: st_notch
        body {
            color: if(mech, fl.steel_700, fl.hull)
            opacity: if(bar_surface > 2.5 and not mech, 0, if(bar_surface > 0.5 and not mech, 0.9, 1)) * st_opacity
            glass: if(bar_surface > 0.5 and bar_surface < 2.5, 100%, 0%)
            lens: bar_surface < 1.5
            refraction: 55%
            dispersion: 35% + 165% * st_aberr
            smoke: 1% * if(bar_surface < 1.5, st_smoke, st_smoke + 8)
            frost: 1% * st_frost
            shadow: 0, st_sh_y, st_sh_blur, 100% * st_sh_a * (bar_surface < 2.5 or mech)
            // the left piece
            box { from: nl_a, -n_r; size: nl_e - nl_a, n_b + n_r; corner: n_r; show: nlw > 1 }
            path { show: nlw > 1; move nl_e, 0; line nl_e + n_f, 0; curve nl_e, n_f via nl_e, 0; close }
            path { show: nlw > 1 and not full_w; move nl_a, 0; line max(0, nl_a - n_f), 0; curve nl_a, n_f via nl_a, 0; close }
            // the notch
            box { from: nc_a, -n_r; size: nc_e - nc_a, n_b + n_r; corner: n_r; show: ncw > 1 }
            path { show: ncw > 1; move nc_a, 0; line nc_a - n_f, 0; curve nc_a, n_f via nc_a, 0; close }
            path { show: ncw > 1; move nc_e, 0; line nc_e + n_f, 0; curve nc_e, n_f via nc_e, 0; close }
            // the right piece
            box { from: nr_a, -n_r; size: nr_e - nr_a, n_b + n_r; corner: n_r; show: nrw > 1 }
            path { show: nrw > 1; move nr_a, 0; line nr_a - n_f, 0; curve nr_a, n_f via nr_a, 0; close }
            path { show: nrw > 1 and not full_w; move nr_e, 0; line min(screen.width, nr_e + n_f), 0; curve nr_e, n_f via nr_e, 0; close }
        }
        // the outline (bar.frame = line): the fillet, down the side, round the foot, and back
        group {
            show: bar_frame < 0.5
            let nec = mix(mix(mix(fl.trace, fl.trace_lit, ob), fl.phos_fill, oa), fl.steel_300, mech)
            path { stroke: st_owidth; color: nec; show: nlw > 1 and full_w
                   move 0, n_b; line nl_e - n_r, n_b; curve nl_e, n_b - n_r via nl_e, n_b; line nl_e, n_f; curve nl_e + n_f, 0 via nl_e, 0 }
            path { stroke: st_owidth; color: nec; show: nlw > 1 and not full_w
                   move max(0, nl_a - n_f), 0; curve nl_a, n_f via nl_a, 0; line nl_a, n_b - n_r; curve nl_a + n_r, n_b via nl_a, n_b
                   line nl_e - n_r, n_b; curve nl_e, n_b - n_r via nl_e, n_b; line nl_e, n_f; curve nl_e + n_f, 0 via nl_e, 0 }
            path { stroke: st_owidth; color: nec; show: ncw > 1
                   move nc_a - n_f, 0; curve nc_a, n_f via nc_a, 0; line nc_a, n_b - n_r; curve nc_a + n_r, n_b via nc_a, n_b
                   line nc_e - n_r, n_b; curve nc_e, n_b - n_r via nc_e, n_b; line nc_e, n_f; curve nc_e + n_f, 0 via nc_e, 0 }
            path { stroke: st_owidth; color: nec; show: nrw > 1 and full_w
                   move nr_a - n_f, 0; curve nr_a, n_f via nr_a, 0; line nr_a, n_b - n_r; curve nr_a + n_r, n_b via nr_a, n_b; line screen.width, n_b }
            path { stroke: st_owidth; color: nec; show: nrw > 1 and not full_w
                   move nr_a - n_f, 0; curve nr_a, n_f via nr_a, 0; line nr_a, n_b - n_r; curve nr_a + n_r, n_b via nr_a, n_b
                   line nr_e - n_r, n_b; curve nr_e, n_b - n_r via nr_e, n_b; line nr_e, n_f; curve min(screen.width, nr_e + n_f), 0 via nr_e, 0 }
        }
        // ── Each island's foot, as the visualiser ────────────────
        // Three islands, three borders: every piece's own foot line steps down into the desktop with
        // the music, filled with its hull and stroked with its own edge, so the visualiser is what the
        // bar stands on and never a band across the screen. Not on glass, blurred or clear surfaces,
        // which have no opaque fill to carry the swells.
        group {
            show: bar_frame < 0.5 and bar_surface < 0.5 and nlw > 1
            BarFoot(if(full_w, 0, nl_a + n_r), nl_e - n_r, n_b)
        }
        group {
            show: bar_frame < 0.5 and bar_surface < 0.5 and ncw > 1
            BarFoot(nc_a + n_r, nc_e - n_r, n_b)
        }
        group {
            show: bar_frame < 0.5 and bar_surface < 0.5 and nrw > 1
            BarFoot(nr_a + n_r, if(full_w, screen.width, nr_e - n_r), n_b)
        }

        // corners (bar.frame = corners): marks at each piece's foot
        group {
            show: bar_frame > 0.5 and bar_frame < 1.5
            path { stroke: st_owidth + 0.1; color: fl.trace_lit; show: nlw > 1; move nl_e - 7, n_b; line nl_e, n_b; line nl_e, n_b - 7 }
            path { stroke: st_owidth + 0.1; color: fl.trace_lit; show: ncw > 1; move nc_a + 7, n_b; line nc_a, n_b; line nc_a, n_b - 7 }
            path { stroke: st_owidth + 0.1; color: fl.trace_lit; show: ncw > 1; move nc_e - 7, n_b; line nc_e, n_b; line nc_e, n_b - 7 }
            path { stroke: st_owidth + 0.1; color: fl.trace_lit; show: nrw > 1; move nr_a + 7, n_b; line nr_a, n_b; line nr_a, n_b - 7 }
        }
    }

    // ── Islands mode: the frames ──────────────────────────────
    // A frame per group, in its style — except the workspaces', when its edges are the helix.
    // On a mechanism each group is a machined housing a little wider than its group, so
    // neighbouring housings meet at a seam and the bar reads as one machine.
    for f in frames {
        let fx = pick(f.a, xs_workspaces, xs_window, xs_media, xs_resources, xs_bandwidth, xs_keyboard, xs_weather, xs_tray, xs_notifications, xs_mic, xs_volume, xs_brightness, xs_battery, xs_network, xs_bluetooth, xs_clock, xs_caffeine, xs_recorder, xs_screenshot, xs_clipboard, xs_power, xs_actions, xs_overview, xs_core, xs_focus, xs_settings, xs_notes, xs_wallpaper)
        let fw = (pick(f.b, xs_workspaces, xs_window, xs_media, xs_resources, xs_bandwidth, xs_keyboard, xs_weather, xs_tray, xs_notifications, xs_mic, xs_volume, xs_brightness, xs_battery, xs_network, xs_bluetooth, xs_clock, xs_caffeine, xs_recorder, xs_screenshot, xs_clipboard, xs_power, xs_actions, xs_overview, xs_core, xs_focus, xs_settings, xs_notes, xs_wallpaper) + pick(f.b, ws_workspaces, ws_window, ws_media, ws_resources, ws_bandwidth, ws_keyboard, ws_weather, ws_tray, ws_notifications, ws_mic, ws_volume, ws_brightness, ws_battery, ws_network, ws_bluetooth, ws_clock, ws_caffeine, ws_recorder, ws_screenshot, ws_clipboard, ws_power, ws_actions, ws_overview, ws_core, ws_focus, ws_settings, ws_notes, ws_wallpaper)) - fx
        let own = helix_edges and f.a == wsf_a        // the workspaces' island, drawn as the helix
        group {
            show: not bar_full and not st_notch and not own
            group { show: not mech; Frame(fx - 3, fw + 6, 0, f.style) }
            group { show: mech; MechHousing(fx, fw, f.style) }
        }
        // the bay a group sits in on a mechanism (both modes)
        MechBay(fx, fw, mech and not own)
    }
    // Full mode on a mechanism: bolts at the panel's two ends.
    group {
        show: bar_full and mech
        MechBolt(px + 4, fl.cy)
        MechBolt(px + pw - 4, fl.cy)
    }
    // The hairlines between the members of a group (and, in full mode, between groups); on a
    // mechanism a group's seam in the full panel is a vent of three slots.
    for d in dividers {
        let pe = pick(d.p, xs_workspaces, xs_window, xs_media, xs_resources, xs_bandwidth, xs_keyboard, xs_weather, xs_tray, xs_notifications, xs_mic, xs_volume, xs_brightness, xs_battery, xs_network, xs_bluetooth, xs_clock, xs_caffeine, xs_recorder, xs_screenshot, xs_clipboard, xs_power, xs_actions, xs_overview, xs_core, xs_focus, xs_settings, xs_notes, xs_wallpaper) + pick(d.p, ws_workspaces, ws_window, ws_media, ws_resources, ws_bandwidth, ws_keyboard, ws_weather, ws_tray, ws_notifications, ws_mic, ws_volume, ws_brightness, ws_battery, ws_network, ws_bluetooth, ws_clock, ws_caffeine, ws_recorder, ws_screenshot, ws_clipboard, ws_power, ws_actions, ws_overview, ws_core, ws_focus, ws_settings, ws_notes, ws_wallpaper)            // where the module before the divider ends
        let ms = pick(d.m, xs_workspaces, xs_window, xs_media, xs_resources, xs_bandwidth, xs_keyboard, xs_weather, xs_tray, xs_notifications, xs_mic, xs_volume, xs_brightness, xs_battery, xs_network, xs_bluetooth, xs_clock, xs_caffeine, xs_recorder, xs_screenshot, xs_clipboard, xs_power, xs_actions, xs_overview, xs_core, xs_focus, xs_settings, xs_notes, xs_wallpaper)                          // where the one after it begins
        let dx = if(d.strong, (pe + ms) / 2, ms)
        line { from: dx, fl.top + if(d.strong, 5, 8); to: dx, fl.top + fl.mod_h - if(d.strong, 5, 8); width: 1
               color: if(d.strong, fl.trace, fl.trace_dim); show: not (mech and d.strong) and (not d.strong or ms - pe < 40) }
        group {
            show: mech and d.strong and ms - pe < 40
            box { at: dx - 3, fl.cy; size: 1.6, 16; corner: 0.8; color: fl.ground }
            box { at: dx, fl.cy; size: 1.6, 16; corner: 0.8; color: fl.ground }
            box { at: dx + 3, fl.cy; size: 1.6, 16; corner: 0.8; color: fl.ground }
        }
    }

    // ── Workspaces ────────────────────────────────────────────
    // Three instruments on one slot, switched by bar.workspaces: **DNA** — a double helix of
    // phos and ember strands, one rung per workspace, turning and sliding through the
    // bracketed focus slot, the rung arriving there morphing into the workspace's lit tag
    // (and, in full mode, its strands are the panel's own edges); **prism** — the steel helix;
    // **cells** — Ferrolume's grid, every workspace at once. All three read the same map
    // (`spaces`) and the same press: a workspace's id.
    group {
        show: p_workspaces
        zone box chain { from: frame_x, fl.top; size: ws_body, fl.mod_h
                         role: list; label: "Workspace chain" }

        // The tag, close against the instrument: the workspace in phos over its windows (×n).
        for w in spaces {
            text "W{w.id, 0}" { at: frame_x - 3, fl.cy - 6; anchor: right center; size: 13; weight: 600; family: "Exo 2"
                                color: fl.phos; show: w.active and ws_style < 2.5 }
            text "×{w.windows, 0}" { at: frame_x - 3, fl.cy + 8; anchor: right center; size: 10; weight: 600; family: "Exo 2"
                                     color: fl.ember; show: w.active and ws_style < 2.5 }
        }

        // ── DNA ──
        group {
            show: ws_style < 0.5
            let x_first = chain_x - pos * fl.pitch
            let x_last = chain_x + (spaces.count - 1 - pos) * fl.pitch
            line { from: max(frame_x, x_first - 12), fl.cy; to: min(frame_x + chain_span, x_last + 12), fl.cy
                   width: 1; color: fl.trace_dim; show: not helix_edges }
            // The strands: sampled every 6 px to keep the helix smooth with fewer segments, drawn twice —
            // the halves in front after the rungs. With the helix as the panel's edges they run
            // a little wider (the ramps into the straight), and nothing fades at the ends.
            repeat k in 0..35 {
                let x0.$k = if(helix_edges, hx_a, frame_x) + k * 6
                let xm.$k = x0.$k + 3
                let e0.$k = if(helix_edges, clamp((x0.$k - hx_a) / 14, 0, 1) * clamp((hx_b - x0.$k) / 14, 0, 1), 1)
                let e1.$k = if(helix_edges, clamp((x0.$k + 6 - hx_a) / 14, 0, 1) * clamp((hx_b - x0.$k - 6) / 14, 0, 1), 1)
                let w0.$k = e0.$k * e0.$k * (3 - 2 * e0.$k)
                let w1.$k = e1.$k * e1.$k * (3 - 2 * e1.$k)
                let p0.$k = 90 - (x0.$k - chain_x) / fl.pitch * fl.dna_twist + spin
                let p1.$k = p0.$k - 6 / fl.pitch * fl.dna_twist
                let z.$k = cos(p0.$k - 3 / fl.pitch * fl.dna_twist)
                let fade.$k = if(helix_edges, 1, clamp(min(xm.$k - frame_x, frame_x + chain_span - xm.$k) / 18, 0, 1) * clamp(min(xm.$k - x_first + 0.5 * fl.pitch, x_last + 0.5 * fl.pitch - xm.$k) / 10, 0, 1))
                let on.$k = x0.$k < if(helix_edges, hx_b, frame_x + chain_span)
                let ya0.$k = mix(pt, fl.cy - amp * sin(p0.$k), w0.$k)
                let ya1.$k = mix(pt, fl.cy - amp * sin(p1.$k), w1.$k)
                let yb0.$k = mix(pb, fl.cy + amp * sin(p0.$k), w0.$k)
                let yb1.$k = mix(pb, fl.cy + amp * sin(p1.$k), w1.$k)
                let ca.$k = mix(fl.trace, mix(fl.phos, fl.trace_dim, 0.6), w0.$k)
                let cb.$k = mix(fl.trace, mix(fl.ember, fl.trace_dim, 0.6), w0.$k)
                line { from: x0.$k, if(helix_edges, ya0.$k, fl.cy - fl.dna_amp * sin(p0.$k)); to: x0.$k + 6, if(helix_edges, ya1.$k, fl.cy - fl.dna_amp * sin(p1.$k))
                       width: if(helix_edges, 1.3, 0.8); color: ca.$k; opacity: fade.$k; show: on.$k and (z.$k < 0 or w0.$k < 0.5) }
                line { from: x0.$k, if(helix_edges, yb0.$k, fl.cy + fl.dna_amp * sin(p0.$k)); to: x0.$k + 6, if(helix_edges, yb1.$k, fl.cy + fl.dna_amp * sin(p1.$k))
                       width: if(helix_edges, 1.3, 0.8); color: cb.$k; opacity: fade.$k; show: on.$k and (z.$k >= 0 or w0.$k < 0.5) }
            }
            for w in spaces {
                let d = w.index - pos
                let ax = chain_x + d * fl.pitch
                group { move: ax, fl.cy
                        opacity: clamp(min(ax - frame_x, frame_x + chain_span - ax) / 18, 0, 1)
                        DnaBack(w, d, spin, clamp(1 - abs(d), 0, 1), amp) }
            }
            repeat k in 0..35 {
                let x0.$k = if(helix_edges, hx_a, frame_x) + k * 6
                let xm.$k = x0.$k + 3
                let e0.$k = if(helix_edges, clamp((x0.$k - hx_a) / 14, 0, 1) * clamp((hx_b - x0.$k) / 14, 0, 1), 1)
                let e1.$k = if(helix_edges, clamp((x0.$k + 6 - hx_a) / 14, 0, 1) * clamp((hx_b - x0.$k - 6) / 14, 0, 1), 1)
                let w0.$k = e0.$k * e0.$k * (3 - 2 * e0.$k)
                let w1.$k = e1.$k * e1.$k * (3 - 2 * e1.$k)
                let p0.$k = 90 - (x0.$k - chain_x) / fl.pitch * fl.dna_twist + spin
                let p1.$k = p0.$k - 6 / fl.pitch * fl.dna_twist
                let z.$k = cos(p0.$k - 3 / fl.pitch * fl.dna_twist)
                let fade.$k = if(helix_edges, 1, clamp(min(xm.$k - frame_x, frame_x + chain_span - xm.$k) / 18, 0, 1) * clamp(min(xm.$k - x_first + 0.5 * fl.pitch, x_last + 0.5 * fl.pitch - xm.$k) / 10, 0, 1))
                let on.$k = x0.$k < if(helix_edges, hx_b, frame_x + chain_span) and w0.$k >= 0.5
                let ya0.$k = mix(pt, fl.cy - amp * sin(p0.$k), w0.$k)
                let ya1.$k = mix(pt, fl.cy - amp * sin(p1.$k), w1.$k)
                let yb0.$k = mix(pb, fl.cy + amp * sin(p0.$k), w0.$k)
                let yb1.$k = mix(pb, fl.cy + amp * sin(p1.$k), w1.$k)
                line { from: x0.$k, if(helix_edges, ya0.$k, fl.cy - fl.dna_amp * sin(p0.$k)); to: x0.$k + 6, if(helix_edges, ya1.$k, fl.cy - fl.dna_amp * sin(p1.$k))
                       width: 1 + 1.2 * z.$k; color: mix(fl.trace, fl.phos, 0.35 + 0.65 * z.$k); opacity: fade.$k; show: on.$k and z.$k >= 0 }
                line { from: x0.$k, if(helix_edges, yb0.$k, fl.cy + fl.dna_amp * sin(p0.$k)); to: x0.$k + 6, if(helix_edges, yb1.$k, fl.cy + fl.dna_amp * sin(p1.$k))
                       width: 1 - 1.2 * z.$k; color: mix(fl.trace, fl.ember, 0.35 - 0.65 * z.$k); opacity: fade.$k; show: on.$k and z.$k < 0 }
            }
            for w in spaces {
                let d = w.index - pos
                let ax = chain_x + d * fl.pitch
                group { move: ax, fl.cy
                        opacity: clamp(min(ax - frame_x, frame_x + chain_span - ax) / 18, 0, 1)
                        DnaRung(w, d, spin, if(abs(ax - win_c) <= chain_span / 2, 1, 0), clamp(1 - abs(d), 0, 1), amp) }
            }
        }

        // ── Prism ──
        group {
            show: ws_style > 0.5 and ws_style < 1.5
            clip box { from: frame_x, fl.top + 1; size: chain_span, fl.mod_h - 2 }
            let sh_a = chain_x - (pos + 0.5) * fl.pitch - 2
            let sh_b = chain_x + (spaces.count - 0.5 - pos) * fl.pitch + 2
            repeat k in 0..4 {
                box { from: sh_a, fl.cy - fl.shaft_h / 2 + k * fl.shaft_h / 4; size: sh_b - sh_a, fl.shaft_h / 4 + 0.5
                      color: mix(fl.steel_500, fl.steel_900, k / 3) }
            }
            line { from: sh_a, fl.cy - fl.shaft_h / 2 + 1; to: sh_b, fl.cy - fl.shaft_h / 2 + 1; width: 1; color: fl.steel_300; opacity: 0.6 }
            repeat e in 0..2 {
                let ex.$e = if(e == 0, sh_a - 3, sh_b + 3)
                box { at: ex.$e, fl.cy; size: 6, 18; corner: 1.5; color: fl.steel_700 }
                box { from: ex.$e - 3, fl.cy - 9; size: 6, 6; corner: 1.5; color: fl.steel_500 }
                box { from: ex.$e - 3, fl.cy + 4; size: 6, 5; corner: 1.5; color: fl.steel_900 }
            }
            for w in spaces {
                let d = w.index - pos
                let ax = chain_x + d * fl.pitch
                let al = 60 - fl.helix_turn * d
                let aln = al - fl.helix_turn
                let nxt = w.index < spaces.count - 1
                let xe = ax + fl.blk_w / 2
                let xn = ax + fl.pitch - fl.blk_w / 2
                ellipse { at: ax + fl.pitch / 2, fl.cy; radius: 3.2; color: fl.steel_900; show: nxt }
                ellipse { at: ax + fl.pitch / 2, fl.cy; radius: 2.2; color: fl.steel_500; show: nxt }
                repeat j in 0..3 {
                    let a1.$j = al + 120 * j
                    let y1.$j = fl.cy + fl.prism_r * sin(a1.$j)
                    let z1.$j = (cos(a1.$j) + 1) / 2
                    let rc.$j = mix(fl.steel_700, fl.steel_300, z1.$j)
                    line { from: xe, y1.$j; to: xn, fl.cy + fl.prism_r * sin(aln + 120 * j + 120); width: 0.7 + 0.5 * z1.$j; color: rc.$j; show: nxt }
                    line { from: xe, y1.$j; to: xn, fl.cy + fl.prism_r * sin(aln + 120 * j - 120); width: 0.7 + 0.5 * z1.$j; color: rc.$j; show: nxt }
                }
                group { move: ax, fl.cy
                        opacity: clamp(min(ax - frame_x, frame_x + chain_span - ax) / 14, 0.15, 1)
                        HelixBlock(w, al, if(abs(ax - win_c) <= chain_span / 2, 1, 0), clamp(1 - abs(d), 0, 1)) }
            }
        }

        // The focus slot of the sliding instruments: four corner brackets, fixed — they give a
        // little on each arrival, like a detent taking the shaft, and the ping rings out of it.
        group {
            show: ws_style < 1.5 and not helix_edges
            let bk = 2.5 * sin(arr * 180)
            let bx0 = chain_x - fl.pitch / 2 + 1 - bk
            let bx1 = chain_x + fl.pitch / 2 - 1 + bk
            let by0 = fl.top + 2 - bk * 0.6
            let by1 = fl.top + fl.mod_h - 2 + bk * 0.6
            path { stroke: 1.2; color: mix(fl.trace_lit, fl.flare, sin(arr * 180)); move bx0, by0 + 4; line bx0, by0; line bx0 + 4, by0 }
            path { stroke: 1.2; color: mix(fl.trace_lit, fl.flare, sin(arr * 180)); move bx1 - 4, by0; line bx1, by0; line bx1, by0 + 4 }
            path { stroke: 1.2; color: mix(fl.trace_lit, fl.flare, sin(arr * 180)); move bx0, by1 - 4; line bx0, by1; line bx0 + 4, by1 }
            path { stroke: 1.2; color: mix(fl.trace_lit, fl.flare, sin(arr * 180)); move bx1 - 4, by1; line bx1, by1; line bx1, by1 - 4 }
        }
        group {
            show: ws_style < 1.5
            Ping(chain_x, fl.cy, 9)
        }

        // ── Cells ──
        // A sight frame travels from cell to cell on the liquid highlight, stretching across the
        // cells between; each cell lights as the frame covers it.
        group {
            show: ws_style > 1.5 and ws_style < 2.5
            let cp = fl.cell + fl.cell_gap
            group {
                glow: 6, (0.6) * st_glow, fl.phos
                box { from: frame_x + ws_lo * cp - 2, fl.cy - fl.cell / 2 - 2; size: (ws_hi - ws_lo) * cp + fl.cell + 4, fl.cell + 4; corner: 5
                      stroke: 1.2; color: fl.trace_lit; opacity: 0.85 }
            }
            for w in spaces { Cell(w, frame_x + w.index * cp + fl.cell / 2, clamp(min(w.index + 1 - ws_lo, ws_hi + 1 - w.index), 0, 1)) }
            Ping(frame_x + active_row * cp + fl.cell / 2, fl.cy, 9)
        }

        // ── The everyday switchers ──
        // pills (ii / iNiR): occupied workspaces sit on plates that join where neighbours are
        // occupied, and the active one is a lit pill; segments (ArchEclipse): thin bars, the
        // switcher opening under the pointer to show each workspace's app; dots: the active one a
        // lit dash; numbers: an underline. In all four the lit piece is the liquid highlight —
        // it reaches toward the next workspace and gathers there — and the ping rings on arrival.
        group {
            show: ws_style > 2.5 and ws_style < 6.5
            let wp = pick(clamp(ws_style - 3, 0, 3), 24, 20, 14, 22)
            for w in spaces {
                let pcx = frame_x + wp * (w.index + 0.5)
                box { at: pcx, fl.cy; size: 22, 22; corner: 11; color: mix(fl.hull_raised, fl.well, 0.55)
                      show: ws_style > 2.5 and ws_style < 3.5 and w.windows > 0 }
                box { from: pcx, fl.cy - 11; size: wp, 22; color: mix(fl.hull_raised, fl.well, 0.55)
                      show: ws_style > 2.5 and ws_style < 3.5 and w.joined }
            }
            // pills
            group {
                show: ws_style > 2.5 and ws_style < 3.5
                glow: 7, (0.7) * st_glow, fl.phos
                box { from: frame_x + wp * ws_lo + 1, fl.cy - 11; size: wp * (ws_hi - ws_lo) + 22, 22; corner: 11; color: fl.phos_fill }
                box { from: frame_x + wp * ws_lo + 6, fl.cy - 10; size: wp * (ws_hi - ws_lo) + 12, 1; corner: 0.5; color: fl.phos; opacity: 0.5 }
            }
            // segments
            group {
                show: ws_style > 3.5 and ws_style < 4.5
                glow: 6, (0.75) * st_glow, fl.phos
                box { from: frame_x + wp * ws_lo + 2, fl.cy - 2 - 9 * chain.hover; size: wp * (ws_hi - ws_lo) + wp - 4, 4 + 18 * chain.hover
                      corner: 2 + 2 * chain.hover; color: mix(fl.phos, fl.phos_fill, chain.hover) }
            }
            // dots: the dash, and every dot after it stepped aside to make room
            group {
                show: ws_style > 4.5 and ws_style < 5.5
                glow: 6, (0.8) * st_glow, fl.phos
                box { from: frame_x + 4 + ws_lo * 14, fl.cy - 3; size: 20 + (ws_hi - ws_lo) * 14, 6; corner: 3; color: fl.phos }
            }
            // numbers
            group {
                show: ws_style > 5.5
                glow: 6, (0.8) * st_glow, fl.phos
                box { from: frame_x + wp * ws_lo + 5, fl.cy + 9; size: wp * (ws_hi - ws_lo) + wp - 10, 2; corner: 1; color: fl.phos }
            }
            for w in spaces {
                let lit = clamp(min(w.index + 1 - ws_lo, ws_hi + 1 - w.index), 0, 1)
                ClassicWs(w, if(ws_style > 4.5 and ws_style < 5.5, frame_x + 7 + w.index * 14 + 14 * clamp(w.index - ws_lo, 0, 1),
                                frame_x + wp * (w.index + 0.5)), wp, chain.hover, lit)
            }
            Ping(if(ws_style > 4.5 and ws_style < 5.5, frame_x + 14 + active_row * 14, frame_x + wp * (active_row + 0.5)), fl.cy, if(ws_style > 4.5 and ws_style < 5.5, 6, 10))
        }

        // ── Compass: a heading tape ──
        // The workspaces are headings on a tape that slides under a fixed lubber line, as an
        // aircraft's compass does: a major tick and the number at each, minor ticks between, the
        // ends fading. The tape runs on the instrument's spring, so a switch is a turn of heading.
        group {
            show: ws_style > 6.5 and ws_style < 7.5
            let tc = frame_x + 75
            let tp = 30
            clip box { from: frame_x, fl.top; size: 150, fl.mod_h }
            line { from: frame_x, fl.cy + 10; to: frame_x + 150, fl.cy + 10; width: 1; color: fl.trace_dim }
            repeat j in 0..32 {
                let mx.$j = tc - 96 + j * 6 - mod(pos * tp, 6)
                line { from: mx.$j, fl.cy + 7; to: mx.$j, fl.cy + 10; width: 1; color: fl.trace
                       opacity: clamp(1 - abs(mx.$j - tc) / 75, 0, 1) }
            }
            for w in spaces { CompassMark(w, tc + (w.index - pos) * tp, tc) }
            // the lubber line: it kicks against the turn (the tape's speed) and flares on arrival
            let lk = clamp(vel(pos) * 1.4, -4, 4)
            group {
                glow: 6, (0.9 + 0.8 * sin(arr * 180)) * st_glow, fl.phos
                path { color: mix(fl.phos, fl.flare, sin(arr * 180)); move tc - 4 - lk, fl.top; line tc + 4 - lk, fl.top; line tc, fl.top + 5; close }
                line { from: tc, fl.cy + 4; to: tc, fl.cy + 12; width: 1.6; color: fl.phos }
            }
            Ping(tc, fl.cy - 5, 8)
        }

        // ── Radar: a scope ──
        // Each workspace is a blip at its bearing (the first at twelve o'clock), larger the more
        // windows it holds; the sweep turns to the active one on the instrument's spring, a fading
        // trail behind it, and the blip it rests on is ringed. The workspace and its windows beside.
        group {
            show: ws_style > 7.5
            let rc = frame_x + 15
            let rs = pos / max(spaces.count, 1) * 360 - 90
            ellipse { at: rc, fl.cy; radius: 13.5; color: mix(fl.ground, fl.well, 0.5) }
            ellipse { at: rc, fl.cy; radius: 13.5; stroke: 1; color: fl.trace }
            ellipse { at: rc, fl.cy; radius: 9; stroke: 1; color: fl.trace_dim }
            ellipse { at: rc, fl.cy; radius: 4.5; stroke: 1; color: fl.trace_dim }
            line { from: rc - 13, fl.cy; to: rc + 13, fl.cy; width: 0.6; color: fl.trace_dim }
            line { from: rc, fl.cy - 13; to: rc, fl.cy + 13; width: 0.6; color: fl.trace_dim }
            repeat t in 0..6 {
                line { from: rc, fl.cy; to: rc + 12.5 * cos(rs - t * 7), fl.cy + 12.5 * sin(rs - t * 7); width: 3
                       color: fl.phos; opacity: 0.22 * (1 - t / 6) }
            }
            group {
                glow: 5, (0.8) * st_glow, fl.phos
                line { from: rc, fl.cy; to: rc + 13 * cos(rs), fl.cy + 13 * sin(rs); width: 1.4; color: fl.phos }
            }
            for w in spaces { RadarBlip(w, rc, w.index / max(spaces.count, 1) * 360 - 90, rs) }
            // the contact: a ping off the blip the sweep came to rest on
            let ra = active_row / max(spaces.count, 1) * 360 - 90
            Ping(rc + 8.5 * cos(ra), fl.cy + 8.5 * sin(ra), 3)
            for w in spaces {
                text "{w.id, 0}" { at: frame_x + 36, fl.cy - 5; anchor: left center; size: 13; weight: 700; family: "Exo 2"; color: fl.phos; show: w.active }
                text "×{w.windows, 0}" { at: frame_x + 36, fl.cy + 8; anchor: left center; size: 10; weight: 600; family: "Exo 2"; color: fl.ember; show: w.active }
            }
        }
    }

    // ── Window: the focused one, its icon and title ───────────
    group {
        show: p_window
        move: xs_window, 0
        opacity: pv_window
        zone box zwin { from: 0, fl.top; size: ws_window, fl.mod_h; cursor: pointer; role: button
                        label: "Window actions — {tgt_title}" }
        Pill(ws_window, zwin.hover)
        image wicon { at: 8, fl.cy - 8; size: 16, 16; opacity: 90% }
        text "{upper(win_letter)}" { at: 16, fl.cy; anchor: center; size: 12; weight: 700; family: "Exo 2"; color: fl.phos }
        text window.class { at: 30, fl.cy - 6; anchor: left center; size: 10; family: "Share Tech Mono"; width: ws_window - 36; lines: 1; color: fl.muted }
        text window.title { at: 30, fl.cy + 7; anchor: left center; size: 12; weight: 600; family: "Exo 2"; width: ws_window - 36; lines: 1
                            shadow: 0, 1, 4, 90% * (bar_surface > 2.5 and bar_surface < 3.5), #000000
                            color: mix(fl.phos, fl.trace_lit, zwin.hover) }
        on press zwin { emit open_window }
    }

    // ── Media ─────────────────────────────────────────────────
    // Four modes (media.mode): **full** — the transport slabs, the visualizer (real audio from
    // cava, in one of four styles), the track; **compact** — the slabs and the visualizer;
    // **art** — the cover and the track; **viz** — the visualizer alone. With nothing playing
    // (media.idle) it stays as it is, collapses to a pill with the note in it, or leaves the
    // bar (the layout gives its room back). A press on the visualizer, the track, the cover or
    // the pill plays or pauses; the wheel over it is previous / next.
    let collapsed = not med.playing and media_idle < 0.5
    let mfull = media_mode < 0.5 and not collapsed
    let mcomp = media_mode > 0.5 and media_mode < 1.5 and not collapsed
    let mart = media_mode > 1.5 and media_mode < 2.5 and not collapsed
    let mviz = media_mode > 2.5 and not collapsed
    let has_viz = viz < 3.5 and (mfull or mcomp or mviz)
    let vx0 = if(mviz, 8, 47)                      // where the visualizer's bars begin
    let tx = if(mart, 34, if(has_viz, 132, 44))    // where the track's text begins
    let slabs = mfull or mcomp
    image med_cover = from med_art, 22, 22
    group {
        show: p_media
        move: xs_media, 0
        opacity: pv_media
        // The wheel skips tracks anywhere on the module. Its zone is the first, underneath: declared
        // last it covered the note, the title and the wave, and no press reached them (an idle note
        // that would not open the player). The buttons on top skip with the wheel too.
        zone box mscroll { from: 0, fl.top; size: ws_media, fl.mod_h }
        on scroll mscroll { emit media_cmd(if(wheel > 0, -1, 1)) }
        zone box wave { from: vx0 - 5, fl.top; size: 86, fl.mod_h; cursor: pointer; role: button; show: has_viz
                        active: media_on; label: pick(med.playing, "Play", "Pause") }
        zone box track { from: tx - 4, fl.top; size: ws_media - tx + 4 - if(slabs, 42, 4), fl.mod_h; cursor: pointer; role: button
                         show: mfull or mart; label: "Music player — {med.title}" }
        zone box pill { from: 0, fl.top; size: ws_media, fl.mod_h; cursor: pointer; role: button; show: collapsed
                        label: "Music player" }
        on scroll wave { emit media_cmd(if(wheel > 0, -1, 1)) }
        on scroll track { emit media_cmd(if(wheel > 0, -1, 1)) }
        on scroll pill { emit media_cmd(if(wheel > 0, -1, 1)) }
        box { from: tx - 2, fl.top + 3; size: ws_media - tx - if(slabs, 40, 4), fl.mod_h - 6; corner: 4; color: fl.hull_raised
              opacity: 0.85 * track.hover; show: mfull or mart }
        group {
            show: slabs
            Slab(6, -1, media_on, media_cmd, "Previous track")
            Slab(ws_media - 38, 1, media_on, media_cmd, "Next track")
        }

        // The collapsed pill: the note, lit while a player is there.
        group {
            show: collapsed
            Pill(ws_media, pill.hover)
            figure i_music { at: ws_media / 2, fl.cy; size: 16, 16; color: if(media_on, mix(fl.ember, fl.flare, pill.hover), fl.trace) }
        }
        // The cover (art mode), or the note where the player gives none.
        group {
            show: mart
            box { from: 6, fl.cy - 11; size: 22, 22; corner: 3; color: fl.hull_raised }
            image med_cover { at: 6, fl.cy - 11; size: 22, 22 }
            figure i_music { at: 17, fl.cy; size: 13, 13; color: fl.ember; show: not med_has_art }
            box { from: 6, fl.cy - 11; size: 22, 22; corner: 3; stroke: 1; color: fl.trace }
        }
        // Nothing on any player: one quiet line in the middle, not a flat visualizer and a dash.
        text "NOTHING PLAYING" { at: ws_media / 2, fl.cy; anchor: center; size: 10; family: "Share Tech Mono"; color: fl.muted
                                 show: not media_on and not collapsed }
        // the visualiser (shell/ui/viz.plm, the music player overhaul): the same six as the player,
        // coloured like every other module — the main accent rising into the second with the level,
        // so it follows the wallpaper and the day. bar.visualizer's four keep their look's family:
        // mirror → Mirror, bars → Spectrum, line → Aurora, dots → LED (lib/vizbands from_bar).
        group {
            show: has_viz and media_on and not viz_missing
            viz.Pick(pick(viz, 1, 0, 3, 4, 6), vx0, fl.cy - 11, 80, 22, vx0 + 40, fl.cy, 5, 6, fl.phos, fl.ember, fl.trace_dim)
        }
        // cava missing: a flat visualizer would look like silence, so it says what it needs.
        text "CAVA MISSING" { at: vx0 + 40, fl.cy; anchor: center; size: 10; family: "Share Tech Mono"; color: fl.ember
                             show: has_viz and media_on and viz_missing }
        group {
            show: (mfull or mart) and media_on
            text pick(media_on, "—", med.title) { at: tx + 4, fl.cy - 5; anchor: left center; size: 12; weight: 600
                  family: "Exo 2"; width: ws_media - tx - if(slabs, 48, 10); lines: 1; color: mix(fl.muted, mix(fl.phos, fl.trace_lit, track.hover), media_on) }
            text "{upper(med.artist)}" { at: tx + 4, fl.cy + 8; anchor: left center; size: 10; family: "Share Tech Mono"
                  width: ws_media - tx - if(slabs, 48, 10); lines: 1; color: fl.muted }
        }
        on press wave { emit media_cmd(0) }
        // A press opens the player (D88); the right press keeps play/pause, the wheel and the
        // slabs stay the transport, and the visualiser still plays and pauses.
        on press track { emit open_player(0); side = none; mark_open = false; open = none }
        on press pill { emit open_player(0); side = none; mark_open = false; open = none }
        // a right press shows the next of its views (media.mode: full → compact → art → visualizer);
        // play/pause is a left press on the visualizer, or a middle press anywhere on it
        on press right track { emit media_view }
        on press right pill { emit media_view }
        on press right wave { emit media_view }
        on press right mscroll { emit media_view }
        on press middle track { emit media_cmd(0) }
        on press middle pill { emit media_cmd(0) }
        on press middle wave { emit media_cmd(0) }
    }

    // ── Resources: processor, memory, temperature ─────────────
    // Each labelled with what it is (CPU, RAM, TMP) and hot — ember — past where it hurts.
    group {
        show: p_resources
        move: xs_resources, 0
        opacity: pv_resources
        let cpu_p = round(res_cpu * 100)
        let mem_p = round(res_mem * 100)
        let tmp_c = round(res_temp)
        zone box zres { from: 0, fl.top; size: ws_resources, fl.mod_h; cursor: pointer; role: button
                        label: "Resources — processor {cpu_p, 0} %, memory {mem_p, 0} % ({res_memgb}), {tmp_c, 0} °C" }
        on press zres while open == stats { open = none }
        on press zres while open != stats { isl_shelf = false; isl_cx = xs_resources + ws_resources / 2; open = stats; side = none; mark_open = false }
        figure i_cpu { at: 12, fl.cy; size: 15, 15; color: if(cpu_p > 85, fl.ember, fl.phos_fill) }
        Readout(23, "CPU", "{cpu_p, 0}%", cpu_p > 85)
        figure i_ram { at: 62, fl.cy; size: 15, 15; color: if(mem_p > 90, fl.ember, fl.phos_fill) }
        Readout(73, "RAM", "{mem_p, 0}%", mem_p > 90)
        figure i_temp { at: 112, fl.cy; size: 15, 15; color: if(tmp_c > 85, fl.ember, fl.phos_fill) }
        Readout(122, "TMP", "{tmp_c, 0}°", tmp_c > 85)
    }

    // ── Bandwidth: down over up ───────────────────────────────
    group {
        show: p_bandwidth
        move: xs_bandwidth, 0
        opacity: pv_bandwidth
        zone box zbw { from: 0, fl.top; size: ws_bandwidth, fl.mod_h; label: "Network throughput — down {bw_down}, up {bw_up}" }
        figure i_down { at: 12, fl.cy - 6; size: 11, 11; color: fl.phos }
        text bw_down { at: 22, fl.cy - 6; anchor: left center; size: 11; weight: 600; family: "Exo 2"; color: fl.phos }
        figure i_up { at: 12, fl.cy + 7; size: 11, 11; color: fl.ember }
        text bw_up { at: 22, fl.cy + 7; anchor: left center; size: 11; weight: 600; family: "Exo 2"; color: fl.ember }
        text "↓/s" { at: ws_bandwidth - 6, fl.cy - 6; anchor: right center; size: 10; family: "Share Tech Mono"; color: fl.muted }
        text "↑/s" { at: ws_bandwidth - 6, fl.cy + 7; anchor: right center; size: 10; family: "Share Tech Mono"; color: fl.muted }
    }

    // ── Keyboard layout ───────────────────────────────────────
    group {
        show: p_keyboard
        move: xs_keyboard, 0
        opacity: pv_keyboard
        zone box zkb { from: 0, fl.top; size: ws_keyboard, fl.mod_h; label: "Keyboard layout — {kb_name}" }
        figure i_keyboard { at: 12, fl.cy; size: 15, 15; color: fl.phos_fill }
        Readout(23, "KBD", kb_code)
    }

    // ── Weather ───────────────────────────────────────────────
    group {
        show: p_weather
        move: xs_weather, 0
        opacity: pv_weather
        zone box zwx { from: 0, fl.top; size: ws_weather, fl.mod_h; cursor: pointer; role: button; label: "Weather — {wx_word}, {wx_temp, 0} °C" }
        on press zwx while open == weather { open = none }
        on press zwx while open != weather { isl_shelf = false; isl_cx = xs_weather + ws_weather / 2; open = weather; side = none; mark_open = false }
        let wc = mix(fl.muted, fl.phos, wx_ok)
        figure i_clear { at: 13, fl.cy; size: 17, 17; color: fl.flare; show: wx_kind < 0.5 }
        figure i_night { at: 13, fl.cy; size: 17, 17; color: wc; show: wx_kind > 0.5 and wx_kind < 1.5 }
        figure i_cloud { at: 13, fl.cy; size: 17, 17; color: wc; show: wx_kind > 1.5 and wx_kind < 2.5 }
        figure i_fog { at: 13, fl.cy; size: 17, 17; color: wc; show: wx_kind > 2.5 and wx_kind < 3.5 }
        figure i_rain { at: 13, fl.cy; size: 17, 17; color: wc; show: wx_kind > 3.5 and wx_kind < 4.5 }
        figure i_snow { at: 13, fl.cy; size: 17, 17; color: wc; show: wx_kind > 4.5 and wx_kind < 5.5 }
        figure i_storm { at: 13, fl.cy; size: 17, 17; color: fl.ember; show: wx_kind > 5.5 }
        Readout(26, pick(wx_ok, "WX", wx_word), pick(wx_ok, "--", "{wx_temp, 0}°C"), false, not wx_ok)
    }

    // ── Tray ──────────────────────────────────────────────────
    group {
        show: p_tray
        move: xs_tray, 0
        opacity: pv_tray
        for t in tray_items {
            TrayIcon(t, 4 + t.index * 22, tray_cmd)
            // mooi's own glyph where it knows the program (nm-applet, blueman): the icon theme's
            // picture was missing (nothing drawn) or a grey blob, and these sit with the bar's icons
            let gx = 4 + t.index * 22 + 10
            group {
                show: t.glyph > 0.5 and t.glyph < 1.5
                figure i_wifi.a3 { at: gx, fl.cy; size: 15, 15; color: if(t.level > 0.66, fl.phos, fl.trace_dim) }
                figure i_wifi.a2 { at: gx, fl.cy; size: 15, 15; color: if(t.level > 0.33, fl.phos, fl.trace_dim) }
                figure i_wifi.a1 { at: gx, fl.cy; size: 15, 15; color: fl.phos }
                figure i_wifi.dot { at: gx, fl.cy; size: 15, 15; color: fl.phos }
            }
            figure i_ethernet { at: gx, fl.cy; size: 15, 15; color: fl.phos; show: t.glyph > 1.5 and t.glyph < 2.5 }
            figure i_wifi_off { at: gx, fl.cy; size: 15, 15; color: fl.muted; show: t.glyph > 2.5 and t.glyph < 3.5 }
            figure i_bt { at: gx, fl.cy; size: 15, 15; color: fl.phos; show: t.glyph > 3.5 and t.glyph < 4.5 }
            figure i_bt_off { at: gx, fl.cy; size: 15, 15; color: fl.muted; show: t.glyph > 4.5 }
        }
    }

    // ── Notifications ─────────────────────────────────────────
    // The bell and how many are waiting; a press opens the notices beside the bar. Beside
    // ArchEclipse the notices are ArchEclipse's (notifications.server), and the bell is off.
    group {
        show: p_notifications
        move: xs_notifications, 0
        opacity: pv_notifications
        zone box znote { from: 0, fl.top; size: ws_notifications, fl.mod_h; cursor: pointer; role: button
                         active: notes_on; label: "Notifications — {note_count, 0}" }
        Pill(ws_notifications, znote.hover)
        figure i_bell { at: 16, fl.cy; size: 17, 17; color: if(notes_on, if(note_count > 0 and not dnd_now, fl.phos, fl.trace), fl.trace_dim) }
        // do not disturb: the bell struck through
        line { from: 8, fl.cy + 8; to: 24, fl.cy - 8; width: 1.6; color: fl.ember; show: dnd_now }
        group {
            show: note_count > 0
            glow: 5, (70%) * st_glow, fl.ember
            box { at: 31, fl.cy - 6; size: 14, 11; corner: 2; color: fl.ember_fill }
        }
        text "{min(note_count, 99), 0}" { at: 31, fl.cy - 5.5; anchor: center; size: 10; weight: 700; family: "Exo 2"; color: fl.ink; show: note_count > 0 }
        on press znote while side != notes { side = notes; mark_open = false; open = none }
        on press znote while side == notes { side = none }
    }

    // ── Microphone ────────────────────────────────────────────
    group {
        show: p_mic
        move: xs_mic, 0
        opacity: pv_mic
        let ip = round(audio.input * 100)
        zone box zmic { from: 0, fl.top; size: ws_mic, fl.mod_h; cursor: pointer; role: button
                        label: pick(audio.input_muted, "Microphone — {ip, 0} %", "Microphone — muted") }
        Pill(ws_mic, zmic.hover)
        figure i_mic { at: 13, fl.cy; size: 16, 16; color: fl.phos_fill; show: not audio.input_muted }
        figure i_mic_off { at: 13, fl.cy; size: 16, 16; color: fl.ember; show: audio.input_muted }
        Readout(25, "MIC", pick(audio.input_muted, "{ip, 0}%", "OFF"), audio.input_muted)
        on press zmic { emit mic_mute }
        on scroll zmic { emit mic_vol(clamp(audio.input + 0.05 * wheel, 0, 1)) }
    }

    // ── Volume ────────────────────────────────────────────────
    // The speaker's waves light with the level; the ring is the level too. A press opens the
    // System island, the middle button mutes, the wheel turns it.
    group {
        show: p_volume
        move: xs_volume, 0
        opacity: pv_volume
        zone box zvol { from: 0, fl.top; size: ws_volume, fl.mod_h; cursor: pointer; role: button
                        label: pick(audio.muted, "Volume — {vv, 0} %", "Volume — muted") }
        Pill(ws_volume, zvol.hover)
        group {
            show: not audio.muted
            figure i_volume.body { at: 13, fl.cy; size: 17, 17; color: fl.phos_fill }
            figure i_volume.w1 { at: 13, fl.cy; size: 17, 17; color: if(audio.volume > 0.02, fl.phos, fl.trace_dim) }
            figure i_volume.w2 { at: 13, fl.cy; size: 17, 17; color: if(audio.volume > 0.5, fl.phos, fl.trace_dim) }
        }
        figure i_volume_mute { at: 13, fl.cy; size: 17, 17; color: fl.ember; show: audio.muted }
        Readout(26, "VOL", pick(audio.muted, "{vv, 0}%", "MUTE"), audio.muted)
        Ring(ws_volume - 10, fl.cy, audio.volume * (1 - audio.muted), audio.muted)
        on press zvol while open == sound { open = none }
        on press zvol while open != sound { isl_shelf = false; isl_cx = xs_volume + ws_volume / 2; open = sound; side = none; mark_open = false }
        on press middle zvol { emit mute }
        on scroll zvol { emit vol(clamp(audio.volume + 0.05 * wheel, 0, 1)) }
    }

    // ── Brightness ────────────────────────────────────────────
    group {
        show: p_brightness
        move: xs_brightness, 0
        opacity: pv_brightness
        let bl = round(brightness.level * 100)
        zone box zbri { from: 0, fl.top; size: ws_brightness, fl.mod_h; cursor: pointer; role: button; label: "Brightness — {bl, 0} %" }
        Pill(ws_brightness, zbri.hover)
        figure i_sun { at: 13, fl.cy; size: 17, 17; color: mix(fl.trace, fl.phos, clamp(brightness.level * 1.3, 0.25, 1)) }
        Readout(26, "BRI", "{bl, 0}%")
        Ring(ws_brightness - 10, fl.cy, brightness.level, false)
        on press zbri while open == display { open = none }
        on press zbri while open != display { isl_shelf = false; isl_cx = xs_brightness + ws_brightness / 2; open = display; side = none; mark_open = false }
        on scroll zbri { emit bri(clamp(brightness.level + 0.05 * wheel, 0.01, 1)) }
    }

    // ── Battery ───────────────────────────────────────────────
    group {
        show: p_battery
        move: xs_battery, 0
        opacity: pv_battery
        zone box zbat { from: 0, fl.top; size: ws_battery, fl.mod_h; cursor: pointer; role: button
                        label: pick(battery.charging, "Battery — {bb, 0} %", "Battery — {bb, 0} %, charging") }
        Pill(ws_battery, zbat.hover)
        figure i_battery { at: 14, fl.cy; size: 19, 19; color: if(low, fl.ember, fl.phos_fill) }
        box { from: 6.5, fl.cy - 2.5; size: max(1, 10.5 * battery.percent / 100), 5; color: if(low, fl.ember, fl.phos) }
        figure i_bolt { at: 13, fl.cy; size: 11, 11; color: fl.flare; show: battery.charging }
        Readout(28, "BAT", "{bb, 0}%", low)
        Ring(ws_battery - 10, fl.cy, battery.percent / 100, low)
        on press zbat while open == power { open = none }
        on press zbat while open != power { isl_shelf = false; isl_cx = xs_battery + ws_battery / 2; open = power; side = none; mark_open = false }
    }

    // ── Network ───────────────────────────────────────────────
    // The Wi-Fi glyph lights its arcs with the signal instead of swapping glyphs.
    group {
        show: p_network
        move: xs_network, 0
        opacity: pv_network
        let wired_on = network.online and network.kind == wired
        let wifi_on = network.online and network.kind != wired
        let ns = round(network.strength * 100)        // the service reports 0→1
        zone box znet { from: 0, fl.top; size: ws_network, fl.mod_h; cursor: pointer; role: button
                        label: pick(network.online, "Network — offline", "Network — {network.name}") }
        Pill(ws_network, znet.hover)
        group {
            show: wifi_on
            figure i_wifi.a3 { at: 13, fl.cy; size: 17, 17; color: if(network.strength > 0.66, fl.phos, fl.trace_dim) }
            figure i_wifi.a2 { at: 13, fl.cy; size: 17, 17; color: if(network.strength > 0.33, fl.phos, fl.trace_dim) }
            figure i_wifi.a1 { at: 13, fl.cy; size: 17, 17; color: fl.phos }
            figure i_wifi.dot { at: 13, fl.cy; size: 17, 17; color: fl.phos }
        }
        figure i_ethernet { at: 13, fl.cy; size: 17, 17; color: fl.phos; show: wired_on }
        figure i_wifi_off { at: 13, fl.cy; size: 17, 17; color: fl.muted; show: not network.online }
        Readout(26, "NET", pick(if(not network.online, 0, if(wired_on, 1, 2)), "OFF", "ETH", "{ns, 0}%"), false, not network.online)
        on press znet { sys_cx = xs_network + ws_network / 2; emit open_system }
    }

    // ── Bluetooth ─────────────────────────────────────────────
    group {
        show: p_bluetooth
        move: xs_bluetooth, 0
        opacity: pv_bluetooth
        zone box zbt { from: 0, fl.top; size: ws_bluetooth, fl.mod_h; cursor: pointer; role: button
                       label: pick(bluetooth.powered, "Bluetooth — off", "Bluetooth — on, {bt_conn, 0} connected") }
        Pill(ws_bluetooth, zbt.hover)
        figure i_bt { at: 13, fl.cy; size: 17, 17; color: if(bt_conn > 0, fl.phos, fl.phos_fill); show: bluetooth.powered }
        figure i_bt_off { at: 13, fl.cy; size: 17, 17; color: fl.muted; show: not bluetooth.powered }
        ellipse { at: 20, fl.cy - 7; radius: 1.6; color: fl.ember; show: bluetooth.discovering }
        Readout(26, "BT", pick(if(not bluetooth.powered, 0, if(bt_conn > 0, 2, 1)), "OFF", "ON", "{bt_conn, 0} DEV"), false, not bluetooth.powered)
        on press zbt { sys_cx = xs_bluetooth + ws_bluetooth / 2; emit open_system }
    }

    // ── Clock ─────────────────────────────────────────────────
    // A press opens the calendar under it; a right press cycles what it shows (clock.view).
    group {
        show: p_clock and show_clock
        move: xs_clock, 0
        zone box zclk { from: 0, fl.top; size: ws_clock, fl.mod_h; cursor: pointer; role: button
                        label: "{clock.time}, {clock.date} — the calendar (right press: what the clock shows)" }
        on press zclk while open == calendar { open = none }
        on press zclk while open != calendar { isl_shelf = false; isl_cx = xs_clock + ws_clock / 2; open = calendar; side = none; mark_open = false }
        on press right zclk { emit clock_next }
        group {
            show: st_aberr > 0.01 and clock_view < 0.5
            mode: screen
            text clock.time { at: 8 - 2.2 * st_aberr, fl.cy; anchor: left center; size: 15; weight: 600; family: "Exo 2"; color: #ff2a55; opacity: min(1, st_aberr * 2.5) * 0.8 }
            text clock.time { at: 8 + 2.2 * st_aberr, fl.cy; anchor: left center; size: 15; weight: 600; family: "Exo 2"; color: #2ae8ff; opacity: min(1, st_aberr * 2.5) * 0.8 }
        }
        group {
            show: clock_view < 0.5
            text clock.time { at: 8, fl.cy; anchor: left center; size: 15; weight: 600; family: "Exo 2"
                              color: fl.phos; shadow: 0, if(bar_surface > 2.5 and bar_surface < 3.5, 1, 0), 6, 45%, mix(fl.phos, #000000, bar_surface > 2.5 and bar_surface < 3.5) }
            text "{upper(clock.date)}" { at: 54, fl.cy + 0.5; anchor: left center; size: 10; family: "Share Tech Mono"
                                shadow: 0, 1, 4, 90% * (bar_surface > 2.5 and bar_surface < 3.5), #000000
                                         width: ws_clock - 58; lines: 1; color: fl.ember }
        }
        // the time alone, larger, in the middle
        text clock.time { at: ws_clock / 2, fl.cy; anchor: center; align: center; size: 17; weight: 600; family: "Exo 2"; color: fl.phos
                          show: clock_view > 0.5 and clock_view < 1.5 }
        // with the seconds
        text "{clock.time}:{floor(tick.second / 10), 0}{mod(tick.second, 10), 0}" { at: ws_clock / 2, fl.cy; anchor: center; align: center
                          size: 15; weight: 600; family: "Exo 2"; color: fl.phos; show: clock_view > 1.5 }
        // the minute running out under the time: an instrument's second hand, laid flat
        group {
            show: bar_accents
            line { from: 8, fl.cy + 11.5; to: ws_clock - 8, fl.cy + 11.5; width: 1; color: fl.trace_dim }
            line { from: 8, fl.cy + 11.5; to: 8 + (ws_clock - 16) * tick.second / 59, fl.cy + 11.5; width: 1; color: fl.phos; opacity: 0.8 }
        }
    }

    // ── The action buttons ────────────────────────────────────
    // Keep awake (lights while it holds the screen on), record (left: an area, right: the
    // whole screen; pressed again it stops), screenshot (left: an area, right: the screen),
    // the clipboard's history, the session (left: the menu, right: lock now), the focused
    // window's actions, the Atlas, and the core (search; right: the bar's menu).
    group {
        show: p_caffeine
        move: xs_caffeine, 0
        opacity: pv_caffeine
        zone box zcaf { from: 0, fl.top; size: ws_caffeine, fl.mod_h; cursor: pointer; role: toggle; checked: caffeine_on
                        label: pick(caffeine_on, "Keep awake — off", "Keep awake — on") }
        Pill(ws_caffeine, zcaf.hover)
        group {
            glow: 6, (if(caffeine_on, 0.8, 0)) * st_glow, fl.phos
            figure i_caffeine { at: ws_caffeine / 2, fl.cy; size: 17, 17; color: if(caffeine_on, fl.phos, mix(fl.trace, fl.phos, zcaf.hover)) }
        }
        on press zcaf { emit caffeine }
    }
    group {
        show: p_recorder
        move: xs_recorder, 0
        opacity: pv_recorder
        zone box zrec { from: 0, fl.top; size: ws_recorder, fl.mod_h; cursor: pointer; role: toggle; checked: recording
                        label: pick(recording, "Record the screen — left: an area, right: all of it", "Stop recording") }
        Pill(ws_recorder, zrec.hover)
        figure i_recorder { at: ws_recorder / 2, fl.cy; size: 17, 17; color: mix(fl.trace, fl.phos, zrec.hover); show: not recording }
        group {
            show: recording
            glow: 6, (90%) * st_glow, fl.ember
            figure i_recorder { at: ws_recorder / 2, fl.cy; size: 17, 17; color: fl.ember }
        }
        on press zrec { emit record(1) }
        on press right zrec { emit record(0) }
    }
    group {
        show: p_screenshot
        move: xs_screenshot, 0
        opacity: pv_screenshot
        zone box zshot { from: 0, fl.top; size: ws_screenshot, fl.mod_h; cursor: pointer; role: button
                         label: "Screenshot — left: an area, right: the screen" }
        Pill(ws_screenshot, zshot.hover)
        figure i_screenshot { at: ws_screenshot / 2, fl.cy; size: 17, 17; color: mix(fl.trace, fl.phos, zshot.hover) }
        on press zshot { emit shot(0) }
        on press right zshot { emit shot(1) }
    }
    group {
        show: p_clipboard
        move: xs_clipboard, 0
        opacity: pv_clipboard
        zone box zclip { from: 0, fl.top; size: ws_clipboard, fl.mod_h; cursor: pointer; role: button; label: "Clipboard history" }
        Pill(ws_clipboard, zclip.hover)
        figure i_clipboard { at: ws_clipboard / 2, fl.cy; size: 17, 17; color: mix(fl.trace, fl.phos, max(zclip.hover, side == clips)) }
        on press zclip while side != clips { emit clips; side = clips; mark_open = false; open = none }
        on press zclip while side == clips { side = none }
    }
    group {
        show: p_power
        move: xs_power, 0
        opacity: pv_power
        zone box zpow { from: 0, fl.top; size: ws_power, fl.mod_h; cursor: pointer; role: button; label: "Session — left: the menu, right: lock" }
        Pill(ws_power, zpow.hover)
        figure i_power { at: ws_power / 2, fl.cy; size: 17, 17; color: mix(fl.ember, fl.flare, zpow.hover) }
        on press zpow { emit power(0) }
        on press right zpow { emit power(1) }
    }
    group {
        show: p_actions
        move: xs_actions, 0
        opacity: pv_actions
        zone box dwin { from: 0, fl.top; size: ws_actions, fl.mod_h; cursor: pointer; role: button
                        label: "Window actions — the focused window" }
        Pill(ws_actions, max(dwin.hover, rv.window))
        figure i_window { at: ws_actions / 2, fl.cy; size: 17, 17; color: mix(fl.trace, fl.phos, max(dwin.hover, rv.window)) }
        on press dwin { emit open_window }
    }
    group {
        show: p_overview
        move: xs_overview, 0
        opacity: pv_overview
        zone box doverview { from: 0, fl.top; size: ws_overview, fl.mod_h; cursor: pointer; role: button
                             label: "Overview — every workspace zoomed out (Super+Tab)" }
        Pill(ws_overview, max(doverview.hover, ov_z))
        group {
            glow: 5, (60% * max(doverview.hover, ov_z)) * st_glow, fl.phos
            figure i_overview { at: ws_overview / 2, fl.cy; size: 16, 16; color: mix(fl.trace, fl.phos, max(doverview.hover, ov_z)) }
        }
        on press doverview { emit open_overview }
    }
    group {
        show: p_core
        move: xs_core, 0
        opacity: pv_core
        zone box core { from: 0, fl.top; size: ws_core, fl.mod_h; cursor: pointer; role: button
                        label: pick(cfg_error or theme_error, "Search — apps, windows, workspaces", "Search — and the settings need attention") }
        let cx = ws_core / 2
        let err = cfg_error or theme_error
        arc { at: cx, fl.cy; radius: 8.5; width: 4; span: 105deg; rotate: -20deg; color: mix(fl.trace, fl.trace_lit, max(core.hover, rv.command)) }
        arc { at: cx, fl.cy; radius: 8.5; width: 4; span: 120deg; rotate: 105deg; color: mix(fl.trace, fl.trace_lit, max(core.hover, rv.command)) }
        arc { at: cx, fl.cy; radius: 8.5; width: 4; span: 95deg; rotate: 230deg; color: mix(fl.trace, fl.trace_lit, max(core.hover, rv.command)) }
        group {
            glow: 6, (if(err, 1, 0.7 * max(core.hover, rv.command))) * st_glow, fl.ember
            ellipse { at: cx, fl.cy; radius: 3.4; color: if(err, fl.flare, fl.ember_fill) }
        }
        on press core { emit open_command }
        on press right core { emit bar_menu }
    }

    // ── Settings ──────────────────────────────────────────────
    // mooi's own settings, as a dial: six teeth on a ring and an index that turns a sixth of a
    // turn on its spring while you point at it, and stays turned while the settings are open —
    // the hub lit. Press: open or close the settings · right: arrange the bar (edit mode).
    group {
        show: p_settings
        move: xs_settings, 0
        opacity: pv_settings
        zone box zset { from: 0, fl.top; size: ws_settings, fl.mod_h; cursor: pointer; role: toggle
                        checked: settings_open; label: "mooi · settings (right-click: arrange the bar)" }
        Pill(ws_settings, max(zset.hover, if(settings_open, 1, 0)))
        let sd_x = ws_settings / 2
        let sd_a = max(zset.hover, if(settings_open, 1, 0))
        let sd_spin = 60deg * sd_a
        let sd_tooth = mix(fl.trace, fl.trace_lit, sd_a)
        arc { at: sd_x, fl.cy; radius: 7.6; width: 3; span: 24deg; rotate: sd_spin; color: sd_tooth }
        arc { at: sd_x, fl.cy; radius: 7.6; width: 3; span: 24deg; rotate: sd_spin + 60deg; color: sd_tooth }
        arc { at: sd_x, fl.cy; radius: 7.6; width: 3; span: 24deg; rotate: sd_spin + 120deg; color: sd_tooth }
        arc { at: sd_x, fl.cy; radius: 7.6; width: 3; span: 24deg; rotate: sd_spin + 180deg; color: sd_tooth }
        arc { at: sd_x, fl.cy; radius: 7.6; width: 3; span: 24deg; rotate: sd_spin + 240deg; color: sd_tooth }
        arc { at: sd_x, fl.cy; radius: 7.6; width: 3; span: 24deg; rotate: sd_spin + 300deg; color: sd_tooth }
        arc { at: sd_x, fl.cy; radius: 5; width: 1.4; span: 360deg; color: mix(fl.trace_lit, fl.phos, sd_a) }
        group {
            glow: 6, (0.8 * sd_a) * st_glow, fl.ember
            arc { at: sd_x, fl.cy; radius: 2.6; width: 1.6; span: 70deg; rotate: sd_spin - 125deg; color: fl.ember }
            ellipse { at: sd_x, fl.cy; radius: 1.3; color: mix(fl.ember_fill, fl.flare, if(settings_open, 1, 0)) }
        }
        on press zset { emit bar_menu }
        on press right zset { emit edit_mode(1) }
    }

    // ── Quick notes ──────────────────────────────────────────
    // The pad's page, and how many notes are on it (shell/notes.luau keeps them in notes.json).
    // A press opens the dropdown under the bar — drawn below, in this same surface — where a note
    // is written, copied or forgotten.
    group {
        show: p_notes
        move: xs_notes, 0
        opacity: pv_notes
        zone box zqn { from: 0, fl.top; size: ws_notes, fl.mod_h; cursor: pointer; role: button
                       label: pick(qn_count > 0, "Quick notes — open the pad", "Quick notes — {qn_count, 0}; open the pad") }
        Pill(ws_notes, max(zqn.hover, if(qn_open, 1, 0)))
        let qx = 16
        let qy = fl.cy
        let qtone = mix(fl.trace, fl.phos, max(zqn.hover, if(qn_open, 1, 0)))
        // a page with a folded corner and two ruled lines
        path { color: mix(fl.hull_raised, fl.well, 0.5); opacity: 0.9
               move qx - 6, qy - 8; line qx + 3, qy - 8; line qx + 6, qy - 5; line qx + 6, qy + 8; line qx - 6, qy + 8; close }
        path { stroke: 1.2; color: qtone
               move qx - 6, qy - 8; line qx + 3, qy - 8; line qx + 6, qy - 5; line qx + 6, qy + 8; line qx - 6, qy + 8; close }
        line { from: qx - 3, qy - 2; to: qx + 3, qy - 2; width: 1; color: qtone }
        line { from: qx - 3, qy + 2; to: qx + 3, qy + 2; width: 1; color: qtone }
        group {
            show: qn_count > 0
            glow: 5, (70%) * st_glow, fl.ember
            box { at: 31, fl.cy - 6; size: 14, 11; corner: 2; color: fl.ember_fill }
        }
        text "{min(qn_count, 99), 0}" { at: 31, fl.cy - 5.5; anchor: center; size: 10; weight: 700; family: "Exo 2"; color: fl.ink; show: qn_count > 0 }
        on press zqn { emit qn_toggle; side = none; mark_open = false; open = none }
    }

    // ── Wallpaper studio (D57) ───────────────────────────────
    // Lumen's door: a framed picture. A press opens the studio (a program of its own); it is
    // closed from inside, by Esc or the corner.
    group {
        show: p_wallpaper
        move: xs_wallpaper, 0
        opacity: pv_wallpaper
        zone box zwp { from: 0, fl.top; size: ws_wallpaper, fl.mod_h; cursor: pointer; role: button
                       label: "Wallpaper studio — pick a picture and grade it" }
        Pill(ws_wallpaper, zwp.hover)
        // a figure's `at` is its centre (D84), so the picture sits in the middle of its pill
        figure i_wallpaper { at: ws_wallpaper / 2, fl.cy; size: 17, 17
                             color: mix(fl.trace, fl.phos, zwp.hover) }
        on press zwp { emit open_wallpaper; side = none; mark_open = false; open = none }
    }

    // ── System updates ───────────────────────────────────────
    // A tray with an arrow into it: dim when all is up to date, lit with the count (as the bell's)
    // when updates wait, breathing while it looks. A press runs the updater in a terminal (paru or
    // yay, then Flatpak); the rule under it stays lit while that is open.
    group {
        show: p_updates
        move: xs_updates, 0
        opacity: pv_updates
        let ulit = max(zupd.hover, if(upd_running, 1, 0))
        zone box zupd { from: 0, fl.top; size: ws_updates, fl.mod_h; cursor: pointer; role: button
                        label: "System updates — {upd_t}" }
        Pill(ws_updates, ulit)
        figure i_updates { at: 16, fl.cy; size: 17, 17
                           color: if(upd_n > 0, mix(fl.phos, fl.engrave, 0.15 * (1 - ulit)), mix(fl.trace, fl.trace_lit, ulit))
                           opacity: if(upd_busy, 0.55 + 0.45 * abs(cos(upd_pulse)), 1) }
        group {
            show: upd_n > 0
            glow: 5, (70%) * st_glow, fl.ember
            box { at: 31, fl.cy - 6; size: 16, 11; corner: 2; color: fl.ember_fill }
        }
        text "{min(upd_n, 99), 0}" { at: 31, fl.cy - 5.5; anchor: center; size: 10; weight: 700; family: "Exo 2"; color: fl.ink; show: upd_n > 0 }
        box { from: ws_updates / 2 - 6, fl.top + fl.mod_h - 4; size: 12, 2; corner: 1; color: fl.phos; opacity: if(upd_running, 0.95, 0) }
        on press zupd { emit run_updates; side = none; mark_open = false; open = none }
    }

    // ── Claude and GitHub (D106): doors to the side notch's panels ──
    // Claude: the sparkle; a press opens the chat beside the notch. GitHub: the branch, the count of
    // what waits for you there (read by the notch); a press opens your GitHub panel.
    group {
        show: p_claude
        move: xs_claude, 0
        opacity: pv_claude
        zone box zcl { from: 0, fl.top; size: ws_claude, fl.mod_h; cursor: pointer; role: button; label: "Claude: ask anything" }
        Pill(ws_claude, zcl.hover)
        figure i_claude { at: ws_claude / 2, fl.cy; size: 16, 16; color: mix(fl.trace_lit, fl.phos, zcl.hover) }
        on press zcl { emit open_claude; side = none; mark_open = false; open = none }
    }
    group {
        show: p_github
        move: xs_github, 0
        opacity: pv_github
        zone box zgh { from: 0, fl.top; size: ws_github, fl.mod_h; cursor: pointer; role: button; label: "GitHub: your repositories, pull requests and activity" }
        Pill(ws_github, zgh.hover)
        figure i_git { at: ws_github / 2, fl.cy; size: 16, 16; color: mix(fl.trace_lit, fl.phos, zgh.hover) }
        group {
            show: gh_unread > 0
            glow: 5, (70%) * st_glow, fl.ember
            box { at: ws_github - 7, fl.cy - 7; size: 12, 9; corner: 2; color: fl.ember_fill }
        }
        on press zgh { emit open_github; side = none; mark_open = false; open = none }
    }

    // ── Control Nexus (D65) ──────────────────────────────────
    // The system command centre's door: the Arch mark. A press opens the Nexus program (a
    // full-screen overlay of its own); the same press again, Escape there or an outside press
    // closes it. The dot is live while the program is up.
    group {
        show: p_nexus
        move: xs_nexus, 0
        opacity: pv_nexus
        let nlit = max(znx.hover, if(nexus_open, 1, 0))
        zone box znx { from: 0, fl.top; size: ws_nexus, fl.mod_h; cursor: pointer; role: toggle
                       checked: nexus_open; label: "Control Nexus — the system command centre" }
        Pill(ws_nexus, nlit)
        // the mark: a core in its orbit, lit while the Nexus is up, and a rule under it
        group {
            glow: 3, 35% * st_glow * if(nexus_open, 1, 0), fl.phos
            figure i_nexus { at: ws_nexus / 2, fl.cy - if(nexus_open, 1, 0); size: 17, 17
                             color: mix(mix(fl.trace_lit, fl.engrave, 0.25), mix(fl.phos, fl.engrave, 0.35), nlit) }
        }
        box { from: ws_nexus / 2 - 6, fl.top + fl.mod_h - 4; size: 12, 2; corner: 1; color: fl.phos; opacity: if(nexus_open, 0.95, 0) }
        on press znx { emit open_nexus; side = none; mark_open = false; open = none }
    }

    // ── Focus timer ───────────────────────────────────────────
    // A block of work, then a break (shell/bar.luau keeps the time). The ring is what is left:
    // phos while you work, ember on the break, dark at rest — light means live. Press: start or
    // stop · right: skip to what comes next · wheel, at rest: the block's length, 5 to 90 min.
    group {
        show: p_focus
        move: xs_focus, 0
        opacity: pv_focus
        let fon = foc_state > 0.5
        let fbrk = foc_state > 1.5
        zone box zfoc { from: 0, fl.top; size: ws_focus, fl.mod_h; cursor: pointer; role: toggle; checked: fon
                        label: pick(foc_state, "Focus timer — {foc_len, 0} minutes; press to start", "Focus — {foc_left} left; press to stop", "Break — {foc_left} left") }
        Pill(ws_focus, zfoc.hover)
        arc { at: 15, fl.cy; radius: 8; width: 1.4; span: 360deg; color: fl.trace_dim }
        group {
            glow: 6, (if(fon, 0.7, 0)) * st_glow, if(fbrk, fl.ember, fl.phos)
            arc { at: 15, fl.cy; radius: 8; width: 2.4; span: foc_frac * 360deg; rotate: foc_frac * 180deg; color: if(fbrk, fl.ember, fl.phos); show: fon }
        }
        // at rest a start mark inside the ring, running a stop square
        path { color: mix(fl.trace_lit, fl.phos, zfoc.hover); show: not fon; move 13, fl.cy - 4; line 18.5, fl.cy; line 13, fl.cy + 4; close }
        box { at: 15, fl.cy; size: 5, 5; corner: 1; color: mix(if(fbrk, fl.ember, fl.phos), fl.flare, zfoc.hover); show: fon }
        Readout(29, pick(foc_state, "FOCUS", "FOCUS", "BREAK"), pick(foc_state, "{foc_len, 0} MIN", foc_left, foc_left), fbrk, not fon)
        on press zfoc { emit focus_cmd(0) }
        on press right zfoc { emit focus_cmd(1) }
        on scroll zfoc { emit focus_cmd(if(wheel > 0, 2, 3)) }
    }

    // ── Edit mode ─────────────────────────────────────────────
    // The bar as a workbench (the settings window's "Edit bar layout"): every placed module
    // outlined and picked up by a press, carried by the pointer (the others make room live,
    // shell/bar.luau plans each step), dropped beside a module to go there, on a module's
    // middle to join its group, or on the shelf below the bar to leave it. The shelf holds
    // every module that is not on the bar; dragged up onto the bar, one is placed. Escape
    // puts the layout back as edit mode found it.
    on change bar_edit { emit edit_mode(bar_edit) }
    on change screen.width { emit screen_w(screen.width) }
    on change round(ed_x / 6) + 1000 * round(ed_y / 30) while ed_drag >= 0 { emit edit_hover(ed_drag * 100000 + round(clamp(ed_x, 0, 49999)) + if(ed_y > st_res + 4, 50000, 0)) }
    on change pointer.x + 10000 * pointer.y while ed_drag >= 0 { ed_x = pointer.x; ed_y = pointer.y }
    on key Escape while bar_edit and ed_sel >= 0 { ed_sel = -1 }
    on key Escape while bar_edit and ed_sel < 0 { emit edit_cancel; ed_drag = -1; bar_edit = false }
    on edit_toggle { toggle bar_edit; ed_sel = -1 }
    on change bar_edit while not bar_edit { ed_sel = -1; ed_drag = -1 }
    on ed_grab(v) { ed_drag = v; ed_x = pointer.x; ed_y = pointer.y }
    on ed_release(v) while ed_drag == v { emit edit_drop(ed_drag * 100000 + round(clamp(ed_x, 0, 49999)) + if(ed_y > st_res + 4, 50000, 0)); ed_drag = -1 }
    group {
        show: bar_edit
        // The shelf, under the bar: what to do, the modules not on the bar, and the way out.
        // The chips wrap in rows of 12 (a literal: grid columns are fixed), short of Reset and
        // Done on any screen 1600 px wide or more; the plate grows with the rows.
        let shelf_rows = max(1, ceil(shelf_items.count / 12))
        FlPlate(screen.width - 24, 78 + 34 * (shelf_rows - 1)) {
            move: 12, st_res + 6
            text "EDIT BAR · DRAG A MODULE ANYWHERE: IT STAYS WHERE YOU LET GO · ON ANOTHER'S MIDDLE IT JOINS ITS GROUP · DROP IT HERE TO HIDE IT · ESC CANCELS" {
                 at: 14, 14; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.ember }
            grid {
                at: 14, 32
                columns: 12
                width: 1314          // 12 chips of 104 and their gaps
                gap: 6
                row: 34              // a chip's 28 and the gap under it
                for c in shelf_items { ShelfChip(c, ed_grab, ed_release) }
            }
            text "Every module is on the bar." { at: 14, 46; anchor: left center; size: 12; family: "Exo 2"; color: fl.muted; show: shelf_items.count < 1 }
        }
        SButton(screen.width - 232, st_res + 46, 96, "Reset", set_action, 2)
        SButton(screen.width - 128, st_res + 46, 96, "Done", set_action, 3, true)
        // The spacers and gaps, which are otherwise only room: hatched, with an × to take one out.
        for g in edit_gaps {
            EditGap(g, edit_gap)
        }
    }
    on set_action(v) while v == 2 { emit edit_reset }
    on set_action(v) while v == 3 { bar_edit = false; ed_drag = -1 }
    // The ghost: the module being carried, under the pointer — phos to move, ember to join a
    // group, muted over the shelf (to hide it).
    // Over the bar, where it will land: its outline at the pointer, a line through its middle.
    group {
        show: ed_drag >= 0 and ed_y <= st_res + 4 and not ed_merge
        let gw = pick(max(ed_drag, 0), ws_workspaces, ws_window, ws_media, ws_resources, ws_bandwidth, ws_keyboard, ws_weather, ws_tray, ws_notifications, ws_mic, ws_volume, ws_brightness, ws_battery, ws_network, ws_bluetooth, ws_clock, ws_caffeine, ws_recorder, ws_screenshot, ws_clipboard, ws_power, ws_actions, ws_overview, ws_core, ws_focus, ws_settings, ws_notes, ws_wallpaper)
        box { at: ed_x, fl.cy; size: gw, fl.mod_h; corner: fl.radius; stroke: 1.4; color: fl.phos; opacity: 0.9 }
        line { from: ed_x, fl.top - 3; to: ed_x, fl.top + fl.mod_h + 3; width: 1; color: fl.flare }
    }
    group {
        show: ed_drag >= 0
        glow: 8, (70%) * st_glow, if(ed_merge, fl.ember, fl.phos)
        box { at: ed_x, ed_y + 2; size: 132, 34; corner: 7; color: if(ed_y > st_res + 4, fl.muted, if(ed_merge, fl.ember_fill, fl.phos_fill)); opacity: 0.95 }
    }
    // <gen:edit>
    group {
        show: bar_edit and p_workspaces
        zone box ez_workspaces { from: xs_workspaces, fl.top; size: ws_workspaces, fl.mod_h; cursor: grab; role: button; label: "Move Workspaces" }
        box { from: xs_workspaces + 1, fl.top + 1; size: ws_workspaces - 2, fl.mod_h - 2; corner: 5; color: if(ed_drag == 0 and ed_merge, fl.ember_fill, fl.well)
              opacity: if(ed_drag == 0, 0.6, if(ed_sel == 0, 0.4, 0.2 * ez_workspaces.hover)) }
        box { from: xs_workspaces + 1, fl.top + 1; size: ws_workspaces - 2, fl.mod_h - 2; corner: 5; stroke: if(ed_sel == 0, 2, 1.2)
              color: if(ed_sel == 0 or ed_drag == 0, fl.flare, mix(fl.trace_lit, fl.flare, ez_workspaces.hover)); opacity: if(ed_drag >= 0 and ed_drag != 0, 0.45, 0.85) }
    }
    on press ez_workspaces while bar_edit { ed_press = 0; ed_px = pointer.x; ed_x = pointer.x; ed_y = pointer.y }
    on drag ez_workspaces while ed_press == 0 and ed_drag < 0 and abs(pointer.x - ed_px) > 5 { ed_drag = 0; ed_sel = -1 }
    on release ez_workspaces while ed_drag == 0 { emit edit_drop(ed_drag * 100000 + round(clamp(ed_x, 0, 49999)) + if(ed_y > st_res + 4, 50000, 0)); ed_drag = -1; ed_press = -1 }
    on release ez_workspaces while ed_drag < 0 and ed_press == 0 { ed_sel = if(ed_sel == 0, -1, 0); ed_press = -1 }
    group {
        show: bar_edit and p_window
        zone box ez_window { from: xs_window, fl.top; size: ws_window, fl.mod_h; cursor: grab; role: button; label: "Move Window title" }
        box { from: xs_window + 1, fl.top + 1; size: ws_window - 2, fl.mod_h - 2; corner: 5; color: if(ed_drag == 1 and ed_merge, fl.ember_fill, fl.well)
              opacity: if(ed_drag == 1, 0.6, if(ed_sel == 1, 0.4, 0.2 * ez_window.hover)) }
        box { from: xs_window + 1, fl.top + 1; size: ws_window - 2, fl.mod_h - 2; corner: 5; stroke: if(ed_sel == 1, 2, 1.2)
              color: if(ed_sel == 1 or ed_drag == 1, fl.flare, mix(fl.trace_lit, fl.flare, ez_window.hover)); opacity: if(ed_drag >= 0 and ed_drag != 1, 0.45, 0.85) }
    }
    on press ez_window while bar_edit { ed_press = 1; ed_px = pointer.x; ed_x = pointer.x; ed_y = pointer.y }
    on drag ez_window while ed_press == 1 and ed_drag < 0 and abs(pointer.x - ed_px) > 5 { ed_drag = 1; ed_sel = -1 }
    on release ez_window while ed_drag == 1 { emit edit_drop(ed_drag * 100000 + round(clamp(ed_x, 0, 49999)) + if(ed_y > st_res + 4, 50000, 0)); ed_drag = -1; ed_press = -1 }
    on release ez_window while ed_drag < 0 and ed_press == 1 { ed_sel = if(ed_sel == 1, -1, 1); ed_press = -1 }
    group {
        show: bar_edit and p_media
        zone box ez_media { from: xs_media, fl.top; size: ws_media, fl.mod_h; cursor: grab; role: button; label: "Move Media player" }
        box { from: xs_media + 1, fl.top + 1; size: ws_media - 2, fl.mod_h - 2; corner: 5; color: if(ed_drag == 2 and ed_merge, fl.ember_fill, fl.well)
              opacity: if(ed_drag == 2, 0.6, if(ed_sel == 2, 0.4, 0.2 * ez_media.hover)) }
        box { from: xs_media + 1, fl.top + 1; size: ws_media - 2, fl.mod_h - 2; corner: 5; stroke: if(ed_sel == 2, 2, 1.2)
              color: if(ed_sel == 2 or ed_drag == 2, fl.flare, mix(fl.trace_lit, fl.flare, ez_media.hover)); opacity: if(ed_drag >= 0 and ed_drag != 2, 0.45, 0.85) }
    }
    on press ez_media while bar_edit { ed_press = 2; ed_px = pointer.x; ed_x = pointer.x; ed_y = pointer.y }
    on drag ez_media while ed_press == 2 and ed_drag < 0 and abs(pointer.x - ed_px) > 5 { ed_drag = 2; ed_sel = -1 }
    on release ez_media while ed_drag == 2 { emit edit_drop(ed_drag * 100000 + round(clamp(ed_x, 0, 49999)) + if(ed_y > st_res + 4, 50000, 0)); ed_drag = -1; ed_press = -1 }
    on release ez_media while ed_drag < 0 and ed_press == 2 { ed_sel = if(ed_sel == 2, -1, 2); ed_press = -1 }
    group {
        show: bar_edit and p_resources
        zone box ez_resources { from: xs_resources, fl.top; size: ws_resources, fl.mod_h; cursor: grab; role: button; label: "Move Resources" }
        box { from: xs_resources + 1, fl.top + 1; size: ws_resources - 2, fl.mod_h - 2; corner: 5; color: if(ed_drag == 3 and ed_merge, fl.ember_fill, fl.well)
              opacity: if(ed_drag == 3, 0.6, if(ed_sel == 3, 0.4, 0.2 * ez_resources.hover)) }
        box { from: xs_resources + 1, fl.top + 1; size: ws_resources - 2, fl.mod_h - 2; corner: 5; stroke: if(ed_sel == 3, 2, 1.2)
              color: if(ed_sel == 3 or ed_drag == 3, fl.flare, mix(fl.trace_lit, fl.flare, ez_resources.hover)); opacity: if(ed_drag >= 0 and ed_drag != 3, 0.45, 0.85) }
    }
    on press ez_resources while bar_edit { ed_press = 3; ed_px = pointer.x; ed_x = pointer.x; ed_y = pointer.y }
    on drag ez_resources while ed_press == 3 and ed_drag < 0 and abs(pointer.x - ed_px) > 5 { ed_drag = 3; ed_sel = -1 }
    on release ez_resources while ed_drag == 3 { emit edit_drop(ed_drag * 100000 + round(clamp(ed_x, 0, 49999)) + if(ed_y > st_res + 4, 50000, 0)); ed_drag = -1; ed_press = -1 }
    on release ez_resources while ed_drag < 0 and ed_press == 3 { ed_sel = if(ed_sel == 3, -1, 3); ed_press = -1 }
    group {
        show: bar_edit and p_bandwidth
        zone box ez_bandwidth { from: xs_bandwidth, fl.top; size: ws_bandwidth, fl.mod_h; cursor: grab; role: button; label: "Move Bandwidth" }
        box { from: xs_bandwidth + 1, fl.top + 1; size: ws_bandwidth - 2, fl.mod_h - 2; corner: 5; color: if(ed_drag == 4 and ed_merge, fl.ember_fill, fl.well)
              opacity: if(ed_drag == 4, 0.6, if(ed_sel == 4, 0.4, 0.2 * ez_bandwidth.hover)) }
        box { from: xs_bandwidth + 1, fl.top + 1; size: ws_bandwidth - 2, fl.mod_h - 2; corner: 5; stroke: if(ed_sel == 4, 2, 1.2)
              color: if(ed_sel == 4 or ed_drag == 4, fl.flare, mix(fl.trace_lit, fl.flare, ez_bandwidth.hover)); opacity: if(ed_drag >= 0 and ed_drag != 4, 0.45, 0.85) }
    }
    on press ez_bandwidth while bar_edit { ed_press = 4; ed_px = pointer.x; ed_x = pointer.x; ed_y = pointer.y }
    on drag ez_bandwidth while ed_press == 4 and ed_drag < 0 and abs(pointer.x - ed_px) > 5 { ed_drag = 4; ed_sel = -1 }
    on release ez_bandwidth while ed_drag == 4 { emit edit_drop(ed_drag * 100000 + round(clamp(ed_x, 0, 49999)) + if(ed_y > st_res + 4, 50000, 0)); ed_drag = -1; ed_press = -1 }
    on release ez_bandwidth while ed_drag < 0 and ed_press == 4 { ed_sel = if(ed_sel == 4, -1, 4); ed_press = -1 }
    group {
        show: bar_edit and p_keyboard
        zone box ez_keyboard { from: xs_keyboard, fl.top; size: ws_keyboard, fl.mod_h; cursor: grab; role: button; label: "Move Keyboard layout" }
        box { from: xs_keyboard + 1, fl.top + 1; size: ws_keyboard - 2, fl.mod_h - 2; corner: 5; color: if(ed_drag == 5 and ed_merge, fl.ember_fill, fl.well)
              opacity: if(ed_drag == 5, 0.6, if(ed_sel == 5, 0.4, 0.2 * ez_keyboard.hover)) }
        box { from: xs_keyboard + 1, fl.top + 1; size: ws_keyboard - 2, fl.mod_h - 2; corner: 5; stroke: if(ed_sel == 5, 2, 1.2)
              color: if(ed_sel == 5 or ed_drag == 5, fl.flare, mix(fl.trace_lit, fl.flare, ez_keyboard.hover)); opacity: if(ed_drag >= 0 and ed_drag != 5, 0.45, 0.85) }
    }
    on press ez_keyboard while bar_edit { ed_press = 5; ed_px = pointer.x; ed_x = pointer.x; ed_y = pointer.y }
    on drag ez_keyboard while ed_press == 5 and ed_drag < 0 and abs(pointer.x - ed_px) > 5 { ed_drag = 5; ed_sel = -1 }
    on release ez_keyboard while ed_drag == 5 { emit edit_drop(ed_drag * 100000 + round(clamp(ed_x, 0, 49999)) + if(ed_y > st_res + 4, 50000, 0)); ed_drag = -1; ed_press = -1 }
    on release ez_keyboard while ed_drag < 0 and ed_press == 5 { ed_sel = if(ed_sel == 5, -1, 5); ed_press = -1 }
    group {
        show: bar_edit and p_weather
        zone box ez_weather { from: xs_weather, fl.top; size: ws_weather, fl.mod_h; cursor: grab; role: button; label: "Move Weather" }
        box { from: xs_weather + 1, fl.top + 1; size: ws_weather - 2, fl.mod_h - 2; corner: 5; color: if(ed_drag == 6 and ed_merge, fl.ember_fill, fl.well)
              opacity: if(ed_drag == 6, 0.6, if(ed_sel == 6, 0.4, 0.2 * ez_weather.hover)) }
        box { from: xs_weather + 1, fl.top + 1; size: ws_weather - 2, fl.mod_h - 2; corner: 5; stroke: if(ed_sel == 6, 2, 1.2)
              color: if(ed_sel == 6 or ed_drag == 6, fl.flare, mix(fl.trace_lit, fl.flare, ez_weather.hover)); opacity: if(ed_drag >= 0 and ed_drag != 6, 0.45, 0.85) }
    }
    on press ez_weather while bar_edit { ed_press = 6; ed_px = pointer.x; ed_x = pointer.x; ed_y = pointer.y }
    on drag ez_weather while ed_press == 6 and ed_drag < 0 and abs(pointer.x - ed_px) > 5 { ed_drag = 6; ed_sel = -1 }
    on release ez_weather while ed_drag == 6 { emit edit_drop(ed_drag * 100000 + round(clamp(ed_x, 0, 49999)) + if(ed_y > st_res + 4, 50000, 0)); ed_drag = -1; ed_press = -1 }
    on release ez_weather while ed_drag < 0 and ed_press == 6 { ed_sel = if(ed_sel == 6, -1, 6); ed_press = -1 }
    group {
        show: bar_edit and p_tray
        zone box ez_tray { from: xs_tray, fl.top; size: ws_tray, fl.mod_h; cursor: grab; role: button; label: "Move Tray" }
        box { from: xs_tray + 1, fl.top + 1; size: ws_tray - 2, fl.mod_h - 2; corner: 5; color: if(ed_drag == 7 and ed_merge, fl.ember_fill, fl.well)
              opacity: if(ed_drag == 7, 0.6, if(ed_sel == 7, 0.4, 0.2 * ez_tray.hover)) }
        box { from: xs_tray + 1, fl.top + 1; size: ws_tray - 2, fl.mod_h - 2; corner: 5; stroke: if(ed_sel == 7, 2, 1.2)
              color: if(ed_sel == 7 or ed_drag == 7, fl.flare, mix(fl.trace_lit, fl.flare, ez_tray.hover)); opacity: if(ed_drag >= 0 and ed_drag != 7, 0.45, 0.85) }
    }
    on press ez_tray while bar_edit { ed_press = 7; ed_px = pointer.x; ed_x = pointer.x; ed_y = pointer.y }
    on drag ez_tray while ed_press == 7 and ed_drag < 0 and abs(pointer.x - ed_px) > 5 { ed_drag = 7; ed_sel = -1 }
    on release ez_tray while ed_drag == 7 { emit edit_drop(ed_drag * 100000 + round(clamp(ed_x, 0, 49999)) + if(ed_y > st_res + 4, 50000, 0)); ed_drag = -1; ed_press = -1 }
    on release ez_tray while ed_drag < 0 and ed_press == 7 { ed_sel = if(ed_sel == 7, -1, 7); ed_press = -1 }
    group {
        show: bar_edit and p_notifications
        zone box ez_notifications { from: xs_notifications, fl.top; size: ws_notifications, fl.mod_h; cursor: grab; role: button; label: "Move Notifications" }
        box { from: xs_notifications + 1, fl.top + 1; size: ws_notifications - 2, fl.mod_h - 2; corner: 5; color: if(ed_drag == 8 and ed_merge, fl.ember_fill, fl.well)
              opacity: if(ed_drag == 8, 0.6, if(ed_sel == 8, 0.4, 0.2 * ez_notifications.hover)) }
        box { from: xs_notifications + 1, fl.top + 1; size: ws_notifications - 2, fl.mod_h - 2; corner: 5; stroke: if(ed_sel == 8, 2, 1.2)
              color: if(ed_sel == 8 or ed_drag == 8, fl.flare, mix(fl.trace_lit, fl.flare, ez_notifications.hover)); opacity: if(ed_drag >= 0 and ed_drag != 8, 0.45, 0.85) }
    }
    on press ez_notifications while bar_edit { ed_press = 8; ed_px = pointer.x; ed_x = pointer.x; ed_y = pointer.y }
    on drag ez_notifications while ed_press == 8 and ed_drag < 0 and abs(pointer.x - ed_px) > 5 { ed_drag = 8; ed_sel = -1 }
    on release ez_notifications while ed_drag == 8 { emit edit_drop(ed_drag * 100000 + round(clamp(ed_x, 0, 49999)) + if(ed_y > st_res + 4, 50000, 0)); ed_drag = -1; ed_press = -1 }
    on release ez_notifications while ed_drag < 0 and ed_press == 8 { ed_sel = if(ed_sel == 8, -1, 8); ed_press = -1 }
    group {
        show: bar_edit and p_mic
        zone box ez_mic { from: xs_mic, fl.top; size: ws_mic, fl.mod_h; cursor: grab; role: button; label: "Move Microphone" }
        box { from: xs_mic + 1, fl.top + 1; size: ws_mic - 2, fl.mod_h - 2; corner: 5; color: if(ed_drag == 9 and ed_merge, fl.ember_fill, fl.well)
              opacity: if(ed_drag == 9, 0.6, if(ed_sel == 9, 0.4, 0.2 * ez_mic.hover)) }
        box { from: xs_mic + 1, fl.top + 1; size: ws_mic - 2, fl.mod_h - 2; corner: 5; stroke: if(ed_sel == 9, 2, 1.2)
              color: if(ed_sel == 9 or ed_drag == 9, fl.flare, mix(fl.trace_lit, fl.flare, ez_mic.hover)); opacity: if(ed_drag >= 0 and ed_drag != 9, 0.45, 0.85) }
    }
    on press ez_mic while bar_edit { ed_press = 9; ed_px = pointer.x; ed_x = pointer.x; ed_y = pointer.y }
    on drag ez_mic while ed_press == 9 and ed_drag < 0 and abs(pointer.x - ed_px) > 5 { ed_drag = 9; ed_sel = -1 }
    on release ez_mic while ed_drag == 9 { emit edit_drop(ed_drag * 100000 + round(clamp(ed_x, 0, 49999)) + if(ed_y > st_res + 4, 50000, 0)); ed_drag = -1; ed_press = -1 }
    on release ez_mic while ed_drag < 0 and ed_press == 9 { ed_sel = if(ed_sel == 9, -1, 9); ed_press = -1 }
    group {
        show: bar_edit and p_volume
