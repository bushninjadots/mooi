    let ft63 = wtt * (0.6 + 0.24 * sin((W * 0.984375) * 0.515662 - wa) + 0.16 * sin((W * 0.984375) * 1.317803 + wc))
    let ft64 = wtt * (0.6 + 0.24 * sin((W * 1) * 0.515662 - wa) + 0.16 * sin((W * 1) * 1.317803 + wc))
