    surface frame_l {
        size: 128, full
        anchor: left
        margin: 160, 0, 128, 0
        level: bottom
        reserve: -1
        rate: 30
        group {
            move: 0, -160
            group {
                glow: 8, if(st_frame_edge > 0.5 and st_frame_edge < 1.5, 0.8, 0) * st_glow, fl.phos
                group {
                    show: not ((pl_act and pl_l < W / 2 and pl_t < min(H - 128, H * 0.25) and pl_b > max(160, H * 0.125)) or (dk_act and dk_l < W / 2 and dk_t < min(H - 128, H * 0.25) and dk_b > max(160, H * 0.125)))
                    clip box { from: -40, max(160, H * 0.125); size: W / 2 + 40, max(0, min(H - 128, H * 0.25) - max(160, H * 0.125)) }
                    body {
                        color: fcol
                        opacity: fop
                        glass: if(glassy, 100%, 0%)
                        lens: false
                        frost: 1% * st_frost
                        smoke: 1% * st_smoke
                        shadow: 0, st_sh_y, st_sh_blur, 100% * st_sh_a
                        border: if(st_frame_edge < 1.5, st_owidth, 0), fnec
                        path { show: band_on; move -40, H * 0.0625
                               line bs + sw3, H * 0.0625
