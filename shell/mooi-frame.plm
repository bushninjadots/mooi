language 0.4
import "theme/tokens.plm"
import "theme/ferrolume.plm"

// mooi's screen frame (D119, D127): the chassis, after iNiR's iRiS frame. The band round the screen and
// every piece of the bar are one body — melted together, one fill, one border, one shadow — so the bar
// grows out of the frame instead of floating over it, in every mode (islands, full, notch). It is a
// program of its own under the bar (level bottom): still it costs nothing, and only it moves with the
// music. The bar hands over where its pieces are (bar-geo.json) and paints only what stands on them
// while the frame is on; the music is the bar's feed, made into iNiR's level and wave by the logic.

scene Frame {
    permissions {
        run: "pleamar"
        services: "files", "env"
    }

    // ── The palette (the logic paints it from palette.json, as the bar's) ──
    fact cn_kind = 0
    fact cn_scale = 1
    fact fr_ground_r = 0.000000
    fact fr_ground_g = 0.000000
    fact fr_ground_b = 0.000000
    fact fr_hull_r = 0.015686
    fact fr_hull_g = 0.035294
    fact fr_hull_b = 0.031373
    fact fr_hull_raised_r = 0.027451
    fact fr_hull_raised_g = 0.074510
    fact fr_hull_raised_b = 0.066667
    fact fr_well_r = 0.019608
    fact fr_well_g = 0.164706
    fact fr_well_b = 0.145098
    fact fr_trace_dim_r = 0.121569
    fact fr_trace_dim_g = 0.219608
    fact fr_trace_dim_b = 0.200000
    fact fr_trace_r = 0.239216
    fact fr_trace_g = 0.415686
    fact fr_trace_b = 0.376471
    fact fr_trace_lit_r = 0.423529
    fact fr_trace_lit_g = 0.788235
    fact fr_trace_lit_b = 0.682353
    fact fr_phos_r = 0.498039
    fact fr_phos_g = 0.811765
    fact fr_phos_b = 0.713725
    fact fr_phos_fill_r = 0.090196
    fact fr_phos_fill_g = 0.603922
    fact fr_phos_fill_b = 0.533333
    fact fr_ember_r = 0.878431
    fact fr_ember_g = 0.482353
    fact fr_ember_b = 0.180392
    fact fr_ember_fill_r = 0.823529
    fact fr_ember_fill_g = 0.411765
    fact fr_ember_fill_b = 0.117647
    fact fr_flare_r = 0.956863
    fact fr_flare_g = 0.713725
    fact fr_flare_b = 0.235294
    fact fr_muted_r = 0.352941
    fact fr_muted_g = 0.541176
    fact fr_muted_b = 0.494118
    fact fr_ink_r = 0.015686
    fact fr_ink_g = 0.129412
    fact fr_ink_b = 0.113725
    fact fr_steel_900_r = 0.082353
    fact fr_steel_900_g = 0.098039
    fact fr_steel_900_b = 0.105882
    fact fr_steel_700_r = 0.164706
    fact fr_steel_700_g = 0.192157
    fact fr_steel_700_b = 0.203922
    fact fr_steel_500_r = 0.290196
    fact fr_steel_500_g = 0.329412
    fact fr_steel_500_b = 0.349020
    fact fr_steel_300_r = 0.545098
    fact fr_steel_300_g = 0.592157
    fact fr_steel_300_b = 0.611765
    fact fr_engrave_r = 0.603922
    fact fr_engrave_g = 0.650980
    fact fr_engrave_b = 0.670588
    prop pr_ground_r = 0.000000 ~fl.relight
    follow pr_ground_r = fr_ground_r
    prop pr_ground_g = 0.000000 ~fl.relight
    follow pr_ground_g = fr_ground_g
    prop pr_ground_b = 0.000000 ~fl.relight
    follow pr_ground_b = fr_ground_b
    prop pr_hull_r = 0.015686 ~fl.relight
    follow pr_hull_r = fr_hull_r
    prop pr_hull_g = 0.035294 ~fl.relight
    follow pr_hull_g = fr_hull_g
    prop pr_hull_b = 0.031373 ~fl.relight
    follow pr_hull_b = fr_hull_b
    prop pr_hull_raised_r = 0.027451 ~fl.relight
    follow pr_hull_raised_r = fr_hull_raised_r
    prop pr_hull_raised_g = 0.074510 ~fl.relight
    follow pr_hull_raised_g = fr_hull_raised_g
    prop pr_hull_raised_b = 0.066667 ~fl.relight
    follow pr_hull_raised_b = fr_hull_raised_b
    prop pr_well_r = 0.019608 ~fl.relight
    follow pr_well_r = fr_well_r
    prop pr_well_g = 0.164706 ~fl.relight
    follow pr_well_g = fr_well_g
    prop pr_well_b = 0.145098 ~fl.relight
    follow pr_well_b = fr_well_b
    prop pr_trace_dim_r = 0.121569 ~fl.relight
    follow pr_trace_dim_r = fr_trace_dim_r
    prop pr_trace_dim_g = 0.219608 ~fl.relight
    follow pr_trace_dim_g = fr_trace_dim_g
    prop pr_trace_dim_b = 0.200000 ~fl.relight
    follow pr_trace_dim_b = fr_trace_dim_b
    prop pr_trace_r = 0.239216 ~fl.relight
    follow pr_trace_r = fr_trace_r
    prop pr_trace_g = 0.415686 ~fl.relight
    follow pr_trace_g = fr_trace_g
    prop pr_trace_b = 0.376471 ~fl.relight
    follow pr_trace_b = fr_trace_b
    prop pr_trace_lit_r = 0.423529 ~fl.relight
    follow pr_trace_lit_r = fr_trace_lit_r
    prop pr_trace_lit_g = 0.788235 ~fl.relight
    follow pr_trace_lit_g = fr_trace_lit_g
    prop pr_trace_lit_b = 0.682353 ~fl.relight
    follow pr_trace_lit_b = fr_trace_lit_b
    prop pr_phos_r = 0.498039 ~fl.relight
    follow pr_phos_r = fr_phos_r
    prop pr_phos_g = 0.811765 ~fl.relight
    follow pr_phos_g = fr_phos_g
    prop pr_phos_b = 0.713725 ~fl.relight
    follow pr_phos_b = fr_phos_b
    prop pr_phos_fill_r = 0.090196 ~fl.relight
    follow pr_phos_fill_r = fr_phos_fill_r
    prop pr_phos_fill_g = 0.603922 ~fl.relight
    follow pr_phos_fill_g = fr_phos_fill_g
    prop pr_phos_fill_b = 0.533333 ~fl.relight
    follow pr_phos_fill_b = fr_phos_fill_b
    prop pr_ember_r = 0.878431 ~fl.relight
    follow pr_ember_r = fr_ember_r
    prop pr_ember_g = 0.482353 ~fl.relight
    follow pr_ember_g = fr_ember_g
    prop pr_ember_b = 0.180392 ~fl.relight
    follow pr_ember_b = fr_ember_b
    prop pr_ember_fill_r = 0.823529 ~fl.relight
    follow pr_ember_fill_r = fr_ember_fill_r
    prop pr_ember_fill_g = 0.411765 ~fl.relight
    follow pr_ember_fill_g = fr_ember_fill_g
    prop pr_ember_fill_b = 0.117647 ~fl.relight
    follow pr_ember_fill_b = fr_ember_fill_b
    prop pr_flare_r = 0.956863 ~fl.relight
    follow pr_flare_r = fr_flare_r
    prop pr_flare_g = 0.713725 ~fl.relight
    follow pr_flare_g = fr_flare_g
    prop pr_flare_b = 0.235294 ~fl.relight
    follow pr_flare_b = fr_flare_b
    prop pr_muted_r = 0.352941 ~fl.relight
    follow pr_muted_r = fr_muted_r
    prop pr_muted_g = 0.541176 ~fl.relight
    follow pr_muted_g = fr_muted_g
    prop pr_muted_b = 0.494118 ~fl.relight
    follow pr_muted_b = fr_muted_b
    prop pr_ink_r = 0.015686 ~fl.relight
    follow pr_ink_r = fr_ink_r
    prop pr_ink_g = 0.129412 ~fl.relight
    follow pr_ink_g = fr_ink_g
    prop pr_ink_b = 0.113725 ~fl.relight
    follow pr_ink_b = fr_ink_b
    prop pr_steel_900_r = 0.082353 ~fl.relight
    follow pr_steel_900_r = fr_steel_900_r
    prop pr_steel_900_g = 0.098039 ~fl.relight
    follow pr_steel_900_g = fr_steel_900_g
    prop pr_steel_900_b = 0.105882 ~fl.relight
    follow pr_steel_900_b = fr_steel_900_b
    prop pr_steel_700_r = 0.164706 ~fl.relight
    follow pr_steel_700_r = fr_steel_700_r
    prop pr_steel_700_g = 0.192157 ~fl.relight
    follow pr_steel_700_g = fr_steel_700_g
    prop pr_steel_700_b = 0.203922 ~fl.relight
    follow pr_steel_700_b = fr_steel_700_b
    prop pr_steel_500_r = 0.290196 ~fl.relight
    follow pr_steel_500_r = fr_steel_500_r
    prop pr_steel_500_g = 0.329412 ~fl.relight
    follow pr_steel_500_g = fr_steel_500_g
    prop pr_steel_500_b = 0.349020 ~fl.relight
    follow pr_steel_500_b = fr_steel_500_b
    prop pr_steel_300_r = 0.545098 ~fl.relight
    follow pr_steel_300_r = fr_steel_300_r
    prop pr_steel_300_g = 0.592157 ~fl.relight
    follow pr_steel_300_g = fr_steel_300_g
    prop pr_steel_300_b = 0.611765 ~fl.relight
    follow pr_steel_300_b = fr_steel_300_b
    prop pr_engrave_r = 0.603922 ~fl.relight
    follow pr_engrave_r = fr_engrave_r
    prop pr_engrave_g = 0.650980 ~fl.relight
    follow pr_engrave_g = fr_engrave_g
    prop pr_engrave_b = 0.670588 ~fl.relight
    follow pr_engrave_b = fr_engrave_b
    fact c_bg_primary_r = 0.062745
    fact c_bg_primary_g = 0.078431
    fact c_bg_primary_b = 0.086275
    fact c_bg_secondary_r = 0.086275
    fact c_bg_secondary_g = 0.105882
    fact c_bg_secondary_b = 0.117647
    fact c_surface_primary_r = 0.098039
    fact c_surface_primary_g = 0.121569
    fact c_surface_primary_b = 0.133333
    fact c_surface_elevated_r = 0.133333
    fact c_surface_elevated_g = 0.160784
    fact c_surface_elevated_b = 0.176471
    fact c_border_subtle_r = 0.172549
    fact c_border_subtle_g = 0.207843
    fact c_border_subtle_b = 0.223529
    fact c_fg_primary_r = 0.890196
    fact c_fg_primary_g = 0.913725
    fact c_fg_primary_b = 0.921569
    fact c_fg_secondary_r = 0.639216
    fact c_fg_secondary_g = 0.690196
    fact c_fg_secondary_b = 0.709804
    fact c_fg_muted_r = 0.541176
    fact c_fg_muted_g = 0.592157
    fact c_fg_muted_b = 0.611765
    fact c_accent_primary_r = 0.650980
    fact c_accent_primary_g = 0.952941
    fact c_accent_primary_b = 0.819608
    fact c_accent_secondary_r = 1.000000
    fact c_accent_secondary_g = 0.572549
    fact c_accent_secondary_b = 0.372549
    fact c_status_ok_r = 0.650980
    fact c_status_ok_g = 0.952941
    fact c_status_ok_b = 0.819608
    fact c_status_error_r = 1.000000
    fact c_status_error_g = 0.572549
    fact c_status_error_b = 0.372549
    fact c_focus_ring_r = 0.650980
    fact c_focus_ring_g = 0.952941
    fact c_focus_ring_b = 0.819608
    fact c_selection_bg_r = 0.164706
    fact c_selection_bg_g = 0.227451
    fact c_selection_bg_b = 0.211765

    fact st_offset = 0
    fact st_notch = false
    fact st_height = 30
    fact st_radius = 8
    fact st_res = 46
    fact st_glow = 1
    fact st_width = 1
    fact st_owidth = 1.4
    fact st_ocol = 0
    fact st_frame_r = 14
    fact st_frame_edge = 0       // 0 line · 1 neon · 2 none
    fact st_frame_op = 1
    fact bar_surface = 0         // 0 solid · 1 glass · 2 blur · 3 clear · 4 machined
    fact bar_ground = 0
    fact bar_frame = 0           // the bar's outline: 0 a line (the only one that joins the frame)
    fact bar_rail = false
    fact frame_band = 6
    fact frame_reach = 18
    fact frame_edges = 0         // 0 all · 1 sides · 2 the ends
    fact frame_music = true

    // the bar's notch pieces (bar-geo.json): x and width of each cluster, 0 wide when it is not there
    fact gl_x = 0
    fact gl_w = 0
    fact gc_x = 0
    fact gc_w = 0
    fact gr_x = 0
    fact gr_w = 0

    // the music (iNiR's IrisFramePulse): the level, fast up and slow down, and the wave's phase
    fact flev = 0
    fact fph = 0
    // the bar's islands and its full panel (bar-geo.json), and which the bar is: 0 islands · 1 full · 2 notch
    fact ix0 = 0
    fact iw0 = 0
    fact ix1 = 0
    fact iw1 = 0
    fact ix2 = 0
    fact iw2 = 0
    fact ix3 = 0
    fact iw3 = 0
    fact ix4 = 0
    fact iw4 = 0
    fact ix5 = 0
    fact iw5 = 0
    fact ix6 = 0
    fact iw6 = 0
    fact ix7 = 0
    fact iw7 = 0
    fact ix8 = 0
    fact iw8 = 0
    fact ix9 = 0
    fact iw9 = 0
    fact ix10 = 0
    fact iw10 = 0
    fact ix11 = 0
    fact iw11 = 0
    fact ix12 = 0
    fact iw12 = 0
    fact ix13 = 0
    fact iw13 = 0
    fact ix14 = 0
    fact iw14 = 0
    fact ix15 = 0
    fact iw15 = 0
    fact il_x = -1                 // where the first island begins, and the last ends (-1: none)
    fact ir_e = -1
    fact gp_x = 0
    fact gp_w = 0
    fact bar_mode = 0
    fact st_opacity = 1
    fact st_sh_y = 4
    fact st_sh_blur = 14
    fact st_sh_a = 0.35
    fact st_frost = 0
    fact st_smoke = 0

    // ── Motion ──
    spring fr.flow = 640, 46        // the pieces move as the bar's do (its fl.flow)
    prop plx = 0 ~fr.flow
    follow plx = gl_x
    prop plw = 0 ~fr.flow
    follow plw = gl_w
    prop pcx = 0 ~fr.flow
    follow pcx = gc_x
    prop pcw = 0 ~fr.flow
    follow pcw = gc_w
    prop prx = 0 ~fr.flow
    follow prx = gr_x
    prop prw = 0 ~fr.flow
    follow prw = gr_w

    surface frame {
        size: full, full
        anchor: top
        level: bottom
        reserve: -1
        // still, it costs nothing; with the music it moves at the feed's pace
        rate: 30

        let W = frame.width
        let H = frame.height

        // ── The chassis (D127): iNiR's iRiS frame, in pleamar ──
        // Everything on the screen's edge is one body: the band round the screen and every piece of
        // the bar, melted together (pleamar's `blend` is the smooth union iNiR's shader computes), so
        // the bar grows out of the frame with a fillet on each side instead of floating over it. One
        // fill, one border round the whole silhouette, one shadow. The bar paints only what sits on
        // its plates while the frame is on (shell/mooi.plm), so nothing is drawn twice.
        //
        // The music (iNiR's IrisFramePulse, exactly): the band's inner edge is pushed in by
        // level × reach, varying along the edge as 0.60 + 0.24·sin(y·0.011 + t) + 0.16·sin(y·0.027 − 1.4t)
        // (x·0.009 − t and x·0.023 + 1.2t along the top and foot). The level and the phase `t` come
        // from the logic (shell/mooi-frame.luau); sin here takes degrees, hence the factors.
        let bs = frame_band                                        // the sides
        let bb = frame_band                                        // the foot
        let bt = frame_band                                        // the top
        let frr = clamp(st_frame_r, 0, 40)                         // the inner corners
        let reach = frame_reach * 1.6
        let wl = if(frame_edges != 2, flev * reach, 0)             // sides (all, sides)
        let wt = if(frame_edges != 1, flev * reach, 0)             // top and foot (all, ends)
        let wa = fph * 57.29578
        let wb = fph * 80.21409
        let wc = fph * 68.75494
        let kf = 12                                                // the fillet where a piece meets the band

        // the bar's row, as the bar lays it out (theme/ferrolume.plm)
        let row_b = fl.top + fl.mod_h                              // an island's foot, the full panel's
        let n_pad = 10
        let n_r = st_radius + 4
        let n_b = st_res                                           // a notch piece's foot

        // ── The corners ──
        // Does a piece of the bar sit in a corner (it starts within the corner's reach of the side)? Then
        // that corner turns at the piece's foot, so all four are the same round whatever the bar does.
        let foot = if(bar_mode == 2, n_b, row_b)
        let covL = pick(bar_mode, il_x >= 0 and il_x - 3 <= bs + frr, gp_w > 1 and gp_x <= bs + frr, plw > 1 and plx - n_pad <= bs + frr)
        let covR = pick(bar_mode, ir_e >= 0 and ir_e + 3 >= W - bs - frr, gp_w > 1 and gp_x + gp_w >= W - bs - frr, prw > 1 and prx + prw + n_pad >= W - bs - frr)
        // where each corner's round starts on the top (or foot) and on the side: in two steps, as the
        // moving side shifts where the top's edge is met
        let xBL0 = bs + wl * (0.6 + 0.24 * sin((H - bb - frr) * 0.630254 + wa) + 0.16 * sin((H - bb - frr) * 1.546986 - wb))
        let xBR0 = W - bs - wl * (0.6 + 0.24 * sin((H - bb - frr) * 0.630254 + wa) + 0.16 * sin((H - bb - frr) * 1.546986 - wb))
        let yTLs = if(covL, foot, bt)
        let yTRs = if(covR, foot, bt)
        let yTL = yTLs                                    // the top stays still: the bar is there
        let yTR = yTRs
        let yBL = H - bb - if(wt > 0.5, 1.5, 0) - wt * (0.6 + 0.24 * sin((xBL0 + frr) * 0.515662 - wa) + 0.16 * sin((xBL0 + frr) * 1.317803 + wc))
        let yBR = H - bb - if(wt > 0.5, 1.5, 0) - wt * (0.6 + 0.24 * sin((xBR0 - frr) * 0.515662 - wa) + 0.16 * sin((xBR0 - frr) * 1.317803 + wc))
        let xTL = bs + 1.5 + wl * (0.6 + 0.24 * sin((yTL + frr) * 0.630254 + wa) + 0.16 * sin((yTL + frr) * 1.546986 - wb))
        let xTR = W - bs - 1.5 - wl * (0.6 + 0.24 * sin((yTR + frr) * 0.630254 + wa) + 0.16 * sin((yTR + frr) * 1.546986 - wb))
        let xBL = bs + 1.5 + wl * (0.6 + 0.24 * sin((yBL - frr) * 0.630254 + wa) + 0.16 * sin((yBL - frr) * 1.546986 - wb))
        let xBR = W - bs - 1.5 - wl * (0.6 + 0.24 * sin((yBR - frr) * 0.630254 + wa) + 0.16 * sin((yBR - frr) * 1.546986 - wb))

        // the material: the bar's own, so the bar and the frame are one thing
        let mech = bar_surface > 3.5
        let fcol = mix(mix(fl.hull, fl.ground, bar_ground < 0.5), fl.steel_900, mech)
        let fnec = mix(mix(mix(fl.trace, fl.trace_lit, clamp(st_ocol, 0, 1)), fl.phos_fill, clamp(st_ocol - 1, 0, 1)), fl.steel_300, mech)
        let glassy = bar_surface > 0.5 and bar_surface < 2.5
        let fop = max(st_opacity, 0.3) * if(bar_surface > 2.5 and not mech, 0, 1)

        // ── The still chassis: the band, the bar's pieces, the corners, one outline ──
        // Drawn as it is at rest. It changes only when the bar's layout does, so nothing here is
        // painted again while the music plays (one full-screen body re-evaluated thirty times a
        // second held the GPU at ~92 % and made the desktop stutter).
        group {
            glow: 8, if(st_frame_edge > 0.5 and st_frame_edge < 1.5, 0.8, 0) * st_glow, fl.phos
            body {
                color: fcol
                opacity: fop
                glass: if(glassy, 100%, 0%)
                lens: false
                frost: 1% * st_frost
                smoke: 1% * st_smoke
                shadow: 0, st_sh_y, st_sh_blur, 100% * st_sh_a
                border: if(st_frame_edge < 1.5, st_owidth, 0), fnec
                box { from: -40, -40; size: W + 80, 40 + bt }
                box { from: -40, -40; size: 40 + bs, H + 80 }
                box { from: W - bs, -40; size: bs + 40, H + 80 }
                box { from: -40, H - bb; size: W + 80, bb + 40 }
                // the four inner corners at rest: true quarter rounds of the frame's radius, turning at a
                // piece's foot when one sits in that corner; each reaches back to the screen's corner
                path { move -40, -40; line bs + frr, -40; line bs + frr, yTLs; curve bs, yTLs + frr via bs, yTLs; line -40, yTLs + frr; close }
                path { move W + 40, -40; line W - bs - frr, -40; line W - bs - frr, yTRs; curve W - bs, yTRs + frr via W - bs, yTRs; line W + 40, yTRs + frr; close }
                path { move -40, H + 40; line bs + frr, H + 40; line bs + frr, H - bb; curve bs, H - bb - frr via bs, H - bb; line -40, H - bb - frr; close }
                path { move W + 40, H + 40; line W - bs - frr, H + 40; line W - bs - frr, H - bb; curve W - bs, H - bb - frr via W - bs, H - bb; line W + 40, H - bb - frr; close }
                // the bar's pieces, each grown out of the band
                // <gen:islands> sixteen slots (a `for` cannot stand inside a body); 0 wide when unused
                box { from: ix0 - 3, -40; size: iw0 + 6, 40 + row_b; corner: fl.radius; blend: kf; show: bar_mode == 0 and iw0 > 1 }
                box { from: ix1 - 3, -40; size: iw1 + 6, 40 + row_b; corner: fl.radius; blend: kf; show: bar_mode == 0 and iw1 > 1 }
                box { from: ix2 - 3, -40; size: iw2 + 6, 40 + row_b; corner: fl.radius; blend: kf; show: bar_mode == 0 and iw2 > 1 }
                box { from: ix3 - 3, -40; size: iw3 + 6, 40 + row_b; corner: fl.radius; blend: kf; show: bar_mode == 0 and iw3 > 1 }
                box { from: ix4 - 3, -40; size: iw4 + 6, 40 + row_b; corner: fl.radius; blend: kf; show: bar_mode == 0 and iw4 > 1 }
                box { from: ix5 - 3, -40; size: iw5 + 6, 40 + row_b; corner: fl.radius; blend: kf; show: bar_mode == 0 and iw5 > 1 }
                box { from: ix6 - 3, -40; size: iw6 + 6, 40 + row_b; corner: fl.radius; blend: kf; show: bar_mode == 0 and iw6 > 1 }
                box { from: ix7 - 3, -40; size: iw7 + 6, 40 + row_b; corner: fl.radius; blend: kf; show: bar_mode == 0 and iw7 > 1 }
                box { from: ix8 - 3, -40; size: iw8 + 6, 40 + row_b; corner: fl.radius; blend: kf; show: bar_mode == 0 and iw8 > 1 }
                box { from: ix9 - 3, -40; size: iw9 + 6, 40 + row_b; corner: fl.radius; blend: kf; show: bar_mode == 0 and iw9 > 1 }
                box { from: ix10 - 3, -40; size: iw10 + 6, 40 + row_b; corner: fl.radius; blend: kf; show: bar_mode == 0 and iw10 > 1 }
                box { from: ix11 - 3, -40; size: iw11 + 6, 40 + row_b; corner: fl.radius; blend: kf; show: bar_mode == 0 and iw11 > 1 }
                box { from: ix12 - 3, -40; size: iw12 + 6, 40 + row_b; corner: fl.radius; blend: kf; show: bar_mode == 0 and iw12 > 1 }
                box { from: ix13 - 3, -40; size: iw13 + 6, 40 + row_b; corner: fl.radius; blend: kf; show: bar_mode == 0 and iw13 > 1 }
                box { from: ix14 - 3, -40; size: iw14 + 6, 40 + row_b; corner: fl.radius; blend: kf; show: bar_mode == 0 and iw14 > 1 }
                box { from: ix15 - 3, -40; size: iw15 + 6, 40 + row_b; corner: fl.radius; blend: kf; show: bar_mode == 0 and iw15 > 1 }
                // </gen:islands>
                box { from: plx - n_pad, -40; size: plw + 2 * n_pad, 40 + n_b; corner: n_r; blend: kf; show: bar_mode == 2 and plw > 1 }
                box { from: pcx - n_pad, -40; size: pcw + 2 * n_pad, 40 + n_b; corner: n_r; blend: kf; show: bar_mode == 2 and pcw > 1 }
                box { from: prx - n_pad, -40; size: prw + 2 * n_pad, 40 + n_b; corner: n_r; blend: kf; show: bar_mode == 2 and prw > 1 }
                box { from: gp_x, -40; size: gp_w, 40 + row_b; corner: fl.radius; blend: kf; show: bar_mode == 1 and gp_w > 1 }
            }
        }
    }

    // ── The moving edges: their own narrow surfaces, only while the music moves them ──
    // Thin strips down each side and along the foot, in the chassis's material and without an
    // outline of their own: they lie over the still band (the wave only ever pushes inward, so they
    // cover its edge), and one stroked line traces the moving edge and its corners, so there is no
    // seam. Each is its own surface, 128 px across and open only while the edge moves: on the
    // chassis's surface, every step of the wave repainted the whole screen (the GPU at ~90 %).
    // The drawing is in the screen's coordinates; `move` puts it where the surface sits.

    surface frame_l {
        size: 128, full
        anchor: left
        level: bottom
        reserve: -1
        rate: 30
        open: wl > 0.5 or wt > 0.5
        group {
            move: 0, 0
            body {
                color: fcol
                opacity: fop
                glass: if(glassy, 100%, 0%)
                lens: false
                show: wl > 0.5 or wt > 0.5
                path { move -40, -40
                       line bs + 1.5 + wl * (0.6 + 0.24 * sin((H * 0.0000) * 0.630254 + wa) + 0.16 * sin((H * 0.0000) * 1.546986 - wb)), H * 0.0000
                       line bs + 1.5 + wl * (0.6 + 0.24 * sin((H * 0.0333) * 0.630254 + wa) + 0.16 * sin((H * 0.0333) * 1.546986 - wb)), H * 0.0333
                       line bs + 1.5 + wl * (0.6 + 0.24 * sin((H * 0.0667) * 0.630254 + wa) + 0.16 * sin((H * 0.0667) * 1.546986 - wb)), H * 0.0667
                       line bs + 1.5 + wl * (0.6 + 0.24 * sin((H * 0.1000) * 0.630254 + wa) + 0.16 * sin((H * 0.1000) * 1.546986 - wb)), H * 0.1000
                       line bs + 1.5 + wl * (0.6 + 0.24 * sin((H * 0.1333) * 0.630254 + wa) + 0.16 * sin((H * 0.1333) * 1.546986 - wb)), H * 0.1333
                       line bs + 1.5 + wl * (0.6 + 0.24 * sin((H * 0.1667) * 0.630254 + wa) + 0.16 * sin((H * 0.1667) * 1.546986 - wb)), H * 0.1667
                       line bs + 1.5 + wl * (0.6 + 0.24 * sin((H * 0.2000) * 0.630254 + wa) + 0.16 * sin((H * 0.2000) * 1.546986 - wb)), H * 0.2000
                       line bs + 1.5 + wl * (0.6 + 0.24 * sin((H * 0.2333) * 0.630254 + wa) + 0.16 * sin((H * 0.2333) * 1.546986 - wb)), H * 0.2333
                       line bs + 1.5 + wl * (0.6 + 0.24 * sin((H * 0.2667) * 0.630254 + wa) + 0.16 * sin((H * 0.2667) * 1.546986 - wb)), H * 0.2667
                       line bs + 1.5 + wl * (0.6 + 0.24 * sin((H * 0.3000) * 0.630254 + wa) + 0.16 * sin((H * 0.3000) * 1.546986 - wb)), H * 0.3000
                       line bs + 1.5 + wl * (0.6 + 0.24 * sin((H * 0.3333) * 0.630254 + wa) + 0.16 * sin((H * 0.3333) * 1.546986 - wb)), H * 0.3333
                       line bs + 1.5 + wl * (0.6 + 0.24 * sin((H * 0.3667) * 0.630254 + wa) + 0.16 * sin((H * 0.3667) * 1.546986 - wb)), H * 0.3667
                       line bs + 1.5 + wl * (0.6 + 0.24 * sin((H * 0.4000) * 0.630254 + wa) + 0.16 * sin((H * 0.4000) * 1.546986 - wb)), H * 0.4000
                       line bs + 1.5 + wl * (0.6 + 0.24 * sin((H * 0.4333) * 0.630254 + wa) + 0.16 * sin((H * 0.4333) * 1.546986 - wb)), H * 0.4333
                       line bs + 1.5 + wl * (0.6 + 0.24 * sin((H * 0.4667) * 0.630254 + wa) + 0.16 * sin((H * 0.4667) * 1.546986 - wb)), H * 0.4667
                       line bs + 1.5 + wl * (0.6 + 0.24 * sin((H * 0.5000) * 0.630254 + wa) + 0.16 * sin((H * 0.5000) * 1.546986 - wb)), H * 0.5000
                       line bs + 1.5 + wl * (0.6 + 0.24 * sin((H * 0.5333) * 0.630254 + wa) + 0.16 * sin((H * 0.5333) * 1.546986 - wb)), H * 0.5333
                       line bs + 1.5 + wl * (0.6 + 0.24 * sin((H * 0.5667) * 0.630254 + wa) + 0.16 * sin((H * 0.5667) * 1.546986 - wb)), H * 0.5667
                       line bs + 1.5 + wl * (0.6 + 0.24 * sin((H * 0.6000) * 0.630254 + wa) + 0.16 * sin((H * 0.6000) * 1.546986 - wb)), H * 0.6000
                       line bs + 1.5 + wl * (0.6 + 0.24 * sin((H * 0.6333) * 0.630254 + wa) + 0.16 * sin((H * 0.6333) * 1.546986 - wb)), H * 0.6333
                       line bs + 1.5 + wl * (0.6 + 0.24 * sin((H * 0.6667) * 0.630254 + wa) + 0.16 * sin((H * 0.6667) * 1.546986 - wb)), H * 0.6667
                       line bs + 1.5 + wl * (0.6 + 0.24 * sin((H * 0.7000) * 0.630254 + wa) + 0.16 * sin((H * 0.7000) * 1.546986 - wb)), H * 0.7000
                       line bs + 1.5 + wl * (0.6 + 0.24 * sin((H * 0.7333) * 0.630254 + wa) + 0.16 * sin((H * 0.7333) * 1.546986 - wb)), H * 0.7333
                       line bs + 1.5 + wl * (0.6 + 0.24 * sin((H * 0.7667) * 0.630254 + wa) + 0.16 * sin((H * 0.7667) * 1.546986 - wb)), H * 0.7667
                       line bs + 1.5 + wl * (0.6 + 0.24 * sin((H * 0.8000) * 0.630254 + wa) + 0.16 * sin((H * 0.8000) * 1.546986 - wb)), H * 0.8000
                       line bs + 1.5 + wl * (0.6 + 0.24 * sin((H * 0.8333) * 0.630254 + wa) + 0.16 * sin((H * 0.8333) * 1.546986 - wb)), H * 0.8333
                       line bs + 1.5 + wl * (0.6 + 0.24 * sin((H * 0.8667) * 0.630254 + wa) + 0.16 * sin((H * 0.8667) * 1.546986 - wb)), H * 0.8667
                       line bs + 1.5 + wl * (0.6 + 0.24 * sin((H * 0.9000) * 0.630254 + wa) + 0.16 * sin((H * 0.9000) * 1.546986 - wb)), H * 0.9000
                       line bs + 1.5 + wl * (0.6 + 0.24 * sin((H * 0.9333) * 0.630254 + wa) + 0.16 * sin((H * 0.9333) * 1.546986 - wb)), H * 0.9333
                       line bs + 1.5 + wl * (0.6 + 0.24 * sin((H * 0.9667) * 0.630254 + wa) + 0.16 * sin((H * 0.9667) * 1.546986 - wb)), H * 0.9667
                       line bs + 1.5 + wl * (0.6 + 0.24 * sin((H * 1.0000) * 0.630254 + wa) + 0.16 * sin((H * 1.0000) * 1.546986 - wb)), H * 1.0000
                       line -40, H + 40; close }
                path { move -40, -40; line xTL + frr, -40; line xTL + frr, yTL; curve xTL, yTL + frr via xTL, yTL; line -40, yTL + frr; close }
                path { move -40, H + 40; line xBL + frr, H + 40; line xBL + frr, yBL; curve xBL, yBL - frr via xBL, yBL; line -40, yBL - frr; close }
            }
