    let xTL = bs + wl * (0.6 + 0.24 * sin((yTL0 + frl) * 0.630254 + wa) + 0.16 * sin((yTL0 + frl) * 1.546986 - wb))
    let yTL = if(covL, foot, bt + wtt * (0.6 + 0.24 * sin((xTL + frl) * 0.515662 - wa) + 0.16 * sin((xTL + frl) * 1.317803 + wc)))
