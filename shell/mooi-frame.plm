    surface frame_p {
        size: full, full
        anchor: top
        level: top
        reserve: -1
        rate: 60
        box { from: 0, 0; size: 1, 1; color: #000000; opacity: 0.01 }
        group {
            show: pl_act or dk_act
            body { color: fcol; opacity: clamp(1 - 0.06 / max(0.06, 1 - fop), 0, 1); show: pl_act; box { from: pl_bx + 1, pl_by + 1; size: max(1, pl_bw - 2), max(1, pl_bh - 2); corner: pl_br } }
            body { color: fcol; opacity: clamp(1 - 0.06 / max(0.06, 1 - fop), 0, 1); show: dk_act; box { from: dk_bx + 1, dk_by + 1; size: max(1, dk_bw - 2), max(1, dk_bh - 2); corner: dk_br } }
            group {
                glow: 8, if(st_frame_edge > 0.5 and st_frame_edge < 1.5, 0.8 + 0.35 * clamp(flev * 2, 0, 1), 0) * st_glow, fl.phos
                group {
                    show: (pl_act and pl_l < W * 0.09375 and pl_e > -40 and pl_t < 160 + 40) or (dk_act and dk_l < W * 0.09375 and dk_e > -40 and dk_t < 160 + 40)
                    clip box { from: -40, -40; size: (W * 0.09375) - (-40), max(160 + 40, if(pl_act, pl_b + 16, 0)) }
                    body {
                        color: fcol
                        opacity: fop
                        glass: if(glassy, 100%, 0%)
                        lens: false
                        frost: 1% * st_frost * if(glassy, 1, 0)
                        smoke: 1% * st_smoke * if(glassy, 1, 0)
                        shadow: 0, st_sh_y, st_sh_blur, 100% * st_sh_a
                        border: if(bar_frame < 0.5 and (not band_on or st_frame_edge < 1.5), st_owidth, 0), fnec
                        path { show: band_on; move W * 0, -40
                               line W * 0, bt + ft0
                               line W * 0.015625, bt + ft1
                               line W * 0.03125, bt + ft2
                               line W * 0.046875, bt + ft3
                               line W * 0.0625, bt + ft4
                               line W * 0.078125, bt + ft5
                               line W * 0.09375, bt + ft6
                               line W * 0.109375, bt + ft7
                               line W * 0.125, bt + ft8
                               line W * 0.140625, bt + ft9
