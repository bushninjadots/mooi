                       line W - bs + 1.5 - sw23, H * 0.479167
                       line W - bs + 1.5 - sw24, H * 0.5
                       line W - bs + 1.5 - sw25, H * 0.520833
                       line W - bs + 1.5 - sw26, H * 0.541667
                       line W - bs + 1.5 - sw27, H * 0.5625
                       line W - bs + 1.5 - sw28, H * 0.583333
                       line W - bs + 1.5 - sw29, H * 0.604167
                       line W - bs + 1.5 - sw30, H * 0.625
                       line W - bs + 1.5 - sw31, H * 0.645833
                       line W - bs + 1.5 - sw32, H * 0.666667
                       line W - bs + 1.5 - sw33, H * 0.6875
                       line W - bs + 1.5 - sw34, H * 0.708333
                       line W - bs + 1.5 - sw35, H * 0.729167
                       line W - bs + 1.5 - sw36, H * 0.75
                       line W - bs + 1.5 - sw37, H * 0.770833
                       line W - bs + 1.5 - sw38, H * 0.791667
