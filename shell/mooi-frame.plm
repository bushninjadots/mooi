                        smoke: 1% * st_smoke
                        shadow: 0, st_sh_y, st_sh_blur, 100% * st_sh_a
                        border: if(st_frame_edge < 1.5, st_owidth, 0), fnec
                        path { show: band_on; move W + 40, H * 0.6875
                               line W - bs - sw33, H * 0.6875
                               line W - bs - sw34, H * 0.708333
                               line W - bs - sw35, H * 0.729167
                               line W - bs - sw36, H * 0.75
                               line W - bs - sw37, H * 0.770833
                               line W - bs - sw38, H * 0.791667
                               line W - bs - sw39, H * 0.8125
                               line W - bs - sw40, H * 0.833333
                               line W - bs - sw41, H * 0.854167
                               line W - bs - sw42, H * 0.875
                               line W - bs - sw43, H * 0.895833
                               line W - bs - sw44, H * 0.916667
                               line W - bs - sw45, H * 0.9375
                               line W + 40, H * 0.9375
                               close }
                        path { show: band_on; move W + 40, H + 40; line xBR - frr, H + 40; line xBR - frr, yBR; curve xBR, yBR - frr via xBR, yBR; line W + 40, yBR - frr; close }
                    }
                }
                group {
                    show: not ((pl_act and pl_e > W / 2 and pl_t < min(H - 128, H * 1) and pl_b > max(160, H * 0.875)) or (dk_act and dk_e > W / 2 and dk_t < min(H - 128, H * 1) and dk_b > max(160, H * 0.875)))
                    clip box { from: W / 2, max(160, H * 0.875); size: W / 2 + 40, max(0, min(H - 128, H * 1) - max(160, H * 0.875)) }
                    body {
                        color: fcol
                        opacity: fop
                        glass: if(glassy, 100%, 0%)
                        lens: false
                        frost: 1% * st_frost
                        smoke: 1% * st_smoke
                        shadow: 0, st_sh_y, st_sh_blur, 100% * st_sh_a
                        border: if(st_frame_edge < 1.5, st_owidth, 0), fnec
                        path { show: band_on; move W + 40, H * 0.8125
                               line W - bs - sw39, H * 0.8125
                               line W - bs - sw40, H * 0.833333
                               line W - bs - sw41, H * 0.854167
                               line W - bs - sw42, H * 0.875
                               line W - bs - sw43, H * 0.895833
                               line W - bs - sw44, H * 0.916667
                               line W - bs - sw45, H * 0.9375
                               line W - bs - sw46, H * 0.958333
                               line W - bs - sw47, H * 0.979167
                               line W - bs - sw48, H * 1
                               line W + 40, H * 1
                               close }
                        path { show: band_on; move W + 40, H + 40; line xBR - frr, H + 40; line xBR - frr, yBR; curve xBR, yBR - frr via xBR, yBR; line W + 40, yBR - frr; close }
                    }
                }
            }
            group {
                show: band_on and wl > 0.5
                opacity: 0.35 * clamp(flev * 2, 0, 1)
                glow: 5, 0.6 * st_glow, fg.primary
                clip box { from: -40, yTR + frr + 8; size: W + 80, max(0, yBR - yTR - 2 * frr - 16) }
                path { stroke: 1.4; color: fg.primary
                       move W - bs + 1.5 - sw0, H * 0
                       line W - bs + 1.5 - sw1, H * 0.020833
                       line W - bs + 1.5 - sw2, H * 0.041667
                       line W - bs + 1.5 - sw3, H * 0.0625
                       line W - bs + 1.5 - sw4, H * 0.083333
                       line W - bs + 1.5 - sw5, H * 0.104167
                       line W - bs + 1.5 - sw6, H * 0.125
                       line W - bs + 1.5 - sw7, H * 0.145833
                       line W - bs + 1.5 - sw8, H * 0.166667
                       line W - bs + 1.5 - sw9, H * 0.1875
                       line W - bs + 1.5 - sw10, H * 0.208333
                       line W - bs + 1.5 - sw11, H * 0.229167
                       line W - bs + 1.5 - sw12, H * 0.25
