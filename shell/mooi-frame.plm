    let ft56 = wtt * (0.6 + 0.24 * sin((W * 0.875) * 0.515662 - wa) + 0.16 * sin((W * 0.875) * 1.317803 + wc))
    let ft57 = wtt * (0.6 + 0.24 * sin((W * 0.890625) * 0.515662 - wa) + 0.16 * sin((W * 0.890625) * 1.317803 + wc))
    let ft58 = wtt * (0.6 + 0.24 * sin((W * 0.90625) * 0.515662 - wa) + 0.16 * sin((W * 0.90625) * 1.317803 + wc))
    let ft59 = wtt * (0.6 + 0.24 * sin((W * 0.921875) * 0.515662 - wa) + 0.16 * sin((W * 0.921875) * 1.317803 + wc))
