                       line W - bs + 1.5 - sw46, H * 0.958333
                       line W - bs + 1.5 - sw47, H * 0.979167
                       line W - bs + 1.5 - sw48, H * 1 }
            }
        }
    }

    surface frame_p {
        size: full, full
        anchor: top
        level: bottom, top while pl_act or dk_act
        reserve: -1
        rate: 60
        group {
            show: pl_act or dk_act
            group {
                glow: 8, if(st_frame_edge > 0.5 and st_frame_edge < 1.5, 0.8, 0) * st_glow, fl.phos
                group {
                    show: (pl_act and pl_l < W * 0.09375 and pl_e > -40 and pl_t < 160 + 40) or (dk_act and dk_l < W * 0.09375 and dk_e > -40 and dk_t < 160 + 40)
                    clip box { from: -40, -40; size: (W * 0.09375) - (-40), max(160 + 40, if(pl_act, pl_y + pl_h + 80, 0)) }
                    body {
                        color: fcol
                        opacity: fop
                        glass: if(glassy, 100%, 0%)
                        lens: false
                        frost: 1% * st_frost
                        smoke: 1% * st_smoke
                        shadow: 0, st_sh_y, st_sh_blur, 100% * st_sh_a
                        border: if(st_frame_edge < 1.5, st_owidth, 0), fnec
                        path { show: band_on; move W * 0, -40
                               line W * 0, bt + fw0
                               line W * 0.015625, bt + fw1
                               line W * 0.03125, bt + fw2
                               line W * 0.046875, bt + fw3
                               line W * 0.0625, bt + fw4
                               line W * 0.078125, bt + fw5
                               line W * 0.09375, bt + fw6
                               line W * 0.109375, bt + fw7
                               line W * 0.125, bt + fw8
                               line W * 0.140625, bt + fw9
                               line W * 0.140625, -40
                               close }
                        path { show: band_on; move -40, H * 0
                               line bs + sw0, H * 0
                               line bs + sw1, H * 0.020833
                               line bs + sw2, H * 0.041667
                               line bs + sw3, H * 0.0625
                               line bs + sw4, H * 0.083333
                               line bs + sw5, H * 0.104167
                               line bs + sw6, H * 0.125
                               line bs + sw7, H * 0.145833
                               line bs + sw8, H * 0.166667
                               line bs + sw9, H * 0.1875
                               line bs + sw10, H * 0.208333
                               line -40, H * 0.208333
                               close }
                        path { show: band_on; move -40, -40; line xTL + frr, -40; line xTL + frr, yTL; curve xTL, yTL + frr via xTL, yTL; line -40, yTL + frr; close }
                        box { from: ix0 - 3, if(band_on, -40, st_offset); size: iw0 + 6, if(band_on, 40 + row_b, row_b - st_offset); corner: fl.radius; blend: kf; show: bar_mode == 0 and iw0 > 1 and ix0 - 3 < W * 0.09375 + 48 and ix0 + iw0 + 3 > -40 - 48 }
                        box { from: ix1 - 3, if(band_on, -40, st_offset); size: iw1 + 6, if(band_on, 40 + row_b, row_b - st_offset); corner: fl.radius; blend: kf; show: bar_mode == 0 and iw1 > 1 and ix1 - 3 < W * 0.09375 + 48 and ix1 + iw1 + 3 > -40 - 48 }
                        box { from: ix2 - 3, if(band_on, -40, st_offset); size: iw2 + 6, if(band_on, 40 + row_b, row_b - st_offset); corner: fl.radius; blend: kf; show: bar_mode == 0 and iw2 > 1 and ix2 - 3 < W * 0.09375 + 48 and ix2 + iw2 + 3 > -40 - 48 }
                        box { from: ix3 - 3, if(band_on, -40, st_offset); size: iw3 + 6, if(band_on, 40 + row_b, row_b - st_offset); corner: fl.radius; blend: kf; show: bar_mode == 0 and iw3 > 1 and ix3 - 3 < W * 0.09375 + 48 and ix3 + iw3 + 3 > -40 - 48 }
                        box { from: ix4 - 3, if(band_on, -40, st_offset); size: iw4 + 6, if(band_on, 40 + row_b, row_b - st_offset); corner: fl.radius; blend: kf; show: bar_mode == 0 and iw4 > 1 and ix4 - 3 < W * 0.09375 + 48 and ix4 + iw4 + 3 > -40 - 48 }
                        box { from: ix5 - 3, if(band_on, -40, st_offset); size: iw5 + 6, if(band_on, 40 + row_b, row_b - st_offset); corner: fl.radius; blend: kf; show: bar_mode == 0 and iw5 > 1 and ix5 - 3 < W * 0.09375 + 48 and ix5 + iw5 + 3 > -40 - 48 }
                        box { from: ix6 - 3, if(band_on, -40, st_offset); size: iw6 + 6, if(band_on, 40 + row_b, row_b - st_offset); corner: fl.radius; blend: kf; show: bar_mode == 0 and iw6 > 1 and ix6 - 3 < W * 0.09375 + 48 and ix6 + iw6 + 3 > -40 - 48 }
                        box { from: ix7 - 3, if(band_on, -40, st_offset); size: iw7 + 6, if(band_on, 40 + row_b, row_b - st_offset); corner: fl.radius; blend: kf; show: bar_mode == 0 and iw7 > 1 and ix7 - 3 < W * 0.09375 + 48 and ix7 + iw7 + 3 > -40 - 48 }
                        box { from: ix8 - 3, if(band_on, -40, st_offset); size: iw8 + 6, if(band_on, 40 + row_b, row_b - st_offset); corner: fl.radius; blend: kf; show: bar_mode == 0 and iw8 > 1 and ix8 - 3 < W * 0.09375 + 48 and ix8 + iw8 + 3 > -40 - 48 }
                        box { from: ix9 - 3, if(band_on, -40, st_offset); size: iw9 + 6, if(band_on, 40 + row_b, row_b - st_offset); corner: fl.radius; blend: kf; show: bar_mode == 0 and iw9 > 1 and ix9 - 3 < W * 0.09375 + 48 and ix9 + iw9 + 3 > -40 - 48 }
                        box { from: ix10 - 3, if(band_on, -40, st_offset); size: iw10 + 6, if(band_on, 40 + row_b, row_b - st_offset); corner: fl.radius; blend: kf; show: bar_mode == 0 and iw10 > 1 and ix10 - 3 < W * 0.09375 + 48 and ix10 + iw10 + 3 > -40 - 48 }
                        box { from: ix11 - 3, if(band_on, -40, st_offset); size: iw11 + 6, if(band_on, 40 + row_b, row_b - st_offset); corner: fl.radius; blend: kf; show: bar_mode == 0 and iw11 > 1 and ix11 - 3 < W * 0.09375 + 48 and ix11 + iw11 + 3 > -40 - 48 }
                        box { from: ix12 - 3, if(band_on, -40, st_offset); size: iw12 + 6, if(band_on, 40 + row_b, row_b - st_offset); corner: fl.radius; blend: kf; show: bar_mode == 0 and iw12 > 1 and ix12 - 3 < W * 0.09375 + 48 and ix12 + iw12 + 3 > -40 - 48 }
                        box { from: ix13 - 3, if(band_on, -40, st_offset); size: iw13 + 6, if(band_on, 40 + row_b, row_b - st_offset); corner: fl.radius; blend: kf; show: bar_mode == 0 and iw13 > 1 and ix13 - 3 < W * 0.09375 + 48 and ix13 + iw13 + 3 > -40 - 48 }
                        box { from: ix14 - 3, if(band_on, -40, st_offset); size: iw14 + 6, if(band_on, 40 + row_b, row_b - st_offset); corner: fl.radius; blend: kf; show: bar_mode == 0 and iw14 > 1 and ix14 - 3 < W * 0.09375 + 48 and ix14 + iw14 + 3 > -40 - 48 }
                        box { from: ix15 - 3, if(band_on, -40, st_offset); size: iw15 + 6, if(band_on, 40 + row_b, row_b - st_offset); corner: fl.radius; blend: kf; show: bar_mode == 0 and iw15 > 1 and ix15 - 3 < W * 0.09375 + 48 and ix15 + iw15 + 3 > -40 - 48 }
                        box { from: plx - n_pad, if(band_on, -40, st_offset); size: plw + 2 * n_pad, if(band_on, 40 + n_b, n_b - st_offset); corner: n_r; blend: kf; show: bar_mode == 2 and plw > 1 and plx - n_pad < W * 0.09375 + 48 and plx + plw + n_pad > -40 - 48 }
                        box { from: pcx - n_pad, if(band_on, -40, st_offset); size: pcw + 2 * n_pad, if(band_on, 40 + n_b, n_b - st_offset); corner: n_r; blend: kf; show: bar_mode == 2 and pcw > 1 and pcx - n_pad < W * 0.09375 + 48 and pcx + pcw + n_pad > -40 - 48 }
