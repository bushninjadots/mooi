                       line bs + 1.5 + wl * (0.6 + 0.24 * sin((yTL + frr + (yBL - yTL - 2 * frr) * 0.1333) * 0.630254 + wa) + 0.16 * sin((yTL + frr + (yBL - yTL - 2 * frr) * 0.1333) * 1.546986 - wb)), yTL + frr + (yBL - yTL - 2 * frr) * 0.1333
                       line bs + 1.5 + wl * (0.6 + 0.24 * sin((yTL + frr + (yBL - yTL - 2 * frr) * 0.1667) * 0.630254 + wa) + 0.16 * sin((yTL + frr + (yBL - yTL - 2 * frr) * 0.1667) * 1.546986 - wb)), yTL + frr + (yBL - yTL - 2 * frr) * 0.1667
