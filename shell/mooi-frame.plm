                        box { from: px0, py0; size: pw0, ph0; corner: pr0; blend: pk0; show: pw0 > 0 and px0 < W * 0.09375 + 48 and px0 + pw0 > -40 - 48 }
                        box { from: px1, py1; size: pw1, ph1; corner: pr1; blend: pk1; show: pw1 > 0 and px1 < W * 0.09375 + 48 and px1 + pw1 > -40 - 48 }
                        box { from: px2, py2; size: pw2, ph2; corner: pr2; blend: pk2; show: pw2 > 0 and px2 < W * 0.09375 + 48 and px2 + pw2 > -40 - 48 }
