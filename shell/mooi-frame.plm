                               line W - bs - sw21, H * 0.4375
                               line W - bs - sw22, H * 0.458333
                               line W - bs - sw23, H * 0.479167
                               line W - bs - sw24, H * 0.5
                               line W - bs - sw25, H * 0.520833
                               line W - bs - sw26, H * 0.541667
