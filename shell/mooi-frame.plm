language 0.9
import "theme/tokens.plm"
import "theme/ferrolume.plm"

// mooi's screen frame (D119, D127): the chassis, after iNiR's iRiS frame. The band round the screen and
// every piece of the bar are one body — melted together, one fill, one border, one shadow — so the bar
// grows out of the frame instead of floating over it, in every mode (islands, full, notch). It is a
// program of its own under the bar (level bottom): still it costs nothing, and only it moves with the
// music. The bar hands over where its pieces are (bar-geo.json) and paints only what stands on them
// while the frame is on; the music is the bar's feed, made into iNiR's level and wave by the logic.

scene Frame {
    permissions {
        run: "pleamar"
        services: "files", "env"
    }

    // ── The palette (the logic paints it from palette.json, as the bar's) ──
    fact cn_kind = 0
    fact cn_scale = 1
    fact fr_ground_r = 0.000000
    fact fr_ground_g = 0.000000
    fact fr_ground_b = 0.000000
    fact fr_hull_r = 0.015686
    fact fr_hull_g = 0.035294
    fact fr_hull_b = 0.031373
    fact fr_hull_raised_r = 0.027451
    fact fr_hull_raised_g = 0.074510
    fact fr_hull_raised_b = 0.066667
    fact fr_well_r = 0.019608
    fact fr_well_g = 0.164706
    fact fr_well_b = 0.145098
    fact fr_trace_dim_r = 0.121569
    fact fr_trace_dim_g = 0.219608
    fact fr_trace_dim_b = 0.200000
    fact fr_trace_r = 0.239216
    fact fr_trace_g = 0.415686
    fact fr_trace_b = 0.376471
    fact fr_trace_lit_r = 0.423529
    fact fr_trace_lit_g = 0.788235
    fact fr_trace_lit_b = 0.682353
    fact fr_phos_r = 0.498039
    fact fr_phos_g = 0.811765
    fact fr_phos_b = 0.713725
    fact fr_phos_fill_r = 0.090196
    fact fr_phos_fill_g = 0.603922
    fact fr_phos_fill_b = 0.533333
    fact fr_ember_r = 0.878431
    fact fr_ember_g = 0.482353
    fact fr_ember_b = 0.180392
    fact fr_ember_fill_r = 0.823529
    fact fr_ember_fill_g = 0.411765
    fact fr_ember_fill_b = 0.117647
    fact fr_flare_r = 0.956863
    fact fr_flare_g = 0.713725
    fact fr_flare_b = 0.235294
    fact fr_muted_r = 0.352941
    fact fr_muted_g = 0.541176
    fact fr_muted_b = 0.494118
    fact fr_ink_r = 0.015686
    fact fr_ink_g = 0.129412
    fact fr_ink_b = 0.113725
    fact fr_steel_900_r = 0.082353
    fact fr_steel_900_g = 0.098039
    fact fr_steel_900_b = 0.105882
    fact fr_steel_700_r = 0.164706
    fact fr_steel_700_g = 0.192157
    fact fr_steel_700_b = 0.203922
    fact fr_steel_500_r = 0.290196
    fact fr_steel_500_g = 0.329412
    fact fr_steel_500_b = 0.349020
    fact fr_steel_300_r = 0.545098
    fact fr_steel_300_g = 0.592157
    fact fr_steel_300_b = 0.611765
    fact fr_engrave_r = 0.603922
    fact fr_engrave_g = 0.650980
    fact fr_engrave_b = 0.670588
    prop pr_ground_r = 0.000000 ~fl.relight
    follow pr_ground_r = fr_ground_r
    prop pr_ground_g = 0.000000 ~fl.relight
    follow pr_ground_g = fr_ground_g
    prop pr_ground_b = 0.000000 ~fl.relight
    follow pr_ground_b = fr_ground_b
    prop pr_hull_r = 0.015686 ~fl.relight
    follow pr_hull_r = fr_hull_r
    prop pr_hull_g = 0.035294 ~fl.relight
    follow pr_hull_g = fr_hull_g
    prop pr_hull_b = 0.031373 ~fl.relight
    follow pr_hull_b = fr_hull_b
    prop pr_hull_raised_r = 0.027451 ~fl.relight
    follow pr_hull_raised_r = fr_hull_raised_r
    prop pr_hull_raised_g = 0.074510 ~fl.relight
    follow pr_hull_raised_g = fr_hull_raised_g
    prop pr_hull_raised_b = 0.066667 ~fl.relight
    follow pr_hull_raised_b = fr_hull_raised_b
    prop pr_well_r = 0.019608 ~fl.relight
    follow pr_well_r = fr_well_r
    prop pr_well_g = 0.164706 ~fl.relight
    follow pr_well_g = fr_well_g
    prop pr_well_b = 0.145098 ~fl.relight
    follow pr_well_b = fr_well_b
    prop pr_trace_dim_r = 0.121569 ~fl.relight
    follow pr_trace_dim_r = fr_trace_dim_r
    prop pr_trace_dim_g = 0.219608 ~fl.relight
    follow pr_trace_dim_g = fr_trace_dim_g
    prop pr_trace_dim_b = 0.200000 ~fl.relight
    follow pr_trace_dim_b = fr_trace_dim_b
    prop pr_trace_r = 0.239216 ~fl.relight
    follow pr_trace_r = fr_trace_r
    prop pr_trace_g = 0.415686 ~fl.relight
    follow pr_trace_g = fr_trace_g
    prop pr_trace_b = 0.376471 ~fl.relight
    follow pr_trace_b = fr_trace_b
    prop pr_trace_lit_r = 0.423529 ~fl.relight
    follow pr_trace_lit_r = fr_trace_lit_r
    prop pr_trace_lit_g = 0.788235 ~fl.relight
    follow pr_trace_lit_g = fr_trace_lit_g
    prop pr_trace_lit_b = 0.682353 ~fl.relight
    follow pr_trace_lit_b = fr_trace_lit_b
    prop pr_phos_r = 0.498039 ~fl.relight
    follow pr_phos_r = fr_phos_r
    prop pr_phos_g = 0.811765 ~fl.relight
    follow pr_phos_g = fr_phos_g
    prop pr_phos_b = 0.713725 ~fl.relight
    follow pr_phos_b = fr_phos_b
    prop pr_phos_fill_r = 0.090196 ~fl.relight
    follow pr_phos_fill_r = fr_phos_fill_r
    prop pr_phos_fill_g = 0.603922 ~fl.relight
    follow pr_phos_fill_g = fr_phos_fill_g
    prop pr_phos_fill_b = 0.533333 ~fl.relight
    follow pr_phos_fill_b = fr_phos_fill_b
    prop pr_ember_r = 0.878431 ~fl.relight
    follow pr_ember_r = fr_ember_r
    prop pr_ember_g = 0.482353 ~fl.relight
    follow pr_ember_g = fr_ember_g
    prop pr_ember_b = 0.180392 ~fl.relight
    follow pr_ember_b = fr_ember_b
    prop pr_ember_fill_r = 0.823529 ~fl.relight
    follow pr_ember_fill_r = fr_ember_fill_r
    prop pr_ember_fill_g = 0.411765 ~fl.relight
    follow pr_ember_fill_g = fr_ember_fill_g
    prop pr_ember_fill_b = 0.117647 ~fl.relight
    follow pr_ember_fill_b = fr_ember_fill_b
    prop pr_flare_r = 0.956863 ~fl.relight
    follow pr_flare_r = fr_flare_r
    prop pr_flare_g = 0.713725 ~fl.relight
    follow pr_flare_g = fr_flare_g
    prop pr_flare_b = 0.235294 ~fl.relight
    follow pr_flare_b = fr_flare_b
    prop pr_muted_r = 0.352941 ~fl.relight
    follow pr_muted_r = fr_muted_r
    prop pr_muted_g = 0.541176 ~fl.relight
    follow pr_muted_g = fr_muted_g
    prop pr_muted_b = 0.494118 ~fl.relight
    follow pr_muted_b = fr_muted_b
    prop pr_ink_r = 0.015686 ~fl.relight
    follow pr_ink_r = fr_ink_r
    prop pr_ink_g = 0.129412 ~fl.relight
    follow pr_ink_g = fr_ink_g
    prop pr_ink_b = 0.113725 ~fl.relight
    follow pr_ink_b = fr_ink_b
    prop pr_steel_900_r = 0.082353 ~fl.relight
    follow pr_steel_900_r = fr_steel_900_r
    prop pr_steel_900_g = 0.098039 ~fl.relight
    follow pr_steel_900_g = fr_steel_900_g
    prop pr_steel_900_b = 0.105882 ~fl.relight
    follow pr_steel_900_b = fr_steel_900_b
    prop pr_steel_700_r = 0.164706 ~fl.relight
    follow pr_steel_700_r = fr_steel_700_r
    prop pr_steel_700_g = 0.192157 ~fl.relight
    follow pr_steel_700_g = fr_steel_700_g
    prop pr_steel_700_b = 0.203922 ~fl.relight
    follow pr_steel_700_b = fr_steel_700_b
    prop pr_steel_500_r = 0.290196 ~fl.relight
    follow pr_steel_500_r = fr_steel_500_r
    prop pr_steel_500_g = 0.329412 ~fl.relight
    follow pr_steel_500_g = fr_steel_500_g
    prop pr_steel_500_b = 0.349020 ~fl.relight
    follow pr_steel_500_b = fr_steel_500_b
    prop pr_steel_300_r = 0.545098 ~fl.relight
    follow pr_steel_300_r = fr_steel_300_r
    prop pr_steel_300_g = 0.592157 ~fl.relight
    follow pr_steel_300_g = fr_steel_300_g
    prop pr_steel_300_b = 0.611765 ~fl.relight
    follow pr_steel_300_b = fr_steel_300_b
    prop pr_engrave_r = 0.603922 ~fl.relight
    follow pr_engrave_r = fr_engrave_r
    prop pr_engrave_g = 0.650980 ~fl.relight
    follow pr_engrave_g = fr_engrave_g
    prop pr_engrave_b = 0.670588 ~fl.relight
    follow pr_engrave_b = fr_engrave_b
    fact c_bg_primary_r = 0.062745
    fact c_bg_primary_g = 0.078431
    fact c_bg_primary_b = 0.086275
    fact c_bg_secondary_r = 0.086275
    fact c_bg_secondary_g = 0.105882
    fact c_bg_secondary_b = 0.117647
    fact c_surface_primary_r = 0.098039
    fact c_surface_primary_g = 0.121569
    fact c_surface_primary_b = 0.133333
    fact c_surface_elevated_r = 0.133333
    fact c_surface_elevated_g = 0.160784
    fact c_surface_elevated_b = 0.176471
    fact c_border_subtle_r = 0.172549
    fact c_border_subtle_g = 0.207843
    fact c_border_subtle_b = 0.223529
    fact c_fg_primary_r = 0.890196
    fact c_fg_primary_g = 0.913725
    fact c_fg_primary_b = 0.921569
    fact c_fg_secondary_r = 0.639216
    fact c_fg_secondary_g = 0.690196
    fact c_fg_secondary_b = 0.709804
    fact c_fg_muted_r = 0.541176
    fact c_fg_muted_g = 0.592157
    fact c_fg_muted_b = 0.611765
    fact c_accent_primary_r = 0.650980
    fact c_accent_primary_g = 0.952941
    fact c_accent_primary_b = 0.819608
    fact c_accent_secondary_r = 1.000000
    fact c_accent_secondary_g = 0.572549
    fact c_accent_secondary_b = 0.372549
    fact c_status_ok_r = 0.650980
    fact c_status_ok_g = 0.952941
    fact c_status_ok_b = 0.819608
    fact c_status_error_r = 1.000000
    fact c_status_error_g = 0.572549
    fact c_status_error_b = 0.372549
    fact c_focus_ring_r = 0.650980
    fact c_focus_ring_g = 0.952941
    fact c_focus_ring_b = 0.819608
    fact c_selection_bg_r = 0.164706
    fact c_selection_bg_g = 0.227451
    fact c_selection_bg_b = 0.211765

    // ── A place (D152): the island open now, grown out of the bar's piece as part of this body ──
    // The bar hands it over as it opens (`mooi-frame` facts, from shell/mooi.luau): the island's box on
    // the screen, the middle of the module it came from, and a count of openings (each runs the spring
    // from 0, even when one island follows another). Its content is the bar's, clipped to the same shape.
    fact pl_on = false
    fact pl_n = 0
    fact pl_x = 0
    fact pl_y = 0
    fact pl_w = 0
    fact pl_h = 0
    fact pl_tx = 0
    fact pl_r = 14
    prop pl_q = 0 ~m.isl
    follow pl_q = pl_n
    prop pl_c = 0 ~m.isl_out
    follow pl_c = if(pl_on, 1, 0)
    // the Control Nexus's deck (shell/mooi-nexus.luau hands it over): its box on the screen, the edge it grows out of (0 foot · 1 top · 2 left · 3 right), a count
    fact dk_on = false
    fact dk_n = 0
    fact dk_x = 0
    fact dk_y = 0
    fact dk_w = 0
    fact dk_h = 0
    fact dk_edge = 3
    fact dk_r = 14
    prop dk_q = 0 ~m.isl
    follow dk_q = dk_n
    prop dk_c = 0 ~m.isl_out
    follow dk_c = if(dk_on, 1, 0)
    fact st_offset = 0
    fact st_notch = false
    fact st_height = 30
    fact st_radius = 8
    fact st_res = 46
    fact st_glow = 1
    fact st_width = 1
    fact st_owidth = 1.4
    fact st_ocol = 0
    fact st_frame_r = 14
    fact st_frame_edge = 0       // 0 line · 1 neon · 2 none
    fact st_frame_op = 1
    fact bar_surface = 0         // 0 solid · 1 glass · 2 blur · 3 clear · 4 machined
    fact bar_ground = 0
    fact bar_frame = 0           // the bar's outline: 0 a line (the only one that joins the frame)
    fact bar_rail = false
    fact band_on = true          // D153: the band (frame.on); off, only the bar's pieces and what grows out of them
    fact frame_band = 6
    fact frame_reach = 18
    fact frame_edges = 0         // 0 all · 1 sides · 2 the ends
    fact frame_music = true

    // the bar's notch pieces (bar-geo.json): x and width of each cluster, 0 wide when it is not there
    fact gl_x = 0
    fact gl_w = 0
    fact gc_x = 0
    fact gc_w = 0
    fact gr_x = 0
    fact gr_w = 0

    // the music (iNiR's IrisFramePulse): the level, fast up and slow down, and the wave's phase
    fact flev = 0
    fact fph = 0
    // the bar's islands and its full panel (bar-geo.json), and which the bar is: 0 islands · 1 full · 2 notch
    fact ix0 = 0
    fact iw0 = 0
    fact ix1 = 0
    fact iw1 = 0
    fact ix2 = 0
    fact iw2 = 0
    fact ix3 = 0
    fact iw3 = 0
    fact ix4 = 0
    fact iw4 = 0
    fact ix5 = 0
    fact iw5 = 0
    fact ix6 = 0
    fact iw6 = 0
    fact ix7 = 0
    fact iw7 = 0
    fact ix8 = 0
    fact iw8 = 0
    fact ix9 = 0
    fact iw9 = 0
    fact ix10 = 0
    fact iw10 = 0
    fact ix11 = 0
    fact iw11 = 0
    fact ix12 = 0
    fact iw12 = 0
    fact ix13 = 0
    fact iw13 = 0
    fact ix14 = 0
    fact iw14 = 0
    fact ix15 = 0
    fact iw15 = 0
    fact il_x = -1                 // where the first island begins, and the last ends (-1: none)
    fact ir_e = -1
    fact gp_x = 0
    fact gp_w = 0
    fact bar_mode = 0
    fact st_opacity = 1
    fact st_sh_y = 4
    fact st_sh_blur = 14
    fact st_sh_a = 0.35
    fact st_frost = 0
    fact st_smoke = 0

    // ── Motion ──
    spring fr.flow = 640, 46        // the pieces move as the bar's do (its fl.flow)
    prop plx = 0 ~fr.flow
    follow plx = gl_x
    prop plw = 0 ~fr.flow
    follow plw = gl_w
    prop pcx = 0 ~fr.flow
    follow pcx = gc_x
    prop pcw = 0 ~fr.flow
    follow pcw = gc_w
    prop prx = 0 ~fr.flow
    follow prx = gr_x
    prop prw = 0 ~fr.flow
    follow prw = gr_w

    // ── The chassis (D127, D128): iNiR's iRiS frame, in pleamar ──
    // Everything on the screen's edge is one body: the band round the screen and every piece of the bar,
    // melted together (pleamar's `blend` is the smooth union iNiR's shader computes), so the bar grows out
    // of the frame with a fillet on each side instead of floating over it. One fill, one border round the
    // whole silhouette, one shadow. The bar paints only what sits on its plates while the frame is on
    // (shell/mooi.plm), so nothing is drawn twice.
    //
    // That body is drawn by four strips that do not overlap: the top and the foot the full width, the
    // sides between them (tools/gen-frame.py writes them). Each evaluates the same shapes and shows its
    // own slice, so the edges, the corners and the outline run on across the seams as one; and each only
    // repaints its own pixels — a full-screen body redrawn thirty times a second held the GPU at ~90 %.
    //
    // The music (iNiR's IrisFramePulse): every edge's inner side is pushed in by level × reach, varying
    // along it as 0.60 + 0.24·sin(y·0.011 + t) + 0.16·sin(y·0.027 − 1.4t) down the sides and
    // 0.60 + 0.24·sin(x·0.009 − t) + 0.16·sin(x·0.023 + 1.2t) along the top and foot — the top too: between
    // and under the bar's pieces, which ride on it. The level and the phase `t` come from the logic
    // (shell/mooi-frame.luau); sin here takes degrees, hence the factors.
    let W = frame_t.width
    let H = frame_l.height + 288                               // the sides stop short of the top (160) and the foot (128) strips
    let bs = frame_band                                        // the sides
    let bb = frame_band                                        // the foot
    let bt = frame_band                                        // the top
    let frr = clamp(st_frame_r, 0, 40)                         // the inner corners
    let reach = frame_reach * 1.6
    let wl = if(frame_edges != 2, flev * reach, 0)             // sides (all, sides)
    let wt = if(frame_edges != 1, flev * reach, 0)             // top and foot (all, ends)
    let wa = fph * 57.29578
    let wb = fph * 80.21409
    let wc = fph * 68.75494
    let kf = 12                                                // the fillet where a piece meets the band

    // the bar's row, as the bar lays it out (theme/ferrolume.plm)
    let row_b = fl.top + fl.mod_h                              // an island's foot, the full panel's
    let n_pad = 10
    let n_r = st_radius + 4
    let n_b = if(band_on, st_res, fl.top + fl.mod_h + 6)       // a notch piece's foot (the bar's own without the band)

    // Does a piece of the bar sit in a corner (it starts within the corner's round, or within the side's
    // swing and the fillet, of the side)? Then that corner turns at the piece's foot, so all four are the
    // same round whatever the bar does, and the side never runs up past a piece it would melt into.
    let cr = bs + frr + reach + kf
    let foot = if(bar_mode == 2, n_b, row_b)
    let covL = pick(bar_mode, il_x >= 0 and il_x - 3 <= cr, gp_w > 1 and gp_x <= cr, plw > 1 and plx - n_pad <= cr)
    let covR = pick(bar_mode, ir_e >= 0 and ir_e + 3 >= W - cr, gp_w > 1 and gp_x + gp_w >= W - cr, prw > 1 and prx + prw + n_pad >= W - cr)

    // the place's body as it grows (the same formula as ui/island.plm's content clip, D152): from the
    // module's pill at 55 % on the bar's foot to the island — across on the spring, down on the spring
    // squared (it pours rather than scales), its corners from the pill's to its own
    let pl_rv = min(clamp(pl_q - (pl_n - 1), 0, 1), pl_c)
    let pl_act = pl_rv > 0.002
    let pl_lag = pl_rv * pl_rv
    let pl_x0 = pl_tx - 22 * 0.55
    let pl_y0 = pl_y - 14
    let pl_bx = pl_x0 + (pl_x - pl_x0) * pl_rv
    let pl_bw = 44 * 0.55 + (pl_w - 44 * 0.55) * pl_rv
    let pl_by = pl_y0 + (pl_y - pl_y0) * pl_rv
    let pl_bh = 12 + (pl_h - 12) * pl_lag
    let pl_br = min(min(pl_bw, pl_bh) / 2, 6 + (pl_r - 6) * pl_rv)
    // the stretch of the top strip it crosses (its tiles are drawn by `frame_p` while it is out)
    let pl_l = min(pl_x, pl_tx - 40) - 64
    let pl_e = max(pl_x + pl_w, pl_tx + 40) + 64
    let pl_t = pl_y0 - 64
    let pl_b = pl_y + pl_h + 64
    // an edge's place: a sliver on the band's inner edge, a third of the place's length, spreads along
    // the edge on the spring and pours out of it on the spring squared (iNiR: it spreads, then pours)
    let dk_rv = min(clamp(dk_q - (dk_n - 1), 0, 1), dk_c)
    let dk_act = dk_rv > 0.002
    let dk_hz = dk_edge >= 2
    let dk_sx = if(dk_edge == 3, W - bs - 12, if(dk_edge == 2, bs, dk_x + dk_w * 0.35))
    let dk_sw = if(dk_hz, 12, dk_w * 0.3)
    let dk_sy = if(dk_edge == 0, H - bb - 12, if(dk_edge == 1, bt, dk_y + dk_h * 0.35))
    let dk_sh = if(dk_hz, dk_h * 0.3, 12)
    let dk_px = if(dk_hz, dk_rv * dk_rv, dk_rv)
    let dk_py = if(dk_hz, dk_rv, dk_rv * dk_rv)
    let dk_bx = dk_sx + (dk_x - dk_sx) * dk_px
    let dk_bw = dk_sw + (dk_w - dk_sw) * dk_px
    let dk_by = dk_sy + (dk_y - dk_sy) * dk_py
    let dk_bh = dk_sh + (dk_h - dk_sh) * dk_py
    let dk_br = min(min(dk_bw, dk_bh) / 2, 6 + (dk_r - 6) * dk_rv)
    let dk_l = min(dk_x, dk_sx) - 64
    let dk_e = max(dk_x + dk_w, dk_sx + dk_sw) + 64
    let dk_t = min(dk_y, dk_sy) - 64
    let dk_b = max(dk_y + dk_h, dk_sy + dk_sh) + 64

    // the material: the bar's own, so the bar and the frame are one thing
    let mech = bar_surface > 3.5
    let fcol = mix(mix(fl.hull, fl.ground, bar_ground < 0.5), fl.steel_900, mech)
    let fnec = mix(mix(mix(fl.trace, fl.trace_lit, clamp(st_ocol, 0, 1)), fl.phos_fill, clamp(st_ocol - 1, 0, 1)), fl.steel_300, mech)
    let glassy = bar_surface > 0.5 and bar_surface < 2.5
    let fop = max(st_opacity, 0.3) * if(bar_surface > 2.5 and not mech, 0, 1)

    // <gen:frame>
    // the moving edges, sampled: sw down the sides (left and right alike), fw along the top and foot
    let sw0 = wl * (0.6 + 0.24 * sin((H * 0) * 0.630254 + wa) + 0.16 * sin((H * 0) * 1.546986 - wb))
    let sw1 = wl * (0.6 + 0.24 * sin((H * 0.020833) * 0.630254 + wa) + 0.16 * sin((H * 0.020833) * 1.546986 - wb))
    let sw2 = wl * (0.6 + 0.24 * sin((H * 0.041667) * 0.630254 + wa) + 0.16 * sin((H * 0.041667) * 1.546986 - wb))
    let sw3 = wl * (0.6 + 0.24 * sin((H * 0.0625) * 0.630254 + wa) + 0.16 * sin((H * 0.0625) * 1.546986 - wb))
