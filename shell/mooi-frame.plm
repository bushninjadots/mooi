                        path { show: band_on; move W + 40, H * 0.0625
                               line W - bs - sw3, H * 0.0625
                               line W - bs - sw4, H * 0.083333
                               line W - bs - sw5, H * 0.104167
                               line W - bs - sw6, H * 0.125
                               line W - bs - sw7, H * 0.145833
                               line W - bs - sw8, H * 0.166667
                               line W - bs - sw9, H * 0.1875
                               line W - bs - sw10, H * 0.208333
                               line W - bs - sw11, H * 0.229167
                               line W - bs - sw12, H * 0.25
                               line W - bs - sw13, H * 0.270833
                               line W - bs - sw14, H * 0.291667
                               line W - bs - sw15, H * 0.3125
                               line W + 40, H * 0.3125
                               close }
                        path { show: band_on; move W + 40, -40; line xTR - frr, -40; line xTR - frr, yTR; curve xTR, yTR + frr via xTR, yTR; line W + 40, yTR + frr; close }
                    }
                }
                group {
                    show: not ((pl_act and pl_e > W / 2 and pl_t < min(H - 128, H * 0.375) and pl_b > max(160, H * 0.25)) or (dk_act and dk_e > W / 2 and dk_t < min(H - 128, H * 0.375) and dk_b > max(160, H * 0.25)))
                    clip box { from: W / 2, max(160, H * 0.25); size: W / 2 + 40, max(0, min(H - 128, H * 0.375) - max(160, H * 0.25)) }
