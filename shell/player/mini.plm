// The mini card (the music player overhaul): what a press on the bar's music icon opens first —
// a signal board in the Control Nexus's language. The cover is the core node (press: play/pause;
// the ring round it is the progress, pressed or dragged round to seek); previous and next are pad
// nodes wired to it; the title is a readout on its own trace; the volume a via sliding up a
// trace; the visualiser pins stand on a bus along the foot; OPEN PLAYER grows it into the panel.
// Pulses run the traces while music plays and coast to a stop with the record (`vang`), so a
// paused card draws nothing. A part of shell/mooi-player.plm (`include`d in its surface). It
// takes no keyboard (a card must not steal typing): a press anywhere outside it closes it.
part Mini {
        group {
            show: mn_a > 0.004
            let cw = 420
            let ch = 200
            let cx0 = clamp(if(pl_cx > 0, pl_cx - 120, (sw - cw) / 2), 10, sw - cw - 10)
            // the core, and where things are wired
            let ox = 210
            let oy = 104
            let orr = 44
            let ring = 55
            let px1 = 88
            let nx1 = 332
            let bus = 182
            // a pulse's place along the bus, 0 … 1 (the record's turning drives it)
            let pz = mod(vang, 720) / 720
            let on = pstate == playing
            zone box maway { from: 0, 0; size: sw, sh; label: "Close the player"; agent: hidden }
            on press maway { emit pl_size(-1) }

            group {
                move: cx0, pl_top - (1 - mn_a) * 12
                opacity: min(1, mn_a * 1.4)
                zone box mbody { from: 0, 0; size: cw, ch; agent: hidden }

                // ── the board ─────────────────────────────────────
                group {
                    glow: 18, 24% * st_glow, fl.phos
                    Chamfer(0, 0, cw, ch, 14, fl.hull, mix(fl.trace, fl.phos, 0.35), 1, 1.4)
                }
                repeat k in 0..104 {
                    ellipse { at: 21 + mod(k, 13) * 31, 18 + floor(k / 13) * 23; radius: 0.8; color: fl.trace_dim; opacity: 0.7 }
                }

                // ── the traces (drawn under the nodes) ────────────
                let tw = 1.6
                let tc = mix(fl.trace, fl.phos, if(on, 0.45, 0.15))
                // core ↔ previous, core ↔ next
                line { from: px1 + 20, oy; to: ox - ring - 4, oy; width: tw; color: tc }
                line { from: ox + ring + 4, oy; to: nx1 - 20, oy; width: tw; color: tc }
                // previous, next and the core down to the bus (45° shoulders)
                path { color: tc; stroke: tw; move px1, oy + 20; line px1, bus - 12; line px1 + 12, bus }
                path { color: tc; stroke: tw; move nx1, oy + 20; line nx1, bus - 12; line nx1 - 12, bus }
                line { from: ox, oy + ring + 4; to: ox, bus; width: tw; color: tc }
                // the readout's trace into the core's shoulder
                path { color: tc; stroke: tw; move 168, 46; line 182, 46; line 182, oy - ring + 4; line ox - 26, oy - ring + 4 }
                // OPEN PLAYER's trace down to the next pad
                path { color: tc; stroke: tw; move 350, 46; line nx1, 64; line nx1, oy - 20 }
                // the bus
                line { from: 18, bus; to: cw - 40, bus; width: tw + 0.6; color: tc }
                // vias where traces meet the bus
                ellipse { at: px1 + 12, bus; radius: 3; color: tc }
                ellipse { at: ox, bus; radius: 3; color: tc }
                ellipse { at: nx1 - 12, bus; radius: 3; color: tc }

                // ── pulses: light running the traces while it plays ──
                group {
                    show: on and spd > 1
                    glow: 8, 70% * st_glow, fl.phos
                    ellipse { at: 18 + (cw - 58) * pz, bus; radius: 2.6; color: fl.phos }
                    ellipse { at: 18 + (cw - 58) * mod(pz + 0.5, 1), bus; radius: 2; color: fl.ember }
                    ellipse { at: ox - ring - 4 - (ox - ring - 24 - px1) * mod(pz * 2, 1), oy; radius: 2.2; color: fl.phos }
                    ellipse { at: ox + ring + 4 + (nx1 - 24 - ox - ring) * mod(pz * 2, 1), oy; radius: 2.2; color: fl.phos }
                    ellipse { at: ox, oy + ring + 4 + (bus - oy - ring - 4) * mod(pz * 3, 1); radius: 2; color: fl.ember }
                }

                // ── the visualiser: pins standing on the bus ──────
                repeat k in 0..24 {
                    let mv = clamp(pick(k, vp0, vp1, vp2, vp3, vp4, vp5, vp6, vp7, vp8, vp9, vp10, vp11,
                                        vp12, vp13, vp14, vp15, vp16, vp17, vp18, vp19, vp20, vp21, vp22, vp23), 0.04, 1)
                    // twelve each side of the core's drop, clear of the pads' traces
                    let pxk = if(k < 12, 104 + k * 7.6, 222 + (k - 12) * 7.6)
                    box { from: pxk, bus - 3 - mv * 30; size: 3, 3 + mv * 30; corner: 1.5; color: mix(fl.phos, fl.ember, mv); opacity: 0.9 }
                }

                // ── the readout: the song ─────────────────────────
                Chamfer(14, 14, 154, 52, 7, fl.well, mix(fl.trace_dim, fl.phos, 0.25), 1, 1)
                text pick(has_song, "NOTHING PLAYING", t_title) { at: 24, 31; anchor: left center; size: 11.5; weight: 700
                     color: fl.engrave; width: 136; lines: 1 }
                text pick(has_song, "open the library", t_artist) { at: 24, 49; anchor: left center; size: 9.5
                     color: fl.muted; width: 136; lines: 1 }
                text pick(has_song, "", "{t_elapsed} / {t_total}") { at: 24, 76; anchor: left center; size: 8.5
                     family: "Share Tech Mono"; color: fl.trace_lit }

                // ── the core: the cover, the progress ring round it ─
                zone box mring { from: ox - ring - 8, oy - ring - 8; size: ring * 2 + 16, ring * 2 + 16; cursor: pointer
                                 role: slider; label: "Position — press or drag round the ring"; value: prg; show: has_song }
                arc { at: ox, oy; radius: ring; width: 3; span: 360deg; color: fl.ground }
                group {
                    glow: 10, 55% * st_glow, fl.phos
                    arc { at: ox, oy; radius: ring; width: 3; span: clamp(prg, 0, 1) * 360deg; rotate: clamp(prg, 0, 1) * 180deg
                          color: fl.phos; show: has_song }
                }
                ellipse { at: ox + sin(clamp(prg, 0, 1) * 360) * ring, oy - cos(clamp(prg, 0, 1) * 360) * ring; radius: 4 + mring.hover * 2
                          color: fl.engrave; show: has_song }
                on press mring { emit pl_seek(round(mod(atan2(local.x - ox, oy - local.y) + 360, 360) / 360 * 1000)) }
                on drag mring { emit pl_seek(round(mod(atan2(local.x - ox, oy - local.y) + 360, 360) / 360 * 1000)) }

                zone box mcore { from: ox - orr, oy - orr; size: orr * 2, orr * 2; cursor: pointer; role: button
                                 label: pick(on, "Play", "Pause") }
                ellipse { at: ox, oy; radius: orr + 2; color: fl.well }
                group {
                    show: cover_on
                    clip box { from: ox - orr, oy - orr; size: orr * 2, orr * 2; corner: orr }
                    group {
                        rotate: vang * 0.12deg
                        image cover { at: ox - orr, oy - orr; size: orr * 2, orr * 2 }
                    }
                }
                text "♪" { at: ox, oy; anchor: center; size: 28; color: fl.trace; show: not cover_on }
                // play/pause shows over the cover while hovered or paused
                group {
                    opacity: max(mcore.hover, if(on, 0, 0.85))
                    ellipse { at: ox, oy; radius: 18; color: fl.ground; opacity: 0.7 }
                    path { color: fl.phos; show: not on; move ox - 5, oy - 8; line ox + 8, oy; line ox - 5, oy + 8; close }
                    box { from: ox - 7, oy - 7; size: 4, 14; corner: 1; color: fl.phos; show: on }
                    box { from: ox + 3, oy - 7; size: 4, 14; corner: 1; color: fl.phos; show: on }
                }
                on press mcore { emit pl_toggle }

                // ── the pads: previous and next ───────────────────
                zone box mprev { from: px1 - 20, oy - 20; size: 40, 40; cursor: pointer; role: button; label: "Previous" }
                Chamfer(px1 - 18, oy - 18, 36, 36, 8, mix(fl.hull_raised, fl.phos, mprev.hover * 0.15), mix(fl.trace, fl.phos, 0.4 + mprev.hover * 0.6), 1, 1.3)
                path { color: mix(fl.engrave, fl.phos, mprev.hover); move px1 + 4, oy - 6; line px1 - 5, oy; line px1 + 4, oy + 6; close }
                box { from: px1 - 7, oy - 6; size: 2, 12; color: mix(fl.engrave, fl.phos, mprev.hover) }
                on press mprev { emit pl_prev }
                zone box mnext { from: nx1 - 20, oy - 20; size: 40, 40; cursor: pointer; role: button; label: "Next" }
                Chamfer(nx1 - 18, oy - 18, 36, 36, 8, mix(fl.hull_raised, fl.phos, mnext.hover * 0.15), mix(fl.trace, fl.phos, 0.4 + mnext.hover * 0.6), 1, 1.3)
                path { color: mix(fl.engrave, fl.phos, mnext.hover); move nx1 - 4, oy - 6; line nx1 + 5, oy; line nx1 - 4, oy + 6; close }
                box { from: nx1 + 5, oy - 6; size: 2, 12; color: mix(fl.engrave, fl.phos, mnext.hover) }
                on press mnext { emit pl_next }

                // ── the volume: a via up its own trace ────────────
                let vx = cw - 24
                let vt = 30
                let vb = bus - 4
                zone box mvol { from: vx - 12, vt; size: 24, vb - vt; cursor: pointer; role: slider; label: "Volume"; value: vol / 100; show: vol_on }
                line { from: vx, vt; to: vx, vb; width: 2; color: fl.ground; show: vol_on }
                line { from: vx, vb - (vb - vt) * clamp(vol / 100, 0, 1); to: vx, vb; width: 2; color: fl.trace_lit; show: vol_on }
                Chamfer(vx - 7, vb - (vb - vt) * clamp(vol / 100, 0, 1) - 5, 14, 10, 3, fl.hull_raised, mix(fl.trace_lit, fl.phos, mvol.hover), 1, 1.2)
                text "VOL" { at: vx, vt - 10; anchor: center; size: 7; family: "Share Tech Mono"; color: fl.muted; show: vol_on }
                on press mvol { emit pl_vol(round(clamp((vb - local.y) / (vb - vt), 0, 1) * 100)) }
                on drag mvol { emit pl_vol(round(clamp((vb - local.y) / (vb - vt), 0, 1) * 100)) }

                // ── OPEN PLAYER: the same window grows into the panel ─
                zone box mopen { from: 296, 14; size: 92, 30; cursor: pointer; role: button; label: "Open the player" }
                Chamfer(296, 14, 92, 30, 6, mix(fl.hull_raised, fl.phos, 0.12 + mopen.hover * 0.14), mix(fl.trace, fl.phos, 0.5 + mopen.hover * 0.5), 1, 1.2)
                text "OPEN PLAYER" { at: 342, 29; anchor: center; size: 8.5; weight: 700; family: "Share Tech Mono"; color: fl.phos }
                on press mopen { emit pl_size(1) }
            }
        }
}
