// The panel: the turntable, the transport and the pane — a part of shell/mooi-player.plm (`include`d in its surface): it reads the surface's lets.
part Panel {
        group {
            show: pl_a > 0.004 and size == panel
            zone box away { from: 0, 0; size: sw, sh; label: "Close the player"; agent: hidden }
            on press away { emit pl_close }

            group {
                move: px, py - (1 - pl_a) * 16
                scale: 0.97 + 0.03 * pl_a
                opacity: min(1, pl_a * 1.4)
                zone box body { from: 0, 0; size: pw, ph; agent: hidden }

                // the plate, and the cover's light behind it all, out of focus — or, while a video plays
                // under this overlay, the plate in four pieces round its box, which is left undrawn
                let hx = rcx - rr - 30
                let hw = 2 * rr + 100
                // the video's box: 16:9 across the left plate, in its middle
                let vh = round(hw * 9 / 16)
                let vy = 64 + round((ph - 84 - vh) / 2)
                group {
                    show: video_on
                    box { from: 0, 0; size: pw, vy; color: fl.hull }
                    box { from: 0, vy + vh; size: pw, ph - vy - vh; color: fl.hull }
                    box { from: 0, vy; size: hx, vh; color: fl.hull }
                    box { from: hx + hw, vy; size: pw - hx - hw, vh; color: fl.hull }
                    box { from: hx - 1, vy - 1; size: hw + 2, vh + 2; corner: 2; stroke: 1.4; color: mix(fl.trace, fl.phos, 0.5) }
                    text "FINDING THE VIDEO…" { at: hx + hw / 2, vy + vh / 2; anchor: center; size: 10; family: "Share Tech Mono"
                         color: fl.muted; show: video_busy }
                }
                group {
                    show: not video_on
                    glow: 22, 30% * st_glow, fl.phos
                    Chamfer(0, 0, pw, ph, 14, fl.hull, mix(fl.trace, fl.phos, 0.35), 1, 1.4)
                }
                group {
                    show: cover_on and not video_on
                    clip box { from: 2, 2; size: pw - 4, ph - 4 }
                    group {
                        blur: 40
                        opacity: 0.28
                        image cover { at: -60, -260; size: pw + 120, pw + 120 }
                    }
                }

                // ── the head ──
                text "PLAYER" { at: 24, 26; anchor: left center; size: 12; weight: 700; family: "Share Tech Mono"; color: fl.ember }
                zone box zsrc0 { from: 108, 14; size: 92, 24; cursor: pointer; role: tab; selected: src == library; label: "Your library (mpd)" }
                PChip(108, 15, 92, "LIBRARY", src == library, zsrc0.hover)
                on press zsrc0 { emit pl_src(0) }
                zone box zsrc1 { from: 206, 14; size: 116, 24; cursor: pointer; role: tab; selected: src == remote; label: "Whatever else is playing" }
                PChip(206, 15, 116, "ELSEWHERE", src == remote, zsrc1.hover)
                on press zsrc1 { emit pl_src(1) }
                ellipse { at: 314, 19; radius: 3; color: fl.flare; show: has_remote and src != remote }
                text t_status { at: 340, 26; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.muted; width: 400; lines: 1 }
                zone box zfull { from: pw - 104, 13; size: 54, 24; cursor: pointer; role: button; label: "Full screen" }
                PChip(pw - 104, 14, 54, "FULL", false, zfull.hover)
                on press zfull { emit pl_full }
                // the view: the DJ deck, the cover stage, the instrument rack
                repeat vv in 0..3 {
                    zone box zview.$vv { from: pw - 420 + vv * 74, 13; size: 70, 24; cursor: pointer; role: tab
                                         selected: pick(vv, view == deck, view == stage, view == rack); label: pick(vv, "The DJ deck", "The cover stage", "The instrument rack") }
                    PChip(pw - 420 + vv * 74, 14, 70, pick(vv, "DECK", "STAGE", "RACK"), pick(vv, view == deck, view == stage, view == rack), zview.$vv.hover)
                    on press zview.$vv { emit pl_view(vv) }
                }
                // the song's video, in the view's own box (not the rack: it has no picture to give way)
                zone box zvid { from: pw - 494, 13; size: 66, 24; cursor: pointer; role: toggle; checked: video_on
                                label: "The song's video, in the view"; show: view != rack and video_ok }
                group { show: view != rack and video_ok
                        opacity: if(src == library and video_tools, 1, 0.4)
                        PChip(pw - 494, 14, 66, pick(video_on, "VIDEO", "MUSIC"), video_on, zvid.hover) }
                on press zvid { vbx = px + hx; vby = py + vy; vbw = hw; vbh = vh; emit video_toggle }
                zone box zcol { from: pw - 178, 13; size: 66, 24; cursor: pointer; role: toggle; checked: cover_tint
                                label: "Colours from the album cover" }
                PChip(pw - 178, 14, 66, "COVER", cover_tint, zcol.hover)
                on press zcol { emit pl_tint }
                zone box zclose { from: pw - 44, 10; size: 30, 30; cursor: pointer; role: button; label: "Close the player" }
                line { from: pw - 35, 19; to: pw - 23, 31; width: 1.5; color: mix(fl.muted, fl.ember, zclose.hover) }
                line { from: pw - 23, 19; to: pw - 35, 31; width: 1.5; color: mix(fl.muted, fl.ember, zclose.hover) }
                on press zclose { emit pl_close }
                box { from: 18, 48; size: pw - 36, 1; color: fl.trace_dim; opacity: 0.8 }

                // ── the view, on the left plate ──
                let vx0 = rcx - rr - 30
                let vw0 = 2 * rr + 100
                group {
                    show: view == deck and not video_on
                    // ── the turntable ──
                    // the plinth: a cut plate of brushed steel, a strobe dot ring at its edge
                    Chamfer(rcx - rr - 30, 64, 2 * rr + 60 + 40, ph - 84, 10, mix(fl.hull_raised, fl.steel_900, 0.5), fl.trace_dim, 1, 1)
                    repeat k in 0..72 {
                        ellipse { at: rcx + sin(k * 5) * (rr + 14), rcy - cos(k * 5) * (rr + 14); radius: 0.9
                                  color: fl.steel_500; opacity: 0.6 }
                    }
                    // the visualiser (ui/viz.plm): round the record, or along the plinth's foot
                    group {
                        opacity: if(pstate == playing, 0.95, 0.35)
                        viz.Pick(viz_deck, 36, ph - 64, 388, 40, rcx, rcy, rr + 20, 28, fl.phos, fl.flare, fl.trace_dim, vang, viz_still)
                    }
                    zone box pviz { from: 24, 22; size: 76, 16; cursor: pointer; role: button; label: "Visualiser style" }
                    text pick(viz_deck, "SPECTRUM", "MIRROR", "RING", "AURORA", "LED", "ORBIT", "VIZ OFF") { at: 28, 30; anchor: left center
                         size: 7.5; family: "Share Tech Mono"; color: mix(fl.muted, fl.phos, pviz.hover) }
                    on press pviz { emit viz_next(1) }
                    // the record: black vinyl, its grooves, a sheen that stays where the light is
                    ellipse { at: rcx, rcy; radius: rr; color: #08090a }
                    repeat g in 0..14 {
                        ellipse { at: rcx, rcy; radius: rl + 8 + g * (rr - rl - 12) / 13; stroke: 0.7; color: #1c1f22; opacity: 0.9 }
                    }
                    ellipse { at: rcx, rcy; radius: rr; stroke: 1.5; color: fl.steel_700 }
                    group {
                        mask: radial rcx, rcy radius rr - 2 to rr
                        path { color: #ffffff; opacity: 0.045
                               move rcx, rcy; line rcx + rr * 1.2, rcy - rr * 0.6; line rcx + rr * 1.2, rcy - rr * 0.1; close }
                        path { color: #ffffff; opacity: 0.045
                               move rcx, rcy; line rcx - rr * 1.2, rcy + rr * 0.6; line rcx - rr * 1.2, rcy + rr * 0.1; close }
                    }
                    // the label: the cover, round, turning with the record
                    group {
                        pivot: rcx, rcy
                        rotate: vang * 1deg
                        mask: radial rcx, rcy radius rl - 1 to rl
                        box { from: rcx - rl, rcy - rl; size: rl * 2, rl * 2; color: mix(fl.ember_fill, fl.hull, 0.3) }
                        image cover { at: rcx - rl, rcy - rl; size: rl * 2, rl * 2; show: cover_on }
                        // a mark on the label, so the turn can be seen even on a plain cover
                        box { from: rcx - 2, rcy - rl + 4; size: 4, 10; corner: 2; color: fl.engrave; opacity: 0.5; show: not cover_on }
                    }
                    ellipse { at: rcx, rcy; radius: rl; stroke: 1; color: #000000; opacity: 0.5 }
                    ellipse { at: rcx, rcy; radius: 5; color: fl.steel_300 }
                    ellipse { at: rcx, rcy; radius: 2; color: fl.steel_700 }
                    // the tonearm: its base, the arm, the head; dragged, it seeks
                    ellipse { at: apx, apy; radius: 22; color: fl.steel_700 }
                    ellipse { at: apx, apy; radius: 22; stroke: 1; color: fl.steel_300; opacity: 0.6 }
                    ellipse { at: apx, apy; radius: 9; color: fl.steel_500 }
                    group {
                        pivot: apx, apy
                        rotate: arm * 1deg
                        line { from: apx, apy; to: apx, apy + alen - 30; width: 4; color: fl.steel_300 }
                        line { from: apx, apy + alen - 30; to: apx - 10, apy + alen; width: 4; color: fl.steel_300 }
                        box { from: apx - 20, apy + alen - 6; size: 22, 14; corner: 2; color: fl.steel_500 }
                        box { from: apx - 18, apy + alen + 6; size: 4, 4; color: fl.phos; opacity: if(pstate == playing, 1, 0.3) }
                        // the counterweight behind the pivot
                        box { from: apx - 9, apy - 50; size: 18, 24; corner: 3; color: fl.steel_500 }
                    }
                    // the arm's head is the handle: carried, the angle is read from the pointer
                    zone box zarm { from: apx - 60, apy + 150; size: 120, 160; cursor: grab; role: slider; label: "The tonearm — carry it to seek"
                                    value: progress; show: has_song and src == library }
                    on press zarm { arm_drag = true; arm_at = arm }
                    on drag zarm while arm_drag { arm_at = clamp(atan2(apx - local.x, local.y - apy), 20, 40) }
                    on release zarm while arm_drag { arm_drag = false; emit pl_seek(round((arm_at - 20) / 20 * 1000)) }
                    views.DeckKit(vx0, 64, vw0, ph - 84)
                }
                group {
                    show: view == stage and not video_on
                    views.Stage(vx0, 64, vw0, ph - 84)
                }
                group {
                    show: view == rack
                    views.Rack(vx0, 64, vw0, ph - 84)
                }

                // ── the track ──
                text pick(has_song, "NOTHING IS PLAYING", t_title) { at: mx, 96; anchor: left center; size: 21; weight: 700; family: "Exo 2"
                      width: mw; lines: 2; color: fl.engrave }
                text t_artist { at: mx, 146; anchor: left center; size: 13; family: "Exo 2"; width: mw; lines: 1; color: fl.phos }
                text t_album { at: mx, 168; anchor: left center; size: 10; family: "Exo 2"; width: mw; lines: 1; color: fl.trace_lit }
                text t_meta { at: mx, 188; anchor: left center; size: 10; family: "Share Tech Mono"; width: mw; lines: 1; color: fl.muted }
                text "START mpd, OR PLAY SOMETHING ELSEWHERE" { at: mx, 146; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.muted
                      show: not has_song and not mpd_on and src == library }

                // the time: a bar to seek along, with the played part lit
                zone box zseek { from: mx - 4, 204; size: mw + 8, 50; cursor: pointer; role: slider; label: "Seek"; value: progress; show: has_song }
                group {
                    show: wave_on
                    image wave { at: mx, 206; size: mw, 30; tint: fl.trace; opacity: 0.55 }
                    group {
                        clip box { from: mx, 200; size: mw * clamp(prg, 0, 1), 40 }
                        image wave { at: mx, 206; size: mw, 30; tint: fl.phos; opacity: 0.95 }
                    }
                }
                box { from: mx, 238; size: mw, 6; corner: 3; color: fl.ground }
                group {
                    glow: 8, 45% * st_glow, fl.phos
                    box { from: mx, 238; size: mw * clamp(prg, 0, 1), 6; corner: 3; color: fl.phos; show: has_song }
                }
                ellipse { at: mx + mw * clamp(prg, 0, 1), 241; radius: 6 + zseek.hover * 2; color: fl.engrave; show: has_song }
                text t_elapsed { at: mx, 262; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.trace_lit }
                text t_total { at: mx + mw, 262; anchor: right center; size: 10; family: "Share Tech Mono"; color: fl.muted }
                on press zseek { emit pl_seek(round(clamp((local.x - mx) / mw, 0, 1) * 1000)) }
                on drag zseek { emit pl_seek(round(clamp((local.x - mx) / mw, 0, 1) * 1000)) }

                // the transport: shuffle, previous, play, next, repeat
                let tcx = mx + mw / 2
                let tcy = 330
                zone box zrnd { from: tcx - 156, tcy - 16; size: 32, 32; cursor: pointer; role: toggle; checked: rnd; label: "Shuffle" }
                PRound(tcx - 140, tcy, 16, if(rnd, 1, 0), fl.phos, zrnd.hover)
                line { from: tcx - 148, tcy - 5; to: tcx - 132, tcy + 5; width: 1.4; color: if(rnd, fl.phos, fl.muted) }
                line { from: tcx - 148, tcy + 5; to: tcx - 132, tcy - 5; width: 1.4; color: if(rnd, fl.phos, fl.muted) }
                on press zrnd { emit pl_rnd }
                zone box zprev { from: tcx - 98, tcy - 22; size: 44, 44; cursor: pointer; role: button; label: "Previous" }
                PRound(tcx - 76, tcy, 22, 0, fl.phos, zprev.hover)
                path { color: mix(fl.engrave, fl.phos, zprev.hover); move tcx - 70, tcy - 8; line tcx - 82, tcy; line tcx - 70, tcy + 8; close }
                box { from: tcx - 85, tcy - 8; size: 2.5, 16; color: mix(fl.engrave, fl.phos, zprev.hover) }
                on press zprev { emit pl_prev }
                zone box zplay { from: tcx - 34, tcy - 34; size: 68, 68; cursor: pointer; role: button; label: pick(pstate == playing, "Play", "Pause") }
                PRound(tcx, tcy, 34, if(pstate == playing, 1, 0.4), fl.phos, zplay.hover)
                path { color: fl.phos; show: pstate != playing; move tcx - 9, tcy - 14; line tcx + 15, tcy; line tcx - 9, tcy + 14; close }
                box { from: tcx - 11, tcy - 13; size: 7, 26; corner: 2; color: fl.phos; show: pstate == playing }
                box { from: tcx + 4, tcy - 13; size: 7, 26; corner: 2; color: fl.phos; show: pstate == playing }
                on press zplay { emit pl_toggle }
                zone box znext { from: tcx + 54, tcy - 22; size: 44, 44; cursor: pointer; role: button; label: "Next" }
                PRound(tcx + 76, tcy, 22, 0, fl.phos, znext.hover)
                path { color: mix(fl.engrave, fl.phos, znext.hover); move tcx + 70, tcy - 8; line tcx + 82, tcy; line tcx + 70, tcy + 8; close }
                box { from: tcx + 82.5, tcy - 8; size: 2.5, 16; color: mix(fl.engrave, fl.phos, znext.hover) }
                on press znext { emit pl_next }
                zone box zrpt { from: tcx + 124, tcy - 16; size: 32, 32; cursor: pointer; role: toggle; checked: rpt; label: "Repeat" }
                PRound(tcx + 140, tcy, 16, if(rpt, 1, 0), fl.phos, zrpt.hover)
                arc { at: tcx + 140, tcy; radius: 6; width: 1.4; span: 300deg; color: if(rpt, fl.phos, fl.muted) }
                on press zrpt { emit pl_rpt }

                // the volume, and the single-song switch
                text "VOLUME" { at: mx, 404; anchor: left center; size: 10; weight: 700; family: "Share Tech Mono"; color: fl.muted }
                zone box zvol { from: mx + 60, 394; size: mw - 110, 22; cursor: pointer; role: slider; label: "Volume"; value: vol / 100; show: vol_on }
                box { from: mx + 60, 402; size: mw - 110, 5; corner: 2.5; color: fl.ground }
                box { from: mx + 60, 402; size: (mw - 110) * clamp(vol / 100, 0, 1), 5; corner: 2.5; color: fl.trace_lit; show: vol_on }
                ellipse { at: mx + 60 + (mw - 110) * clamp(vol / 100, 0, 1), 404.5; radius: 6 + zvol.hover; color: fl.engrave; show: vol_on }
                text pick(vol_on, "N/A", "{vol, 0}%") { at: mx + mw, 404; anchor: right center; size: 9; weight: 700; family: "Share Tech Mono"; color: fl.trace_lit }
                on press zvol { emit pl_vol(round(clamp((local.x - mx - 60) / (mw - 110), 0, 1) * 100)) }
                on drag zvol { emit pl_vol(round(clamp((local.x - mx - 60) / (mw - 110), 0, 1) * 100)) }
                on scroll zvol { emit pl_vol(clamp(vol + wheel * 3, 0, 100)) }
                zone box zsgl { from: mx, 436; size: 96, 22; cursor: pointer; role: toggle; checked: sgl; label: "Stop after this song" }
                PChip(mx, 436, 96, "SINGLE", sgl, zsgl.hover)
                on press zsgl { emit pl_sgl }
                text "SPACE PLAY · ← → SEEK · ↑ ↓ VOLUME · N P · S SHUFFLE · R REPEAT · ESC" { at: mx, ph - 26; anchor: left center; size: 10
                     family: "Share Tech Mono"; color: fl.trace; width: mw + 40; lines: 1 }

                // ── the pane: the queue ──
                Chamfer(qx, 64, qw, ph - 84, 10, mix(fl.hull_raised, fl.ground, 0.4), fl.trace_dim, 0.95, 1)
                // the pane's tabs
                zone box ztq { from: qx + 12, 72; size: 60, 24; cursor: pointer; role: tab; selected: pane == queue; label: "The queue" }
                PChip(qx + 12, 73, 60, "QUEUE", pane == queue, ztq.hover)
                on press ztq { emit pl_pane(0) }
                zone box ztl { from: qx + 76, 72; size: 68, 24; cursor: pointer; role: tab; selected: pane == library; label: "Your library" }
                PChip(qx + 76, 73, 68, "LIBRARY", pane == library, ztl.hover)
                on press ztl { emit pl_pane(1) }
                zone box zty { from: qx + 148, 72; size: 62, 24; cursor: pointer; role: tab; selected: pane == lyrics; label: "The lyrics" }
                PChip(qx + 148, 73, 62, "LYRICS", pane == lyrics, zty.hover)
                zone box zte { from: qx + 214, 72; size: 40, 24; cursor: pointer; role: tab; selected: pane == eq; label: "The equaliser" }
                PChip(qx + 214, 73, 40, "EQ", pane == eq, zte.hover)
                on press zte { emit pl_pane(4) }
                on press zty { emit pl_pane(2) }

                group {
                    show: pane == queue
                    zone box zqclear { from: qx + qw - 90, 74; size: 76, 20; cursor: pointer; role: button; label: "Empty the queue"; show: q_count > 0 }
                text "{q_count, 0} · CLEAR" { at: qx + qw - 52, 84; anchor: center; align: center; size: 10; family: "Share Tech Mono"; color: mix(fl.muted, fl.ember, zqclear.hover); show: q_count > 0 }
                on press zqclear { emit pl_clear }
                zone box zqscroll { from: qx, 100; size: qw, 9 * 48; role: list; label: "The queue — the wheel pages it" }
                on scroll zqscroll { emit pl_qpage(if(wheel > 0, -1, 1)) }
                for q in queue {
                    let qy = 100 + q.n * 48
                    zone box zq { from: qx + 8, qy; size: qw - 44, 44; cursor: pointer; role: item; selected: q.current; label: "Play {q.title}" }
                    box { from: qx + 8, qy; size: qw - 16, 44; corner: 6; color: if(q.current, mix(fl.well, fl.phos, 0.12), fl.well)
                          opacity: if(q.current, 0.9, 0.5 * zq.hover) }
                    box { from: qx + 8, qy + 8; size: 3, 28; corner: 1.5; color: fl.phos; show: q.current }
                    text "{q.pos + 1, 0}" { at: qx + 30, qy + 22; anchor: center; size: 10; family: "Share Tech Mono"; color: if(q.current, fl.phos, fl.muted) }
                    text q.title { at: qx + 48, qy + 15; anchor: left center; size: 10; weight: 600; family: "Exo 2"; width: qw - 130; lines: 1
                                   color: if(q.current, fl.phos, fl.engrave) }
                    text q.artist { at: qx + 48, qy + 31; anchor: left center; size: 10; family: "Exo 2"; width: qw - 130; lines: 1; color: fl.muted }
                    text q.time { at: qx + qw - 40, qy + 22; anchor: right center; size: 10; family: "Share Tech Mono"; color: fl.muted }
                    zone box zqdel { from: qx + qw - 34, qy + 11; size: 22, 22; cursor: pointer; role: button; label: "Take {q.title} out" }
                    line { from: qx + qw - 28, qy + 17; to: qx + qw - 18, qy + 27; width: 1.2; color: mix(fl.trace, fl.ember, zqdel.hover) }
                    line { from: qx + qw - 18, qy + 17; to: qx + qw - 28, qy + 27; width: 1.2; color: mix(fl.trace, fl.ember, zqdel.hover) }
                    on press zq { emit pl_play(q.pos) }
                    on press zqdel { emit pl_del(q.pos) }
                }
                text pick(src == remote, "THE QUEUE IS EMPTY", "ANOTHER PLAYER KEEPS ITS OWN QUEUE") { at: qx + qw / 2, 200; anchor: center; size: 10; family: "Share Tech Mono"
                     color: fl.muted; show: q_count < 1 or src == remote }
                text "PAGE {q_page + 1, 0} / {q_pages, 0}" { at: qx + qw / 2, ph - 34; anchor: center; size: 10; family: "Share Tech Mono"; color: fl.muted
                     show: q_pages > 1 and src == library }
                }

                // ── the lyrics: the line being sung lit, the ones round it fading ──
                group {
                    show: pane == lyrics
                    text lyr_note { at: qx + 16, 117; anchor: left center; size: 10; weight: 700; family: "Share Tech Mono"; color: fl.trace_lit
                                    width: qw - 170; lines: 1 }
                    // the song's nudge, for lyrics that run early or late (kept by the song)
                    group {
                        show: lyr_synced
                        zone box zlyb { from: qx + qw - 150, 106; size: 40, 22; cursor: pointer; role: button; label: "Lyrics half a second later" }
                        PChip(qx + qw - 150, 106, 40, "−0.5", false, zlyb.hover)
                        on press zlyb { emit lyr_nudge(-1) }
                        text lyr_offset { at: qx + qw - 82, 117; anchor: center; align: center; size: 10; family: "Share Tech Mono"; color: fl.muted; width: 60 }
                        zone box zlyf { from: qx + qw - 54, 106; size: 40, 22; cursor: pointer; role: button; label: "Lyrics half a second earlier" }
                        PChip(qx + qw - 54, 106, 40, "+0.5", false, zlyf.hover)
                        on press zlyf { emit lyr_nudge(1) }
                    }
                    zone box zlyr { from: qx, 130; size: qw, 9 * 46; role: list; label: "The lyrics" }
                    on scroll zlyr { emit lyr_scroll(wheel) }
                    for l in lyr {
                        let lyy = 150 + l.n * 46
                        zone box zline { from: qx + 8, lyy - 20; size: qw - 16, 40; cursor: pointer; role: item; label: "Go to: {l.text}"; show: lyr_synced }
                        box { from: qx + 8, lyy - 20; size: qw - 16, 40; corner: 6; color: fl.well; opacity: 0.35 * zline.hover }
                        group {
                            show: l.cur
                            glow: 12, 50% * st_glow, fl.phos
                            text l.text { at: qx + qw / 2, lyy; anchor: center; align: center; size: 14; weight: 700; family: "Exo 2"; width: qw - 30; lines: 2
                                          color: fl.phos }
                        }
                        text l.text { at: qx + qw / 2, lyy; anchor: center; align: center; size: 11; family: "Exo 2"; width: qw - 30; lines: 2
                                      color: mix(fl.engrave, fl.muted, clamp(l.dist / 4, 0, 1)); opacity: clamp(1 - l.dist * 0.16, 0.25, 1); show: not l.cur }
                        on press zline { emit lyr_seek(l.t) }
                    }
                    text "♪" { at: qx + qw / 2, 260; anchor: center; size: 30; family: "Exo 2"; color: fl.trace_dim; show: not lyr_on }
                }

                // ── the equaliser: shell/player/eq.plm ──
                include "eq.plm"

                // ── the library: shell/player/library.plm ──
                include "library.plm"
            }
        }
}
