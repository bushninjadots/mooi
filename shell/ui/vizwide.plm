                   line lcx + sin(270) * lr * (1 + if(still, 0.08, (vs15 + vs16 * 2 + vs17) / 4) * 0.42 + sin(270 * 3 + np_turn * 1.5) * 0.03), lcy + cos(270) * lr * (1 + if(still, 0.08, (vs15 + vs16 * 2 + vs17) / 4) * 0.42 + sin(270 * 3 + np_turn * 1.5) * 0.03)
