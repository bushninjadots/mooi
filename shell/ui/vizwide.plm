    // The Ring's inner wave and glow (its spokes are the lane's own, one per bar).
    component RingWave(x: number, y: number, w: number, h: number, u: number, t1: color, t2: color, still: bool) {
        size: w, h
        let cx = x + w / 2
        let cy = y + h / 2
        let rr = min(w, h) * 0.24
        group {
            blur: 16
            ellipse { at: cx, cy; radius: rr * 0.62; color: t2; opacity: 0.1 + if(still, 0, vs0 * 0.18) }
        }
        path { stroke: 1.5 * u; color: t2; opacity: 0.85
               move cx + sin(0) * rr * (0.86 + if(still, 0.04, vs0) * 0.2), cy - cos(0) * rr * (0.86 + if(still, 0.04, vs0) * 0.2)
                   line cx + sin(7.5) * rr * (0.86 + if(still, 0.04, vs1) * 0.2), cy - cos(7.5) * rr * (0.86 + if(still, 0.04, vs1) * 0.2)
                   line cx + sin(15) * rr * (0.86 + if(still, 0.04, vs3) * 0.2), cy - cos(15) * rr * (0.86 + if(still, 0.04, vs3) * 0.2)
                   line cx + sin(22.5) * rr * (0.86 + if(still, 0.04, vs4) * 0.2), cy - cos(22.5) * rr * (0.86 + if(still, 0.04, vs4) * 0.2)
                   line cx + sin(30) * rr * (0.86 + if(still, 0.04, vs5) * 0.2), cy - cos(30) * rr * (0.86 + if(still, 0.04, vs5) * 0.2)
                   line cx + sin(37.5) * rr * (0.86 + if(still, 0.04, vs6) * 0.2), cy - cos(37.5) * rr * (0.86 + if(still, 0.04, vs6) * 0.2)
                   line cx + sin(45) * rr * (0.86 + if(still, 0.04, vs8) * 0.2), cy - cos(45) * rr * (0.86 + if(still, 0.04, vs8) * 0.2)
                   line cx + sin(52.5) * rr * (0.86 + if(still, 0.04, vs9) * 0.2), cy - cos(52.5) * rr * (0.86 + if(still, 0.04, vs9) * 0.2)
                   line cx + sin(60) * rr * (0.86 + if(still, 0.04, vs10) * 0.2), cy - cos(60) * rr * (0.86 + if(still, 0.04, vs10) * 0.2)
                   line cx + sin(67.5) * rr * (0.86 + if(still, 0.04, vs12) * 0.2), cy - cos(67.5) * rr * (0.86 + if(still, 0.04, vs12) * 0.2)
                   line cx + sin(75) * rr * (0.86 + if(still, 0.04, vs13) * 0.2), cy - cos(75) * rr * (0.86 + if(still, 0.04, vs13) * 0.2)
                   line cx + sin(82.5) * rr * (0.86 + if(still, 0.04, vs14) * 0.2), cy - cos(82.5) * rr * (0.86 + if(still, 0.04, vs14) * 0.2)
                   line cx + sin(90) * rr * (0.86 + if(still, 0.04, vs16) * 0.2), cy - cos(90) * rr * (0.86 + if(still, 0.04, vs16) * 0.2)
                   line cx + sin(97.5) * rr * (0.86 + if(still, 0.04, vs17) * 0.2), cy - cos(97.5) * rr * (0.86 + if(still, 0.04, vs17) * 0.2)
                   line cx + sin(105) * rr * (0.86 + if(still, 0.04, vs18) * 0.2), cy - cos(105) * rr * (0.86 + if(still, 0.04, vs18) * 0.2)
                   line cx + sin(112.5) * rr * (0.86 + if(still, 0.04, vs19) * 0.2), cy - cos(112.5) * rr * (0.86 + if(still, 0.04, vs19) * 0.2)
                   line cx + sin(120) * rr * (0.86 + if(still, 0.04, vs21) * 0.2), cy - cos(120) * rr * (0.86 + if(still, 0.04, vs21) * 0.2)
                   line cx + sin(127.5) * rr * (0.86 + if(still, 0.04, vs22) * 0.2), cy - cos(127.5) * rr * (0.86 + if(still, 0.04, vs22) * 0.2)
                   line cx + sin(135) * rr * (0.86 + if(still, 0.04, vs23) * 0.2), cy - cos(135) * rr * (0.86 + if(still, 0.04, vs23) * 0.2)
                   line cx + sin(142.5) * rr * (0.86 + if(still, 0.04, vs25) * 0.2), cy - cos(142.5) * rr * (0.86 + if(still, 0.04, vs25) * 0.2)
                   line cx + sin(150) * rr * (0.86 + if(still, 0.04, vs26) * 0.2), cy - cos(150) * rr * (0.86 + if(still, 0.04, vs26) * 0.2)
                   line cx + sin(157.5) * rr * (0.86 + if(still, 0.04, vs27) * 0.2), cy - cos(157.5) * rr * (0.86 + if(still, 0.04, vs27) * 0.2)
                   line cx + sin(165) * rr * (0.86 + if(still, 0.04, vs28) * 0.2), cy - cos(165) * rr * (0.86 + if(still, 0.04, vs28) * 0.2)
                   line cx + sin(172.5) * rr * (0.86 + if(still, 0.04, vs30) * 0.2), cy - cos(172.5) * rr * (0.86 + if(still, 0.04, vs30) * 0.2)
                   line cx + sin(180) * rr * (0.86 + if(still, 0.04, vs31) * 0.2), cy - cos(180) * rr * (0.86 + if(still, 0.04, vs31) * 0.2)
                   line cx + sin(187.5) * rr * (0.86 + if(still, 0.04, vs30) * 0.2), cy - cos(187.5) * rr * (0.86 + if(still, 0.04, vs30) * 0.2)
                   line cx + sin(195) * rr * (0.86 + if(still, 0.04, vs28) * 0.2), cy - cos(195) * rr * (0.86 + if(still, 0.04, vs28) * 0.2)
                   line cx + sin(202.5) * rr * (0.86 + if(still, 0.04, vs27) * 0.2), cy - cos(202.5) * rr * (0.86 + if(still, 0.04, vs27) * 0.2)
                   line cx + sin(210) * rr * (0.86 + if(still, 0.04, vs26) * 0.2), cy - cos(210) * rr * (0.86 + if(still, 0.04, vs26) * 0.2)
                   line cx + sin(217.5) * rr * (0.86 + if(still, 0.04, vs25) * 0.2), cy - cos(217.5) * rr * (0.86 + if(still, 0.04, vs25) * 0.2)
                   line cx + sin(225) * rr * (0.86 + if(still, 0.04, vs23) * 0.2), cy - cos(225) * rr * (0.86 + if(still, 0.04, vs23) * 0.2)
                   line cx + sin(232.5) * rr * (0.86 + if(still, 0.04, vs22) * 0.2), cy - cos(232.5) * rr * (0.86 + if(still, 0.04, vs22) * 0.2)
                   line cx + sin(240) * rr * (0.86 + if(still, 0.04, vs21) * 0.2), cy - cos(240) * rr * (0.86 + if(still, 0.04, vs21) * 0.2)
                   line cx + sin(247.5) * rr * (0.86 + if(still, 0.04, vs19) * 0.2), cy - cos(247.5) * rr * (0.86 + if(still, 0.04, vs19) * 0.2)
                   line cx + sin(255) * rr * (0.86 + if(still, 0.04, vs18) * 0.2), cy - cos(255) * rr * (0.86 + if(still, 0.04, vs18) * 0.2)
                   line cx + sin(262.5) * rr * (0.86 + if(still, 0.04, vs17) * 0.2), cy - cos(262.5) * rr * (0.86 + if(still, 0.04, vs17) * 0.2)
                   line cx + sin(270) * rr * (0.86 + if(still, 0.04, vs16) * 0.2), cy - cos(270) * rr * (0.86 + if(still, 0.04, vs16) * 0.2)
                   line cx + sin(277.5) * rr * (0.86 + if(still, 0.04, vs14) * 0.2), cy - cos(277.5) * rr * (0.86 + if(still, 0.04, vs14) * 0.2)
                   line cx + sin(285) * rr * (0.86 + if(still, 0.04, vs13) * 0.2), cy - cos(285) * rr * (0.86 + if(still, 0.04, vs13) * 0.2)
                   line cx + sin(292.5) * rr * (0.86 + if(still, 0.04, vs12) * 0.2), cy - cos(292.5) * rr * (0.86 + if(still, 0.04, vs12) * 0.2)
                   line cx + sin(300) * rr * (0.86 + if(still, 0.04, vs10) * 0.2), cy - cos(300) * rr * (0.86 + if(still, 0.04, vs10) * 0.2)
                   line cx + sin(307.5) * rr * (0.86 + if(still, 0.04, vs9) * 0.2), cy - cos(307.5) * rr * (0.86 + if(still, 0.04, vs9) * 0.2)
                   line cx + sin(315) * rr * (0.86 + if(still, 0.04, vs8) * 0.2), cy - cos(315) * rr * (0.86 + if(still, 0.04, vs8) * 0.2)
                   line cx + sin(322.5) * rr * (0.86 + if(still, 0.04, vs6) * 0.2), cy - cos(322.5) * rr * (0.86 + if(still, 0.04, vs6) * 0.2)
                   line cx + sin(330) * rr * (0.86 + if(still, 0.04, vs5) * 0.2), cy - cos(330) * rr * (0.86 + if(still, 0.04, vs5) * 0.2)
                   line cx + sin(337.5) * rr * (0.86 + if(still, 0.04, vs4) * 0.2), cy - cos(337.5) * rr * (0.86 + if(still, 0.04, vs4) * 0.2)
                   line cx + sin(345) * rr * (0.86 + if(still, 0.04, vs3) * 0.2), cy - cos(345) * rr * (0.86 + if(still, 0.04, vs3) * 0.2)
                   line cx + sin(352.5) * rr * (0.86 + if(still, 0.04, vs1) * 0.2), cy - cos(352.5) * rr * (0.86 + if(still, 0.04, vs1) * 0.2)
                   close }
