                   line lcx + sin(112.5) * lr * (1 + if(still, 0.08, (vs18 + vs19 * 2 + vs20) / 4) * 0.42 + sin(112.5 * 3 + np_turn * 1.5) * 0.03), lcy + cos(112.5) * lr * (1 + if(still, 0.08, (vs18 + vs19 * 2 + vs20) / 4) * 0.42 + sin(112.5 * 3 + np_turn * 1.5) * 0.03)
                   line lcx + sin(123.75) * lr * (1 + if(still, 0.08, (vs20 + vs21 * 2 + vs22) / 4) * 0.42 + sin(123.75 * 3 + np_turn * 1.5) * 0.03), lcy + cos(123.75) * lr * (1 + if(still, 0.08, (vs20 + vs21 * 2 + vs22) / 4) * 0.42 + sin(123.75 * 3 + np_turn * 1.5) * 0.03)
                   line lcx + sin(135) * lr * (1 + if(still, 0.08, (vs22 + vs23 * 2 + vs24) / 4) * 0.42 + sin(135 * 3 + np_turn * 1.5) * 0.03), lcy + cos(135) * lr * (1 + if(still, 0.08, (vs22 + vs23 * 2 + vs24) / 4) * 0.42 + sin(135 * 3 + np_turn * 1.5) * 0.03)
                   line lcx + sin(146.25) * lr * (1 + if(still, 0.08, (vs24 + vs25 * 2 + vs26) / 4) * 0.42 + sin(146.25 * 3 + np_turn * 1.5) * 0.03), lcy + cos(146.25) * lr * (1 + if(still, 0.08, (vs24 + vs25 * 2 + vs26) / 4) * 0.42 + sin(146.25 * 3 + np_turn * 1.5) * 0.03)
                   line lcx + sin(157.5) * lr * (1 + if(still, 0.08, (vs26 + vs27 * 2 + vs28) / 4) * 0.42 + sin(157.5 * 3 + np_turn * 1.5) * 0.03), lcy + cos(157.5) * lr * (1 + if(still, 0.08, (vs26 + vs27 * 2 + vs28) / 4) * 0.42 + sin(157.5 * 3 + np_turn * 1.5) * 0.03)
                   line lcx + sin(168.75) * lr * (1 + if(still, 0.08, (vs28 + vs29 * 2 + vs30) / 4) * 0.42 + sin(168.75 * 3 + np_turn * 1.5) * 0.03), lcy + cos(168.75) * lr * (1 + if(still, 0.08, (vs28 + vs29 * 2 + vs30) / 4) * 0.42 + sin(168.75 * 3 + np_turn * 1.5) * 0.03)
                   line lcx + sin(180) * lr * (1 + if(still, 0.08, (vs30 + vs31 * 2 + vs0) / 4) * 0.42 + sin(180 * 3 + np_turn * 1.5) * 0.03), lcy + cos(180) * lr * (1 + if(still, 0.08, (vs30 + vs31 * 2 + vs0) / 4) * 0.42 + sin(180 * 3 + np_turn * 1.5) * 0.03)
                   line lcx + sin(191.25) * lr * (1 + if(still, 0.08, (vs28 + vs29 * 2 + vs30) / 4) * 0.42 + sin(191.25 * 3 + np_turn * 1.5) * 0.03), lcy + cos(191.25) * lr * (1 + if(still, 0.08, (vs28 + vs29 * 2 + vs30) / 4) * 0.42 + sin(191.25 * 3 + np_turn * 1.5) * 0.03)
                   line lcx + sin(202.5) * lr * (1 + if(still, 0.08, (vs26 + vs27 * 2 + vs28) / 4) * 0.42 + sin(202.5 * 3 + np_turn * 1.5) * 0.03), lcy + cos(202.5) * lr * (1 + if(still, 0.08, (vs26 + vs27 * 2 + vs28) / 4) * 0.42 + sin(202.5 * 3 + np_turn * 1.5) * 0.03)
