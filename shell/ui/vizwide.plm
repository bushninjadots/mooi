    // Scope: a thin phosphor trace with three true afterimages (the last frames, fading behind it).
    component Scope3(x: number, y: number, w: number, h: number, u: number, glow: number, t1: color, t2: color, still: bool) {
        size: w, h
        let sm = y + h / 2
        let ph = np_turn * 9
        repeat k in 0..46 {
            let f0 = k / 46
            let f1 = (k + 1) / 46
            let b0 = if(still, 0.06, mix(pick(floor(f0 * 23), so2_0, so2_1, so2_2, so2_3, so2_4, so2_5, so2_6, so2_7, so2_8, so2_9, so2_10, so2_11, so2_12, so2_13, so2_14, so2_15, so2_16, so2_17, so2_18, so2_19, so2_20, so2_21, so2_22, so2_23), pick(min(23, floor(f0 * 23) + 1), so2_0, so2_1, so2_2, so2_3, so2_4, so2_5, so2_6, so2_7, so2_8, so2_9, so2_10, so2_11, so2_12, so2_13, so2_14, so2_15, so2_16, so2_17, so2_18, so2_19, so2_20, so2_21, so2_22, so2_23), f0 * 23 - floor(f0 * 23)))
            let b1 = if(still, 0.06, mix(pick(floor(f1 * 23), so2_0, so2_1, so2_2, so2_3, so2_4, so2_5, so2_6, so2_7, so2_8, so2_9, so2_10, so2_11, so2_12, so2_13, so2_14, so2_15, so2_16, so2_17, so2_18, so2_19, so2_20, so2_21, so2_22, so2_23), pick(min(23, floor(f1 * 23) + 1), so2_0, so2_1, so2_2, so2_3, so2_4, so2_5, so2_6, so2_7, so2_8, so2_9, so2_10, so2_11, so2_12, so2_13, so2_14, so2_15, so2_16, so2_17, so2_18, so2_19, so2_20, so2_21, so2_22, so2_23), f1 * 23 - floor(f1 * 23)))
            line { from: x + f0 * w, sm + sin(f0 * 1080 + ph - 3 * 30) * b0 * h * 0.34; to: x + f1 * w, sm + sin(f1 * 1080 + ph - 3 * 30) * b1 * h * 0.34
                   width: 1.2 * u; color: t1; opacity: 0.1 }
        }
        repeat k in 0..46 {
            let f0 = k / 46
            let f1 = (k + 1) / 46
            let b0 = if(still, 0.06, mix(pick(floor(f0 * 23), so1_0, so1_1, so1_2, so1_3, so1_4, so1_5, so1_6, so1_7, so1_8, so1_9, so1_10, so1_11, so1_12, so1_13, so1_14, so1_15, so1_16, so1_17, so1_18, so1_19, so1_20, so1_21, so1_22, so1_23), pick(min(23, floor(f0 * 23) + 1), so1_0, so1_1, so1_2, so1_3, so1_4, so1_5, so1_6, so1_7, so1_8, so1_9, so1_10, so1_11, so1_12, so1_13, so1_14, so1_15, so1_16, so1_17, so1_18, so1_19, so1_20, so1_21, so1_22, so1_23), f0 * 23 - floor(f0 * 23)))
            let b1 = if(still, 0.06, mix(pick(floor(f1 * 23), so1_0, so1_1, so1_2, so1_3, so1_4, so1_5, so1_6, so1_7, so1_8, so1_9, so1_10, so1_11, so1_12, so1_13, so1_14, so1_15, so1_16, so1_17, so1_18, so1_19, so1_20, so1_21, so1_22, so1_23), pick(min(23, floor(f1 * 23) + 1), so1_0, so1_1, so1_2, so1_3, so1_4, so1_5, so1_6, so1_7, so1_8, so1_9, so1_10, so1_11, so1_12, so1_13, so1_14, so1_15, so1_16, so1_17, so1_18, so1_19, so1_20, so1_21, so1_22, so1_23), f1 * 23 - floor(f1 * 23)))
            line { from: x + f0 * w, sm + sin(f0 * 1080 + ph - 2 * 30) * b0 * h * 0.34; to: x + f1 * w, sm + sin(f1 * 1080 + ph - 2 * 30) * b1 * h * 0.34
                   width: 1.2 * u; color: t1; opacity: 0.18 }
        }
        repeat k in 0..46 {
            let f0 = k / 46
            let f1 = (k + 1) / 46
            let b0 = if(still, 0.06, mix(pick(floor(f0 * 23), so0_0, so0_1, so0_2, so0_3, so0_4, so0_5, so0_6, so0_7, so0_8, so0_9, so0_10, so0_11, so0_12, so0_13, so0_14, so0_15, so0_16, so0_17, so0_18, so0_19, so0_20, so0_21, so0_22, so0_23), pick(min(23, floor(f0 * 23) + 1), so0_0, so0_1, so0_2, so0_3, so0_4, so0_5, so0_6, so0_7, so0_8, so0_9, so0_10, so0_11, so0_12, so0_13, so0_14, so0_15, so0_16, so0_17, so0_18, so0_19, so0_20, so0_21, so0_22, so0_23), f0 * 23 - floor(f0 * 23)))
            let b1 = if(still, 0.06, mix(pick(floor(f1 * 23), so0_0, so0_1, so0_2, so0_3, so0_4, so0_5, so0_6, so0_7, so0_8, so0_9, so0_10, so0_11, so0_12, so0_13, so0_14, so0_15, so0_16, so0_17, so0_18, so0_19, so0_20, so0_21, so0_22, so0_23), pick(min(23, floor(f1 * 23) + 1), so0_0, so0_1, so0_2, so0_3, so0_4, so0_5, so0_6, so0_7, so0_8, so0_9, so0_10, so0_11, so0_12, so0_13, so0_14, so0_15, so0_16, so0_17, so0_18, so0_19, so0_20, so0_21, so0_22, so0_23), f1 * 23 - floor(f1 * 23)))
            line { from: x + f0 * w, sm + sin(f0 * 1080 + ph - 1 * 30) * b0 * h * 0.34; to: x + f1 * w, sm + sin(f1 * 1080 + ph - 1 * 30) * b1 * h * 0.34
                   width: 1.2 * u; color: t1; opacity: 0.32 }
        }
        group {
            glow: min(8 * u, 10), max(0.3, glow), t1
            repeat k in 0..64 {
                let f0 = k / 64
                let f1 = (k + 1) / 64
                let b0 = if(still, 0.06, mix(pick(floor(f0 * 31), vs0, vs1, vs2, vs3, vs4, vs5, vs6, vs7, vs8, vs9, vs10, vs11, vs12, vs13, vs14, vs15, vs16, vs17, vs18, vs19, vs20, vs21, vs22, vs23, vs24, vs25, vs26, vs27, vs28, vs29, vs30, vs31), pick(min(31, floor(f0 * 31) + 1), vs0, vs1, vs2, vs3, vs4, vs5, vs6, vs7, vs8, vs9, vs10, vs11, vs12, vs13, vs14, vs15, vs16, vs17, vs18, vs19, vs20, vs21, vs22, vs23, vs24, vs25, vs26, vs27, vs28, vs29, vs30, vs31), f0 * 31 - floor(f0 * 31)))
                let b1 = if(still, 0.06, mix(pick(floor(f1 * 31), vs0, vs1, vs2, vs3, vs4, vs5, vs6, vs7, vs8, vs9, vs10, vs11, vs12, vs13, vs14, vs15, vs16, vs17, vs18, vs19, vs20, vs21, vs22, vs23, vs24, vs25, vs26, vs27, vs28, vs29, vs30, vs31), pick(min(31, floor(f1 * 31) + 1), vs0, vs1, vs2, vs3, vs4, vs5, vs6, vs7, vs8, vs9, vs10, vs11, vs12, vs13, vs14, vs15, vs16, vs17, vs18, vs19, vs20, vs21, vs22, vs23, vs24, vs25, vs26, vs27, vs28, vs29, vs30, vs31), f1 * 31 - floor(f1 * 31)))
                line { from: x + f0 * w, sm + sin(f0 * 1080 + ph) * b0 * h * 0.34 + sin(f0 * 3100 + ph * 0.4) * b0 * h * 0.06
                       to: x + f1 * w, sm + sin(f1 * 1080 + ph) * b1 * h * 0.34 + sin(f1 * 3100 + ph * 0.4) * b1 * h * 0.06
                       width: 1.5 * u; color: mix(t1, t2, b0 * 0.5) }
            }
        }
    }
    // Dust: two depths of specks (far: small and slow; near: larger and quicker), each leaving a
    // short trail along the way the beat throws it.
    component Dust2(x: number, y: number, w: number, h: number, u: number, t1: color, t2: color, still: bool) {
        size: w, h
        repeat k in 0..96 {
            let near = mod(k, 2) == 1
            let bx = mod(k * 61, 97) / 97
            let by = mod(k * k * 7 + k * 29, 89) / 89
            let pace = if(near, 1.6, 0.7)
            let push = np_scatter * if(near, 0.4, 0.2)
            let dx = bx + if(still, 0, sin(np_turn * (0.3 + mod(k, 5) * 0.1) * pace + k * 37) * 0.02) + (bx - 0.5) * push
            let dy = by + if(still, 0, cos(np_turn * (0.25 + mod(k, 7) * 0.08) * pace + k * 53) * 0.03) + (by - 0.5) * push
            let px = x + clamp(dx, 0, 1) * w
            let py = y + clamp(dy, 0, 1) * h
            line { from: px, py; to: px - (bx - 0.5) * push * w * 0.25, py - (by - 0.5) * push * h * 0.25
                   width: if(near, 1.4, 0.8) * u; color: if(mod(k, 3) == 0, t2, t1); opacity: if(near, 0.45, 0.25) * min(1, np_scatter * 2) }
            ellipse { at: px, py; radius: (if(near, 1.3, 0.6) + mod(k, 4) * 0.25) * u
                      color: if(mod(k, 3) == 0, t2, t1); opacity: if(near, 0.75, 0.4) + np_scatter * 0.25 }
        }
    }

    // Ripple: rings from the centre on each beat, each thick where it hit hardest, with a faint
    // refracting band inside it.
    component Ripple2(x: number, y: number, w: number, h: number, u: number, t1: color, t2: color, still: bool) {
        size: w, h
        let rcx = x + w / 2
        let rcy = y + h / 2
        let half = min(w, h) / 2
        repeat k in 0..4 {
            let rr = pick(k, rp_r0, rp_r1, rp_r2, rp_r3)
            let ra = if(still, 0, pick(k, rp_a0, rp_a1, rp_a2, rp_a3))
            arc { at: rcx, rcy; radius: max(1, rr * half * 0.93); width: 7 * u; span: 360deg; color: mix(t1, #ffffff, 0.3); opacity: ra * 0.1 }
            arc { at: rcx, rcy; radius: max(1, rr * half); width: (1 + ra * 2.5) * u; span: 360deg; color: mix(t1, t2, rr); opacity: ra }
        }
        group {
            glow: 8 * u, 0.6, t1
            ellipse { at: rcx, rcy; radius: (3 + if(still, 0, vs0 * 5)) * u; color: t1 }
        }
    }

    // Orbit: particles on three rings, each trailing a fading arc; the low band swells the inner
    // ring, the high speeds the outer.
    component Orbit2(x: number, y: number, w: number, h: number, u: number, t1: color, t2: color, dim: color, still: bool) {
        size: w, h
        let ocx = x + w / 2
        let ocy = y + h / 2
        let base = min(w, h) / 2
        let lo = if(still, 0.2, (vs0 + vs1 + vs2 + vs3 + vs4 + vs5) / 6)
        let hi = if(still, 0.1, (vs24 + vs26 + vs28 + vs30 + vs31) / 5)
        repeat ring in 0..3 {
            let rr = base * (0.36 + ring * 0.27) * (1 + if(ring == 0, lo * 0.25, 0))
            arc { at: ocx, ocy; radius: rr; width: 1; span: 360deg; color: dim; opacity: 0.5 }
            repeat p in 0..6 {
                let a = p * 60 + ring * 20 + np_turn * (0.6 + ring * 0.5) * (1 + if(ring == 2, hi, 0))
                arc { at: ocx, ocy; radius: rr; width: (1.2 + ring * 0.4) * u; span: 28deg; rotate: (a - 28) * 1deg
                      color: if(mod(p + ring, 3) == 0, t2, t1); opacity: 0.35 }
                ellipse { at: ocx + sin(a) * rr, ocy - cos(a) * rr; radius: (1.6 + ring * 0.7 + lo * 2) * u
                          color: if(mod(p + ring, 3) == 0, t2, t1) }
            }
        }
    }
    // Spectrum (style 0), Mirror (1) and Skyline (2) from lane A's bars: thin bars with round
    // caps, a lit top, peak dots that hold and fall, and a reflection under a waterline.
    component BarsA(x: number, y: number, w: number, h: number, u: number, n: number, gap: number,
                     peaks: bool, refl: bool, style: number, t1: color, t2: color, still: bool) {
        size: w, h
        let bw = w / max(1, n)
        let bwi = max(1, bw * (1 - gap))
        let mirror = style > 0.5 and style < 1.5
        let water = style > 1.5 or refl
        let fy = if(mirror, y + h / 2, if(water, y + h * 0.72, y + h))
        let reach = if(mirror, h * 0.47, if(water, h * 0.7, h * 0.96))
        for b in vzA {
            let v = if(still, 0.06, clamp(b.v, 0.015, 1))
            let bx = x + b.index * bw + (bw - bwi) / 2
            let hh = v * reach
            let r = min(bwi / 2, 3 * u)
            box { from: bx, fy - hh; size: bwi, if(mirror, hh * 2, hh); corner: r; color: mix(t1, t2, v * 0.8) }
            box { from: bx, fy - hh; size: bwi, min(hh, 3 * u); corner: r; color: mix(t2, #ffffff, 0.3); opacity: 0.85 }
            box { from: bx, fy - b.pk * reach - 2.5 * u; size: bwi, 2 * u; corner: 1; color: t2
                  show: peaks and not still and b.pk > b.v + 0.02 }
            box { from: bx, fy + if(mirror, hh - 2 * u, 0); size: bwi, 2 * u; corner: 1; color: t2; show: mirror and peaks and not still }
            box { from: bx, fy + 2 * u; size: bwi, hh * 0.38; corner: r; color: t1; opacity: 0.16; show: water and not mirror }
        }
        box { from: x, fy; size: w, 1; color: t2; opacity: 0.35; show: water and not mirror }
    }

    // LED: a dot matrix, one column per bar, ten rows; the peak row lit in the second colour.
    component LEDA(x: number, y: number, w: number, h: number, u: number, n: number, gap: number,
                    peaks: bool, t1: color, t2: color, dim: color, still: bool) {
        size: w, h
        let bw = w / max(1, n)
        let rh = h / 10
        let dr = max(0.8, min(bw * (1 - gap * 0.5), rh) * 0.36)
        for b in vzA {
            let v = if(still, 0.15, b.v)
            let cx = x + b.index * bw + bw / 2
            repeat row in 0..10 {
                let lit = v * 10 > row + 0.5
                let top = peaks and not still and floor(b.pk * 10 - 0.01) == row
                ellipse { at: cx, y + h - row * rh - rh / 2; radius: dr
                          color: if(top, t2, if(lit, if(row >= 8, t2, t1), dim)); opacity: if(lit or top, 1, 0.35) }
            }
        }
    }

    // Ring: one spoke per bar round a centre, a peak dot on each, turning slowly while it plays.
    component SpokesA(x: number, y: number, w: number, h: number, u: number, n: number,
                       peaks: bool, t1: color, t2: color, still: bool) {
        size: w, h
        let cx = x + w / 2
        let cy = y + h / 2
        let cr = min(w, h) * 0.27
        let reach = min(w, h) * 0.2
        group {
            pivot: cx, cy
            rotate: np_turn * 0.15deg
            for b in vzA {
                let v = if(still, 0.12, clamp(b.v, 0.02, 1))
                let a = b.index * 360 / max(1, n)
                line { from: cx + sin(a) * cr, cy - cos(a) * cr; to: cx + sin(a) * (cr + 3 * u + v * reach), cy - cos(a) * (cr + 3 * u + v * reach)
                       width: max(1, min(3 * u, 2 * 3.1416 * cr / max(1, n) * 0.55)); color: mix(t1, t2, v) }
                ellipse { at: cx + sin(a) * (cr + 5 * u + b.pk * reach), cy - cos(a) * (cr + 5 * u + b.pk * reach); radius: 1.3 * u; color: t2
                          show: peaks and not still }
            }
        }
    }

    // Horizon's near layer: a stepped skyline over every bar, with a lit crest.
    component HorizonFrontA(x: number, y: number, w: number, h: number, u: number, n: number, t1: color, t2: color, still: bool) {
        size: w, h
        let bw = w / max(1, n)
        let base = y + h * 0.9
        for b in vzA {
            let v = if(still, 0.1, b.v)
            let lift = v * h * 0.42
            box { from: x + b.index * bw, base - lift; size: bw + 0.6, y + h - base + lift; color: t1; opacity: 0.55 }
            box { from: x + b.index * bw, base - lift; size: bw + 0.6, 1.6 * u; color: mix(t1, #ffffff, 0.45); opacity: 0.9 }
        }
    }

    // Lane A: whichever of the twelve its widget has chosen (lib/widgets MODES order).
    component LaneA(x: number, y: number, w: number, h: number, u: number, mode: number, n: number, gap: number,
                     glow: number, peaks: bool, refl: bool, t1: color, t2: color, dim: color, still: bool) {
        size: w, h
        let gl = min(10 * u, 12)
        group { glow: gl, glow, t1; show: mode < 0.5
                BarsA(x, y, w, h, u, n, gap, peaks, refl, 0, t1, t2, still) }
        group { glow: gl, glow, t1; show: mode > 0.5 and mode < 1.5
                BarsA(x, y, w, h, u, n, gap, peaks, refl, 1, t1, t2, still) }
        group { show: mode > 1.5 and mode < 2.5
                RingWave(x, y, w, h, u, t1, t2, still)
                SpokesA(x, y, w, h, u, n, peaks, t1, t2, still) }
        group { show: mode > 2.5 and mode < 3.5
                Aurora4(x, y, w, h, u, t1, t2, still) }
        group { glow: gl, glow * 0.6, t1; show: mode > 3.5 and mode < 4.5
                LEDA(x, y, w, h, u, n, gap, peaks, t1, t2, dim, still) }
        group { glow: gl, glow, t1; show: mode > 4.5 and mode < 5.5
                Orbit2(x, y, w, h, u, t1, t2, dim, still) }
        group { show: mode > 5.5 and mode < 6.5
                Scope3(x, y, w, h, u, glow, t1, t2, still) }
        group { show: mode > 6.5 and mode < 7.5
                HorizonBack(x, y, w, h, u, t1, t2, still)
                HorizonFrontA(x, y, w, h, u, n, t1, t2, still) }
        group { glow: gl, glow, t1; show: mode > 7.5 and mode < 8.5
                Dust2(x, y, w, h, u, t1, t2, still) }
        group { show: mode > 8.5 and mode < 9.5
                Ripple2(x, y, w, h, u, t1, t2, still) }
        group { glow: gl, glow, t1; show: mode > 9.5 and mode < 10.5
                BarsA(x, y, w, h, u, n, gap, peaks, true, 2, t1, t2, still) }
        group { show: mode > 10.5
                Liquid2(x, y, w, h, u, t1, t2, still) }
    }

    // Spectrum (style 0), Mirror (1) and Skyline (2) from lane B's bars: thin bars with round
    // caps, a lit top, peak dots that hold and fall, and a reflection under a waterline.
    component BarsB(x: number, y: number, w: number, h: number, u: number, n: number, gap: number,
                     peaks: bool, refl: bool, style: number, t1: color, t2: color, still: bool) {
        size: w, h
        let bw = w / max(1, n)
        let bwi = max(1, bw * (1 - gap))
        let mirror = style > 0.5 and style < 1.5
        let water = style > 1.5 or refl
        let fy = if(mirror, y + h / 2, if(water, y + h * 0.72, y + h))
        let reach = if(mirror, h * 0.47, if(water, h * 0.7, h * 0.96))
        for b in vzB {
            let v = if(still, 0.06, clamp(b.v, 0.015, 1))
            let bx = x + b.index * bw + (bw - bwi) / 2
            let hh = v * reach
            let r = min(bwi / 2, 3 * u)
            box { from: bx, fy - hh; size: bwi, if(mirror, hh * 2, hh); corner: r; color: mix(t1, t2, v * 0.8) }
            box { from: bx, fy - hh; size: bwi, min(hh, 3 * u); corner: r; color: mix(t2, #ffffff, 0.3); opacity: 0.85 }
            box { from: bx, fy - b.pk * reach - 2.5 * u; size: bwi, 2 * u; corner: 1; color: t2
                  show: peaks and not still and b.pk > b.v + 0.02 }
            box { from: bx, fy + if(mirror, hh - 2 * u, 0); size: bwi, 2 * u; corner: 1; color: t2; show: mirror and peaks and not still }
            box { from: bx, fy + 2 * u; size: bwi, hh * 0.38; corner: r; color: t1; opacity: 0.16; show: water and not mirror }
        }
        box { from: x, fy; size: w, 1; color: t2; opacity: 0.35; show: water and not mirror }
    }

    // LED: a dot matrix, one column per bar, ten rows; the peak row lit in the second colour.
    component LEDB(x: number, y: number, w: number, h: number, u: number, n: number, gap: number,
                    peaks: bool, t1: color, t2: color, dim: color, still: bool) {
        size: w, h
        let bw = w / max(1, n)
        let rh = h / 10
        let dr = max(0.8, min(bw * (1 - gap * 0.5), rh) * 0.36)
        for b in vzB {
            let v = if(still, 0.15, b.v)
            let cx = x + b.index * bw + bw / 2
            repeat row in 0..10 {
                let lit = v * 10 > row + 0.5
                let top = peaks and not still and floor(b.pk * 10 - 0.01) == row
                ellipse { at: cx, y + h - row * rh - rh / 2; radius: dr
                          color: if(top, t2, if(lit, if(row >= 8, t2, t1), dim)); opacity: if(lit or top, 1, 0.35) }
            }
        }
    }

    // Ring: one spoke per bar round a centre, a peak dot on each, turning slowly while it plays.
    component SpokesB(x: number, y: number, w: number, h: number, u: number, n: number,
                       peaks: bool, t1: color, t2: color, still: bool) {
        size: w, h
        let cx = x + w / 2
        let cy = y + h / 2
        let cr = min(w, h) * 0.27
        let reach = min(w, h) * 0.2
        group {
            pivot: cx, cy
            rotate: np_turn * 0.15deg
            for b in vzB {
                let v = if(still, 0.12, clamp(b.v, 0.02, 1))
                let a = b.index * 360 / max(1, n)
                line { from: cx + sin(a) * cr, cy - cos(a) * cr; to: cx + sin(a) * (cr + 3 * u + v * reach), cy - cos(a) * (cr + 3 * u + v * reach)
                       width: max(1, min(3 * u, 2 * 3.1416 * cr / max(1, n) * 0.55)); color: mix(t1, t2, v) }
                ellipse { at: cx + sin(a) * (cr + 5 * u + b.pk * reach), cy - cos(a) * (cr + 5 * u + b.pk * reach); radius: 1.3 * u; color: t2
                          show: peaks and not still }
            }
        }
    }

    // Horizon's near layer: a stepped skyline over every bar, with a lit crest.
    component HorizonFrontB(x: number, y: number, w: number, h: number, u: number, n: number, t1: color, t2: color, still: bool) {
        size: w, h
        let bw = w / max(1, n)
        let base = y + h * 0.9
        for b in vzB {
            let v = if(still, 0.1, b.v)
            let lift = v * h * 0.42
            box { from: x + b.index * bw, base - lift; size: bw + 0.6, y + h - base + lift; color: t1; opacity: 0.55 }
            box { from: x + b.index * bw, base - lift; size: bw + 0.6, 1.6 * u; color: mix(t1, #ffffff, 0.45); opacity: 0.9 }
        }
    }

    // Lane B: whichever of the twelve its widget has chosen (lib/widgets MODES order).
    component LaneB(x: number, y: number, w: number, h: number, u: number, mode: number, n: number, gap: number,
                     glow: number, peaks: bool, refl: bool, t1: color, t2: color, dim: color, still: bool) {
        size: w, h
        let gl = min(10 * u, 12)
        group { glow: gl, glow, t1; show: mode < 0.5
                BarsB(x, y, w, h, u, n, gap, peaks, refl, 0, t1, t2, still) }
        group { glow: gl, glow, t1; show: mode > 0.5 and mode < 1.5
                BarsB(x, y, w, h, u, n, gap, peaks, refl, 1, t1, t2, still) }
        group { show: mode > 1.5 and mode < 2.5
                RingWave(x, y, w, h, u, t1, t2, still)
                SpokesB(x, y, w, h, u, n, peaks, t1, t2, still) }
        group { show: mode > 2.5 and mode < 3.5
                Aurora4(x, y, w, h, u, t1, t2, still) }
        group { glow: gl, glow * 0.6, t1; show: mode > 3.5 and mode < 4.5
                LEDB(x, y, w, h, u, n, gap, peaks, t1, t2, dim, still) }
        group { glow: gl, glow, t1; show: mode > 4.5 and mode < 5.5
                Orbit2(x, y, w, h, u, t1, t2, dim, still) }
        group { show: mode > 5.5 and mode < 6.5
                Scope3(x, y, w, h, u, glow, t1, t2, still) }
        group { show: mode > 6.5 and mode < 7.5
                HorizonBack(x, y, w, h, u, t1, t2, still)
                HorizonFrontB(x, y, w, h, u, n, t1, t2, still) }
        group { glow: gl, glow, t1; show: mode > 7.5 and mode < 8.5
                Dust2(x, y, w, h, u, t1, t2, still) }
        group { show: mode > 8.5 and mode < 9.5
                Ripple2(x, y, w, h, u, t1, t2, still) }
        group { glow: gl, glow, t1; show: mode > 9.5 and mode < 10.5
                BarsB(x, y, w, h, u, n, gap, peaks, true, 2, t1, t2, still) }
        group { show: mode > 10.5
                Liquid2(x, y, w, h, u, t1, t2, still) }
    }

    // Spectrum (style 0), Mirror (1) and Skyline (2) from lane C's bars: thin bars with round
    // caps, a lit top, peak dots that hold and fall, and a reflection under a waterline.
    component BarsC(x: number, y: number, w: number, h: number, u: number, n: number, gap: number,
                     peaks: bool, refl: bool, style: number, t1: color, t2: color, still: bool) {
        size: w, h
        let bw = w / max(1, n)
        let bwi = max(1, bw * (1 - gap))
        let mirror = style > 0.5 and style < 1.5
        let water = style > 1.5 or refl
        let fy = if(mirror, y + h / 2, if(water, y + h * 0.72, y + h))
        let reach = if(mirror, h * 0.47, if(water, h * 0.7, h * 0.96))
        for b in vzC {
            let v = if(still, 0.06, clamp(b.v, 0.015, 1))
            let bx = x + b.index * bw + (bw - bwi) / 2
            let hh = v * reach
            let r = min(bwi / 2, 3 * u)
            box { from: bx, fy - hh; size: bwi, if(mirror, hh * 2, hh); corner: r; color: mix(t1, t2, v * 0.8) }
            box { from: bx, fy - hh; size: bwi, min(hh, 3 * u); corner: r; color: mix(t2, #ffffff, 0.3); opacity: 0.85 }
            box { from: bx, fy - b.pk * reach - 2.5 * u; size: bwi, 2 * u; corner: 1; color: t2
                  show: peaks and not still and b.pk > b.v + 0.02 }
            box { from: bx, fy + if(mirror, hh - 2 * u, 0); size: bwi, 2 * u; corner: 1; color: t2; show: mirror and peaks and not still }
            box { from: bx, fy + 2 * u; size: bwi, hh * 0.38; corner: r; color: t1; opacity: 0.16; show: water and not mirror }
        }
        box { from: x, fy; size: w, 1; color: t2; opacity: 0.35; show: water and not mirror }
    }

    // LED: a dot matrix, one column per bar, ten rows; the peak row lit in the second colour.
    component LEDC(x: number, y: number, w: number, h: number, u: number, n: number, gap: number,
                    peaks: bool, t1: color, t2: color, dim: color, still: bool) {
        size: w, h
        let bw = w / max(1, n)
        let rh = h / 10
        let dr = max(0.8, min(bw * (1 - gap * 0.5), rh) * 0.36)
        for b in vzC {
            let v = if(still, 0.15, b.v)
            let cx = x + b.index * bw + bw / 2
            repeat row in 0..10 {
                let lit = v * 10 > row + 0.5
                let top = peaks and not still and floor(b.pk * 10 - 0.01) == row
                ellipse { at: cx, y + h - row * rh - rh / 2; radius: dr
                          color: if(top, t2, if(lit, if(row >= 8, t2, t1), dim)); opacity: if(lit or top, 1, 0.35) }
            }
        }
    }

    // Ring: one spoke per bar round a centre, a peak dot on each, turning slowly while it plays.
    component SpokesC(x: number, y: number, w: number, h: number, u: number, n: number,
                       peaks: bool, t1: color, t2: color, still: bool) {
        size: w, h
        let cx = x + w / 2
        let cy = y + h / 2
        let cr = min(w, h) * 0.27
        let reach = min(w, h) * 0.2
        group {
            pivot: cx, cy
            rotate: np_turn * 0.15deg
            for b in vzC {
                let v = if(still, 0.12, clamp(b.v, 0.02, 1))
                let a = b.index * 360 / max(1, n)
                line { from: cx + sin(a) * cr, cy - cos(a) * cr; to: cx + sin(a) * (cr + 3 * u + v * reach), cy - cos(a) * (cr + 3 * u + v * reach)
                       width: max(1, min(3 * u, 2 * 3.1416 * cr / max(1, n) * 0.55)); color: mix(t1, t2, v) }
                ellipse { at: cx + sin(a) * (cr + 5 * u + b.pk * reach), cy - cos(a) * (cr + 5 * u + b.pk * reach); radius: 1.3 * u; color: t2
                          show: peaks and not still }
            }
        }
    }

    // Horizon's near layer: a stepped skyline over every bar, with a lit crest.
    component HorizonFrontC(x: number, y: number, w: number, h: number, u: number, n: number, t1: color, t2: color, still: bool) {
        size: w, h
        let bw = w / max(1, n)
        let base = y + h * 0.9
        for b in vzC {
            let v = if(still, 0.1, b.v)
            let lift = v * h * 0.42
            box { from: x + b.index * bw, base - lift; size: bw + 0.6, y + h - base + lift; color: t1; opacity: 0.55 }
            box { from: x + b.index * bw, base - lift; size: bw + 0.6, 1.6 * u; color: mix(t1, #ffffff, 0.45); opacity: 0.9 }
        }
    }

    // Lane C: whichever of the twelve its widget has chosen (lib/widgets MODES order).
    component LaneC(x: number, y: number, w: number, h: number, u: number, mode: number, n: number, gap: number,
                     glow: number, peaks: bool, refl: bool, t1: color, t2: color, dim: color, still: bool) {
        size: w, h
        let gl = min(10 * u, 12)
        group { glow: gl, glow, t1; show: mode < 0.5
                BarsC(x, y, w, h, u, n, gap, peaks, refl, 0, t1, t2, still) }
        group { glow: gl, glow, t1; show: mode > 0.5 and mode < 1.5
                BarsC(x, y, w, h, u, n, gap, peaks, refl, 1, t1, t2, still) }
        group { show: mode > 1.5 and mode < 2.5
                RingWave(x, y, w, h, u, t1, t2, still)
                SpokesC(x, y, w, h, u, n, peaks, t1, t2, still) }
        group { show: mode > 2.5 and mode < 3.5
                Aurora4(x, y, w, h, u, t1, t2, still) }
        group { glow: gl, glow * 0.6, t1; show: mode > 3.5 and mode < 4.5
                LEDC(x, y, w, h, u, n, gap, peaks, t1, t2, dim, still) }
        group { glow: gl, glow, t1; show: mode > 4.5 and mode < 5.5
                Orbit2(x, y, w, h, u, t1, t2, dim, still) }
        group { show: mode > 5.5 and mode < 6.5
                Scope3(x, y, w, h, u, glow, t1, t2, still) }
        group { show: mode > 6.5 and mode < 7.5
                HorizonBack(x, y, w, h, u, t1, t2, still)
                HorizonFrontC(x, y, w, h, u, n, t1, t2, still) }
        group { glow: gl, glow, t1; show: mode > 7.5 and mode < 8.5
                Dust2(x, y, w, h, u, t1, t2, still) }
        group { show: mode > 8.5 and mode < 9.5
                Ripple2(x, y, w, h, u, t1, t2, still) }
        group { glow: gl, glow, t1; show: mode > 9.5 and mode < 10.5
                BarsC(x, y, w, h, u, n, gap, peaks, true, 2, t1, t2, still) }
        group { show: mode > 10.5
                Liquid2(x, y, w, h, u, t1, t2, still) }
    }

}
