                   line lcx + sin(348.75) * lr * (1 + if(still, 0.08, (vs1 + vs2 * 2 + vs3) / 4) * 0.42 + sin(348.75 * 3 + np_turn * 1.5) * 0.03), lcy + cos(348.75) * lr * (1 + if(still, 0.08, (vs1 + vs2 * 2 + vs3) / 4) * 0.42 + sin(348.75 * 3 + np_turn * 1.5) * 0.03)
                   close }
