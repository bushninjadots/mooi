                   line lcx + sin(292.5) * lr * (1 + if(still, 0.08, (vs11 + vs12 * 2 + vs13) / 4) * 0.42 + sin(292.5 * 3 + np_turn * 1.5) * 0.03), lcy + cos(292.5) * lr * (1 + if(still, 0.08, (vs11 + vs12 * 2 + vs13) / 4) * 0.42 + sin(292.5 * 3 + np_turn * 1.5) * 0.03)
                   line lcx + sin(303.75) * lr * (1 + if(still, 0.08, (vs9 + vs10 * 2 + vs11) / 4) * 0.42 + sin(303.75 * 3 + np_turn * 1.5) * 0.03), lcy + cos(303.75) * lr * (1 + if(still, 0.08, (vs9 + vs10 * 2 + vs11) / 4) * 0.42 + sin(303.75 * 3 + np_turn * 1.5) * 0.03)
                   line lcx + sin(315) * lr * (1 + if(still, 0.08, (vs7 + vs8 * 2 + vs9) / 4) * 0.42 + sin(315 * 3 + np_turn * 1.5) * 0.03), lcy + cos(315) * lr * (1 + if(still, 0.08, (vs7 + vs8 * 2 + vs9) / 4) * 0.42 + sin(315 * 3 + np_turn * 1.5) * 0.03)
                   line lcx + sin(326.25) * lr * (1 + if(still, 0.08, (vs5 + vs6 * 2 + vs7) / 4) * 0.42 + sin(326.25 * 3 + np_turn * 1.5) * 0.03), lcy + cos(326.25) * lr * (1 + if(still, 0.08, (vs5 + vs6 * 2 + vs7) / 4) * 0.42 + sin(326.25 * 3 + np_turn * 1.5) * 0.03)
