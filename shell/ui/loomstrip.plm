language 0.9

// An Accordion's strip (D195, spec §4.1): its windows as thin machined layers standing on a screen edge.
// Compressed, each layer is a plate seen edge-on — 6 px, 3 px apart — and the one in use slides out of the
// stack, lit. Pointed at, the stack opens into rows: the app's initial on a small chamfered tag and the
// window's title. A layer is never its own zone: one zone covers the strip and reads where the pointer is,
// so the strip's hover never splits as the pointer crosses layers.
//
//   press        the layer under the pointer: pulled out to your workspace (the one out: back in)
//   drag         a layer along the strip: reordered
//   right press  that layer taken out of the accordion (its window stays where it is)
//   middle press every layer out, tiled — or, all out already, all back in
//   wheel        the next / previous layer
//   the tag      press: every layer out or back in · right press: the accordion dissolved
//
// Drawn in the bar's material (fl.*), its light the accent; one light, no glow at rest.

library LoomStrip {
    component LoomStrip(k: number, n: number, open: number, tiled: bool, count: number, left: bool, sh: number) {
        size: 300, 400
        // where it stands: the strips share the edge's height, each centred in its share
        let cy = sh * (k + 1) / (count + 1)
        prop ext = 0 ~m.isl
        follow ext = if(z.hover > 0.5 or tag.hover > 0.5, 1, 0)
        let pitch = 9 + 21 * ext
        let lh = 6 + 20 * ext
        let lw = 44 + 196 * ext
        let top = cy - n * pitch / 2
        let hrow = clamp(floor((pointer.y - top) / pitch), 0, max(0, n - 1))
        // the edge's x: layers grow inward from it
        let ex = if(left, 0, 300)
        let dir = if(left, 1, -1)
        // the spine: the edge the layers hang from, lit while every layer is out
        box { from: if(left, 0, 297), top - 10; size: 3, n * pitch + 20; color: if(tiled, fl.phos, fl.trace); opacity: 0.85 }
        for l in lf_layers {
            group {
                show: l.s == k
                let y = top + l.i * pitch + (pitch - lh) / 2
                let out = if(l.open, 1, 0)
                // the one in use stands out of the stack (compressed), and every row is as wide (open)
                // D198: the layers nearest the mouse swell toward it as it comes to the edge (a dock's
                // magnification, only while the strip is compressed)
                let edge_near = clamp(1 - abs(cursor.x - ex) / 160, 0, 1)
                let mag = clamp(1 - abs(cursor.y - (y + lh / 2)) / 70, 0, 1) * edge_near * (1 - ext)
                let w = lw + 22 * out * (1 - ext) + 20 * mag
                let x0 = if(left, 3, 297 - w)
                let hot = z.hover > 0.5 and hrow == l.i
                let fade = if(l.absent, 0.35, 1)
                group {
                    opacity: fade
                    // the plate: its body, its lit top edge, and its side a shade darker
                    box { from: x0, y; size: w, lh; corner: min(2 + 4 * ext, lh / 2); color: mix(fl.hull_raised, fl.phos_fill, max(out * 0.6, if(hot, 0.35, 0))) }
                    box { from: x0, y; size: w, 1; color: mix(fl.trace_lit, fl.phos, out); opacity: 0.9 }
                    box { from: x0, y + lh - 1; size: w, 1; color: fl.ground; opacity: 0.6 }
                    box { from: if(left, x0 + w - 2, x0), y; size: 2, lh; color: if(l.open, fl.phos, fl.trace_dim) }
                    // open: the app's initial on its tag, and the title
                    group {
                        show: ext > 0.4
                        opacity: smooth(0.4, 0.9, ext)
                        let tx = if(left, x0 + 10, x0 + 10)
                        box { from: tx, y + 4; size: lh - 8, lh - 8; corner: 3; color: if(l.open, fl.phos, fl.well) }
                        text l.initial { at: tx + (lh - 8) / 2, y + lh / 2 + 0.5; anchor: center; size: 11; weight: 700; family: "Exo 2"; color: if(l.open, fl.ink, fl.engrave) }
                        text l.title { at: tx + lh, y + lh / 2; anchor: left center; size: 12; weight: if(l.open, 700, 500); family: "Exo 2"
                                       color: if(l.open, fl.engrave, fl.muted); width: max(1, w - lh - 26); lines: 1 }
                    }
                }
            }
        }
        // a drag: the layer it started on (where the pointer was at the press) and where it lands
        let from_row = clamp(floor((pointer.y - drag.dy - top) / pitch), 0, max(0, n - 1))

        // the tag above the strip: how many layers, and the accordion's own presses
        let tw = 22 + 40 * ext
        box { from: if(left, 3, 297 - tw), top - 30; size: tw, 16; corner: 3; color: fl.hull; opacity: 0.9 }
        box { from: if(left, 3, 297 - tw), top - 30; size: tw, 16; corner: 3; stroke: 1; color: if(tiled, fl.phos, fl.trace) }
        text "{n, 0}" { at: if(left, 3, 297 - tw) + 11, top - 22; anchor: center; size: 10; weight: 700; family: "Share Tech Mono"; color: fl.phos }
        text pick(tiled, "OPEN ALL", "FOLD ALL") { at: if(left, 3, 297 - tw) + 22, top - 22; anchor: left center; size: 9; weight: 700; family: "Share Tech Mono"; color: fl.engrave; show: ext > 0.6; opacity: smooth(0.6, 1, ext) }
        zone box tag { from: if(left, 0, 300 - tw - 3), top - 32; size: tw + 3, 20; cursor: pointer; role: button; label: "Every layer of this accordion out, or back in" }
        on press tag { emit acc_all(k) }
        on press right tag { emit acc_dissolve(k) }

        // the strip's one zone: as tall as its layers, as wide as they are now
        zone box z { from: if(left, 0, 300 - lw - 26), top; size: lw + 26, max(10, n * pitch); cursor: pointer; role: list; label: "Accordion: {n, 0} windows" }
        on release z while abs(drag.dy) < 6 { emit acc_press(k * 100 + hrow) }
        on release z while abs(drag.dy) >= 6 { emit acc_move(k * 10000 + from_row * 100 + hrow) }
        on press right z { emit acc_remove(k * 100 + hrow) }
        on press middle z { emit acc_all(k) }
        on scroll z { emit acc_step(k * 10 + if(wheel < 0, 1, 0)) }
    }
}
