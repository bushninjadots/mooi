language 0.9

// A Cube, docked (D197, spec §4.2): a whole working environment as one small solid on the screen's edge.
// Drawn as a projection, not a picture: its four sides and its top are quads computed here from its turn
// (a spring, so it rolls round), lit by one key light from the upper left, edged in hairlines. Folded it
// is solid; unfolded its sides are open glass (the environment is out on its workspaces); partly unfolded,
// only the facing side is open. The facing side carries its first app's initial and how many it holds.
//
//   press        folded → every window back where it was; unfolded → fold it
//   middle press only the facing side's windows out (a partial unfold)
//   wheel        turn it: the next side comes round (no window moves)
//   right press  the cube dissolved: every window out where it was, the cube gone
//
// The scene has no perspective transform, so face content is drawn only on the side facing you.

library LoomCube {
    component LoomCube(c: number, folded: bool, partial: bool, face: number, turn: number, n: number,
                       n0: number, n1: number, n2: number, n3: number, i0: text, i1: text, i2: text, i3: text,
                       name: text, left: bool, sh: number) {
        size: 100, 110
        let cx = if(left, 52, 248)
        let cy = sh - 84 - c * 96
        prop yaw = 0 ~m.isl
        // at rest it stands a quarter-turn askew (25°), so two sides and its top show like a solid's
        // D198: and leans toward the mouse (up to 14°) as it moves across the screen
        let lean = clamp((cursor.x - cx) / 420, -1, 1) * 14
        follow yaw = 0 - turn * 90 - 25 + lean
        prop open_f = 0 ~m.isl
        follow open_f = if(folded, 0, 1)
        let r = 30
        let h = 21
        let sp = 0.47
        let cp = 0.88
        let hot = z.hover > 0.5 or abs(cursor.x - cx) + abs(cursor.y - cy) < 70
        // the shadow it casts on the edge below it
        ellipse { at: cx, cy + h * cp + r * sp + 6; radius: r * 1.1; scale: 1, 0.22; color: fl.ground; opacity: 0.45 }
        // the four sides, each drawn only while it faces you (a convex solid needs no sorting)
        repeat k in 0..4 {
            let a = yaw + k * 90
            let ca = cos(a)
            let t1 = a - 45
            let t2 = a + 45
            let x1 = cx + r * sin(t1)
            let x2 = cx + r * sin(t2)
            let yt1 = cy - h * cp + r * cos(t1) * sp
            let yt2 = cy - h * cp + r * cos(t2) * sp
            let yb1 = cy + h * cp + r * cos(t1) * sp
            let yb2 = cy + h * cp + r * cos(t2) * sp
            let light = 0.22 + 0.45 * max(0, cos(a + 35))
            // open (unfolded, or this side opened by a partial unfold): glass, not steel
            let facing = ca > 0.8
            let glassy = max(open_f * if(partial, 0, 1), if(partial and facing, 1, 0))
            group {
                show: ca > 0.02
                path { color: mix(fl.hull_raised, fl.phos, light * (1 - glassy * 0.6)); opacity: 1 - glassy * 0.65
                       move x1, yt1; line x2, yt2; line x2, yb2; line x1, yb1; close }
                path { stroke: 1; color: if(hot or glassy > 0.5, fl.phos, fl.trace_lit); opacity: 0.85
                       move x1, yt1; line x2, yt2; line x2, yb2; line x1, yb1; close }
            }
        }
        // the top: lit most (the light is above)
        let ta = yaw + 45
        path { color: mix(fl.hull_raised, fl.phos, 0.55 * (1 - open_f * 0.5)); opacity: 1 - open_f * 0.5
               move cx + r * sin(ta), cy - h * cp + r * cos(ta) * sp
               line cx + r * sin(ta + 90), cy - h * cp + r * cos(ta + 90) * sp
               line cx + r * sin(ta + 180), cy - h * cp + r * cos(ta + 180) * sp
               line cx + r * sin(ta + 270), cy - h * cp + r * cos(ta + 270) * sp; close }
        path { stroke: 1; color: if(hot, fl.phos, fl.trace_lit); opacity: 0.9
               move cx + r * sin(ta), cy - h * cp + r * cos(ta) * sp
               line cx + r * sin(ta + 90), cy - h * cp + r * cos(ta + 90) * sp
               line cx + r * sin(ta + 180), cy - h * cp + r * cos(ta + 180) * sp
               line cx + r * sin(ta + 270), cy - h * cp + r * cos(ta + 270) * sp; close }
        // the facing side's content: its first app's initial and its count (once the turn has settled)
        // on the facing side's centre (it stands at -25° once the turn settles)
        let settled = abs(yaw - (0 - turn * 90 - 25 + lean)) < 10
        let fx = cx + 0.707 * r * sin(lean - 25)
        let fy = cy + 0.707 * r * cos(lean - 25) * sp
        group {
            show: settled
            text pick(face, i0, i1, i2, i3) { at: fx, fy - 3; anchor: center; size: 16; weight: 800; family: "Exo 2"; color: fl.engrave }
            text "{pick(face, n0, n1, n2, n3), 0}" { at: fx + 12, fy + 10; anchor: center; size: 9; weight: 700; family: "Share Tech Mono"; color: fl.phos }
        }
        // its name and the facing side, under it
        text "{upper(name)}" { at: cx, cy + h * cp + r * sp + 16; anchor: center; size: 9; weight: 700; family: "Share Tech Mono"; color: fl.engrave; width: 96; lines: 1 }
        text pick(face, "FRONT", "RIGHT", "BACK", "LEFT") { at: cx, cy + h * cp + r * sp + 27; anchor: center; size: 8; family: "Share Tech Mono"
              color: if(folded, fl.muted, fl.phos); opacity: if(hot, 1, 0.7) }
        zone box z { from: cx - 40, cy - 40; size: 80, 90; cursor: pointer; role: button; label: "Cube {name}: {n, 0} windows" }
        on press z { emit cube_press(c) }
        on press middle z { emit cube_face(c) }
        on press right z { emit cube_dissolve(c) }
        on scroll z { emit cube_turn(c * 10 + if(wheel < 0, 1, 0)) }
    }
}
