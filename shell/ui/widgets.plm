language 0.9

// The desktop widgets' looks (D137): Now Playing in three layouts and the Visualiser. Every size
// is the layout's own times `u` (lib/widgets.scale), so a bigger widget is the same widget larger.
// No card unless `plate`: a soft dark haze behind the words keeps them readable on any picture.
// They read the scene's now-playing facts (np_*), its cover image and its record's springs.

import "viz.plm" as viz

library Widgets {
    // A soft dark haze, or the plate when asked for one: what any widget stands on.
    component Ground(x: number, y: number, w: number, h: number, u: number, plate: bool, hzv: number = 0.32, tnv: number = 0) {
        size: w, h
        // the look of them all (D141, wg_style): 0 adaptive · 1 phosphor · 2 ink · 3 chrome · 4 paper.
        // Phosphor, chrome and paper always stand on a plate of their own.
        let st = wg_style
        let plt = if(plate, true, st == 1 or st > 2.5)
        // a soft shadow cast on the wallpaper, away from its light (wg_lx, wg_ly)
        group { show: wg_shad and not editing
                blur: 14 * u
                box { from: x + wg_lx * 12 * u, y + wg_ly * 12 * u + 4 * u; size: w, h; corner: 10 * u; color: #000000; opacity: if(plt, 0.38, 0.2) } }
        // the haze follows the wallpaper under it (D139): stronger over detail; light behind dark words
        group { show: not plt
                blur: 22 * u
                box { from: x + 10 * u, y + 10 * u; size: w - 20 * u, h - 20 * u; corner: 12 * u; color: if(tnv > 0.5 or (st > 1.5 and st < 2.5), #ffffff, #000000); opacity: 0.12 + 0.55 * hzv } }
        box { from: x, y; size: w, h; corner: 6 * u; color: pick(st, fl.hull, #06120d, fl.hull, #262c33, #f2eadb); opacity: pick(st, 0.78, 0.84, 0.78, 0.9, 0.95); show: plt }
        group { show: plt and st > 2.5 and st < 3.5
                // chrome: brushed — a lit top edge and a darker foot
                box { from: x + 6 * u, y + 1; size: w - 12 * u, 1.2; color: #ffffff; opacity: 0.45 }
                box { from: x + 6 * u, y + h - 2; size: w - 12 * u, 1; color: #000000; opacity: 0.5 } }
        group { show: plt and st > 0.5 and st < 1.5
                glow: 8 * u, 0.35, fl.phos
                box { from: x, y; size: w, h; corner: 6 * u; stroke: 1; color: fl.phos; opacity: 0.55 } }
        box { from: x, y; size: w, h; corner: 6 * u; stroke: 1; color: pick(st, fl.trace_dim, fl.phos, fl.trace_dim, #8b98a5, #cbbd9f); opacity: 0.9; show: plt and not (st > 0.5 and st < 1.5) }
    }

    // ── Icons (D141) ──
    // The weather as drawn: 0 sun · 1 moon · 2 cloud · 3 sun and cloud · 4 fog · 5 rain · 6 snow · 7 storm
    // (lib/deskdata.icon_kind); centred on cx, cy, `s` across.
    component WxIcon(cx: number, cy: number, s: number, kind: number, ink: color, acc: color) {
        size: s, s
        let sun = #ffcf5a
        let cloud = mix(ink, #c9d2da, 0.5)
        let wet = kind == 5 or kind == 7
        let clouded = kind > 1.5 and kind != 4
        // the sun, whole or behind the cloud
        group {
            show: kind < 0.5 or (kind > 2.5 and kind < 3.5)
            let sx = if(kind < 0.5, cx, cx - s * 0.14)
            let sy = if(kind < 0.5, cy, cy - s * 0.14)
            let sr = if(kind < 0.5, s * 0.2, s * 0.15)
            glow: 6, 0.5, sun
            ellipse { at: sx, sy; radius: sr; color: sun }
            repeat ri in 0..8 {
                line { from: sx + sin(ri * 45) * sr * 1.4, sy - cos(ri * 45) * sr * 1.4; to: sx + sin(ri * 45) * sr * 1.95, sy - cos(ri * 45) * sr * 1.95
                       width: max(1, s * 0.05); color: sun }
            }
        }
        // the moon: a crescent
        arc { at: cx, cy; radius: s * 0.2; width: s * 0.1; span: 210deg; rotate: -120deg; color: #e8e2c8; show: kind > 0.5 and kind < 1.5 }
        // the cloud, raised a little when it rains or snows under it
        group {
            show: clouded
            let oy = if(kind > 4.5, -s * 0.1, 0)
            ellipse { at: cx - s * 0.14, cy + s * 0.04 + oy; radius: s * 0.15; color: cloud }
            ellipse { at: cx + s * 0.04, cy - s * 0.05 + oy; radius: s * 0.2; color: cloud }
            ellipse { at: cx + s * 0.2, cy + s * 0.05 + oy; radius: s * 0.13; color: cloud }
            box { from: cx - s * 0.29, cy + s * 0.04 + oy; size: s * 0.62, s * 0.15; corner: s * 0.07; color: cloud }
        }
        // rain, snow, lightning
        group {
            show: wet
            repeat di in 0..3 {
                line { from: cx - s * 0.16 + di * s * 0.16, cy + s * 0.18; to: cx - s * 0.21 + di * s * 0.16, cy + s * 0.34; width: max(1, s * 0.05); color: #8fc8ff }
            }
        }
        group {
            show: kind > 5.5 and kind < 6.5
            repeat ni in 0..3 { ellipse { at: cx - s * 0.16 + ni * s * 0.16, cy + s * 0.27; radius: max(1, s * 0.04); color: #f4f8ff } }
        }
        group {
            show: kind > 6.5
            glow: 4, 0.6, sun
            line { from: cx + s * 0.04, cy + s * 0.1; to: cx - s * 0.06, cy + s * 0.26; width: max(1.2, s * 0.06); color: sun }
            line { from: cx - s * 0.06, cy + s * 0.26; to: cx + s * 0.06, cy + s * 0.26; width: max(1.2, s * 0.06); color: sun }
            line { from: cx + s * 0.06, cy + s * 0.26; to: cx - s * 0.04, cy + s * 0.42; width: max(1.2, s * 0.06); color: sun }
        }
        // fog: three drawn lines
        group {
            show: kind > 3.5 and kind < 4.5
            repeat fi in 0..3 { box { from: cx - s * 0.3 + fi * s * 0.04, cy - s * 0.14 + fi * s * 0.14; size: s * 0.56, max(1.5, s * 0.06); corner: s * 0.03; color: cloud; opacity: 0.9 - fi * 0.15 } }
        }
    }

    // A battery: its body, its nub, how full (red under 20 %), and a bolt while charging. `s` is its height.
    component BatIcon(x: number, y: number, s: number, pct: number, chg: bool, ink: color, acc: color) {
        size: s * 2.3, s
        let bw = s * 2
        box { from: x, y; size: bw, s; corner: s * 0.18; stroke: max(1, s * 0.09); color: ink; opacity: 0.85 }
        box { from: x + bw + s * 0.06, y + s * 0.3; size: s * 0.16, s * 0.4; corner: s * 0.06; color: ink; opacity: 0.85 }
        box { from: x + s * 0.16, y + s * 0.16; size: (bw - s * 0.32) * clamp(pct / 100, 0.04, 1), s * 0.68; corner: s * 0.08
              color: if(pct < 20 and not chg, fl.ember, if(chg, #7be495, acc)) }
        group {
            show: chg
            glow: 4, 0.5, #fff3b0
            path { color: #fff3b0
                   move x + bw * 0.56, y - s * 0.12; line x + bw * 0.36, y + s * 0.56; line x + bw * 0.5, y + s * 0.56
                   line x + bw * 0.44, y + s * 1.12; line x + bw * 0.66, y + s * 0.42; line x + bw * 0.52, y + s * 0.42; close }
        }
    }

    // The cover, square, with a lit rim; the placeholder glyph when there is none.
    component Cover(x: number, y: number, s: number, u: number) {
        size: s, s
        box { from: x, y; size: s, s; corner: 4 * u; color: fl.well }
        text "♪" { at: x + s / 2, y + s / 2; anchor: center; align: center; size: s * 0.38; family: "Exo 2"; color: fl.trace; show: not np_cover_on }
        image cover { at: x, y; size: s, s; show: np_cover_on }
        box { from: x, y; size: s, s; corner: 4 * u; stroke: 1.2; color: fl.trace_lit; opacity: 0.55 }
    }

    // The transport under the title (D141): shuffle, previous, play or pause, next, repeat — shown
    // while the widget is pointed at, lit where a mode is on.
    component Transport(x: number, cy: number, u: number, k: number, hv: number, ink: color, acc: color) {
        size: 170 * u, 28 * u
        let on = pick(k, hl0, hl1, hl2, hl3, hl4, hl5, hl6, hl7, hl8, hl9, hl10, hl11) > 0.5 and not editing
        let bs = 26 * u
        group {
            opacity: hv
            repeat tb in 0..5 {
                let bx = x + tb * 34 * u + bs / 2
                let big = tb == 2
                ellipse { at: bx, cy; radius: if(big, 15, 12) * u; color: if(big, acc, ink); opacity: if(big, 0.95, 0.1) }
            }
            let g = 5 * u
            // shuffle: two crossing strokes
            line { from: x + 6 * u, cy - 4 * u; to: x + 20 * u, cy + 4 * u; width: 1.6 * u; color: if(np_shuf, acc, ink) }
            line { from: x + 6 * u, cy + 4 * u; to: x + 20 * u, cy - 4 * u; width: 1.6 * u; color: if(np_shuf, acc, ink) }
            // previous
            box { from: x + 34 * u + 7 * u, cy - g; size: 1.6 * u, 2 * g; color: ink }
            path { color: ink
                   move x + 34 * u + 9 * u, cy; line x + 34 * u + 19 * u, cy - g; line x + 34 * u + 19 * u, cy + g; close }
            // play, or pause while playing
            path { color: fl.hull; show: not np_playing
                   move x + 68 * u + 10 * u, cy - 6 * u; line x + 68 * u + 20 * u, cy; line x + 68 * u + 10 * u, cy + 6 * u; close }
            box { from: x + 68 * u + 8 * u, cy - 6 * u; size: 3.5 * u, 12 * u; color: fl.hull; show: np_playing }
            box { from: x + 68 * u + 15 * u, cy - 6 * u; size: 3.5 * u, 12 * u; color: fl.hull; show: np_playing }
            // next
            path { color: ink
                   move x + 102 * u + 7 * u, cy - g; line x + 102 * u + 17 * u, cy; line x + 102 * u + 7 * u, cy + g; close }
            box { from: x + 102 * u + 17 * u, cy - g; size: 1.6 * u, 2 * g; color: ink }
            // repeat: a loop, a 1 on it when one track repeats
            ellipse { at: x + 136 * u + 13 * u, cy; radius: 6 * u; stroke: 1.6 * u; color: if(np_loop > 0.5, acc, ink) }
            text "1" { at: x + 136 * u + 13 * u, cy; anchor: center; align: center; size: 7 * u; weight: 700; family: "Share Tech Mono"; color: acc; show: np_loop > 1.5 }
        }
        zone box tshuf { from: x, cy - bs / 2; size: bs, bs; cursor: pointer; role: toggle; checked: np_shuf; label: "Shuffle"; show: on }
        zone box tprev { from: x + 34 * u, cy - bs / 2; size: bs, bs; cursor: pointer; role: button; label: "Previous"; show: on }
        zone box tplay { from: x + 68 * u, cy - bs / 2; size: bs, bs; cursor: pointer; role: button; label: "Play or pause"; show: on }
        zone box tnext { from: x + 102 * u, cy - bs / 2; size: bs, bs; cursor: pointer; role: button; label: "Next"; show: on }
        zone box tloop { from: x + 136 * u, cy - bs / 2; size: bs, bs; cursor: pointer; role: button; label: "Repeat"; show: on }
        on press tshuf { emit wg_ctl(k * 10 + 3) }
        on press tprev { emit wg_ctl(k * 10) }
        on press tplay { emit wg_ctl(k * 10 + 1) }
        on press tnext { emit wg_ctl(k * 10 + 2) }
        on press tloop { emit wg_ctl(k * 10 + 4) }
    }

    // A strip of the music's bands inside a music widget (D141, its VISUALISER switch): 16 bars from the
    // bar's feed, risen from the foot, in its accent.
    component VizStrip(x: number, y: number, w: number, h: number, u: number, acc: color) {
        size: w, h
        repeat vi in 0..16 {
            let v = clamp(pick(vi, vb0, vb1, vb2, vb3, vb4, vb5, vb6, vb7, vb8, vb9, vb10, vb11, vb12, vb13, vb14, vb15), 0.03, 1)
            let bw = w / 16
            box { from: x + vi * bw + bw * 0.18, y + h - h * v; size: bw * 0.64, h * v; corner: min(2 * u, bw * 0.3); color: acc; opacity: 0.35 + 0.55 * v }
        }
    }

    // A seekable progress trace: thin, a little thicker while pointed at; the time gone and the length.
    component Progress(x: number, y: number, w: number, u: number, k: number, hv: number) {
        size: w, 10 * u
        box { from: x, y - (1 + hv) * u; size: w, (2 + 2 * hv) * u; color: fl.trace_dim; opacity: 0.8 }
        box { from: x, y - (1 + hv) * u; size: w * clamp(np_prg, 0, 1), (2 + 2 * hv) * u; color: fl.phos }
        ellipse { at: x + w * clamp(np_prg, 0, 1), y; radius: 4 * u * hv; color: fl.phos }
        group {
            opacity: hv
            text np_tpos { at: x, y - 10 * u; anchor: left center; size: 9 * u; family: "Share Tech Mono"; color: fl.engrave }
            text np_tlen { at: x + w, y - 10 * u; anchor: right center; size: 9 * u; family: "Share Tech Mono"; color: fl.engrave }
        }
        zone box pseek { from: x, y - 6 * u; size: w, 12 * u; cursor: pointer; role: slider; label: "Seek"; show: pick(k, hl0, hl1, hl2, hl3, hl4, hl5, hl6, hl7, hl8, hl9, hl10, hl11) > 0.5 and not editing }
        on press pseek { emit wg_seek(k * 1000 + round(clamp((local.x - x) / w, 0, 1) * 999)) }
    }

    // What the cover does: opens mooi's player; the wheel over it is the volume.
    component CoverZone(x: number, y: number, w: number, h: number, k: number) {
        size: w, h
        zone box cz { from: x, y; size: w, h; cursor: pointer; role: button; label: "Open the player"; show: not editing }
        on press cz { emit wg_open(k) }
        on scroll cz { emit wg_vol(k * 10 + if(wheel > 0, 1, 0)) }
    }

    // A widget resting as a small engraved mark where it sat: a press opens the player.
    component Marker(x: number, y: number, u: number, k: number) {
        size: 28 * u, 28 * u
        ellipse { at: x + 14 * u, y + 14 * u; radius: 13 * u; color: fl.hull; opacity: 0.7 }
        ellipse { at: x + 14 * u, y + 14 * u; radius: 13 * u; stroke: 1; color: fl.trace_lit; opacity: 0.8 }
        text "♪" { at: x + 14 * u, y + 14 * u; anchor: center; align: center; size: 14 * u; family: "Exo 2"; color: fl.phos }
        zone box mz { from: x, y; size: 28 * u, 28 * u; cursor: pointer; role: button; label: "Open the player" }
        on press mz { emit wg_open(k) }
    }

    // A: the sleeve — the cover, then the title, the artist, the line being sung and the progress.
    component Sleeve(x: number, y: number, w: number, h: number, u: number, lyr: bool, prog: bool, plate: bool, k: number, hv: number, ts: number = 1, ink: color = #e6eaee, acc: color = #8fd3c0, hzv: number = 0.32, tnv: number = 0, viz: bool = false) {
        size: w, h
        let pad = 14 * u
        let cs = h - 2 * pad
        let tx = x + pad + cs + 16 * u
        let tw = max(10, x + w - pad - tx)
        Ground(x, y, w, h, u, plate, hzv, tnv)
        Cover(x + pad, y + pad, cs, u)
        text pick(np_has, "NOTHING PLAYING", np_title) { at: tx, y + pad + 12 * u; anchor: left center; size: 20 * u * ts; weight: 700; family: "Exo 2"
              width: tw; lines: 1; color: ink }
        text np_artist { at: tx, y + pad + 36 * u; anchor: left center; size: 12 * u * ts; family: "Share Tech Mono"; width: tw; lines: 1; color: mix(ink, acc, 0.45) }
        group {
            show: lyr and np_sung
            opacity: np_lf
            text np_line { at: tx, y + pad + 64 * u; anchor: left center; size: 14 * u * ts; family: "Exo 2"; width: tw; lines: 1; color: acc }
        }
        // the music itself under the words, when asked for; the transport over it while pointed at
        group { show: viz and np_playing
                opacity: 1 - 0.7 * hv
                VizStrip(tx, y + h - pad - 34 * u, tw, 26 * u, u, acc) }
        group { show: prog and np_has
                Progress(tx, y + h - pad - 1 * u, tw, u, k, hv) }
        CoverZone(x + pad, y + pad, cs, cs, k)
        Transport(tx, y + h - pad - 26 * u, u * 0.85, k, hv, ink, acc)
    }

    // B: the lyric stage — the line being sung large and centred, the ones either side faded, the
    // cover and the title as a caption. Without synced lyrics, the title takes the stage.
    component LyricStage(x: number, y: number, w: number, h: number, u: number, plate: bool, k: number, hv: number, ts: number = 1, ink: color = #e6eaee, acc: color = #8fd3c0, hzv: number = 0.32, tnv: number = 0, viz: bool = false) {
        size: w, h
        let cx = x + w / 2
        let lw = w - 64 * u
        let sung = np_sung
        Ground(x, y, w, h, u, plate, hzv, tnv)
        text np_prev { at: cx, y + h * 0.2; anchor: center; align: center; size: 17 * u * ts; family: "Exo 2"; width: lw; lines: 1; color: mix(ink, acc, 0.45); opacity: 0.45; show: sung }
        group {
            opacity: if(sung, np_lf, 1)
            text np_line { at: cx, y + h * 0.48; anchor: center; align: center; size: 34 * u * ts; weight: 600; family: "Exo 2"
                  width: lw; lines: 2; color: ink; show: sung }
            text pick(np_has, "NOTHING PLAYING", np_title) { at: cx, y + h * 0.48; anchor: center; align: center; size: 34 * u * ts; weight: 600; family: "Exo 2"
                  width: lw; lines: 2; color: ink; show: not sung }
        }
        text np_next { at: cx, y + h * 0.76; anchor: center; align: center; size: 17 * u * ts; family: "Exo 2"; width: lw; lines: 1; color: mix(ink, acc, 0.45); opacity: 0.45; show: sung }
        Cover(x + 16 * u, y + h - 44 * u, 28 * u, u)
        CoverZone(x + 16 * u, y + h - 44 * u, 28 * u, 28 * u, k)
        group { show: viz and np_playing
                opacity: 0.6
                VizStrip(x + w * 0.25, y + h - 22 * u, w * 0.5, 16 * u, u, acc) }
        Transport(x + w - 166 * u, y + h - 30 * u, u * 0.85, k, hv, ink, acc)
        text "{np_title}  ·  {np_artist}" { at: x + 52 * u, y + h - 30 * u; anchor: left center; size: 11 * u * ts; family: "Share Tech Mono"
              width: w - 72 * u; lines: 1; color: mix(ink, acc, 0.3); opacity: 0.8; show: np_has and sung }
    }

    // C: the record — the cover as its label, turning at 33⅓ while it plays, the tonearm on the
    // song; the title and the artist under it.
    component Record(x: number, y: number, w: number, h: number, u: number, plate: bool, prog: bool, k: number, hv: number, ts: number = 1, ink: color = #e6eaee, acc: color = #8fd3c0, hzv: number = 0.32, tnv: number = 0, viz: bool = false) {
        size: w, h
        let r = w * 0.44
        let rcx = x + w / 2
        let rcy = y + w * 0.5
        let rl = r * 0.36
        let px = x + w * 0.9
        let py = y + w * 0.1
        Ground(x, y, w, h, u, plate, hzv, tnv)
        ellipse { at: rcx, rcy; radius: r; color: #0d0f11 }
        repeat g in 0..7 {
            ellipse { at: rcx, rcy; radius: rl + 6 * u + g * (r - rl - 10 * u) / 6; stroke: 0.8; color: #23272b; opacity: 0.9 }
        }
        ellipse { at: rcx, rcy; radius: r; stroke: 1.5; color: fl.steel_700 }
        group {
            pivot: rcx, rcy
            rotate: np_vang * 1deg
            mask: radial rcx, rcy radius rl - 1 to rl
            box { from: rcx - rl, rcy - rl; size: rl * 2, rl * 2; color: mix(fl.ember_fill, fl.hull, 0.3) }
            image cover { at: rcx - rl, rcy - rl; size: rl * 2, rl * 2; show: np_cover_on }
        }
        ellipse { at: rcx, rcy; radius: 3 * u; color: fl.steel_300 }
        ellipse { at: px, py; radius: 9 * u; color: fl.steel_700 }
        group {
            pivot: px, py
            rotate: np_arm * 1deg
            line { from: px, py; to: px, py + r * 1.05; width: 3 * u; color: fl.steel_300 }
            line { from: px, py + r * 1.05; to: px - 7 * u, py + r * 1.2; width: 3 * u; color: fl.steel_300 }
        }
        text pick(np_has, "NOTHING PLAYING", np_title) { at: rcx, y + w + 16 * u; anchor: center; align: center; size: 17 * u * ts; weight: 700; family: "Exo 2"
              width: w - 16 * u; lines: 1; color: ink }
        text np_artist { at: rcx, y + w + 40 * u; anchor: center; align: center; size: 11 * u * ts; family: "Share Tech Mono"; width: w - 16 * u; lines: 1; color: mix(ink, acc, 0.45) }
        group { show: prog and np_has
                Progress(x + 24 * u, y + w + 60 * u, w - 48 * u, u, k, hv) }
        group { show: viz and np_playing
                VizStrip(x + 24 * u, y + h - 22 * u, w - 48 * u, 14 * u, u, acc) }
        CoverZone(rcx - rl, rcy - rl, rl * 2, rl * 2, k)
        Transport(rcx - 72 * u, rcy + r * 0.62, u * 0.85, k, hv, ink, acc)
    }

    // ── Edit mode (mooi widgets edit) ──────────────────────────────

    // A small engraved chip: a choice, a switch or an action, sending its code to the logic.
    component Chip(x: number, y: number, w: number, word: text, on: bool, code: number) {
        size: w, 24
        zone box ch { from: x, y; size: w, 24; cursor: pointer; role: button; label: word }
        box { from: x, y; size: w, 24; corner: 4; color: if(on, fl.phos_fill, fl.well); opacity: if(on, 0.9, 0.7 + 0.3 * ch.hover) }
        box { from: x, y; size: w, 24; corner: 4; stroke: 1; color: if(on, fl.phos, mix(fl.trace_dim, fl.trace_lit, ch.hover)) }
        text word { at: x + w / 2, y + 12; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"
                    width: w - 6; lines: 1; color: if(on, fl.ink, fl.engrave) }
        on press ch { wg_hold = 0; emit wg_opt(code) }
    }

    // The options beside the chosen widget: its layout or mode, what it does at rest, its
    // switches, and duplicate / remove. `k` is its slot; the logic says what is chosen.
    // A slider: a track, a thumb and its value; pressed or pulled it sends where (0 … 999), live,
    // and its letting go saves it. `which` is the logic's (mooi-widgets.luau wg_slide).
    component WSlider(x: number, y: number, w: number, word: text, shown: text, f: number, k: number, which: number) {
        size: w, 24
        let tx = x + 78
        let tw = w - 78 - 52
        text word { at: x, y + 12; anchor: left center; size: 9; family: "Share Tech Mono"; color: fl.muted; width: 74; lines: 1 }
        zone box sz { from: tx - 6, y; size: tw + 12, 24; cursor: pointer; role: slider; label: word }
        box { from: tx, y + 11; size: tw, 2; corner: 1; color: fl.trace_dim }
        box { from: tx, y + 11; size: tw * clamp(f, 0, 1), 2; corner: 1; color: fl.phos }
        ellipse { at: tx + tw * clamp(f, 0, 1), y + 12; radius: 5 + sz.hover; color: fl.phos }
        text shown { at: x + w, y + 12; anchor: right center; size: 10; family: "Share Tech Mono"; color: fl.engrave; width: 48; lines: 1; align: right }
        on press sz { wg_hold = 3; emit wg_slide(k * 10000 + which * 1000 + round(clamp((local.x - tx) / tw, 0, 1) * 999)) }
        on drag sz while wg_hold == 3 { emit wg_slide(k * 10000 + which * 1000 + round(clamp((local.x - tx) / tw, 0, 1) * 999)) }
        on release sz while wg_hold == 3 { emit wg_slid }
        on scroll sz { emit wg_slide(k * 10000 + which * 1000 + round(clamp(f + if(wheel > 0, 0.04, -0.04), 0, 1) * 999))
                       emit wg_slid }
    }

    // The options of the chosen widget (D138): dragged by its header, folded with ⌄; its layout
    // or mode as live thumbnails, sliders, what it does at rest, its switches, where it is.
    component Panel(x: number, y: number, k: number) {
        size: 320, 520
        let base = k * 1000
        let np = wg_sk < 0.5
        let vis = wg_sk > 0.5 and wg_sk < 1.5
        let sy = if(vis, 186, if(np, 122, if(wg_sk == 3 or wg_sk == 7, 40, 76)))   // the sliders
        let ns = if(vis, 8, if(np, 3, 2))
        let ry = sy + ns * 30 + 8                 // at rest
        let wy = ry + 44                          // the switches
        let ay = wy + if(vis, 100, if(np, 130, if(wg_sk == 4 or wg_sk == 11 or wg_sk == 2 or wg_sk == 12, 70, if(wg_sk == 10 or wg_sk == 15, 100, 40))))   // where, and the actions
        let ph = if(wg_pcol, 30, ay + 102)
        box { from: x, y; size: 320, ph; corner: 6; color: fl.hull; opacity: 0.95 }
        box { from: x, y; size: 320, ph; corner: 6; stroke: 1; color: fl.trace_lit; opacity: 0.8 }
        // the header: its title, the fold, and the handle that carries the panel
        zone box phd { from: x, y; size: 284, 30; cursor: grab; role: button; label: "Move the options" }
        on press phd { wg_hold = 2; wg_pbx = x; wg_pby = y }
        on drag phd while wg_hold == 2 { emit wg_pmove(round(clamp(wg_pbx + drag.dx, 0, 4095)) * 4096 + round(clamp(wg_pby + drag.dy, 0, 4095))) }
        text pick(wg_sk, "NOW PLAYING", "VISUALISER", "CLOCK", "NOTES", "GITHUB", "WEATHER", "SYSTEM", "CALENDAR", "FOCUS TIMER", "CLAUDE", "PHOTO", "LAUNCHER", "NOTICES", "WALLPAPERS", "SETTINGS", "CONTROLS") { at: x + 12, y + 16; anchor: left center; size: 11; weight: 700; family: "Share Tech Mono"; color: fl.phos }
        text "{wg_nsel} CHOSEN · THESE ARE THE LAST ONE'S" { at: x + 120, y + 16; anchor: left center; size: 8; family: "Share Tech Mono"; color: fl.muted; show: wg_nsel > 1 }
        zone box pfo { from: x + 288, y + 4; size: 26, 22; cursor: pointer; role: button; label: "Fold the options" }
        text pick(wg_pcol, "⌄", "›") { at: x + 301, y + 15; anchor: center; align: center; size: 14; family: "Exo 2"; color: fl.engrave }
        on press pfo { wg_hold = 0; wg_pcol = not wg_pcol }
        group {
            show: not wg_pcol
            // 1 · the layout, or the mode, as live thumbnails
            group {
                show: np
            group {
                zone box tc0 { from: x + 12, y + 36; size: 96, 76; cursor: pointer; role: button; label: "Sleeve" }
                box { from: x + 12, y + 36; size: 96, 76; corner: 4; color: fl.ground; opacity: 0.8 }
                box { from: x + 12, y + 36; size: 96, 76; corner: 4; stroke: if(wg_sl == 0, 1.6, 1); color: if(wg_sl == 0, fl.phos, mix(fl.trace_dim, fl.trace_lit, tc0.hover)) }
                Sleeve(x + 12 + 4, y + 42, 88, 31, 0.2, true, true, false, k, 0)
                text "SLEEVE" { at: x + 12 + 48, y + 104; anchor: center; align: center; size: 8; family: "Share Tech Mono"; color: if(wg_sl == 0, fl.phos, fl.muted) }
                on press tc0 { wg_hold = 0; emit wg_opt(base + 100 + 0) }
            }
            group {
                zone box tc1 { from: x + 112, y + 36; size: 96, 76; cursor: pointer; role: button; label: "Lyrics" }
                box { from: x + 112, y + 36; size: 96, 76; corner: 4; color: fl.ground; opacity: 0.8 }
                box { from: x + 112, y + 36; size: 96, 76; corner: 4; stroke: if(wg_sl == 1, 1.6, 1); color: if(wg_sl == 1, fl.phos, mix(fl.trace_dim, fl.trace_lit, tc1.hover)) }
                LyricStage(x + 112 + 4, y + 42, 88, 22, 0.092, false, k, 0)
                text "LYRICS" { at: x + 112 + 48, y + 104; anchor: center; align: center; size: 8; family: "Share Tech Mono"; color: if(wg_sl == 1, fl.phos, fl.muted) }
                on press tc1 { wg_hold = 0; emit wg_opt(base + 100 + 1) }
            }
            group {
                zone box tc2 { from: x + 212, y + 36; size: 96, 76; cursor: pointer; role: button; label: "Record" }
                box { from: x + 212, y + 36; size: 96, 76; corner: 4; color: fl.ground; opacity: 0.8 }
                box { from: x + 212, y + 36; size: 96, 76; corner: 4; stroke: if(wg_sl == 2, 1.6, 1); color: if(wg_sl == 2, fl.phos, mix(fl.trace_dim, fl.trace_lit, tc2.hover)) }
                Record(x + 212 + 26, y + 40, 44, 56, 0.157, false, false, k, 0)
                text "RECORD" { at: x + 212 + 48, y + 104; anchor: center; align: center; size: 8; family: "Share Tech Mono"; color: if(wg_sl == 2, fl.phos, fl.muted) }
                on press tc2 { wg_hold = 0; emit wg_opt(base + 100 + 2) }
            }
            }
            group {
                show: vis
            group {
                zone box th0 { from: x + 12, y + 36 + 0 * 48; size: 72, 44; cursor: pointer; role: button; label: "Spectrum" }
                box { from: x + 12, y + 36 + 0 * 48; size: 72, 44; corner: 4; color: fl.ground; opacity: 0.8 }
                box { from: x + 12, y + 36 + 0 * 48; size: 72, 44; corner: 4; stroke: if(wg_sm == 0, 1.6, 1); color: if(wg_sm == 0, fl.phos, mix(fl.trace_dim, fl.trace_lit, th0.hover)) }
                Visualiser(x + 12 + 4, y + 36 + 0 * 48 + 3, 64, 28, 0.15, 0, 0, false)
                text "SPECTRUM" { at: x + 12 + 36, y + 36 + 0 * 48 + 38; anchor: center; align: center; size: 8; family: "Share Tech Mono"; color: if(wg_sm == 0, fl.phos, fl.muted) }
                on press th0 { wg_hold = 0; emit wg_opt(base + 100 + 0) }
            }
            group {
                zone box th1 { from: x + 88, y + 36 + 0 * 48; size: 72, 44; cursor: pointer; role: button; label: "Mirror" }
                box { from: x + 88, y + 36 + 0 * 48; size: 72, 44; corner: 4; color: fl.ground; opacity: 0.8 }
                box { from: x + 88, y + 36 + 0 * 48; size: 72, 44; corner: 4; stroke: if(wg_sm == 1, 1.6, 1); color: if(wg_sm == 1, fl.phos, mix(fl.trace_dim, fl.trace_lit, th1.hover)) }
                Visualiser(x + 88 + 4, y + 36 + 0 * 48 + 3, 64, 28, 0.15, 1, 0, false)
                text "MIRROR" { at: x + 88 + 36, y + 36 + 0 * 48 + 38; anchor: center; align: center; size: 8; family: "Share Tech Mono"; color: if(wg_sm == 1, fl.phos, fl.muted) }
                on press th1 { wg_hold = 0; emit wg_opt(base + 100 + 1) }
            }
            group {
                zone box th2 { from: x + 164, y + 36 + 0 * 48; size: 72, 44; cursor: pointer; role: button; label: "Ring" }
                box { from: x + 164, y + 36 + 0 * 48; size: 72, 44; corner: 4; color: fl.ground; opacity: 0.8 }
                box { from: x + 164, y + 36 + 0 * 48; size: 72, 44; corner: 4; stroke: if(wg_sm == 2, 1.6, 1); color: if(wg_sm == 2, fl.phos, mix(fl.trace_dim, fl.trace_lit, th2.hover)) }
                Visualiser(x + 164 + 4, y + 36 + 0 * 48 + 3, 64, 28, 0.15, 2, 0, false)
                text "RING" { at: x + 164 + 36, y + 36 + 0 * 48 + 38; anchor: center; align: center; size: 8; family: "Share Tech Mono"; color: if(wg_sm == 2, fl.phos, fl.muted) }
                on press th2 { wg_hold = 0; emit wg_opt(base + 100 + 2) }
            }
            group {
                zone box th3 { from: x + 240, y + 36 + 0 * 48; size: 72, 44; cursor: pointer; role: button; label: "Aurora" }
                box { from: x + 240, y + 36 + 0 * 48; size: 72, 44; corner: 4; color: fl.ground; opacity: 0.8 }
                box { from: x + 240, y + 36 + 0 * 48; size: 72, 44; corner: 4; stroke: if(wg_sm == 3, 1.6, 1); color: if(wg_sm == 3, fl.phos, mix(fl.trace_dim, fl.trace_lit, th3.hover)) }
                Visualiser(x + 240 + 4, y + 36 + 0 * 48 + 3, 64, 28, 0.15, 3, 0, false)
                text "AURORA" { at: x + 240 + 36, y + 36 + 0 * 48 + 38; anchor: center; align: center; size: 8; family: "Share Tech Mono"; color: if(wg_sm == 3, fl.phos, fl.muted) }
                on press th3 { wg_hold = 0; emit wg_opt(base + 100 + 3) }
            }
            group {
                zone box th4 { from: x + 12, y + 36 + 1 * 48; size: 72, 44; cursor: pointer; role: button; label: "Led" }
                box { from: x + 12, y + 36 + 1 * 48; size: 72, 44; corner: 4; color: fl.ground; opacity: 0.8 }
                box { from: x + 12, y + 36 + 1 * 48; size: 72, 44; corner: 4; stroke: if(wg_sm == 4, 1.6, 1); color: if(wg_sm == 4, fl.phos, mix(fl.trace_dim, fl.trace_lit, th4.hover)) }
                Visualiser(x + 12 + 4, y + 36 + 1 * 48 + 3, 64, 28, 0.15, 4, 0, false)
                text "LED" { at: x + 12 + 36, y + 36 + 1 * 48 + 38; anchor: center; align: center; size: 8; family: "Share Tech Mono"; color: if(wg_sm == 4, fl.phos, fl.muted) }
                on press th4 { wg_hold = 0; emit wg_opt(base + 100 + 4) }
            }
            group {
                zone box th5 { from: x + 88, y + 36 + 1 * 48; size: 72, 44; cursor: pointer; role: button; label: "Orbit" }
                box { from: x + 88, y + 36 + 1 * 48; size: 72, 44; corner: 4; color: fl.ground; opacity: 0.8 }
                box { from: x + 88, y + 36 + 1 * 48; size: 72, 44; corner: 4; stroke: if(wg_sm == 5, 1.6, 1); color: if(wg_sm == 5, fl.phos, mix(fl.trace_dim, fl.trace_lit, th5.hover)) }
                Visualiser(x + 88 + 4, y + 36 + 1 * 48 + 3, 64, 28, 0.15, 5, 0, false)
                text "ORBIT" { at: x + 88 + 36, y + 36 + 1 * 48 + 38; anchor: center; align: center; size: 8; family: "Share Tech Mono"; color: if(wg_sm == 5, fl.phos, fl.muted) }
                on press th5 { wg_hold = 0; emit wg_opt(base + 100 + 5) }
            }
            group {
                zone box th6 { from: x + 164, y + 36 + 1 * 48; size: 72, 44; cursor: pointer; role: button; label: "Scope" }
                box { from: x + 164, y + 36 + 1 * 48; size: 72, 44; corner: 4; color: fl.ground; opacity: 0.8 }
                box { from: x + 164, y + 36 + 1 * 48; size: 72, 44; corner: 4; stroke: if(wg_sm == 6, 1.6, 1); color: if(wg_sm == 6, fl.phos, mix(fl.trace_dim, fl.trace_lit, th6.hover)) }
                Visualiser(x + 164 + 4, y + 36 + 1 * 48 + 3, 64, 28, 0.15, 6, 0, false)
                text "SCOPE" { at: x + 164 + 36, y + 36 + 1 * 48 + 38; anchor: center; align: center; size: 8; family: "Share Tech Mono"; color: if(wg_sm == 6, fl.phos, fl.muted) }
                on press th6 { wg_hold = 0; emit wg_opt(base + 100 + 6) }
            }
            group {
                zone box th7 { from: x + 240, y + 36 + 1 * 48; size: 72, 44; cursor: pointer; role: button; label: "Horizon" }
                box { from: x + 240, y + 36 + 1 * 48; size: 72, 44; corner: 4; color: fl.ground; opacity: 0.8 }
                box { from: x + 240, y + 36 + 1 * 48; size: 72, 44; corner: 4; stroke: if(wg_sm == 7, 1.6, 1); color: if(wg_sm == 7, fl.phos, mix(fl.trace_dim, fl.trace_lit, th7.hover)) }
                Visualiser(x + 240 + 4, y + 36 + 1 * 48 + 3, 64, 28, 0.15, 7, 0, false)
                text "HORIZON" { at: x + 240 + 36, y + 36 + 1 * 48 + 38; anchor: center; align: center; size: 8; family: "Share Tech Mono"; color: if(wg_sm == 7, fl.phos, fl.muted) }
                on press th7 { wg_hold = 0; emit wg_opt(base + 100 + 7) }
            }
            group {
                zone box th8 { from: x + 12, y + 36 + 2 * 48; size: 72, 44; cursor: pointer; role: button; label: "Dust" }
                box { from: x + 12, y + 36 + 2 * 48; size: 72, 44; corner: 4; color: fl.ground; opacity: 0.8 }
                box { from: x + 12, y + 36 + 2 * 48; size: 72, 44; corner: 4; stroke: if(wg_sm == 8, 1.6, 1); color: if(wg_sm == 8, fl.phos, mix(fl.trace_dim, fl.trace_lit, th8.hover)) }
                Visualiser(x + 12 + 4, y + 36 + 2 * 48 + 3, 64, 28, 0.15, 8, 0, false)
                text "DUST" { at: x + 12 + 36, y + 36 + 2 * 48 + 38; anchor: center; align: center; size: 8; family: "Share Tech Mono"; color: if(wg_sm == 8, fl.phos, fl.muted) }
                on press th8 { wg_hold = 0; emit wg_opt(base + 100 + 8) }
            }
            group {
                zone box th9 { from: x + 88, y + 36 + 2 * 48; size: 72, 44; cursor: pointer; role: button; label: "Ripple" }
                box { from: x + 88, y + 36 + 2 * 48; size: 72, 44; corner: 4; color: fl.ground; opacity: 0.8 }
                box { from: x + 88, y + 36 + 2 * 48; size: 72, 44; corner: 4; stroke: if(wg_sm == 9, 1.6, 1); color: if(wg_sm == 9, fl.phos, mix(fl.trace_dim, fl.trace_lit, th9.hover)) }
                Visualiser(x + 88 + 4, y + 36 + 2 * 48 + 3, 64, 28, 0.15, 9, 0, false)
                text "RIPPLE" { at: x + 88 + 36, y + 36 + 2 * 48 + 38; anchor: center; align: center; size: 8; family: "Share Tech Mono"; color: if(wg_sm == 9, fl.phos, fl.muted) }
                on press th9 { wg_hold = 0; emit wg_opt(base + 100 + 9) }
            }
            group {
                zone box th10 { from: x + 164, y + 36 + 2 * 48; size: 72, 44; cursor: pointer; role: button; label: "Skyline" }
                box { from: x + 164, y + 36 + 2 * 48; size: 72, 44; corner: 4; color: fl.ground; opacity: 0.8 }
                box { from: x + 164, y + 36 + 2 * 48; size: 72, 44; corner: 4; stroke: if(wg_sm == 10, 1.6, 1); color: if(wg_sm == 10, fl.phos, mix(fl.trace_dim, fl.trace_lit, th10.hover)) }
                Visualiser(x + 164 + 4, y + 36 + 2 * 48 + 3, 64, 28, 0.15, 10, 0, false)
                text "SKYLINE" { at: x + 164 + 36, y + 36 + 2 * 48 + 38; anchor: center; align: center; size: 8; family: "Share Tech Mono"; color: if(wg_sm == 10, fl.phos, fl.muted) }
                on press th10 { wg_hold = 0; emit wg_opt(base + 100 + 10) }
            }
            group {
                zone box th11 { from: x + 240, y + 36 + 2 * 48; size: 72, 44; cursor: pointer; role: button; label: "Liquid" }
                box { from: x + 240, y + 36 + 2 * 48; size: 72, 44; corner: 4; color: fl.ground; opacity: 0.8 }
                box { from: x + 240, y + 36 + 2 * 48; size: 72, 44; corner: 4; stroke: if(wg_sm == 11, 1.6, 1); color: if(wg_sm == 11, fl.phos, mix(fl.trace_dim, fl.trace_lit, th11.hover)) }
                Visualiser(x + 240 + 4, y + 36 + 2 * 48 + 3, 64, 28, 0.15, 11, 0, false)
                text "LIQUID" { at: x + 240 + 36, y + 36 + 2 * 48 + 38; anchor: center; align: center; size: 8; family: "Share Tech Mono"; color: if(wg_sm == 11, fl.phos, fl.muted) }
                on press th11 { wg_hold = 0; emit wg_opt(base + 100 + 11) }
            }
            }
            group {
                show: wg_sk > 1.5 and wg_sk < 2.5
                text "LAYOUT" { at: x + 12, y + 42; anchor: left center; size: 9; family: "Share Tech Mono"; color: fl.muted }
                Chip(x + 12, y + 52, 70, "DIGITAL", wg_sl < 0.5, base + 100)
                Chip(x + 86, y + 52, 72, "ANALOGUE", wg_sl > 0.5 and wg_sl < 1.5, base + 101)
                Chip(x + 162, y + 52, 70, "WORDS", wg_sl > 1.5 and wg_sl < 2.5, base + 102)
                Chip(x + 236, y + 52, 72, "INFO", wg_sl > 2.5, base + 103)
            }
            group {
                show: wg_sk == 4
                text "LAYOUT" { at: x + 12, y + 42; anchor: left center; size: 9; family: "Share Tech Mono"; color: fl.muted }
                Chip(x + 12, y + 52, 70, "CARD", wg_sl < 0.5, base + 100)
                Chip(x + 86, y + 52, 72, "COMMITS", wg_sl > 0.5 and wg_sl < 1.5, base + 101)
                Chip(x + 162, y + 52, 70, "PULSE", wg_sl > 1.5 and wg_sl < 2.5, base + 102)
                Chip(x + 236, y + 52, 72, "ACTIVITY", wg_sl > 2.5, base + 103)
            }
            // the D141 kinds with two layouts
            group {
                show: wg_sk > 4.5 and wg_sk != 7 and wg_sk != 11 and wg_sk < 11.5
                let n = wg_sk - 5
                text "LAYOUT" { at: x + 12, y + 42; anchor: left center; size: 9; family: "Share Tech Mono"; color: fl.muted }
                Chip(x + 12, y + 52, 146, pick(n, "HORIZON", "SCOPE", "", "RING", "TICKER", "FRAME", "SHELF"), wg_sl < 0.5, base + 100)
                Chip(x + 162, y + 52, 146, pick(n, "DAYS", "GAUGES", "", "SLAB", "QUOTE", "POLAROID", "COLUMN"), wg_sl > 0.5, base + 101)
            }
            // D215: the launcher's three layouts; the controls' two
            group {
                show: wg_sk == 11
                text "LAYOUT" { at: x + 12, y + 42; anchor: left center; size: 9; family: "Share Tech Mono"; color: fl.muted }
                Chip(x + 12, y + 52, 96, "SHELF", wg_sl < 0.5, base + 100)
                Chip(x + 112, y + 52, 96, "COLUMN", wg_sl > 0.5 and wg_sl < 1.5, base + 101)
                Chip(x + 212, y + 52, 96, "GRID", wg_sl > 1.5, base + 102)
            }
            group {
                show: wg_sk == 15
                text "LAYOUT" { at: x + 12, y + 42; anchor: left center; size: 9; family: "Share Tech Mono"; color: fl.muted }
                Chip(x + 12, y + 52, 146, "ROW", wg_sl < 0.5, base + 100)
                Chip(x + 162, y + 52, 146, "COLUMN", wg_sl > 0.5, base + 101)
            }
            // 2 · sliders
            WSlider(x + 12, y + sy, 296, "OPACITY", "{round(wg_oop * 100)}%", (wg_oop - 0.3) / 0.7, k, 1)
            WSlider(x + 12, y + sy + 30, 296, "SCALE", "{round(wg_osc * 100)}%", wg_osc, k, 7)
            group {
                show: np
                WSlider(x + 12, y + sy + 60, 296, "TEXT", "{round(wg_otx * 100)}%", (wg_otx - 0.8) / 0.6, k, 6)
            }
            group {
                show: vis
                WSlider(x + 12, y + sy + 60, 296, "BARS", "{round(wg_ob)}", (wg_ob - 16) / 112, k, 2)
                WSlider(x + 12, y + sy + 90, 296, "GLOW", "{round(wg_og * 100)}%", wg_og, k, 3)
                WSlider(x + 12, y + sy + 120, 296, "GAP", "{round(wg_ogap * 100)}%", wg_ogap / 0.6, k, 4)
                WSlider(x + 12, y + sy + 150, 296, "SMOOTHING", "{round(wg_osm * 100)}%", wg_osm, k, 5)
                // the look's turn about its own centre (-180 … 180), and its lean inside the box
                // (-40 … 40); SQUARE below levels both
                WSlider(x + 12, y + sy + 180, 296, "ANGLE", "{round(wg_oa)}°", (wg_oa + 180) / 360, k, 8)
                // the lean only reaches the modes drawn without effects of their own (vizwide)
                group {
                    show: wg_sm == 0 or wg_sm == 1 or wg_sm == 4 or wg_sm == 5 or wg_sm == 7 or wg_sm == 10
                    WSlider(x + 12, y + sy + 210, 296, "LEAN", "{round(wg_ol)}°", (wg_ol + 40) / 80, k, 9)
                }
            }
            // 3 · at rest
            text "AT REST" { at: x + 12, y + ry; anchor: left center; size: 9; family: "Share Tech Mono"; color: fl.muted }
            Chip(x + 12, y + ry + 10, 96, "HIDE", wg_si < 0.5, base + 200)
            Chip(x + 112, y + ry + 10, 96, "REST", wg_si > 0.5 and wg_si < 1.5, base + 201)
            Chip(x + 212, y + ry + 10, 96, "MARKER", wg_si > 1.5, base + 202)
            // 4 · switches
            group {
                show: wg_sk > 1.5 and wg_sk < 2.5
                Chip(x + 12, y + wy, 96, "24 HOUR", wg_oh24, base + if(wg_oh24, 910, 909))
                Chip(x + 112, y + wy, 96, "SECONDS", wg_osec, base + if(wg_osec, 912, 911))
                Chip(x + 212, y + wy, 96, "PLATE", wg_o5, base + 500 + if(wg_o5, 0, 1))
            }
            group {
                show: wg_sk > 2.5 and wg_sk < 3.5
                Chip(x + 12, y + wy, 96, "PLATE", wg_o5, base + 500 + if(wg_o5, 0, 1))
            }
            group {
                show: wg_sk == 4
                Chip(x + 12, y + wy, 96, "PLATE", wg_o5, base + 500 + if(wg_o5, 0, 1))
                // the repository: owner/name, Enter to read it
                text "REPO" { at: x + 118, y + wy + 12; anchor: left center; size: 9; family: "Share Tech Mono"; color: fl.muted }
                box { from: x + 150, y + wy; size: 158, 24; corner: 4; color: fl.well }
                box { from: x + 150, y + wy; size: 158, 24; corner: 4; stroke: 1; color: fl.trace_dim }
                input wg_repo { at: x + 156, y + wy + 5; width: 146; size: 11; family: "Share Tech Mono"; color: fl.engrave; selection: fl.well; placeholder: "owner/name" }
                text "ENTER TO READ IT · ANY PUBLIC REPO, OR YOURS" { at: x + 12, y + wy + 40; anchor: left center; size: 8; family: "Share Tech Mono"; color: fl.muted }
            }
            group {
                show: np
                Chip(x + 12, y + wy, 144, "LYRIC LINE", wg_o3, base + 300 + if(wg_o3, 0, 1))
                Chip(x + 164, y + wy, 144, "PROGRESS", wg_o4, base + 400 + if(wg_o4, 0, 1))
                Chip(x + 12, y + wy + 30, 144, "PLATE", wg_o5, base + 500 + if(wg_o5, 0, 1))
                Chip(x + 164, y + wy + 30, 144, "WHEEL VOLUME", wg_o6, base + 600 + if(wg_o6, 0, 1))
                Chip(x + 12, y + wy + 60, 296, "VISUALISER IN IT", wg_oviz, base + if(wg_oviz, 922, 921))
                // D217: how it meets the wallpaper while below — news pushes up through the picture
                Chip(x + 12, y + wy + 90, 296, "PUSHES UP THROUGH THE PICTURE", wg_omeet, base + if(wg_omeet, 944, 945))
            }
            // D217: the clock sweeps a light over its place at the hour; the notices push up through the picture
            group {
                show: wg_sk == 2
                Chip(x + 12, y + wy + 30, 296, "MOVES THE WALLPAPER", wg_omeet, base + if(wg_omeet, 944, 945))
            }
            group {
                show: wg_sk == 12
                Chip(x + 12, y + wy + 30, 296, "PUSHES UP THROUGH THE PICTURE", wg_omeet, base + if(wg_omeet, 944, 945))
            }
            // the D141 kinds: the plate for all; the timer's length, the photo's folder, the launcher's apps
            group {
                show: wg_sk > 4.5
                Chip(x + 12, y + wy, 96, "PLATE", wg_o5, base + 500 + if(wg_o5, 0, 1))
            }
            // D215: the notices' rows; which controls show, and whether power asks again
            group {
                show: wg_sk == 12
                text "ROWS" { at: x + 116, y + wy + 12; anchor: left center; size: 9; family: "Share Tech Mono"; color: fl.muted }
                Chip(x + 156, y + wy, 34, "3", wg_onr == 3, base + 924)
                Chip(x + 194, y + wy, 34, "4", wg_onr == 4, base + 925)
                Chip(x + 232, y + wy, 34, "5", wg_onr == 5, base + 926)
                Chip(x + 270, y + wy, 38, "6", wg_onr == 6, base + 927)
            }
            group {
                show: wg_sk == 15
                Chip(x + 112, y + wy, 96, "WI-FI", wg_oc1, base + if(wg_oc1, 931, 930))
                Chip(x + 212, y + wy, 96, "BLUETOOTH", wg_oc2, base + if(wg_oc2, 933, 932))
                Chip(x + 12, y + wy + 30, 96, "VOLUME", wg_oc3, base + if(wg_oc3, 935, 934))
                Chip(x + 112, y + wy + 30, 96, "BRIGHTNESS", wg_oc4, base + if(wg_oc4, 937, 936))
                Chip(x + 212, y + wy + 30, 96, "BATTERY", wg_oc5, base + if(wg_oc5, 939, 938))
                Chip(x + 12, y + wy + 60, 96, "POWER", wg_oc6, base + if(wg_oc6, 941, 940))
                Chip(x + 112, y + wy + 60, 196, "POWER ASKS TWICE", wg_ocf, base + if(wg_ocf, 943, 942))
            }
            group {
                show: wg_sk == 8
                Chip(x + 112, y + wy, 62, "15 MIN", wg_omin == 15, base + 913)
                Chip(x + 178, y + wy, 62, "25 MIN", wg_omin == 25, base + 914)
                Chip(x + 244, y + wy, 64, "50 MIN", wg_omin == 50, base + 915)
            }
            group {
                show: wg_sk == 10
                Chip(x + 112, y + wy, 96, "STEP OUT", wg_opop, base + if(wg_opop, 917, 916))
                Chip(x + 212, y + wy, 96, "{wg_oevery} MIN", true, base + 918)
                text "FOLDER" { at: x + 12, y + wy + 42; anchor: left center; size: 9; family: "Share Tech Mono"; color: fl.muted }
                box { from: x + 70, y + wy + 30; size: 238, 24; corner: 4; color: fl.well }
                box { from: x + 70, y + wy + 30; size: 238, 24; corner: 4; stroke: 1; color: fl.trace_dim }
                input wg_folder { at: x + 76, y + wy + 35; width: 226; size: 11; family: "Share Tech Mono"; color: fl.engrave; selection: fl.well; placeholder: "~/Pictures" }
                text "ENTER TO USE IT · A PRESS ON THE PHOTO: THE NEXT" { at: x + 12, y + wy + 70; anchor: left center; size: 8; family: "Share Tech Mono"; color: fl.muted }
            }
            group {
                show: wg_sk == 11
                text "APPS" { at: x + 118, y + wy + 12; anchor: left center; size: 9; family: "Share Tech Mono"; color: fl.muted }
                box { from: x + 150, y + wy; size: 158, 24; corner: 4; color: fl.well }
                box { from: x + 150, y + wy; size: 158, 24; corner: 4; stroke: 1; color: fl.trace_dim }
                input wg_apps { at: x + 156, y + wy + 5; width: 146; size: 11; family: "Share Tech Mono"; color: fl.engrave; selection: fl.well; placeholder: "kitty,zen,code" }
                text "COMMA-SEPARATED · ENTER TO USE THEM" { at: x + 12, y + wy + 40; anchor: left center; size: 8; family: "Share Tech Mono"; color: fl.muted }
            }
            group {
                show: vis
                Chip(x + 12, y + wy, 96, "PLATE", wg_o5, base + 500 + if(wg_o5, 0, 1))
                Chip(x + 112, y + wy, 96, "PEAKS", wg_o7, base + 700 + if(wg_o7, 0, 1))
                Chip(x + 212, y + wy, 96, "REFLECTION", wg_o8, base + 800 + if(wg_o8, 0, 1))
                Chip(x + 12, y + wy + 30, 296, "SQUARE · LEVEL", round(wg_oa) == 0 and round(wg_ol) == 0, base + 923)
                // D217: a playing visualiser ripples the wallpaper round its place
                Chip(x + 12, y + wy + 60, 296, "MOVES THE WALLPAPER", wg_omeet, base + if(wg_omeet, 944, 945))
            }
            // 5 · where it is, and what can be done to it
            text wg_readout { at: x + 12, y + ay + 8; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.engrave; width: 296; lines: 1 }
            Chip(x + 12, y + ay + 24, 96, pick(wg_olk, "LOCK", "UNLOCK"), wg_olk, base + 903)
            Chip(x + 112, y + ay + 24, 96, "DUPLICATE", false, base + 901)
            Chip(x + 212, y + ay + 24, 96, "REMOVE", false, base + 902)
            // the wallpaper (D139): read against it, sit behind its subject, or move off it
            Chip(x + 12, y + ay + 54, 96, "ADAPT", wg_oad, base + if(wg_oad, 906, 905))
            Chip(x + 112, y + ay + 54, 96, "BEHIND", wg_obh, base + if(wg_obh, 908, 907))
            Chip(x + 212, y + ay + 54, 96, "CALM SPOT", false, base + 904)
        }
    }

    // ── Clocks (D140) ──────────────────────────────────────────
    // The time from the logic (ck_*), once a second; the hands glide on the scene's springs
    // (ck_ha, ck_ma, ck_sa: degrees). Words and accent as the wallpaper under it gives them.

    // A: big digital — the time large, a thin arc of the seconds, the date under it.
    component ClockDigital(x: number, y: number, w: number, h: number, u: number, h24: bool, secs: bool, plate: bool,
                           ink: color = #e6eaee, acc: color = #8fd3c0, hzv: number = 0.32, tnv: number = 0) {
        size: w, h
        Ground(x, y, w, h, u, plate, hzv, tnv)
        text pick(h24, ck_hm12, ck_hm24) { at: x + 22 * u, y + h * 0.44; anchor: left center; size: 72 * u; weight: 600; family: "Exo 2"; color: ink }
        text ck_ampm { at: x + w - 22 * u, y + h * 0.3; anchor: right center; size: 13 * u; family: "Share Tech Mono"; color: acc; show: not h24 }
        text ck_date { at: x + 24 * u, y + h * 0.8; anchor: left center; size: 12 * u; family: "Share Tech Mono"; color: mix(ink, acc, 0.45); width: w - 48 * u; lines: 1 }
        group {
            show: secs
            box { from: x + 24 * u, y + h - 12 * u; size: w - 48 * u, 2 * u; corner: u; color: ink; opacity: 0.15 }
            box { from: x + 24 * u, y + h - 12 * u; size: (w - 48 * u) * ck_s / 59, 2 * u; corner: u; color: acc }
        }
    }

    // B: analogue — a machined dial, ticks, numerals at the quarters, steel hands, a phosphor sweep.
    component ClockAnalogue(x: number, y: number, w: number, h: number, u: number, secs: bool, plate: bool,
                            ink: color = #e6eaee, acc: color = #8fd3c0, hzv: number = 0.32, tnv: number = 0) {
        size: w, h
        let r = min(w, h) / 2 - 6 * u
        let cx = x + w / 2
        let cy = y + h / 2
        group { show: not plate
                blur: 18 * u
                ellipse { at: cx, cy; radius: r; color: if(tnv > 0.5, #ffffff, #000000); opacity: 0.12 + 0.5 * hzv } }
        ellipse { at: cx, cy; radius: r; color: fl.hull; opacity: 0.85; show: plate }
        ellipse { at: cx, cy; radius: r; stroke: 1.5 * u; color: mix(ink, fl.steel_500, 0.4); opacity: 0.8 }
        repeat t in 0..60 {
            let big = mod(t, 5) == 0
            line { from: cx + sin(t * 6) * r * if(big, 0.84, 0.9), cy - cos(t * 6) * r * if(big, 0.84, 0.9); to: cx + sin(t * 6) * r * 0.95, cy - cos(t * 6) * r * 0.95
                   width: if(big, 2, 1) * u; color: ink; opacity: if(big, 0.9, 0.4) }
        }
        text "12" { at: cx, cy - r * 0.68; anchor: center; align: center; size: 14 * u; weight: 600; family: "Exo 2"; color: ink }
        text "3" { at: cx + r * 0.68, cy; anchor: center; align: center; size: 14 * u; weight: 600; family: "Exo 2"; color: ink }
        text "6" { at: cx, cy + r * 0.68; anchor: center; align: center; size: 14 * u; weight: 600; family: "Exo 2"; color: ink }
        text "9" { at: cx - r * 0.68, cy; anchor: center; align: center; size: 14 * u; weight: 600; family: "Exo 2"; color: ink }
        group { pivot: cx, cy; rotate: ck_ha * 1deg
                line { from: cx, cy + r * 0.08; to: cx, cy - r * 0.5; width: 5 * u; color: mix(ink, fl.steel_300, 0.3) } }
        group { pivot: cx, cy; rotate: ck_ma * 1deg
                line { from: cx, cy + r * 0.1; to: cx, cy - r * 0.76; width: 3 * u; color: ink } }
        // while music plays the second hand breathes with the bass (vb0, vb1: the bar's feed) and
        // flashes on a beat
        let bass = if(np_playing, clamp((vb0 + vb1) * 0.6 + np_beat * 0.4, 0, 1), 0)
        group { pivot: cx, cy; rotate: ck_sa * 1deg; show: secs
                glow: (6 + 10 * bass) * u, 0.6 + 0.4 * bass, acc
                line { from: cx, cy + r * 0.16; to: cx, cy - r * 0.86; width: (1.4 + 2.2 * bass) * u; color: mix(acc, #ffffff, 0.35 * bass) } }
        ellipse { at: cx, cy; radius: (4 + 3 * bass) * u; color: acc }
    }

    // C: words — the time written out, the date in a thin mono line.
    component ClockWords(x: number, y: number, w: number, h: number, u: number, plate: bool,
                         ink: color = #e6eaee, acc: color = #8fd3c0, hzv: number = 0.32, tnv: number = 0) {
        size: w, h
        Ground(x, y, w, h, u, plate, hzv, tnv)
        text ck_words { at: x + 22 * u, y + h * 0.42; anchor: left center; size: 30 * u; weight: 300; family: "Exo 2"; color: ink; width: w - 44 * u; lines: 2 }
        text "{ck_date}  ·  {ck_hm24}" { at: x + 24 * u, y + h * 0.82; anchor: left center; size: 11 * u; family: "Share Tech Mono"; color: mix(ink, acc, 0.5); width: w - 48 * u; lines: 1 }
    }

    // D: info — the time and date, and a strip: the weather, the battery, the board's next due, the week.
    component ClockInfo(x: number, y: number, w: number, h: number, u: number, h24: bool, plate: bool,
                        ink: color = #e6eaee, acc: color = #8fd3c0, hzv: number = 0.32, tnv: number = 0) {
        size: w, h
        Ground(x, y, w, h, u, plate, hzv, tnv)
        text pick(h24, ck_hm12, ck_hm24) { at: x + 20 * u, y + 46 * u; anchor: left center; size: 48 * u; weight: 600; family: "Exo 2"; color: ink }
        text ck_date { at: x + w - 20 * u, y + 34 * u; anchor: right center; size: 11 * u; family: "Share Tech Mono"; color: mix(ink, acc, 0.45); width: w * 0.5; lines: 1; align: right }
        text ck_week { at: x + w - 20 * u, y + 54 * u; anchor: right center; size: 10 * u; family: "Share Tech Mono"; color: acc }
        box { from: x + 20 * u, y + 84 * u; size: w - 40 * u, 1; color: ink; opacity: 0.2 }
        // the weather (its symbol, the temperature, what it is doing, the day's high and low) and the battery
        group {
            show: ck_wx_on
            WxIcon(x + 38 * u, y + 110 * u, 40 * u, ck_wkind, ink, acc)
            text "{ck_wx}" { at: x + 64 * u, y + 104 * u; anchor: left center; size: 22 * u; weight: 600; family: "Exo 2"; color: ink }
            text ck_wword { at: x + 64 * u, y + 124 * u; anchor: left center; size: 9 * u; family: "Share Tech Mono"; color: mix(ink, acc, 0.45); width: w * 0.36; lines: 1 }
            text ck_wxhl { at: x + 130 * u, y + 104 * u; anchor: left center; size: 11 * u; family: "Share Tech Mono"; color: mix(ink, acc, 0.45) }
        }
        group {
            show: ck_bat_on
            BatIcon(x + w - 112 * u, y + 102 * u, 15 * u, ck_bat, ck_chg, ink, acc)
            text "{ck_bat}%" { at: x + w - 20 * u, y + 110 * u; anchor: right center; size: 12 * u; weight: 600; family: "Share Tech Mono"; color: ink }
            text pick(ck_chg, "BATTERY", "CHARGING") { at: x + w - 20 * u, y + 126 * u; anchor: right center; size: 8 * u; family: "Share Tech Mono"; color: mix(ink, acc, 0.45) }
        }
        // the board's next card due
        text ck_due { at: x + 20 * u, y + h - 24 * u; anchor: left center; size: 11 * u; family: "Share Tech Mono"; color: acc; width: w - 40 * u; lines: 1 }
    }

    // ── Notes (D140): mooi's quick notes; a row pressed is changed where it is ──
    component NotesList(x: number, y: number, w: number, h: number, u: number, plate: bool,
                        ink: color = #e6eaee, acc: color = #8fd3c0, hzv: number = 0.32, tnv: number = 0) {
        size: w, h
        let rh = 30 * u
        let n = floor((h - 64 * u) / rh)
        Ground(x, y, w, h, u, plate, hzv, tnv)
        text "NOTES" { at: x + 16 * u, y + 20 * u; anchor: left center; size: 11 * u; weight: 700; family: "Share Tech Mono"; color: acc }
        zone box nadd { from: x + w - 76 * u, y + 8 * u; size: 62 * u, 24 * u; cursor: pointer; role: button; label: "Add a note"; show: not editing }
        box { from: x + w - 76 * u, y + 8 * u; size: 62 * u, 24 * u; corner: 4 * u; color: ink; opacity: 0.08 + 0.12 * nadd.hover }
        text "+ NOTE" { at: x + w - 45 * u, y + 20 * u; anchor: center; align: center; size: 10 * u; weight: 700; family: "Share Tech Mono"; color: ink }
        on press nadd { emit nt_edit(-1) }
        // the field, over the row being changed (or the top, for a new one)
        group {
            show: nt_ed > -1.5
            box { from: x + 10 * u, y + 40 * u; size: w - 20 * u, rh - 2 * u; corner: 4 * u; color: fl.hull; opacity: 0.9 }
            box { from: x + 10 * u, y + 40 * u; size: w - 20 * u, rh - 2 * u; corner: 4 * u; stroke: 1; color: acc }
            input nt_draft { at: x + 18 * u, y + 47 * u; width: w - 36 * u; size: 13; family: "Exo 2"; color: fl.engrave; selection: fl.well; placeholder: "A note…" }
            on nt_focus { focus nt_draft }
            on key Escape while nt_ed > -1.5 { emit nt_cancel }
        }
        for t in nt {
            let ry = y + 40 * u + (t.index + if(nt_ed > -1.5, 1, 0)) * rh
            group {
                show: t.index < n and nt_ed != t.id
                zone box nrow { from: x + 10 * u, ry; size: w - 96 * u, rh - 2 * u; cursor: text; role: button; label: "Change: {t.text}"; show: not editing }
                box { from: x + 10 * u, ry; size: w - 20 * u, rh - 2 * u; corner: 4 * u; color: ink; opacity: 0.06 * nrow.hover }
                box { from: x + 12 * u, ry + 9 * u; size: 3 * u, rh - 20 * u; corner: u; color: acc; show: t.pinned }
                text t.text { at: x + 22 * u, ry + rh / 2; anchor: left center; size: 13 * u; family: "Exo 2"; color: ink; opacity: if(t.done, 0.45, 1)
                              width: w - 130 * u; lines: 1 }
                text t.ago { at: x + w - 92 * u, ry + rh / 2; anchor: right center; size: 9 * u; family: "Share Tech Mono"; color: mix(ink, acc, 0.4); opacity: 1 - nrow.hover }
                on press nrow { emit nt_edit(t.id) }
                // pin, done, forget: at the row's end, lit while the row is pointed at
                zone box npin { from: x + w - 86 * u, ry + 3 * u; size: 22 * u, rh - 8 * u; cursor: pointer; role: button; label: "Pin"; show: not editing }
                zone box ndone { from: x + w - 62 * u, ry + 3 * u; size: 22 * u, rh - 8 * u; cursor: pointer; role: button; label: "Done"; show: not editing }
                zone box ndel { from: x + w - 38 * u, ry + 3 * u; size: 22 * u, rh - 8 * u; cursor: pointer; role: button; label: "Forget"; show: not editing }
                group {
                    opacity: max(nrow.hover, max(npin.hover, max(ndone.hover, ndel.hover)))
                    text "⌖" { at: x + w - 75 * u, ry + rh / 2; anchor: center; align: center; size: 12 * u; color: if(t.pinned, acc, ink) }
                    text "✓" { at: x + w - 51 * u, ry + rh / 2; anchor: center; align: center; size: 12 * u; color: if(t.done, acc, ink) }
                    text "×" { at: x + w - 27 * u, ry + rh / 2; anchor: center; align: center; size: 13 * u; color: ink }
                    on press npin { emit nt_pin(t.id) }
                    on press ndone { emit nt_done(t.id) }
                    on press ndel { emit nt_del(t.id) }
                }
            }
        }
        text "+{nt_count - n} MORE" { at: x + 16 * u, y + h - 14 * u; anchor: left center; size: 9 * u; family: "Share Tech Mono"; color: mix(ink, acc, 0.4); show: nt_count > n }
        text "NO NOTES YET · + NOTE TO WRITE ONE" { at: x + 16 * u, y + 60 * u; anchor: left center; size: 10 * u; family: "Share Tech Mono"; color: mix(ink, acc, 0.4); show: nt_count == 0 and nt_ed < -1.5 }
    }

    // The visualiser: one of the twelve (lib/widgets MODES), in the palette's two signal colours,
    // with a glow of its own (0 … 1). Stillness is the scene's (`viz_still`).
    component Visualiser(x: number, y: number, w: number, h: number, u: number, mode: number, glow: number, plate: bool) {
        size: w, h
        let t1 = fl.phos
        let t2 = fl.ember
        let cr = min(w, h) * 0.3
        box { from: x, y; size: w, h; corner: 6 * u; color: fl.hull; opacity: 0.7; show: plate }
        group {
            group { glow: min(10 * u, 12), glow, t1; show: mode < 0.5
                    viz.Spectrum(x, y, w, h, t1, t2, viz_still) }
            group { glow: min(10 * u, 12), glow, t1; show: mode > 0.5 and mode < 1.5
                    viz.Mirror(x, y, w, h, t1, t2, viz_still) }
            group { glow: min(10 * u, 12), glow, t1; show: mode > 1.5 and mode < 2.5
                    viz.Ring(x + w / 2, y + h / 2, cr, min(w, h) * 0.18, t1, t2, viz_still) }
            group { show: mode > 2.5 and mode < 3.5
                    viz.Aurora(x, y, w, h, t1, t2, np_turn, viz_still) }
            group { glow: min(10 * u, 12), glow, t1; show: mode > 3.5 and mode < 4.5
                    viz.LED(x, y, w, h, t1, t2, fl.trace_dim, viz_still) }
            group { glow: min(10 * u, 12), glow, t1; show: mode > 4.5 and mode < 5.5
                    viz.Orbit(x, y, w, h, t1, t2, fl.trace_dim, np_turn, viz_still) }
            group { glow: min(10 * u, 12), glow, t1; show: mode > 5.5 and mode < 6.5
                    viz.Scope(x, y, w, h, t1, t2, viz_still, np_turn, 40, 90) }
            group { show: mode > 6.5 and mode < 7.5
                    viz.Horizon(x, y, w, h, t1, t2, viz_still, np_turn) }
            group { glow: min(10 * u, 12), glow, t1; show: mode > 7.5 and mode < 8.5
                    viz.Dust(x, y, w, h, t1, t2, viz_still, np_scatter, np_turn) }
            group { glow: min(10 * u, 12), glow, t1; show: mode > 8.5 and mode < 9.5
                    viz.Ripple(x, y, w, h, t1, t2, viz_still, rp_r0, rp_a0, rp_r1, rp_a1, rp_r2, rp_a2, rp_r3, rp_a3) }
            group { glow: min(10 * u, 12), glow, t1; show: mode > 9.5 and mode < 10.5
                    viz.Skyline(x, y, w, h, t1, t2, viz_still) }
            group { show: mode > 10.5
                    viz.Liquid(x, y, w, h, t1, t2, viz_still, np_turn) }
        }
    }
}
