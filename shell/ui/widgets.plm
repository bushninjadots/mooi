language 0.9

// The desktop widgets' looks (D137): Now Playing in three layouts and the Visualiser. Every size
// is the layout's own times `u` (lib/widgets.scale), so a bigger widget is the same widget larger.
// No card unless `plate`: a soft dark haze behind the words keeps them readable on any picture.
// They read the scene's now-playing facts (np_*), its cover image and its record's springs.

import "viz.plm" as viz

library Widgets {
    // A soft dark haze, or the plate when asked for one: what any widget stands on.
    component Ground(x: number, y: number, w: number, h: number, u: number, plate: bool, hzv: number = 0.32, tnv: number = 0) {
        size: w, h
        // the haze follows the wallpaper under it (D139): stronger over detail; light behind dark words
        group { show: not plate
                blur: 22 * u
                box { from: x + 10 * u, y + 10 * u; size: w - 20 * u, h - 20 * u; corner: 12 * u; color: if(tnv > 0.5, #ffffff, #000000); opacity: 0.12 + 0.55 * hzv } }
        box { from: x, y; size: w, h; corner: 6 * u; color: fl.hull; opacity: 0.78; show: plate }
        box { from: x, y; size: w, h; corner: 6 * u; stroke: 1; color: fl.trace_dim; opacity: 0.9; show: plate }
    }

    // The cover, square, with a lit rim; the placeholder glyph when there is none.
    component Cover(x: number, y: number, s: number, u: number) {
        size: s, s
        box { from: x, y; size: s, s; corner: 4 * u; color: fl.well }
        text "♪" { at: x + s / 2, y + s / 2; anchor: center; align: center; size: s * 0.38; family: "Exo 2"; color: fl.trace; show: not np_cover_on }
        image cover { at: x, y; size: s, s; show: np_cover_on }
        box { from: x, y; size: s, s; corner: 4 * u; stroke: 1.2; color: fl.trace_lit; opacity: 0.55 }
    }

    // The hands, shown while the widget is pointed at (`hv` 0 … 1): previous, play or pause, next.
    // Their zones exist only while shown, so a calm widget takes no clicks.
    component Controls(cx: number, cy: number, u: number, k: number, hv: number) {
        size: 96 * u, 28 * u
        let bs = 26 * u
        group {
            opacity: hv
            repeat b in 0..3 {
                let bx = cx + (b - 1) * (bs + 6 * u)
                box { from: bx - bs / 2, cy - bs / 2; size: bs, bs; corner: bs / 2; color: fl.hull; opacity: 0.85 }
                box { from: bx - bs / 2, cy - bs / 2; size: bs, bs; corner: bs / 2; stroke: 1; color: fl.trace_lit; opacity: 0.7 }
            }
            let g = 5 * u
            // previous: a bar and a triangle pointing left
            box { from: cx - bs - 6 * u - g, cy - g; size: 1.6 * u, 2 * g; color: fl.engrave }
            path { color: fl.engrave
                   move cx - bs - 6 * u - g + 2 * u, cy; line cx - bs - 6 * u + g, cy - g; line cx - bs - 6 * u + g, cy + g; close }
            // play, or pause while playing
            path { color: fl.phos; show: not np_playing
                   move cx - g * 0.7, cy - g; line cx + g, cy; line cx - g * 0.7, cy + g; close }
            box { from: cx - g * 0.8, cy - g; size: g * 0.55, 2 * g; color: fl.phos; show: np_playing }
            box { from: cx + g * 0.25, cy - g; size: g * 0.55, 2 * g; color: fl.phos; show: np_playing }
            // next: a triangle pointing right and a bar
            path { color: fl.engrave
                   move cx + bs + 6 * u - g, cy - g; line cx + bs + 6 * u + g - 2 * u, cy; line cx + bs + 6 * u - g, cy + g; close }
            box { from: cx + bs + 6 * u + g - 1.6 * u, cy - g; size: 1.6 * u, 2 * g; color: fl.engrave }
        }
        zone box cprev { from: cx - 1.5 * bs - 6 * u, cy - bs / 2; size: bs, bs; cursor: pointer; role: button; label: "Previous"; show: pick(k, hl0, hl1, hl2, hl3, hl4, hl5, hl6, hl7) > 0.5 and not editing }
        zone box cplay { from: cx - bs / 2, cy - bs / 2; size: bs, bs; cursor: pointer; role: button; label: "Play or pause"; show: pick(k, hl0, hl1, hl2, hl3, hl4, hl5, hl6, hl7) > 0.5 and not editing }
        zone box cnext { from: cx + bs / 2 + 6 * u, cy - bs / 2; size: bs, bs; cursor: pointer; role: button; label: "Next"; show: pick(k, hl0, hl1, hl2, hl3, hl4, hl5, hl6, hl7) > 0.5 and not editing }
        on press cprev { emit wg_ctl(k * 10) }
        on press cplay { emit wg_ctl(k * 10 + 1) }
        on press cnext { emit wg_ctl(k * 10 + 2) }
    }

    // A seekable progress trace: thin, a little thicker while pointed at.
    component Progress(x: number, y: number, w: number, u: number, k: number, hv: number) {
        size: w, 10 * u
        box { from: x, y - (1 + hv) * u; size: w, (2 + 2 * hv) * u; color: fl.trace_dim; opacity: 0.8 }
        box { from: x, y - (1 + hv) * u; size: w * clamp(np_prg, 0, 1), (2 + 2 * hv) * u; color: fl.phos }
        zone box pseek { from: x, y - 6 * u; size: w, 12 * u; cursor: pointer; role: slider; label: "Seek"; show: pick(k, hl0, hl1, hl2, hl3, hl4, hl5, hl6, hl7) > 0.5 and not editing }
        on press pseek { emit wg_seek(k * 1000 + round(clamp((local.x - x) / w, 0, 1) * 999)) }
    }

    // What the cover does: opens mooi's player; the wheel over it is the volume.
    component CoverZone(x: number, y: number, w: number, h: number, k: number) {
        size: w, h
        zone box cz { from: x, y; size: w, h; cursor: pointer; role: button; label: "Open the player"; show: not editing }
        on press cz { emit wg_open(k) }
        on scroll cz { emit wg_vol(k * 10 + if(wheel > 0, 1, 0)) }
    }

    // A widget resting as a small engraved mark where it sat: a press opens the player.
    component Marker(x: number, y: number, u: number, k: number) {
        size: 28 * u, 28 * u
        ellipse { at: x + 14 * u, y + 14 * u; radius: 13 * u; color: fl.hull; opacity: 0.7 }
        ellipse { at: x + 14 * u, y + 14 * u; radius: 13 * u; stroke: 1; color: fl.trace_lit; opacity: 0.8 }
        text "♪" { at: x + 14 * u, y + 14 * u; anchor: center; align: center; size: 14 * u; family: "Exo 2"; color: fl.phos }
        zone box mz { from: x, y; size: 28 * u, 28 * u; cursor: pointer; role: button; label: "Open the player" }
        on press mz { emit wg_open(k) }
    }

    // A: the sleeve — the cover, then the title, the artist, the line being sung and the progress.
    component Sleeve(x: number, y: number, w: number, h: number, u: number, lyr: bool, prog: bool, plate: bool, k: number, hv: number, ts: number = 1, ink: color = #e6eaee, acc: color = #8fd3c0, hzv: number = 0.32, tnv: number = 0) {
        size: w, h
        let pad = 14 * u
        let cs = h - 2 * pad
        let tx = x + pad + cs + 16 * u
        let tw = max(10, x + w - pad - tx)
        Ground(x, y, w, h, u, plate, hzv, tnv)
        Cover(x + pad, y + pad, cs, u)
        text pick(np_has, "NOTHING PLAYING", np_title) { at: tx, y + pad + 12 * u; anchor: left center; size: 20 * u * ts; weight: 700; family: "Exo 2"
              width: tw; lines: 1; color: ink }
        text np_artist { at: tx, y + pad + 36 * u; anchor: left center; size: 12 * u * ts; family: "Share Tech Mono"; width: tw; lines: 1; color: mix(ink, acc, 0.45) }
        group {
            show: lyr and np_sung
            opacity: np_lf
            text np_line { at: tx, y + pad + 64 * u; anchor: left center; size: 14 * u * ts; family: "Exo 2"; width: tw; lines: 1; color: acc }
        }
        group { show: prog and np_has
                Progress(tx, y + h - pad - 1 * u, tw, u, k, hv) }
        CoverZone(x + pad, y + pad, cs, cs, k)
        Controls(x + pad + cs / 2, y + pad + cs / 2, u * 0.9, k, hv)
    }

    // B: the lyric stage — the line being sung large and centred, the ones either side faded, the
    // cover and the title as a caption. Without synced lyrics, the title takes the stage.
    component LyricStage(x: number, y: number, w: number, h: number, u: number, plate: bool, k: number, hv: number, ts: number = 1, ink: color = #e6eaee, acc: color = #8fd3c0, hzv: number = 0.32, tnv: number = 0) {
        size: w, h
        let cx = x + w / 2
        let lw = w - 64 * u
        let sung = np_sung
        Ground(x, y, w, h, u, plate, hzv, tnv)
        text np_prev { at: cx, y + h * 0.2; anchor: center; align: center; size: 17 * u * ts; family: "Exo 2"; width: lw; lines: 1; color: mix(ink, acc, 0.45); opacity: 0.45; show: sung }
        group {
            opacity: if(sung, np_lf, 1)
            text np_line { at: cx, y + h * 0.48; anchor: center; align: center; size: 34 * u * ts; weight: 600; family: "Exo 2"
                  width: lw; lines: 2; color: ink; show: sung }
            text pick(np_has, "NOTHING PLAYING", np_title) { at: cx, y + h * 0.48; anchor: center; align: center; size: 34 * u * ts; weight: 600; family: "Exo 2"
                  width: lw; lines: 2; color: ink; show: not sung }
        }
        text np_next { at: cx, y + h * 0.76; anchor: center; align: center; size: 17 * u * ts; family: "Exo 2"; width: lw; lines: 1; color: mix(ink, acc, 0.45); opacity: 0.45; show: sung }
        Cover(x + 16 * u, y + h - 44 * u, 28 * u, u)
        CoverZone(x + 16 * u, y + h - 44 * u, 28 * u, 28 * u, k)
        Controls(x + w - 64 * u, y + h - 30 * u, u * 0.8, k, hv)
        text "{np_title}  ·  {np_artist}" { at: x + 52 * u, y + h - 30 * u; anchor: left center; size: 11 * u * ts; family: "Share Tech Mono"
              width: w - 72 * u; lines: 1; color: mix(ink, acc, 0.3); opacity: 0.8; show: np_has and sung }
    }

    // C: the record — the cover as its label, turning at 33⅓ while it plays, the tonearm on the
    // song; the title and the artist under it.
    component Record(x: number, y: number, w: number, h: number, u: number, plate: bool, prog: bool, k: number, hv: number, ts: number = 1, ink: color = #e6eaee, acc: color = #8fd3c0, hzv: number = 0.32, tnv: number = 0) {
        size: w, h
        let r = w * 0.44
        let rcx = x + w / 2
        let rcy = y + w * 0.5
        let rl = r * 0.36
        let px = x + w * 0.9
        let py = y + w * 0.1
        Ground(x, y, w, h, u, plate, hzv, tnv)
        ellipse { at: rcx, rcy; radius: r; color: #0d0f11 }
        repeat g in 0..7 {
            ellipse { at: rcx, rcy; radius: rl + 6 * u + g * (r - rl - 10 * u) / 6; stroke: 0.8; color: #23272b; opacity: 0.9 }
        }
        ellipse { at: rcx, rcy; radius: r; stroke: 1.5; color: fl.steel_700 }
        group {
            pivot: rcx, rcy
            rotate: np_vang * 1deg
            mask: radial rcx, rcy radius rl - 1 to rl
            box { from: rcx - rl, rcy - rl; size: rl * 2, rl * 2; color: mix(fl.ember_fill, fl.hull, 0.3) }
            image cover { at: rcx - rl, rcy - rl; size: rl * 2, rl * 2; show: np_cover_on }
        }
        ellipse { at: rcx, rcy; radius: 3 * u; color: fl.steel_300 }
        ellipse { at: px, py; radius: 9 * u; color: fl.steel_700 }
        group {
            pivot: px, py
            rotate: np_arm * 1deg
            line { from: px, py; to: px, py + r * 1.05; width: 3 * u; color: fl.steel_300 }
            line { from: px, py + r * 1.05; to: px - 7 * u, py + r * 1.2; width: 3 * u; color: fl.steel_300 }
        }
        text pick(np_has, "NOTHING PLAYING", np_title) { at: rcx, y + w + 16 * u; anchor: center; align: center; size: 17 * u * ts; weight: 700; family: "Exo 2"
              width: w - 16 * u; lines: 1; color: ink }
        text np_artist { at: rcx, y + w + 40 * u; anchor: center; align: center; size: 11 * u * ts; family: "Share Tech Mono"; width: w - 16 * u; lines: 1; color: mix(ink, acc, 0.45) }
        group { show: prog and np_has
                Progress(x + 24 * u, y + w + 60 * u, w - 48 * u, u, k, hv) }
        CoverZone(rcx - rl, rcy - rl, rl * 2, rl * 2, k)
        Controls(rcx, rcy + r * 0.62, u, k, hv)
    }

    // ── Edit mode (mooi widgets edit) ──────────────────────────────

    // A small engraved chip: a choice, a switch or an action, sending its code to the logic.
    component Chip(x: number, y: number, w: number, word: text, on: bool, code: number) {
        size: w, 24
        zone box ch { from: x, y; size: w, 24; cursor: pointer; role: button; label: word }
        box { from: x, y; size: w, 24; corner: 4; color: if(on, fl.phos_fill, fl.well); opacity: if(on, 0.9, 0.7 + 0.3 * ch.hover) }
        box { from: x, y; size: w, 24; corner: 4; stroke: 1; color: if(on, fl.phos, mix(fl.trace_dim, fl.trace_lit, ch.hover)) }
        text word { at: x + w / 2, y + 12; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"
                    width: w - 6; lines: 1; color: if(on, fl.ink, fl.engrave) }
        on press ch { wg_hold = 0; emit wg_opt(code) }
    }

    // The options beside the chosen widget: its layout or mode, what it does at rest, its
    // switches, and duplicate / remove. `k` is its slot; the logic says what is chosen.
    // A slider: a track, a thumb and its value; pressed or pulled it sends where (0 … 999), live,
    // and its letting go saves it. `which` is the logic's (mooi-widgets.luau wg_slide).
    component WSlider(x: number, y: number, w: number, word: text, shown: text, f: number, k: number, which: number) {
        size: w, 24
        let tx = x + 78
        let tw = w - 78 - 52
        text word { at: x, y + 12; anchor: left center; size: 9; family: "Share Tech Mono"; color: fl.muted; width: 74; lines: 1 }
        zone box sz { from: tx - 6, y; size: tw + 12, 24; cursor: pointer; role: slider; label: word }
        box { from: tx, y + 11; size: tw, 2; corner: 1; color: fl.trace_dim }
        box { from: tx, y + 11; size: tw * clamp(f, 0, 1), 2; corner: 1; color: fl.phos }
        ellipse { at: tx + tw * clamp(f, 0, 1), y + 12; radius: 5 + sz.hover; color: fl.phos }
        text shown { at: x + w, y + 12; anchor: right center; size: 10; family: "Share Tech Mono"; color: fl.engrave; width: 48; lines: 1; align: right }
        on press sz { wg_hold = 3; emit wg_slide(k * 10000 + which * 1000 + round(clamp((local.x - tx) / tw, 0, 1) * 999)) }
        on drag sz while wg_hold == 3 { emit wg_slide(k * 10000 + which * 1000 + round(clamp((local.x - tx) / tw, 0, 1) * 999)) }
        on release sz while wg_hold == 3 { emit wg_slid }
        on scroll sz { emit wg_slide(k * 10000 + which * 1000 + round(clamp(f + if(wheel > 0, 0.04, -0.04), 0, 1) * 999))
                       emit wg_slid }
    }

    // The options of the chosen widget (D138): dragged by its header, folded with ⌄; its layout
    // or mode as live thumbnails, sliders, what it does at rest, its switches, where it is.
    component Panel(x: number, y: number, k: number) {
        size: 320, 520
        let base = k * 1000
        let vis = wg_sk > 0.5
        let sy = if(vis, 186, 122)               // the sliders
        let ns = if(vis, 6, 3)
        let ry = sy + ns * 30 + 8                 // at rest
        let wy = ry + 44                          // the switches
        let ay = wy + if(vis, 40, 70)             // where, and the actions
        let ph = if(wg_pcol, 30, ay + 102)
        box { from: x, y; size: 320, ph; corner: 6; color: fl.hull; opacity: 0.95 }
        box { from: x, y; size: 320, ph; corner: 6; stroke: 1; color: fl.trace_lit; opacity: 0.8 }
        // the header: its title, the fold, and the handle that carries the panel
        zone box phd { from: x, y; size: 284, 30; cursor: grab; role: button; label: "Move the options" }
        on press phd { wg_hold = 2; wg_pbx = x; wg_pby = y }
        on drag phd while wg_hold == 2 { emit wg_pmove(round(clamp(wg_pbx + drag.dx, 0, 4095)) * 4096 + round(clamp(wg_pby + drag.dy, 0, 4095))) }
        text pick(vis, "NOW PLAYING", "VISUALISER") { at: x + 12, y + 16; anchor: left center; size: 11; weight: 700; family: "Share Tech Mono"; color: fl.phos }
        text "{wg_nsel} CHOSEN · THESE ARE THE LAST ONE'S" { at: x + 120, y + 16; anchor: left center; size: 8; family: "Share Tech Mono"; color: fl.muted; show: wg_nsel > 1 }
        zone box pfo { from: x + 288, y + 4; size: 26, 22; cursor: pointer; role: button; label: "Fold the options" }
        text pick(wg_pcol, "⌄", "›") { at: x + 301, y + 15; anchor: center; align: center; size: 14; family: "Exo 2"; color: fl.engrave }
        on press pfo { wg_hold = 0; wg_pcol = not wg_pcol }
        group {
            show: not wg_pcol
            // 1 · the layout, or the mode, as live thumbnails
            group {
                show: not vis
            group {
                zone box tc0 { from: x + 12, y + 36; size: 96, 76; cursor: pointer; role: button; label: "Sleeve" }
                box { from: x + 12, y + 36; size: 96, 76; corner: 4; color: fl.ground; opacity: 0.8 }
                box { from: x + 12, y + 36; size: 96, 76; corner: 4; stroke: if(wg_sl == 0, 1.6, 1); color: if(wg_sl == 0, fl.phos, mix(fl.trace_dim, fl.trace_lit, tc0.hover)) }
                Sleeve(x + 12 + 4, y + 42, 88, 31, 0.2, true, true, false, k, 0)
                text "SLEEVE" { at: x + 12 + 48, y + 104; anchor: center; align: center; size: 8; family: "Share Tech Mono"; color: if(wg_sl == 0, fl.phos, fl.muted) }
                on press tc0 { wg_hold = 0; emit wg_opt(base + 100 + 0) }
            }
            group {
                zone box tc1 { from: x + 112, y + 36; size: 96, 76; cursor: pointer; role: button; label: "Lyrics" }
                box { from: x + 112, y + 36; size: 96, 76; corner: 4; color: fl.ground; opacity: 0.8 }
                box { from: x + 112, y + 36; size: 96, 76; corner: 4; stroke: if(wg_sl == 1, 1.6, 1); color: if(wg_sl == 1, fl.phos, mix(fl.trace_dim, fl.trace_lit, tc1.hover)) }
                LyricStage(x + 112 + 4, y + 42, 88, 22, 0.092, false, k, 0)
                text "LYRICS" { at: x + 112 + 48, y + 104; anchor: center; align: center; size: 8; family: "Share Tech Mono"; color: if(wg_sl == 1, fl.phos, fl.muted) }
                on press tc1 { wg_hold = 0; emit wg_opt(base + 100 + 1) }
            }
            group {
                zone box tc2 { from: x + 212, y + 36; size: 96, 76; cursor: pointer; role: button; label: "Record" }
                box { from: x + 212, y + 36; size: 96, 76; corner: 4; color: fl.ground; opacity: 0.8 }
                box { from: x + 212, y + 36; size: 96, 76; corner: 4; stroke: if(wg_sl == 2, 1.6, 1); color: if(wg_sl == 2, fl.phos, mix(fl.trace_dim, fl.trace_lit, tc2.hover)) }
                Record(x + 212 + 26, y + 40, 44, 56, 0.157, false, false, k, 0)
                text "RECORD" { at: x + 212 + 48, y + 104; anchor: center; align: center; size: 8; family: "Share Tech Mono"; color: if(wg_sl == 2, fl.phos, fl.muted) }
                on press tc2 { wg_hold = 0; emit wg_opt(base + 100 + 2) }
            }
            }
            group {
                show: vis
            group {
                zone box th0 { from: x + 12, y + 36 + 0 * 48; size: 72, 44; cursor: pointer; role: button; label: "Spectrum" }
                box { from: x + 12, y + 36 + 0 * 48; size: 72, 44; corner: 4; color: fl.ground; opacity: 0.8 }
                box { from: x + 12, y + 36 + 0 * 48; size: 72, 44; corner: 4; stroke: if(wg_sm == 0, 1.6, 1); color: if(wg_sm == 0, fl.phos, mix(fl.trace_dim, fl.trace_lit, th0.hover)) }
                Visualiser(x + 12 + 4, y + 36 + 0 * 48 + 3, 64, 28, 0.15, 0, 0, false)
                text "SPECTRUM" { at: x + 12 + 36, y + 36 + 0 * 48 + 38; anchor: center; align: center; size: 8; family: "Share Tech Mono"; color: if(wg_sm == 0, fl.phos, fl.muted) }
                on press th0 { wg_hold = 0; emit wg_opt(base + 100 + 0) }
            }
            group {
                zone box th1 { from: x + 88, y + 36 + 0 * 48; size: 72, 44; cursor: pointer; role: button; label: "Mirror" }
                box { from: x + 88, y + 36 + 0 * 48; size: 72, 44; corner: 4; color: fl.ground; opacity: 0.8 }
                box { from: x + 88, y + 36 + 0 * 48; size: 72, 44; corner: 4; stroke: if(wg_sm == 1, 1.6, 1); color: if(wg_sm == 1, fl.phos, mix(fl.trace_dim, fl.trace_lit, th1.hover)) }
                Visualiser(x + 88 + 4, y + 36 + 0 * 48 + 3, 64, 28, 0.15, 1, 0, false)
                text "MIRROR" { at: x + 88 + 36, y + 36 + 0 * 48 + 38; anchor: center; align: center; size: 8; family: "Share Tech Mono"; color: if(wg_sm == 1, fl.phos, fl.muted) }
                on press th1 { wg_hold = 0; emit wg_opt(base + 100 + 1) }
            }
            group {
                zone box th2 { from: x + 164, y + 36 + 0 * 48; size: 72, 44; cursor: pointer; role: button; label: "Ring" }
                box { from: x + 164, y + 36 + 0 * 48; size: 72, 44; corner: 4; color: fl.ground; opacity: 0.8 }
                box { from: x + 164, y + 36 + 0 * 48; size: 72, 44; corner: 4; stroke: if(wg_sm == 2, 1.6, 1); color: if(wg_sm == 2, fl.phos, mix(fl.trace_dim, fl.trace_lit, th2.hover)) }
                Visualiser(x + 164 + 4, y + 36 + 0 * 48 + 3, 64, 28, 0.15, 2, 0, false)
                text "RING" { at: x + 164 + 36, y + 36 + 0 * 48 + 38; anchor: center; align: center; size: 8; family: "Share Tech Mono"; color: if(wg_sm == 2, fl.phos, fl.muted) }
                on press th2 { wg_hold = 0; emit wg_opt(base + 100 + 2) }
            }
            group {
                zone box th3 { from: x + 240, y + 36 + 0 * 48; size: 72, 44; cursor: pointer; role: button; label: "Aurora" }
                box { from: x + 240, y + 36 + 0 * 48; size: 72, 44; corner: 4; color: fl.ground; opacity: 0.8 }
                box { from: x + 240, y + 36 + 0 * 48; size: 72, 44; corner: 4; stroke: if(wg_sm == 3, 1.6, 1); color: if(wg_sm == 3, fl.phos, mix(fl.trace_dim, fl.trace_lit, th3.hover)) }
                Visualiser(x + 240 + 4, y + 36 + 0 * 48 + 3, 64, 28, 0.15, 3, 0, false)
                text "AURORA" { at: x + 240 + 36, y + 36 + 0 * 48 + 38; anchor: center; align: center; size: 8; family: "Share Tech Mono"; color: if(wg_sm == 3, fl.phos, fl.muted) }
                on press th3 { wg_hold = 0; emit wg_opt(base + 100 + 3) }
            }
            group {
                zone box th4 { from: x + 12, y + 36 + 1 * 48; size: 72, 44; cursor: pointer; role: button; label: "Led" }
                box { from: x + 12, y + 36 + 1 * 48; size: 72, 44; corner: 4; color: fl.ground; opacity: 0.8 }
                box { from: x + 12, y + 36 + 1 * 48; size: 72, 44; corner: 4; stroke: if(wg_sm == 4, 1.6, 1); color: if(wg_sm == 4, fl.phos, mix(fl.trace_dim, fl.trace_lit, th4.hover)) }
                Visualiser(x + 12 + 4, y + 36 + 1 * 48 + 3, 64, 28, 0.15, 4, 0, false)
                text "LED" { at: x + 12 + 36, y + 36 + 1 * 48 + 38; anchor: center; align: center; size: 8; family: "Share Tech Mono"; color: if(wg_sm == 4, fl.phos, fl.muted) }
                on press th4 { wg_hold = 0; emit wg_opt(base + 100 + 4) }
            }
            group {
                zone box th5 { from: x + 88, y + 36 + 1 * 48; size: 72, 44; cursor: pointer; role: button; label: "Orbit" }
                box { from: x + 88, y + 36 + 1 * 48; size: 72, 44; corner: 4; color: fl.ground; opacity: 0.8 }
                box { from: x + 88, y + 36 + 1 * 48; size: 72, 44; corner: 4; stroke: if(wg_sm == 5, 1.6, 1); color: if(wg_sm == 5, fl.phos, mix(fl.trace_dim, fl.trace_lit, th5.hover)) }
                Visualiser(x + 88 + 4, y + 36 + 1 * 48 + 3, 64, 28, 0.15, 5, 0, false)
                text "ORBIT" { at: x + 88 + 36, y + 36 + 1 * 48 + 38; anchor: center; align: center; size: 8; family: "Share Tech Mono"; color: if(wg_sm == 5, fl.phos, fl.muted) }
                on press th5 { wg_hold = 0; emit wg_opt(base + 100 + 5) }
            }
            group {
                zone box th6 { from: x + 164, y + 36 + 1 * 48; size: 72, 44; cursor: pointer; role: button; label: "Scope" }
                box { from: x + 164, y + 36 + 1 * 48; size: 72, 44; corner: 4; color: fl.ground; opacity: 0.8 }
                box { from: x + 164, y + 36 + 1 * 48; size: 72, 44; corner: 4; stroke: if(wg_sm == 6, 1.6, 1); color: if(wg_sm == 6, fl.phos, mix(fl.trace_dim, fl.trace_lit, th6.hover)) }
                Visualiser(x + 164 + 4, y + 36 + 1 * 48 + 3, 64, 28, 0.15, 6, 0, false)
                text "SCOPE" { at: x + 164 + 36, y + 36 + 1 * 48 + 38; anchor: center; align: center; size: 8; family: "Share Tech Mono"; color: if(wg_sm == 6, fl.phos, fl.muted) }
                on press th6 { wg_hold = 0; emit wg_opt(base + 100 + 6) }
            }
            group {
                zone box th7 { from: x + 240, y + 36 + 1 * 48; size: 72, 44; cursor: pointer; role: button; label: "Horizon" }
                box { from: x + 240, y + 36 + 1 * 48; size: 72, 44; corner: 4; color: fl.ground; opacity: 0.8 }
                box { from: x + 240, y + 36 + 1 * 48; size: 72, 44; corner: 4; stroke: if(wg_sm == 7, 1.6, 1); color: if(wg_sm == 7, fl.phos, mix(fl.trace_dim, fl.trace_lit, th7.hover)) }
                Visualiser(x + 240 + 4, y + 36 + 1 * 48 + 3, 64, 28, 0.15, 7, 0, false)
                text "HORIZON" { at: x + 240 + 36, y + 36 + 1 * 48 + 38; anchor: center; align: center; size: 8; family: "Share Tech Mono"; color: if(wg_sm == 7, fl.phos, fl.muted) }
                on press th7 { wg_hold = 0; emit wg_opt(base + 100 + 7) }
            }
            group {
                zone box th8 { from: x + 12, y + 36 + 2 * 48; size: 72, 44; cursor: pointer; role: button; label: "Dust" }
                box { from: x + 12, y + 36 + 2 * 48; size: 72, 44; corner: 4; color: fl.ground; opacity: 0.8 }
                box { from: x + 12, y + 36 + 2 * 48; size: 72, 44; corner: 4; stroke: if(wg_sm == 8, 1.6, 1); color: if(wg_sm == 8, fl.phos, mix(fl.trace_dim, fl.trace_lit, th8.hover)) }
                Visualiser(x + 12 + 4, y + 36 + 2 * 48 + 3, 64, 28, 0.15, 8, 0, false)
                text "DUST" { at: x + 12 + 36, y + 36 + 2 * 48 + 38; anchor: center; align: center; size: 8; family: "Share Tech Mono"; color: if(wg_sm == 8, fl.phos, fl.muted) }
                on press th8 { wg_hold = 0; emit wg_opt(base + 100 + 8) }
            }
            group {
                zone box th9 { from: x + 88, y + 36 + 2 * 48; size: 72, 44; cursor: pointer; role: button; label: "Ripple" }
                box { from: x + 88, y + 36 + 2 * 48; size: 72, 44; corner: 4; color: fl.ground; opacity: 0.8 }
                box { from: x + 88, y + 36 + 2 * 48; size: 72, 44; corner: 4; stroke: if(wg_sm == 9, 1.6, 1); color: if(wg_sm == 9, fl.phos, mix(fl.trace_dim, fl.trace_lit, th9.hover)) }
                Visualiser(x + 88 + 4, y + 36 + 2 * 48 + 3, 64, 28, 0.15, 9, 0, false)
                text "RIPPLE" { at: x + 88 + 36, y + 36 + 2 * 48 + 38; anchor: center; align: center; size: 8; family: "Share Tech Mono"; color: if(wg_sm == 9, fl.phos, fl.muted) }
                on press th9 { wg_hold = 0; emit wg_opt(base + 100 + 9) }
            }
            group {
                zone box th10 { from: x + 164, y + 36 + 2 * 48; size: 72, 44; cursor: pointer; role: button; label: "Skyline" }
                box { from: x + 164, y + 36 + 2 * 48; size: 72, 44; corner: 4; color: fl.ground; opacity: 0.8 }
                box { from: x + 164, y + 36 + 2 * 48; size: 72, 44; corner: 4; stroke: if(wg_sm == 10, 1.6, 1); color: if(wg_sm == 10, fl.phos, mix(fl.trace_dim, fl.trace_lit, th10.hover)) }
                Visualiser(x + 164 + 4, y + 36 + 2 * 48 + 3, 64, 28, 0.15, 10, 0, false)
                text "SKYLINE" { at: x + 164 + 36, y + 36 + 2 * 48 + 38; anchor: center; align: center; size: 8; family: "Share Tech Mono"; color: if(wg_sm == 10, fl.phos, fl.muted) }
                on press th10 { wg_hold = 0; emit wg_opt(base + 100 + 10) }
            }
            group {
                zone box th11 { from: x + 240, y + 36 + 2 * 48; size: 72, 44; cursor: pointer; role: button; label: "Liquid" }
                box { from: x + 240, y + 36 + 2 * 48; size: 72, 44; corner: 4; color: fl.ground; opacity: 0.8 }
                box { from: x + 240, y + 36 + 2 * 48; size: 72, 44; corner: 4; stroke: if(wg_sm == 11, 1.6, 1); color: if(wg_sm == 11, fl.phos, mix(fl.trace_dim, fl.trace_lit, th11.hover)) }
                Visualiser(x + 240 + 4, y + 36 + 2 * 48 + 3, 64, 28, 0.15, 11, 0, false)
                text "LIQUID" { at: x + 240 + 36, y + 36 + 2 * 48 + 38; anchor: center; align: center; size: 8; family: "Share Tech Mono"; color: if(wg_sm == 11, fl.phos, fl.muted) }
                on press th11 { wg_hold = 0; emit wg_opt(base + 100 + 11) }
            }
            }
            // 2 · sliders
            WSlider(x + 12, y + sy, 296, "OPACITY", "{round(wg_oop * 100)}%", (wg_oop - 0.3) / 0.7, k, 1)
            WSlider(x + 12, y + sy + 30, 296, "SCALE", "{round(wg_osc * 100)}%", wg_osc, k, 7)
            group {
                show: not vis
                WSlider(x + 12, y + sy + 60, 296, "TEXT", "{round(wg_otx * 100)}%", (wg_otx - 0.8) / 0.6, k, 6)
            }
            group {
                show: vis
                WSlider(x + 12, y + sy + 60, 296, "BARS", "{round(wg_ob)}", (wg_ob - 16) / 112, k, 2)
                WSlider(x + 12, y + sy + 90, 296, "GLOW", "{round(wg_og * 100)}%", wg_og, k, 3)
                WSlider(x + 12, y + sy + 120, 296, "GAP", "{round(wg_ogap * 100)}%", wg_ogap / 0.6, k, 4)
                WSlider(x + 12, y + sy + 150, 296, "SMOOTHING", "{round(wg_osm * 100)}%", wg_osm, k, 5)
            }
            // 3 · at rest
            text "AT REST" { at: x + 12, y + ry; anchor: left center; size: 9; family: "Share Tech Mono"; color: fl.muted }
            Chip(x + 12, y + ry + 10, 96, "HIDE", wg_si < 0.5, base + 200)
            Chip(x + 112, y + ry + 10, 96, "REST", wg_si > 0.5 and wg_si < 1.5, base + 201)
            Chip(x + 212, y + ry + 10, 96, "MARKER", wg_si > 1.5, base + 202)
            // 4 · switches
            group {
                show: not vis
                Chip(x + 12, y + wy, 144, "LYRIC LINE", wg_o3, base + 300 + if(wg_o3, 0, 1))
                Chip(x + 164, y + wy, 144, "PROGRESS", wg_o4, base + 400 + if(wg_o4, 0, 1))
                Chip(x + 12, y + wy + 30, 144, "PLATE", wg_o5, base + 500 + if(wg_o5, 0, 1))
                Chip(x + 164, y + wy + 30, 144, "WHEEL VOLUME", wg_o6, base + 600 + if(wg_o6, 0, 1))
            }
            group {
                show: vis
                Chip(x + 12, y + wy, 96, "PLATE", wg_o5, base + 500 + if(wg_o5, 0, 1))
                Chip(x + 112, y + wy, 96, "PEAKS", wg_o7, base + 700 + if(wg_o7, 0, 1))
                Chip(x + 212, y + wy, 96, "REFLECTION", wg_o8, base + 800 + if(wg_o8, 0, 1))
            }
            // 5 · where it is, and what can be done to it
            text wg_readout { at: x + 12, y + ay + 8; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.engrave; width: 296; lines: 1 }
            Chip(x + 12, y + ay + 24, 96, pick(wg_olk, "LOCK", "UNLOCK"), wg_olk, base + 903)
            Chip(x + 112, y + ay + 24, 96, "DUPLICATE", false, base + 901)
            Chip(x + 212, y + ay + 24, 96, "REMOVE", false, base + 902)
            // the wallpaper (D139): read against it, sit behind its subject, or move off it
            Chip(x + 12, y + ay + 54, 96, "ADAPT", wg_oad, base + if(wg_oad, 906, 905))
            Chip(x + 112, y + ay + 54, 96, "BEHIND", wg_obh, base + if(wg_obh, 908, 907))
            Chip(x + 212, y + ay + 54, 96, "CALM SPOT", false, base + 904)
        }
    }

    // The visualiser: one of the twelve (lib/widgets MODES), in the palette's two signal colours,
    // with a glow of its own (0 … 1). Stillness is the scene's (`viz_still`).
    component Visualiser(x: number, y: number, w: number, h: number, u: number, mode: number, glow: number, plate: bool) {
        size: w, h
        let t1 = fl.phos
        let t2 = fl.ember
        let cr = min(w, h) * 0.3
        box { from: x, y; size: w, h; corner: 6 * u; color: fl.hull; opacity: 0.7; show: plate }
        group {
            group { glow: min(10 * u, 12), glow, t1; show: mode < 0.5
                    viz.Spectrum(x, y, w, h, t1, t2, viz_still) }
            group { glow: min(10 * u, 12), glow, t1; show: mode > 0.5 and mode < 1.5
                    viz.Mirror(x, y, w, h, t1, t2, viz_still) }
            group { glow: min(10 * u, 12), glow, t1; show: mode > 1.5 and mode < 2.5
                    viz.Ring(x + w / 2, y + h / 2, cr, min(w, h) * 0.18, t1, t2, viz_still) }
            group { show: mode > 2.5 and mode < 3.5
                    viz.Aurora(x, y, w, h, t1, t2, np_turn, viz_still) }
            group { glow: min(10 * u, 12), glow, t1; show: mode > 3.5 and mode < 4.5
                    viz.LED(x, y, w, h, t1, t2, fl.trace_dim, viz_still) }
            group { glow: min(10 * u, 12), glow, t1; show: mode > 4.5 and mode < 5.5
                    viz.Orbit(x, y, w, h, t1, t2, fl.trace_dim, np_turn, viz_still) }
            group { glow: min(10 * u, 12), glow, t1; show: mode > 5.5 and mode < 6.5
                    viz.Scope(x, y, w, h, t1, t2, viz_still, np_turn, 40, 90) }
            group { show: mode > 6.5 and mode < 7.5
                    viz.Horizon(x, y, w, h, t1, t2, viz_still, np_turn) }
            group { glow: min(10 * u, 12), glow, t1; show: mode > 7.5 and mode < 8.5
                    viz.Dust(x, y, w, h, t1, t2, viz_still, np_scatter, np_turn) }
            group { glow: min(10 * u, 12), glow, t1; show: mode > 8.5 and mode < 9.5
                    viz.Ripple(x, y, w, h, t1, t2, viz_still, rp_r0, rp_a0, rp_r1, rp_a1, rp_r2, rp_a2, rp_r3, rp_a3) }
            group { glow: min(10 * u, 12), glow, t1; show: mode > 9.5 and mode < 10.5
                    viz.Skyline(x, y, w, h, t1, t2, viz_still) }
            group { show: mode > 10.5
                    viz.Liquid(x, y, w, h, t1, t2, viz_still, np_turn) }
        }
    }
}
