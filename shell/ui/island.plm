language 0.9
import "../theme/tokens.plm"
import "../theme/ferrolume.plm"

// The pieces every island shares. An island is drawn in the bar's surface; inside it,
// IslandFrame draws the body that grows out of its anchor and fades its content in. Two styles
// (island.style, the scene fact `isl_style`): 0 **plate** — a Ferrolume plate, the bar's own
// language: chamfered (look.corners), a lit top edge, mono caps — and 1 **tether** — a calm
// rounded slab hanging from its module on a hairline tether. The pieces below draw a header,
// rules, meters, buttons and figures in whichever is chosen; zones and rules stay in the scene.
library Island {
    // `rv` is the island's reveal spring (0 hidden → 1 shown). At 0 the body is the
    // anchor's own size (`aw` × `ah`), sitting where the anchor is; it grows to w × h.
    // `up`: grows upwards from the bottom-left corner (anchors at the bottom of the Spine).
    // `centre`: grows from the middle of its top edge (an island with no Spine anchor,
    // such as the command membrane, which sits at a fixed place).
    // `tx`: where its module is, from the island's left — the tether drops there (−1: no tether).
    // A tethered island sits 12 px lower, so the tether shows; its children move with it.
    component IslandFrame(rv: number, w: number, h: number, up: bool = false, centre: bool = false, aw: number = 36, ah: number = 36, tx: number = -1) {
        size: w, h
        let tether = isl_style > 0.5
        // biomass (island.biomass, D148): the island hangs further down, on living circuitry
        let bio = bio_on and not up
        let drop = if(bio and not centre, 44, if(tether and not up and not centre, 12, 0))
        let iw = aw + (w - aw) * rv
        let ih = ah + (h - ah) * rv
        let top = if(up, h - ih, 0) + drop
        let left = if(centre, (w - iw) / 2, 0)
        // the tether's corner: the theme's radius on look.corner_size, none when square
        let irad = if(cn_kind > 2.5, 0, (g.radius + 4) * cn_scale)
        let k = clamp(fl.chamfer * 1.4 * cn_scale, 0, min(iw, ih) / 2)

        // ── plate ──
        group {
            show: not tether
            // the shadow comes from a body inside the cut (a group cannot cast one)
            body {
                gradient: 0, top to 0, top + ih, fl.hull, fl.hull
                shadow: 0, 6 * rv, 20 * rv, 45% * rv
                box { from: left + k * 0.5, top + k * 0.5; size: max(1, iw - k), max(1, ih - k); corner: 2 }
            }
            Chamfer(left, top, iw, ih, fl.chamfer * 1.4, fl.hull, fl.trace, 0.97, 1)
            // the lit top run and the cut it turns into
            group {
                glow: 5, (0.55 * rv) * st_glow, fl.phos
                line { from: left + k + 2, top + 0.5; to: left + iw - 1, top + 0.5; width: 1.4; color: fl.phos; opacity: 0.85 * rv }
            }
            line { from: left + 10, top + ih - 3; to: left + 26, top + ih - 3; width: 1; color: fl.phos; opacity: 0.5 * rv }
        }

        // ── tether ──
        group {
            show: tether
            group {
                show: tx >= 0 and not up and not centre
                opacity: smooth(0.2, 1, rv)
                line { from: clamp(tx, 14, w - 14), -6; to: clamp(tx, 14, w - 14), top; width: 1; color: accent.primary; opacity: 0.75 }
                group {
                    glow: 6, (0.8) * st_glow, accent.primary
                    ellipse { at: clamp(tx, 14, w - 14), top; radius: 2.6; color: accent.primary }
                }
            }
            body {
                gradient: 0, top to 0, top + ih, mix(surface.elevated, accent.primary, 0.05), bg.primary
                border: 1, mix(border.subtle, accent.primary, 0.35)
                shadow: 0, 8 * rv, 26 * rv, 42% * rv
                box { from: left, top; size: iw, ih; corner: irad }
            }
            line { from: left + irad, top + 0.75; to: left + iw - irad, top + 0.75; width: 1; color: accent.primary; opacity: 0.45 * rv }
        }


        // ── biomass (D148): the island grown out of the bar on living circuitry ──
        // An umbilical of braided cable, ribbed like vertebrae and webbed to the island, roots curling
        // along the bar, veins that run its border and grip it from outside, nodules where it took root,
        // and a signal that runs it all once as it opens. Driven by the island's own spring (`rv`): it
        // grows as the island morphs open and rests when it is open, so it costs nothing while nothing
        // moves. Straight steps only (a curve costs far more per frame).
        let bax = if(tx >= 0, clamp(tx, 14, w - 14), left + iw / 2)
        let by0 = if(centre, -28, -6)
        let bgl = smooth(0, 0.55, rv)                      // the cable, grown down from the bar
        let bgv = smooth(0.35, 1, rv)                      // the veins, spread over the island
        let bly = by0 + (top - by0) * bgl                  // how far down the cable has reached
        let bcl = top - by0
        let bvl = left + 2                                 // the veins run the island's border
        let bvr = left + iw - 2
        let bvh = ih * 0.5 * bgv                           // how far down its sides they have grown
        group {
            show: bio and rv > 0.02
            // roots along the bar's foot, curling away to both sides
            group {
                opacity: smooth(0, 0.3, rv) * 0.85
                path { move bax, by0; line bax - 8 * bgl, by0 + 2; line bax - 18 * bgl, by0 + 2; line bax - 26 * bgl, by0 + 5; line bax - 34 * bgl, by0 + 4; line bax - 38 * bgl, by0 + 1; stroke: 1.3; color: fl.trace_lit }
                path { move bax, by0; line bax + 8 * bgl, by0 + 2; line bax + 18 * bgl, by0 + 2; line bax + 26 * bgl, by0 + 5; line bax + 34 * bgl, by0 + 4; line bax + 38 * bgl, by0 + 1; stroke: 1.3; color: fl.trace_lit }
                path { move bax, by0 + 1; line bax - 6 * bgl, by0 + 6; line bax - 12 * bgl, by0 + 8; line bax - 16 * bgl, by0 + 14; stroke: 1; color: fl.trace }
                path { move bax, by0 + 1; line bax + 6 * bgl, by0 + 6; line bax + 12 * bgl, by0 + 8; line bax + 16 * bgl, by0 + 14; stroke: 1; color: fl.trace }
                path { move bax - 18 * bgl, by0 + 2; line bax - 22 * bgl, by0 - 2; stroke: 1; color: fl.trace }
                path { move bax + 18 * bgl, by0 + 2; line bax + 22 * bgl, by0 - 2; stroke: 1; color: fl.trace }
                ellipse { at: bax - 38 * bgl, by0 + 1; radius: 1.8; color: fl.phos }
                ellipse { at: bax + 38 * bgl, by0 + 1; radius: 1.8; color: fl.phos }
                ellipse { at: bax - 16 * bgl, by0 + 14; radius: 1.4; color: fl.trace_lit }
                ellipse { at: bax + 16 * bgl, by0 + 14; radius: 1.4; color: fl.trace_lit }
                ellipse { at: bax, by0 + 1; radius: 5; color: fl.steel_700 }
                ellipse { at: bax, by0 + 1; radius: 5; stroke: 1.2; color: fl.trace_lit }
            }
            // the webbing between cable and island: tissue held taut
            group {
                opacity: smooth(0.3, 0.8, rv) * 0.55
                line { from: bax, by0 + bcl * 0.55; to: bax - 40, top; width: 1; color: fl.trace }
                line { from: bax, by0 + bcl * 0.55; to: bax + 40, top; width: 1; color: fl.trace }
                line { from: bax, by0 + bcl * 0.75; to: bax - 22, top; width: 1; color: fl.trace_dim }
                line { from: bax, by0 + bcl * 0.75; to: bax + 22, top; width: 1; color: fl.trace_dim }
            }
            // the umbilical: a core cable, two strands braided round it, ribs like vertebrae
            group {
                clip box { from: bax - 16, by0 - 2; size: 32, max(0.5, bly - by0 + 2) }
                line { from: bax, by0; to: bax, top; width: 5; color: fl.steel_700 }
                group {
                    glow: 5, 0.5 * st_glow, fl.phos
                    line { from: bax, by0; to: bax, top; width: 1.6; color: fl.phos_fill }
                }
                path { move bax, by0; line bax + 6, by0 + bcl * 0.1; line bax, by0 + bcl * 0.2; line bax - 6, by0 + bcl * 0.3; line bax, by0 + bcl * 0.4
                       line bax + 6, by0 + bcl * 0.5; line bax, by0 + bcl * 0.6; line bax - 6, by0 + bcl * 0.7; line bax, by0 + bcl * 0.8
                       line bax + 6, by0 + bcl * 0.9; line bax, top; stroke: 1.4; color: fl.trace_lit }
                path { move bax, by0; line bax - 6, by0 + bcl * 0.1; line bax, by0 + bcl * 0.2; line bax + 6, by0 + bcl * 0.3; line bax, by0 + bcl * 0.4
                       line bax - 6, by0 + bcl * 0.5; line bax, by0 + bcl * 0.6; line bax + 6, by0 + bcl * 0.7; line bax, by0 + bcl * 0.8
                       line bax - 6, by0 + bcl * 0.9; line bax, top; stroke: 1.4; color: fl.trace }
                repeat q in 1..6 {
                    line { from: bax - 7, by0 + bcl * q / 6; to: bax + 7, by0 + bcl * q / 6; width: 2.4; color: fl.steel_500 }
                    ellipse { at: bax - 8, by0 + bcl * q / 6; radius: 1.3; color: fl.trace_lit }
                    ellipse { at: bax + 8, by0 + bcl * q / 6; radius: 1.3; color: fl.trace_lit }
                }
            }
            ellipse { at: bax, top; radius: 5; color: fl.hull; show: rv > 0.5 }
            ellipse { at: bax, top; radius: 5; stroke: 1.4; color: fl.phos; show: rv > 0.5 }
        }
        group {
            show: bio and rv > 0.3
            opacity: bgv
            // veins out from the cable along the top edge to the corners, then down the island's border
            path { move bax, top + 2; line bax + (bvr - 10 - bax) * bgv, top + 2; line bax + (bvr - bax) * bgv, top + 8 * bgv; line bvr, top + 8 + bvh; stroke: 1.4; color: fl.phos; opacity: 0.8 }
            path { move bax, top + 2; line bax - (bax - bvl - 10) * bgv, top + 2; line bax - (bax - bvl) * bgv, top + 8 * bgv; line bvl, top + 8 + bvh; stroke: 1.4; color: fl.phos; opacity: 0.8 }
            // where they grip from outside: short tendrils hooked over the edge
            path { move bvl, top + 8 + bvh * 0.35; line bvl - 7, top + 14 + bvh * 0.35; line bvl - 9, top + 24 + bvh * 0.35; stroke: 1.1; color: fl.trace_lit; opacity: 0.75 }
            path { move bvr, top + 8 + bvh * 0.35; line bvr + 7, top + 14 + bvh * 0.35; line bvr + 9, top + 24 + bvh * 0.35; stroke: 1.1; color: fl.trace_lit; opacity: 0.75 }
            path { move bvl, top + 8 + bvh * 0.8; line bvl - 6, top + 12 + bvh * 0.8; line bvl - 6, top + 20 + bvh * 0.8; stroke: 1; color: fl.trace; opacity: 0.7 }
            path { move bvr, top + 8 + bvh * 0.8; line bvr + 6, top + 12 + bvh * 0.8; line bvr + 6, top + 20 + bvh * 0.8; stroke: 1; color: fl.trace; opacity: 0.7 }
            ellipse { at: bvl, top + 8 + bvh; radius: 2.4; color: fl.phos }
            ellipse { at: bvr, top + 8 + bvh; radius: 2.4; color: fl.phos }
            ellipse { at: bvl - 9, top + 24 + bvh * 0.35; radius: 1.6; color: fl.trace_lit }
            ellipse { at: bvr + 9, top + 24 + bvh * 0.35; radius: 1.6; color: fl.trace_lit }
            // a capillary off the top vein each side, ending in a pad
            path { move bax + (bvr - bax) * 0.5 * bgv, top + 2; line bax + (bvr - bax) * 0.5 * bgv + 6, top - 4; line bax + (bvr - bax) * 0.5 * bgv + 20 * bgv, top - 4; stroke: 1; color: fl.trace_lit; opacity: 0.6 }
            path { move bax - (bax - bvl) * 0.5 * bgv, top + 2; line bax - (bax - bvl) * 0.5 * bgv - 6, top - 4; line bax - (bax - bvl) * 0.5 * bgv - 20 * bgv, top - 4; stroke: 1; color: fl.trace_lit; opacity: 0.6 }
            ellipse { at: bax + (bvr - bax) * 0.5 * bgv + 20 * bgv, top - 4; radius: 1.5; color: fl.trace_lit }
            ellipse { at: bax - (bax - bvl) * 0.5 * bgv - 20 * bgv, top - 4; radius: 1.5; color: fl.trace_lit }
            // nodules where it has taken root at the corners: growths of steel and ember
            group {
                opacity: smooth(0.7, 1, rv)
                ellipse { at: left + 3, top + 3; radius: 5.5; color: fl.steel_700 }
                ellipse { at: left + 3, top + 3; radius: 5.5; stroke: 1.2; color: fl.trace_lit }
                ellipse { at: left + 11, top - 1; radius: 2.6; color: fl.ember }
                ellipse { at: left - 2, top + 12; radius: 2.2; color: fl.steel_500 }
                ellipse { at: left + iw - 3, top + 3; radius: 5.5; color: fl.steel_700 }
                ellipse { at: left + iw - 3, top + 3; radius: 5.5; stroke: 1.2; color: fl.trace_lit }
                ellipse { at: left + iw - 11, top - 1; radius: 2.6; color: fl.ember }
                ellipse { at: left + iw + 2, top + 12; radius: 2.2; color: fl.steel_500 }
                ellipse { at: left + 2, top + ih - 3; radius: 3.5; color: fl.steel_700 }
                ellipse { at: left + 2, top + ih - 3; radius: 3.5; stroke: 1; color: fl.trace }
                ellipse { at: left + iw - 2, top + ih - 3; radius: 3.5; color: fl.steel_700 }
                ellipse { at: left + iw - 2, top + ih - 3; radius: 3.5; stroke: 1; color: fl.trace }
            }
        }
        // the signal: down the cable as it opens, then out along both veins and down the sides
        group {
            show: bio and rv > 0.05 and rv < 0.985
            glow: 10, 0.95 * st_glow, fl.flare
            let bsp = smooth(0.05, 0.98, rv)
            let bs2 = max(0, bsp * 2 - 1)
            ellipse { at: bax, by0 + bcl * min(1, bsp * 2); radius: 3.2; color: fl.flare; show: bsp < 0.5 }
            ellipse { at: bax + (bvr - bax) * min(1, bs2 * 1.6), top + 2 + max(0, bs2 * 1.6 - 1) * ih * 0.8; radius: 2.6; color: fl.flare; show: bsp >= 0.5 }
            ellipse { at: bax - (bax - bvl) * min(1, bs2 * 1.6), top + 2 + max(0, bs2 * 1.6 - 1) * ih * 0.8; radius: 2.6; color: fl.flare; show: bsp >= 0.5 }
        }
        group {
            opacity: smooth(0.45, 1, rv)
            move: if(centre, 0, -10 * (1 - rv)), if(centre, -6 * (1 - rv), 0) + drop
            clip box { from: left, top - drop; size: iw, ih; corner: if(tether, irad, 0) }
            children
        }
    }

    // The header: the island's name left, a live line right. Plate: mono caps over a short lit
    // trace; tether: a quiet title.
    component IsleHead(w: number, title: text, sub: text = "") {
        size: w, 30
        group {
            show: isl_style < 0.5
            text "{upper(title)}" { at: 16, 18; anchor: left center; size: 11; weight: 700; family: "Share Tech Mono"; color: fl.phos
                         width: w * 0.55; lines: 1 }
            line { from: 16, 27; to: 40, 27; width: 1.4; color: fl.phos; opacity: 0.8 }
            line { from: 44, 27; to: w - 16, 27; width: 1; color: fl.trace_dim; opacity: 0.6 }
            text sub { at: w - 16, 18; anchor: right center; size: 10; family: "Share Tech Mono"; color: fl.muted; width: w * 0.45; lines: 1; align: right }
        }
        group {
            show: isl_style > 0.5
            text title { at: 16, 18; anchor: left center; size: 14; weight: 600; family: "Exo 2"; color: fg.primary; width: w * 0.55; lines: 1 }
            text sub { at: w - 16, 18; anchor: right center; size: 11; family: "Exo 2"; color: fg.secondary; width: w * 0.45; lines: 1; align: right }
        }
    }

    // A divider across the island at `y`.
    component IsleRule(w: number, y: number) {
        size: w, 1
        line { from: 16, y; to: w - 16, y; width: 1; color: if(isl_style > 0.5, border.subtle, fl.trace_dim); opacity: if(isl_style > 0.5, 0.8, 0.55) }
    }

    // A small label over a large figure, at (x, y) its top-left. `hot`: past where it hurts.
    component IsleStat(x: number, y: number, label: text, value: text, hot: bool = false) {
        size: 90, 40
        group {
            show: isl_style < 0.5
            text label { at: x, y + 6; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.muted }
            text value { at: x, y + 25; anchor: left center; size: 19; weight: 600; family: "Exo 2"; color: if(hot, fl.ember, fl.phos) }
        }
        group {
            show: isl_style > 0.5
            text label { at: x, y + 6; anchor: left center; size: 10; family: "Exo 2"; color: fg.secondary }
            text value { at: x, y + 25; anchor: left center; size: 19; weight: 600; family: "Exo 2"; color: if(hot, status.error, fg.primary) }
        }
    }

    // A level 0..1 at (x, y), `w` wide: segments in plate, a smooth track with a thumb in tether.
    component IsleMeter(x: number, y: number, w: number, v: number, hot: bool = false) {
        size: w, 8
        prop sv = 0 ~m.select
        follow sv = clamp(v, 0, 1)
        group {
            show: isl_style < 0.5
            repeat s in 0..24 {
                let sw = (w - 23 * 2) / 24
                box { from: x + s * (sw + 2), y; size: sw, 8; corner: 1
                      color: if(s < sv * 24, if(hot, fl.ember, fl.phos), mix(fl.well, fl.trace, 0.45)); opacity: if(s < sv * 24, 1, 0.8) }
            }
        }
        group {
            show: isl_style > 0.5
            box { from: x, y + 1; size: w, 6; corner: 3; color: bg.primary }
            box { from: x, y + 1; size: w, 6; corner: 3; stroke: 1; color: border.subtle }
            group {
                glow: 6, (0.6) * st_glow, accent.primary
                box { from: x, y + 1; size: max(6, w * sv), 6; corner: 3; color: if(hot, status.error, accent.primary) }
            }
            ellipse { at: x + max(6, w * sv) - 3, y + 4; radius: 6; color: fg.primary }
        }
    }

    // A reading with its meter: the label left, the figure right, the level under them, `w` wide
    // from (x, y). `hot`: past where it hurts.
    component IsleGauge(x: number, y: number, w: number, label: text, shown: text, v: number, hot: bool = false) {
        size: w, 28
        group {
            show: isl_style < 0.5
            text "{upper(label)}" { at: x, y + 6; anchor: left center; size: 10; weight: 700; family: "Share Tech Mono"; color: fl.engrave }
            text shown { at: x + w, y + 6; anchor: right center; size: 10; family: "Share Tech Mono"; color: if(hot, fl.ember, fl.phos) }
        }
        group {
            show: isl_style > 0.5
            text label { at: x, y + 6; anchor: left center; size: 12; family: "Exo 2"; color: fg.primary }
            text shown { at: x + w, y + 6; anchor: right center; size: 11; family: "Exo 2"; color: if(hot, status.error, fg.secondary) }
        }
        IsleMeter(x, y + 16, w, v, hot)
    }

    // A button's face at (x, y): a cut chip (plate) or a pill (tether). `lit`: the chosen one;
    // `hover`: the pointer's over it. The caller draws its zone over the same box.
    component IsleBtn(x: number, y: number, w: number, word: text, lit: number, hover: number, h: number = 24) {
        size: w, h
        group {
            show: isl_style < 0.5
            Chamfer(x, y, w, h, 5, mix(fl.hull_raised, fl.phos_fill, lit), mix(fl.trace, fl.phos, max(hover, lit)), 1, 1)
            text "{upper(word)}" { at: x + w / 2, y + h / 2 + 0.5; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"
                                   color: if(lit > 0.5, fl.ink, mix(fl.engrave, fl.phos, hover)); width: w - 6; lines: 1 }
        }
        group {
            show: isl_style > 0.5
            box { from: x, y; size: w, h; corner: if(cn_kind > 2.5, 3, h / 2)
                  color: mix(mix(surface.elevated, fg.primary, 0.06 * hover), accent.primary, 0.85 * lit) }
            box { from: x, y; size: w, h; corner: if(cn_kind > 2.5, 3, h / 2); stroke: 1
                  color: mix(border.subtle, accent.primary, max(0.6 * hover, lit)) }
            text word { at: x + w / 2, y + h / 2; anchor: center; align: center; size: 11; weight: 600; family: "Exo 2"
                        color: if(lit > 0.5, bg.primary, fg.primary); width: w - 8; lines: 1 }
        }
    }

    // A button's face, wherever an island has one (the Window island's actions): machined in
    // tether, a cut chip in plate; its edge lighting under the pointer, a neon bar under it when it
    // is the chosen one, the second colour when it is armed (a close that asks twice). `dim`: it
    // cannot act now.
    component BtnFace(w: number, h: number, hover: number, lit: number, hot: number = 0, dim: bool = false) {
        size: w, h
        opacity: if(dim, 0.45, 1)
        group {
            show: isl_style < 0.5
            Chamfer(0, 0, w, h, 6, mix(fl.hull_raised, fl.well, lit * 0.6), mix(mix(fl.trace, fl.phos, max(0.8 * hover, lit)), fl.ember, hot), 1, 1)
            group {
                glow: 6, (max(lit, hot)) * st_glow, mix(fl.phos, fl.ember, hot)
                box { from: w * 0.25, h - 3.5; size: w * 0.5, 2; corner: 1; color: mix(fl.phos, fl.ember, hot); opacity: max(lit, hot) }
            }
        }
        group {
            show: isl_style > 0.5
            body {
                gradient: 0, 0 to 0, h, mix(surface.elevated, fg.primary, 0.06 * hover), mix(surface.primary, selection.bg, lit)
                box { from: 0, 0; size: w, h; corner: g.radius.item }
            }
            line { from: g.radius.item, 1; to: w - g.radius.item, 1; width: 1; color: fg.primary; opacity: 0.07 + 0.08 * hover }
            box { from: 0, 0; size: w, h; corner: g.radius.item; stroke: 1
                  color: mix(mix(border.subtle, focus.ring, max(0.7 * hover, lit)), accent.secondary, hot) }
            group {
                glow: 6, (max(lit, hot)) * st_glow, mix(accent.primary, accent.secondary, hot)
                box { from: w * 0.25, h - 3.5; size: w * 0.5, 2; corner: 1; color: mix(accent.primary, accent.secondary, hot); opacity: max(lit, hot) }
            }
        }
    }

    // A horizontal level (0..1) the user can drag, click or scroll. What it shows is
    // `value`, which should be what the system reports, not what was asked for.
    component Level(label: text, shown: text, value: number, chosen: bool, set: event, w: number = 268) {
        size: w, 40
        prop v = 0 ~m.select
        follow v = value
        prop lit = 0 ~m.select
        follow lit = if(chosen, 1, 0)
        box { from: -8, -4; size: w + 16, 46; corner: if(isl_style > 0.5, g.radius.item, 2)
              color: if(isl_style > 0.5, selection.bg, fl.well); opacity: lit * 70% }
        group {
            show: isl_style < 0.5
            text "{upper(label)}" { at: 0, 10; anchor: left center; size: 10; weight: 700; family: "Share Tech Mono"; color: fl.engrave }
            text shown { at: w, 10; anchor: right center; size: 10; family: "Share Tech Mono"; color: fl.phos }
        }
        group {
            show: isl_style > 0.5
            text label { at: 0, 10; anchor: left center; size: 12; color: fg.primary }
            text shown { at: w, 10; anchor: right center; size: 11; color: fg.secondary }
        }
        zone box track { from: 0, 22; size: w, 14; cursor: pointer; role: slider; value: value; label: label }
        IsleMeter(0, 25, w, value)
        on press track { emit set(clamp(local.x / w, 0, 1)) }
        on drag track { emit set(clamp(local.x / w, 0, 1)) }
        on scroll track { emit set(clamp(value + wheel * 0.05, 0, 1)) }
    }
}
