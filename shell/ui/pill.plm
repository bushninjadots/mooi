language 0.9

// The Pill's content (D168): what the capsule at the top centre shows, drawn by the bar's scene over
// the body mooi-frame draws for it (lib/chassis). shell/bar.luau feeds the facts from lib/pill:
//   pill_kind  0 idle · 1 music · 2 osd · 3 notify · 4 record · 5 battery
//   pill_shape 0 attached · 1 floating · 2 dot · 3 record (D172: the disc, the cover its label)
//   pill_glyph 0 idle · 1 music · 2 vol · 3 bri · 4 notify · 5 record · 6 low · 7 charging
// with the first and second lines (pill_t1, pill_t2), a value (pill_val), a split partner on the right
// (pill_split, pill_glyph2, pill_s1, pill_val2 from pill_w1 on) and up to four moons (moon_x*, moon_k*).
// D173: it is pointer-aware — a warmth behind the capsule that brightens as the pointer comes near, the
// dot leaning a little toward it, and a half disc that turns once when the workspace changes (or the wheel
// turns its view: pill_turn, the scene's pill_turn_f — D188: drawn as the edge flash).
// The visualiser's bars are ui/viz.plm's, read from the scene's bands like every other.

import "viz.plm" as viz

library Pill {
    // A mark for an activity, centred at (cx, cy): bars for music, a dot for the rest, coloured by what it is.
    component Mark(cx: number, cy: number, g: number) {
        size: 18, 18
        group {
            show: g > 0.5 and g < 1.5
            viz.Spectrum(cx - 9, cy - 7, 18, 14, fl.phos, fl.ember)
        }
        ellipse { at: cx, cy; radius: 4; color: pick(g, fl.trace_lit, fl.phos, fl.phos, fl.ember, fl.phos, #e05a5a, fl.ember, fl.phos); show: g < 0.5 or g > 1.5 }
        ellipse { at: cx, cy; radius: 6.5; stroke: 1.2; color: #e05a5a; opacity: 0.5; show: g > 4.5 and g < 5.5 }
    }

    // D187: one layout, whatever is happening. Every activity is a mark — or, when the song has a cover,
    // the cover itself — one line of words at the same size and the same left edge, and for a volume or
    // brightness change a hairline of a track along the capsule's foot. Nothing becomes a different pill
    // when it takes over: it only takes the room its words need.
    component Half(x: number, w: number, g: number, t1: text, t2: text, v: number) {
        size: w, fl.mod_h
        let cy = fl.cy
        let cover = med_has_art and (g > 0.5 and g < 1.5 or g > 4.5)
        image art = from med_art, 64, 64
        let bmo = pill_face > 0.5 and pill_face < 1.5      // D196: with BMO as the face, he is the mark
        box { from: x + 6, cy - 8; size: 16, 16; corner: 4; color: fl.well; show: cover and not bmo }
        image art { at: x + 6, cy - 8; size: 16, 16; show: cover and not bmo }
        group { show: not cover and not bmo
                Mark(x + 18, cy, g) }
        group { show: bmo
                BmoMark(x + 6, cy) }
        text "{t1}{? · {t2}}" { at: x + 34, cy; anchor: left center; size: 12; weight: 600; family: "Exo 2"; color: fl.engrave; width: max(1, w - 44); lines: 1 }
        box { from: x + 10, fl.top + pill_h - 3.5; size: max(4, w - 20), 2; corner: 1; color: fl.well; show: g > 1.5 and g < 3.5 }
        box { from: x + 10, fl.top + pill_h - 3.5; size: max(0, (w - 20) * v), 2; corner: 1; color: fl.phos; show: g > 1.5 and g < 3.5 }
    }

    // BMO's face on his own small screen (D169), 48 × 22 at (fx, fy): bmo/brain's numbers at 0.42 of
    // the desktop BMO's face, eyes pulled toward the pointer (pb_lx, pb_ly), the blink (pb_open).
    component BmoFace(fx: number, fy: number, framed: bool = true) {
        // D170: the desktop BMO's own face (bmo/bmo.plm's screen) at 50 × 34: drawn in its 96 × 66 units and
        // scaled, so every expression is the same drawing — eyes with their shine, ^ when happy-shut, brows,
        // a mouth of two curves that opens into a D or an O, the tongue, the blush. Singing, his mouth opens
        // on the bass and his head bobs.
        size: 50, 34
        let ink = #183d42
        let glass = #b8f5df
        let bass = clamp((lv0 + lv1 + lv2) / 3, 0, 1)
        let mo = if(pb_sing, 0.15 + 0.85 * bass, pbm_o)
        let lx = pb_lx
        let ly = pb_ly
        let shut = min(1, pb_lidf + 1 - pb_open)
        let eh = pbe_h
        let ew = pbe_w
        let eye_h = max(2.5, eh * (1 - shut))
        let mx = 48 + lx * 0.3
        let half = pbm_w / 2
        let bend = pbm_c * 8
        let upper = 46 + bend * 0.55 - mo * 7 * (1 - max(0, pbm_c))
        let lower = 46 + bend + mo * 13
        group {
            move: fx, fy - if(pb_sing, bass * 1.5, 0)
            pivot: 0, 0
            scale: 50 / 96
            // D196: framed, his own screen; unframed, the face alone (drawn on the capsule's glass, BmoScreen)
            box { from: 0, 0; size: 96, 66; corner: 9; color: ink; show: framed }
            box { from: 2, 2; size: 92, 62; corner: 7; color: glass; show: framed }
            box { from: 6, 5; size: 84, 6; corner: 3; color: #ffffff; opacity: 0.22; show: framed }
            ellipse { at: 18, 39; radius: 6.5; scale: 1, 0.46; color: #f28aa0; opacity: pb_blf * 0.55 }
            ellipse { at: 78, 39; radius: 6.5; scale: 1, 0.46; color: #f28aa0; opacity: pb_blf * 0.55 }
            box { from: 30 + lx - ew / 2, 26 + ly + eh / 2 - eye_h; size: ew, eye_h; corner: min(ew, eye_h) / 2; color: ink; opacity: 1 - pb_sqlf }
            box { from: 66 + lx - ew / 2, 26 + ly + eh / 2 - eye_h; size: ew, eye_h; corner: min(ew, eye_h) / 2; color: ink; opacity: 1 - pb_sqrf }
            box { from: 30 + lx + ew / 2 - 4, 26 + ly + eh / 2 - eye_h + 2.5; size: 2.5, 2.5; corner: 1.25; color: glass; opacity: 0.85 * (1 - pb_sqlf); show: eye_h > 8 }
            box { from: 66 + lx + ew / 2 - 4, 26 + ly + eh / 2 - eye_h + 2.5; size: 2.5, 2.5; corner: 1.25; color: glass; opacity: 0.85 * (1 - pb_sqrf); show: eye_h > 8 }
            path { stroke: 3; color: ink; opacity: pb_sqlf
                   move 24 + lx, 29 + ly; curve 36 + lx, 29 + ly via 30 + lx, 20 + ly }
            path { stroke: 3; color: ink; opacity: pb_sqrf
                   move 60 + lx, 29 + ly; curve 72 + lx, 29 + ly via 66 + lx, 20 + ly }
            box { at: 30 + lx, 26 + ly - eh / 2 - 6; size: 12, 3; corner: 1.5; rotate: -pb_browf * 1deg; color: ink; opacity: pb_bronf }
            box { at: 66 + lx, 26 + ly - eh / 2 - 6; size: 12, 3; corner: 1.5; rotate: pb_browf * 1deg; color: ink; opacity: pb_bronf }
            path { color: ink; opacity: min(1, mo * 4)
                   move mx - half, 46; curve mx + half, 46 via mx, lower; curve mx - half, 46 via mx, upper; close }
            path { stroke: 3.2; color: ink
                   move mx - half, 46; curve mx + half, 46 via mx, lower }
            path { stroke: 3.2; color: ink; opacity: min(1, mo * 4)
                   move mx - half, 46; curve mx + half, 46 via mx, upper }
            ellipse { at: mx + 3, (46 + lower) / 2 + 2; radius: 4.5; scale: 1, 0.66; color: #ef7f93; opacity: pb_tgf * if(mo > 0.25, 1, 0) }
            // asleep: a z drifting up from the corner of his screen
            text "z" { at: 82, 18 - (pk_flow2 - floor(pk_flow2 / 14) * 14); anchor: center; size: 13; family: "Share Tech Mono"; color: ink; opacity: 0.7; show: pb_asleep }
        }
    }

    // D196: BMO as the Pill. The capsule's inside becomes his screen — the mint glass (a touch of the
    // theme's light in it), faint scanlines, a sheen across the top — with his face as tall as the capsule
    // lets it be and his line typed out beside it on the same glass, a block cursor at its end. He hops
    // (squash and stretch, on the morph spring) whenever his face changes; notes rise while he sings; a mark
    // over his head says what he feels (a drop on low battery, a bolt charging, ! for a notice); asleep the
    // glass dims and a z drifts up, and waking it flickers back on. Still one capsule (D187): no body round
    // it, only what its glass shows.
    component BmoScreen(px: number, pw: number, cy: number, say: text, talking: bool) {
        size: pw, 30
        let ink = #183d42
        let glass = mix(#b8f5df, fl.phos, 0.18)
        let gh = pill_h - 5
        let gy = fl.top + 2.5
        // the screen: dims asleep; waking, a flicker as the power comes back
        let flick = if(pb_pow < 0.98 and not pb_asleep, 0.25 * sin(pb_pow * 3000), 0)
        let lit = clamp(pb_pow + flick, 0.2, 1)
        group {
            opacity: lit
            box { from: px + 2.5, gy; size: max(4, pw - 5), gh; corner: gh / 2; color: glass }
            // scanlines, and the sheen across the top
            repeat sl in 0..6 {
                box { from: px + gh / 2, gy + 3 + sl * (gh - 6) / 5; size: max(1, pw - 5 - gh), 1; color: ink; opacity: 0.05 }
            }
            box { from: px + gh / 2, gy + 1.5; size: max(1, pw - 5 - gh), max(1, gh * 0.22); corner: 2; color: #ffffff; opacity: 0.22 }
        }
        // the hop: up and back on the morph spring, squashing as it lands
        let h = clamp(pb_hop - (pb_bump - 1), 0, 1.3)
        let rise = if(pill_still, 0, sin(min(h, 1) * 180) * 2.6)
        let squash = if(pill_still, 0, max(0, h - 1) * 0.5)
        // his features (eyes, brows, mouth: x 9…40, y 9…28 of the face's 50 × 34 units) fill the glass's
        // height — the face's empty margins left out, clipped to the glass; scaled about his feet so a
        // squash lands on the glass's floor
        let sc = (gh - 3) / 19
        // centred in the capsule while he is quiet; talking, he slides to the left end to make room for his line
        let fcx = px + pw / 2 + (px + 8 + 15.5 * sc - px - pw / 2) * pb_talkf
        let fby = gy + gh / 2 + 9.5 * sc
        group {
            clip box { from: px + 2.5, gy; size: max(4, pw - 5), gh; corner: gh / 2 }
            group {
                move: fcx - 24.5, fby - 28 - rise
                pivot: 24.5, 28
                scale: sc * (1 + squash), sc * (1 - squash)
                BmoFace(0, 0, false)
            }
        }
        // the mark over his head
        let mx = fcx + 15.5 * sc + 2
        let my = gy + 2 - 2 * sin(pb_t * 4)
        group {
            show: pb_mark > 0.5 and not pb_asleep
            // low battery: a drop of sweat, drawn
            path { color: #4aa3df; show: pb_mark < 1.5
                   move mx, my - 4.5; line mx + 3, my + 0.5; curve mx - 3, my + 0.5 via mx, my + 4.5; close }
            text pick(pb_mark - 2, "ϟ", "!") { at: mx, my; anchor: center; size: 10; weight: 800; family: "Exo 2"
                  color: pick(pb_mark - 2, #f3c64a, fl.ember); show: pb_mark > 1.5 }
        }
        // singing: notes rising out of his screen and fading
        repeat nt in 0..3 {
            let ph = (pb_t / 360 + nt / 3) - floor(pb_t / 360 + nt / 3)
            text pick(nt, "♪", "♫", "♪") { at: fcx + 15.5 * sc + 6 + nt * 7, gy + gh - ph * (gh + 6); anchor: center; size: 9; color: ink
                  opacity: (1 - ph) * 0.8; show: pb_sing and not pill_still }
        }
        // his line, typed out on the glass, a block cursor at its end
        let tx = fcx + 15.5 * sc + 9
        let tw = max(1, px + pw - 14 - tx)
        let tf = clamp(pb_type - (pb_say_n - 1), 0, 1)
        group {
            show: talking
            clip box { from: tx, gy; size: tw * tf, gh }
            text say { at: tx, cy; anchor: left center; size: 12; weight: 700; family: "Exo 2"; color: ink; width: tw; lines: 1 }
        }
        box { from: tx + min(tw - 4, say_w.width * tf) + 2, cy - 5; size: 5, 10; color: ink; opacity: if(talking, 0.65 * pb_cur, 0) }
        measure say_w = say
    }

    // D196: BMO small, as the capsule's mark while something else takes it (music, a level, a notice)
    component BmoMark(x: number, cy: number) {
        size: 22, 16
        let glass = mix(#b8f5df, fl.phos, 0.18)
        let h = clamp(pb_hop - (pb_bump - 1), 0, 1.3)
        let rise = if(pill_still, 0, sin(min(h, 1) * 180) * 1.6)
        box { from: x, cy - 8; size: 23, 16; corner: 4; color: glass }
        group { move: x + 0.5, cy - 8 - rise; pivot: 0, 0; scale: 0.46; BmoFace(0, 0, false) }
    }

    // The Control Nexus as the Pill's face (D169): its mark (a hub and three nodes) and its name, lit
    // while the Nexus is open.
    component NexusFace(x: number, w: number, cy: number) {
        size: w, 20
        let lit = if(nexus_open, 1, 0)
        let cx = x + w / 2 - 22
        line { from: cx, cy; to: cx - 7, cy - 5; width: 1.2; color: fl.trace_lit }
        line { from: cx, cy; to: cx + 7, cy - 5; width: 1.2; color: fl.trace_lit }
        line { from: cx, cy; to: cx, cy + 7; width: 1.2; color: fl.trace_lit }
        ellipse { at: cx, cy; radius: 3.2; color: mix(fl.phos, fl.ember, lit) }
        ellipse { at: cx - 7, cy - 5; radius: 1.8; color: fl.phos }
        ellipse { at: cx + 7, cy - 5; radius: 1.8; color: fl.phos }
        ellipse { at: cx, cy + 7; radius: 1.8; color: fl.phos }
        text "NEXUS" { at: cx + 14, cy; anchor: left center; size: 12; weight: 700; family: "Exo 2"; color: mix(fl.engrave, fl.ember, lit) }
    }

    // D172: the Pill as a record (pill.shape = record): the song's cover as the label on a turning disc,
    // a ring of the bands round it, coloured from the cover itself while it plays (pc1…pc3, shell/bar.luau)
    component Record(cx: number, cy: number, d: number) {
        size: d + 16, d + 16
        let r = d / 2
        let on = mu_playing
        let c1 = rgb(pc1_r, pc1_g, pc1_b)
        let c2 = rgb(pc2_r, pc2_g, pc2_b)
        let c3 = rgb(pc3_r, pc3_g, pc3_b)
        image rec = from med_art, 96, 96
        // D185: the grooves are the disc's own, inside its rim — the ring of bands reached past a 31 px
        // capsule and buried the cover; the bands are the capsule's aura now (D181), the disc keeps its
        // own light: two hairline grooves that breathe with the bass
        let beat = if(pill_still, 0, clamp((lv0 + lv1 + lv2) / 2.4, 0, 1))
        ellipse { at: cx, cy; radius: max(2, r - 1.6); stroke: 1.2; color: mix(c1, c3, 0.4); opacity: 0.5 + 0.35 * beat }
        ellipse { at: cx, cy; radius: max(1.5, r - 3.8); stroke: 1; color: mix(c2, c3, 0.5); opacity: 0.3 + 0.3 * beat }
        group {
            glow: 5, if(on, 0.5 * st_glow, 0), c1
            pivot: cx, cy
            rotate: if(mu_playing and not pill_still, mu_ang, 0) * 1deg
            ellipse { at: cx, cy; radius: r; color: mix(c3, c1, if(on, 0.2, 0)) }
            ellipse { at: cx, cy; radius: max(1, r - 1.6); color: mix(c3, fl.ground, 0.45) }
            image rec { at: cx - (r - 5.2), cy - (r - 5.2); size: max(2, (r - 5.2) * 2), max(2, (r - 5.2) * 2); show: med_has_art }
            ellipse { at: cx, cy; radius: 1.3; color: fl.engrave; opacity: 0.85 }
            box { from: cx - 0.7, cy - r + 2; size: 1.4, 3.2; corner: 0.7; color: fl.ink; opacity: 0.4; show: med_has_art }
        }
    }

    // D191: one of the glance face's workspace dots (ArchEclipse's PillDots): 5 px, the one you are on a
    // capsule 2.4 × as wide in the accent, a workspace with windows in the ink, an empty one in the trace.
    // Its own component so each dot keeps its own spring. Drawn only: a zone per dot would sit under the
    // Pill's own zone and split its hover, and the peek follows that hover (a press is the board).
    component GlanceDot(x: number, cy: number, on: bool, busy: bool) {
        size: 12, 5
        prop dw = 5 ~m.select
        follow dw = if(on, 12, 5)
        box { from: x, cy - 2.5; size: dw, 5; corner: 2.5; color: if(on, fl.phos, if(busy, fl.engrave, fl.trace)) }
    }

    // D191: ArchEclipse's rest face (PillBar's "rest" row): the workspace dots, the clock, and the live
    // chip — the song while a player has one (its title, the artist muted, a faint accent plate), else the
    // battery. 14 px between the three and at each end; lib/pill.glance_w measures the same.
    component GlanceFace(px: number, pw: number, cy: number) {
        size: pw, 26
        let n = pill_gl_n
        let dots_w = n * 10 - 5 + 7
        let x0 = px + 14 + dots_w + 14
        let x1 = x0 + 46 + 14
        let cw = max(24, px + pw - 14 - x1)
        for w in spaces {
            let dx = px + 14 + w.index * 10 + if(w.id > ws.active, 7, 0)
            group { show: w.index < n
                    GlanceDot(dx, cy, w.active, w.windows > 0) }
        }
        text clock.time { at: x0 + 23, cy; anchor: center; size: 14; weight: 700; family: "Exo 2"; color: fl.engrave }
        box { from: x1, cy - 12; size: cw, 24; corner: 12; color: fl.phos; opacity: if(mu_has, 0.16, 0) }
        let low = battery.present and battery.percent < 15 and not battery.charging
        let tw = if(mu_has and pill_gl_art, min(pill_gl_tw + 4, cw - 36), cw - 36)
        text "♪" { at: x1 + 11, cy; anchor: left center; size: 12; weight: 700; color: fl.phos; show: mu_has }
        text pick(battery.charging, "▮", "ϟ") { at: x1 + 11, cy; anchor: left center; size: 12; weight: 700; color: if(low, #a94545, fl.engrave); show: not mu_has }
        text mu_title { at: x1 + 25, cy; anchor: left center; size: 12; weight: 600; family: "Exo 2"; color: fl.engrave; width: max(1, tw); lines: 1; show: mu_has }
        text pick(battery.present, "—", "{battery.percent, 0}%") { at: x1 + 25, cy; anchor: left center; size: 12; weight: 600; family: "Exo 2"; color: fl.muted; width: max(1, tw); lines: 1; show: not mu_has }
        text mu_artist { at: x1 + 25 + tw + 7, cy; anchor: left center; size: 11; family: "Exo 2"; color: fl.muted
                         width: max(1, cw - 36 - tw - 7); lines: 1; show: mu_has and pill_gl_art and cw - 36 - tw > 20 }
    }

    component PillBody() {
        size: 1, 1
        group {
            show: pill_on
            // D188: opened, the capsule becomes the board (ui/pillboard.plm), so its face goes first — out
            // in the first fifth of the growth, back as the board folds into it
            opacity: 1 - smooth(0, 0.2, rv.board)
            // D187: the capsule never lifts, dims or changes form. What it shows changes; it does not.
            let px = pill_x
            let pw = pill_w
            let cy = fl.cy
            // D173: how near the pointer is (0 far, 1 on it) and how far the dot leans toward it
            let cx = px + pw / 2
            let near = clamp(1 - (abs(pointer.x - cx) + abs(pointer.y - cy)) / 190, 0, 1) * pill_warm
            let lean = clamp((pointer.x - cx) / 70, -1, 1) * 2.5 * near
            // D187: one light, and it is the sound's — a soft glow under the capsule's own foot. No band
            // inside it, no hairline over its top, no ring, no sweep, no flash: the effects D181 and D182
            // added read as noise on a capsule that is meant to sit still. Silent when nothing plays
            // (D131), with reduced motion, or with the theme's glow off.
            // D191: ArchEclipse's PillSpectrum in its default look (mirror, 45 % of the capsule, 55 %): the
            // song's bands rise from the capsule's foot behind what it shows, the bass in the middle fanning
            // out to both ends, solid at the edge and fading toward the words. It replaces D187's glow under
            // the foot: one light, still the sound's, and still silent when nothing plays (D131), with reduced
            // motion, while the capsule is hidden or has become the board.
            prop spec_f = 0 ~m.isl
            follow spec_f = if(mu_playing and not pill_still and not pill_hidden and not pill_vanish and rv.board < 0.02 and (pill_kind < 1.5 or pill_record), 1, 0)
            group {
                show: spec_f > 0.01
                opacity: spec_f * 0.55
                clip box { from: px, fl.top; size: max(1, pw), pill_h; corner: pill_h / 2 }
                repeat b in 0..16 {
                    let k = if(b < 8, 7 - b, b - 8)
                    let v = clamp(pick(k, lv0, lv1, lv2, lv3, lv4, lv5, lv6, lv7), 0, 1)
                    let bw = pw / 16
                    let bh = v * pill_h * 0.45
                    let fy = fl.top + pill_h
                    box { from: px + b * bw + 1, fy - bh; size: max(1, bw - 2), bh * 0.55; corner: 1; color: fl.phos; opacity: 0.35 }
                    box { from: px + b * bw + 1, fy - bh * 0.45; size: max(1, bw - 2), bh * 0.45; corner: 1; color: fl.phos; opacity: 0.95 }
                }
            }
            // idle: its face (D169) — the time and the workspace it is on, BMO, or the Nexus button;
            // nothing while it is hidden (a sliver the frame draws)
            group {
                show: pill_kind < 0.5 and not pill_split and not pill_hidden and not pill_record and pill_face < 0.5
                text clock.time { at: px + pw / 2 - 8 - if(pill_detail > 1.5, 30, 0), cy; anchor: center; size: 14; weight: 700; family: "Exo 2"; color: fl.engrave }
                text "· {ws.active, 0}" { at: px + pw / 2 + 26 - if(pill_detail > 1.5, 30, 0), cy; anchor: center; size: 11; family: "Share Tech Mono"; color: fl.phos }
                text clock.date { at: px + pw / 2 + 34, cy; anchor: left center; size: 11; family: "Share Tech Mono"; color: fl.muted; width: 90; lines: 1; show: pill_detail > 1.5 }
            }
            group {
                show: pill_kind < 0.5 and not pill_split and not pill_hidden and not pill_record and pill_face > 0.5 and pill_face < 1.5
                // D196: the capsule's glass is his screen (BmoScreen); D187 still holds — no body round it
                BmoScreen(px, pw, cy, pill_t1, pb_talk)
            }
            group {
                show: pill_kind < 0.5 and not pill_split and not pill_hidden and not pill_record and pill_face > 1.5 and pill_face < 2.5
                NexusFace(px, pw, cy)
            }
            // D170: a module's face — its icon and a short reading
            group {
                show: pill_kind < 0.5 and not pill_split and not pill_hidden and not pill_record and pill_face > 2.5 and pill_face < 10.5
                let fk = pick(pill_face - 3, 6, 3, 2, 12, 0, 13, 8, 2)
                // D171: icon — just the glyph, centred; brief and full — the glyph and its words
                PkIcon(fk, if(pill_detail < 0.5, px + pw / 2, px + 20), cy, 15, fl.phos)
                group {
                    show: pill_detail > 0.5
                    let tw = pw - 44
                    text pick(pill_detail > 1.5, "{wx_temp, 0}° {lower(wx_word)}", "{wx_temp, 0}° {lower(wx_word)} · {wx_city}") { at: px + 34, cy; anchor: left center; size: 12; weight: 600; family: "Exo 2"; color: fl.engrave; width: tw; lines: 1; show: pill_face == 3 }
                    text pick(pill_detail > 1.5, "CPU {round(res_cpu * 100), 0}% · {round(res_temp), 0}°C", "CPU {round(res_cpu * 100), 0}% · MEM {round(res_mem * 100), 0}% · {round(res_temp), 0}°C") { at: px + 34, cy; anchor: left center; size: 11; family: "Share Tech Mono"; color: fl.engrave; width: tw; lines: 1; show: pill_face == 4 }
                    text pick(mu_has, "Nothing playing", mu_title) { at: px + 34, cy; anchor: left center; size: 12; weight: 600; family: "Exo 2"; color: fl.engrave; width: tw; lines: 1; show: pill_face == 5 and pill_detail < 1.5 }
                    text "{mu_title}{? · {mu_artist}}" { at: px + 34, cy; anchor: left center; size: 12; weight: 600; family: "Exo 2"; color: fl.engrave; width: tw; lines: 1; show: pill_face == 5 and pill_detail > 1.5 and mu_has }
                    text pick(battery.present, "No battery", "{battery.percent, 0}%") { at: px + 34, cy; anchor: left center; size: 12; weight: 700; family: "Exo 2"; color: fl.engrave; width: tw; lines: 1; show: pill_face == 6 and pill_detail < 1.5 }
                    text pick(battery.charging, "{battery.percent, 0}% · on battery", "{battery.percent, 0}% · charging") { at: px + 34, cy; anchor: left center; size: 12; weight: 700; family: "Exo 2"; color: fl.engrave; width: tw; lines: 1; show: pill_face == 6 and pill_detail > 1.5 and battery.present }
                    // workspaces: a dot each, the one you are on lit (full: and its number)
                    // by each workspace's own place and state, not 1..count (review I2)
                    for w in spaces {
                        let wx = px + 34 + w.index * 12
                        ellipse { at: wx, cy; radius: if(w.active, 4, 2.6); color: if(w.active, fl.phos, if(w.windows > 0, fl.trace_lit, fl.trace)); show: pill_face == 7 and wx < px + pw - 10 }
                    }
                    text "{ws.active, 0}" { at: px + pw - 14, cy; anchor: right center; size: 11; family: "Share Tech Mono"; color: fl.phos; show: pill_face == 7 and pill_detail > 1.5 }
                    text pick(network.online, "Offline", network.name) { at: px + 34, cy; anchor: left center; size: 12; weight: 600; family: "Exo 2"; color: fl.engrave; width: tw - if(pill_detail > 1.5, 44, 0); lines: 1; show: pill_face == 8 }
                    text "{network.strength, 0}%" { at: px + pw - 14, cy; anchor: right center; size: 10; family: "Share Tech Mono"; color: fl.muted; show: pill_face == 8 and pill_detail > 1.5 and network.online }
                    // signals: how many (full: the newest, its app and title)
                    text "{loom_count, 0} signals" { at: px + 34, cy; anchor: left center; size: 12; weight: 600; family: "Exo 2"; color: fl.engrave; width: tw; lines: 1; show: pill_face == 9 and (pill_detail < 1.5 or not (pill_alert_on and loom_count > 0.5)) }
                    text pill_alert { at: px + 34, cy; anchor: left center; size: 12; weight: 600; family: "Exo 2"; color: fl.engrave; width: tw; lines: 1; show: pill_face == 9 and pill_detail > 1.5 and pill_alert_on and loom_count > 0.5 }
                    // the visualiser: the music's bands
                    group { show: pill_face == 10
                            viz.Spectrum(px + 34, cy - 8, pw - 48, 16, fl.phos, fl.ember) }
                }
            }
            // D191: ArchEclipse's rest face
            group {
                show: pill_kind < 0.5 and not pill_split and not pill_hidden and not pill_record and pill_face > 10.5
                GlanceFace(px, pw, cy)
            }
            // D173: the pointer's warmth behind the capsule — nearer is brighter, and never while it is gone
            group {
                show: not pill_hidden and not pill_record and near > 0.02
                glow: 9, (0.5 * near) * st_glow, fl.phos
                box { from: px + 2, cy - 2; size: max(4, pw - 4), 4; corner: 2; color: fl.phos; opacity: 0.3 * near }
            }
            // D188: the edge flash (ZenoShell's only effect, the owner's switch pill.ping): the capsule's own
            // edge lights in the accent for a moment when the workspace changes or a notice arrives, and
            // fades. It replaces D173's turning half disc — one switch, one effect.
            group {
                show: not pill_hidden and not pill_vanish and pill_ping and pill_turn_f > 0.02
                box { from: px + 0.5, fl.top + 0.5; size: max(1, pw - 1), pill_h - 1; corner: (pill_h - 1) / 2; stroke: 2; color: fl.phos; opacity: pill_turn_f }
            }
            // anything else, whole
            group {
                show: pill_kind > 0.5 and not pill_split and not pill_record
                Half(px, pw, pill_glyph, pill_t1, pill_t2, pill_val)
            }
            // split: the main on the left, its partner on the right, a pinch between
            group {
                show: pill_split
                Half(px, pill_w1, pill_glyph, pill_t1, pill_t2, pill_val)
                box { from: px + pill_w1 + 3, cy - 8; size: 2, 16; corner: 1; color: fl.trace_dim }
                Half(px + pill_w1 + 8, pw - pill_w1 - 8, pill_glyph2, pill_s1, "", pill_val2)
            }
            // D187: the record is the same capsule with the cover as its mark — not a disc that replaces
            // it. Never beside a split (lib/pill).
            group {
                show: pill_record
                Half(px, pw, 5, pill_t1, pill_t2, 0)
            }
            // hidden with the frame on, the tab hangs in the top strip: the zone reaches the top (review M5)
            // D171: the dot — a ring breathing out of it now and then, and room round it to land on
            let dotted = pill_hidden and pill_shape > 1.5
            let vanished = pill_hidden and pill_vanish      // D172: gone (pill.hide = vanish)
            let pf = pill_pulse / 360 - floor(pill_pulse / 360)
            group {
                show: dotted
                glow: 6, (0.6 * (1 - pf)) * st_glow, fl.phos
                ellipse { at: px + pw / 2 + lean, fl.cy; radius: 7 + 9 * pf; stroke: 1.4; color: fl.phos; opacity: 0.7 * (1 - pf) }
                ellipse { at: px + pw / 2 + lean, fl.cy; radius: 3; color: fl.phos }
            }
            // D172: vanished — nothing there, but a faint seam keeps its place on the bar to point at
            group {
                show: vanished
                line { from: px - 9, fl.cy; to: px + 9, fl.cy; width: 1.4; color: fl.trace_lit }
                ellipse { at: px, fl.cy; radius: 1.6; color: fl.phos; opacity: 0.6 }
            }
            zone box pillz { from: if(pill_vanish, px - 12, if(pill_record, px - 8, if(dotted, px - 10, px))), if(pill_hidden, 0, fl.top); size: if(pill_vanish, 24, if(pill_record, pw + 16, if(dotted, pw + 20, pw))), if(pill_hidden, fl.top + fl.mod_h, pill_h); cursor: pointer; role: button; label: "The Pill: open what it shows" }
            on press pillz { emit pill_press }
            // D170: the right press keeps the old jumps (the calendar, the player, the activity's island)
            on press right pillz { emit pill_rpress }
            // pointed at: 1, and 0 when the pointer leaves — a resting pointer keeps it open (review M4).
            // Once per crossing (D170): `on change pillz.hover` fired on every step of the hover's easing.
            let pz_in = pillz.hover > 0.5
            on change pz_in while pz_in { emit pill_hover(1) }
            on change pz_in while not pz_in { emit pill_hover(0) }
            // nodes (D169): each pad on a circuit trace to the one inside it, a via at each end
            group {
                show: pill_nodes
                group {
                    show: moon_k0 > -0.5
                    line { from: moon_x0 + 24, cy; to: px, cy; width: 1.6; color: fl.trace_lit }
                    ellipse { at: moon_x0 + 24, cy; radius: 2; color: fl.phos }
                    ellipse { at: px, cy; radius: 2; color: fl.phos }
                }
                group {
                    show: moon_k1 > -0.5
                    line { from: px + pw, cy; to: moon_x1, cy; width: 1.6; color: fl.trace_lit }
                    ellipse { at: px + pw, cy; radius: 2; color: fl.phos }
                    ellipse { at: moon_x1, cy; radius: 2; color: fl.phos }
                }
                group {
                    show: moon_k2 > -0.5
                    line { from: moon_x2 + 24, cy; to: moon_x0, cy; width: 1.6; color: fl.trace_lit }
                    ellipse { at: moon_x2 + 24, cy; radius: 2; color: fl.phos }
                }
                group {
                    show: moon_k3 > -0.5
                    line { from: moon_x1 + 24, cy; to: moon_x3, cy; width: 1.6; color: fl.trace_lit }
                    ellipse { at: moon_x3, cy; radius: 2; color: fl.phos }
                }
            }
            on scroll pillz { emit pill_scroll(wheel) }
            // the moons: a mark each, a press brings it into the Pill
            group {
                show: moon_f0 > 0.02
                opacity: moon_f0
                move: (1 - moon_f0) * 8, 0
                Mark(moon_x0 + 12, cy, max(0, moon_k0))
                zone box pmoon0 { from: moon_x0, cy - 12; size: 24, 24; cursor: pointer; role: button; label: "Show this in the Pill" }
                on press pmoon0 { emit pill_moon(0) }
                on press right pmoon0 { emit pill_rmoon(0) }
            }
            group {
                show: moon_f1 > 0.02
                opacity: moon_f1
                move: (1 - moon_f1) * -8, 0
                Mark(moon_x1 + 12, cy, max(0, moon_k1))
                zone box pmoon1 { from: moon_x1, cy - 12; size: 24, 24; cursor: pointer; role: button; label: "Show this in the Pill" }
                on press pmoon1 { emit pill_moon(1) }
                on press right pmoon1 { emit pill_rmoon(1) }
            }
            group {
                show: moon_f2 > 0.02
                opacity: moon_f2
                move: (1 - moon_f2) * 8, 0
                Mark(moon_x2 + 12, cy, max(0, moon_k2))
                zone box pmoon2 { from: moon_x2, cy - 12; size: 24, 24; cursor: pointer; role: button; label: "Show this in the Pill" }
                on press pmoon2 { emit pill_moon(2) }
                on press right pmoon2 { emit pill_rmoon(2) }
            }
            group {
                show: moon_f3 > 0.02
                opacity: moon_f3
                move: (1 - moon_f3) * -8, 0
                Mark(moon_x3 + 12, cy, max(0, moon_k3))
                zone box pmoon3 { from: moon_x3, cy - 12; size: 24, 24; cursor: pointer; role: button; label: "Show this in the Pill" }
                on press pmoon3 { emit pill_moon(3) }
                on press right pmoon3 { emit pill_rmoon(3) }
            }
        }
    }
}
