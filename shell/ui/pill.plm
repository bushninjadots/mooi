language 0.9

// The Pill's content (D168): what the capsule at the top centre shows, drawn by the bar's scene over
// the body mooi-frame draws for it (lib/chassis). shell/bar.luau feeds the facts from lib/pill:
//   pill_kind  0 idle · 1 music · 2 osd · 3 notify · 4 record · 5 battery
//   pill_glyph 0 idle · 1 music · 2 vol · 3 bri · 4 notify · 5 record · 6 low · 7 charging
// with the first and second lines (pill_t1, pill_t2), a value (pill_val), a split partner on the right
// (pill_split, pill_glyph2, pill_s1, pill_val2 from pill_w1 on) and up to four moons (moon_x*, moon_k*).
// The visualiser's bars are ui/viz.plm's, read from the scene's bands like every other.

import "viz.plm" as viz

library Pill {
    // A mark for an activity, centred at (cx, cy): bars for music, a dot for the rest, coloured by what it is.
    component Mark(cx: number, cy: number, g: number) {
        size: 18, 18
        group {
            show: g > 0.5 and g < 1.5
            viz.Spectrum(cx - 9, cy - 7, 18, 14, fl.phos, fl.ember)
        }
        ellipse { at: cx, cy; radius: 4; color: pick(g, fl.trace_lit, fl.phos, fl.phos, fl.ember, fl.phos, #e05a5a, fl.ember, fl.phos); show: g < 0.5 or g > 1.5 }
        ellipse { at: cx, cy; radius: 6.5; stroke: 1.2; color: #e05a5a; opacity: 0.5; show: g > 4.5 and g < 5.5 }
    }

    // One half (or the whole) of the Pill: its mark, its words, and for a volume or brightness change
    // a track filled to the value.
    component Half(x: number, w: number, g: number, t1: text, t2: text, v: number) {
        size: w, fl.mod_h
        let cy = fl.cy
        Mark(x + 18, cy, g)
        group {
            show: g < 1.5 or g > 3.5
            // the line and its second part (the artist, a notice's summary): the width counts both (review M1)
            text "{t1}{? · {t2}}" { at: x + 34, cy; anchor: left center; size: 12; weight: 600; family: "Exo 2"; color: fl.engrave; width: w - 44; lines: 1 }
        }
        group {
            show: g > 1.5 and g < 3.5
            text t1 { at: x + 34, cy; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.muted }
            box { from: x + 64, cy - 2; size: max(4, w - 104), 4; corner: 2; color: fl.well }
            box { from: x + 64, cy - 2; size: max(0, (w - 104) * v), 4; corner: 2; color: fl.phos }
            text t2 { at: x + w - 14, cy; anchor: right center; size: 11; weight: 600; family: "Exo 2"; color: fl.engrave }
        }
    }

    // BMO's face on his own small screen (D169), 48 × 22 at (fx, fy): bmo/brain's numbers at 0.42 of
    // the desktop BMO's face, eyes pulled toward the pointer (pb_lx, pb_ly), the blink (pb_open).
    component BmoFace(fx: number, fy: number) {
        // D170: the desktop BMO's own face (bmo/bmo.plm's screen) at 50 × 34: drawn in its 96 × 66 units and
        // scaled, so every expression is the same drawing — eyes with their shine, ^ when happy-shut, brows,
        // a mouth of two curves that opens into a D or an O, the tongue, the blush. Singing, his mouth opens
        // on the bass and his head bobs.
        size: 50, 34
        let ink = #183d42
        let glass = #b8f5df
        let bass = clamp((lv0 + lv1 + lv2) / 3, 0, 1)
        let mo = if(pb_sing, 0.15 + 0.85 * bass, pbm_o)
        let lx = pb_lx
        let ly = pb_ly
        let shut = min(1, pb_lidf + 1 - pb_open)
        let eh = pbe_h
        let ew = pbe_w
        let eye_h = max(2.5, eh * (1 - shut))
        let mx = 48 + lx * 0.3
        let half = pbm_w / 2
        let bend = pbm_c * 8
        let upper = 46 + bend * 0.55 - mo * 7 * (1 - max(0, pbm_c))
        let lower = 46 + bend + mo * 13
        group {
            move: fx, fy - if(pb_sing, bass * 1.5, 0)
            pivot: 0, 0
            scale: 50 / 96
            box { from: 0, 0; size: 96, 66; corner: 9; color: ink }
            box { from: 2, 2; size: 92, 62; corner: 7; color: glass }
            box { from: 6, 5; size: 84, 6; corner: 3; color: #ffffff; opacity: 0.22 }
            ellipse { at: 18, 39; radius: 6.5; scale: 1, 0.46; color: #f28aa0; opacity: pb_blf * 0.55 }
            ellipse { at: 78, 39; radius: 6.5; scale: 1, 0.46; color: #f28aa0; opacity: pb_blf * 0.55 }
            box { from: 30 + lx - ew / 2, 26 + ly + eh / 2 - eye_h; size: ew, eye_h; corner: min(ew, eye_h) / 2; color: ink; opacity: 1 - pb_sqlf }
            box { from: 66 + lx - ew / 2, 26 + ly + eh / 2 - eye_h; size: ew, eye_h; corner: min(ew, eye_h) / 2; color: ink; opacity: 1 - pb_sqrf }
            box { from: 30 + lx + ew / 2 - 4, 26 + ly + eh / 2 - eye_h + 2.5; size: 2.5, 2.5; corner: 1.25; color: glass; opacity: 0.85 * (1 - pb_sqlf); show: eye_h > 8 }
            box { from: 66 + lx + ew / 2 - 4, 26 + ly + eh / 2 - eye_h + 2.5; size: 2.5, 2.5; corner: 1.25; color: glass; opacity: 0.85 * (1 - pb_sqrf); show: eye_h > 8 }
            path { stroke: 3; color: ink; opacity: pb_sqlf
                   move 24 + lx, 29 + ly; curve 36 + lx, 29 + ly via 30 + lx, 20 + ly }
            path { stroke: 3; color: ink; opacity: pb_sqrf
                   move 60 + lx, 29 + ly; curve 72 + lx, 29 + ly via 66 + lx, 20 + ly }
            box { at: 30 + lx, 26 + ly - eh / 2 - 6; size: 12, 3; corner: 1.5; rotate: -pb_browf * 1deg; color: ink; opacity: pb_bronf }
            box { at: 66 + lx, 26 + ly - eh / 2 - 6; size: 12, 3; corner: 1.5; rotate: pb_browf * 1deg; color: ink; opacity: pb_bronf }
            path { color: ink; opacity: min(1, mo * 4)
                   move mx - half, 46; curve mx + half, 46 via mx, lower; curve mx - half, 46 via mx, upper; close }
            path { stroke: 3.2; color: ink
                   move mx - half, 46; curve mx + half, 46 via mx, lower }
            path { stroke: 3.2; color: ink; opacity: min(1, mo * 4)
                   move mx - half, 46; curve mx + half, 46 via mx, upper }
            ellipse { at: mx + 3, (46 + lower) / 2 + 2; radius: 4.5; scale: 1, 0.66; color: #ef7f93; opacity: pb_tgf * if(mo > 0.25, 1, 0) }
            // asleep: a z drifting up from the corner of his screen
            text "z" { at: 82, 18 - (pk_flow2 - floor(pk_flow2 / 14) * 14); anchor: center; size: 13; family: "Share Tech Mono"; color: ink; opacity: 0.7; show: pb_asleep }
        }
    }

    // The Control Nexus as the Pill's face (D169): its mark (a hub and three nodes) and its name, lit
    // while the Nexus is open.
    component NexusFace(x: number, w: number, cy: number) {
        size: w, 20
        let lit = if(nexus_open, 1, 0)
        let cx = x + w / 2 - 22
        line { from: cx, cy; to: cx - 7, cy - 5; width: 1.2; color: fl.trace_lit }
        line { from: cx, cy; to: cx + 7, cy - 5; width: 1.2; color: fl.trace_lit }
        line { from: cx, cy; to: cx, cy + 7; width: 1.2; color: fl.trace_lit }
        ellipse { at: cx, cy; radius: 3.2; color: mix(fl.phos, fl.ember, lit) }
        ellipse { at: cx - 7, cy - 5; radius: 1.8; color: fl.phos }
        ellipse { at: cx + 7, cy - 5; radius: 1.8; color: fl.phos }
        ellipse { at: cx, cy + 7; radius: 1.8; color: fl.phos }
        text "NEXUS" { at: cx + 14, cy; anchor: left center; size: 12; weight: 700; family: "Exo 2"; color: mix(fl.engrave, fl.ember, lit) }
    }

    component PillBody() {
        size: 1, 1
        group {
            show: pill_on
            let px = pill_x
            let pw = pill_w
            let cy = fl.cy
            // idle: its face (D169) — the time and the workspace it is on, BMO, or the Nexus button;
            // nothing while it is hidden (a sliver the frame draws)
            group {
                show: pill_kind < 0.5 and not pill_split and not pill_hidden and pill_face < 0.5
                text clock.time { at: px + pw / 2 - 8 - if(pill_detail > 1.5, 30, 0), cy; anchor: center; size: 14; weight: 700; family: "Exo 2"; color: fl.engrave }
                text "· {ws.active, 0}" { at: px + pw / 2 + 26 - if(pill_detail > 1.5, 30, 0), cy; anchor: center; size: 11; family: "Share Tech Mono"; color: fl.phos }
                text clock.date { at: px + pw / 2 + 34, cy; anchor: left center; size: 11; family: "Share Tech Mono"; color: fl.muted; width: 90; lines: 1; show: pill_detail > 1.5 }
            }
            group {
                show: pill_kind < 0.5 and not pill_split and not pill_hidden and pill_face > 0.5 and pill_face < 1.5
                // D171: BMO as BMO — his teal body round the screen, a little D-pad and two buttons
                box { from: px + 3, fl.top + 1; size: 66, pill_h - 2; corner: 7; color: #69c7bb }
                box { from: px + 3, fl.top + 1; size: 66, pill_h - 2; corner: 7; stroke: 1.2; color: #183d42; opacity: 0.6 }
                box { from: px + 5, fl.top + 2.5; size: 62, 2; corner: 1; color: #ffffff; opacity: 0.25 }
                box { at: px + 62, fl.top + 12; size: 8, 2.6; corner: 1; color: #f1c94a }
                box { at: px + 62, fl.top + 12; size: 2.6, 8; corner: 1; color: #f1c94a }
                ellipse { at: px + 61, fl.top + 24; radius: 2.2; color: #e9606f }
                ellipse { at: px + 65.5, fl.top + 29; radius: 1.7; color: #5aa7e0 }
                ellipse { at: px + 60, fl.top + 31.5; radius: 1.4; color: #7bd66a }
                BmoFace(px + 6, fl.top + (pill_h - 34) / 2)
                text pill_t1 { at: px + 68, fl.top + pill_h / 2; anchor: left center; size: 12; weight: 600; family: "Exo 2"; color: fl.engrave; width: max(1, pw - 76); lines: 1 }
            }
            group {
                show: pill_kind < 0.5 and not pill_split and not pill_hidden and pill_face > 1.5 and pill_face < 2.5
                NexusFace(px, pw, cy)
            }
            // D170: a module's face — its icon and a short reading
            group {
                show: pill_kind < 0.5 and not pill_split and not pill_hidden and pill_face > 2.5
                let fk = pick(pill_face - 3, 6, 3, 2, 12, 0, 13, 8, 2)
                // D171: icon — just the glyph, centred; brief and full — the glyph and its words
                PkIcon(fk, if(pill_detail < 0.5, px + pw / 2, px + 20), cy, 15, fl.phos)
                group {
                    show: pill_detail > 0.5
                    let tw = pw - 44
                    text pick(pill_detail > 1.5, "{wx_temp, 0}° {lower(wx_word)}", "{wx_temp, 0}° {lower(wx_word)} · {wx_city}") { at: px + 34, cy; anchor: left center; size: 12; weight: 600; family: "Exo 2"; color: fl.engrave; width: tw; lines: 1; show: pill_face == 3 }
                    text pick(pill_detail > 1.5, "CPU {round(res_cpu * 100), 0}% · {round(res_temp), 0}°C", "CPU {round(res_cpu * 100), 0}% · MEM {round(res_mem * 100), 0}% · {round(res_temp), 0}°C") { at: px + 34, cy; anchor: left center; size: 11; family: "Share Tech Mono"; color: fl.engrave; width: tw; lines: 1; show: pill_face == 4 }
                    text pick(mu_has, "Nothing playing", mu_title) { at: px + 34, cy; anchor: left center; size: 12; weight: 600; family: "Exo 2"; color: fl.engrave; width: tw; lines: 1; show: pill_face == 5 and pill_detail < 1.5 }
                    text "{mu_title}{? · {mu_artist}}" { at: px + 34, cy; anchor: left center; size: 12; weight: 600; family: "Exo 2"; color: fl.engrave; width: tw; lines: 1; show: pill_face == 5 and pill_detail > 1.5 and mu_has }
                    text pick(battery.present, "No battery", "{battery.percent, 0}%") { at: px + 34, cy; anchor: left center; size: 12; weight: 700; family: "Exo 2"; color: fl.engrave; width: tw; lines: 1; show: pill_face == 6 and pill_detail < 1.5 }
                    text pick(battery.charging, "{battery.percent, 0}% · on battery", "{battery.percent, 0}% · charging") { at: px + 34, cy; anchor: left center; size: 12; weight: 700; family: "Exo 2"; color: fl.engrave; width: tw; lines: 1; show: pill_face == 6 and pill_detail > 1.5 and battery.present }
                    // workspaces: a dot each, the one you are on lit (full: and its number)
                    // by each workspace's own place and state, not 1..count (review I2)
                    for w in spaces {
                        let wx = px + 34 + w.index * 12
                        ellipse { at: wx, cy; radius: if(w.active, 4, 2.6); color: if(w.active, fl.phos, if(w.windows > 0, fl.trace_lit, fl.trace)); show: pill_face == 7 and wx < px + pw - 10 }
                    }
                    text "{ws.active, 0}" { at: px + pw - 14, cy; anchor: right center; size: 11; family: "Share Tech Mono"; color: fl.phos; show: pill_face == 7 and pill_detail > 1.5 }
                    text pick(network.online, "Offline", network.name) { at: px + 34, cy; anchor: left center; size: 12; weight: 600; family: "Exo 2"; color: fl.engrave; width: tw - if(pill_detail > 1.5, 44, 0); lines: 1; show: pill_face == 8 }
                    text "{network.strength, 0}%" { at: px + pw - 14, cy; anchor: right center; size: 10; family: "Share Tech Mono"; color: fl.muted; show: pill_face == 8 and pill_detail > 1.5 and network.online }
                    // signals: how many (full: the newest, its app and title)
                    text "{loom_count, 0} signals" { at: px + 34, cy; anchor: left center; size: 12; weight: 600; family: "Exo 2"; color: fl.engrave; width: tw; lines: 1; show: pill_face == 9 and (pill_detail < 1.5 or not (pill_alert_on and loom_count > 0.5)) }
                    text pill_alert { at: px + 34, cy; anchor: left center; size: 12; weight: 600; family: "Exo 2"; color: fl.engrave; width: tw; lines: 1; show: pill_face == 9 and pill_detail > 1.5 and pill_alert_on and loom_count > 0.5 }
                    // the visualiser: the music's bands
                    group { show: pill_face == 10
                            viz.Spectrum(px + 34, cy - 8, pw - 48, 16, fl.phos, fl.ember) }
                }
            }
            // anything else, whole
            group {
                show: pill_kind > 0.5 and not pill_split
                Half(px, pw, pill_glyph, pill_t1, pill_t2, pill_val)
            }
            // split: the main on the left, its partner on the right, a pinch between
            group {
                show: pill_split
                Half(px, pill_w1, pill_glyph, pill_t1, pill_t2, pill_val)
                box { from: px + pill_w1 + 3, cy - 8; size: 2, 16; corner: 1; color: fl.trace_dim }
                Half(px + pill_w1 + 8, pw - pill_w1 - 8, pill_glyph2, pill_s1, "", pill_val2)
            }
            // hidden with the frame on, the tab hangs in the top strip: the zone reaches the top (review M5)
            // D171: the dot — a ring breathing out of it now and then, and room round it to land on
            let dotted = pill_hidden and pill_shape > 1.5
            let pf = pill_pulse / 360 - floor(pill_pulse / 360)
            group {
                show: dotted
                glow: 6, (0.6 * (1 - pf)) * st_glow, fl.phos
                ellipse { at: px + pw / 2, fl.cy; radius: 7 + 9 * pf; stroke: 1.4; color: fl.phos; opacity: 0.7 * (1 - pf) }
                ellipse { at: px + pw / 2, fl.cy; radius: 3; color: fl.phos }
            }
            zone box pillz { from: if(dotted, px - 10, px), if(pill_hidden, 0, fl.top); size: if(dotted, pw + 20, pw), if(pill_hidden, fl.top + fl.mod_h, pill_h); cursor: pointer; role: button; label: "The Pill: open what it shows" }
            on press pillz { emit pill_press }
            // D170: the right press keeps the old jumps (the calendar, the player, the activity's island)
            on press right pillz { emit pill_rpress }
            // pointed at: 1, and 0 when the pointer leaves — a resting pointer keeps it open (review M4).
            // Once per crossing (D170): `on change pillz.hover` fired on every step of the hover's easing.
            let pz_in = pillz.hover > 0.5
            on change pz_in while pz_in { emit pill_hover(1) }
            on change pz_in while not pz_in { emit pill_hover(0) }
            // nodes (D169): each pad on a circuit trace to the one inside it, a via at each end
            group {
                show: pill_nodes
                group {
                    show: moon_k0 > -0.5
                    line { from: moon_x0 + 24, cy; to: px, cy; width: 1.6; color: fl.trace_lit }
                    ellipse { at: moon_x0 + 24, cy; radius: 2; color: fl.phos }
                    ellipse { at: px, cy; radius: 2; color: fl.phos }
                }
                group {
                    show: moon_k1 > -0.5
                    line { from: px + pw, cy; to: moon_x1, cy; width: 1.6; color: fl.trace_lit }
                    ellipse { at: px + pw, cy; radius: 2; color: fl.phos }
                    ellipse { at: moon_x1, cy; radius: 2; color: fl.phos }
                }
                group {
                    show: moon_k2 > -0.5
                    line { from: moon_x2 + 24, cy; to: moon_x0, cy; width: 1.6; color: fl.trace_lit }
                    ellipse { at: moon_x2 + 24, cy; radius: 2; color: fl.phos }
                }
                group {
                    show: moon_k3 > -0.5
                    line { from: moon_x1 + 24, cy; to: moon_x3, cy; width: 1.6; color: fl.trace_lit }
                    ellipse { at: moon_x3, cy; radius: 2; color: fl.phos }
                }
            }
            on scroll pillz { emit pill_scroll(wheel) }
            // the moons: a mark each, a press brings it into the Pill
            group {
                show: moon_k0 > -0.5
                Mark(moon_x0 + 12, cy, moon_k0)
                zone box pmoon0 { from: moon_x0, cy - 12; size: 24, 24; cursor: pointer; role: button; label: "Show this in the Pill" }
                on press pmoon0 { emit pill_moon(0) }
                on press right pmoon0 { emit pill_rmoon(0) }
            }
            group {
                show: moon_k1 > -0.5
                Mark(moon_x1 + 12, cy, moon_k1)
                zone box pmoon1 { from: moon_x1, cy - 12; size: 24, 24; cursor: pointer; role: button; label: "Show this in the Pill" }
                on press pmoon1 { emit pill_moon(1) }
                on press right pmoon1 { emit pill_rmoon(1) }
            }
            group {
                show: moon_k2 > -0.5
                Mark(moon_x2 + 12, cy, moon_k2)
                zone box pmoon2 { from: moon_x2, cy - 12; size: 24, 24; cursor: pointer; role: button; label: "Show this in the Pill" }
                on press pmoon2 { emit pill_moon(2) }
                on press right pmoon2 { emit pill_rmoon(2) }
            }
            group {
                show: moon_k3 > -0.5
                Mark(moon_x3 + 12, cy, moon_k3)
                zone box pmoon3 { from: moon_x3, cy - 12; size: 24, 24; cursor: pointer; role: button; label: "Show this in the Pill" }
                on press pmoon3 { emit pill_moon(3) }
                on press right pmoon3 { emit pill_rmoon(3) }
            }
        }
    }
}
