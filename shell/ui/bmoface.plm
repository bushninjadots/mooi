language 0.9

// BMO's face (D170, D196, D209): the desktop BMO's own face (bmo/bmo.plm's screen) at 50 × 34, for the bar's BMO
// module. It was the classic Pill's (ui/pill.plm) until the Pill became the node (D226); the bar's scene feeds the
// facts it reads (pb_*, pbm_*, pbe_*, the bass's lv0 … lv2).

library BmoFaceLib {
    component BmoFace(fx: number, fy: number, framed: bool = true, s: number = 1, ex: number = pb_lx, ey: number = pb_ly) {
        // D170: the desktop BMO's own face (bmo/bmo.plm's screen) at 50 × 34: drawn in its 96 × 66 units and
        // scaled, so every expression is the same drawing — eyes with their shine, ^ when happy-shut, brows,
        // a mouth of two curves that opens into a D or an O, the tongue, the blush. Singing, his mouth opens
        // on the bass and his head bobs. `s` scales it for the bar module (D209).
        size: 50 * s, 34 * s
        let ink = #183d42
        let glass = #b8f5df
        let bass = clamp((lv0 + lv1 + lv2) / 3, 0, 1)
        let mo = if(pb_sing, 0.15 + 0.85 * bass, pbm_o)
        let lx = ex
        let ly = ey
        let shut = min(1, pb_lidf + 1 - pb_open)
        let eh = pbe_h
        let ew = pbe_w
        let eye_h = max(2.5, eh * (1 - shut))
        let mx = 48 + lx * 0.3
        let half = pbm_w / 2
        let bend = pbm_c * 8
        let upper = 46 + bend * 0.55 - mo * 7 * (1 - max(0, pbm_c))
        let lower = 46 + bend + mo * 13
        group {
            move: fx, fy - if(pb_sing, bass * 1.5, 0)
            pivot: 0, 0
            scale: (50 / 96) * s
            // D196: framed, his own screen; unframed, the face alone (drawn on the capsule's glass, BmoScreen)
            box { from: 0, 0; size: 96, 66; corner: 9; color: ink; show: framed }
            box { from: 2, 2; size: 92, 62; corner: 7; color: glass; show: framed }
            box { from: 6, 5; size: 84, 6; corner: 3; color: #ffffff; opacity: 0.22; show: framed }
            ellipse { at: 18, 39; radius: 6.5; scale: 1, 0.46; color: #f28aa0; opacity: pb_blf * 0.55 }
            ellipse { at: 78, 39; radius: 6.5; scale: 1, 0.46; color: #f28aa0; opacity: pb_blf * 0.55 }
            box { from: 30 + lx - ew / 2, 26 + ly + eh / 2 - eye_h; size: ew, eye_h; corner: min(ew, eye_h) / 2; color: ink; opacity: 1 - pb_sqlf }
            box { from: 66 + lx - ew / 2, 26 + ly + eh / 2 - eye_h; size: ew, eye_h; corner: min(ew, eye_h) / 2; color: ink; opacity: 1 - pb_sqrf }
            box { from: 30 + lx + ew / 2 - 4, 26 + ly + eh / 2 - eye_h + 2.5; size: 2.5, 2.5; corner: 1.25; color: glass; opacity: 0.85 * (1 - pb_sqlf); show: eye_h > 8 }
            box { from: 66 + lx + ew / 2 - 4, 26 + ly + eh / 2 - eye_h + 2.5; size: 2.5, 2.5; corner: 1.25; color: glass; opacity: 0.85 * (1 - pb_sqrf); show: eye_h > 8 }
            path { stroke: 3; color: ink; opacity: pb_sqlf
                   move 24 + lx, 29 + ly; curve 36 + lx, 29 + ly via 30 + lx, 20 + ly }
            path { stroke: 3; color: ink; opacity: pb_sqrf
                   move 60 + lx, 29 + ly; curve 72 + lx, 29 + ly via 66 + lx, 20 + ly }
            box { at: 30 + lx, 26 + ly - eh / 2 - 6; size: 12, 3; corner: 1.5; rotate: -pb_browf * 1deg; color: ink; opacity: pb_bronf }
            box { at: 66 + lx, 26 + ly - eh / 2 - 6; size: 12, 3; corner: 1.5; rotate: pb_browf * 1deg; color: ink; opacity: pb_bronf }
            path { color: ink; opacity: min(1, mo * 4)
                   move mx - half, 46; curve mx + half, 46 via mx, lower; curve mx - half, 46 via mx, upper; close }
            path { stroke: 3.2; color: ink
                   move mx - half, 46; curve mx + half, 46 via mx, lower }
            path { stroke: 3.2; color: ink; opacity: min(1, mo * 4)
                   move mx - half, 46; curve mx + half, 46 via mx, upper }
            ellipse { at: mx + 3, (46 + lower) / 2 + 2; radius: 4.5; scale: 1, 0.66; color: #ef7f93; opacity: pb_tgf * if(mo > 0.25, 1, 0) }
            // asleep: a z drifting up from the corner of his screen
            text "z" { at: 82, 18 - (pk_flow2 - floor(pk_flow2 / 14) * 14); anchor: center; size: 13; family: "Share Tech Mono"; color: ink; opacity: 0.7; show: pb_asleep }
        }
    }
}
