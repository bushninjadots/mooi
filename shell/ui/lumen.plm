language 0.4
import "../theme/tokens.plm"
import "../theme/ferrolume.plm"

// Lumen's pieces (the wallpaper studio): machined plates, a compact slider, a vibe row, a
// palette swatch and a source tile. As in ui/loom.plm, nothing here decides anything: a row
// is given the values and the events it emits, and shell/mooi-wallpaper.luau keeps the state.

library Lumen {

    // A chamfered plate: two opposite corners cut, a hairline edge and a top highlight.
    component Plate(x: number, y: number, w: number, h: number, cut: number, fill: color, edge: color, op: number = 0.9) {
        size: w, h
        let k = clamp(cut, 0, min(w, h) / 2)
        path { color: fill; opacity: op
               move x + k, y; line x + w, y; line x + w, y + h - k; line x + w - k, y + h; line x, y + h; line x, y + k; close }
        path { stroke: 1; color: edge; opacity: min(1, op + 0.08)
               move x + k, y; line x + w, y; line x + w, y + h - k; line x + w - k, y + h; line x, y + h; line x, y + k; close }
        line { from: x + k + 1, y + 1; to: x + w - 2, y + 1; width: 1; color: fl.steel_300; opacity: 0.16 }
    }

    // A slider: its label, a track with its notches, a steel knob, and the value in a well.
    // A press or a drag sets it (never a mere hover); the wheel steps it. `press` gets
    // code * 1000 + offset, as the settings window's sliders do.
    component Slider(x: number, y: number, w: number, label: text, v: number, span: number, press: event, code: number, shown: text) {
        size: w + 78, 46
        text "{upper(label)}" { at: x, y; anchor: left center; size: 9; family: "Share Tech Mono"; color: fl.muted }
        zone box hit { from: x - 8, y + 14; size: w + 16, 30; cursor: pointer; role: slider; label: label; value: v / max(span, 1) }
        let at = round(clamp((pointer.x - x) / w, 0, 1) * span)
        let cur = if(hit.pressed > 0.5, at, v)
        let kx = x + w * clamp(cur / max(span, 1), 0, 1)
        box { from: x, y + 30; size: w, 3; corner: 1; color: fl.ground }
        box { from: x, y + 30; size: w, 3; corner: 1; stroke: 1; color: fl.steel_700 }
        repeat t in 0..8 {
            box { from: x + w * t / 8 - 0.5, y + 39; size: 1, if(t == 0 or t == 4 or t == 8, 4, 2); color: fl.steel_500 }
        }
        group {
            glow: 5, 0.8, fl.phos
            box { from: x, y + 31; size: max(0, kx - x), 1.5; corner: 1; color: fl.phos }
        }
        body {
            gradient: 0, y + 24 to 0, y + 42, fl.steel_300, fl.steel_500 35%, fl.steel_700
            box { at: kx, y + 32; size: 2, 16; corner: 1 }
        }
        box { at: kx, y + 33; size: 1, 9; color: mix(fl.phos, fl.flare, hit.hover) }
        box { from: x + w + 16, y + 20; size: 60, 22; corner: 3; color: fl.ground }
        box { from: x + w + 16, y + 20; size: 60, 22; corner: 3; stroke: 1; color: fl.steel_700 }
        text shown { at: x + w + 46, y + 31; anchor: center; size: 11; weight: 600; family: "Share Tech Mono"; color: fl.phos }
        on press hit { emit press(code * 1000 + round(clamp((local.x - x) / w, 0, 1) * span)) }
        on drag hit { emit press(code * 1000 + round(clamp((local.x - x) / w, 0, 1) * span)) }
        on scroll hit { emit press(code * 1000 + clamp(v + wheel * max(1, round(span / 40)), 0, span)) }
    }

    // A button: a cut plate; solid in its tone (an action that matters), or drawn (the way out).
    component Button(x: number, y: number, w: number, h: number, label: text, tone: color, solid: bool, press: event, n: number, en: bool = true) {
        size: w, h
        opacity: if(en, 1, 0.4)
        zone box hit { from: x, y; size: w, h; cursor: pointer; role: button; label: label; active: en }
        path { color: if(solid, tone, mix(fl.hull_raised, fl.well, 0.55 * hit.hover)); opacity: 0.96
               move x + 7, y; line x + w, y; line x + w, y + h - 7; line x + w - 7, y + h; line x, y + h; line x, y + 7; close }
        path { stroke: 1; color: mix(if(solid, mix(tone, fl.flare, 0.35), fl.trace), tone, hit.hover)
               move x + 7, y; line x + w, y; line x + w, y + h - 7; line x + w - 7, y + h; line x, y + h; line x, y + 7; close }
        text label { at: x + w / 2, y + h / 2; anchor: center; size: 10; weight: 700; family: "Share Tech Mono"
                     color: if(solid, fl.ink, mix(fl.engrave, tone, max(hit.hover, 0.6))) }
        on press hit { emit press(n) }
    }

    // A tab over the grade dock: its name, and a lit rule while it is the one shown.
    component Tab(x: number, y: number, w: number, label: text, press: event, n: number, on: bool) {
        size: w, 30
        zone box hit { from: x, y; size: w, 30; cursor: pointer; role: tab; label: label; selected: on }
        text label { at: x + w / 2, y + 13; anchor: center; size: 10; weight: 600; family: "Share Tech Mono"
                     color: if(on, fl.phos, mix(fl.muted, fl.engrave, hit.hover)) }
        box { from: x, y + 27; size: w, 2; color: fl.ember; opacity: if(on, 1, 0) }
        on press hit { emit press(n) }
    }

    // A backdrop: the colour or effect it fills the matte with (its own swatch), its name, the
    // hex it is, and a lit rule while it is the one in use.
    component BGMode(x: number, y: number, w: number, h: number, c: color, label: text, hex: text, on: bool, press: event, n: number) {
        size: w, h
        zone box hit { from: x, y; size: w, h; cursor: pointer; role: toggle; label: label; selected: on }
        box { from: x, y; size: w, h; corner: 3; color: mix(fl.hull_raised, fl.well, 0.5 * hit.hover); opacity: 0.9 }
        box { from: x, y; size: w, h; corner: 3; stroke: if(on, 2, 1); color: if(on, fl.ember, fl.trace_dim) }
        box { from: x + 5, y + 5; size: min(h - 10, 20), min(h - 10, 20); corner: 2; color: c }
        box { from: x + 5, y + 5; size: min(h - 10, 20), min(h - 10, 20); corner: 2; stroke: 1; color: mix(c, fl.phos, 0.4) }
        text label { at: x + 32, y + h / 2; anchor: left center; size: 9; weight: 600; family: "Share Tech Mono"
                      color: if(on, fl.phos, mix(fl.engrave, fl.phos, hit.hover)) }
        text hex { at: x + w - 8, y + h / 2; anchor: right center; size: 8; family: "Share Tech Mono"; color: fl.muted }
        box { from: x, y + h - 2; size: w, 2; color: fl.ember; opacity: if(on, 1, 0) }
        on press hit { emit press(n) }
    }

    // A colour of the backdrop's palette (D63): the colour itself, a lit rule while it is the fill,
    // and the hex it is — a press fills the picture's background with it.
    component ColorSwatch(x: number, y: number, w: number, h: number, c: color, hex: text, on: bool, press: event, n: number) {
        size: w, h
        zone box hit { from: x, y; size: w, h; cursor: pointer; role: toggle; label: hex; selected: on }
        box { from: x, y; size: w, h; corner: 3; color: c }
        box { from: x, y; size: w, h; corner: 3; stroke: if(on, 2, 1)
              color: if(on, fl.ember, mix(fl.trace_dim, fl.engrave, 0.35 * hit.hover)) }
        box { from: x, y + h - 2; size: w, 2; color: fl.ember; opacity: if(on, 1, 0) }
        on press hit { emit press(n) }
    }

    // A switch in the backdrop row (the background key): its name, ON or OFF, and a lit rule while
    // it is on.
    component KeyToggle(x: number, y: number, w: number, h: number, label: text, on: bool, press: event) {
        size: w, h
        zone box hit { from: x, y; size: w, h; cursor: pointer; role: toggle; label: label; selected: on }
        box { from: x, y; size: w, h; corner: 3; color: mix(fl.hull_raised, fl.well, 0.5 * hit.hover); opacity: 0.9 }
        box { from: x, y; size: w, h; corner: 3; stroke: if(on, 2, 1); color: if(on, fl.ember, fl.trace_dim) }
        box { from: x + 7, y + h / 2 - 5; size: 18, 10; corner: 5; color: fl.ground }
        box { from: x + 7, y + h / 2 - 5; size: 18, 10; corner: 5; stroke: 1; color: if(on, fl.phos, fl.trace_dim) }
        box { at: x + (if(on, 21, 11)), y + h / 2; size: 6, 6; corner: 3; color: if(on, fl.phos, fl.trace) }
        text label { at: x + 32, y + h / 2; anchor: left center; size: 9; weight: 600; family: "Share Tech Mono"
                      color: if(on, fl.phos, mix(fl.engrave, fl.phos, hit.hover)) }
        text pick(on, "ON", "OFF") { at: x + w - 8, y + h / 2; anchor: right center; size: 8; family: "Share Tech Mono"
                                      color: if(on, fl.ember, fl.muted) }
        box { from: x, y + h - 2; size: w, 2; color: fl.ember; opacity: if(on, 1, 0) }
        on press hit { emit press(0) }
    }

    // A vibe: its name and what it is, a lit rule for the chosen one.
    component Vibe(r: record, sel: bool, press: event, x: number, y: number, w: number) {
        size: w, 38
        zone box hit { from: x, y; size: w, 38; cursor: pointer; role: item; label: r.name; selected: sel }
        path { color: mix(fl.hull_raised, fl.well, if(sel, 0.9, 0.5 * hit.hover)); opacity: 0.92
               move x + 6, y; line x + w, y; line x + w, y + 32; line x + w - 6, y + 38; line x, y + 38; line x, y + 6; close }
        path { stroke: 1; color: mix(fl.trace, fl.ember, if(sel, 1, 0.35 * hit.hover))
               move x + 6, y; line x + w, y; line x + w, y + 32; line x + w - 6, y + 38; line x, y + 38; line x, y + 6; close }
        box { from: x, y + 5; size: 2, 28; color: if(sel, fl.ember, fl.trace_dim) }
        text r.name { at: x + 14, y + 13; anchor: left center; size: 12; weight: 600; family: "Exo 2"
                      color: if(sel, fl.phos, mix(fl.engrave, fl.phos, hit.hover)) }
        text r.hint { at: x + 14, y + 27; anchor: left center; size: 8; family: "Share Tech Mono"
                      color: if(sel, fl.trace_lit, fl.muted) }
        box { at: x + w - 12, y + 19; size: 4, 4; corner: 2; color: fl.ember; show: sel }
        on press hit { emit press(r.index) }
    }

    // One folder in the picker: a folder tab and body, its name, and the press that enters it.
    component DirRow(r: record, enter: event, x: number, y: number) {
        size: 704, 28
        zone box hit { from: x, y; size: 704, 28; cursor: pointer; role: item; label: "Open {r.name}" }
        box { from: x, y; size: 704, 28; corner: 4; color: mix(fl.hull_raised, fl.well, 0.55 * hit.hover); opacity: 0.55 }
        path { stroke: 1.2; color: mix(fl.trace, fl.phos, hit.hover)
               move x + 12, y + 11; line x + 12, y + 8; line x + 17, y + 8; line x + 19, y + 11; line x + 27, y + 11
               line x + 27, y + 20; line x + 12, y + 20; close }
        text r.name { at: x + 38, y + 14; anchor: left center; size: 12; family: "Exo 2"
                      color: mix(fl.engrave, fl.phos, hit.hover); width: 630; lines: 1 }
        text "›" { at: x + 692, y + 14; anchor: right center; size: 13; family: "Share Tech Mono"; color: mix(fl.trace, fl.ember, hit.hover) }
        on press hit { emit enter(r.slot) }
    }

    // A theme colour: the colour itself, its role, and the hex it is.
    component Swatch(x: number, y: number, w: number, h: number, c: color, role: text, hex: text) {
        size: w, h
        box { from: x, y; size: w, h; corner: 2; color: c }
        box { from: x, y; size: w, h; corner: 2; stroke: 1; color: mix(c, fl.phos, 0.4) }
        text role { at: x + w + 12, y + 12; anchor: left center; size: 8; family: "Share Tech Mono"; color: fl.muted }
        text hex { at: x + w + 12, y + 32; anchor: left center; size: 13; weight: 600; family: "Share Tech Mono"; color: c }
    }

    // One picture in the source wall: the thumbnail, its name and size.
    component SourceTile(r: record, sel: bool, pick: event) {
        size: 284, 186
        zone box hit { from: r.x, r.y; size: 284, 186; cursor: pointer; role: item; label: r.name; selected: sel }
        box { from: r.x, r.y; size: 284, 186; corner: 3; color: fl.hull; opacity: 0.6 }
        image r.thumb { at: r.x + 1, r.y + 1; size: 282, 158; show: r.ready > 0.5 }
        text "DEVELOPING…" { at: r.x + 142, r.y + 79; anchor: center; size: 8; family: "Share Tech Mono"
                             color: fl.trace; show: r.ready < 0.5 }
        box { from: r.x, r.y; size: 284, 158; corner: 3; stroke: if(sel, 2, 1); color: if(sel, fl.ember, fl.trace_dim) }
        text r.name { at: r.x + 2, r.y + 169; anchor: left center; size: 9; family: "Share Tech Mono"
                      color: if(sel, fl.phos, fl.engrave); width: 226; lines: 1 }
        text r.dims { at: r.x + 282, r.y + 169; anchor: right center; size: 8; family: "Share Tech Mono"; color: fl.muted }
        on press hit { emit pick(r.slot) }
    }
}
