    follow wg_ambs = if(wg_amb and not editing and not wg_desk, 1, 0)
    prop wg_dkp = 0 ~wg.fade
    follow wg_dkp = if(wg_desk, 1, 0)
    // ── Edit mode ──
    fact editing = false
