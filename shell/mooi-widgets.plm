    prop ph3 = 0 ~wg.hand
    follow ph3 = hl3
    fact op3 = 1
    prop po3 = 1 ~wg.fade
    follow po3 = op3
    fact hl4 = 0
    prop ph4 = 0 ~wg.hand
    follow ph4 = hl4
    fact op4 = 1
    prop po4 = 1 ~wg.fade
    follow po4 = op4
