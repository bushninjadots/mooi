language 0.9
import "theme/tokens.plm"
import "theme/ferrolume.plm"
import "ui/widgets.plm" as wg
import "ui/vizwide.plm" as vw

// mooi's desktop widgets (D137, docs/superpowers/specs/2026-11-03-widgets-design.md): Now Playing
// (Sleeve, Lyric stage, Record) and the Visualiser (twelve modes), on one surface over the
// wallpaper and under the desk's cutout and every window. A program of its own, kept by the bar
// while widgets.on; mooi-widgets.luau reads widgets.json (lib/widgets), the music and the bar's
// visualiser feed. The surface leaves the bar's strip to the bar, so y = 0 is just under it.
// Empty parts take no clicks: they go to the desktop.

scene Widgets {
    permissions {
        run: "pleamar", "mv", "playerctl", "curl", "cat", "mkdir", "mooi"
        services: "files", "files.write", "media", "media.*", "audio", "audio.*", "env"
    }

    // corners on every plate (look.corners: 0 chamfer · 1 bevel · 2 rounded · 3 square; look.corner_size as a scale)
    fact cn_kind = 0
    fact cn_scale = 1
    fact fr_ground_r = 0.000000
    fact fr_ground_g = 0.000000
    fact fr_ground_b = 0.000000
    fact fr_hull_r = 0.015686
    fact fr_hull_g = 0.035294
    fact fr_hull_b = 0.031373
    fact fr_hull_raised_r = 0.027451
    fact fr_hull_raised_g = 0.074510
    fact fr_hull_raised_b = 0.066667
    fact fr_well_r = 0.019608
    fact fr_well_g = 0.164706
    fact fr_well_b = 0.145098
    fact fr_trace_dim_r = 0.121569
    fact fr_trace_dim_g = 0.219608
    fact fr_trace_dim_b = 0.200000
    fact fr_trace_r = 0.239216
    fact fr_trace_g = 0.415686
    fact fr_trace_b = 0.376471
    fact fr_trace_lit_r = 0.423529
    fact fr_trace_lit_g = 0.788235
    fact fr_trace_lit_b = 0.682353
    fact fr_phos_r = 0.498039
    fact fr_phos_g = 0.811765
    fact fr_phos_b = 0.713725
    fact fr_phos_fill_r = 0.090196
    fact fr_phos_fill_g = 0.603922
    fact fr_phos_fill_b = 0.533333
    fact fr_ember_r = 0.878431
    fact fr_ember_g = 0.482353
    fact fr_ember_b = 0.180392
    fact fr_ember_fill_r = 0.823529
    fact fr_ember_fill_g = 0.411765
    fact fr_ember_fill_b = 0.117647
    fact fr_flare_r = 0.956863
    fact fr_flare_g = 0.713725
    fact fr_flare_b = 0.235294
    fact fr_muted_r = 0.352941
    fact fr_muted_g = 0.541176
    fact fr_muted_b = 0.494118
    fact fr_ink_r = 0.015686
    fact fr_ink_g = 0.129412
    fact fr_ink_b = 0.113725
    fact fr_steel_900_r = 0.082353
    fact fr_steel_900_g = 0.098039
    fact fr_steel_900_b = 0.105882
    fact fr_steel_700_r = 0.164706
    fact fr_steel_700_g = 0.192157
    fact fr_steel_700_b = 0.203922
    fact fr_steel_500_r = 0.290196
    fact fr_steel_500_g = 0.329412
    fact fr_steel_500_b = 0.349020
    fact fr_steel_300_r = 0.545098
    fact fr_steel_300_g = 0.592157
    fact fr_steel_300_b = 0.611765
    fact fr_engrave_r = 0.603922
    fact fr_engrave_g = 0.650980
    fact fr_engrave_b = 0.670588
    prop pr_ground_r = 0.000000 ~fl.relight
    follow pr_ground_r = fr_ground_r
    prop pr_ground_g = 0.000000 ~fl.relight
    follow pr_ground_g = fr_ground_g
    prop pr_ground_b = 0.000000 ~fl.relight
    follow pr_ground_b = fr_ground_b
    prop pr_hull_r = 0.015686 ~fl.relight
    follow pr_hull_r = fr_hull_r
    prop pr_hull_g = 0.035294 ~fl.relight
    follow pr_hull_g = fr_hull_g
    prop pr_hull_b = 0.031373 ~fl.relight
    follow pr_hull_b = fr_hull_b
    prop pr_hull_raised_r = 0.027451 ~fl.relight
    follow pr_hull_raised_r = fr_hull_raised_r
    prop pr_hull_raised_g = 0.074510 ~fl.relight
    follow pr_hull_raised_g = fr_hull_raised_g
    prop pr_hull_raised_b = 0.066667 ~fl.relight
    follow pr_hull_raised_b = fr_hull_raised_b
    prop pr_well_r = 0.019608 ~fl.relight
    follow pr_well_r = fr_well_r
    prop pr_well_g = 0.164706 ~fl.relight
    follow pr_well_g = fr_well_g
    prop pr_well_b = 0.145098 ~fl.relight
    follow pr_well_b = fr_well_b
    prop pr_trace_dim_r = 0.121569 ~fl.relight
    follow pr_trace_dim_r = fr_trace_dim_r
    prop pr_trace_dim_g = 0.219608 ~fl.relight
    follow pr_trace_dim_g = fr_trace_dim_g
    prop pr_trace_dim_b = 0.200000 ~fl.relight
    follow pr_trace_dim_b = fr_trace_dim_b
    prop pr_trace_r = 0.239216 ~fl.relight
    follow pr_trace_r = fr_trace_r
    prop pr_trace_g = 0.415686 ~fl.relight
    follow pr_trace_g = fr_trace_g
    prop pr_trace_b = 0.376471 ~fl.relight
    follow pr_trace_b = fr_trace_b
    prop pr_trace_lit_r = 0.423529 ~fl.relight
    follow pr_trace_lit_r = fr_trace_lit_r
    prop pr_trace_lit_g = 0.788235 ~fl.relight
    follow pr_trace_lit_g = fr_trace_lit_g
    prop pr_trace_lit_b = 0.682353 ~fl.relight
    follow pr_trace_lit_b = fr_trace_lit_b
    prop pr_phos_r = 0.498039 ~fl.relight
    follow pr_phos_r = fr_phos_r
    prop pr_phos_g = 0.811765 ~fl.relight
    follow pr_phos_g = fr_phos_g
    prop pr_phos_b = 0.713725 ~fl.relight
    follow pr_phos_b = fr_phos_b
    prop pr_phos_fill_r = 0.090196 ~fl.relight
    follow pr_phos_fill_r = fr_phos_fill_r
    prop pr_phos_fill_g = 0.603922 ~fl.relight
    follow pr_phos_fill_g = fr_phos_fill_g
    prop pr_phos_fill_b = 0.533333 ~fl.relight
    follow pr_phos_fill_b = fr_phos_fill_b
    prop pr_ember_r = 0.878431 ~fl.relight
    follow pr_ember_r = fr_ember_r
    prop pr_ember_g = 0.482353 ~fl.relight
    follow pr_ember_g = fr_ember_g
    prop pr_ember_b = 0.180392 ~fl.relight
    follow pr_ember_b = fr_ember_b
    prop pr_ember_fill_r = 0.823529 ~fl.relight
    follow pr_ember_fill_r = fr_ember_fill_r
    prop pr_ember_fill_g = 0.411765 ~fl.relight
    follow pr_ember_fill_g = fr_ember_fill_g
    prop pr_ember_fill_b = 0.117647 ~fl.relight
    follow pr_ember_fill_b = fr_ember_fill_b
    prop pr_flare_r = 0.956863 ~fl.relight
    follow pr_flare_r = fr_flare_r
    prop pr_flare_g = 0.713725 ~fl.relight
    follow pr_flare_g = fr_flare_g
    prop pr_flare_b = 0.235294 ~fl.relight
    follow pr_flare_b = fr_flare_b
    prop pr_muted_r = 0.352941 ~fl.relight
    follow pr_muted_r = fr_muted_r
    prop pr_muted_g = 0.541176 ~fl.relight
    follow pr_muted_g = fr_muted_g
    prop pr_muted_b = 0.494118 ~fl.relight
    follow pr_muted_b = fr_muted_b
    prop pr_ink_r = 0.015686 ~fl.relight
    follow pr_ink_r = fr_ink_r
    prop pr_ink_g = 0.129412 ~fl.relight
    follow pr_ink_g = fr_ink_g
    prop pr_ink_b = 0.113725 ~fl.relight
    follow pr_ink_b = fr_ink_b
    prop pr_steel_900_r = 0.082353 ~fl.relight
    follow pr_steel_900_r = fr_steel_900_r
    prop pr_steel_900_g = 0.098039 ~fl.relight
    follow pr_steel_900_g = fr_steel_900_g
    prop pr_steel_900_b = 0.105882 ~fl.relight
    follow pr_steel_900_b = fr_steel_900_b
    prop pr_steel_700_r = 0.164706 ~fl.relight
    follow pr_steel_700_r = fr_steel_700_r
    prop pr_steel_700_g = 0.192157 ~fl.relight
    follow pr_steel_700_g = fr_steel_700_g
    prop pr_steel_700_b = 0.203922 ~fl.relight
    follow pr_steel_700_b = fr_steel_700_b
    prop pr_steel_500_r = 0.290196 ~fl.relight
    follow pr_steel_500_r = fr_steel_500_r
    prop pr_steel_500_g = 0.329412 ~fl.relight
    follow pr_steel_500_g = fr_steel_500_g
    prop pr_steel_500_b = 0.349020 ~fl.relight
    follow pr_steel_500_b = fr_steel_500_b
    prop pr_steel_300_r = 0.545098 ~fl.relight
    follow pr_steel_300_r = fr_steel_300_r
    prop pr_steel_300_g = 0.592157 ~fl.relight
    follow pr_steel_300_g = fr_steel_300_g
    prop pr_steel_300_b = 0.611765 ~fl.relight
    follow pr_steel_300_b = fr_steel_300_b
    prop pr_engrave_r = 0.603922 ~fl.relight
    follow pr_engrave_r = fr_engrave_r
    prop pr_engrave_g = 0.650980 ~fl.relight
    follow pr_engrave_g = fr_engrave_g
    prop pr_engrave_b = 0.670588 ~fl.relight
    follow pr_engrave_b = fr_engrave_b


    // The islands' semantic tokens, which theme/tokens defines over these facts.
    fact c_bg_primary_r = 0.062745
    fact c_bg_primary_g = 0.078431
    fact c_bg_primary_b = 0.086275
    fact c_bg_secondary_r = 0.086275
    fact c_bg_secondary_g = 0.105882
    fact c_bg_secondary_b = 0.117647
    fact c_surface_primary_r = 0.098039
    fact c_surface_primary_g = 0.121569
    fact c_surface_primary_b = 0.133333
    fact c_surface_elevated_r = 0.133333
    fact c_surface_elevated_g = 0.160784
    fact c_surface_elevated_b = 0.176471
    fact c_border_subtle_r = 0.172549
    fact c_border_subtle_g = 0.207843
    fact c_border_subtle_b = 0.223529
    fact c_fg_primary_r = 0.890196
    fact c_fg_primary_g = 0.913725
    fact c_fg_primary_b = 0.921569
    fact c_fg_secondary_r = 0.639216
    fact c_fg_secondary_g = 0.690196
    fact c_fg_secondary_b = 0.709804
    fact c_fg_muted_r = 0.541176
    fact c_fg_muted_g = 0.592157
    fact c_fg_muted_b = 0.611765
    fact c_accent_primary_r = 0.650980
    fact c_accent_primary_g = 0.952941
    fact c_accent_primary_b = 0.819608
    fact c_accent_secondary_r = 1.000000
    fact c_accent_secondary_g = 0.572549
    fact c_accent_secondary_b = 0.372549
    fact c_status_ok_r = 0.650980
    fact c_status_ok_g = 0.952941
    fact c_status_ok_b = 0.819608
    fact c_status_error_r = 1.000000
    fact c_status_error_g = 0.572549
    fact c_status_error_b = 0.372549
    fact c_focus_ring_r = 0.650980
    fact c_focus_ring_g = 0.952941
    fact c_focus_ring_b = 0.819608
    fact c_selection_bg_r = 0.164706
    fact c_selection_bg_g = 0.227451
    fact c_selection_bg_b = 0.211765

    // What theme/ferrolume reads for its geometry (the bar's strip; unused here) and the finish.
    fact st_offset = 0
    fact st_notch = false
    fact bar_rail = true
    fact st_height = 30
    fact st_radius = 8
    fact st_res = 46
    fact st_glow = 1

    // the widgets as widgets.json has them, worked out by lib/widgets (kind 0 now playing,
    // 1 visualiser; lay 0 sleeve, 1 lyric stage, 2 record; st 0 shown, 1 resting, 2 hidden, 3 marker)
    model wg max 8 { kind: number; lay: number; mode: number; x: number; y: number; w: number; h: number; u: number; idle: number; st: number; op: number; glow: number; plate: bool; lyr: bool; prog: bool; gh: bool; bars: number; gap: number; peaks: bool; refl: bool; vslot: number; opa: number; txt: number; locked: bool; sel: bool }

    // what is playing (any player, through the media service)
    text np_title = ""
    text np_artist = ""
    text np_prev = ""
    text np_line = ""
    text np_next = ""
    text np_cover_path = ""
    image cover = from np_cover_path, 480, 480
    fact np_has = false
    fact np_cover_on = false
    fact np_playing = false
    fact np_progress = 0
    fact np_arm_at = 0
    fact np_line_in = 1
    fact np_sung = false
    fact viz_still = false
    fact wg_calm = true          // nothing pointed at, no fade running (the logic says)

    // the visualiser's feed (lib/vizfeed): sixteen bands, and what the beats leave behind
    fact vb0 = 0.03
    fact vb1 = 0.03
    fact vb2 = 0.03
    fact vb3 = 0.03
    fact vb4 = 0.03
    fact vb5 = 0.03
    fact vb6 = 0.03
    fact vb7 = 0.03
    fact vb8 = 0.03
    fact vb9 = 0.03
    fact vb10 = 0.03
    fact vb11 = 0.03
    fact vb12 = 0.03
    fact vb13 = 0.03
    fact vb14 = 0.03
    fact vb15 = 0.03
    fact np_beat = 0
    // the three visualiser lanes (D138): where each draws, what, and from which widget slot
    fact lA_on = false
    fact lA_k = 0
    fact lA_x = 0
    fact lA_y = 0
    fact lA_w = 10
    fact lA_h = 10
    fact lA_u = 1
    fact lA_mode = 0
    fact lA_n = 64
    fact lA_gap = 0.3
    fact lA_glow = 0.6
    fact lA_peaks = true
    fact lA_refl = false
    fact lA_plate = false
    fact lA_st = 0
    fact lA_gh = false
    fact lA_opa = 1
    fact lA_sel = false
    fact lB_on = false
    fact lB_k = 0
    fact lB_x = 0
    fact lB_y = 0
    fact lB_w = 10
    fact lB_h = 10
    fact lB_u = 1
    fact lB_mode = 0
    fact lB_n = 64
    fact lB_gap = 0.3
    fact lB_glow = 0.6
    fact lB_peaks = true
    fact lB_refl = false
    fact lB_plate = false
    fact lB_st = 0
    fact lB_gh = false
    fact lB_opa = 1
    fact lB_sel = false
    fact lC_on = false
    fact lC_k = 0
    fact lC_x = 0
    fact lC_y = 0
    fact lC_w = 10
    fact lC_h = 10
    fact lC_u = 1
    fact lC_mode = 0
    fact lC_n = 64
    fact lC_gap = 0.3
    fact lC_glow = 0.6
    fact lC_peaks = true
    fact lC_refl = false
    fact lC_plate = false
    fact lC_st = 0
    fact lC_gh = false
    fact lC_opa = 1
    fact lC_sel = false
    // the visualisers' own bars (D138): one record per bar, for up to three visualisers
    model vzA max 128 { v: number; pk: number }
    model vzB max 128 { v: number; pk: number }
    model vzC max 128 { v: number; pk: number }
    fact viz_wide = false        // the 64-band feed is coming (else 32 resampled)
    // 32 bands for the shapes drawn as paths, and the scope's last three frames of 24
    fact vs0 = 0.03
    fact vs1 = 0.03
    fact vs2 = 0.03
    fact vs3 = 0.03
    fact vs4 = 0.03
    fact vs5 = 0.03
    fact vs6 = 0.03
    fact vs7 = 0.03
    fact vs8 = 0.03
    fact vs9 = 0.03
    fact vs10 = 0.03
    fact vs11 = 0.03
    fact vs12 = 0.03
    fact vs13 = 0.03
    fact vs14 = 0.03
    fact vs15 = 0.03
    fact vs16 = 0.03
    fact vs17 = 0.03
    fact vs18 = 0.03
    fact vs19 = 0.03
    fact vs20 = 0.03
    fact vs21 = 0.03
    fact vs22 = 0.03
    fact vs23 = 0.03
    fact vs24 = 0.03
    fact vs25 = 0.03
    fact vs26 = 0.03
    fact vs27 = 0.03
    fact vs28 = 0.03
    fact vs29 = 0.03
    fact vs30 = 0.03
    fact vs31 = 0.03
    fact so0_0 = 0.03
    fact so0_1 = 0.03
    fact so0_2 = 0.03
    fact so0_3 = 0.03
    fact so0_4 = 0.03
    fact so0_5 = 0.03
    fact so0_6 = 0.03
    fact so0_7 = 0.03
    fact so0_8 = 0.03
    fact so0_9 = 0.03
    fact so0_10 = 0.03
    fact so0_11 = 0.03
    fact so0_12 = 0.03
    fact so0_13 = 0.03
    fact so0_14 = 0.03
    fact so0_15 = 0.03
    fact so0_16 = 0.03
    fact so0_17 = 0.03
    fact so0_18 = 0.03
    fact so0_19 = 0.03
    fact so0_20 = 0.03
    fact so0_21 = 0.03
    fact so0_22 = 0.03
    fact so0_23 = 0.03
    fact so1_0 = 0.03
    fact so1_1 = 0.03
    fact so1_2 = 0.03
    fact so1_3 = 0.03
    fact so1_4 = 0.03
    fact so1_5 = 0.03
    fact so1_6 = 0.03
    fact so1_7 = 0.03
    fact so1_8 = 0.03
    fact so1_9 = 0.03
    fact so1_10 = 0.03
    fact so1_11 = 0.03
    fact so1_12 = 0.03
    fact so1_13 = 0.03
    fact so1_14 = 0.03
    fact so1_15 = 0.03
    fact so1_16 = 0.03
    fact so1_17 = 0.03
    fact so1_18 = 0.03
    fact so1_19 = 0.03
    fact so1_20 = 0.03
    fact so1_21 = 0.03
    fact so1_22 = 0.03
    fact so1_23 = 0.03
    fact so2_0 = 0.03
    fact so2_1 = 0.03
    fact so2_2 = 0.03
    fact so2_3 = 0.03
    fact so2_4 = 0.03
    fact so2_5 = 0.03
    fact so2_6 = 0.03
    fact so2_7 = 0.03
    fact so2_8 = 0.03
    fact so2_9 = 0.03
    fact so2_10 = 0.03
    fact so2_11 = 0.03
    fact so2_12 = 0.03
    fact so2_13 = 0.03
    fact so2_14 = 0.03
    fact so2_15 = 0.03
    fact so2_16 = 0.03
    fact so2_17 = 0.03
    fact so2_18 = 0.03
    fact so2_19 = 0.03
    fact so2_20 = 0.03
    fact so2_21 = 0.03
    fact so2_22 = 0.03
    fact so2_23 = 0.03
    fact rp_r0 = 0
    fact rp_a0 = 0
    fact rp_r1 = 0
    fact rp_a1 = 0
    fact rp_r2 = 0
    fact rp_a2 = 0
    fact rp_r3 = 0
    fact rp_a3 = 0

    // the record turns at 33⅓ (200° a second) and coasts to a stop; the arm follows the song
    spring wg.coast = 60, 14
    spring wg.arm = 120, 18
    spring wg.line = 260, 30
    prop np_spd = 0 ~wg.coast
    follow np_spd = if(np_playing and not viz_still, 200, 0)
    prop np_vang = 0
    spin np_vang by np_spd
    prop np_arm = 0 ~wg.arm
    follow np_arm = np_arm_at
    prop np_prg = 0 ~500ms
    follow np_prg = np_progress
    // what moves the drifting modes while something plays
    prop np_tspd = 0 ~wg.coast
    follow np_tspd = if(np_playing and not viz_still, 40, 0)
    prop np_turn = 0
    spin np_turn by np_tspd
    // a beat's push, gone again in a moment (the dust scatters on it)
    prop np_scatter = 0 ~180ms
    follow np_scatter = np_beat
    // a new lyric line fades in
    prop np_lf = 1 ~wg.line
    follow np_lf = np_line_in

    // each slot's hands (lingering, set by the logic) and its opacity (the idle rule), gliding
    spring wg.hand = 320, 30
    spring wg.fade = 140, 22
    fact hl0 = 0
    prop ph0 = 0 ~wg.hand
    follow ph0 = hl0
    fact op0 = 1
    prop po0 = 1 ~wg.fade
    follow po0 = op0
    fact hl1 = 0
    prop ph1 = 0 ~wg.hand
    follow ph1 = hl1
    fact op1 = 1
    prop po1 = 1 ~wg.fade
    follow po1 = op1
    fact hl2 = 0
    prop ph2 = 0 ~wg.hand
    follow ph2 = hl2
    fact op2 = 1
    prop po2 = 1 ~wg.fade
    follow po2 = op2
    fact hl3 = 0
    prop ph3 = 0 ~wg.hand
    follow ph3 = hl3
    fact op3 = 1
    prop po3 = 1 ~wg.fade
    follow po3 = op3
    fact hl4 = 0
    prop ph4 = 0 ~wg.hand
    follow ph4 = hl4
    fact op4 = 1
    prop po4 = 1 ~wg.fade
    follow po4 = op4
    fact hl5 = 0
    prop ph5 = 0 ~wg.hand
    follow ph5 = hl5
    fact op5 = 1
    prop po5 = 1 ~wg.fade
    follow po5 = op5
    fact hl6 = 0
    prop ph6 = 0 ~wg.hand
    follow ph6 = hl6
    fact op6 = 1
    prop po6 = 1 ~wg.fade
    follow po6 = op6
    fact hl7 = 0
    prop ph7 = 0 ~wg.hand
    follow ph7 = hl7
    fact op7 = 1
    prop po7 = 1 ~wg.fade
    follow po7 = op7
    // ── Edit mode ──
    fact editing = false
    // a widget carried (its slot, how far) or pulled by an edge (its slot, how far each way)
    fact wg_dk = -1
    fact wg_dx = 0
    fact wg_dy = 0
    fact wg_rk = -1
    fact wg_rw = 0
    fact wg_rh = 0
    // where it would settle (the logic's snap) and the lines it snapped to (-1: none)
    fact wg_sx = 0
    fact wg_sy = 0
    fact wg_sw = 0
    fact wg_sh = 0
    fact wg_gvx = -1
    fact wg_ghy = -1
    // the chosen widget, its panel's place and what the panel shows
    fact wg_sel = -1
    fact wg_px = 0
    fact wg_py = 0
    fact wg_sk = 0
    fact wg_sl = 0
    fact wg_sm = 0
    fact wg_si = 1
    fact wg_o3 = true
    fact wg_o4 = true
    fact wg_o5 = false
    fact wg_o6 = true
    fact wg_og = 0.6
    fact wg_nsel = 0             // how many are chosen
    // who owns the gesture under way: a drag reaches every zone under the press, not only the top
    // one (Pleamar), so each press says whose it is and every drag and release asks (D138 fix):
    // 0 none · 1 the desktop (marquee) · 2 the panel's header · 3 a slider · 100 + slot a widget ·
    // 200 + slot · 8 + handle a handle
    fact wg_hold = 0
    fact wg_ru = 1               // the scale of the widget being pulled, at its new size
    fact wg_nviz = 0             // how many visualisers (three at most)
    fact wg_dksel = false        // the one carried is chosen, so the others chosen come along
    fact wg_snap = true          // snapping on (the top bar's SNAP)
    fact wg_o7 = true
    fact wg_o8 = false
    fact wg_ob = 64
    fact wg_ogap = 0.3
    fact wg_osm = 0.5
    fact wg_otx = 1
    fact wg_oop = 1
    fact wg_olk = false
    fact wg_pcol = false         // the panel folded to its header
    fact wg_pbx = 0              // where the panel was when its header was pressed
    fact wg_pby = 0
    fact wg_osc = 0.5            // the chosen widget's size between its layout's least and most
    text wg_readout = ""
    text wg_note = ""
    // the marquee: pressed here, pulled this far
    fact wg_mx = 0
    fact wg_my = 0
    fact wg_mdx = 0
    fact wg_mdy = 0
    fact wg_mon = false
    event wg_sel ->              // slot · 10 + 0 choose it only · 1 add it or take it away (right press) · 2 none
    event wg_marq0 ->            // the marquee's start, x · 4096 + y
    event wg_marq1 ->            // its end, x · 4096 + y: what it touches is chosen
    event wg_hgrab ->            // a handle held: slot · 8 + handle (0 tl … 7 l)
    event wg_hmove ->            // pulled: (dx + 2048) · 4096 + (dy + 2048)
    event wg_hdrop ->            // let go
    event wg_key ->              // the editor's keys (mooi-widgets.luau)
    event wg_tool ->             // the toolbar: align, distribute, match, order, lock, snap
    event wg_slide ->            // a slider held: slot · 10000 + which · 1000 + value (0 … 999)
    event wg_slid ->             // let go of the slider
    event wg_pmove ->            // the panel dragged by its header: x · 4096 + y
    event wg_edit ->             // edit mode on (1) or off (0): `mooi widgets edit`, Done, Esc, a press on the desktop
    event wg_pick ->             // a widget chosen: its slot
    event wg_drag ->             // carried: slot · 65536 + x / 8 · 256 + y / 8
    event wg_drop ->             // let go: its slot
    event wg_add ->              // + now playing (0) or + visualiser (1)
    event wg_opt ->              // the panel: slot · 1000 + what · 100 + value

    event wg_hov ->              // to the logic: slot · 10 + 1 pointed at, + 0 left
    event wg_ctl ->              // slot · 10 + 0 previous · 1 play/pause · 2 next
    event wg_seek ->             // slot · 1000 + where (0 … 999)
    event wg_vol ->              // slot · 10 + 0 down · 1 up
    event wg_open ->             // the player, from slot n
    event wg_room ->             // to the logic: the room under the bar, width · 4096 + height

    surface desk {
        size: full, full
        anchor: top
        level: bottom
        keyboard: on_demand while editing
        rate: 30, 4 while not np_playing and wg_calm and not editing

        // edit mode: a press on the empty desktop leaves it; a faint grid to place by (snapping is 8 px)
        // edit mode: a press on the empty desktop chooses none; pulled, it draws a marquee
        zone box wbg { from: 0, 0; size: desk.width, desk.height; agent: hidden; show: editing }
        on press wbg { wg_hold = 1; wg_mx = pointer.x; wg_my = pointer.y; wg_mdx = 0; wg_mdy = 0; emit wg_sel(2) }
        on drag wbg while wg_hold == 1 { wg_mon = true; wg_mdx = drag.dx; wg_mdy = drag.dy }
        on release wbg while wg_hold == 1 and wg_mon {
            emit wg_marq0(round(clamp(wg_mx, 0, 4095)) * 4096 + round(clamp(wg_my, 0, 4095)))
            emit wg_marq1(round(clamp(wg_mx + wg_mdx, 0, 4095)) * 4096 + round(clamp(wg_my + wg_mdy, 0, 4095)))
            wg_mon = false
        }
        group {
            show: editing
            box { from: 0, 0; size: desk.width, desk.height; color: #000000; opacity: 0.18 }
            repeat gx in 0..60 {
                box { from: gx * 32, 0; size: 1, desk.height; color: fl.trace_dim; opacity: if(mod(gx, 4) == 0, 0.35, 0.14) }
            }
            repeat gy in 0..34 {
                box { from: 0, gy * 32; size: desk.width, 1; color: fl.trace_dim; opacity: if(mod(gy, 4) == 0, 0.35, 0.14) }
            }
        }

        // the visualisers, a lane each, under the other widgets
        group {
            show: lA_on and (editing or lA_st < 1.5)
            opacity: if(editing, if(lA_gh, 0.4, 1), if(viz_still, if(lA_st < 0.5, 1, 0.35), pick(lA_k, po0, po1, po2, po3, po4, po5, po6, po7))) * lA_opa
            move: if(wg_dk == lA_k or (wg_dk >= 0 and wg_dksel and lA_sel), wg_dx, 0), if(wg_dk == lA_k or (wg_dk >= 0 and wg_dksel and lA_sel), wg_dy, 0)
            box { from: if(wg_rk == lA_k, wg_sx, lA_x), if(wg_rk == lA_k, wg_sy, lA_y); size: if(wg_rk == lA_k, wg_sw, lA_w), if(wg_rk == lA_k, wg_sh, lA_h); corner: 6 * lA_u; color: fl.hull; opacity: 0.7; show: lA_plate }
            vw.LaneA(if(wg_rk == lA_k, wg_sx, lA_x), if(wg_rk == lA_k, wg_sy, lA_y), if(wg_rk == lA_k, wg_sw, lA_w), if(wg_rk == lA_k, wg_sh, lA_h), if(wg_rk == lA_k, wg_ru, lA_u), lA_mode, lA_n, lA_gap, lA_glow, lA_peaks, lA_refl, fl.phos, fl.ember, fl.trace_dim, viz_still)
        }
        group {
            show: lB_on and (editing or lB_st < 1.5)
            opacity: if(editing, if(lB_gh, 0.4, 1), if(viz_still, if(lB_st < 0.5, 1, 0.35), pick(lB_k, po0, po1, po2, po3, po4, po5, po6, po7))) * lB_opa
            move: if(wg_dk == lB_k or (wg_dk >= 0 and wg_dksel and lB_sel), wg_dx, 0), if(wg_dk == lB_k or (wg_dk >= 0 and wg_dksel and lB_sel), wg_dy, 0)
            box { from: if(wg_rk == lB_k, wg_sx, lB_x), if(wg_rk == lB_k, wg_sy, lB_y); size: if(wg_rk == lB_k, wg_sw, lB_w), if(wg_rk == lB_k, wg_sh, lB_h); corner: 6 * lB_u; color: fl.hull; opacity: 0.7; show: lB_plate }
            vw.LaneB(if(wg_rk == lB_k, wg_sx, lB_x), if(wg_rk == lB_k, wg_sy, lB_y), if(wg_rk == lB_k, wg_sw, lB_w), if(wg_rk == lB_k, wg_sh, lB_h), if(wg_rk == lB_k, wg_ru, lB_u), lB_mode, lB_n, lB_gap, lB_glow, lB_peaks, lB_refl, fl.phos, fl.ember, fl.trace_dim, viz_still)
        }
        group {
            show: lC_on and (editing or lC_st < 1.5)
            opacity: if(editing, if(lC_gh, 0.4, 1), if(viz_still, if(lC_st < 0.5, 1, 0.35), pick(lC_k, po0, po1, po2, po3, po4, po5, po6, po7))) * lC_opa
            move: if(wg_dk == lC_k or (wg_dk >= 0 and wg_dksel and lC_sel), wg_dx, 0), if(wg_dk == lC_k or (wg_dk >= 0 and wg_dksel and lC_sel), wg_dy, 0)
            box { from: if(wg_rk == lC_k, wg_sx, lC_x), if(wg_rk == lC_k, wg_sy, lC_y); size: if(wg_rk == lC_k, wg_sw, lC_w), if(wg_rk == lC_k, wg_sh, lC_h); corner: 6 * lC_u; color: fl.hull; opacity: 0.7; show: lC_plate }
            vw.LaneC(if(wg_rk == lC_k, wg_sx, lC_x), if(wg_rk == lC_k, wg_sy, lC_y), if(wg_rk == lC_k, wg_sw, lC_w), if(wg_rk == lC_k, wg_sh, lC_h), if(wg_rk == lC_k, wg_ru, lC_u), lC_mode, lC_n, lC_gap, lC_glow, lC_peaks, lC_refl, fl.phos, fl.ember, fl.trace_dim, viz_still)
        }

        for w in wg {
            let k = w.index
            // the widget being pulled is drawn at the size in the hand (facts, not the model, so
            // nothing is rebuilt under the pointer while it moves)
            let rz = wg_rk == k
            let wx = if(rz, wg_sx, w.x)
            let wy = if(rz, wg_sy, w.y)
            let ww = if(rz, wg_sw, w.w)
            let wh = if(rz, wg_sh, w.h)
            let wu = if(rz, wg_ru, w.u)
            let hv = if(w.kind < 0.5 and not editing, pick(k, ph0, ph1, ph2, ph3, ph4, ph5, ph6, ph7), 0)
            let fo = max(if(viz_still, w.op, pick(k, po0, po1, po2, po3, po4, po5, po6, po7)), 0.9 * hv * if(w.st < 1.5, 1, 0))
            // only a widget that shows music can be pointed at (a hidden one, or the visualiser, never)
            let over = w.kind < 0.5 and (w.st < 1.5 or editing) and desk.cursor.x >= w.x and desk.cursor.x <= w.x + w.w and desk.cursor.y >= w.y and desk.cursor.y <= w.y + w.h
            on change over { emit wg_hov(k * 10 + if(over, 1, 0)) }
            let along = wg_dk == k or (wg_dk >= 0 and wg_dksel and w.sel and not w.locked)
            let ox = if(along, wg_dx, 0)
            let oy = if(along, wg_dy, 0)
            group {
                opacity: if(editing, if(w.gh, 0.4, 1), fo) * w.opa
                show: editing or (w.st < 1.5 and fo > 0.01)
                move: ox, oy
                group { show: w.kind < 0.5 and w.lay < 0.5
                        wg.Sleeve(wx, wy, ww, wh, wu, w.lyr, w.prog, w.plate, k, hv, w.txt) }
                group { show: w.kind < 0.5 and w.lay > 0.5 and w.lay < 1.5
                        wg.LyricStage(wx, wy, ww, wh, wu, w.plate, k, hv, w.txt) }
                group { show: w.kind < 0.5 and w.lay > 1.5
                        wg.Record(wx, wy, ww, wh, wu, w.plate, w.prog, k, hv, w.txt) }
            }
            group { show: w.st > 2.5 and not editing
                    wg.Marker(w.x, w.y, w.u, k) }

            // edit mode: its outline (lit when chosen), the hand that carries it, eight handles
            group {
                show: editing
                let rec = w.kind < 0.5 and w.lay > 1.5
                let xx = wx + ox
                let yy = wy + oy
                box { from: xx, yy; size: ww, wh; corner: 4; stroke: if(w.sel, 2, 1); color: if(w.sel, fl.phos, fl.trace_lit); opacity: if(w.sel, 1, 0.6) }
                text "HIDDEN AT REST" { at: xx + 8, yy + 12; anchor: left center; size: 9; family: "Share Tech Mono"; color: fl.muted; show: w.gh }
                // a padlock when it is locked
                group {
                    show: w.locked
                    box { from: xx + ww - 22, yy + 10; size: 12, 9; corner: 2; color: fl.ember }
                    arc { at: xx + ww - 16, yy + 10; radius: 4; width: 1.6; span: 180deg; rotate: -90deg; color: fl.ember }
                }
                zone box mv { from: w.x, w.y; size: w.w, w.h; cursor: if(w.locked, pointer, grab); role: button; label: "Choose or move this widget" }
                on press mv { wg_hold = 100 + k; emit wg_sel(k * 10) }
                on press right mv { wg_hold = 0; emit wg_sel(k * 10 + 1) }
                on drag mv while wg_hold == 100 + k and not w.locked {
                    wg_dk = k; wg_dx = drag.dx; wg_dy = drag.dy
                    emit wg_drag(k * 65536 + clamp(round((w.x + drag.dx) / 8), 0, 255) * 256 + clamp(round((w.y + drag.dy) / 8), 0, 255))
                }
                // the offset stays until the logic has put it where it settles (no flash back)
                on release mv while wg_hold == 100 + k and wg_dk == k { emit wg_drop(k) }
                // eight handles on the chosen one: corners and edge middles (a record keeps its shape: corners only)
                group {
                    show: w.sel and not w.locked and wg_dk < 0
                    repeat hd in 0..8 {
                        let hx = wx + pick(hd, 0, 0.5, 1, 1, 1, 0.5, 0, 0) * ww
                        let hy = wy + pick(hd, 0, 0, 0, 0.5, 1, 1, 1, 0.5) * wh
                        let corner = mod(hd, 2) == 0
                        group {
                            show: corner or not rec
                            box { from: hx - 5, hy - 5; size: 10, 10; corner: 2; color: fl.hull }
                            box { from: hx - 5, hy - 5; size: 10, 10; corner: 2; stroke: 1.4; color: fl.phos }
                            zone box hz { from: hx - 9, hy - 9; size: 18, 18; role: button; label: "Resize"
                                          cursor: pick(hd, nwse_resize, ns_resize, nesw_resize, ew_resize, nwse_resize, ns_resize, nesw_resize, ew_resize) }
                            on press hz { wg_hold = 200 + k * 8 + hd; emit wg_hgrab(k * 8 + hd) }
                            on drag hz while wg_hold == 200 + k * 8 + hd { emit wg_hmove((round(clamp(drag.dx, -2047, 2047)) + 2048) * 4096 + round(clamp(drag.dy, -2047, 2047)) + 2048) }
                            on release hz while wg_hold == 200 + k * 8 + hd { emit wg_hdrop }
                        }
                    }
                }
            }
        }

        // where a carried or pulled widget will settle, and the lines it snapped to
        group {
            show: editing and wg_dk >= 0
            box { from: wg_sx, wg_sy; size: wg_sw, wg_sh; corner: 4; color: fl.phos; opacity: 0.12 }
            box { from: wg_sx, wg_sy; size: wg_sw, wg_sh; corner: 4; stroke: 1.5; color: fl.phos; opacity: 0.8 }
            box { from: wg_gvx, 0; size: 1, desk.height; color: fl.ember; opacity: 0.8; show: wg_gvx >= 0 }
            box { from: 0, wg_ghy; size: desk.width, 1; color: fl.ember; opacity: 0.8; show: wg_ghy >= 0 }
        }

        // the marquee being drawn
        group {
            show: editing and wg_mon
            box { from: min(wg_mx, wg_mx + wg_mdx), min(wg_my, wg_my + wg_mdy); size: abs(wg_mdx), abs(wg_mdy); color: fl.phos; opacity: 0.08 }
            box { from: min(wg_mx, wg_mx + wg_mdx), min(wg_my, wg_my + wg_mdy); size: abs(wg_mdx), abs(wg_mdy); stroke: 1; color: fl.phos; opacity: 0.8 }
        }
        // the size and place while carried or pulled, by the pointer
        group {
            show: editing and (wg_dk >= 0 or wg_rk >= 0)
            box { from: desk.cursor.x + 16, desk.cursor.y + 16; size: 150, 22; corner: 4; color: fl.hull; opacity: 0.92 }
            text wg_readout { at: desk.cursor.x + 24, desk.cursor.y + 27; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.phos; width: 140; lines: 1 }
        }

        // the top bar: + Now Playing, + Visualiser, SNAP, Done; under it the tools for what is chosen
        group {
            show: editing
            let cx = desk.width / 2
            box { from: cx - 270, 12; size: 540, 40; corner: 6; color: fl.hull; opacity: 0.94 }
            box { from: cx - 270, 12; size: 540, 40; corner: 6; stroke: 1; color: fl.trace_lit; opacity: 0.8 }
            text "WIDGETS" { at: cx - 256, 32; anchor: left center; size: 11; weight: 700; family: "Share Tech Mono"; color: fl.phos }
            zone box adn { from: cx - 176, 20; size: 120, 24; cursor: pointer; role: button; label: "Add Now Playing" }
            zone box adv { from: cx - 50, 20; size: 110, 24; cursor: pointer; role: button; label: "Add a visualiser" }
            zone box snp { from: cx + 66, 20; size: 86, 24; cursor: pointer; role: toggle; checked: wg_snap; label: "Snapping" }
            zone box don { from: cx + 160, 20; size: 100, 24; cursor: pointer; role: button; label: "Done" }
            box { from: cx - 176, 20; size: 120, 24; corner: 4; color: fl.well; opacity: 0.7 + 0.3 * adn.hover }
            box { from: cx - 50, 20; size: 110, 24; corner: 4; color: fl.well; opacity: if(wg_nviz >= 3, 0.3, 0.7 + 0.3 * adv.hover) }
            box { from: cx + 66, 20; size: 86, 24; corner: 4; color: if(wg_snap, fl.phos_fill, fl.well); opacity: 0.7 + 0.3 * snp.hover }
            box { from: cx + 160, 20; size: 100, 24; corner: 4; color: fl.phos_fill; opacity: 0.8 + 0.2 * don.hover }
            text "+ NOW PLAYING" { at: cx - 116, 32; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: fl.engrave }
            text "+ VISUALISER" { at: cx + 5, 32; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: fl.engrave }
            text pick(wg_snap, "SNAP OFF", "SNAP ON") { at: cx + 109, 32; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(wg_snap, fl.ink, fl.engrave) }
            text "DONE" { at: cx + 210, 32; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: fl.ink }
            on press adn { wg_hold = 0; emit wg_add(0) }
            on press adv { wg_hold = 0; emit wg_add(1) }
            on press snp { wg_hold = 0; emit wg_tool(14) }
            on press don { wg_hold = 0; emit wg_edit(0) }
            // what happened (three visualisers at most, locked ones left alone)
            text wg_note { at: cx, 104; anchor: center; align: center; size: 10; family: "Share Tech Mono"; color: fl.ember; width: 520; lines: 1 }
            // the tools: align, spread and match need two or more; order and lock one or more
            group {
                show: wg_nsel >= 1
                let n2 = wg_nsel >= 2
                let tx0 = cx - 270 + 8
                let tx1 = cx + 270 - 8 - 3 * 62 + 4
                box { from: cx - 270, 58; size: 540, 38; corner: 6; color: fl.hull; opacity: 0.9 }
                group {
                    opacity: if(n2, 1, 0.3)
                zone box tb1 { from: tx0 + 0, 64; size: 30, 26; cursor: pointer; role: button; label: "Align left" }
                box { from: tx0 + 0, 64; size: 30, 26; corner: 4; color: mix(fl.well, fl.phos_fill, 0.6 * tb1.hover) }
                text "◧" { at: tx0 + 0 + 15, 77; anchor: center; align: center; size: 13; family: "Exo 2"; color: fl.engrave }
                on press tb1 { wg_hold = 0; emit wg_tool(1) }
                zone box tb2 { from: tx0 + 34, 64; size: 30, 26; cursor: pointer; role: button; label: "Align centres" }
                box { from: tx0 + 34, 64; size: 30, 26; corner: 4; color: mix(fl.well, fl.phos_fill, 0.6 * tb2.hover) }
                text "◫" { at: tx0 + 34 + 15, 77; anchor: center; align: center; size: 13; family: "Exo 2"; color: fl.engrave }
                on press tb2 { wg_hold = 0; emit wg_tool(2) }
                zone box tb3 { from: tx0 + 68, 64; size: 30, 26; cursor: pointer; role: button; label: "Align right" }
                box { from: tx0 + 68, 64; size: 30, 26; corner: 4; color: mix(fl.well, fl.phos_fill, 0.6 * tb3.hover) }
                text "◨" { at: tx0 + 68 + 15, 77; anchor: center; align: center; size: 13; family: "Exo 2"; color: fl.engrave }
                on press tb3 { wg_hold = 0; emit wg_tool(3) }
                zone box tb4 { from: tx0 + 102, 64; size: 30, 26; cursor: pointer; role: button; label: "Align tops" }
                box { from: tx0 + 102, 64; size: 30, 26; corner: 4; color: mix(fl.well, fl.phos_fill, 0.6 * tb4.hover) }
                text "⬒" { at: tx0 + 102 + 15, 77; anchor: center; align: center; size: 13; family: "Exo 2"; color: fl.engrave }
                on press tb4 { wg_hold = 0; emit wg_tool(4) }
                zone box tb5 { from: tx0 + 136, 64; size: 30, 26; cursor: pointer; role: button; label: "Align middles" }
                box { from: tx0 + 136, 64; size: 30, 26; corner: 4; color: mix(fl.well, fl.phos_fill, 0.6 * tb5.hover) }
                text "⊟" { at: tx0 + 136 + 15, 77; anchor: center; align: center; size: 13; family: "Exo 2"; color: fl.engrave }
                on press tb5 { wg_hold = 0; emit wg_tool(5) }
                zone box tb6 { from: tx0 + 170, 64; size: 30, 26; cursor: pointer; role: button; label: "Align bottoms" }
                box { from: tx0 + 170, 64; size: 30, 26; corner: 4; color: mix(fl.well, fl.phos_fill, 0.6 * tb6.hover) }
                text "⬓" { at: tx0 + 170 + 15, 77; anchor: center; align: center; size: 13; family: "Exo 2"; color: fl.engrave }
                on press tb6 { wg_hold = 0; emit wg_tool(6) }
                zone box tb7 { from: tx0 + 204, 64; size: 30, 26; cursor: pointer; role: button; label: "Spread across" }
                box { from: tx0 + 204, 64; size: 30, 26; corner: 4; color: mix(fl.well, fl.phos_fill, 0.6 * tb7.hover) }
                text "⇹" { at: tx0 + 204 + 15, 77; anchor: center; align: center; size: 13; family: "Exo 2"; color: fl.engrave }
                on press tb7 { wg_hold = 0; emit wg_tool(7) }
                zone box tb8 { from: tx0 + 238, 64; size: 30, 26; cursor: pointer; role: button; label: "Spread down" }
                box { from: tx0 + 238, 64; size: 30, 26; corner: 4; color: mix(fl.well, fl.phos_fill, 0.6 * tb8.hover) }
                text "⇳" { at: tx0 + 238 + 15, 77; anchor: center; align: center; size: 13; family: "Exo 2"; color: fl.engrave }
                on press tb8 { wg_hold = 0; emit wg_tool(8) }
                zone box tb9 { from: tx0 + 272, 64; size: 30, 26; cursor: pointer; role: button; label: "Same width" }
                box { from: tx0 + 272, 64; size: 30, 26; corner: 4; color: mix(fl.well, fl.phos_fill, 0.6 * tb9.hover) }
                text "↔" { at: tx0 + 272 + 15, 77; anchor: center; align: center; size: 13; family: "Exo 2"; color: fl.engrave }
                on press tb9 { wg_hold = 0; emit wg_tool(9) }
                zone box tb10 { from: tx0 + 306, 64; size: 30, 26; cursor: pointer; role: button; label: "Same height" }
                box { from: tx0 + 306, 64; size: 30, 26; corner: 4; color: mix(fl.well, fl.phos_fill, 0.6 * tb10.hover) }
                text "↕" { at: tx0 + 306 + 15, 77; anchor: center; align: center; size: 13; family: "Exo 2"; color: fl.engrave }
                on press tb10 { wg_hold = 0; emit wg_tool(10) }
                }
                zone box tb11 { from: tx1 + 0, 64; size: 58, 26; cursor: pointer; role: button; label: "Bring to the front" }
                box { from: tx1 + 0, 64; size: 58, 26; corner: 4; color: mix(fl.well, fl.phos_fill, 0.6 * tb11.hover) }
                text "FRONT" { at: tx1 + 0 + 29, 77; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: fl.engrave }
                on press tb11 { wg_hold = 0; emit wg_tool(11) }
                zone box tb12 { from: tx1 + 62, 64; size: 58, 26; cursor: pointer; role: button; label: "Send to the back" }
                box { from: tx1 + 62, 64; size: 58, 26; corner: 4; color: mix(fl.well, fl.phos_fill, 0.6 * tb12.hover) }
                text "BACK" { at: tx1 + 62 + 29, 77; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: fl.engrave }
                on press tb12 { wg_hold = 0; emit wg_tool(12) }
                zone box tb13 { from: tx1 + 124, 64; size: 58, 26; cursor: pointer; role: button; label: "Lock or unlock" }
                box { from: tx1 + 124, 64; size: 58, 26; corner: 4; color: mix(fl.well, fl.phos_fill, 0.6 * tb13.hover) }
                text "LOCK" { at: tx1 + 124 + 29, 77; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: fl.engrave }
                on press tb13 { wg_hold = 0; emit wg_tool(13) }
            }
        }
        group { show: editing and wg_sel >= 0 and wg_dk < 0 and wg_rk < 0
                wg.Panel(wg_px, wg_py, wg_sel) }

        // the editor's keys
        on key Escape while editing and wg_nsel > 0 { emit wg_sel(2) }
        on key Escape while editing and wg_nsel == 0 { emit wg_edit(0) }
        on key Left while editing { emit wg_key(1) }
        on key Right while editing { emit wg_key(2) }
        on key Up while editing { emit wg_key(3) }
        on key Down while editing { emit wg_key(4) }
        on key Shift+Left while editing { emit wg_key(5) }
        on key Shift+Right while editing { emit wg_key(6) }
        on key Shift+Up while editing { emit wg_key(7) }
        on key Shift+Down while editing { emit wg_key(8) }
        on key Delete while editing { emit wg_key(9) }
        on key Ctrl+d while editing { emit wg_key(10) }
        on key Ctrl+z while editing { emit wg_key(11) }
        on key Ctrl+Shift+z while editing { emit wg_key(12) }
        on key Ctrl+a while editing { emit wg_key(13) }
        on key l while editing { emit wg_key(14) }
        on key bracketright while editing { emit wg_key(15) }
        on key bracketleft while editing { emit wg_key(16) }
    }

    on change desk.width * 4096 + desk.height { emit wg_room(desk.width * 4096 + desk.height) }
}
