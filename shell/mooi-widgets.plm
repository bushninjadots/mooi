        for w in wg {
            let k = w.index
            // the widget being pulled is drawn at the size in the hand (facts, not the model, so
            // nothing is rebuilt under the pointer while it moves)
            let rz = wg_rk == k
            let wx = if(rz, wg_sx, w.x)
            let wy = if(rz, wg_sy, w.y)
            let ww = if(rz, wg_sw, w.w)
            let wh = if(rz, wg_sh, w.h)
            let wu = if(rz, wg_ru, w.u)
            let hv = if(w.kind < 0.5 and not editing, pick(k, ph0, ph1, ph2, ph3, ph4, ph5, ph6, ph7, ph8, ph9, ph10, ph11, ph12, ph13, ph14, ph15), 0)
            let fo = max(if(viz_still, w.op, pick(k, po0, po1, po2, po3, po4, po5, po6, po7, po8, po9, po10, po11, po12, po13, po14, po15)), 0.9 * hv * if(w.st < 1.5, 1, 0))
            // only a widget that shows music can be pointed at (a hidden one, or the visualiser, never)
            let over = w.kind < 0.5 and (w.st < 1.5 or editing) and desk.cursor.x >= w.x and desk.cursor.x <= w.x + w.w and desk.cursor.y >= w.y and desk.cursor.y <= w.y + w.h
            on change over { emit wg_hov(k * 10 + if(over, 1, 0)) }
            let along = wg_dk == k or (wg_dk >= 0 and wg_dksel and w.sel and not w.locked)
            let ox = if(along, wg_dx, 0)
            let oy = if(along, wg_dy, 0)
            // read against the wallpaper under it (D139), or the palette
            // … or in the style chosen for them all (D141, wg_style; tools/gen-wlanes.py writes the same)
            let ink = pick(wg_style, if(w.adapt and w.ar + w.ag + w.ab > 0, if(w.tn > 0.5, #15181c, #eef1f4), fl.engrave), #dcffe9, #16191c, #f2f5f8, #2b2722)
            let acc = pick(wg_style, if(w.adapt and w.ar + w.ag + w.ab > 0, rgb(w.ar, w.ag, w.ab), fl.phos), fl.phos, fl.ember, #a9c4dc, #b4532f)
            // the ambient rest (D141): resting faint, it comes back as the pointer nears; near enough, all wake
            let near = clamp(1 - max(max(0, max(w.x - desk.cursor.x, desk.cursor.x - w.x - w.w)), max(0, max(w.y - desk.cursor.y, desk.cursor.y - w.y - w.h))) / 220, 0, 1)
            let wake = near > 0.7
            on change wake while wake and wg_amb { wg_amb = false }
            let seen = if(editing, if(w.gh, 0.4, 1), fo) * w.opa * (1 - 0.85 * wg_ambs * (1 - near))
            // D209: below the wallpaper the widget is only there while the opening shows, and only
            // inside the hole; kept above (or being edited, or in desk mode) it is whole again.
            group {
                show: not sf_on or w.above or editing or wg_desk or op_vis
                // a clip box cannot be shown/hidden: when the widget is not below, its region is the whole surface
                let clip_on = sf_on and not w.above and not editing and not wg_desk
                clip box { from: if(clip_on, op_x, 0), if(clip_on, op_y - wall_bar, 0); size: if(clip_on, op_w, desk.width), if(clip_on, op_h, desk.height); corner: if(clip_on, op_r, 0) }
            group {
                z: if(w.behind, 1, 3)
                opacity: seen + (1 - seen) * wg_dkp
                show: editing or wg_dkp > 0.01 or (w.st < 1.5 and fo > 0.01)
                // desk mode carries it to its place in the gathering
                move: ox + w.dx * wg_dkp, oy + w.dy * wg_dkp
                group { show: w.kind < 0.5 and w.lay < 0.5
                        wg.Sleeve(wx, wy, ww, wh, wu, w.lyr, w.prog, w.plate, k, hv, w.txt, ink, acc, w.hz, w.tn, w.viz) }
                group { show: w.kind < 0.5 and w.lay > 0.5 and w.lay < 1.5
                        wg.LyricStage(wx, wy, ww, wh, wu, w.plate, k, hv, w.txt, ink, acc, w.hz, w.tn, w.viz) }
                group { show: w.kind > 1.5 and w.kind < 2.5 and w.lay < 0.5
                        wg.ClockDigital(wx, wy, ww, wh, wu, w.h24, w.secs, w.plate, ink, acc, w.hz, w.tn) }
                group { show: w.kind > 1.5 and w.kind < 2.5 and w.lay > 0.5 and w.lay < 1.5
                        wg.ClockAnalogue(wx, wy, ww, wh, wu, w.secs, w.plate, ink, acc, w.hz, w.tn) }
                group { show: w.kind > 1.5 and w.kind < 2.5 and w.lay > 1.5 and w.lay < 2.5
                        wg.ClockWords(wx, wy, ww, wh, wu, w.plate, ink, acc, w.hz, w.tn) }
                group { show: w.kind > 1.5 and w.kind < 2.5 and w.lay > 2.5
                        wg.ClockInfo(wx, wy, ww, wh, wu, w.h24, w.plate, ink, acc, w.hz, w.tn) }
                group { show: w.kind > 7.5 and w.kind < 8.5
                        wx.Timer(wx, wy, ww, wh, wu, w.lay, k, w.plate, ink, acc, w.hz, w.tn) }
                group { show: w.kind > 8.5 and w.kind < 9.5
                        wx.Claude(wx, wy, ww, wh, wu, w.lay, w.plate, ink, acc, w.hz, w.tn) }
                group { show: w.kind > 9.5 and w.kind < 10.5
                        wx.Photo(wx, wy, ww, wh, wu, w.lay, w.pop, w.plate, ink, acc, w.hz, w.tn) }
                box { from: wx, wy; size: ww, wh; corner: 6; stroke: 1; color: fl.trace_lit; opacity: 0.4 * wg_ambs * (1 - near); show: not editing }
                group { show: w.kind < 0.5 and w.lay > 1.5
                        wg.Record(wx, wy, ww, wh, wu, w.plate, w.prog, k, hv, w.txt, ink, acc, w.hz, w.tn, w.viz) }
            }
            group { z: 3; show: w.st > 2.5 and not editing
                    wg.Marker(w.x, w.y, w.u, k) }

            // edit mode: its outline (lit when chosen), the hand that carries it, eight handles
            // (no `z:` here: a z inside the loop hid the whole group under pleamar 0.7.11 — the
            // outlines and handles were gone; declared after the widget, it is drawn over it)
            group {
                show: editing
                // a record and an analogue clock keep their shape: corners only
                let rec = (w.kind < 0.5 and w.lay > 1.5) or (w.kind > 1.5 and w.kind < 2.5 and w.lay > 0.5 and w.lay < 1.5) or (w.kind > 7.5 and w.kind < 8.5 and w.lay < 0.5) or (w.kind > 9.5 and w.kind < 10.5 and w.lay > 0.5)
                let xx = wx + ox
                let yy = wy + oy
                box { from: xx, yy; size: ww, wh; corner: 4; stroke: if(w.sel, 2, 1); color: if(w.sel, fl.phos, fl.trace_lit); opacity: if(w.sel, 1, 0.6) }
                // a visualiser's look can be turned (lib/widgets options.angle): its frame and the
                // grip above it turn with it, so the angle is seen even over a still look
                group {
                    show: w.kind > 0.5 and w.kind < 1.5 and w.sel and wg_sel == k and wg_dk < 0 and wg_rk < 0
                    pivot: xx + ww / 2, yy + wh / 2
                    rotate: wg_oa * 1deg
                    box { from: xx, yy; size: ww, wh; corner: 4; stroke: 1.6; color: fl.ember; opacity: 0.9 }
                    line { from: xx + ww / 2, yy; to: xx + ww / 2, yy - 22; width: 1; color: fl.ember; opacity: 0.9 }
                    ellipse { at: xx + ww / 2, yy - 26; radius: 10; color: fl.hull; opacity: 0.95 }
                    ellipse { at: xx + ww / 2, yy - 26; radius: 10; stroke: 1.4; color: fl.ember }
                    text "↻" { at: xx + ww / 2, yy - 26; anchor: center; align: center; size: 13; family: "Exo 2"; color: fl.ember }
                    text "{round(wg_oa)}°" { at: xx + ww / 2 + 18, yy - 26; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.engrave }
                    zone box rg { from: xx + ww / 2 - 14, yy - 40; size: 28, 28; cursor: grab; role: button; label: "Turn the visualiser" }
                    on press rg { wg_hold = 300 + k; emit wg_rot(k * 1000 + round(clamp(atan2(pointer.x - (xx + ww / 2), (yy + wh / 2) - pointer.y), -179, 180)) + 180) }
                    on drag rg while wg_hold == 300 + k { emit wg_rot(k * 1000 + round(clamp(atan2(pointer.x - (xx + ww / 2), (yy + wh / 2) - pointer.y), -179, 180)) + 180) }
                    on release rg while wg_hold == 300 + k { emit wg_rotd }
                }
                text "HIDDEN AT REST" { at: xx + 8, yy + 12; anchor: left center; size: 9; family: "Share Tech Mono"; color: fl.muted; show: w.gh }
                text "GROUP {w.grp}" { at: xx + ww - 8, yy - 8; anchor: right center; size: 9; weight: 700; family: "Share Tech Mono"; color: fl.flare; show: w.grp > 0 }
                text "OVER THE PICTURE'S SUBJECT" { at: xx + 8, yy + wh - 10; anchor: left center; size: 9; family: "Share Tech Mono"; color: fl.ember; show: w.over and not w.behind }
                text "BEHIND THE SUBJECT" { at: xx + 8, yy + wh - 10; anchor: left center; size: 9; family: "Share Tech Mono"; color: fl.phos; show: w.behind }
                // a padlock when it is locked
                group {
                    show: w.locked
                    box { from: xx + ww - 22, yy + 10; size: 12, 9; corner: 2; color: fl.ember }
                    arc { at: xx + ww - 16, yy + 10; radius: 4; width: 1.6; span: 180deg; rotate: -90deg; color: fl.ember }
                }
                zone box mv { from: w.x, w.y; size: w.w, w.h; cursor: if(w.locked, pointer, grab); role: button; label: "Choose or move this widget" }
                on press mv { wg_hold = 100 + k; emit wg_sel(k * 10) }
                on press right mv { wg_hold = 0; emit wg_sel(k * 10 + 1) }
                on drag mv while wg_hold == 100 + k and not w.locked and not op_vis {
                    wg_dk = k; wg_dx = drag.dx; wg_dy = drag.dy
                    emit wg_drag(k * 65536 + clamp(round((w.x + drag.dx) / 8), 0, 255) * 256 + clamp(round((w.y + drag.dy) / 8), 0, 255))
                }
                // D209: a drag while the opening shows freezes its hole so the drop can land outside
                on drag mv while wg_hold == 100 + k and not w.locked and op_vis and not editing { emit sb_drag(-1) }
                // the offset stays until the logic has put it where it settles (no flash back)
                // D209: let go outside the hole → kept above, where it was let go; inside → back below
                on release mv while wg_hold == 100 + k and op_vis and not w.above and not editing and (cursor.x < op_x or cursor.x > op_x + op_w or cursor.y < op_y or cursor.y > op_y + op_h) {
                    wg_hold = 0
                    emit wg_keep(k * 4096 + round(cursor.x))
                    emit wg_keep_y(k * 4096 + round(cursor.y))
                    emit sb_drop(-1)
                }
                on release mv while wg_hold == 100 + k and op_vis and w.above and not editing and cursor.x >= op_x and cursor.x <= op_x + op_w and cursor.y >= op_y and cursor.y <= op_y + op_h {
                    wg_hold = 0
                    emit wg_bury(k)
                    emit sb_drop(-1)
                }
                on release mv while wg_hold == 100 + k and op_vis { wg_hold = 0; emit sb_drop(-1) }
                on release mv while wg_hold == 100 + k and wg_dk == k { emit wg_drop(k) }
                // eight handles on the chosen one: corners and edge middles (a record keeps its shape: corners only)
                group {
                    show: w.sel and not w.locked and wg_dk < 0
                    repeat hd in 0..8 {
                        let hx = wx + pick(hd, 0, 0.5, 1, 1, 1, 0.5, 0, 0) * ww
                        let hy = wy + pick(hd, 0, 0, 0, 0.5, 1, 1, 1, 0.5) * wh
                        let corner = mod(hd, 2) == 0
                        group {
                            show: corner or not rec
                            box { from: hx - 5, hy - 5; size: 10, 10; corner: 2; color: fl.hull }
                            box { from: hx - 5, hy - 5; size: 10, 10; corner: 2; stroke: 1.4; color: fl.phos }
                            zone box hz { from: hx - 9, hy - 9; size: 18, 18; role: button; label: "Resize"
                                          cursor: pick(hd, nwse_resize, ns_resize, nesw_resize, ew_resize, nwse_resize, ns_resize, nesw_resize, ew_resize) }
                            on press hz { wg_hold = 200 + k * 8 + hd; emit wg_hgrab(k * 8 + hd) }
                            on drag hz while wg_hold == 200 + k * 8 + hd { emit wg_hmove((round(clamp(drag.dx, -2047, 2047)) + 2048) * 4096 + round(clamp(drag.dy, -2047, 2047)) + 2048) }
                            on release hz while wg_hold == 200 + k * 8 + hd { emit wg_hdrop }
                        }
                    }
                }
            }
            }
        }

        // where a carried or pulled widget will settle, and the lines it snapped to
        group {
            z: 6
            show: editing and wg_dk >= 0
            box { from: wg_sx, wg_sy; size: wg_sw, wg_sh; corner: 4; color: fl.phos; opacity: 0.12 }
            box { from: wg_sx, wg_sy; size: wg_sw, wg_sh; corner: 4; stroke: 1.5; color: fl.phos; opacity: 0.8 }
            box { from: wg_gvx, 0; size: 1, desk.height; color: fl.ember; opacity: 0.8; show: wg_gvx >= 0 }
            box { from: 0, wg_ghy; size: desk.width, 1; color: fl.ember; opacity: 0.8; show: wg_ghy >= 0 }
        }

        // the marquee being drawn
        group {
            z: 6
            show: editing and wg_mon
            box { from: min(wg_mx, wg_mx + wg_mdx), min(wg_my, wg_my + wg_mdy); size: abs(wg_mdx), abs(wg_mdy); color: fl.phos; opacity: 0.08 }
            box { from: min(wg_mx, wg_mx + wg_mdx), min(wg_my, wg_my + wg_mdy); size: abs(wg_mdx), abs(wg_mdy); stroke: 1; color: fl.phos; opacity: 0.8 }
        }
        // the size and place while carried or pulled, by the pointer
        group {
            z: 6
            show: editing and (wg_dk >= 0 or wg_rk >= 0)
            box { from: desk.cursor.x + 16, desk.cursor.y + 16; size: 150, 22; corner: 4; color: fl.hull; opacity: 0.92 }
            text wg_readout { at: desk.cursor.x + 24, desk.cursor.y + 27; anchor: left center; size: 10; family: "Share Tech Mono"; color: fl.phos; width: 140; lines: 1 }
        }

        // the top bar: + Now Playing, + Visualiser, SNAP, Done; under it the tools for what is chosen
        group {
            z: 7
            show: editing
            let cx = desk.width / 2
            box { from: cx - 600, 12; size: 1200, 72; corner: 6; color: fl.hull; opacity: 0.94 }
            box { from: cx - 600, 12; size: 1200, 72; corner: 6; stroke: 1; color: fl.trace_lit; opacity: 0.8 }
            text "WIDGETS" { at: cx - 586, 32; anchor: left center; size: 11; weight: 700; family: "Share Tech Mono"; color: fl.phos }
            // what can be added (each kind's limit dims its chip)
            // (D215: sixteen kinds, so the chips are narrower)
            repeat ai in 0..16 {
                let ax = cx - 500 + ai * 68
                zone box adz { from: ax, 20; size: 65, 24; cursor: pointer; role: button
                               label: pick(ai, "Add Now Playing", "Add a visualiser", "Add a clock", "Add the notes", "Add a GitHub repo", "Add the weather", "Add the system scope", "Add the calendar", "Add a focus timer", "Add Claude", "Add a photo", "Add a launcher", "Add the notices", "Add the wallpapers", "Add the settings", "Add the controls") }
                let full = wg_count >= 16 or pick(ai, false, wg_nviz >= 3, false, wg_nnt >= 1, wg_ngh >= 2, wg_has5, wg_has6, wg_has7, wg_has8, wg_has9, wg_has10, wg_has11, wg_has12, wg_has13, wg_has14, wg_has15)
                box { from: ax, 20; size: 65, 24; corner: 4; color: fl.well; opacity: if(full, 0.3, 0.7 + 0.3 * adz.hover) }
                text pick(ai, "+ PLAYING", "+ VIZ", "+ CLOCK", "+ NOTES", "+ GITHUB", "+ WEATHER", "+ SYSTEM", "+ CALENDAR", "+ FOCUS", "+ CLAUDE", "+ PHOTO", "+ LAUNCH", "+ NOTICES", "+ WALLS", "+ SETTINGS", "+ CONTROLS") { at: ax + 32, 32; anchor: center; align: center; size: 7.5; weight: 700; family: "Share Tech Mono"; color: fl.engrave; opacity: if(full, 0.5, 1); width: 62; lines: 1 }
                on press adz { wg_hold = 0; emit wg_add(ai) }
            }
            // the look of them all, shadows, the ambient rest, desk mode; snapping; done
            text "LOOK" { at: cx - 586, 64; anchor: left center; size: 9; family: "Share Tech Mono"; color: fl.muted }
            repeat si in 0..5 {
                let sx = cx - 540 + si * 84
                zone box stz { from: sx, 52; size: 80, 24; cursor: pointer; role: tab; selected: wg_style == si; label: pick(si, "Adaptive look", "Phosphor look", "Ink look", "Chrome look", "Paper look") }
                box { from: sx, 52; size: 80, 24; corner: 4; color: if(wg_style == si, fl.phos_fill, fl.well); opacity: 0.7 + 0.3 * stz.hover }
                text pick(si, "ADAPTIVE", "PHOSPHOR", "INK", "CHROME", "PAPER") { at: sx + 40, 64; anchor: center; align: center; size: 9; weight: 700; family: "Share Tech Mono"; color: if(wg_style == si, fl.ink, fl.engrave) }
                on press stz { wg_hold = 0; emit wg_tool(20 + si) }
            }
            repeat ti in 0..3 {
                let sx = cx - 112 + ti * 92
                let lit = pick(ti, wg_shad, wg_ambon, wg_desk)
                zone box tgz { from: sx, 52; size: 88, 24; cursor: pointer; role: toggle; checked: lit; label: pick(ti, "Shadows", "Ambient rest", "Desk mode") }
                box { from: sx, 52; size: 88, 24; corner: 4; color: if(lit, fl.phos_fill, fl.well); opacity: 0.7 + 0.3 * tgz.hover }
                text pick(ti, "SHADOWS", "AMBIENT", "DESK MODE") { at: sx + 44, 64; anchor: center; align: center; size: 9; weight: 700; family: "Share Tech Mono"; color: if(lit, fl.ink, fl.engrave) }
                on press tgz { wg_hold = 0; emit wg_tool(25 + ti) }
            }
            zone box snp { from: cx + 290, 52; size: 86, 24; cursor: pointer; role: toggle; checked: wg_snap; label: "Snapping" }
            zone box don { from: cx + 384, 52; size: 200, 24; cursor: pointer; role: button; label: "Done" }
            box { from: cx + 290, 52; size: 86, 24; corner: 4; color: if(wg_snap, fl.phos_fill, fl.well); opacity: 0.7 + 0.3 * snp.hover }
            box { from: cx + 384, 52; size: 200, 24; corner: 4; color: fl.phos_fill; opacity: 0.8 + 0.2 * don.hover }
            text pick(wg_snap, "SNAP OFF", "SNAP ON") { at: cx + 333, 64; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: if(wg_snap, fl.ink, fl.engrave) }
            text "DONE" { at: cx + 484, 64; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: fl.ink }
            on press snp { wg_hold = 0; emit wg_tool(14) }
            on press don { wg_hold = 0; emit wg_edit(0) }
            // what happened (three visualisers at most, locked ones left alone)
            text wg_note { at: cx, 136; anchor: center; align: center; size: 10; family: "Share Tech Mono"; color: fl.ember; width: 520; lines: 1 }
            // the tools: align, spread and match need two or more; order and lock one or more
            group {
                show: wg_nsel >= 1
                move: 0, 32
                let n2 = wg_nsel >= 2
                let tx0 = cx - 350 + 8
                let tx1 = cx + 350 - 8 - 3 * 62 + 4
                let txg = cx + 4
                box { from: cx - 350, 58; size: 700, 38; corner: 6; color: fl.hull; opacity: 0.9 }
                group {
                    opacity: if(n2, 1, 0.3)
                zone box tb1 { from: tx0 + 0, 64; size: 30, 26; cursor: pointer; role: button; label: "Align left" }
                box { from: tx0 + 0, 64; size: 30, 26; corner: 4; color: mix(fl.well, fl.phos_fill, 0.6 * tb1.hover) }
                text "◧" { at: tx0 + 0 + 15, 77; anchor: center; align: center; size: 13; family: "Exo 2"; color: fl.engrave }
                on press tb1 { wg_hold = 0; emit wg_tool(1) }
                zone box tb2 { from: tx0 + 34, 64; size: 30, 26; cursor: pointer; role: button; label: "Align centres" }
                box { from: tx0 + 34, 64; size: 30, 26; corner: 4; color: mix(fl.well, fl.phos_fill, 0.6 * tb2.hover) }
                text "◫" { at: tx0 + 34 + 15, 77; anchor: center; align: center; size: 13; family: "Exo 2"; color: fl.engrave }
                on press tb2 { wg_hold = 0; emit wg_tool(2) }
                zone box tb3 { from: tx0 + 68, 64; size: 30, 26; cursor: pointer; role: button; label: "Align right" }
                box { from: tx0 + 68, 64; size: 30, 26; corner: 4; color: mix(fl.well, fl.phos_fill, 0.6 * tb3.hover) }
                text "◨" { at: tx0 + 68 + 15, 77; anchor: center; align: center; size: 13; family: "Exo 2"; color: fl.engrave }
                on press tb3 { wg_hold = 0; emit wg_tool(3) }
                zone box tb4 { from: tx0 + 102, 64; size: 30, 26; cursor: pointer; role: button; label: "Align tops" }
                box { from: tx0 + 102, 64; size: 30, 26; corner: 4; color: mix(fl.well, fl.phos_fill, 0.6 * tb4.hover) }
                text "⬒" { at: tx0 + 102 + 15, 77; anchor: center; align: center; size: 13; family: "Exo 2"; color: fl.engrave }
                on press tb4 { wg_hold = 0; emit wg_tool(4) }
                zone box tb5 { from: tx0 + 136, 64; size: 30, 26; cursor: pointer; role: button; label: "Align middles" }
                box { from: tx0 + 136, 64; size: 30, 26; corner: 4; color: mix(fl.well, fl.phos_fill, 0.6 * tb5.hover) }
                text "⊟" { at: tx0 + 136 + 15, 77; anchor: center; align: center; size: 13; family: "Exo 2"; color: fl.engrave }
                on press tb5 { wg_hold = 0; emit wg_tool(5) }
                zone box tb6 { from: tx0 + 170, 64; size: 30, 26; cursor: pointer; role: button; label: "Align bottoms" }
                box { from: tx0 + 170, 64; size: 30, 26; corner: 4; color: mix(fl.well, fl.phos_fill, 0.6 * tb6.hover) }
                text "⬓" { at: tx0 + 170 + 15, 77; anchor: center; align: center; size: 13; family: "Exo 2"; color: fl.engrave }
                on press tb6 { wg_hold = 0; emit wg_tool(6) }
                zone box tb7 { from: tx0 + 204, 64; size: 30, 26; cursor: pointer; role: button; label: "Spread across" }
                box { from: tx0 + 204, 64; size: 30, 26; corner: 4; color: mix(fl.well, fl.phos_fill, 0.6 * tb7.hover) }
                text "⇹" { at: tx0 + 204 + 15, 77; anchor: center; align: center; size: 13; family: "Exo 2"; color: fl.engrave }
                on press tb7 { wg_hold = 0; emit wg_tool(7) }
                zone box tb8 { from: tx0 + 238, 64; size: 30, 26; cursor: pointer; role: button; label: "Spread down" }
                box { from: tx0 + 238, 64; size: 30, 26; corner: 4; color: mix(fl.well, fl.phos_fill, 0.6 * tb8.hover) }
                text "⇳" { at: tx0 + 238 + 15, 77; anchor: center; align: center; size: 13; family: "Exo 2"; color: fl.engrave }
                on press tb8 { wg_hold = 0; emit wg_tool(8) }
                zone box tb9 { from: tx0 + 272, 64; size: 30, 26; cursor: pointer; role: button; label: "Same width" }
                box { from: tx0 + 272, 64; size: 30, 26; corner: 4; color: mix(fl.well, fl.phos_fill, 0.6 * tb9.hover) }
                text "↔" { at: tx0 + 272 + 15, 77; anchor: center; align: center; size: 13; family: "Exo 2"; color: fl.engrave }
                on press tb9 { wg_hold = 0; emit wg_tool(9) }
                zone box tb10 { from: tx0 + 306, 64; size: 30, 26; cursor: pointer; role: button; label: "Same height" }
                box { from: tx0 + 306, 64; size: 30, 26; corner: 4; color: mix(fl.well, fl.phos_fill, 0.6 * tb10.hover) }
                text "↕" { at: tx0 + 306 + 15, 77; anchor: center; align: center; size: 13; family: "Exo 2"; color: fl.engrave }
                on press tb10 { wg_hold = 0; emit wg_tool(10) }
                }
                zone box tb11 { from: tx1 + 0, 64; size: 58, 26; cursor: pointer; role: button; label: "Bring to the front" }
                box { from: tx1 + 0, 64; size: 58, 26; corner: 4; color: mix(fl.well, fl.phos_fill, 0.6 * tb11.hover) }
                text "FRONT" { at: tx1 + 0 + 29, 77; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: fl.engrave }
                on press tb11 { wg_hold = 0; emit wg_tool(11) }
                zone box tb12 { from: tx1 + 62, 64; size: 58, 26; cursor: pointer; role: button; label: "Send to the back" }
                box { from: tx1 + 62, 64; size: 58, 26; corner: 4; color: mix(fl.well, fl.phos_fill, 0.6 * tb12.hover) }
                text "BACK" { at: tx1 + 62 + 29, 77; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: fl.engrave }
                on press tb12 { wg_hold = 0; emit wg_tool(12) }
                zone box tb13 { from: tx1 + 124, 64; size: 58, 26; cursor: pointer; role: button; label: "Lock or unlock" }
                box { from: tx1 + 124, 64; size: 58, 26; corner: 4; color: mix(fl.well, fl.phos_fill, 0.6 * tb13.hover) }
                text "LOCK" { at: tx1 + 124 + 29, 77; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: fl.engrave }
                on press tb13 { wg_hold = 0; emit wg_tool(13) }
                // groups (D141): carried, chosen and faded as one
                group {
                    opacity: if(n2, 1, 0.3)
                    zone box tbg { from: txg, 64; size: 70, 26; cursor: pointer; role: button; label: "Group them" }
                    box { from: txg, 64; size: 70, 26; corner: 4; color: mix(fl.well, fl.phos_fill, 0.6 * tbg.hover) }
                    text "GROUP" { at: txg + 35, 77; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: fl.engrave }
                    on press tbg { wg_hold = 0; emit wg_tool(15) }
                }
                zone box tbu { from: txg + 74, 64; size: 76, 26; cursor: pointer; role: button; label: "Ungroup" }
                box { from: txg + 74, 64; size: 76, 26; corner: 4; color: mix(fl.well, fl.phos_fill, 0.6 * tbu.hover) }
                text "UNGROUP" { at: txg + 112, 77; anchor: center; align: center; size: 10; weight: 700; family: "Share Tech Mono"; color: fl.engrave }
                on press tbu { wg_hold = 0; emit wg_tool(16) }
            }
        }
        group { z: 8; show: editing and wg_sel >= 0 and wg_dk < 0 and wg_rk < 0
                wg.Panel(wg_px, wg_py, wg_sel) }

        // the editor's keys
        on key Escape while editing and wg_nsel > 0 { emit wg_sel(2) }
        on key Escape while editing and wg_nsel == 0 { emit wg_edit(0) }
        on key Left while editing { emit wg_key(1) }
        on key Right while editing { emit wg_key(2) }
        on key Up while editing { emit wg_key(3) }
        on key Down while editing { emit wg_key(4) }
        on key Shift+Left while editing { emit wg_key(5) }
        on key Shift+Right while editing { emit wg_key(6) }
        on key Shift+Up while editing { emit wg_key(7) }
        on key Shift+Down while editing { emit wg_key(8) }
        on key Delete while editing { emit wg_key(9) }
        on key Ctrl+d while editing { emit wg_key(10) }
        on key Ctrl+z while editing { emit wg_key(11) }
        on key Ctrl+Shift+z while editing { emit wg_key(12) }
        on key Ctrl+a while editing { emit wg_key(13) }
        on key l while editing { emit wg_key(14) }
        on key bracketright while editing { emit wg_key(15) }
        on key bracketleft while editing { emit wg_key(16) }
    }

    on change desk.width * 4096 + desk.height { emit wg_room(desk.width * 4096 + desk.height) }
}
