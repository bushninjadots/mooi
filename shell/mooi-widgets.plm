language 0.9
import "theme/tokens.plm"
import "theme/ferrolume.plm"
import "ui/widgets.plm" as wg
import "ui/vizwide.plm" as vw
import "ui/wgithub.plm" as wgh
import "ui/wextra.plm" as wx
import "ui/wbelow.plm" as wb

// mooi's desktop widgets (D137, docs/superpowers/specs/2026-11-03-widgets-design.md): Now Playing
// (Sleeve, Lyric stage, Record) and the Visualiser (twelve modes), on one surface over the
// wallpaper and under the desk's cutout and every window. A program of its own, kept by the bar
// while widgets.on; mooi-widgets.luau reads widgets.json (lib/widgets), the music and the bar's
// visualiser feed. The surface leaves the bar's strip to the bar, so y = 0 is just under it.
// Empty parts take no clicks: they go to the desktop.

scene Widgets {
    permissions {
        run: "pleamar", "mv", "playerctl", "curl", "cat", "mkdir", "mooi", "readlink", "gh", "xdg-open", "date", "sensors", "ps", "find", "nmcli", "bluetoothctl", "systemctl", "hyprctl"
        services: "files", "files.write", "media", "media.*", "audio", "audio.*", "env", "battery", "apps", "apps.launch", "window", "network", "network.*", "bluetooth", "bluetooth.*", "brightness", "brightness.*"
    }


    // corners on every plate (look.corners: 0 chamfer · 1 bevel · 2 rounded · 3 square; look.corner_size as a scale)
    fact cn_kind = 0
    fact cn_scale = 1
    fact fr_ground_r = 0.000000
    fact fr_ground_g = 0.000000
    fact fr_ground_b = 0.000000
    fact fr_hull_r = 0.015686
    fact fr_hull_g = 0.035294
    fact fr_hull_b = 0.031373
    fact fr_hull_raised_r = 0.027451
    fact fr_hull_raised_g = 0.074510
    fact fr_hull_raised_b = 0.066667
    fact fr_well_r = 0.019608
    fact fr_well_g = 0.164706
    fact fr_well_b = 0.145098
    fact fr_trace_dim_r = 0.121569
    fact fr_trace_dim_g = 0.219608
    fact fr_trace_dim_b = 0.200000
    fact fr_trace_r = 0.239216
    fact fr_trace_g = 0.415686
    fact fr_trace_b = 0.376471
    fact fr_trace_lit_r = 0.423529
    fact fr_trace_lit_g = 0.788235
    fact fr_trace_lit_b = 0.682353
    fact fr_phos_r = 0.498039
    fact fr_phos_g = 0.811765
    fact fr_phos_b = 0.713725
    fact fr_phos_fill_r = 0.090196
    fact fr_phos_fill_g = 0.603922
    fact fr_phos_fill_b = 0.533333
    fact fr_ember_r = 0.878431
    fact fr_ember_g = 0.482353
    fact fr_ember_b = 0.180392
    fact fr_ember_fill_r = 0.823529
    fact fr_ember_fill_g = 0.411765
    fact fr_ember_fill_b = 0.117647
    fact fr_flare_r = 0.956863
    fact fr_flare_g = 0.713725
    fact fr_flare_b = 0.235294
    fact fr_muted_r = 0.352941
    fact fr_muted_g = 0.541176
    fact fr_muted_b = 0.494118
    fact fr_ink_r = 0.015686
    fact fr_ink_g = 0.129412
    fact fr_ink_b = 0.113725
    fact fr_steel_900_r = 0.082353
    fact fr_steel_900_g = 0.098039
    fact fr_steel_900_b = 0.105882
    fact fr_steel_700_r = 0.164706
    fact fr_steel_700_g = 0.192157
    fact fr_steel_700_b = 0.203922
    fact fr_steel_500_r = 0.290196
    fact fr_steel_500_g = 0.329412
    fact fr_steel_500_b = 0.349020
    fact fr_steel_300_r = 0.545098
    fact fr_steel_300_g = 0.592157
    fact fr_steel_300_b = 0.611765
    fact fr_engrave_r = 0.603922
    fact fr_engrave_g = 0.650980
    fact fr_engrave_b = 0.670588
    prop pr_ground_r = 0.000000 ~fl.relight
    follow pr_ground_r = fr_ground_r
    prop pr_ground_g = 0.000000 ~fl.relight
    follow pr_ground_g = fr_ground_g
    prop pr_ground_b = 0.000000 ~fl.relight
    follow pr_ground_b = fr_ground_b
    prop pr_hull_r = 0.015686 ~fl.relight
    follow pr_hull_r = fr_hull_r
    prop pr_hull_g = 0.035294 ~fl.relight
    follow pr_hull_g = fr_hull_g
    prop pr_hull_b = 0.031373 ~fl.relight
    follow pr_hull_b = fr_hull_b
    prop pr_hull_raised_r = 0.027451 ~fl.relight
    follow pr_hull_raised_r = fr_hull_raised_r
    prop pr_hull_raised_g = 0.074510 ~fl.relight
    follow pr_hull_raised_g = fr_hull_raised_g
    prop pr_hull_raised_b = 0.066667 ~fl.relight
    follow pr_hull_raised_b = fr_hull_raised_b
    prop pr_well_r = 0.019608 ~fl.relight
    follow pr_well_r = fr_well_r
    prop pr_well_g = 0.164706 ~fl.relight
    follow pr_well_g = fr_well_g
    prop pr_well_b = 0.145098 ~fl.relight
    follow pr_well_b = fr_well_b
    prop pr_trace_dim_r = 0.121569 ~fl.relight
    follow pr_trace_dim_r = fr_trace_dim_r
    prop pr_trace_dim_g = 0.219608 ~fl.relight
    follow pr_trace_dim_g = fr_trace_dim_g
    prop pr_trace_dim_b = 0.200000 ~fl.relight
    follow pr_trace_dim_b = fr_trace_dim_b
    prop pr_trace_r = 0.239216 ~fl.relight
    follow pr_trace_r = fr_trace_r
    prop pr_trace_g = 0.415686 ~fl.relight
    follow pr_trace_g = fr_trace_g
    prop pr_trace_b = 0.376471 ~fl.relight
    follow pr_trace_b = fr_trace_b
    prop pr_trace_lit_r = 0.423529 ~fl.relight
    follow pr_trace_lit_r = fr_trace_lit_r
    prop pr_trace_lit_g = 0.788235 ~fl.relight
    follow pr_trace_lit_g = fr_trace_lit_g
    prop pr_trace_lit_b = 0.682353 ~fl.relight
    follow pr_trace_lit_b = fr_trace_lit_b
    prop pr_phos_r = 0.498039 ~fl.relight
    follow pr_phos_r = fr_phos_r
    prop pr_phos_g = 0.811765 ~fl.relight
    follow pr_phos_g = fr_phos_g
    prop pr_phos_b = 0.713725 ~fl.relight
    follow pr_phos_b = fr_phos_b
    prop pr_phos_fill_r = 0.090196 ~fl.relight
    follow pr_phos_fill_r = fr_phos_fill_r
    prop pr_phos_fill_g = 0.603922 ~fl.relight
    follow pr_phos_fill_g = fr_phos_fill_g
    prop pr_phos_fill_b = 0.533333 ~fl.relight
    follow pr_phos_fill_b = fr_phos_fill_b
    prop pr_ember_r = 0.878431 ~fl.relight
    follow pr_ember_r = fr_ember_r
    prop pr_ember_g = 0.482353 ~fl.relight
    follow pr_ember_g = fr_ember_g
    prop pr_ember_b = 0.180392 ~fl.relight
    follow pr_ember_b = fr_ember_b
    prop pr_ember_fill_r = 0.823529 ~fl.relight
    follow pr_ember_fill_r = fr_ember_fill_r
    prop pr_ember_fill_g = 0.411765 ~fl.relight
    follow pr_ember_fill_g = fr_ember_fill_g
    prop pr_ember_fill_b = 0.117647 ~fl.relight
    follow pr_ember_fill_b = fr_ember_fill_b
    prop pr_flare_r = 0.956863 ~fl.relight
    follow pr_flare_r = fr_flare_r
    prop pr_flare_g = 0.713725 ~fl.relight
    follow pr_flare_g = fr_flare_g
    prop pr_flare_b = 0.235294 ~fl.relight
    follow pr_flare_b = fr_flare_b
    prop pr_muted_r = 0.352941 ~fl.relight
    follow pr_muted_r = fr_muted_r
    prop pr_muted_g = 0.541176 ~fl.relight
    follow pr_muted_g = fr_muted_g
    prop pr_muted_b = 0.494118 ~fl.relight
    follow pr_muted_b = fr_muted_b
    prop pr_ink_r = 0.015686 ~fl.relight
    follow pr_ink_r = fr_ink_r
    prop pr_ink_g = 0.129412 ~fl.relight
    follow pr_ink_g = fr_ink_g
    prop pr_ink_b = 0.113725 ~fl.relight
    follow pr_ink_b = fr_ink_b
    prop pr_steel_900_r = 0.082353 ~fl.relight
    follow pr_steel_900_r = fr_steel_900_r
    prop pr_steel_900_g = 0.098039 ~fl.relight
    follow pr_steel_900_g = fr_steel_900_g
    prop pr_steel_900_b = 0.105882 ~fl.relight
    follow pr_steel_900_b = fr_steel_900_b
    prop pr_steel_700_r = 0.164706 ~fl.relight
    follow pr_steel_700_r = fr_steel_700_r
    prop pr_steel_700_g = 0.192157 ~fl.relight
    follow pr_steel_700_g = fr_steel_700_g
    prop pr_steel_700_b = 0.203922 ~fl.relight
    follow pr_steel_700_b = fr_steel_700_b
    prop pr_steel_500_r = 0.290196 ~fl.relight
    follow pr_steel_500_r = fr_steel_500_r
    prop pr_steel_500_g = 0.329412 ~fl.relight
    follow pr_steel_500_g = fr_steel_500_g
    prop pr_steel_500_b = 0.349020 ~fl.relight
    follow pr_steel_500_b = fr_steel_500_b
    prop pr_steel_300_r = 0.545098 ~fl.relight
    follow pr_steel_300_r = fr_steel_300_r
    prop pr_steel_300_g = 0.592157 ~fl.relight
    follow pr_steel_300_g = fr_steel_300_g
    prop pr_steel_300_b = 0.611765 ~fl.relight
    follow pr_steel_300_b = fr_steel_300_b
    prop pr_engrave_r = 0.603922 ~fl.relight
    follow pr_engrave_r = fr_engrave_r
    prop pr_engrave_g = 0.650980 ~fl.relight
    follow pr_engrave_g = fr_engrave_g
    prop pr_engrave_b = 0.670588 ~fl.relight
    follow pr_engrave_b = fr_engrave_b


    // The islands' semantic tokens, which theme/tokens defines over these facts.
    fact c_bg_primary_r = 0.062745
    fact c_bg_primary_g = 0.078431
    fact c_bg_primary_b = 0.086275
    fact c_bg_secondary_r = 0.086275
    fact c_bg_secondary_g = 0.105882
    fact c_bg_secondary_b = 0.117647
    fact c_surface_primary_r = 0.098039
    fact c_surface_primary_g = 0.121569
    fact c_surface_primary_b = 0.133333
    fact c_surface_elevated_r = 0.133333
    fact c_surface_elevated_g = 0.160784
    fact c_surface_elevated_b = 0.176471
    fact c_border_subtle_r = 0.172549
    fact c_border_subtle_g = 0.207843
    fact c_border_subtle_b = 0.223529
    fact c_fg_primary_r = 0.890196
    fact c_fg_primary_g = 0.913725
    fact c_fg_primary_b = 0.921569
    fact c_fg_secondary_r = 0.639216
    fact c_fg_secondary_g = 0.690196
    fact c_fg_secondary_b = 0.709804
    fact c_fg_muted_r = 0.541176
    fact c_fg_muted_g = 0.592157
    fact c_fg_muted_b = 0.611765
    fact c_accent_primary_r = 0.650980
    fact c_accent_primary_g = 0.952941
    fact c_accent_primary_b = 0.819608
    fact c_accent_secondary_r = 1.000000
    fact c_accent_secondary_g = 0.572549
    fact c_accent_secondary_b = 0.372549
    fact c_status_ok_r = 0.650980
    fact c_status_ok_g = 0.952941
    fact c_status_ok_b = 0.819608
    fact c_status_error_r = 1.000000
    fact c_status_error_g = 0.572549
    fact c_status_error_b = 0.372549
    fact c_focus_ring_r = 0.650980
    fact c_focus_ring_g = 0.952941
    fact c_focus_ring_b = 0.819608
    fact c_selection_bg_r = 0.164706
    fact c_selection_bg_g = 0.227451
    fact c_selection_bg_b = 0.211765

    // What theme/ferrolume reads for its geometry (the bar's strip; unused here) and the finish.
    fact st_offset = 0
    fact st_notch = false
    fact bar_rail = true
    fact st_height = 30
    fact st_radius = 8
    fact st_res = 46
    fact st_glow = 1

    // the widgets as widgets.json has them, worked out by lib/widgets (kind 0 now playing,
    // 1 visualiser; lay 0 sleeve, 1 lyric stage, 2 record; st 0 shown, 1 resting, 2 hidden, 3 marker)
    model wg max 16 { kind: number; lay: number; mode: number; x: number; y: number; w: number; h: number; u: number; idle: number; st: number; op: number; glow: number; plate: bool; lyr: bool; prog: bool; gh: bool; adapt: bool; behind: bool; tn: number; hz: number; ar: number; ag: number; ab: number; over: bool; bars: number; gap: number; peaks: bool; refl: bool; vslot: number; opa: number; txt: number; locked: bool; sel: bool; h24: bool; secs: bool; viz: bool; dx: number; dy: number; grp: number; pop: bool; above: bool }

    // what is playing (any player, through the media service)
    text np_title = ""
    text np_artist = ""
    text np_prev = ""
    text np_line = ""
    text np_next = ""
    text np_cover_path = ""
    image cover = from np_cover_path, 480, 480
    fact np_has = false
    fact np_cover_on = false
    fact np_playing = false
    fact np_progress = 0
    fact np_arm_at = 0
    fact np_line_in = 1
    fact np_sung = false
    fact viz_still = false
    // D155: mooi-viz draws the visualisers (a program of its own); these draw them only while edited or
    // gathered, or when it is not running. `np_rec`: a Now Playing in the Record layout (its turntable)
    fact viz_ext = false
    fact np_rec = false
    event wg_viz_hello ->        // from mooi-viz: it is up, tell it where the visualisers are
    fact wg_calm = true          // nothing pointed at, no fade running (the logic says)

    // the visualiser's feed (lib/vizfeed): sixteen bands, and what the beats leave behind
    fact vb0 = 0.03
    fact vb1 = 0.03
    fact vb2 = 0.03
    fact vb3 = 0.03
    fact vb4 = 0.03
    fact vb5 = 0.03
    fact vb6 = 0.03
    fact vb7 = 0.03
    fact vb8 = 0.03
    fact vb9 = 0.03
    fact vb10 = 0.03
    fact vb11 = 0.03
    fact vb12 = 0.03
    fact vb13 = 0.03
    fact vb14 = 0.03
    fact vb15 = 0.03
    fact np_beat = 0
    // D141: the transport's modes (shuffle; repeat 0 none · 1 the list · 2 the track) and the times
    fact np_shuf = false
    fact np_loop = 0
    text np_tpos = ""
    text np_tlen = ""
    // D141: the look of them all — the style (0 adaptive · 1 phosphor · 2 ink · 3 chrome · 4 paper),
    // shadows cast away from the wallpaper's light (a unit vector), the ambient rest and desk mode
    fact wg_style = 0
    fact wg_shad = false
    fact wg_lx = 0
    fact wg_ly = 1
    fact wg_ambon = true
    fact wg_amb = false
    fact wg_desk = false
    // the Info clock's weather symbol and its word (lib/deskdata.icon_kind)
    fact ck_wkind = 2
    text ck_wword = ""
    // the three visualiser lanes (D138): where each draws, what, and from which widget slot
    fact lA_on = false
    fact lA_above = false
    fact lA_dx = 0
    fact lA_dy = 0
    fact lA_k = 0
    fact lA_x = 0
    fact lA_y = 0
    fact lA_w = 10
    fact lA_h = 10
    fact lA_u = 1
    fact lA_mode = 0
    fact lA_n = 64
    fact lA_gap = 0.3
    fact lA_glow = 0.6
    fact lA_peaks = true
    fact lA_refl = false
    fact lA_plate = false
    fact lA_st = 0
    fact lA_gh = false
    fact lA_opa = 1
    fact lA_sel = false
    fact lA_ad = false
    fact lA_beh = false
    fact lA_ar = 0.6
    fact lA_ag = 0.8
    fact lA_ab = 0.7
    fact lA_ang = 0        // its turn about its centre (lib/widgets options.angle, degrees)
    fact lA_lean = 0       // its lean inside its box (lib/widgets options.lean, degrees)
    fact lB_on = false
    fact lB_above = false
    fact lB_dx = 0
    fact lB_dy = 0
    fact lB_k = 0
    fact lB_x = 0
    fact lB_y = 0
    fact lB_w = 10
    fact lB_h = 10
    fact lB_u = 1
    fact lB_mode = 0
    fact lB_n = 64
    fact lB_gap = 0.3
    fact lB_glow = 0.6
    fact lB_peaks = true
    fact lB_refl = false
    fact lB_plate = false
    fact lB_st = 0
    fact lB_gh = false
    fact lB_opa = 1
    fact lB_sel = false
    fact lB_ad = false
    fact lB_beh = false
    fact lB_ar = 0.6
    fact lB_ag = 0.8
    fact lB_ab = 0.7
    fact lB_ang = 0
    fact lB_lean = 0       // its lean inside its box (lib/widgets options.lean, degrees)
    fact lC_on = false
    fact lC_above = false
    fact lC_dx = 0
    fact lC_dy = 0
    fact lC_k = 0
    fact lC_x = 0
    fact lC_y = 0
    fact lC_w = 10
    fact lC_h = 10
    fact lC_u = 1
    fact lC_mode = 0
    fact lC_n = 64
    fact lC_gap = 0.3
    fact lC_glow = 0.6
    fact lC_peaks = true
    fact lC_refl = false
    fact lC_plate = false
    fact lC_st = 0
    fact lC_gh = false
    fact lC_opa = 1
    fact lC_sel = false
    fact lC_ad = false
    fact lC_beh = false
    fact lC_ar = 0.6
    fact lC_ag = 0.8
    fact lC_ab = 0.7
    fact lC_ang = 0
    fact lC_lean = 0       // its lean inside its box (lib/widgets options.lean, degrees)
    // the visualisers' own bars (D138): one record per bar, for up to three visualisers
    model vzA max 128 { v: number; pk: number }
    model vzB max 128 { v: number; pk: number }
    model vzC max 128 { v: number; pk: number }
    fact viz_wide = false        // the 64-band feed is coming (else 32 resampled)
    // 32 bands for the shapes drawn as paths, and the scope's last three frames of 24
    fact vs0 = 0.03
    fact vs1 = 0.03
    fact vs2 = 0.03
    fact vs3 = 0.03
    fact vs4 = 0.03
    fact vs5 = 0.03
    fact vs6 = 0.03
    fact vs7 = 0.03
    fact vs8 = 0.03
    fact vs9 = 0.03
    fact vs10 = 0.03
    fact vs11 = 0.03
    fact vs12 = 0.03
    fact vs13 = 0.03
    fact vs14 = 0.03
    fact vs15 = 0.03
    fact vs16 = 0.03
    fact vs17 = 0.03
    fact vs18 = 0.03
    fact vs19 = 0.03
    fact vs20 = 0.03
    fact vs21 = 0.03
    fact vs22 = 0.03
    fact vs23 = 0.03
    fact vs24 = 0.03
    fact vs25 = 0.03
    fact vs26 = 0.03
    fact vs27 = 0.03
    fact vs28 = 0.03
    fact vs29 = 0.03
    fact vs30 = 0.03
    fact vs31 = 0.03
    fact so0_0 = 0.03
    fact so0_1 = 0.03
    fact so0_2 = 0.03
    fact so0_3 = 0.03
    fact so0_4 = 0.03
    fact so0_5 = 0.03
    fact so0_6 = 0.03
    fact so0_7 = 0.03
    fact so0_8 = 0.03
    fact so0_9 = 0.03
    fact so0_10 = 0.03
    fact so0_11 = 0.03
    fact so0_12 = 0.03
    fact so0_13 = 0.03
    fact so0_14 = 0.03
    fact so0_15 = 0.03
    fact so0_16 = 0.03
    fact so0_17 = 0.03
    fact so0_18 = 0.03
    fact so0_19 = 0.03
    fact so0_20 = 0.03
    fact so0_21 = 0.03
    fact so0_22 = 0.03
    fact so0_23 = 0.03
    fact so1_0 = 0.03
    fact so1_1 = 0.03
    fact so1_2 = 0.03
    fact so1_3 = 0.03
    fact so1_4 = 0.03
    fact so1_5 = 0.03
    fact so1_6 = 0.03
    fact so1_7 = 0.03
    fact so1_8 = 0.03
    fact so1_9 = 0.03
    fact so1_10 = 0.03
    fact so1_11 = 0.03
    fact so1_12 = 0.03
    fact so1_13 = 0.03
    fact so1_14 = 0.03
    fact so1_15 = 0.03
    fact so1_16 = 0.03
    fact so1_17 = 0.03
    fact so1_18 = 0.03
    fact so1_19 = 0.03
    fact so1_20 = 0.03
    fact so1_21 = 0.03
    fact so1_22 = 0.03
    fact so1_23 = 0.03
    fact so2_0 = 0.03
    fact so2_1 = 0.03
    fact so2_2 = 0.03
    fact so2_3 = 0.03
    fact so2_4 = 0.03
    fact so2_5 = 0.03
    fact so2_6 = 0.03
    fact so2_7 = 0.03
    fact so2_8 = 0.03
    fact so2_9 = 0.03
    fact so2_10 = 0.03
    fact so2_11 = 0.03
    fact so2_12 = 0.03
    fact so2_13 = 0.03
    fact so2_14 = 0.03
    fact so2_15 = 0.03
    fact so2_16 = 0.03
    fact so2_17 = 0.03
    fact so2_18 = 0.03
    fact so2_19 = 0.03
    fact so2_20 = 0.03
    fact so2_21 = 0.03
    fact so2_22 = 0.03
    fact so2_23 = 0.03
    fact rp_r0 = 0
    fact rp_a0 = 0
    fact rp_r1 = 0
    fact rp_a1 = 0
    fact rp_r2 = 0
    fact rp_a2 = 0
    fact rp_r3 = 0
    fact rp_a3 = 0

    // the record turns at 33⅓ (200° a second) and coasts to a stop; the arm follows the song
    spring wg.coast = 60, 14
    spring wg.arm = 120, 18
    spring wg.line = 260, 30
    prop np_spd = 0 ~wg.coast
    follow np_spd = if(np_playing and not viz_still and np_rec, 200, 0)
    prop np_vang = 0
    spin np_vang by np_spd
    prop np_arm = 0 ~wg.arm
    follow np_arm = np_arm_at
    prop np_prg = 0 ~500ms
    follow np_prg = np_progress
    // what moves the drifting modes while something plays
    prop np_tspd = 0 ~wg.coast
    follow np_tspd = if(np_playing and not viz_still and (not viz_ext or editing or wg_dkp > 0.01), 40 * mood_pace, 0)
    prop np_turn = 0
    spin np_turn by np_tspd
    // a beat's push, gone again in a moment (the dust scatters on it)
    prop np_scatter = 0 ~180ms
    follow np_scatter = np_beat
    // a new lyric line fades in
    prop np_lf = 1 ~wg.line
    follow np_lf = np_line_in

    // each slot's hands (lingering, set by the logic) and its opacity (the idle rule), gliding
    spring wg.hand = 320, 30
    spring wg.fade = 140, 22
    fact hl0 = 0
    prop ph0 = 0 ~wg.hand
    follow ph0 = hl0
    fact op0 = 1
    prop po0 = 1 ~wg.fade
    follow po0 = op0
    fact hl1 = 0
    prop ph1 = 0 ~wg.hand
    follow ph1 = hl1
    fact op1 = 1
    prop po1 = 1 ~wg.fade
    follow po1 = op1
    fact hl2 = 0
    prop ph2 = 0 ~wg.hand
    follow ph2 = hl2
    fact op2 = 1
    prop po2 = 1 ~wg.fade
    follow po2 = op2
