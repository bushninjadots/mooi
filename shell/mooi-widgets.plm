            pivot: if(wg_rk == lA_k, wg_sx + wg_sw / 2, lA_x + lA_w / 2), if(wg_rk == lA_k, wg_sy + wg_sh / 2, lA_y + lA_h / 2)
            rotate: lA_ang * 1deg
            box { from: if(wg_rk == lA_k, wg_sx, lA_x), if(wg_rk == lA_k, wg_sy, lA_y); size: if(wg_rk == lA_k, wg_sw, lA_w), if(wg_rk == lA_k, wg_sh, lA_h); corner: 6 * lA_u; color: fl.hull; opacity: 0.7; show: lA_plate }
            vw.LaneA(if(wg_rk == lA_k, wg_sx, lA_x), if(wg_rk == lA_k, wg_sy, lA_y), if(wg_rk == lA_k, wg_sw, lA_w), if(wg_rk == lA_k, wg_sh, lA_h), if(wg_rk == lA_k, wg_ru, lA_u), lA_mode, lA_n, lA_gap, lA_glow * mood_glow, lA_peaks, lA_refl, if(lA_ad, rgb(lA_ar, lA_ag, lA_ab), fl.phos), if(lA_ad, mix(rgb(lA_ar, lA_ag, lA_ab), #ffffff, 0.35), fl.ember), fl.trace_dim, viz_still, lA_lean)
        }
        group {
            z: if(lB_beh, 1, 3)
            show: (not sf_on or lB_above or editing or wg_desk or op_vis) and lB_on and (editing or wg_dkp > 0.01 or (lB_st < 1.5 and not viz_ext))
            opacity: if(editing, if(lB_gh, 0.4, 1), if(viz_still, if(lB_st < 0.5, 1, 0.35), pick(lB_k, po0, po1, po2, po3, po4, po5, po6, po7, po8, po9, po10, po11, po12, po13, po14, po15))) * lB_opa
