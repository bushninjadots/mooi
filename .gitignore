# A public repo should not ship live user state, but it must not hide new work either.
# These are explicit rules: a new test, doc, scene or theme package is visible to git unless a
# rule below names it. (The old `**` rule made every new file invisible; audit G2.)

# runtime and machine state, wherever it lands
settings.json
notes.json
board.json
stash.json
wall.json
wallpapers.json
workspaces.json
signals.json
environments.json
player-eq.json
player-eq-ee.json
nexus-anchor.json
player-anchor.json
notch-state.json
bmo-state.json
nexus-weather.json
ipinfo.json
*.log
*.tsv
*.cache

# the shareable setup baseline is tracked...
!setup/home/**
# ...except personal identity pictures (audit G1) and caches/state under the baseline
setup/home/**/identity/
setup/home/**/.cache/

# caches and tool state
__pycache__/
.claude/
.claude-flow/
.open-design/
.swarm/
.superpowers/
.devin/
.show-your-work/
.freebuff/
pleamar helix bar/
ruvector.db
agentdb.rvf
agentdb.rvf.idmap.json
*.db
