# A public repo should not ship live user state.
# These rules apply to the repo snapshot itself; cargo-culting local runtime state
# into the repository is explicitly avoided.
!important
!
**

# keep setup files tracked if they are shareable config
!setup/home/**

# runtime and machine state live outside the repo and should not be committed
settings.json
notes.json
board.json
stash.json
wall.json
wallpapers.json
workspaces.json
signals.json
environments.json
player-eq.json
player-eq-ee.json
nexus-anchor.json
player-anchor.json
notch-state.json
bmo-state.json
identity/
*.jpg
*.png
*.log
*.tsv
*.cache

# caches and tool state
__pycache__/
.claude/
.claude-flow/
.open-design/
.swarm/
.superpowers/
ruvector.db
agentdb.rvf
agentdb.rvf.idmap.json
