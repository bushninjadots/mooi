# mooi's own Matugen run — generated by `bin/mooi theme-sync` into the mooi data folder,
# with @TPL@ and @OUT@ replaced by absolute paths. It is deliberately a separate config
# from the user's (~/.config/matugen/config.toml): Matugen is the one palette generator
# (docs/BRIEF.md §7, "do not run Matugen and Wallust as competing palette generators"),
# the user's config keeps recolouring the rest of the desktop, and this one writes the
# single file mooi reads. Nothing here touches any other program's colours.
#
# The output is declarative JSON of the Material roles the theme model maps:
# shell/lib/theme.luau (M.FROM_MATUGEN) → the scene's semantic tokens. The template holds
# no comments of its own, because Matugen copies everything that is not a handlebars tag
# straight through, and JSON with comments in it would not parse.
[config]

[templates.mooi]
input_path = "@TPL@"
output_path = "@OUT@"
