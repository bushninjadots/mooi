#!/bin/sh
# mooi — launcher and shell switch. Beside ArchEclipse, or — with Settings → Advanced → "mooi is the
# whole desktop" (session.standalone) — the shell you log into, ArchEclipse left installed but never
# started (D48; ~/.config/hypr/config/custom/mooi.lua starts `mooi session` at login).
#
#   mooi session           mooi is the whole desktop: like a takeover, but nothing brings ArchEclipse
#                          back when it ends (what the login starts when standalone is on)
#   mooi toggle            the command membrane; starts mooi beside ArchEclipse first if needed
#                          (Super+Alt+Space)
#   mooi start             start mooi beside ArchEclipse (detached, restarted if it crashes)
#   mooi takeover          mooi becomes the shell: ArchEclipse's bar is stopped until mooi ends
#   mooi stop              stop mooi; after a takeover, ArchEclipse comes back (Super+Alt+Shift+Space)
#   mooi status            what is running
#   mooi run [--safe] …    foreground, for development (pleamar options after it): runs the repo
#                          itself, so saving a file reloads it
#   mooi refresh           copy the repo's shell into the running snapshot and restart the scene
#                          (the keeper, the mode and ArchEclipse's state are kept)
#   mooi restart-hypr      Hyprland reads its config again, then the bar restarts on it (Settings →
#                          Advanced and the Nexus's rail); windows stay open, mooi's own close
#   mooi window | system   toggle the window island (Super+Alt+W) or the system island
#   mooi mode [light|dark|auto]  day or night for the whole desktop; no word turns to the other one (Super+Alt+T)
#   mooi overview          every workspace zoomed out (Super+Tab)
#   mooi shutter | shutter-here   the Mechanical Shutter on the focused window (Super+Alt+D), or the
#                          one under the pointer (Super+Alt+right-click)
#   mooi wallpaper         the wallpaper picker: Skwd Wall (skwd-wall-v2), the one picker (D118)
#   mooi settings | edit   open or close the settings window; the bar's edit mode on or off
#   mooi notes | clipboard the side panel's notices or clipboard history (open or close)
#   mooi note "text"       save a line in the quick notes (no window; notes.json)
#   mooi board            the Kanban board (open or close; the quick notes pad's rail opens it too)
#   mooi player           the music player: mpd's library, lyrics, a turntable (open or close; a press on the media module)
#   mooi nexus            Control Nexus (open or close; the bar's Arch mark opens it too)
#   mooi notch [panel]    the side notch on a panel: claude (default), music, spaces, walls, weather, github
#   mooi identity …        manage local Nexus name, avatar and banner assets
#   mooi record [area]     start or stop recording the screen (or an area) with the bar's recorder
#   mooi open              same as `window` (kept for old scripts)
#   mooi say CMD…          pass a command to the running scene (pleamar --say)
#   mooi theme-sync [--light] [image]
#                          recolour from the wallpaper with Matugen (theme/matugen.toml.in,
#                          theme/palette.json.hbs), using mooi's own config so nothing of
#                          the user's theming is written; then asks a running mooi to read it
#   mooi theme-watch       follow the wallpaper: recolour with Matugen whenever it changes.
#                          `start` and `takeover` run this beside the bar, `stop` ends it
#   mooi apps-sync         put mooi's palette on Kitty, GTK and Qt as the settings say (the watch
#                          does it by itself; switched off, an app gets its own colours back)
#   mooi check             compile the scene and run the unit tests
#
# --safe / MOOI_SAFE=1 ignores settings.json. MOOI_PLEAMAR picks another pleamar binary.
#
# The takeover marker is $XDG_RUNTIME_DIR/mooi/takeover (tmpfs, gone at logout) and
# holds the keeper's pid. ArchEclipse's bar.sh ends a takeover whenever it starts the
# bar (SUPER+SHIFT+B is always a way back), and its fullscreen sync leaves the bar
# down while a live takeover holds the desktop. A dead keeper's marker is ignored.
set -u
root=$(cd "$(dirname "$0")/.." && pwd)
self="$root/bin/mooi"
# The scene's own commands are written as `mooi …` (the identity image import and the
# diagnostics copy). Pleamar runs them by name, not by path, so the launcher's own bin is on
# PATH for the keeper and for everything the scene starts.
case ":$PATH:" in
    *":$root/bin:"*) ;;
    *) PATH="$root/bin:$PATH"; export PATH ;;
esac
src="$root/shell/mooi.plm"                      # the repo's scene: development, `check`, the tests
live="${XDG_STATE_HOME:-$HOME/.local/state}/mooi/live"
scene="$live/mooi.plm"                          # what the keeper runs: a snapshot (see `snapshot`)
name=mooi
pleamar=${MOOI_PLEAMAR:-pleamar}
rt="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/mooi"
marker="$rt/takeover"
keep_pid="$rt/keep.pid"
state="${XDG_STATE_HOME:-$HOME/.local/state}/mooi"
log="$state/mooi.log"
settings="${XDG_DATA_HOME:-$HOME/.local/share}/pleamar/$name/settings.json"
bar_sh="$HOME/.config/hypr/scripts/bar.sh"
engine_sh="$HOME/.config/hypr/scripts/shell-engine.sh"
mkdir -p "$rt" "$state"

reduced_flag() {
    [ "${MOOI_SAFE:-0}" = 1 ] && return 0
    [ -r "$settings" ] && command -v jq >/dev/null 2>&1 || return 0
    [ "$(jq -r '.motion.reduced // false' "$settings" 2>/dev/null)" = true ] && echo --reduced-motion
    return 0
}
running() { "$pleamar" --say "$name" "get phase" >/dev/null 2>&1; }
alive() { [ -n "${1:-}" ] && kill -0 "$1" 2>/dev/null; }
takeover_active() { [ -f "$marker" ] && alive "$(cat "$marker" 2>/dev/null)"; }
archeclipse_running() {
    pgrep -af -- "$HOME/.config/quickshell/archeclipse" 2>/dev/null | grep -v -F 'ipc call' | grep -q .
}
# ArchEclipse may be uninstalled (D48): then there is nothing to hand the desktop back to.
archeclipse_installed() { [ -x "$bar_sh" ] && [ -d "$HOME/.config/quickshell/archeclipse" ]; }
wait_for() { # seconds, command…
    n=$(($1 * 10)); shift
    while [ "$n" -gt 0 ]; do "$@" && return 0; sleep 0.1; n=$((n - 1)); done; return 1
}
wallpaper="${HOME}/.cache/current_wallpaper"   # the image every wallpaper setter in this setup updates
folder=$(dirname "$settings")                   # where the palette and the settings live
palette="$folder/palette.json"
from="$folder/palette.from"                     # which wallpaper, and extracted how, the palette came from
# How the palette is extracted (settings.json): the scheme, the source colour and the contrast.
# Day or night, now (D91): theme.mode, and for `auto` the hours it turns light and dark. The one
# place this is decided — Matugen runs in it, it is stamped into the palette the bar reads, and the
# bar hands it to the apps — so nothing can disagree about what time of day it is.
mode_now() {
    mm=dark; lf=7; lt=19
    if [ -f "$settings" ] && command -v jq >/dev/null 2>&1; then
        mm=$(jq -r '.theme.mode // "dark"' "$settings" 2>/dev/null || echo dark)
        lf=$(jq -r '.theme.light_at // 7' "$settings" 2>/dev/null || echo 7)
        lt=$(jq -r '.theme.dark_at // 19' "$settings" 2>/dev/null || echo 19)
    fi
    case "$mm" in
        light) echo light ;;
        auto)
            hh=$((10#$(date +%H)))
            if [ "$lf" -le "$lt" ]; then
                if [ "$hh" -ge "$lf" ] && [ "$hh" -lt "$lt" ]; then echo light; else echo dark; fi
            else   # a day that runs past midnight (light at 20, dark at 6)
                if [ "$hh" -ge "$lf" ] || [ "$hh" -lt "$lt" ]; then echo light; else echo dark; fi
            fi ;;
        *) echo dark ;;
    esac
}
extraction() { echo "$(jq -c '[.theme.scheme, .theme.color_index, .theme.contrast]' "$settings" 2>/dev/null) $(mode_now)"; }
theme_lock="$rt/theme.lock"
theme_pid="$rt/theme.pid"
theme_watch_lock="$rt/theme-watch.lock"

# Matugen is the palette generator (the brief: not Matugen *and* Wallust), and it runs with
# mooi's own config: one output file, no other program's colours touched. Everything that
# recolours mooi comes through here — `mooi theme-sync`, from the wallpaper or from an image
# given by hand, and `mooi theme-watch`, when the wallpaper changes on its own.
#
# The lock is what keeps two syncs apart: Matugen writes the palette in place, and a second
# run reading the wallpaper while the first is still writing would hand mooi half a palette
# (which is refused whole, so the bar would keep the old colours and look stuck).
theme_sync() { # [--light | --dark] [image] — quiet: says what it did on stdout, nothing on failure
    mode=$(mode_now)
    case "${1:-}" in --light) mode=light; shift ;; --dark) mode=dark; shift ;; esac
    image=${1:-$wallpaper}
    # Read the actual image path once, before any filesystem changes
    real_image=$(readlink -f "$image" 2>/dev/null || echo "$image")
    [ -e "$real_image" ] || { echo "no image at $image (pass one, or set a wallpaper first)" >&2; return 1; }
    command -v matugen >/dev/null 2>&1 || { echo "matugen is not installed" >&2; return 1; }
    if command -v flock >/dev/null 2>&1; then
        exec 9>"$theme_lock"
        flock -w 20 9 || { echo "another sync is still running" >&2; return 1; }
    fi
    # The lock belongs to the sync, not to the process. Without this the theme watch — which
    # calls this inside its own long loop — held it for the rest of the session, so a manual
    # `mooi theme-sync` waited 20 s and failed with "another sync is still running" while
    # nothing was syncing (audit 2026-10-31, F4).
    theme_unlock() { if command -v flock >/dev/null 2>&1; then flock -u 9 2>/dev/null; exec 9>&-; fi; }
    mkdir -p "$folder"
    cfg="$folder/matugen.toml"
    sed -e "s|@TPL@|$root/theme/palette.json.hbs|" -e "s|@OUT@|$folder/palette.json|" \
        "$root/theme/matugen.toml.in" > "$cfg" || { theme_unlock; return 1; }
    # `--source-color-index 0` is what the user's own matugen-theme.sh passes, so mooi and the
    # rest of the desktop take their colours from the same source colour of the same wallpaper;
    # without it matugen 4.2 stops and asks.
    # How the palette is extracted is the user's (settings.json, the bar's menu): the scheme
    # type, which of the wallpaper's five dominant colours it is built from, and the contrast.
    # Read here so a wallpaper change and a change made from the bar extract the same way.
    scheme=tonal-spot; index=0; contrast=0
    if [ -f "$settings" ] && command -v jq >/dev/null 2>&1; then
        scheme=$(jq -r '.theme.scheme // "tonal-spot"' "$settings" 2>/dev/null || echo tonal-spot)
        index=$(jq -r '.theme.color_index // 0' "$settings" 2>/dev/null || echo 0)
        contrast=$(jq -r '.theme.contrast // 0' "$settings" 2>/dev/null || echo 0)
    fi
    matugen image "$real_image" -c "$cfg" -m "$mode" --type "scheme-$scheme" \
        --source-color-index "$index" --contrast "$contrast" >/dev/null \
        || { echo "matugen failed" >&2; theme_unlock; return 1; }
    # The mode rides in the palette itself, so the bar builds the matching set from the same write.
    if command -v jq >/dev/null 2>&1 && [ -f "$palette" ]; then
        jq --arg m "$mode" '. + {mode: $m}' "$palette" > "$palette.mooi-tmp" && mv "$palette.mooi-tmp" "$palette"
    fi
    # Your own Matugen templates (apps.others): the same image, scheme and mode, so btop, fish,
    # cava, Vesktop, Zen, Spicetify and the widgets turn with the day too. Your config's hooks run
    # as they always do; a failure there is reported, never mooi's.
    user_cfg="${XDG_CONFIG_HOME:-$HOME/.config}/matugen/config.toml"
    if [ -f "$user_cfg" ] && [ "$(jq -r '.apps.others // false' "$settings" 2>/dev/null)" = true ]; then
        matugen image "$real_image" -c "$user_cfg" -m "$mode" --type "scheme-$scheme" \
            --source-color-index "$index" --contrast "$contrast" >/dev/null 2>&1 \
            || echo "your matugen config failed (mooi's palette is fine)" >&2
    fi
    echo "$(readlink -f "$image") $(extraction)" > "$from"   # what the palette came from: the watch reads it
    echo "palette from $(basename "$real_image") ($mode, $scheme, colour $index) → $palette"
    # mooi watches the palette file itself, so this is a courtesy: it is what makes the change
    # land in the frame after the write rather than on the next wallpaper change.
    "$pleamar" --say "$name" "emit recolor" >/dev/null 2>&1 || :
    theme_unlock
    return 0
}

# Your apps in mooi's palette (settings: apps.kitty, apps.gtk, apps.qt; D34). The bar writes
# apps.json — its palette in Matugen's role names — whenever the palette or those switches change,
# and this renders it: Kitty from mooi's template (terminal hues it can tell apart), GTK from your
# own Matugen templates when they are there (mooi's otherwise), Qt from mooi's qt5ct scheme. Each
# switch turned off puts back exactly what it changed, recorded in apps.state:
#   Kitty  — the one `include colors-….conf` line in kitty.conf points at colors-mooi.conf;
#   GTK    — gtk.css is mooi's, and your Matugen config's two GTK outputs are pointed at
#            ~/.cache/mooi while it is (so the two never write the same file); going back
#            restores those lines and the gtk.css Matugen last made;
#   Qt     — qt5ct's / qt6ct's colour scheme is mooi's (a qt6ct.conf mooi had to create goes).
apps_dir="$root/theme/apps"
apps_sync() {
    j="$folder/apps.json"
    { [ -f "$j" ] && command -v jq >/dev/null 2>&1; } || return 0
    C="${XDG_CONFIG_HOME:-$HOME/.config}"
    state="$folder/apps.state"; touch "$state"
    get() { sed -n "s|^$1=||p" "$state" | head -1; }
    put() { grep -v "^$1=" "$state" > "$state.t"; [ -n "$2" ] && echo "$1=$2" >> "$state.t"; mv "$state.t" "$state"; }
    on() { [ "$(jq -r ".$1 // false" "$j")" = true ]; }
    sedf="$folder/apps.sed"
    jq -r '.colors | to_entries[] | "s|{{colors.\(.key).default.hex}}|\(.value)|g\ns|{{colors.\(.key).default.hex_stripped}}|\(.value | ltrimstr("#"))|g"' "$j" > "$sedf" || return 0
    render() { sed -f "$sedf" "$1" > "$2.mooi-tmp" && mv "$2.mooi-tmp" "$2"; }
    did=""

    k="$C/kitty/kitty.conf"
    # A hand-edited `include colors-mooi.conf   ` (or a formatter that adds a space) is still
    # mooi's include: matching the whole line used to miss it, append a second one, and leave
    # both behind when the switch went off.
    mooi_inc='^include[[:space:]]\{1,\}colors-mooi\.conf[[:space:]]*$'
    if on kitty && [ -f "$k" ]; then
        render "$apps_dir/kitty.conf" "$C/kitty/colors-mooi.conf"
        if ! grep -q "$mooi_inc" "$k"; then
            was=$(sed -n "s|^include[[:space:]]\{1,\}\(colors-[A-Za-z0-9_-]*\.conf\)[[:space:]]*\$|\1|p" "$k" | head -1)
            if [ -n "$was" ]; then
                was_re=$(printf '%s\n' "$was" | sed 's/\./\\./g')
                sed -i "s|^include[[:space:]]\{1,\}${was_re}[[:space:]]*\$|include colors-mooi.conf|" "$k"; put kitty_was "$was"
            else echo "include colors-mooi.conf" >> "$k"; put kitty_was "-"; fi
        elif [ -z "$(get kitty_was)" ]; then
            # apps.state was lost while mooi's include was already in place. Nothing records
            # what pointed there before, so the honest fallback is "mooi put it here": the
            # switch off takes the line out instead of leaving Kitty in mooi's palette.
            put kitty_was "-"
        fi
        pkill -USR1 -x kitty 2>/dev/null; did="$did kitty"
    elif [ -n "$(get kitty_was)" ] && [ -f "$k" ]; then
        was=$(get kitty_was)
        if [ "$was" = "-" ]; then sed -i "/$mooi_inc/d" "$k"; else sed -i "s|$mooi_inc|include $was|" "$k"; fi
        put kitty_was ""; pkill -USR1 -x kitty 2>/dev/null; did="$did kitty(yours)"
    fi

    mt="$C/matugen/config.toml"
    for v in 3 4; do
        out="$C/gtk-$v.0/gtk.css"; shadow="$HOME/.cache/mooi/matugen-gtk-$v.0.css"
        tpl="$C/matugen/templates/gtk$v.css"; [ -f "$tpl" ] || tpl="$apps_dir/gtk$v.css"
        if on gtk; then
            mkdir -p "$(dirname "$shadow")" "$(dirname "$out")"
            # A gtk.css mooi creates where there was none has nothing to put back, so the
            # fact is recorded: turning GTK off removes it again. Without this, a file mooi
            # made (the usual case for GTK 4, whose gtk.css most setups do not have) stayed
            # after the switch went off and GTK kept mooi's colours.
            if [ ! -f "$out" ]; then put "gtk${v}_made" yes; fi
            # The user's Matugen line, however it is written: spaces around `=`, a trailing
            # comment, `~`, `$HOME` or an absolute path. The line is kept verbatim in the state,
            # so going back restores exactly what was there rather than mooi's idea of it.
            if [ -f "$mt" ] && grep -q "^output_path[[:space:]]*=[[:space:]]*\".*/gtk-$v\.0/gtk\.css\"" "$mt"; then
                # Only the first redirect keeps a copy: once mooi owns the output, $out is
                # mooi's render, and copying it over the shadow would lose the user's own
                # last Matugen-made gtk.css (which is what going back restores).
                [ -z "$(get "gtk${v}_matugen")" ] && [ -f "$out" ] && cp "$out" "$shadow"
                [ -n "$(get "gtk${v}_mt_line")" ] || put "gtk${v}_mt_line" "$(sed -n "/^output_path[[:space:]]*=[[:space:]]*\".*\/gtk-$v\.0\/gtk\.css\"/p" "$mt" | head -1)"
                sed -i "s|^output_path[[:space:]]*=[[:space:]]*\".*/gtk-$v\.0/gtk\.css\".*|output_path = \"~/.cache/mooi/matugen-gtk-$v.0.css\"  # mooi: GTK follows mooi while it is on (was ~/.config/gtk-$v.0/gtk.css)|" "$mt"
                put "gtk${v}_matugen" yes
            elif [ -z "$(get "gtk${v}_matugen")$(get "gtk${v}_backup")$(get "gtk${v}_made")" ] && [ -f "$out" ]; then
                cp "$out" "$folder/apps-gtk-$v.0.backup.css"; put "gtk${v}_backup" yes
            fi
            render "$tpl" "$out"; did="$did gtk$v"
        elif [ -n "$(get "gtk${v}_matugen")$(get "gtk${v}_backup")$(get "gtk${v}_made")" ]; then
            if [ "$(get "gtk${v}_matugen")" = yes ]; then
                orig=$(get "gtk${v}_mt_line")
                if [ -n "$orig" ]; then
                    orig_re=$(printf '%s\n' "$orig" | sed 's/[\\&|]/\\&/g')
                    sed -i "s|^output_path[[:space:]]*=[[:space:]]*\".*/matugen-gtk-$v\.0\.css\".*|$orig_re|" "$mt"
                else
                    sed -i "s|^output_path = \"~/.cache/mooi/matugen-gtk-$v.0.css\".*|output_path = \"~/.config/gtk-$v.0/gtk.css\"|" "$mt"
                fi
                if [ -f "$shadow" ]; then cp "$shadow" "$out"; else rm -f "$out"; fi
            elif [ -n "$(get "gtk${v}_backup")" ]; then
                cp "$folder/apps-gtk-$v.0.backup.css" "$out"
            else rm -f "$out"; fi
            put "gtk${v}_matugen" ""; put "gtk${v}_backup" ""; put "gtk${v}_made" ""; put "gtk${v}_mt_line" ""
            did="$did gtk$v(yours)"
        fi
    done

    for q in qt5ct qt6ct; do
        qc="$C/$q/$q.conf"; mine="$C/$q/colors/mooi.conf"
        if on qt; then
            if [ ! -f "$qc" ]; then
                [ "$q" = qt6ct ] || continue
                mkdir -p "$C/$q"; printf '[Appearance]\ncustom_palette=true\ncolor_scheme_path=\nstyle=Fusion\n' > "$qc"; put qt6ct_made yes
            fi
            mkdir -p "$C/$q/colors"; render "$apps_dir/qt5ct.conf" "$mine"
            cur=$(sed -n 's/^color_scheme_path=//p' "$qc" | head -1)
            if [ "$cur" != "$mine" ]; then
                [ -n "$(get "${q}_was")" ] || put "${q}_was" "${cur:--}"
                if grep -q '^color_scheme_path=' "$qc"; then sed -i "s|^color_scheme_path=.*|color_scheme_path=$mine|" "$qc"
                else sed -i "/^\[Appearance\]/a color_scheme_path=$mine" "$qc"; fi
            fi
            # A scheme is only used when custom_palette is on, and a qt5ct.conf may not carry
            # the key at all: add it, and remember that it was absent ("-") so the switch off
            # removes it again instead of leaving a setting mooi made behind.
            if ! grep -q '^custom_palette=true' "$qc"; then
                had=$(sed -n 's/^custom_palette=//p' "$qc" | head -1)
                [ -n "$(get "${q}_palette")" ] || put "${q}_palette" "${had:--}"
                if grep -q '^custom_palette=' "$qc"; then sed -i 's/^custom_palette=.*/custom_palette=true/' "$qc"
                else sed -i '/^\[Appearance\]/a custom_palette=true' "$qc"; fi
            fi
            did="$did $q"
        elif [ -n "$(get "${q}_was")$(get "${q}_palette")" ]; then
            if [ "$q" = qt6ct ] && [ "$(get qt6ct_made)" = yes ]; then
                rm -f "$qc" "$mine"; rmdir "$C/$q/colors" "$C/$q" 2>/dev/null; put qt6ct_made ""
            elif [ -f "$qc" ]; then
                was=$(get "${q}_was")
                if [ -n "$was" ]; then [ "$was" = "-" ] && was=""; sed -i "s|^color_scheme_path=.*|color_scheme_path=$was|" "$qc"; fi
                pal=$(get "${q}_palette")
                if [ "$pal" = "-" ]; then sed -i '/^custom_palette=/d' "$qc"
                elif [ -n "$pal" ]; then sed -i "s/^custom_palette=.*/custom_palette=$pal/" "$qc"; fi
            fi
            put "${q}_was" ""; put "${q}_palette" ""; did="$did $q(yours)"
        fi
    done
    # Day and night for the toolkits themselves (D91): the theme and icons that take mooi's colours
    # in the mode the bar is in (apps.json `mode`) — adw-gtk3 is the GTK 3 theme that reads the
    # palette above (WhiteSur and stock Adwaita hardcode their own), Papirus for GTK, Qt and KDE
    # alike, and the desktop's light/dark preference, which GTK 4, libadwaita and browsers follow
    # through the portal. What was there before is kept once in apps.state and put back on off.
    mode=$(jq -r '.mode // "dark"' "$j")
    if [ "$mode" = light ]; then gt=adw-gtk3; ic=Papirus-Light; cs=prefer-light; pd=0
    else gt=adw-gtk3-dark; ic=Papirus-Dark; cs=prefer-dark; pd=1; fi
    gs() { command -v gsettings >/dev/null 2>&1 && gsettings "$@" 2>/dev/null; }
    ini() { # file key value — set it in [Settings], adding the key if it is missing
        [ -f "$1" ] || return 0
        if grep -q "^$2=" "$1"; then sed -i "s|^$2=.*|$2=$3|" "$1"; else sed -i "/^\[Settings\]/a $2=$3" "$1"; fi
    }
    if on gtk; then
        [ -n "$(get gtk_look_was)" ] || put gtk_look_was "$(gs get org.gnome.desktop.interface gtk-theme | tr -d "'")|$(gs get org.gnome.desktop.interface icon-theme | tr -d "'")|$(gs get org.gnome.desktop.interface color-scheme | tr -d "'")"
        if [ "$(gs get org.gnome.desktop.interface gtk-theme | tr -d "'")" != "$gt" ] || [ "$(gs get org.gnome.desktop.interface color-scheme | tr -d "'")" != "$cs" ] \
           || [ "$(gs get org.gnome.desktop.interface icon-theme | tr -d "'")" != "$ic" ]; then
            gs set org.gnome.desktop.interface gtk-theme "$gt"
            gs set org.gnome.desktop.interface icon-theme "$ic"
            gs set org.gnome.desktop.interface color-scheme "$cs"
            did="$did gtk-$mode"
        fi
        for v in 3 4; do
            ini "$C/gtk-$v.0/settings.ini" gtk-theme-name "$gt"
            ini "$C/gtk-$v.0/settings.ini" gtk-icon-theme-name "$ic"
            ini "$C/gtk-$v.0/settings.ini" gtk-application-prefer-dark-theme "$pd"
        done
    elif [ -n "$(get gtk_look_was)" ]; then
        IFS='|' read -r wt wi wc <<EOF2
$(get gtk_look_was)
EOF2
        [ -n "$wt" ] && gs set org.gnome.desktop.interface gtk-theme "$wt"
        [ -n "$wi" ] && gs set org.gnome.desktop.interface icon-theme "$wi"
        [ -n "$wc" ] && gs set org.gnome.desktop.interface color-scheme "$wc"
        put gtk_look_was ""; did="$did gtk-look(yours)"
    fi
    kg="$C/kdeglobals"; kscheme="${XDG_DATA_HOME:-$HOME/.local/share}/color-schemes/Mooi.colors"
    if on qt; then
        for q in qt5ct qt6ct; do
            qc="$C/$q/$q.conf"; [ -f "$qc" ] || continue
            if grep -q '^icon_theme=' "$qc"; then sed -i "s|^icon_theme=.*|icon_theme=$ic|" "$qc"
            else sed -i "/^\[Appearance\]/a icon_theme=$ic" "$qc"; fi
        done
        # KDE apps (Dolphin, Kate, Okular…) read their colours from kdeglobals, not from qt6ct:
        # the scheme is rendered, and its colour groups are copied in; every other setting stays.
        mkdir -p "$(dirname "$kscheme")"; render "$apps_dir/kde.colors" "$kscheme"
        if [ -f "$kg" ] && [ -z "$(get kde_backup)" ]; then cp "$kg" "$folder/apps-kdeglobals.backup"; put kde_backup yes; fi
        [ -f "$kg" ] || { : > "$kg"; [ -n "$(get kde_backup)" ] || put kde_backup made; }
        python3 - "$kscheme" "$kg" "$ic" <<'PY' && did="$did kde"
import configparser, sys
src, dst, icons = sys.argv[1:4]
def load(p):
    cp = configparser.RawConfigParser(strict=False, interpolation=None)
    cp.optionxform = str
    cp.read(p)
    return cp
s, d = load(src), load(dst)
for sec in s.sections():
    if sec.startswith("Colors:") or sec == "WM":
        if not d.has_section(sec): d.add_section(sec)
        for k, v in s.items(sec): d.set(sec, k, v)
for sec, k, v in (("General", "ColorScheme", "Mooi"), ("Icons", "Theme", icons)):
    if not d.has_section(sec): d.add_section(sec)
    d.set(sec, k, v)
with open(dst, "w") as f: d.write(f, space_around_delimiters=False)
PY
        # A KDE app can keep a colour scheme of its own (Settings → Colour scheme, [UiSettings] in its
        # rc), which wins over kdeglobals — Dolphin was still on ArchEclipse's dark one. Each is
        # cleared so the app follows the desktop, and what it was is kept to put back.
        command -v kreadconfig6 >/dev/null 2>&1 && for rc in "$C"/*rc; do
            [ -f "$rc" ] || continue
            cur=$(kreadconfig6 --file "$rc" --group UiSettings --key ColorScheme 2>/dev/null)
            [ -n "$cur" ] || continue
            put kde_app_was "$(get kde_app_was)$(basename "$rc")=$cur;"
            kwriteconfig6 --file "$rc" --group UiSettings --key ColorScheme "" && did="$did $(basename "$rc")"
        done
    elif [ -n "$(get kde_backup)" ]; then
        printf '%s' "$(get kde_app_was)" | tr ';' '\n' | while IFS='=' read -r rcf val; do
            [ -n "$rcf" ] && kwriteconfig6 --file "$C/$rcf" --group UiSettings --key ColorScheme "$val"
        done
        put kde_app_was ""
        if [ "$(get kde_backup)" = made ]; then rm -f "$kg"; else cp "$folder/apps-kdeglobals.backup" "$kg"; fi
        rm -f "$kscheme"; put kde_backup ""; did="$did kde(yours)"
    fi
    [ -n "$did" ] && echo "apps:$did"
    return 0
}

# Follow the wallpaper. `mooi start` and `mooi takeover` run this beside the bar and `mooi
# stop` ends it; on its own it is a foreground loop, so a session can also run it from a
# service of its own. Two waits: inotify where it exists (the symlink is replaced, so the
# event is moved_to or create), and the link's own target where it does not.
theme_watch() {
    exec 8>"$theme_watch_lock"
    flock -n 8 2>/dev/null || { echo "mooi-theme-watch: already running" >&2; exit 1; }
    echo $$ > "$theme_pid"
    # The lock file is never removed: removed-and-recreated, two watchers would hold two
    # different files and neither would know about the other.
    trap 'rm -f "$theme_pid"; exit 0' TERM INT HUP
    dir=$(dirname "$wallpaper")
    was=$(readlink -f "$wallpaper" 2>/dev/null)
    # The wallpaper may have changed while mooi was down, which is the one case a watcher
    # cannot see: the palette records the image it came from, so a different one now means the
    # colours on screen are the last wallpaper's and are recoloured before anything is watched.
    if [ ! -e "$palette" ] || [ "$(cat "$from" 2>/dev/null)" != "$was $(extraction)" ]; then
        # Pass the current wallpaper path so theme_sync reads the symlink at call time
        said=$(theme_sync "$wallpaper" 2>&1) || :
        [ -n "$said" ] && echo "$(date +%T) $said (the wallpaper changed while mooi was down)"
    fi
    resync() {   # one recolour, and one line about it: the watch log is what a session reads
        said=$(theme_sync "$wallpaper" 2>&1) || :
        [ -n "$said" ] && echo "$(date +%T) $said"
        return 0
    }
    # Every wake-up — an event in the folder, or five seconds of quiet — asks the one question
    # that matters: is the wallpaper (its target and its modification time) still the one the
    # palette came from? Matching file names in the event stream missed changes: ~/.cache is
    # busy, and a change landing while the loop slept after somebody else's event was lost
    # (found 2026-10-19). `-t 5` and no `-m`: a monitor that never returns would block the
    # trap, which is how a `mooi stop` once left a watcher behind (2026-10-16).
    # How the palette is extracted is part of the question: changed from the settings window,
    # it is re-extracted here too, so this watch is the one writer of the palette while mooi
    # runs under the keeper (shell/mooi.luau leaves `extract` to it).
    key() { t=$(readlink -f "$wallpaper" 2>/dev/null) && echo "$t $(stat -L -c %Y "$wallpaper" 2>/dev/null) $(extraction)"; }
    seen=$(key)
    apps_key() { cksum "$folder/apps.json" 2>/dev/null; }
    apps_seen=""
    motion_key() { jq -c '[.motion.speed, .motion.reduced]' "$settings" 2>/dev/null; }
    motion_seen=$(motion_key)
    while :; do
        if command -v inotifywait >/dev/null 2>&1; then
            # `8>&-`: the lock is the watcher's, not its child's — an inotifywait left over from
            # a killed watcher would otherwise hold it for up to 5 s and turn the next one away.
            # The visualizer feed (shell/lib/vizfeed.luau) is rewritten 30 times a second while
            # music plays, in this same folder: left in, it woke this loop 30×/s and its checks
            # cost ~60% of a core (measured 2026-11-02). Nothing here reads it.
            inotifywait -q -t 5 --exclude 'viz-levels\.txt' -e moved_to -e create -e close_write -e attrib -e delete_self "$dir" "$folder" >/dev/null 2>&1 8>&- || :
        else
            sleep 2
        fi
        now=$(key)
        if [ -n "$now" ] && [ "$now" != "$seen" ]; then
            # A link swapped is complete the moment it is seen; an image being written in
            # place is not, so only a link that points at a file still growing waits.
            [ -L "$wallpaper" ] || sleep 0.15
            resync; seen=$(key)
        fi
        # the pace or reduced motion changed: a new live copy, and the keeper brings the scene back
        m=$(motion_key)
        if [ -n "$m" ] && [ "$m" != "$motion_seen" ]; then
            motion_seen=$m
            if [ -n "$(scene_pids)" ] && snapshot; then
                for p in $(scene_pids); do kill -TERM "$p" 2>/dev/null; done
                echo "$(date +%T) motion $m: the bar restarted to move at that pace"
            fi
        fi
        # the bar wrote its palette for your apps again (a new palette, or a switch turned)
        a=$(apps_key)
        if [ -n "$a" ] && [ "$a" != "$apps_seen" ]; then
            apps_seen=$a
            said=$(apps_sync 2>&1) || :
            [ -n "$said" ] && echo "$(date +%T) $said"
        fi
    done
}

# The **lock** is the truth about a watcher and the pid file is how it is signalled: a watcher
# killed outright cannot clean up after itself, so a pid file can outlive its watcher (and a
# watcher can outlive its pid file, which is what a `status` reading the file alone gets wrong).
theme_watch_pid() { cat "$theme_pid" 2>/dev/null; }
theme_watching() {
    exec 7>"$theme_watch_lock" 2>/dev/null || return 1
    if flock -n 7 2>/dev/null; then flock -u 7 2>/dev/null; return 1; fi   # we took it: nobody is watching
    return 0
}
theme_watch_stray() { pgrep -f "[b]in/mooi theme-watch" 2>/dev/null; }
theme_watch_start() { # one watcher, ever: start it, or take over from one that has gone quiet
    if theme_watching; then
        alive "$(theme_watch_pid)" && return 0
        echo "mooi: a theme watch was left behind; replacing it" >&2
        theme_watch_stop
    fi
    setsid -f "$self" theme-watch >> "$state/theme-watch.log" 2>&1 < /dev/null
}
theme_watch_stop() { # TERM, wait for the lock, then insist: the watch must really be gone
    for p in $(theme_watch_stray); do kill -TERM "$p" 2>/dev/null; done
    wait_for 7 not theme_watching
    for p in $(theme_watch_stray); do kill -KILL "$p" 2>/dev/null; done
    rm -f "$theme_pid"
}
not() { ! "$@"; }
# The running shell is a snapshot of the repo's `shell/`, not the repo itself: pleamar reloads a
# scene whenever its file is saved, so a desktop running the repo reloaded on every edit — half
# a change at a time, logic errors and all (found 2026-10-19, the Atlas "glitch"). `start`,
# `takeover` and `refresh` take a fresh snapshot; nothing else touches it.
# The settings window, the board and the other tools are programs of their own (their .plm
# files) and pleamar gives each the data folder of its file's name: those folders are links to
# mooi's, so they read and write mooi's settings.json, palette.json and
# board.json. Made here, idempotently; a real folder in the way is moved aside.
settings_link() {
    # (its own names: `scene` is the keeper's, and refresh finds the bar's process by it)
    local prog link
    for prog in mooi-settings mooi-board mooi-nexus mooi-desk mooi-player mooi-notch mooi-frame; do
        link="$(dirname "$folder")/$prog"
        [ -L "$link" ] && continue
        [ -e "$link" ] && mv "$link" "$link.old.$$"
        mkdir -p "$folder" && ln -s "$folder" "$link"
    done
    # BMO shares mooi's data folder too (his settings are its companion section; a link to a single
    # file is replaced by a copy on the first write). His place, kept in his own folder before,
    # comes along as bmo-state.json.
    bmo_dir="$(dirname "$folder")/bmo"
    if [ -d "$bmo_dir" ] && [ ! -L "$bmo_dir" ]; then
        if [ -f "$bmo_dir/bmo-state.json" ]; then cp "$bmo_dir/bmo-state.json" "$folder/bmo-state.json"
        elif [ -f "$bmo_dir/settings.json" ] && command -v jq >/dev/null 2>&1; then
            jq '{x: (.x // -1), y: (.y // -1)}' "$bmo_dir/settings.json" > "$folder/bmo-state.json" 2>/dev/null || :
        fi
        mv "$bmo_dir" "$bmo_dir.old.$$"
    fi
    [ -L "$bmo_dir" ] || { mkdir -p "$folder" && ln -s "$folder" "$bmo_dir"; }
}
# Sockets of scenes that are gone. pleamar names a second copy of a scene `<name>-<pid>`; a copy
# ended outright (a refresh mid-flight, a scene killed) leaves that socket behind, one per restart
# (28 of them by 2026-10-29, every one from a killed copy). A dead pid's is removed, a live one's
# left alone — no name is held by files, only by the process listening on them.
reap_sockets() {
    local d="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/pleamar" f pid
    [ -d "$d" ] || return 0
    for f in "$d"/*.sock; do
        [ -S "$f" ] || continue
        pid=$(basename "$f" | sed -n 's/.*-\([0-9][0-9]*\)\.sock$/\1/p')
        [ -n "$pid" ] || continue
        kill -0 "$pid" 2>/dev/null || rm -f "$f"
    done
}
# The live copy is current when nothing under shell/ is newer than it, no file has come or gone,
# and it was paced at today's speed by the pleamar installed now: then a login (or a refresh with
# nothing changed) starts at once instead of compiling nine scenes first (~1.1 s of every login).
snapshot_stamp() { echo "speed $(pace_speed) · $("$pleamar" --version 2>&1 | head -n 1)"; }
snapshot_current() {
    [ -f "$live/.snapshot" ] && [ "$(cat "$live/.snapshot")" = "$(snapshot_stamp)" ] || return 1
    [ -z "$(find "$root/shell" -newer "$live/.snapshot" -print 2>/dev/null | head -n 1)" ] || return 1
    [ "$(cd "$root/shell" && find . | sort)" = "$(cd "$live" && find . ! -name .snapshot | sort)" ]
}
# Every scene the shell runs, and what to call it when it does not compile.
SCENES="mooi.plm:the repo's scene
mooi-settings.plm:the settings window
mooi-board.plm:the board
mooi-nexus.plm:Control Nexus
mooi-frame.plm:the screen frame
mooi-desk.plm:the desk
mooi-player.plm:the music player
mooi-notch.plm:the side notch
bmo/bmo.plm:BMO"
snapshot() {
    reap_sockets
    settings_link
    snapshot_current && return 0
    # the stamp is taken before anything is read, so a file saved during the copy makes the next
    # start check again rather than be missed
    stamp_new="$state/.snapshot.new"
    mkdir -p "$state" && snapshot_stamp > "$stamp_new" || return 1
    # all nine at once: each check is its own pleamar, and together they take as long as the slowest
    checks="$state/.checks.$$"
    rm -rf "$checks" && mkdir -p "$checks" || return 1
    n=0
    while IFS=: read -r file what; do
        n=$((n + 1))
        { "$pleamar" --check "$root/shell/$file" >/dev/null 2>&1 || echo "$what" > "$checks/$n"; } &
    done <<SCENES_EOF
$SCENES
SCENES_EOF
    wait
    failed=$(cat "$checks"/* 2>/dev/null | head -n 1)
    rm -rf "$checks"
    if [ -n "$failed" ]; then
        rm -f "$stamp_new"
        echo "mooi: $failed does not compile; the running one is kept" >&2
        return 1
    fi
    rm -rf "$live.new" && cp -r "$root/shell" "$live.new" || return 1
    pace "$live.new"
    mv "$stamp_new" "$live.new/.snapshot"
    rm -rf "$live" && mv "$live.new" "$live"
}
# How fast everything moves (settings: motion.speed, %). Pleamar's springs are numbers in the
# scene, so the live copy's are scaled as it is made: a time factor f = 100 / speed turns a
# spring's stiffness into k / f² and its damping into c / f (same shape, f times the duration),
# and a `~120ms` or `for 460ms` into f times as long. The visualizer's spring (`fl.level`) follows
# the sound and is left alone; a 1 ms snap stays a snap.
pace_speed() {
    speed=100
    [ -r "$settings" ] && command -v jq >/dev/null 2>&1 && speed=$(jq -r '.motion.speed // 100' "$settings" 2>/dev/null || echo 100)
    case "$speed" in ''|0|*[!0-9]*) speed=100 ;; esac
    echo "$speed"
}
pace() {
    speed=$(pace_speed)
    [ "$speed" -eq 100 ] && return 0
    # No `bc` (audit 2026-10-31, F5): awk computes the factor itself, so a machine without bc
    # no longer gets a silent division by zero and unpaced scenes. The list is read a line at a
    # time so a path with a space is not split.
    find "$1" -name '*.plm' | while IFS= read -r f; do
        awk -v speed="$speed" '
        BEGIN { f = 100 / speed }
        function ms(s, pat, pre,   out, n) {
            out = ""
            while (match(s, pat)) {
                n = substr(s, RSTART + length(pre), RLENGTH - length(pre) - 2) + 0
                if (n >= 10) n = int(n * f + 0.5)
                out = out substr(s, 1, RSTART - 1) pre n "ms"; s = substr(s, RSTART + RLENGTH)
            }
            return out s
        }
        {
            line = $0
            if (match(line, /spring [A-Za-z_.]+ = [0-9.]+, [0-9.]+/) && line !~ /spring fl\.level /) {
                m = substr(line, RSTART, RLENGTH); split(m, a, /[=,]/)
                line = substr(line, 1, RSTART - 1) a[1] "= " sprintf("%.0f", a[2] / (f * f)) ", " sprintf("%.1f", a[3] / f) substr(line, RSTART + RLENGTH)
            }
            line = ms(line, "~[0-9]+ms", "~")
            line = ms(line, "for [0-9]+ms", "for ")
            print line
        }' "$f" > "$f.paced" && mv "$f.paced" "$f"
    done
}
scene_pids() { # pleamar processes running this scene (never a shell that merely mentions it)
    for p in $(pgrep -x pleamar 2>/dev/null); do
        tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null | grep -qF -- "--scene $scene " && echo "$p"
    done
}

# The keeper: runs the scene, restarts it after a crash, gives up after three quick
# deaths. A takeover it owns is undone when it ends, however it ends.
keep() {
    mode=$1
    exec 8>"$rt/keep.lock"
    flock -n 8 || { echo "mooi: already running" >&2; exit 1; }
    echo $$ > "$keep_pid"
    echo "$mode" > "$rt/mode"
    # A takeover and a session both hold the desktop (the marker the scripts look for); only a
    # takeover gives it back to ArchEclipse when it ends.
    [ "$mode" != beside ] && echo $$ > "$marker"
    end() {
        if [ "$mode" != beside ] && [ "$(cat "$marker" 2>/dev/null)" = "$$" ]; then
            rm -f "$marker"
            [ "$mode" = takeover ] && archeclipse_installed && { archeclipse_running || setsid -f "$bar_sh" >/dev/null 2>&1 8>&-; }
        fi
        rm -f "$keep_pid" "$rt/mode"
    }
    child=""
    trap '[ -n "$child" ] && kill -TERM "$child" 2>/dev/null; end; exit 0' TERM INT HUP
    : > "$log"
    tries=0
    while :; do
        start=$(date +%s)
        MOOI_MODE=$mode MOOI_SHELL=$live MOOI_BIN=$self "$pleamar" --scene "$scene" --no-hud --stall 0 $(reduced_flag) >> "$log" 2>&1 8>&- &
        child=$!
        wait "$child"; code=$?
        [ "$code" -eq 0 ] && break
        [ "$mode" != beside ] && [ ! -f "$marker" ] && break   # bar.sh ended the takeover
        if [ $(($(date +%s) - start)) -lt 10 ]; then tries=$((tries + 1)); else tries=0; fi
        if [ "$tries" -ge 3 ]; then
            echo "mooi-keep: died $tries times quickly, giving up" >> "$log"
            # said where it will be seen: without it a standalone desktop simply has no bar
            command -v notify-send >/dev/null 2>&1 && notify-send -u critical -a mooi "mooi stopped" \
                "It crashed three times in a row. Super+Shift+B starts it again; the log: $log" 8>&-
            break
        fi
        echo "mooi-keep: exited with $code, restarting" >> "$log"
        sleep "$tries"
    done
    end
}

stop_mooi() {
    "$pleamar" --say "$name" quit >/dev/null 2>&1
    wait_for 3 not running && return 0
    # Hung: take the marker first so the keeper does not restart it, then end it.
    rm -f "$marker"
    alive "$(cat "$keep_pid" 2>/dev/null)" && kill -TERM "$(cat "$keep_pid")" 2>/dev/null
    for p in $(scene_pids); do kill -TERM "$p" 2>/dev/null; done
    wait_for 3 not running || for p in $(scene_pids); do kill -KILL "$p" 2>/dev/null; done
}

cmd=${1:-help}; [ $# -gt 0 ] && shift
case "$cmd" in
    __keep) keep "${1:-beside}" ;;
    start)
        running && { echo "mooi is already running"; theme_watch_start; exit 0; }
        # with ArchEclipse uninstalled there is nothing to run beside: mooi is the desktop (D48)
        archeclipse_installed || exec "$self" session
        snapshot || exit 1
        setsid -f "$self" __keep beside >/dev/null 2>&1 < /dev/null
        wait_for 5 running && echo "mooi started beside ArchEclipse" || { echo "mooi did not start; see $log" >&2; exit 1; }
        # The colours follow the wallpaper from here on (docs/MECHANISM.md §8).
        theme_watch_start
        ;;
    toggle)
        if ! running; then
            "$self" start >/dev/null || exit 1
            wait_for 3 running
        fi
        exec "$pleamar" --say "$name" "emit open_command" ;;
    takeover)
        takeover_active && { echo "mooi already holds the desktop"; exit 0; }
        archeclipse_installed || exec "$self" session
        [ "$("$engine_sh" get 2>/dev/null)" = marea ] && { echo "Marea is the shell engine; switch to ArchEclipse first (SUPER+CTRL+SHIFT+B)" >&2; exit 1; }
        # The fullscreen sync restarts ArchEclipse's bar on every focus change unless it knows
        # about the marker, so without its guard the takeover would not hold (docs/SWITCHING.md).
        # bar.sh needs none: SUPER+SHIFT+B bringing ArchEclipse back is the way out.
        f="$HOME/.config/hypr/scripts/quickshell-fullscreen-sync.sh"
        grep -q MOOI_TAKEOVER "$f" 2>/dev/null || { echo "takeover not set up: $f has no mooi guard (docs/SWITCHING.md)" >&2; exit 1; }
        snapshot || exit 1
        running && stop_mooi
        theme_watch_start
        rm -f "$marker"
        setsid -f "$self" __keep takeover >/dev/null 2>&1 < /dev/null
        # Only once mooi is up (and the marker is there) does ArchEclipse step aside.
        if wait_for 6 takeover_active && wait_for 6 running; then
            "$bar_sh" --kill >/dev/null 2>&1
            echo "mooi holds the desktop · back to ArchEclipse: Super+Alt+Shift+Space or SUPER+SHIFT+B"
        else
            echo "mooi did not start; ArchEclipse left as it was. See $log" >&2
            alive "$(cat "$marker" 2>/dev/null)" && kill -TERM "$(cat "$marker")" 2>/dev/null
            rm -f "$marker"; exit 1
        fi
        ;;
    session)
        # mooi as the whole desktop (D48): a takeover that never hands back to ArchEclipse
        [ "$(cat "$rt/mode" 2>/dev/null)" = session ] && takeover_active && running && { echo "mooi is already the desktop"; theme_watch_start; exit 0; }
        snapshot || exit 1
        # the marker first: a takeover's keeper hands the desktop back to ArchEclipse only while it
        # still holds it
        rm -f "$marker"
        running && stop_mooi
        alive "$(cat "$keep_pid" 2>/dev/null)" && kill -TERM "$(cat "$keep_pid")" 2>/dev/null && wait_for 3 not running
        theme_watch_start
        setsid -f "$self" __keep session >/dev/null 2>&1 < /dev/null
        if wait_for 6 takeover_active && wait_for 8 running; then
            archeclipse_running && "$bar_sh" --kill >/dev/null 2>&1
            echo "mooi is the desktop"
        else
            echo "mooi did not start; see $log" >&2
            exit 1
        fi
        ;;
    restart-hypr)
        # Hyprland reads its config again, then the bar comes back on it. A reload leaves every
        # window open; mooi's own windows restart with the bar.
        hyprctl reload >/dev/null 2>&1 || { echo "hyprctl could not reload Hyprland" >&2; exit 1; }
        exec "$self" refresh
        ;;
    refresh)
        running || { echo "mooi is not running; \`mooi start\` or \`mooi takeover\`" >&2; exit 1; }
        [ -n "$(scene_pids)" ] || { echo "the running mooi is not a snapshot (started before \`refresh\` existed): \`mooi stop\`, then \`mooi start\` or \`mooi takeover\`" >&2; exit 1; }
        snapshot || exit 1
        # The keeper restarts a scene that ends with an error, in the same mode: ending only the
        # scene keeps the takeover (and ArchEclipse down) through the refresh.
        for p in $(scene_pids); do kill -TERM "$p" 2>/dev/null; done
        wait_for 3 not running
        wait_for 8 running && echo "mooi refreshed from the repo" || { echo "mooi did not come back; see $log" >&2; exit 1; }
        # the watch is this script too: a new one runs what the repo says now
        theme_watch_stop; theme_watch_start
        ;;
    stop | restore)
        # only a takeover hands the desktop back to ArchEclipse; a session simply stops
        was_takeover=false; takeover_active && [ "$(cat "$rt/mode" 2>/dev/null)" != session ] && was_takeover=true
        [ "$(cat "$rt/mode" 2>/dev/null)" = session ] && rm -f "$marker"
        running && stop_mooi
        theme_watch_stop
        alive "$(cat "$keep_pid" 2>/dev/null)" && kill -TERM "$(cat "$keep_pid")" 2>/dev/null
        if { $was_takeover || [ -f "$marker" ]; } && archeclipse_installed; then
            rm -f "$marker"
            wait_for 5 archeclipse_running || setsid -f "$bar_sh" >/dev/null 2>&1
            wait_for 8 archeclipse_running && echo "ArchEclipse is back" || echo "ArchEclipse did not come back: run $bar_sh" >&2
        else
            rm -f "$marker"
            echo "mooi stopped"
        fi
        ;;
    status)
        if takeover_active && [ "$(cat "$rt/mode" 2>/dev/null)" = session ]; then echo "mooi: the whole desktop (keeper $(cat "$marker"))"
        elif takeover_active; then echo "mooi: takeover (keeper $(cat "$marker"))"
        elif running; then echo "mooi: beside ArchEclipse"
        else echo "mooi: not running"; fi
        theme_watching && echo "theme watch: following $(basename "$wallpaper")" || echo "theme watch: not running"
        if ! archeclipse_installed; then echo "ArchEclipse: not installed"
        elif archeclipse_running; then echo "ArchEclipse: running"
        else echo "ArchEclipse: not running"; fi
        [ -f "$marker" ] && ! takeover_active && echo "(stale takeover marker; ignored)"
        echo "pleamar: $("$pleamar" --version 2>&1)"
        ;;
    run)
        if [ "${1:-}" = --safe ]; then shift; export MOOI_SAFE=1; fi
        # shellcheck disable=SC2046
        settings_link
        MOOI_SHELL="$root/shell" exec "$pleamar" --scene "$src" --no-hud --stall 0 $(reduced_flag) "$@" ;;
    open | window) exec "$pleamar" --say "$name" "emit open_window" ;;
    system) exec "$pleamar" --say "$name" "emit open_system" ;;
    settings) exec "$pleamar" --say "$name" "emit open_settings" ;;
    wallpaper) # the one wallpaper picker (D118): Lumen, the studio, is gone; Skwd Wall picks
               command -v skwd-wall-v2 >/dev/null 2>&1 || { echo "skwd-wall-v2 is not installed" >&2; exit 1; }
               exec skwd-wall-v2 ;;
    notes) exec "$pleamar" --say "$name" "emit open_notes" ;;
    player) running || { echo "mooi is not running; start it first" >&2; exit 1; }
            exec "$pleamar" --say "$name" "emit open_player 1" ;;
    board) running || { echo "mooi is not running; start it first" >&2; exit 1; }
           exec "$pleamar" --say "$name" "emit open_board" ;;
    notch) # the side notch on a panel: claude music spaces walls weather github (Claude by default)
        case "${1:-claude}" in claude) n=0 ;; music) n=1 ;; spaces|workspaces) n=2 ;; walls|wallpapers) n=3 ;; weather) n=4 ;; github) n=5 ;;
            *) echo "usage: mooi notch [claude|music|spaces|walls|weather|github]" >&2; exit 2 ;; esac
        exec "$pleamar" --say mooi-notch "emit nt_show $n" ;;
    nexus) running || { echo "mooi is not running; start it first" >&2; exit 1; }
           exec "$pleamar" --say "$name" "emit open_nexus" ;;
    hardware)
        echo "MOOI HARDWARE INVENTORY"
        echo "Kernel: $(uname -r 2>/dev/null || echo Unavailable)"
        cpu_model=$(awk -F: '/model name[[:space:]]*:/ { sub(/^[[:space:]]+/, "", $2); print $2; exit }' /proc/cpuinfo 2>/dev/null)
        [ -n "$cpu_model" ] || cpu_model="Unavailable"
        echo "CPU: $cpu_model"
        echo
        echo "GRAPHICS"
        if command -v lspci >/dev/null 2>&1; then
            lspci 2>/dev/null | grep -Ei 'VGA compatible controller|3D controller|Display controller' | sed 's/^[^:]*: //' || echo "No PCI display controllers found"
        else echo "Unavailable (install pciutils for lspci)"; fi
        echo
        echo "STORAGE DEVICES"
        if command -v lsblk >/dev/null 2>&1; then
            lsblk -dn -o NAME,SIZE,TYPE,MODEL 2>/dev/null | awk '$3 == "disk" {print}' || true
        else echo "Unavailable (lsblk missing)"; fi
        echo
        echo "DISPLAYS"
        if command -v hyprctl >/dev/null 2>&1; then
            hyprctl monitors -j 2>/dev/null | jq -r '.[] | "\(.name): \(.width)x\(.height) @ \(.refreshRate) Hz · scale \(.scale)"' 2>/dev/null || echo "Unavailable (Hyprland monitor query failed)"
        else echo "Unavailable (Hyprland session not detected)"; fi
        ;;
    diagnostics)
        action=${1:-show}
        case "$action" in show|copy) ;; *) echo "usage: mooi diagnostics [show|copy]" >&2; exit 2 ;; esac
        os_name="Unknown distribution"
        if [ -r /etc/os-release ]; then . /etc/os-release; os_name=${PRETTY_NAME:-${NAME:-Unknown distribution}}; fi
        cpu_model=$(awk -F: '/model name[[:space:]]*:/ { sub(/^[[:space:]]+/, "", $2); print $2; exit }' /proc/cpuinfo 2>/dev/null)
        [ -n "$cpu_model" ] || cpu_model="Unavailable"
        memory=$(awk '/^MemTotal:/ {t=$2} /^MemAvailable:/ {a=$2} END {if(t>0) printf "%.1f GiB used / %.1f GiB total", (t-a)/1048576, t/1048576; else print "Unavailable"}' /proc/meminfo 2>/dev/null)
        root_disk=$(df -hP / 2>/dev/null | awk 'NR==2 {printf "%s used (%s of %s)", $5, $3, $2}')
        [ -n "$root_disk" ] || root_disk="Unavailable"
        uptime_text=$(uptime -p 2>/dev/null || true); [ -n "$uptime_text" ] || uptime_text="Unavailable"
        gpu_list=$(lspci 2>/dev/null | grep -Ei 'VGA compatible controller|3D controller|Display controller' | sed 's/^[^:]*: //' | head -n 4)
        [ -n "$gpu_list" ] || gpu_list="Unavailable (lspci missing or no PCI display device found)"
        report=$(printf '%s\n' "MOOI SYSTEM DIAGNOSTICS" "Distribution: $os_name" "Kernel: $(uname -r 2>/dev/null || echo Unavailable)" "Hostname: $(hostname 2>/dev/null || echo Unavailable)" "Session: ${XDG_CURRENT_DESKTOP:-${XDG_SESSION_TYPE:-Unknown}}" "Uptime: $uptime_text" "CPU: $cpu_model" "Memory: $memory" "Root storage: $root_disk" "Graphics: $gpu_list")
        if [ "$action" = show ]; then printf '%s\n' "$report"; exit 0; fi
        if command -v wl-copy >/dev/null 2>&1; then printf '%s\n' "$report" | wl-copy || { echo "Clipboard write failed" >&2; exit 1; }
        elif command -v xclip >/dev/null 2>&1; then printf '%s\n' "$report" | xclip -selection clipboard -in || { echo "Clipboard write failed" >&2; exit 1; }
        else echo "No clipboard utility found; install wl-clipboard or xclip" >&2; exit 1; fi
        echo "Diagnostics copied"
        ;;
    identity)
        # Import images into mooi's own data folder; only generated relative paths enter settings.
        action=${1:-help}; [ $# -gt 0 ] && shift
        [ "${MOOI_SAFE:-0}" != 1 ] || { echo "identity settings are disabled in --safe mode" >&2; exit 1; }
        [ -r "$settings" ] || { echo "mooi settings not found; start mooi once first: $settings" >&2; exit 1; }
        command -v jq >/dev/null 2>&1 || { echo "identity requires jq" >&2; exit 1; }
        jq -e . "$settings" >/dev/null 2>&1 || { echo "settings.json is not valid JSON; refusing to overwrite it" >&2; exit 1; }
        case "$action" in
            name)
                value=$(printf '%s' "$*" | tr '\n' ' ')
                [ -n "$value" ] || { echo 'usage: mooi identity name "Display name"' >&2; exit 2; }
                [ "${#value}" -le 48 ] || { echo "display name must be 48 characters or fewer" >&2; exit 2; }
                case "$value" in *"$(printf '\001')"*|*"$(printf '\177')"*) echo "control characters are not allowed" >&2; exit 2 ;; esac
                tmp="$settings.tmp.$"
                jq --arg value "$value" '.nexus.identity.name = $value' "$settings" > "$tmp" && mv "$tmp" "$settings" || { rm -f "$tmp"; echo "could not update settings" >&2; exit 1; }
                echo "System identity name set to: $value"
                ;;
            avatar|banner)
                source=${1:-}
                [ -n "$source" ] && [ -f "$source" ] || { echo "usage: mooi identity $action /path/to/image.png" >&2; exit 2; }
                command -v file >/dev/null 2>&1 || { echo "identity image import requires the file utility" >&2; exit 1; }
                mime=$(file --brief --mime-type -- "$source" 2>/dev/null || true)
                case "$mime" in image/png) ext=png ;; image/jpeg) ext=jpg ;; image/webp) ext=webp ;; image/avif) ext=avif ;; *) echo "unsupported image type: $mime (use PNG, JPEG, WebP or AVIF)" >&2; exit 2 ;; esac
                mkdir -p "$folder/identity" || exit 1
                # A new name for every import: a scene's image is read by its path, so reusing
                # avatar.jpg would leave the plate showing the picture it already had (D70).
                relative="identity/$action-$(date +%s)-$$.$ext"
                dest="$folder/$relative"
                tmpdest="$dest.tmp.$"
                cp -- "$source" "$tmpdest" && mv "$tmpdest" "$dest" || { rm -f "$tmpdest"; echo "could not import image" >&2; exit 1; }
                tmp="$settings.tmp.$"
                jq --arg value "$relative" --arg action "$action" '.nexus.identity[$action] = $value' "$settings" > "$tmp" && mv "$tmp" "$settings" || { rm -f "$tmp"; echo "could not update settings; imported image remains at $dest" >&2; exit 1; }
                for old in "$folder/identity/$action".* "$folder/identity/$action"-*; do [ "$old" = "$dest" ] || rm -f -- "$old"; done
                echo "$action image imported to $dest"
                ;;
            remove)
                what=${1:-}
                case "$what" in avatar|banner) ;; *) echo "usage: mooi identity remove avatar|banner" >&2; exit 2 ;; esac
                tmp="$settings.tmp.$"
                jq --arg action "$what" '.nexus.identity[$action] = ""' "$settings" > "$tmp" && mv "$tmp" "$settings" || { rm -f "$tmp"; echo "could not update settings" >&2; exit 1; }
                rm -f "$folder/identity/$what".* "$folder/identity/$what"-*
                echo "$what image removed"
                ;;
            reset)
                tmp="$settings.tmp.$"
                jq '.nexus.identity = {name:"mooi system",avatar:"",banner:""}' "$settings" > "$tmp" && mv "$tmp" "$settings" || { rm -f "$tmp"; echo "could not reset identity settings" >&2; exit 1; }
                rm -f "$folder"/identity/avatar.* "$folder"/identity/avatar-* \
                      "$folder"/identity/banner.* "$folder"/identity/banner-*
                echo "System identity reset"
                ;;
            show)
                jq -r '.nexus.identity // {name:"mooi system",avatar:"",banner:""} | "Name: \(.name // "mooi system")\nAvatar: \(.avatar // "not set")\nBanner: \(.banner // "not set")"' "$settings"
                ;;
            *)
                echo 'usage: mooi identity name "Display name" | avatar IMAGE | banner IMAGE | remove avatar|banner | show | reset' >&2
                exit 2
                ;;
        esac
        ;;
    note)
        text=$(printf '%s' "$*" | tr '\n' ' ')
        [ -n "$text" ] || { echo "usage: mooi note \"what to remember\"" >&2; exit 2; }
        running || { echo "mooi is not running; start it first" >&2; exit 1; }
        "$pleamar" --say "$name" "text qn_draft $text" >/dev/null || exit 1
        "$pleamar" --say "$name" "emit qn_add" >/dev/null
        ;;
    clipboard) exec "$pleamar" --say "$name" "emit open_clips" ;;
    record) exec "$pleamar" --say "$name" "emit record $([ "${1:-}" = area ] && echo 1 || echo 0)" ;;
    edit) exec "$pleamar" --say "$name" "emit edit_toggle" ;;
    overview)
        exec "$pleamar" --say "$name" "emit open_overview" ;;
    mode)   # light | dark | auto | (nothing: the other one now)
        case "${1:-}" in dark) n=0 ;; light) n=1 ;; auto) n=2 ;; ""|toggle) n=9 ;; *) echo "usage: mooi mode [light|dark|auto]" >&2; exit 2 ;; esac
        exec "$pleamar" --say "$name" "emit set_mode $n" ;;
    shutter) exec "$pleamar" --say "$name" "emit open_shutter 0" ;;
    shutter-here) exec "$pleamar" --say "$name" "emit open_shutter 1" ;;
    say)  exec "$pleamar" --say "$name" "$@" ;;
    check)
        sh -n "$self" || exit 1
        for t in "$root"/tests/*.sh; do sh -n "$t" || exit 1; done
        # A gate, not a style report: errors only. The launcher holds the takeover, keeper and
        # lock logic, and `sh -n` cannot see word splitting or a bad expansion (audit F5).
        if command -v shellcheck >/dev/null 2>&1; then
            shellcheck -S error -q "$self" "$root"/tests/*.sh || exit 1
        else
            echo "shellcheck: not installed; syntax checked with sh -n only"
        fi
        "$pleamar" --check "$src" || exit 1
        "$pleamar" --check "$root/shell/mooi-settings.plm" || exit 1
        "$pleamar" --check "$root/shell/mooi-board.plm" || exit 1
        "$pleamar" --check "$root/shell/mooi-nexus.plm" || exit 1
        "$pleamar" --check "$root/shell/mooi-frame.plm" || exit 1
        "$pleamar" --check "$root/shell/mooi-desk.plm" || exit 1
        "$pleamar" --check "$root/shell/mooi-player.plm" || exit 1
        "$pleamar" --check "$root/shell/mooi-notch.plm" || exit 1
        "$pleamar" --check "$root/shell/bmo/bmo.plm" || exit 1
        # `pleamar --check` compiles a scene, not its logic: a logic file that does not even
        # parse is found only when the scene starts (a logic file that lost an `end`, 2026-10-20). Every
        # file is written in the subset Lua 5.4 and Luau share, so Lua 5.4 can parse them all.
        for f in "$root"/shell/*.luau "$root"/shell/lib/*.luau "$root"/shell/player/*.luau "$root"/shell/bmo/*.luau; do
            F="$f" lua5.4 -e 'local _, e = loadfile(os.getenv("F")); if e then io.stderr:write(e, "\n"); os.exit(1) end' || exit 1
        done
        # Each suite must be able to fail the check (audit 2026-10-31, F1): before this the unit
        # tests' status was thrown away and the last `echo` made the command exit 0.
        ( cd "$root" && lua5.4 shell/bmo/test.lua ) || exit 1
        ( cd "$root" && lua5.4 tests/unit/run.lua ) || exit 1
        # What this machine lacks: the scenes fall back quietly, so name it here rather than let a
        # visualizer or a store module look broken (audit 2026-10-29).
        missing=
        for tool in cava rembg playerctl mpc mpv yt-dlp magick wf-recorder grim slurp checkupdates flatpak; do
            command -v "$tool" >/dev/null 2>&1 || missing="$missing $tool"
        done
        [ -n "$missing" ] && echo "optional, not installed:$missing"
        # The scenes are written for language 0.4; another one may compile and still behave
        # differently, so say which pleamar this is.
        ver=$("$pleamar" --version 2>/dev/null | head -1)
        case "$ver" in
            *"language 0.4"*) echo "pleamar: $ver" ;;
            *) echo "warning: $ver · the scenes are written for language 0.4" >&2 ;;
        esac ;;
    theme-sync)
        theme_sync "$@" || { echo "theme-sync: failed" >&2; exit 1; }
        running && echo "mooi asked to read it" || echo "mooi is not running; it will read the palette when it starts"
        ;;
    theme-watch) theme_watch ;;
    apps-sync) apps_sync ;;
    *) sed -n '2,26p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac
