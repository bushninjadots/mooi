#!/usr/bin/env bash
# mooi — launcher. mooi is the whole desktop: the login starts `mooi session`
# (~/.config/hypr/config/custom/mooi.lua) and there is no other shell beside it (D133).
#
#   mooi session           start mooi, or restart it (detached, restarted if it crashes; Super+Shift+B)
#   mooi start             the same as `session` (kept for old keys and scripts)
#   mooi toggle            the command membrane; starts mooi first if needed (Super+Alt+Space)
#   mooi stop              stop mooi (Super+Alt+Shift+Space)
#   mooi status            what is running
#   mooi run [--safe] …    foreground, for development (pleamar options after it): runs the repo
#                          itself, so saving a file reloads it
#   mooi refresh           copy the repo's shell into the running snapshot and restart the scene
#                          (the keeper is kept)
#   mooi restart-hypr      Hyprland reads its config again, then the bar restarts on it (Settings →
#                          Advanced and the Nexus's rail); windows stay open, mooi's own close
#   mooi window | system   toggle the window island (Super+Alt+W) or the system island
#   mooi mode [light|dark|auto]  day or night for the whole desktop; no word turns to the other one (Super+Alt+T)
#   mooi overview          every workspace zoomed out (Super+Tab)
#   mooi shutter | shutter-here   the Mechanical Shutter on the focused window (Super+Alt+D), or the
#                          one under the pointer (Super+Alt+right-click)
#   mooi wallpaper | walls the wallpaper picker: the strip and the colour orbit (D145; Super+W)
#   mooi wall apply FILE   wear a picture, an animated picture or a video (D145); `wall live` keeps
#                          mpvpaper as the wallpaper says, `wall index` reads the folders for the picker
#   mooi settings | edit   open or close the settings window; the bar's edit mode on or off
#   mooi notes | clipboard the side panel's notices or clipboard history (open or close)
#   mooi note "text"       save a line in the quick notes (no window; notes.json)
#   mooi board            the Kanban board (open or close; the quick notes pad's rail opens it too)
#   mooi widgets [edit|desk]  place the desktop widgets (Esc leaves); desk: gather them all over the desktop
#   mooi focus [reset]    the focus timer widget: start or pause it, or reset it
#   mooi bmo joke         BMO tells one of his jokes
#   mooi wallmap [file] [fast]  read the wallpaper for the widgets: its subject cut out (rembg) and a map
#   mooi player           the music player: mpd's library, lyrics, a turntable (open or close; a press on the media module)
#   mooi nexus            Control Nexus (open or close; the bar's Arch mark opens it too)
#   mooi notch [panel]    the side notch on a panel: claude (default), music, spaces, walls, weather, github, games
#   mooi game <folder>    start a game found on the disk where it lies: its own launcher, or wine / PortProton
#   mooi identity …        manage local Nexus name, avatar and banner assets
#   mooi record [area]     start or stop recording the screen (or an area) with the bar's recorder
#   mooi open              same as `window` (kept for old scripts)
#   mooi say CMD…          pass a command to the running scene (pleamar --say)
#   mooi theme-sync [--light] [image]
#                          recolour from the wallpaper with Matugen (theme/matugen.toml.in,
#                          theme/palette.json.hbs), using mooi's own config so nothing of
#                          the user's theming is written; then asks a running mooi to read it
#   mooi theme-watch       follow the wallpaper: recolour with Matugen whenever it changes.
#   mooi theme save <name> [description]  the current look as a package (--force replaces one)
#   mooi theme list        the packages saved in mooi's own folder
#   mooi theme apply <name|file>  wear a package: its visual settings, nothing behavioural
#   mooi idle              write hypridle's file from the lock's idle timeout (Settings → Lock)
#                          and restart it; `session` and the settings window call it
#   mooi lock | unlock     the lock screen (D160): the session through pleamar's `kind: lock`
#                          (ext-session-lock), started here if it is not running. Everything that locks
#                          comes to it — the bar's power module, Super+Shift+Escape, hypridle's idle — and
#                          `unlock` opens it without a password, the way back if it ever sticks
#   mooi ws-fx             the workspaces' shader transitions: Hyprland's screen shader, one transition long.
#                          `session` runs this beside the bar, `stop` ends it
#   mooi apps-sync         put mooi's palette on Kitty, GTK and Qt as the settings say (the watch
#                          does it by itself; switched off, an app gets its own colours back)
#   mooi kitty-shaders     write kitty's own screen shader (`custom_shaders`, kitty ≥ 0.49) as a conf
#                          beside the settings and point kitty.conf at it; the switch off takes it back
#   mooi check             compile the scene and run the unit tests
#
# --safe / MOOI_SAFE=1 ignores settings.json. MOOI_PLEAMAR picks another pleamar binary.
set -u
root=$(cd "$(dirname "$0")/.." && pwd)
self="$root/bin/mooi"
# The scene's own commands are written as `mooi …` (the identity image import and the
# diagnostics copy). Pleamar runs them by name, not by path, so the launcher's own bin is on
# PATH for the keeper and for everything the scene starts.
case ":$PATH:" in
    *":$root/bin:"*) ;;
    *) PATH="$root/bin:$PATH"; export PATH ;;
esac
src="$root/shell/mooi.plm"                      # the repo's scene: development, `check`, the tests
live="${XDG_STATE_HOME:-$HOME/.local/state}/mooi/live"
scene="$live/mooi.plm"                          # what the keeper runs: a snapshot (see `snapshot`)
name=mooi
pleamar=${MOOI_PLEAMAR:-pleamar}
rt="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/mooi"
keep_pid="$rt/keep.pid"
again="$rt/again"                               # `refresh`: the next clean exit is a restart
state="${XDG_STATE_HOME:-$HOME/.local/state}/mooi"
log="$state/mooi.log"
settings="${XDG_DATA_HOME:-$HOME/.local/share}/pleamar/$name/settings.json"
mkdir -p "$rt" "$state"
# An empty folder the notch runs Claude and the free models in (fourth pass, L3): never the runtime
# dir itself, which holds the session's sockets. Exported, so every scene mooi starts has it.
mkdir -p "$rt/ask" 2>/dev/null && chmod 700 "$rt/ask" 2>/dev/null
export MOOI_ASK_DIR="$rt/ask"

reduced_flag() {
    [ "${MOOI_SAFE:-0}" = 1 ] && return 0
    [ -r "$settings" ] && command -v jq >/dev/null 2>&1 || return 0
    [ "$(jq -r '.motion.reduced // false' "$settings" 2>/dev/null)" = true ] && echo --reduced-motion
    return 0
}
running() { "$pleamar" --say "$name" "get phase" >/dev/null 2>&1; }
alive() { [ -n "${1:-}" ] && kill -0 "$1" 2>/dev/null; }
keeping() { alive "$(cat "$keep_pid" 2>/dev/null)"; }
wait_for() { # seconds, command…
    n=$(($1 * 10)); shift
    while [ "$n" -gt 0 ]; do "$@" && return 0; sleep 0.1; n=$((n - 1)); done; return 1
}
wallpaper="${HOME}/.cache/current_wallpaper"   # the image every wallpaper setter in this setup updates
folder=$(dirname "$settings")                   # where the palette and the settings live
palette="$folder/palette.json"
from="$folder/palette.from"                     # which wallpaper, and extracted how, the palette came from
# How the palette is extracted (settings.json): the scheme, the source colour and the contrast.
# Day or night, now (D91): theme.mode, and for `auto` the hours it turns light and dark. The one
# place this is decided — Matugen runs in it, it is stamped into the palette the bar reads, and the
# bar hands it to the apps — so nothing can disagree about what time of day it is.
mode_now() {
    mm=dark; lf=7; lt=19
    if [ -f "$settings" ] && command -v jq >/dev/null 2>&1; then
        mm=$(jq -r '.theme.mode // "dark"' "$settings" 2>/dev/null || echo dark)
        lf=$(jq -r '.theme.light_at // 7' "$settings" 2>/dev/null || echo 7)
        lt=$(jq -r '.theme.dark_at // 19' "$settings" 2>/dev/null || echo 19)
    fi
    case "$mm" in
        light) echo light ;;
        auto)
            hh=$((10#$(date +%H)))
            if [ "$lf" -le "$lt" ]; then
                if [ "$hh" -ge "$lf" ] && [ "$hh" -lt "$lt" ]; then echo light; else echo dark; fi
            else   # a day that runs past midnight (light at 20, dark at 6)
                if [ "$hh" -ge "$lf" ] || [ "$hh" -lt "$lt" ]; then echo light; else echo dark; fi
            fi ;;
        *) echo dark ;;
    esac
}
extraction() { echo "$(jq -c '[.theme.scheme, .theme.color_index, .theme.contrast]' "$settings" 2>/dev/null) $(mode_now)"; }
theme_lock="$rt/theme.lock"
theme_pid="$rt/theme.pid"
theme_watch_lock="$rt/theme-watch.lock"

# Matugen is the palette generator (the brief: not Matugen *and* Wallust), and it runs with
# mooi's own config: one output file, no other program's colours touched. Everything that
# recolours mooi comes through here — `mooi theme-sync`, from the wallpaper or from an image
# given by hand, and `mooi theme-watch`, when the wallpaper changes on its own.
#
# The lock is what keeps two syncs apart: Matugen writes the palette in place, and a second
# run reading the wallpaper while the first is still writing would hand mooi half a palette
# (which is refused whole, so the bar would keep the old colours and look stuck).
theme_sync() { # [--light | --dark] [image] — quiet: says what it did on stdout, nothing on failure
    mode=$(mode_now)
    case "${1:-}" in --light) mode=light; shift ;; --dark) mode=dark; shift ;; esac
    image=${1:-$wallpaper}
    # Read the actual image path once, before any filesystem changes
    real_image=$(readlink -f "$image" 2>/dev/null || echo "$image")
    [ -e "$real_image" ] || { echo "no image at $image (pass one, or set a wallpaper first)" >&2; return 1; }
    command -v matugen >/dev/null 2>&1 || { echo "matugen is not installed" >&2; return 1; }
    if command -v flock >/dev/null 2>&1; then
        exec 9>"$theme_lock"
        flock -w 20 9 || { echo "another sync is still running" >&2; return 1; }
    fi
    # The lock belongs to the sync, not to the process. Without this the theme watch — which
    # calls this inside its own long loop — held it for the rest of the session, so a manual
    # `mooi theme-sync` waited 20 s and failed with "another sync is still running" while
    # nothing was syncing (audit 2026-10-31, F4).
    theme_unlock() { if command -v flock >/dev/null 2>&1; then flock -u 9 2>/dev/null; exec 9>&-; fi; }
    mkdir -p "$folder"
    cfg="$folder/matugen.toml"
    # Escape the replacement: a repo path with `&`, `|` or a backslash used to mangle the TOML
    # (audit 2026-11-06, G13).
    sed_escape() { printf '%s' "$1" | sed 's/[\\&|]/\\&/g'; }
    tpl_esc=$(sed_escape "$root/theme/palette.json.hbs")
    out_esc=$(sed_escape "$folder/palette.json")
    sed -e "s|@TPL@|$tpl_esc|" -e "s|@OUT@|$out_esc|" \
        "$root/theme/matugen.toml.in" > "$cfg" || { theme_unlock; return 1; }
    # `--source-color-index 0` is what the user's own matugen-theme.sh passes, so mooi and the
    # rest of the desktop take their colours from the same source colour of the same wallpaper;
    # without it matugen 4.2 stops and asks.
    # How the palette is extracted is the user's (settings.json, the bar's menu): the scheme
    # type, which of the wallpaper's five dominant colours it is built from, and the contrast.
    # Read here so a wallpaper change and a change made from the bar extract the same way.
    scheme=tonal-spot; index=0; contrast=0
    if [ -f "$settings" ] && command -v jq >/dev/null 2>&1; then
        scheme=$(jq -r '.theme.scheme // "tonal-spot"' "$settings" 2>/dev/null || echo tonal-spot)
        index=$(jq -r '.theme.color_index // 0' "$settings" 2>/dev/null || echo 0)
        contrast=$(jq -r '.theme.contrast // 0' "$settings" 2>/dev/null || echo 0)
    fi
    matugen image "$real_image" -c "$cfg" -m "$mode" --type "scheme-$scheme" \
        --source-color-index "$index" --contrast "$contrast" >/dev/null \
        || { echo "matugen failed" >&2; theme_unlock; return 1; }
    # The mode rides in the palette itself, so the bar builds the matching set from the same write.
    if command -v jq >/dev/null 2>&1 && [ -f "$palette" ]; then
        jq --arg m "$mode" '. + {mode: $m}' "$palette" > "$palette.mooi-tmp" && mv "$palette.mooi-tmp" "$palette"
    fi
    # Your own Matugen templates (apps.others): the same image, scheme and mode, so btop, fish,
    # cava, Vesktop, Zen, Spicetify and the widgets turn with the day too. Your config's hooks run
    # as they always do; a failure there is reported, never mooi's.
    user_cfg="${XDG_CONFIG_HOME:-$HOME/.config}/matugen/config.toml"
    if [ -f "$user_cfg" ] && [ "$(jq -r '.apps.others // false' "$settings" 2>/dev/null)" = true ]; then
        matugen image "$real_image" -c "$user_cfg" -m "$mode" --type "scheme-$scheme" \
            --source-color-index "$index" --contrast "$contrast" >/dev/null 2>&1 \
            || echo "your matugen config failed (mooi's palette is fine)" >&2
    fi
    echo "$(readlink -f "$image") $(extraction)" > "$from"   # what the palette came from: the watch reads it
    echo "palette from $(basename "$real_image") ($mode, $scheme, colour $index) → $palette"
    # mooi watches the palette file itself, so this is a courtesy: it is what makes the change
    # land in the frame after the write rather than on the next wallpaper change.
    "$pleamar" --say "$name" "emit recolor" >/dev/null 2>&1 || :
    theme_unlock
    return 0
}

# Your apps in mooi's palette (settings: apps.kitty, apps.gtk, apps.qt; D34). The bar writes
# apps.json — its palette in Matugen's role names — whenever the palette or those switches change,
# and this renders it: Kitty from mooi's template (terminal hues it can tell apart), GTK from your
# own Matugen templates when they are there (mooi's otherwise), Qt from mooi's qt5ct scheme. Each
# switch turned off puts back exactly what it changed, recorded in apps.state:
#   Kitty  — the one `include colors-….conf` line in kitty.conf points at colors-mooi.conf;
#   GTK    — gtk.css is mooi's, and your Matugen config's two GTK outputs are pointed at
#            ~/.cache/mooi while it is (so the two never write the same file); going back
#            restores those lines and the gtk.css Matugen last made;
#   Qt     — qt5ct's / qt6ct's colour scheme is mooi's (a qt6ct.conf mooi had to create goes).
apps_dir="$root/theme/apps"
apps_sync() {
    j="$folder/apps.json"
    { [ -f "$j" ] && command -v jq >/dev/null 2>&1; } || return 0
    C="${XDG_CONFIG_HOME:-$HOME/.config}"
    state="$folder/apps.state"; touch "$state"
    get() { sed -n "s|^$1=||p" "$state" | head -1; }
    put() { grep -v "^$1=" "$state" > "$state.t"; [ -n "$2" ] && echo "$1=$2" >> "$state.t"; mv "$state.t" "$state"; }
    on() { [ "$(jq -r ".$1 // false" "$j")" = true ]; }
    # The Files switch is read here, above the GTK render it also gates. (Not `//`: jq's
    # alternative operator treats `false` itself as missing, which would pin this on.)
    files_on=$(jq -r '.files != false' "$j")
    sedf="$folder/apps.sed"
    jq -r '.colors | to_entries[] | "s|{{colors.\(.key).default.hex}}|\(.value)|g\ns|{{colors.\(.key).default.hex_stripped}}|\(.value | ltrimstr("#"))|g"' "$j" > "$sedf" || return 0
    render() { sed -f "$sedf" "$1" > "$2.mooi-tmp" && mv "$2.mooi-tmp" "$2"; }
    did=""

    k="$C/kitty/kitty.conf"
    # A hand-edited `include colors-mooi.conf   ` (or a formatter that adds a space) is still
    # mooi's include: matching the whole line used to miss it, append a second one, and leave
    # both behind when the switch went off.
    mooi_inc='^include[[:space:]]\{1,\}colors-mooi\.conf[[:space:]]*$'
    if on kitty && [ -f "$k" ]; then
        render "$apps_dir/kitty.conf" "$C/kitty/colors-mooi.conf"
        if ! grep -q "$mooi_inc" "$k"; then
            was=$(sed -n "s|^include[[:space:]]\{1,\}\(colors-[A-Za-z0-9_-]*\.conf\)[[:space:]]*\$|\1|p" "$k" | head -1)
            if [ -n "$was" ]; then
                was_re=$(printf '%s\n' "$was" | sed 's/\./\\./g')
                sed -i "s|^include[[:space:]]\{1,\}${was_re}[[:space:]]*\$|include colors-mooi.conf|" "$k"; put kitty_was "$was"
            else echo "include colors-mooi.conf" >> "$k"; put kitty_was "-"; fi
        elif [ -z "$(get kitty_was)" ]; then
            # apps.state was lost while mooi's include was already in place. Nothing records
            # what pointed there before, so the honest fallback is "mooi put it here": the
            # switch off takes the line out instead of leaving Kitty in mooi's palette.
            put kitty_was "-"
        fi
        pkill -USR1 -x kitty 2>/dev/null; did="$did kitty"
    elif [ -n "$(get kitty_was)" ] && [ -f "$k" ]; then
        was=$(get kitty_was)
        if [ "$was" = "-" ]; then sed -i "/$mooi_inc/d" "$k"; else sed -i "s|$mooi_inc|include $was|" "$k"; fi
        put kitty_was ""; pkill -USR1 -x kitty 2>/dev/null; did="$did kitty(yours)"
    fi

    mt="$C/matugen/config.toml"
    for v in 3 4; do
        out="$C/gtk-$v.0/gtk.css"; shadow="$HOME/.cache/mooi/matugen-gtk-$v.0.css"
        tpl="$C/matugen/templates/gtk$v.css"; [ -f "$tpl" ] || tpl="$apps_dir/gtk$v.css"
        if on gtk; then
            mkdir -p "$(dirname "$shadow")" "$(dirname "$out")"
            # A gtk.css mooi creates where there was none has nothing to put back, so the
            # fact is recorded: turning GTK off removes it again. Without this, a file mooi
            # made (the usual case for GTK 4, whose gtk.css most setups do not have) stayed
            # after the switch went off and GTK kept mooi's colours.
            if [ ! -f "$out" ]; then put "gtk${v}_made" yes; fi
            # The user's Matugen line, however it is written: spaces around `=`, a trailing
            # comment, `~`, `$HOME` or an absolute path. The line is kept verbatim in the state,
            # so going back restores exactly what was there rather than mooi's idea of it.
            if [ -f "$mt" ] && grep -q "^output_path[[:space:]]*=[[:space:]]*\".*/gtk-$v\.0/gtk\.css\"" "$mt"; then
                # Only the first redirect keeps a copy: once mooi owns the output, $out is
                # mooi's render, and copying it over the shadow would lose the user's own
                # last Matugen-made gtk.css (which is what going back restores).
                [ -z "$(get "gtk${v}_matugen")" ] && [ -f "$out" ] && cp "$out" "$shadow"
                [ -n "$(get "gtk${v}_mt_line")" ] || put "gtk${v}_mt_line" "$(sed -n "/^output_path[[:space:]]*=[[:space:]]*\".*\/gtk-$v\.0\/gtk\.css\"/p" "$mt" | head -1)"
                sed -i "s|^output_path[[:space:]]*=[[:space:]]*\".*/gtk-$v\.0/gtk\.css\".*|output_path = \"~/.cache/mooi/matugen-gtk-$v.0.css\"  # mooi: GTK follows mooi while it is on (was ~/.config/gtk-$v.0/gtk.css)|" "$mt"
                put "gtk${v}_matugen" yes
            elif [ -z "$(get "gtk${v}_matugen")$(get "gtk${v}_backup")$(get "gtk${v}_made")" ] && [ -f "$out" ]; then
                cp "$out" "$folder/apps-gtk-$v.0.backup.css"; put "gtk${v}_backup" yes
            fi
            render "$tpl" "$out"; did="$did gtk$v"
            # Nautilus's layer is cut out of gtk.css when the Files switch is off; the marker lines
            # themselves never belong in the file either way (a template without them simply has no
            # Nautilus block, and both seds are then no-ops).
            if [ "$v" = 4 ]; then
                if [ "$files_on" != true ]; then
                    sed -i '/mooi:files:begin/,/mooi:files:end/d' "$out"
                else
                    sed -i '/mooi:files:begin/d; /mooi:files:end/d' "$out"
                fi
            fi
        elif [ -n "$(get "gtk${v}_matugen")$(get "gtk${v}_backup")$(get "gtk${v}_made")" ]; then
            if [ "$(get "gtk${v}_matugen")" = yes ]; then
                orig=$(get "gtk${v}_mt_line")
                if [ -n "$orig" ]; then
                    orig_re=$(printf '%s\n' "$orig" | sed 's/[\\&|]/\\&/g')
                    sed -i "s|^output_path[[:space:]]*=[[:space:]]*\".*/matugen-gtk-$v\.0\.css\".*|$orig_re|" "$mt"
                else
                    sed -i "s|^output_path = \"~/.cache/mooi/matugen-gtk-$v.0.css\".*|output_path = \"~/.config/gtk-$v.0/gtk.css\"|" "$mt"
                fi
                if [ -f "$shadow" ]; then cp "$shadow" "$out"; else rm -f "$out"; fi
            elif [ -n "$(get "gtk${v}_backup")" ]; then
                cp "$folder/apps-gtk-$v.0.backup.css" "$out"
            else rm -f "$out"; fi
            put "gtk${v}_matugen" ""; put "gtk${v}_backup" ""; put "gtk${v}_made" ""; put "gtk${v}_mt_line" ""
            did="$did gtk$v(yours)"
        fi
    done

    for q in qt5ct qt6ct; do
        qc="$C/$q/$q.conf"; mine="$C/$q/colors/mooi.conf"
        if on qt; then
            if [ ! -f "$qc" ]; then
                [ "$q" = qt6ct ] || continue
                mkdir -p "$C/$q"; printf '[Appearance]\ncustom_palette=true\ncolor_scheme_path=\nstyle=Fusion\n' > "$qc"; put qt6ct_made yes
            fi
            mkdir -p "$C/$q/colors"; render "$apps_dir/qt5ct.conf" "$mine"
            cur=$(sed -n 's/^color_scheme_path=//p' "$qc" | head -1)
            if [ "$cur" != "$mine" ]; then
                [ -n "$(get "${q}_was")" ] || put "${q}_was" "${cur:--}"
                if grep -q '^color_scheme_path=' "$qc"; then sed -i "s|^color_scheme_path=.*|color_scheme_path=$mine|" "$qc"
                else sed -i "/^\[Appearance\]/a color_scheme_path=$mine" "$qc"; fi
            fi
            # A scheme is only used when custom_palette is on, and a qt5ct.conf may not carry
            # the key at all: add it, and remember that it was absent ("-") so the switch off
            # removes it again instead of leaving a setting mooi made behind.
            if ! grep -q '^custom_palette=true' "$qc"; then
                had=$(sed -n 's/^custom_palette=//p' "$qc" | head -1)
                [ -n "$(get "${q}_palette")" ] || put "${q}_palette" "${had:--}"
                if grep -q '^custom_palette=' "$qc"; then sed -i 's/^custom_palette=.*/custom_palette=true/' "$qc"
                else sed -i '/^\[Appearance\]/a custom_palette=true' "$qc"; fi
            fi
            did="$did $q"
        elif [ -n "$(get "${q}_was")$(get "${q}_palette")" ]; then
            if [ "$q" = qt6ct ] && [ "$(get qt6ct_made)" = yes ]; then
                rm -f "$qc" "$mine"; rmdir "$C/$q/colors" "$C/$q" 2>/dev/null; put qt6ct_made ""
            elif [ -f "$qc" ]; then
                was=$(get "${q}_was")
                if [ -n "$was" ]; then [ "$was" = "-" ] && was=""; sed -i "s|^color_scheme_path=.*|color_scheme_path=$was|" "$qc"; fi
                pal=$(get "${q}_palette")
                if [ "$pal" = "-" ]; then sed -i '/^custom_palette=/d' "$qc"
                elif [ -n "$pal" ]; then sed -i "s/^custom_palette=.*/custom_palette=$pal/" "$qc"; fi
            fi
            put "${q}_was" ""; put "${q}_palette" ""; did="$did $q(yours)"
        fi
    done
    # Day and night for the toolkits themselves (D91): the theme and icons that take mooi's colours
    # in the mode the bar is in (apps.json `mode`) — adw-gtk3 is the GTK 3 theme that reads the
    # palette above (WhiteSur and stock Adwaita hardcode their own), Papirus for GTK, Qt and KDE
    # alike, and the desktop's light/dark preference, which GTK 4, libadwaita and browsers follow
    # through the portal. What was there before is kept once in apps.state and put back on off.
    mode=$(jq -r '.mode // "dark"' "$j")
    if [ "$mode" = light ]; then gt=adw-gtk3; ic=Papirus-Light; cs=prefer-light; pd=0
    else gt=adw-gtk3-dark; ic=Papirus-Dark; cs=prefer-dark; pd=1; fi
    # Folder icons are Papirus recoloured to the palette (matugen/apply-icons.sh), but only while
    # the Files switch is on; off leaves the icon theme with the plain Papirus variant.
    if [ "$files_on" = true ] && [ -f "${XDG_DATA_HOME:-$HOME/.local/share}/icons/Papirus-Mooi/index.theme" ]; then ic=Papirus-Mooi; fi
    gs() { command -v gsettings >/dev/null 2>&1 && gsettings "$@" 2>/dev/null; }
    ini() { # file key value — set it in [Settings], adding the key if it is missing
        [ -f "$1" ] || return 0
        if grep -q "^$2=" "$1"; then sed -i "s|^$2=.*|$2=$3|" "$1"; else sed -i "/^\[Settings\]/a $2=$3" "$1"; fi
    }
    if on gtk; then
        [ -n "$(get gtk_look_was)" ] || put gtk_look_was "$(gs get org.gnome.desktop.interface gtk-theme | tr -d "'")|$(gs get org.gnome.desktop.interface icon-theme | tr -d "'")|$(gs get org.gnome.desktop.interface color-scheme | tr -d "'")"
        if [ "$(gs get org.gnome.desktop.interface gtk-theme | tr -d "'")" != "$gt" ] || [ "$(gs get org.gnome.desktop.interface color-scheme | tr -d "'")" != "$cs" ] \
           || [ "$(gs get org.gnome.desktop.interface icon-theme | tr -d "'")" != "$ic" ]; then
            gs set org.gnome.desktop.interface gtk-theme "$gt"
            gs set org.gnome.desktop.interface icon-theme "$ic"
            gs set org.gnome.desktop.interface color-scheme "$cs"
            did="$did gtk-$mode"
        fi
        for v in 3 4; do
            ini "$C/gtk-$v.0/settings.ini" gtk-theme-name "$gt"
            ini "$C/gtk-$v.0/settings.ini" gtk-icon-theme-name "$ic"
            ini "$C/gtk-$v.0/settings.ini" gtk-application-prefer-dark-theme "$pd"
        done
    elif [ -n "$(get gtk_look_was)" ]; then
        IFS='|' read -r wt wi wc <<EOF2
$(get gtk_look_was)
EOF2
        [ -n "$wt" ] && gs set org.gnome.desktop.interface gtk-theme "$wt"
        [ -n "$wi" ] && gs set org.gnome.desktop.interface icon-theme "$wi"
        [ -n "$wc" ] && gs set org.gnome.desktop.interface color-scheme "$wc"
        put gtk_look_was ""; did="$did gtk-look(yours)"
    fi
    kg="$C/kdeglobals"; kscheme="${XDG_DATA_HOME:-$HOME/.local/share}/color-schemes/Mooi.colors"
    if on qt; then
        for q in qt5ct qt6ct; do
            qc="$C/$q/$q.conf"; [ -f "$qc" ] || continue
            if grep -q '^icon_theme=' "$qc"; then sed -i "s|^icon_theme=.*|icon_theme=$ic|" "$qc"
            else sed -i "/^\[Appearance\]/a icon_theme=$ic" "$qc"; fi
        done
        # KDE apps (Dolphin, Kate, Okular…) read their colours from kdeglobals, not from qt6ct:
        # the scheme is rendered, and its colour groups are copied in; every other setting stays.
        mkdir -p "$(dirname "$kscheme")"; render "$apps_dir/kde.colors" "$kscheme"
        if [ -f "$kg" ] && [ -z "$(get kde_backup)" ]; then cp "$kg" "$folder/apps-kdeglobals.backup"; put kde_backup yes; fi
        [ -f "$kg" ] || { : > "$kg"; [ -n "$(get kde_backup)" ] || put kde_backup made; }
        python3 - "$kscheme" "$kg" "$ic" <<'PY' && did="$did kde"
import configparser, sys
src, dst, icons = sys.argv[1:4]
def load(p):
    cp = configparser.RawConfigParser(strict=False, interpolation=None)
    cp.optionxform = str
    cp.read(p)
    return cp
s, d = load(src), load(dst)
for sec in s.sections():
    if sec.startswith("Colors:") or sec == "WM":
        if not d.has_section(sec): d.add_section(sec)
        for k, v in s.items(sec): d.set(sec, k, v)
for sec, k, v in (("General", "ColorScheme", "Mooi"), ("Icons", "Theme", icons)):
    if not d.has_section(sec): d.add_section(sec)
    d.set(sec, k, v)
with open(dst, "w") as f: d.write(f, space_around_delimiters=False)
PY
        # A KDE app can keep a colour scheme of its own (Settings → Colour scheme, [UiSettings] in its
        # rc), which wins over kdeglobals — Dolphin was still on ArchEclipse's dark one. Each is
        # cleared so the app follows the desktop, and what it was is kept to put back.
        command -v kreadconfig6 >/dev/null 2>&1 && for rc in "$C"/*rc; do
            [ -f "$rc" ] || continue
            cur=$(kreadconfig6 --file "$rc" --group UiSettings --key ColorScheme 2>/dev/null)
            [ -n "$cur" ] || continue
            put kde_app_was "$(get kde_app_was)$(basename "$rc")=$cur;"
            kwriteconfig6 --file "$rc" --group UiSettings --key ColorScheme "" && did="$did $(basename "$rc")"
        done
    elif [ -n "$(get kde_backup)" ]; then
        printf '%s' "$(get kde_app_was)" | tr ';' '\n' | while IFS='=' read -r rcf val; do
            [ -n "$rcf" ] && kwriteconfig6 --file "$C/$rcf" --group UiSettings --key ColorScheme "$val"
        done
        put kde_app_was ""
        if [ "$(get kde_backup)" = made ]; then rm -f "$kg"; else cp "$folder/apps-kdeglobals.backup" "$kg"; fi
        rm -f "$kscheme"; put kde_backup ""; did="$did kde(yours)"
    fi
    [ -n "$did" ] && echo "apps:$did"
    return 0
}

# ── Kitty's own screen shaders (D159, kitty ≥ 0.49) ──
# `custom_shaders` in kitty.conf names a pipeline: one kitty ships (crt, tft, dim-inactive-windows…),
# or one of your own — a name under ~/.config/kitty/shaders/, or a path. mooi never edits your
# kitty.conf in place: it writes one small file beside the settings and points kitty.conf at it with
# a single `include` line at the end, so mooi's choice is the one kitty ends up with and your own
# lines stay where they are. kitty reads its config again on SIGUSR1, which is how a change lands in
# the windows already open. The switch off takes exactly the file and the include away again.
kitty_conf_dir="${XDG_CONFIG_HOME:-$HOME/.config}/kitty"
kitty_shaders_sync() {
    [ -f "$settings" ] && command -v jq >/dev/null 2>&1 || return 0
    kc="$kitty_conf_dir/kitty.conf"
    conf="$folder/kitty-shaders.conf"
    pipe="$folder/kitty-mooi-crt.pipeline"   # mooi's own pipeline: kitty's crt in the bar's colour
    inc="include $conf"
    on=$(jq -r '.desktop.kitty_shader_on // false' "$settings" 2>/dev/null)
    # mooi's include line, wherever it is: every other line of kitty.conf is left exactly as it was
    kitty_drop_inc() {
        [ -f "$kc" ] || return 0
        grep -qF "$inc" "$kc" || return 0
        grep -vF "$inc" "$kc" > "$kc.mooi-tmp" && mv "$kc.mooi-tmp" "$kc"
    }
    if [ "$on" != true ]; then
        if [ -f "$conf" ] || { [ -f "$kc" ] && grep -qF "$inc" "$kc"; }; then
            kitty_drop_inc
            rm -f "$conf" "$pipe"
            pkill -USR1 -x kitty 2>/dev/null || :
            echo "kitty: your own shaders again"
        fi
        return 0
    fi
    kind=$(jq -r '.desktop.kitty_shader // "crt"' "$settings" 2>/dev/null)
    wantpipe=""; shown=$kind
    if [ "$kind" = custom ]; then
        name=$(jq -r '.desktop.kitty_shader_custom // ""' "$settings" 2>/dev/null)
        [ -n "$name" ] || { echo "kitty-shaders: Mine is chosen but no pipeline is named (Settings → Windows → Kitty screen shaders)" >&2; return 1; }
        # one option value and nothing else: no spaces (that is two shaders), no quote or # to end the line
        case "$name" in
            ''|*[!A-Za-z0-9._/~-]*) echo "kitty-shaders: a pipeline name cannot hold spaces, quotes or #: $name" >&2; return 1 ;;
        esac
        shown=$name
    elif [ "$kind" = mooi-crt ]; then
        # kitty's crt, tinted with a colour from the bar's palette (palette.json): a pipeline of
        # mooi's, so the CRT follows the wallpaper. TINT is a multiplier in linear RGB, so the
        # colour is scaled until its brightest channel is 1 (a normalised tint leaves the screen as
        # bright as kitty's own), and the alpha is how much of it is laid over the picture.
        cname=$(jq -r '.desktop.kitty_shader_colour // "primary"' "$settings" 2>/dev/null)
        case "$cname" in ''|*[!a-z_]*) cname=primary ;; esac
        phex=$(jq -r --arg c "$cname" '.colours[$c] // ""' "$palette" 2>/dev/null)
        [ -n "$phex" ] || phex=$(jq -r '.colours.primary // ""' "$palette" 2>/dev/null)
        case "$phex" in
            \#[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]) ;;
            *) phex="" ;;
        esac
        if [ -z "$phex" ]; then
            echo "kitty-shaders: no palette yet; wearing kitty's own crt until the bar has one" >&2
            name=crt; shown=crt
        else
            h=${phex#\#}
            r=$((0x$(printf '%s' "$h" | cut -c1-2)))
            g=$((0x$(printf '%s' "$h" | cut -c3-4)))
            b=$((0x$(printf '%s' "$h" | cut -c5-6)))
            tint=$(awk -v r="$r" -v g="$g" -v b="$b" 'function lin(v, c) { c = v / 255; return (c <= 0.04045) ? c / 12.92 : ((c + 0.055) / 1.055) ^ 2.4 }
                BEGIN { R = lin(r); G = lin(g); B = lin(b); m = R; if (G > m) m = G; if (B > m) m = B; if (m <= 0) m = 1
                        printf "%.6f, %.6f, %.6f", R / m, G / m, B / m }')
            # how much of it is laid on (Settings → Windows → Tint), 0–100 % as the shader's alpha
            tstr=$(jq -r '.desktop.kitty_shader_tint // 55' "$settings" 2>/dev/null)
            case "$tstr" in ''|*[!0-9]*) tstr=55 ;; esac
            if [ "$tstr" -gt 100 ]; then tstr=100; fi
            alpha=$(awk -v a="$tstr" 'BEGIN { printf "%.2f", a / 100 }')
            case "$pipe" in
                *[[:space:]]*) echo "kitty-shaders: mooi's folder has a space in it; kitty cannot be pointed at the pipeline" >&2; return 1 ;;
            esac
            wantpipe="# mooi · kitty's crt in the bar's $cname ($phex), from Settings → Windows.
# Written by mooi kitty-shaders out of palette.json, so it follows the wallpaper's palette.
# The tint is linear RGB, normalised so its brightest channel is 1; the last number is how much
# of it is laid on (desktop.kitty_shader_tint, ${tstr}% now).
var float4 TINT = float4($tint, $alpha)

startgroup
    shaders crt
endgroup"
            name=$pipe; shown="mooi-crt ($cname $phex, ${tstr}%)"
        fi
    else
        name=$kind
        case "$name" in
            ''|*[!A-Za-z0-9._/~-]*) echo "kitty-shaders: a pipeline name cannot hold spaces, quotes or #: $name" >&2; return 1 ;;
        esac
    fi
    if [ ! -f "$kc" ]; then
        echo "kitty-shaders: no $kc; nothing to point at it" >&2
        return 1
    fi
    want="# mooi · kitty's own screen shaders (kitty ≥ 0.49), from Settings → Windows.
# Written by mooi kitty-shaders; turning the switch off removes it and its include.
# Your own lines in kitty.conf are untouched.
custom_shaders $name"
    changed=false
    [ "$(cat "$conf" 2>/dev/null)" = "$want" ] || changed=true
    if [ -n "$wantpipe" ]; then
        [ "$(cat "$pipe" 2>/dev/null)" = "$wantpipe" ] || changed=true
    elif [ -f "$pipe" ]; then
        rm -f "$pipe"; changed=true                 # another shader is chosen: mooi's pipeline goes
    fi
    if [ "$(grep -cF "$inc" "$kc" 2>/dev/null)" != 1 ] || [ "$(tail -n 1 "$kc")" != "$inc" ]; then changed=true; fi
    if [ "$changed" = true ]; then
        mkdir -p "$folder"
        if [ -n "$wantpipe" ]; then
            printf '%s\n' "$wantpipe" > "$pipe.mooi-tmp" && mv "$pipe.mooi-tmp" "$pipe" || return 1
        fi
        printf '%s\n' "$want" > "$conf.mooi-tmp" && mv "$conf.mooi-tmp" "$conf" || return 1
        kitty_drop_inc
        printf '%s\n' "$inc" >> "$kc" || return 1
        pkill -USR1 -x kitty 2>/dev/null || :
        echo "kitty: custom_shaders $shown"
    fi
    return 0
}

# Follow the wallpaper. `mooi session` runs this beside the bar and `mooi
# stop` ends it; on its own it is a foreground loop, so a session can also run it from a
# service of its own. Two waits: inotify where it exists (the symlink is replaced, so the
# event is moved_to or create), and the link's own target where it does not.
theme_watch() {
    exec 8>"$theme_watch_lock"
    flock -n 8 2>/dev/null || { echo "mooi-theme-watch: already running" >&2; exit 1; }
    echo $$ > "$theme_pid"
    # The lock file is never removed: removed-and-recreated, two watchers would hold two
    # different files and neither would know about the other.
    trap 'rm -f "$theme_pid"; exit 0' TERM INT HUP
    dir=$(dirname "$wallpaper")
    was=$(readlink -f "$wallpaper" 2>/dev/null)
    # The wallpaper may have changed while mooi was down, which is the one case a watcher
    # cannot see: the palette records the image it came from, so a different one now means the
    # colours on screen are the last wallpaper's and are recoloured before anything is watched.
    if [ ! -e "$palette" ] || [ "$(cat "$from" 2>/dev/null)" != "$was $(extraction)" ]; then
        # Pass the current wallpaper path so theme_sync reads the symlink at call time
        said=$(theme_sync "$wallpaper" 2>&1) || :
        [ -n "$said" ] && echo "$(date +%T) $said (the wallpaper changed while mooi was down)"
    fi
    resync() {   # one recolour, and one line about it: the watch log is what a session reads
        said=$(theme_sync "$wallpaper" 2>&1) || :
        [ -n "$said" ] && echo "$(date +%T) $said"
        return 0
    }
    # Every wake-up — an event in the folder, or five seconds of quiet — asks the one question
    # that matters: is the wallpaper (its target and its modification time) still the one the
    # palette came from? Matching file names in the event stream missed changes: ~/.cache is
    # busy, and a change landing while the loop slept after somebody else's event was lost
    # (found 2026-10-19). `-t 5` and no `-m`: a monitor that never returns would block the
    # trap, which is how a `mooi stop` once left a watcher behind (2026-10-16).
    # How the palette is extracted is part of the question: changed from the settings window,
    # it is re-extracted here too, so this watch is the one writer of the palette while mooi
    # runs under the keeper (shell/mooi.luau leaves `extract` to it).
    key() { t=$(readlink -f "$wallpaper" 2>/dev/null) && echo "$t $(stat -L -c %Y "$wallpaper" 2>/dev/null) $(extraction)"; }
    seen=$(key)
    apps_key() { cksum "$folder/apps.json" 2>/dev/null; }
    apps_seen=""
    motion_key() { jq -c '[.motion.speed, .motion.reduced]' "$settings" 2>/dev/null; }
    motion_seen=$(motion_key)
    # the colour the tint is drawn from is part of the question too: Mooi CRT is rendered from that
    # palette role, so a recoloured desk re-tints the terminal (the palette is watched in this folder)
    kitty_key() {
        _kc=$(jq -r '.desktop.kitty_shader_colour // "primary"' "$settings" 2>/dev/null)
        _kh=$(jq -r --arg c "$_kc" '.colours[$c] // ""' "$palette" 2>/dev/null)
        printf '%s|%s|%s' "$(jq -c '[.desktop.kitty_shader_on, .desktop.kitty_shader, .desktop.kitty_shader_custom, .desktop.kitty_shader_tint]' "$settings" 2>/dev/null)" "$_kc" "$_kh"
    }
    kitty_seen=$(kitty_key)
    # what a session starts with: the shader kitty should be reading now (quiet when it already is)
    said=$(kitty_shaders_sync 2>&1) || :
    [ -n "$said" ] && echo "$(date +%T) $said"
    while :; do
        if command -v inotifywait >/dev/null 2>&1; then
            # `8>&-`: the lock is the watcher's, not its child's — an inotifywait left over from
            # a killed watcher would otherwise hold it for up to 5 s and turn the next one away.
            # The visualizer feed (shell/lib/vizfeed.luau) is rewritten 30 times a second while
            # music plays, in this same folder: left in, it woke this loop 30×/s and its checks
            # cost ~60% of a core (measured 2026-11-02). Nothing here reads it. Nor the v2 feed (D138): it
            # was not excluded, and woke the watch 30 times a second with music (2.5 % of a core, D154).
            inotifywait -q -t 5 --exclude 'viz-levels(-v2)?\.txt' -e moved_to -e create -e close_write -e attrib -e delete_self "$dir" "$folder" >/dev/null 2>&1 8>&- || :
        else
            sleep 2
        fi
        now=$(key)
        if [ -n "$now" ] && [ "$now" != "$seen" ]; then
            # A link swapped is complete the moment it is seen; an image being written in
            # place is not, so only a link that points at a file still growing waits.
            [ -L "$wallpaper" ] || sleep 0.15
            # what was extracted is what was read before it: a change made while Matugen ran (dark
            # pressed during a light extraction, 2026-11-07) is seen on the next wake and done too,
            # where reading the key again after resync took it as done and kept the light palette
            resync; seen=$now
        fi
        # the pace or reduced motion changed: a new live copy, and the keeper brings the scene back
        m=$(motion_key)
        if [ -n "$m" ] && [ "$m" != "$motion_seen" ]; then
            motion_seen=$m
            if [ -n "$(scene_pids)" ] && snapshot; then
                for p in $(scene_pids); do kill -TERM "$p" 2>/dev/null; done
                echo "$(date +%T) motion $m: the bar restarted to move at that pace"
            fi
        fi
        # the bar wrote its palette for your apps again (a new palette, or a switch turned)
        a=$(apps_key)
        if [ -n "$a" ] && [ "$a" != "$apps_seen" ]; then
            apps_seen=$a
            said=$(apps_sync 2>&1) || :
            [ -n "$said" ] && echo "$(date +%T) $said"
        fi
        # kitty's own screen shader: another pipeline, or the switch turned, in the settings file
        kt=$(kitty_key)
        if [ -n "$kt" ] && [ "$kt" != "$kitty_seen" ]; then
            kitty_seen=$kt
            said=$(kitty_shaders_sync 2>&1) || :
            [ -n "$said" ] && echo "$(date +%T) $said"
        fi
    done
}

# ── Wallpapers (D145): mooi draws them all ──
# mooi-desk draws the picture (a still, or an animated GIF/WebP/PNG, which Pleamar plays itself) and
# its transition; a video is mpvpaper's, on the background layer, the desk drawing a frame of it until
# mpvpaper is up and then stepping aside. `wall_apply` is the one way a wallpaper is worn — the notch,
# the picker (mooi-walls) and `mooi wall apply` all come here:
#   wall.json beside the settings   what the desk draws (it watches the file): the file, its still,
#                                   its kind, the transition and where a growing circle starts
#   ~/.cache/current_wallpaper_source → the file, ~/.cache/current_wallpaper → its still
#                                   (lock screens read these; the theme watch recolours from the still)
walls_cache="$HOME/.cache/mooi/walls"
mpv_pid="$rt/mpvpaper.pid"
wall_kind() {
    ext=$(printf '%s' "${1##*.}" | tr '[:upper:]' '[:lower:]')
    case "$ext" in
        mp4|webm|mkv|mov|m4v|avi) echo video ;;
        gif|apng) echo animated ;;
        jpg|jpeg|png|webp|avif|jxl|bmp) echo still ;;
        *) return 1 ;;
    esac
}
# A frame a second into a video (or its first), full size, kept by the file's name and age.
wall_still() {
    key=$(printf '%s %s' "$1" "$(stat -c %Y "$1" 2>/dev/null)" | cksum | cut -d' ' -f1)
    out="$walls_cache/stills/v-$key.jpg"
    [ -s "$out" ] && { echo "$out"; return 0; }
    mkdir -p "$walls_cache/stills"
    for at in 1 0; do
        ffmpeg -v error -y -ss "$at" -i "$1" -frames:v 1 -q:v 2 "$out" </dev/null >/dev/null 2>&1 && [ -s "$out" ] && { echo "$out"; return 0; }
    done
    return 1
}
mpv_running() { p=$(cat "$mpv_pid" 2>/dev/null) && alive "$p" && tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null | grep -q "mpvpaper"; }
mpv_playing() { mpv_running && tr '\0' '\n' < "/proc/$(cat "$mpv_pid")/cmdline" | tail -n 1 | grep -qxF "$1"; }
wall_live_stop() {
    if mpv_running; then kill "$(cat "$mpv_pid")" 2>/dev/null; fi
    rm -f "$mpv_pid"
    # one mpvpaper ever: a stray (started by hand, or by an older mooi) goes too
    pkill -u "$(id -u)" -x mpvpaper 2>/dev/null || :
    "$pleamar" --say mooi-desk "emit live_on 0" >/dev/null 2>&1 || :
}
# mpvpaper as wall.json says: playing that video, or not at all. The desk is told once it is up.
wall_live() {
    src=$(jq -r 'if .kind == "video" then .source else "" end' "$folder/wall.json" 2>/dev/null)
    if [ -z "$src" ] || [ ! -f "$src" ]; then wall_live_stop; return 0; fi
    if mpv_playing "$src"; then "$pleamar" --say mooi-desk "emit live_on 1" >/dev/null 2>&1 || :; return 0; fi
    command -v mpvpaper >/dev/null 2>&1 || { echo "mpvpaper is not installed: the video's still stays" >&2; return 1; }
    wall_live_stop
    setsid mpvpaper -p -o "no-audio loop hwdec=auto panscan=1.0 really-quiet load-scripts=no" '*' "$src" </dev/null >/dev/null 2>&1 &
    echo $! > "$mpv_pid"
    # no scripts: mpv's MPRIS script would make the wallpaper the "song playing" in the bar and BMO
    # it has a surface a moment after it starts; the desk fades its still out once it has
    sleep 0.6
    if mpv_running; then "$pleamar" --say mooi-desk "emit live_on 1" >/dev/null 2>&1 || :
    else rm -f "$mpv_pid"; echo "mpvpaper ended at once: the video's still stays" >&2; return 1; fi
}
wall_apply() { # FILE [--from-y N] [--transition KIND]
    file=$(readlink -f "${1:-}" 2>/dev/null); shift || :
    [ -n "$file" ] && [ -f "$file" ] || { echo "wall: no file at ${file:-(none given)}" >&2; return 1; }
    kind=$(wall_kind "$file") || { echo "wall: not a picture or a video: $file" >&2; return 1; }
    from_y=null; tr=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --from-y) from_y=$(printf '%d' "${2:-0}" 2>/dev/null || echo null); shift 2 ;;
            --transition) tr=${2:-}; shift 2 ;;
            *) shift ;;
        esac
    done
    still=$file
    if [ "$kind" = video ]; then still=$(wall_still "$file") || { echo "wall: ffmpeg could not read a frame of $file" >&2; return 1; }; fi
    command -v jq >/dev/null 2>&1 || { echo "wall: jq is needed" >&2; return 1; }
    mkdir -p "$folder"
    jq -n --arg s "$file" --arg t "$still" --arg k "$kind" --arg tr "$tr" --argjson fy "$from_y" --argjson at "$(date +%s)" \
        '{source: $s, still: $t, kind: $k, transition: $tr, from_y: $fy, at: $at}' > "$folder/wall.json.tmp" \
        && mv "$folder/wall.json.tmp" "$folder/wall.json" || return 1
    # the desk has the new state; a video playing goes once the desk shows its still again (its
    # transition starts from that), and the links change, which the theme watch recolours from
    if [ "$kind" != video ] || ! mpv_playing "$file"; then (sleep 0.15; wall_live_stop) </dev/null >/dev/null 2>&1 & fi
    ln -sfn "$file" "$HOME/.cache/current_wallpaper_source"
    ln -sfn "$still" "$HOME/.cache/current_wallpaper"
    if [ "$kind" = video ]; then (sleep 1.2; wall_live) </dev/null >/dev/null 2>&1 & fi
    echo "wearing $(basename "$file") ($kind)"
}
# ── Wallhaven (D147): searched with your settings, saved into your first folder, worn ──
# The API key (for sketchy/NSFW and your account's own filters) is mooi's data folder
# (wallhaven.key, mode 0600), with ~/.config/mooi/wallhaven.key read as a fallback; never in the
# settings or the repo. It goes to curl as a header on stdin, so it is never in a process list.
# Every URL is checked to be on Wallhaven's own hosts, every id to be letters and digits.
# the key Settings → Wallpapers saves (mooi's data folder, 0600), or one put there by hand
wh_keyfile="$folder/wallhaven.key"
[ -s "$wh_keyfile" ] || wh_keyfile="${XDG_CONFIG_HOME:-$HOME/.config}/mooi/wallhaven.key"
wh_cache="$walls_cache/wh"
wh_key_ok() { [ -s "$wh_keyfile" ] && [ "$(stat -c %a "$wh_keyfile" 2>/dev/null)" = 600 ]; }
wh_curl() { # URL [curl options…] — with the key's header when there is one
    url=$1; shift
    case "$url" in https://wallhaven.cc/api/*|https://w.wallhaven.cc/*|https://th.wallhaven.cc/*) ;; *) echo "wallhaven: not a Wallhaven URL" >&2; return 1 ;; esac
    case "$url" in *[[:space:]\"\'\`\$]*) echo "wallhaven: a URL with odd characters" >&2; return 1 ;; esac
    if wh_key_ok; then
        printf 'X-API-Key: %s\n' "$(head -c 200 "$wh_keyfile" | tr -d '[:space:]')" | curl -fsSL --max-time 20 -H @- "$@" "$url"
    else
        curl -fsSL --max-time 20 "$@" "$url"
    fi
}
wh_search_url() { # SORTING RANGE PAGE [QUERY] [COLOUR] [SEED]
    sorting=$1; range=$2; page=$3; q=${4:-}; colour=${5:-}; seed=${6:-}
    cats=$(jq -r '.wallhaven.categories // "general+anime"' "$settings" 2>/dev/null)
    case "$cats" in general) c=100 ;; anime) c=010 ;; people) c=001 ;; general+people) c=101 ;; anime+people) c=011 ;; all) c=111 ;; *) c=110 ;; esac
    pur=$(jq -r '.wallhaven.purity // "sfw"' "$settings" 2>/dev/null)
    case "$pur" in sfw+sketchy) p=110 ;; sketchy) p=010 ;; nsfw) p=001 ;; all) p=111 ;; *) p=100 ;; esac
    wh_key_ok || p=100                  # without your key, safe for work whatever the setting says
    case "$sorting" in toplist|hot|date_added|random) ;; *) sorting=toplist ;; esac
    case "$range" in 1d|3d|1w|1M|3M|6M|1y) ;; *) range=1M ;; esac
    u="https://wallhaven.cc/api/v1/search?sorting=$sorting&categories=$c&purity=$p&page=$(printf '%d' "$page" 2>/dev/null || echo 1)"
    [ "$sorting" = toplist ] && u="$u&topRange=$range"
    size=$(hyprctl monitors -j 2>/dev/null | jq -r '.[0] | "\(.width)x\(.height)"' 2>/dev/null); [ -n "$size" ] && [ "$size" != nullxnull ] || size=1920x1080
    case "$(jq -r '.wallhaven.atleast // "screen"' "$settings" 2>/dev/null)" in screen) u="$u&atleast=$size" ;; 4k) u="$u&atleast=3840x2160" ;; esac
    if [ "$(jq -r '.wallhaven.ratio // "screen"' "$settings" 2>/dev/null)" = screen ]; then
        w=${size%x*}; h=${size#*x}
        r=$(awk -v w="$w" -v h="$h" 'BEGIN { split("16x9 16x10 21x9 32x9 4x3 5x4 3x2", R, " "); want = w / h; best = "16x9"; gap = 99
            for (i in R) { split(R[i], a, "x"); d = a[1] / a[2] - want; if (d < 0) d = -d; if (d < gap) { gap = d; best = R[i] } } print best }')
        u="$u&ratios=$r"
    fi
    case "$colour" in ''|*[!0-9a-f]*) ;; *) u="$u&colors=$colour" ;; esac
    case "$seed" in ''|*[!0-9A-Za-z]*) ;; *) u="$u&seed=$seed" ;; esac
    if [ -n "$q" ]; then u="$u&q=$(printf '%s' "$q" | head -c 80 | jq -sRr @uri)"; fi
    echo "$u"
}
wall_wallhaven() { # search SORTING RANGE PAGE [Q] [COLOUR] [SEED] | thumb ID URL | wear ID URL | random
    sub=${1:-}; shift || :
    case "$sub" in
        search) wh_curl "$(wh_search_url "$@")" ;;
        thumb)  # a thumbnail, kept: prints where it is
            id=$1; url=$2
            case "$id" in ''|*[!0-9A-Za-z]*) return 1 ;; esac
            out="$wh_cache/$id.jpg"; mkdir -p "$wh_cache"
            [ -s "$out" ] || { wh_curl "$url" -o "$out.part" && mv "$out.part" "$out"; } || { rm -f "$out.part"; return 1; }
            echo "$out" ;;
        wear)   # the full picture, saved into your first folder as wallhaven-ID.ext (kept), then worn
            id=$1; url=$2
            case "$id" in ''|*[!0-9A-Za-z]*) return 1 ;; esac
            ext=${url##*.}; case "$ext" in jpg|jpeg|png|webp) ;; *) ext=jpg ;; esac
            dir=$(jq -r '(.walls.folders // ["~/Pictures/wallpapers"])[0] | sub("^~"; env.HOME)' "$settings" 2>/dev/null)
            [ -n "$dir" ] || dir="$HOME/Pictures/wallpapers"
            mkdir -p "$dir"; out="$dir/wallhaven-$id.$ext"
            [ -s "$out" ] || { wh_curl "$url" -o "$out.part" && mv "$out.part" "$out"; } || { rm -f "$out.part"; echo "wallhaven: could not fetch $id" >&2; return 1; }
            shift 2; wall_apply "$out" "$@"
            (wall_index) </dev/null >/dev/null 2>&1 & ;;
        random) # one at random with your settings (the auto-change)
            doc=$(wh_curl "$(wh_search_url random 1M 1)") || return 1
            line=$(printf '%s' "$doc" | jq -r '.data[] | select(.id | test("^[0-9A-Za-z]+$")) | select(.path | startswith("https://w.wallhaven.cc/")) | "\(.id) \(.path)"' | head -n 1)
            [ -n "$line" ] || { echo "wallhaven: nothing found" >&2; return 1; }
            wall_wallhaven wear ${line} ;;
        *) echo "usage: mooi wall wallhaven search SORTING RANGE PAGE [Q] [COLOUR] [SEED] | thumb ID URL | wear ID URL | random" >&2; return 2 ;;
    esac
}

# A wallpaper at random (the auto-change, D147, and `mooi wall next`): from all, pictures, live, the
# colour chosen last in the picker (walls-state.json: its chip and lightness), or Wallhaven; never the
# one worn now.
wall_next() { # [all|pictures|live|colour|wallhaven] [--dry: say which, wear nothing]
    dry=false; [ "${2:-}" = --dry ] && dry=true
    from=${1:-$(jq -r '.walls.auto_from // "pictures"' "$settings" 2>/dev/null)}
    [ "$from" = wallhaven ] && { wall_wallhaven random; return $?; }
    idx="$folder/walls-index.json"
    [ -f "$idx" ] || { echo "wall: no index yet (mooi wall index)" >&2; return 1; }
    now=$(jq -r '.source // ""' "$folder/wall.json" 2>/dev/null)
    chip=-1; light=0
    if [ "$from" = colour ]; then
        chip=$(jq -r '.chip // -1' "$folder/walls-state.json" 2>/dev/null || echo -1)
        light=$(jq -r '.light // 0' "$folder/walls-state.json" 2>/dev/null || echo 0)
    fi
    pick=$(jq -r --arg from "$from" --arg now "$now" --argjson chip "$chip" --argjson light "$light" '
        def live: .kind == "video" or .kind == "animated";
        def chipof: if .grey then 24 else (((.hue + 7.5) % 360) / 15 | floor) end;
        .items[] | select(.path != $now)
        | select(if $from == "pictures" then (live | not) elif $from == "live" then live else true end)
        | select($chip < 0 or chipof == $chip)
        | select($light == 0 or ($light == 1 and .luma > 0.55) or ($light == 2 and .luma < 0.4))
        | .path' "$idx" | shuf -n 1)
    [ -n "$pick" ] || { echo "wall: nothing to change to from $from" >&2; return 1; }
    if $dry; then echo "$pick"; return 0; fi
    wall_apply "$pick"
}
wall_index() {
    dirs=$(jq -r '(.walls.folders // ["~/Pictures/wallpapers", "~/Pictures/livewalls"])[] | sub("^~"; env.HOME)' "$settings" 2>/dev/null) \
        || dirs="$HOME/Pictures/wallpapers
$HOME/Pictures/livewalls"
    mkdir -p "$walls_cache"
    # shellcheck disable=SC2086
    IFS='
' ; set -- $dirs; unset IFS
    MOOI_ORBIT_DOT=$(jq -r '.walls.dots // 5' "$settings" 2>/dev/null || echo 5) \
        nice -n 19 python3 "$root/tools/wallindex.py" "$walls_cache" "$folder" "$folder/wallpaper-hues.json" "$@"
}

# The **lock** is the truth about a watcher and the pid file is how it is signalled: a watcher
# killed outright cannot clean up after itself, so a pid file can outlive its watcher (and a
# watcher can outlive its pid file, which is what a `status` reading the file alone gets wrong).
theme_watch_pid() { cat "$theme_pid" 2>/dev/null; }
theme_watching() {
    exec 7>"$theme_watch_lock" 2>/dev/null || return 1
    if flock -n 7 2>/dev/null; then flock -u 7 2>/dev/null; return 1; fi   # we took it: nobody is watching
    return 0
}
theme_watch_stray() { pgrep -f "[b]in/mooi theme-watch" 2>/dev/null; }
# The workspaces' shader transitions (D158): `mooi ws-fx` listens on Hyprland's event socket and, at each
# workspace change, turns the screen shader mooi wrote (shell/lib/wsfx.luau → ws-fx.glsl, its length in
# ws-fx.ms; empty: none chosen) on for one transition — damage tracking and vfr off with it, since a
# shader's `time` runs only so — then puts all three back as it found them. A screen shader of your own
# (hyprshade's and the like) is never replaced. It starts and stops with the theme watch.
ws_fx() {
    exec 9>"$rt/ws-fx.lock"
    flock -n 9 2>/dev/null || { echo "mooi-ws-fx: already running" >&2; exit 1; }
    local sock="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hypr/${HYPRLAND_INSTANCE_SIGNATURE:-}/.socket2.sock"
    [ -S "$sock" ] || { echo "mooi-ws-fx: no Hyprland event socket" >&2; exit 1; }
    local glsl="$folder/ws-fx.glsl" msf="$folder/ws-fx.ms" off_pid="" flip=a line ms cur
    local dt vfr
    dt=$(hyprctl getoption debug:damage_tracking 2>/dev/null | sed -n 's/^int: //p'); [[ "$dt" =~ ^[0-9]+$ ]] || dt=2
    [ "$dt" = 0 ] && dt=2                       # left off by a watcher that was killed mid-transition
    vfr=$(hyprctl getoption debug:vfr 2>/dev/null | sed -n 's/^bool: //p'); [ "$vfr" = false ] || vfr=true
    local restore="hl.config({ decoration = { screen_shader = \"\" }, debug = { damage_tracking = $dt, vfr = $vfr } })"
    trap '[ -n "$off_pid" ] && kill "$off_pid" 2>/dev/null; hyprctl eval "$restore" >/dev/null 2>&1; exit 0' TERM INT HUP
    case "$(hyprctl getoption decoration:screen_shader 2>/dev/null)" in *"$rt/ws-fx-"*) hyprctl eval "$restore" >/dev/null 2>&1 ;; esac
    while IFS= read -r line; do
        case "$line" in "workspacev2>>"*) ;; *) continue ;; esac
        ms=$(cat "$msf" 2>/dev/null); [[ "$ms" =~ ^[0-9]+$ ]] && [ -s "$glsl" ] || continue
        cur=$(hyprctl getoption decoration:screen_shader 2>/dev/null | sed -n 's/^str: //p')
        case "$cur" in ""|"[[EMPTY]]"|"$rt/ws-fx-"*) ;; *) continue ;; esac
        # a fresh path each time: the same one again would not be compiled again, and `time` restarts at 0
        cp "$glsl" "$rt/ws-fx-$flip.glsl" 2>/dev/null || continue
        [ -n "$off_pid" ] && kill "$off_pid" 2>/dev/null
        hyprctl eval "hl.config({ debug = { damage_tracking = 0, vfr = false }, decoration = { screen_shader = \"$rt/ws-fx-$flip.glsl\" } })" >/dev/null 2>&1
        ( sleep "$(awk -v m="$ms" 'BEGIN { printf "%.3f", m / 1000 + 0.06 }')"; hyprctl eval "$restore" >/dev/null 2>&1 ) &
        off_pid=$!
        [ "$flip" = a ] && flip=b || flip=a
    done < <(socat -U - "UNIX-CONNECT:$sock" 2>/dev/null)
    hyprctl eval "$restore" >/dev/null 2>&1
}
ws_fx_stray() { pgrep -f "[b]in/mooi ws-fx" 2>/dev/null; }
ws_fx_start() { [ -n "$(ws_fx_stray)" ] || setsid -f "$self" ws-fx >> "$state/ws-fx.log" 2>&1 < /dev/null; }
ws_fx_stop() { for p in $(ws_fx_stray); do kill -TERM "$p" 2>/dev/null; done; }
theme_watch_start() { # one watcher, ever: start it, or take over from one that has gone quiet
    ws_fx_start
    if theme_watching; then
        alive "$(theme_watch_pid)" && return 0
        echo "mooi: a theme watch was left behind; replacing it" >&2
        theme_watch_stop
    fi
    setsid -f "$self" theme-watch >> "$state/theme-watch.log" 2>&1 < /dev/null
}
theme_watch_stop() { # TERM, wait for the lock, then insist: the watch must really be gone
    ws_fx_stop
    for p in $(theme_watch_stray); do kill -TERM "$p" 2>/dev/null; done
    wait_for 7 not theme_watching
    for p in $(theme_watch_stray); do kill -KILL "$p" 2>/dev/null; done
    rm -f "$theme_pid"
}
not() { ! "$@"; }
# The running shell is a snapshot of the repo's `shell/`, not the repo itself: pleamar reloads a
# scene whenever its file is saved, so a desktop running the repo reloaded on every edit — half
# a change at a time, logic errors and all (found 2026-10-19, the Atlas "glitch"). `session`
# and `refresh` take a fresh snapshot; nothing else touches it.
# The settings window, the board and the other tools are programs of their own (their .plm
# files) and pleamar gives each the data folder of its file's name: those folders are links to
# mooi's, so they read and write mooi's settings.json, palette.json and
# board.json. Made here, idempotently; a real folder in the way is moved aside.
settings_link() {
    # (its own names: `scene` is the keeper's, and refresh finds the bar's process by it)
    local prog link
    for prog in mooi-settings mooi-board mooi-nexus mooi-desk mooi-player mooi-notch mooi-frame mooi-widgets mooi-walls mooi-viz; do
        link="$(dirname "$folder")/$prog"
        [ -L "$link" ] && continue
        if [ -e "$link" ]; then
            # Do not let moved-aside folders accumulate for ever (audit G13): prune backups
            # older than a month, then move this one aside as before.
            find "$(dirname "$link")" -maxdepth 1 -name "$(basename "$link").old.*" -type d -mtime +30 \
                -exec rm -rf -- {} + 2>/dev/null || :
            mv "$link" "$link.old.$$"
        fi
        mkdir -p "$folder" && ln -s "$folder" "$link"
    done
    # BMO shares mooi's data folder too (his settings are its companion section; a link to a single
    # file is replaced by a copy on the first write). His place, kept in his own folder before,
    # comes along as bmo-state.json.
    bmo_dir="$(dirname "$folder")/bmo"
    if [ -d "$bmo_dir" ] && [ ! -L "$bmo_dir" ]; then
        if [ -f "$bmo_dir/bmo-state.json" ]; then cp "$bmo_dir/bmo-state.json" "$folder/bmo-state.json"
        elif [ -f "$bmo_dir/settings.json" ] && command -v jq >/dev/null 2>&1; then
            jq '{x: (.x // -1), y: (.y // -1)}' "$bmo_dir/settings.json" > "$folder/bmo-state.json" 2>/dev/null || :
        fi
        mv "$bmo_dir" "$bmo_dir.old.$$"
    fi
    [ -L "$bmo_dir" ] || { mkdir -p "$folder" && ln -s "$folder" "$bmo_dir"; }
}
# Sockets of scenes that are gone. pleamar names a second copy of a scene `<name>-<pid>`; a copy
# ended outright (a refresh mid-flight, a scene killed) leaves that socket behind, one per restart
# (28 of them by 2026-10-29, every one from a killed copy). A dead pid's is removed, a live one's
# left alone — no name is held by files, only by the process listening on them.
reap_sockets() {
    local d="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/pleamar" f pid
    [ -d "$d" ] || return 0
    for f in "$d"/*.sock; do
        [ -S "$f" ] || continue
        pid=$(basename "$f" | sed -n 's/.*-\([0-9][0-9]*\)\.sock$/\1/p')
        [ -n "$pid" ] || continue
        kill -0 "$pid" 2>/dev/null || rm -f "$f"
    done
}
# The live copy is current when nothing under shell/ is newer than it, no file has come or gone,
# and it was paced at today's speed by the pleamar installed now: then a login (or a refresh with
# nothing changed) starts at once instead of compiling nine scenes first (~1.1 s of every login).
snapshot_stamp() { echo "speed $(pace_speed) · $("$pleamar" --version 2>&1 | head -n 1)"; }
snapshot_current() {
    [ -f "$live/.snapshot" ] && [ "$(cat "$live/.snapshot")" = "$(snapshot_stamp)" ] || return 1
    [ -z "$(find "$root/shell" -newer "$live/.snapshot" -print 2>/dev/null | head -n 1)" ] || return 1
    [ "$(cd "$root/shell" && find . | sort)" = "$(cd "$live" && find . ! -name .snapshot | sort)" ]
}
# Every scene the shell runs, and what to call it when it does not compile.
SCENES="mooi.plm:the repo's scene
mooi-settings.plm:the settings window
mooi-board.plm:the board
mooi-nexus.plm:Control Nexus
mooi-frame.plm:the screen frame
mooi-desk.plm:the desk
mooi-player.plm:the music player
mooi-notch.plm:the side notch
mooi-widgets.plm:the desktop widgets
mooi-walls.plm:the wallpaper picker
mooi-viz.plm:the visualisers
mooi-lock.plm:the lock screen
bmo/bmo.plm:BMO"
snapshot() {
    reap_sockets
    settings_link
    snapshot_current && return 0
    # the stamp is taken before anything is read, so a file saved during the copy makes the next
    # start check again rather than be missed
    stamp_new="$state/.snapshot.new"
    mkdir -p "$state" && snapshot_stamp > "$stamp_new" || return 1
    # all nine at once: each check is its own pleamar, and together they take as long as the slowest
    checks="$state/.checks.$$"
    rm -rf "$checks" && mkdir -p "$checks" || return 1
    n=0
    while IFS=: read -r file what; do
        n=$((n + 1))
        { "$pleamar" --check "$root/shell/$file" >/dev/null 2>&1 || echo "$what" > "$checks/$n"; } &
    done <<SCENES_EOF
$SCENES
SCENES_EOF
    wait
    failed=$(cat "$checks"/* 2>/dev/null | head -n 1)
    rm -rf "$checks"
    if [ -n "$failed" ]; then
        rm -f "$stamp_new"
        echo "mooi: $failed does not compile; the running one is kept" >&2
        return 1
    fi
    rm -rf "$live.new" && cp -r "$root/shell" "$live.new" || return 1
    pace "$live.new"
    mv "$stamp_new" "$live.new/.snapshot"
    rm -rf "$live" && mv "$live.new" "$live"
}
# How fast everything moves (settings: motion.speed, %). Pleamar's springs are numbers in the
# scene, so the live copy's are scaled as it is made: a time factor f = 100 / speed turns a
# spring's stiffness into k / f² and its damping into c / f (same shape, f times the duration),
# and a `~120ms` or `for 460ms` into f times as long. The visualizer's spring (`fl.level`) follows
# the sound and is left alone; a 1 ms snap stays a snap.
pace_speed() {
    speed=100
    [ -r "$settings" ] && command -v jq >/dev/null 2>&1 && speed=$(jq -r '.motion.speed // 100' "$settings" 2>/dev/null || echo 100)
    case "$speed" in ''|0|*[!0-9]*) speed=100 ;; esac
    echo "$speed"
}
pace() {
    speed=$(pace_speed)
    [ "$speed" -eq 100 ] && return 0
    # No `bc` (audit 2026-10-31, F5): awk computes the factor itself, so a machine without bc
    # no longer gets a silent division by zero and unpaced scenes. The list is read a line at a
    # time so a path with a space is not split.
    find "$1" -name '*.plm' | while IFS= read -r f; do
        awk -v speed="$speed" '
        BEGIN { f = 100 / speed }
        function ms(s, pat, pre,   out, n) {
            out = ""
            while (match(s, pat)) {
                n = substr(s, RSTART + length(pre), RLENGTH - length(pre) - 2) + 0
                if (n >= 10) n = int(n * f + 0.5)
                out = out substr(s, 1, RSTART - 1) pre n "ms"; s = substr(s, RSTART + RLENGTH)
            }
            return out s
        }
        {
            line = $0
            if (match(line, /spring [A-Za-z_.]+ = [0-9.]+, [0-9.]+/) && line !~ /spring fl\.level /) {
                m = substr(line, RSTART, RLENGTH); split(m, a, /[=,]/)
                line = substr(line, 1, RSTART - 1) a[1] "= " sprintf("%.0f", a[2] / (f * f)) ", " sprintf("%.1f", a[3] / f) substr(line, RSTART + RLENGTH)
            }
            line = ms(line, "~[0-9]+ms", "~")
            line = ms(line, "for [0-9]+ms", "for ")
            print line
        }' "$f" > "$f.paced" && mv "$f.paced" "$f"
    done
}
scene_pids() { # pleamar processes running this scene (never a shell that merely mentions it)
    for p in $(pgrep -x pleamar 2>/dev/null); do
        tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null | grep -qF -- "--scene $scene " && echo "$p"
    done
}

# The keeper: runs the scene, restarts it after a crash, gives up after three quick
# deaths. A scene that quits cleanly (`mooi stop`) ends it too, unless `refresh` asked for it
# back: pleamar 0.5+ quits cleanly on SIGTERM as well, so an exit code cannot tell them apart.
keep() {
    exec 8>"$rt/keep.lock"
    flock -n 8 || { echo "mooi: already running" >&2; exit 1; }
    echo $$ > "$keep_pid"
    end() { [ "$(cat "$keep_pid" 2>/dev/null)" = "$$" ] && rm -f "$keep_pid"; }
    child=""
    trap '[ -n "$child" ] && kill -TERM "$child" 2>/dev/null; end; exit 0' TERM INT HUP
    : > "$log"
    tries=0
    while :; do
        start=$(date +%s)
        # PLEAMAR_SWAPCHAIN=1 (D132): the surfaces present through the standard swapchain, not
        # pleamar's own pool of reused frames. With the pool, under quick changes a frame was shown
        # holding an older one's pixels: the bar's islands stayed on screen after they closed (frozen
        # mid-fade, half-cut), and BMO left copies when thrown about. Every program the bar starts
        # (frame, notch, Nexus, BMO, settings) inherits it.
        PLEAMAR_SWAPCHAIN=1 MOOI_MODE=session MOOI_SHELL=$live MOOI_BIN=$self "$pleamar" --scene "$scene" --no-hud --stall 0 $(reduced_flag) >> "$log" 2>&1 8>&- &
        child=$!
        wait "$child"; code=$?
        if [ -f "$again" ]; then rm -f "$again"; tries=0; echo "mooi-keep: refreshed" >> "$log"; continue; fi
        [ "$code" -eq 0 ] && break
        if [ $(($(date +%s) - start)) -lt 10 ]; then tries=$((tries + 1)); else tries=0; fi
        if [ "$tries" -ge 3 ]; then
            echo "mooi-keep: died $tries times quickly, giving up" >> "$log"
            # said where it will be seen: without it a standalone desktop simply has no bar
            command -v notify-send >/dev/null 2>&1 && notify-send -u critical -a mooi "mooi stopped" \
                "It crashed three times in a row. Super+Shift+B starts it again; the log: $log" 8>&-
            break
        fi
        echo "mooi-keep: exited with $code, restarting" >> "$log"
        sleep "$tries"
    done
    end
}

stop_mooi() {
    "$pleamar" --say "$name" quit >/dev/null 2>&1
    wait_for 3 not running && return 0
    # Hung: end the keeper first so it does not restart the scene, then the scene.
    alive "$(cat "$keep_pid" 2>/dev/null)" && kill -TERM "$(cat "$keep_pid")" 2>/dev/null
    for p in $(scene_pids); do kill -TERM "$p" 2>/dev/null; done
    wait_for 3 not running || for p in $(scene_pids); do kill -KILL "$p" 2>/dev/null; done
}

# The lock screen (D160): one pleamar scene holding the session through ext-session-lock. It is
# started on demand — a lock must exist before it is asked for, so this waits for its socket before
# telling it to lock — and it is the same program the bar, the key bind and hypridle reach.
lock_name=mooi-lock
# The lock scene's `files.read` reaches only its own folder, and what it wants is the shell's palette,
# settings and wallpaper: they are copied in before it starts and before every lock, so a new
# wallpaper or a re-colour shows on the next lock without the scene having to read outside at all.
# One of the lock's pictures (D161): REL (relative to mooi's folder), the name to give it, the lock's
# folder. Prints the copy's whole path, or nothing.
lock_picture() {
    case "$1" in '' | /* | ../* | */../* | *..) return 0 ;; esac
    ext=${1##*.}
    ext=$(printf '%s' "$ext" | tr '[:upper:]' '[:lower:]')
    case "$ext" in png | jpg | jpeg | webp | avif | gif) ;; *) return 0 ;; esac
    [ -f "$folder/$1" ] || return 0
    cp -f "$folder/$1" "$3/$2.$ext" 2>/dev/null && printf '%s' "$3/$2.$ext"
}
lock_files() {
    local d="${XDG_DATA_HOME:-$HOME/.local/share}/pleamar/$lock_name"
    mkdir -p "$d" || return 1
    for f in palette.json settings.json wall.json; do
        [ -f "$folder/$f" ] && cp -f "$folder/$f" "$d/$f" 2>/dev/null
    done
    # How many tries are left before PAM locks the login: the scene can only ask whether a password
    # is right, so the system's threshold (faillock.conf; pam_faillock's own defaults are 3 and 600 s)
    # and the misses already on the tally go with it.
    local deny=3 unlock=600 conf=/etc/security/faillock.conf v
    if [ -r "$conf" ]; then
        v=$(sed -n 's/^[[:space:]]*deny[[:space:]]*=[[:space:]]*\([0-9]\{1,\}\).*/\1/p' "$conf" | tail -1)
        [ -n "$v" ] && deny=$v
        v=$(sed -n 's/^[[:space:]]*unlock_time[[:space:]]*=[[:space:]]*\([0-9]\{1,\}\).*/\1/p' "$conf" | tail -1)
        [ -n "$v" ] && unlock=$v
    fi
    local used=0
    command -v faillock >/dev/null 2>&1 && used=$(faillock --user "${USER:-$(id -un)}" 2>/dev/null | grep -c ' V$')
    printf '{"deny":%s,"unlock":%s,"used":%s}\n' "$deny" "$unlock" "${used:-0}" > "$d/lockout.json" 2>/dev/null
    # The two pictures on the lock (D161): the Nexus's banner across the top and its profile picture
    # above the clock. `files.read` reaches this folder only, so both are copied in and named by their
    # whole path — an image fact draws a path as it stands, and a bare name beside the scene draws
    # nothing at all. No identity, or one of the two cleared: an empty pair, so a picture taken away
    # stops showing instead of last lock's staying.
    rm -f "$d"/avatar.* "$d"/banner.* "$d"/picture.* "$d/identity.json" 2>/dev/null
    local a="" b="" rel
    if command -v jq >/dev/null 2>&1 && [ -r "$settings" ]; then
        # Only a picture inside mooi's own folder, with a plain image extension (fourth pass, L10):
        # a `..` in the path, or an extension with quotes in it, is refused rather than copied.
        rel=$(jq -r '.nexus.identity.avatar // empty' "$settings" 2>/dev/null)
        a=$(lock_picture "$rel" avatar "$d")
        rel=$(jq -r '.nexus.identity.banner // empty' "$settings" 2>/dev/null)
        b=$(lock_picture "$rel" banner "$d")
    fi
    if command -v jq >/dev/null 2>&1; then
        jq -n --arg a "$a" --arg b "$b" '{avatar: $a, banner: $b}' > "$d/identity.json" 2>/dev/null
    else
        printf '{"avatar":"","banner":""}\n' > "$d/identity.json" 2>/dev/null
    fi

    # An animated wallpaper is a picture the renderer plays by itself (a GIF, an animated PNG or
    # WebP): the scene is simply handed the file. A video is not one, and a lock surface has nothing
    # underneath it for mpvpaper, so the copy of wall.json hands the scene the video's still — and,
    # made in the background once per video so a lock never waits on an encoder, a short loop as an
    # animated WebP (or PNG), which the renderer does play. The next lock shows it moving.
    local wj="$d/wall.json" kind src still loop enc
    if [ -r "$wj" ] && command -v jq >/dev/null 2>&1; then
        kind=$(jq -r '.kind // empty' "$wj" 2>/dev/null)
        if [ "$kind" = "video" ]; then
            src=$(jq -r '.source // empty' "$wj" 2>/dev/null)
            still=$(jq -r '.still // empty' "$wj" 2>/dev/null)
            # which encoder this ffmpeg carries (a `case` over its list, not a pipe into `grep -q`:
            # that closes the pipe early, and a caller's `pipefail` would read the encoder as absent)
            loop="" enc=""
            if command -v ffmpeg >/dev/null 2>&1; then
                case "$(ffmpeg -hide_banner -encoders 2>/dev/null)" in
                    *libwebp*) loop="$d/wall-loop.webp"; enc=webp ;;
                    *apng*) loop="$d/wall-loop.png"; enc=apng ;;
                esac
            fi
            if [ -n "$loop" ] && [ -f "$src" ] && { [ ! -f "$loop" ] || [ "$src" -nt "$loop" ]; }; then
                # detached (`setsid -f`), so the encode outlives the lock command that asked for it,
                # and written to a partial name so a scene never reads half a loop
                local vf codec
                vf='fps=10,scale=960:-2:flags=lanczos'
                # `-f` is named because the partial the loop is written to has no extension to guess from
                if [ "$enc" = "webp" ]; then codec='-c:v libwebp -quality 70 -f webp'
                else codec='-c:v apng -plays 0 -f apng'; fi
                setsid -f sh -c 'ffmpeg -y -loglevel error -t 6 -i "$1" -vf "$2" $3 "$4.part" >/dev/null 2>&1 && mv -f "$4.part" "$4"' \
                    _ "$src" "$vf" "$codec" "$loop" >/dev/null 2>&1 < /dev/null
            fi
            if [ -n "$loop" ] && [ -f "$loop" ]; then
                jq --arg p "$loop" '.source = $p' "$wj" > "$wj.tmp" && mv -f "$wj.tmp" "$wj"
            elif [ -n "$still" ] && [ -f "$still" ]; then
                jq --arg p "$still" '.source = $p' "$wj" > "$wj.tmp" && mv -f "$wj.tmp" "$wj"
            fi
        else
            rm -f "$d"/wall-loop.* 2>/dev/null
        fi
    fi
}

# ── The visualiser's feed on the lock ──────────────────────────────────────────
# cava's bands are the bar's (`viz-levels.txt` in the shell's folder) and the lock scene reads only
# its own folder, so the line is carried across while the lock screen is up: a few hundred bytes,
# about thirty times a second while music plays, nothing cava does not already compute. The scene reads it at that pace
# (`every(33)` in mooi-lock.luau) rather than trusting its file watch, which coalesces. It stops two
# seconds after the lock comes down (or at once from `mooi unlock`), and with the session.
lock_feed_start() {
    local d="${XDG_DATA_HOME:-$HOME/.local/share}/pleamar/$lock_name"
    lock_feed_stop
    # Copied only while something plays (L5): with nothing playing the bands do not move, and a
    # lock left up for half an hour should cost one check a second, not fifty copies.
    (
        while [ "$("$pleamar" --say "$lock_name" "get locked" 2>/dev/null)" = "true" ]; do
            # the notices waiting: Signal Loom's feed, carried over too (the lock must not run its own
            # notification service to count them: watching one claims the name)
            [ -r "$folder/nexus-feed.json" ] && cp -f "$folder/nexus-feed.json" "$d/nexus-feed.json" 2>/dev/null
            if [ "$("$pleamar" --say "$lock_name" "get lk_playing" 2>/dev/null)" = "true" ]; then
                n=0
                while [ "$n" -lt 30 ]; do
                    [ -r "$folder/viz-levels.txt" ] && cp -f "$folder/viz-levels.txt" "$d/viz-levels.txt" 2>/dev/null
                    n=$((n + 1)); sleep 0.033
                done
            else
                sleep 1
            fi
        done
    ) >/dev/null 2>&1 < /dev/null &
    echo "$!" > "$state/lock-feed.pid"
}
lock_feed_stop() {
    local f="$state/lock-feed.pid"
    [ -f "$f" ] || return 0
    kill -TERM "$(cat "$f" 2>/dev/null)" 2>/dev/null || :
    rm -f "$f"
}
# ── The lock's idle timeout (D161) ────────────────────────────────────────────
# hypridle reads its listeners from a file of its own, so the setting (`lock.idle`, Settings →
# Lock, 30 minutes by default) becomes that file here and hypridle is restarted when it changed.
# A file that already says this is left alone, so `session` can call it without touching anything.
idle_apply() {
    local mins=30 lock_at suspend_at want
    if [ -r "$settings" ] && command -v jq >/dev/null 2>&1; then
        mins=$(jq -r '.lock.idle // 30' "$settings" 2>/dev/null)
    fi
    case "$mins" in ''|*[!0-9]*) mins=30 ;; esac
    [ "$mins" -ge 1 ] || mins=1
    [ "$mins" -le 60 ] || mins=60
    lock_at=$((mins * 60))
    suspend_at=$((lock_at + 1800))
    [ "$suspend_at" -ge 3600 ] || suspend_at=3600
    want=$(cat <<EOF
#  ◈ HYPRIDLE CONFIGURATION — written by \`mooi idle\` from Settings → Lock. Edit the setting.
#  The lock screen is mooi's while mooi is the desktop (harness: ~/.config/hypr/scripts/lock-session.sh).

general {
    lock_cmd = ~/.config/hypr/scripts/lock-session.sh
    before_sleep_cmd = loginctl lock-session
    inhibit_sleep = 3                         # sleep waits until the session lock is held
    after_sleep_cmd = hyprctl eval 'hl.dispatch(hl.dsp.dpms({ action = "on" }))'
}

listener {
    timeout = $lock_at                      # lock after $mins min idle
    on-timeout = loginctl lock-session
}

listener {
    timeout = $suspend_at                      # suspend $((suspend_at / 60)) min after the last use
    on-timeout = systemctl suspend
}
EOF
)
    local f
    f=$(readlink -f "$idle_conf" 2>/dev/null) || f="$idle_conf"
    if [ -f "$f" ] && [ "$(cat "$f" 2>/dev/null)" = "$want" ]; then
        echo "idle: lock after $mins min, suspend after $((suspend_at / 60)) min (already written)"
        return 0
    fi
    mkdir -p "$(dirname "$f")" || return 1
    printf '%s\n' "$want" > "$f.tmp.$$" && mv "$f.tmp.$$" "$f" || { rm -f "$f.tmp.$$"; echo "idle: could not write $f" >&2; return 1; }
    # One hypridle, started the way ~/.config/hypr/scripts/idle-mode.sh starts it, and only if one
    # was running: none running is idle-mode's "keep awake", which a new file must not undo.
    # Restarting only the systemd unit left a second, session-started hypridle on the old file
    # (two found on 2026-11-06, the older still suspending without waiting for the lock).
    if pgrep -x hypridle >/dev/null 2>&1; then
        systemctl --user is-active --quiet hypridle 2>/dev/null && systemctl --user stop hypridle >/dev/null 2>&1
        pkill -x hypridle 2>/dev/null
        n=0; while [ "$n" -lt 20 ] && pgrep -x hypridle >/dev/null 2>&1; do n=$((n + 1)); sleep 0.1; done
        setsid -f hypridle >/dev/null 2>&1 < /dev/null || echo "idle: the file is written; hypridle did not restart" >&2
    fi
    echo "idle: lock after $mins min, suspend after $((suspend_at / 60)) min"
}
idle_conf="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hypridle.conf"
lock_start() {
    lock_files
    "$pleamar" --say "$lock_name" "get locked" >/dev/null 2>&1 && return 0
    PLEAMAR_SWAPCHAIN=1 MOOI_MODE=session MOOI_SHELL=$live MOOI_BIN=$self \
        setsid -f "$pleamar" --scene "$live/mooi-lock.plm" --no-hud --stall 0 \
        >> "$state/lock.log" 2>&1 < /dev/null
    n=0
    while [ "$n" -lt 50 ] && ! "$pleamar" --say "$lock_name" "get locked" >/dev/null 2>&1; do
        n=$((n + 1)); sleep 0.1
    done
    "$pleamar" --say "$lock_name" "get locked" >/dev/null 2>&1 || {
        echo "mooi lock: the lock screen did not come up (see $state/lock.log)" >&2
        return 1
    }
}
# `locked` is only the request; the lock exists when the compositor says so (`lock.held`). This
# returns 0 only then, so lock-session.sh's suspend and hypridle's `inhibit_sleep` never go on
# behind an open screen, and a refused lock (another locker holds it) is reported as a failure and
# falls through to hyprlock instead of passing as a lock (audit 2026-11-06, fourth pass, L1).
lock_held() {
    case "$("$pleamar" --say "$lock_name" "get lock.held" 2>/dev/null)" in
        1 | true) return 0 ;;
    esac
    return 1
}
lock_only() {
    snapshot || return 1
    lock_start || return 1
    "$pleamar" --say "$lock_name" "fact locked true" >/dev/null 2>&1 || return 1
    n=0
    while [ "$n" -lt 50 ] && ! lock_held; do
        n=$((n + 1)); sleep 0.1
    done
    if ! lock_held; then
        "$pleamar" --say "$lock_name" "fact locked false" >/dev/null 2>&1
        echo "mooi lock: the compositor did not grant the lock (see $state/lock.log)" >&2
        return 1
    fi
    lock_feed_start
}
unlock_only() {
    "$pleamar" --say "$lock_name" "fact locked false" >/dev/null 2>&1 || {
        echo "mooi unlock: no lock screen is running" >&2
        return 1
    }
    lock_feed_stop
}

cmd=${1:-help}; [ $# -gt 0 ] && shift
case "$cmd" in
    __keep) keep ;;
    lock) lock_only ;;
    unlock) unlock_only ;;
    idle) idle_apply ;;
    session | start)
        snapshot || exit 1
        # a running mooi is restarted on the fresh snapshot (Super+Shift+B is "start it again")
        rm -f "$again"
        if keeping || running; then
            stop_mooi
            keeping && kill -TERM "$(cat "$keep_pid")" 2>/dev/null && wait_for 3 not keeping
        fi
        theme_watch_start
        setsid -f "$self" __keep >/dev/null 2>&1 < /dev/null
        if wait_for 6 keeping && wait_for 8 running; then
            echo "mooi is the desktop"
        else
            echo "mooi did not start; see $log" >&2
            exit 1
        fi
        # The lock screen starts with the session, unlocked and idle: locking then raises its
        # surface instead of starting a process, so a key pressed the instant SUPER+L lands is
        # heard (starting one took long enough that the first keystrokes fell on nothing).
        lock_start >/dev/null 2>&1 || :
        # the installed hypridle.conf agrees with the setting again (Settings → Lock)
        idle_apply >/dev/null 2>&1 || :
        ;;
    toggle)
        if ! running; then
            "$self" session >/dev/null || exit 1
            wait_for 3 running
        fi
        exec "$pleamar" --say "$name" "emit open_command" ;;
    restart-hypr)
        # Hyprland reads its config again, then the bar comes back on it. A reload leaves every
        # window open; mooi's own windows restart with the bar.
        hyprctl reload >/dev/null 2>&1 || { echo "hyprctl could not reload Hyprland" >&2; exit 1; }
        exec "$self" refresh
        ;;
    refresh)
        running || { echo "mooi is not running; \`mooi session\`" >&2; exit 1; }
        [ -n "$(scene_pids)" ] || { echo "the running mooi is not a snapshot (started before \`refresh\` existed): \`mooi session\`" >&2; exit 1; }
        snapshot || exit 1
        # Ending only the scene keeps the keeper through the refresh; the mark tells it this
        # ending is not a stop (pleamar 0.5+ exits 0 on SIGTERM, as for `quit`).
        : > "$again"
        for p in $(scene_pids); do kill -TERM "$p" 2>/dev/null; done
        wait_for 3 not running
        wait_for 8 running && echo "mooi refreshed from the repo" || { echo "mooi did not come back; see $log" >&2; exit 1; }
        # the watch is this script too: a new one runs what the repo says now
        theme_watch_stop; theme_watch_start
        # the lock screen ran from the old snapshot: give it the new one, unless it is holding
        # the session (a locked screen is never restarted from here)
        if [ "$("$pleamar" --say "$lock_name" "get locked" 2>/dev/null)" != "true" ]; then
            "$pleamar" --say "$lock_name" quit >/dev/null 2>&1
            lock_start >/dev/null 2>&1 || :
        fi
        ;;
    stop | restore)
        rm -f "$again"   # first: a refresh's mark must not turn this stop into a restart
        lock_feed_stop
        running && stop_mooi
        theme_watch_stop
        keeping && kill -TERM "$(cat "$keep_pid")" 2>/dev/null
        rm -f "$rt/takeover" "$rt/mode"   # left by launchers before D133
        echo "mooi stopped"
        ;;
    status)
        if keeping && running; then echo "mooi: the desktop (keeper $(cat "$keep_pid"))"
        elif running; then echo "mooi: running without its keeper (\`mooi run\`?)"
        else echo "mooi: not running"; fi
        theme_watching && echo "theme watch: following $(basename "$wallpaper")" || echo "theme watch: not running"
        echo "pleamar: $("$pleamar" --version 2>&1)"
        ;;
    run)
        if [ "${1:-}" = --safe ]; then shift; export MOOI_SAFE=1; fi
        # shellcheck disable=SC2046
        settings_link
        PLEAMAR_SWAPCHAIN=1 MOOI_SHELL="$root/shell" exec "$pleamar" --scene "$src" --no-hud --stall 0 $(reduced_flag) "$@" ;;
    open | window) exec "$pleamar" --say "$name" "emit open_window" ;;
    system) exec "$pleamar" --say "$name" "emit open_system" ;;
    settings) exec "$pleamar" --say "$name" "emit open_settings" ;;
    wallpaper|walls) # the wallpaper picker (D145): mooi-walls, the strip and the colour orbit
        running || { echo "mooi is not running; start it first" >&2; exit 1; }
        exec "$pleamar" --say "$name" "emit open_wallpaper" ;;
    wall) # wear a wallpaper (D145): apply FILE [--from-y N] [--transition KIND] · live · index
        sub=${1:-}; shift || :
        case "$sub" in
            apply) wall_apply "$@" ;;
            live) wall_live ;;
            index) wall_index ;;
            next) wall_next "$@" ;;
            wallhaven) wall_wallhaven "$@" ;;
            count) # how many wallpapers a folder holds (Settings → Wallpapers)
                d=$(printf '%s' "${1:-}" | sed "s|^~|$HOME|")
                [ -d "$d" ] || exit 1
                find "$d" -maxdepth 1 -type f | grep -ciE '\.(jpe?g|png|webp|avif|jxl|bmp|gif|apng|mp4|webm|mkv|mov|m4v|avi)$' ;;
            whkey) # whether a Wallhaven API key is there, readable by you alone (it is never printed);
                # `check`: and whether Wallhaven takes it
                k=$wh_keyfile
                if [ -s "$k" ] && [ "$(stat -c %a "$k")" = 600 ]; then
                    if [ "${1:-}" = check ]; then
                        # a sketchy/NSFW search: 200 with a key Wallhaven takes, 401 with one it does not
                        c=$(printf 'X-API-Key: %s\n' "$(head -c 200 "$k" | tr -d '[:space:]')" | curl -s -o /dev/null -w '%{http_code}' --max-time 10 -H @- "https://wallhaven.cc/api/v1/search?purity=001")
                        case "$c" in 200) echo valid ;; 401) echo invalid; exit 1 ;; *) echo offline; exit 1 ;; esac
                    else echo found; fi
                elif [ -s "$k" ]; then echo "unsafe: chmod 600 $k"; exit 1
                else echo none; exit 1; fi ;;
            *) echo "usage: mooi wall apply FILE [--from-y N] [--transition KIND] | live | index | next [FROM] | wallhaven … | count DIR | whkey" >&2; exit 2 ;;
        esac ;;
    notes) exec "$pleamar" --say "$name" "emit open_notes" ;;
    player) running || { echo "mooi is not running; start it first" >&2; exit 1; }
            exec "$pleamar" --say "$name" "emit open_player 1" ;;
    wallmap) # the wallpaper read for the widgets (D139): cut-out + 32×18 map, cached; [file] [fast|nocut]
        src="${1:-$(readlink -f "$HOME/.cache/current_wallpaper_source")}"
        [ -f "$src" ] || { echo "wallmap: no picture at $src" >&2; exit 1; }
        model=bria-rmbg; [ "${2:-}" = fast ] && model=isnet-general-use
        [ "${2:-}" = nocut ] && model=none     # the map only: no rembg (widgets.depth off, D150)
        exec python3 "$root/tools/wallmap.py" "$src" "$folder" 1920 1080 "$model" ;;
    widgets) # the desktop widgets (D137): `mooi widgets edit` places them on the desktop
        case "${1:-edit}" in
            edit) exec "$pleamar" --say mooi-widgets "emit wg_edit 1" ;;
            desk) exec "$pleamar" --say mooi-widgets "emit wg_deskm 2" ;;   # desk mode (D141): gathered, or back
            *) echo "usage: mooi widgets [edit|desk]" >&2; exit 2 ;;
        esac ;;
    bmo) # BMO (D143): `mooi bmo joke` — one of his own jokes, no Claude needed
        case "${1:-}" in
            joke) exec "$pleamar" --say bmo "emit joke" ;;
            *) echo "usage: mooi bmo joke" >&2; exit 2 ;;
        esac ;;
    focus) # the focus timer widget (D141): start or pause it; `mooi focus reset`
        case "${1:-}" in
            reset) exec "$pleamar" --say mooi-widgets "emit tm_go 1" ;;
            *) exec "$pleamar" --say mooi-widgets "emit tm_go 0" ;;
        esac ;;
    photo-prep) # the photo widget's picture (D141): <src> <out-dir> <key> → key-43.jpg, key-11.jpg and,
        # with rembg, their subjects cut out (key-43.png, key-11.png). Quiet and slow on purpose (nice 19).
        src=$1; dir=$2; key=$3
        [ -f "$src" ] && [ -n "$dir" ] && [ -n "$key" ] || { echo "usage: mooi photo-prep <src> <dir> <key>" >&2; exit 2; }
        mkdir -p "$dir"
        [ -f "$dir/$key-43.jpg" ] || nice -n 19 magick "$src" -auto-orient -resize '1200x900^' -gravity center -extent 1200x900 -quality 88 "$dir/$key-43.jpg" || exit 1
        [ -f "$dir/$key-11.jpg" ] || nice -n 19 magick "$src" -auto-orient -resize '900x900^' -gravity center -extent 900x900 -quality 88 "$dir/$key-11.jpg" || exit 1
        echo pictures
        rembg=$(command -v rembg || echo "$HOME/.local/bin/rembg")
        [ -x "$rembg" ] || exit 0
        for a in 43 11; do
            [ -f "$dir/$key-$a.png" ] || nice -n 19 "$rembg" i -m isnet-general-use "$dir/$key-$a.jpg" "$dir/$key-$a.png" >/dev/null 2>&1 || true
        done
        [ -f "$dir/$key-43.png" ] && echo cut
        exit 0 ;;
    board) running || { echo "mooi is not running; start it first" >&2; exit 1; }
           exec "$pleamar" --say "$name" "emit open_board" ;;
    notch) # the side notch on a panel: claude music spaces walls weather github games (Claude by default)
        case "${1:-claude}" in claude) n=0 ;; music) n=1 ;; spaces|workspaces) n=2 ;; walls|wallpapers) n=3 ;; weather) n=4 ;; github) n=5 ;; games) n=6 ;;
            *) echo "usage: mooi notch [claude|music|spaces|walls|weather|github|games]" >&2; exit 2 ;; esac
        exec "$pleamar" --say mooi-notch "emit nt_show $n" ;;
    game) # a game found on the disk (the notch's Games panel): its folder, then a program in it
        # (unless its own launcher is there to find), then --proton when PortProton has to run it
        dir=${1:-}; exe=${2:-}; forge=${3:-}
        [ -n "$dir" ] || { echo "usage: mooi game <folder> [program] [--proton]" >&2; exit 2; }
        case "$dir" in /*) ;; *) echo "mooi game: give the game's own folder" >&2; exit 2 ;; esac
        [ -d "$dir" ] || { echo "mooi game: no such folder: $dir" >&2; exit 1; }
        cd "$dir" || exit 1
        if [ -z "$exe" ]; then
            for f in ./start.sh ./run.sh ./launch.sh ./*.sh ./*.AppImage ./*.x86_64 ./*.run; do
                [ -f "$f" ] && [ -x "$f" ] && { setsid -f "$f" >/dev/null 2>&1 < /dev/null; exit 0; }
            done
            exe=$(ls ./*.exe 2>/dev/null | sed 's:^\./::' | grep -viE 'unitycrash|crashhandler|createdump|elevate|^setup|^unins|vcredist|dxsetup|^install' | head -n 1)
            [ -n "$exe" ] || { echo "mooi game: nothing to start in $dir" >&2; exit 1; }
        fi
        # a folder PortProton made is its own to start; anything else is wine's where wine is here
        case "$dir" in */PortProton/*) forge=--proton ;; esac
        if [ "$forge" != "--proton" ] && command -v wine >/dev/null 2>&1; then
            setsid -f wine "$exe" >/dev/null 2>&1 < /dev/null
            exit 0
        fi
        if command -v portproton >/dev/null 2>&1; then exec portproton "$dir/$exe"; fi
        if command -v wine >/dev/null 2>&1; then setsid -f wine "$exe" >/dev/null 2>&1 < /dev/null; exit 0; fi
        echo "mooi game: install wine or PortProton to run $exe" >&2
        exit 1 ;;
    nexus) running || { echo "mooi is not running; start it first" >&2; exit 1; }
           exec "$pleamar" --say "$name" "emit open_nexus" ;;
    hardware)
        echo "MOOI HARDWARE INVENTORY"
        echo "Kernel: $(uname -r 2>/dev/null || echo Unavailable)"
        cpu_model=$(awk -F: '/model name[[:space:]]*:/ { sub(/^[[:space:]]+/, "", $2); print $2; exit }' /proc/cpuinfo 2>/dev/null)
        [ -n "$cpu_model" ] || cpu_model="Unavailable"
        echo "CPU: $cpu_model"
        echo
        echo "GRAPHICS"
        if command -v lspci >/dev/null 2>&1; then
            lspci 2>/dev/null | grep -Ei 'VGA compatible controller|3D controller|Display controller' | sed 's/^[^:]*: //' || echo "No PCI display controllers found"
        else echo "Unavailable (install pciutils for lspci)"; fi
        echo
        echo "STORAGE DEVICES"
        if command -v lsblk >/dev/null 2>&1; then
            lsblk -dn -o NAME,SIZE,TYPE,MODEL 2>/dev/null | awk '$3 == "disk" {print}' || true
        else echo "Unavailable (lsblk missing)"; fi
        echo
        echo "DISPLAYS"
        if command -v hyprctl >/dev/null 2>&1; then
            hyprctl monitors -j 2>/dev/null | jq -r '.[] | "\(.name): \(.width)x\(.height) @ \(.refreshRate) Hz · scale \(.scale)"' 2>/dev/null || echo "Unavailable (Hyprland monitor query failed)"
        else echo "Unavailable (Hyprland session not detected)"; fi
        ;;
    diagnostics)
        action=${1:-show}
        case "$action" in show|copy) ;; *) echo "usage: mooi diagnostics [show|copy]" >&2; exit 2 ;; esac
        os_name="Unknown distribution"
        if [ -r /etc/os-release ]; then . /etc/os-release; os_name=${PRETTY_NAME:-${NAME:-Unknown distribution}}; fi
        cpu_model=$(awk -F: '/model name[[:space:]]*:/ { sub(/^[[:space:]]+/, "", $2); print $2; exit }' /proc/cpuinfo 2>/dev/null)
        [ -n "$cpu_model" ] || cpu_model="Unavailable"
        memory=$(awk '/^MemTotal:/ {t=$2} /^MemAvailable:/ {a=$2} END {if(t>0) printf "%.1f GiB used / %.1f GiB total", (t-a)/1048576, t/1048576; else print "Unavailable"}' /proc/meminfo 2>/dev/null)
        root_disk=$(df -hP / 2>/dev/null | awk 'NR==2 {printf "%s used (%s of %s)", $5, $3, $2}')
        [ -n "$root_disk" ] || root_disk="Unavailable"
        uptime_text=$(uptime -p 2>/dev/null || true); [ -n "$uptime_text" ] || uptime_text="Unavailable"
        gpu_list=$(lspci 2>/dev/null | grep -Ei 'VGA compatible controller|3D controller|Display controller' | sed 's/^[^:]*: //' | head -n 4)
        [ -n "$gpu_list" ] || gpu_list="Unavailable (lspci missing or no PCI display device found)"
        report=$(printf '%s\n' "MOOI SYSTEM DIAGNOSTICS" "Distribution: $os_name" "Kernel: $(uname -r 2>/dev/null || echo Unavailable)" "Hostname: $(hostname 2>/dev/null || echo Unavailable)" "Session: ${XDG_CURRENT_DESKTOP:-${XDG_SESSION_TYPE:-Unknown}}" "Uptime: $uptime_text" "CPU: $cpu_model" "Memory: $memory" "Root storage: $root_disk" "Graphics: $gpu_list")
        if [ "$action" = show ]; then printf '%s\n' "$report"; exit 0; fi
        if command -v wl-copy >/dev/null 2>&1; then printf '%s\n' "$report" | wl-copy || { echo "Clipboard write failed" >&2; exit 1; }
        elif command -v xclip >/dev/null 2>&1; then printf '%s\n' "$report" | xclip -selection clipboard -in || { echo "Clipboard write failed" >&2; exit 1; }
        else echo "No clipboard utility found; install wl-clipboard or xclip" >&2; exit 1; fi
        echo "Diagnostics copied"
        ;;
    identity)
        # Import images into mooi's own data folder; only generated relative paths enter settings.
        action=${1:-help}; [ $# -gt 0 ] && shift
        [ "${MOOI_SAFE:-0}" != 1 ] || { echo "identity settings are disabled in --safe mode" >&2; exit 1; }
        [ -r "$settings" ] || { echo "mooi settings not found; start mooi once first: $settings" >&2; exit 1; }
        command -v jq >/dev/null 2>&1 || { echo "identity requires jq" >&2; exit 1; }
        jq -e . "$settings" >/dev/null 2>&1 || { echo "settings.json is not valid JSON; refusing to overwrite it" >&2; exit 1; }
        case "$action" in
            name)
                value=$(printf '%s' "$*" | tr '\n' ' ')
                [ -n "$value" ] || { echo 'usage: mooi identity name "Display name"' >&2; exit 2; }
                [ "${#value}" -le 48 ] || { echo "display name must be 48 characters or fewer" >&2; exit 2; }
                # Every C0 control and DEL, not only \001 and \177 (audit G13).
                clean=$(printf '%s' "$value" | tr -d '\000-\037\177')
                [ "$clean" = "$value" ] || { echo "control characters are not allowed" >&2; exit 2; }
                tmp="$settings.tmp.$"
                jq --arg value "$value" '.nexus.identity.name = $value' "$settings" > "$tmp" && mv "$tmp" "$settings" || { rm -f "$tmp"; echo "could not update settings" >&2; exit 1; }
                echo "System identity name set to: $value"
                ;;
            avatar|banner)
                source=${1:-}
                [ -n "$source" ] && [ -f "$source" ] || { echo "usage: mooi identity $action /path/to/image.png" >&2; exit 2; }
                command -v file >/dev/null 2>&1 || { echo "identity image import requires the file utility" >&2; exit 1; }
                mime=$(file --brief --mime-type -- "$source" 2>/dev/null || true)
                case "$mime" in image/png) ext=png ;; image/jpeg) ext=jpg ;; image/webp) ext=webp ;; image/avif) ext=avif ;; *) echo "unsupported image type: $mime (use PNG, JPEG, WebP or AVIF)" >&2; exit 2 ;; esac
                mkdir -p "$folder/identity" || exit 1
                # A new name for every import: a scene's image is read by its path, so reusing
                # avatar.jpg would leave the plate showing the picture it already had (D70).
                relative="identity/$action-$(date +%s)-$$.$ext"
                dest="$folder/$relative"
                tmpdest="$dest.tmp.$"
                cp -- "$source" "$tmpdest" && mv "$tmpdest" "$dest" || { rm -f "$tmpdest"; echo "could not import image" >&2; exit 1; }
                tmp="$settings.tmp.$"
                jq --arg value "$relative" --arg action "$action" '.nexus.identity[$action] = $value' "$settings" > "$tmp" && mv "$tmp" "$settings" || { rm -f "$tmp"; echo "could not update settings; imported image remains at $dest" >&2; exit 1; }
                for old in "$folder/identity/$action".* "$folder/identity/$action"-*; do [ "$old" = "$dest" ] || rm -f -- "$old"; done
                echo "$action image imported to $dest"
                ;;
            remove)
                what=${1:-}
                case "$what" in avatar|banner) ;; *) echo "usage: mooi identity remove avatar|banner" >&2; exit 2 ;; esac
                tmp="$settings.tmp.$"
                jq --arg action "$what" '.nexus.identity[$action] = ""' "$settings" > "$tmp" && mv "$tmp" "$settings" || { rm -f "$tmp"; echo "could not update settings" >&2; exit 1; }
                rm -f "$folder/identity/$what".* "$folder/identity/$what"-*
                echo "$what image removed"
                ;;
            reset)
                tmp="$settings.tmp.$"
                jq '.nexus.identity = {name:"mooi system",avatar:"",banner:""}' "$settings" > "$tmp" && mv "$tmp" "$settings" || { rm -f "$tmp"; echo "could not reset identity settings" >&2; exit 1; }
                rm -f "$folder"/identity/avatar.* "$folder"/identity/avatar-* \
                      "$folder"/identity/banner.* "$folder"/identity/banner-*
                echo "System identity reset"
                ;;
            show)
                jq -r '.nexus.identity // {name:"mooi system",avatar:"",banner:""} | "Name: \(.name // "mooi system")\nAvatar: \(.avatar // "not set")\nBanner: \(.banner // "not set")"' "$settings"
                ;;
            *)
                echo 'usage: mooi identity name "Display name" | avatar IMAGE | banner IMAGE | remove avatar|banner | show | reset' >&2
                exit 2
                ;;
        esac
        ;;
    note)
        text=$(printf '%s' "$*" | tr '\n' ' ')
        [ -n "$text" ] || { echo "usage: mooi note \"what to remember\"" >&2; exit 2; }
        running || { echo "mooi is not running; start it first" >&2; exit 1; }
        "$pleamar" --say "$name" "text qn_draft $text" >/dev/null || exit 1
        "$pleamar" --say "$name" "emit qn_add" >/dev/null
        ;;
    clipboard) exec "$pleamar" --say "$name" "emit open_clips" ;;
    record) exec "$pleamar" --say "$name" "emit record $([ "${1:-}" = area ] && echo 1 || echo 0)" ;;
    edit) exec "$pleamar" --say "$name" "emit edit_toggle" ;;
    overview)
        exec "$pleamar" --say "$name" "emit open_overview" ;;
    mode)   # light | dark | auto | (nothing: the other one now)
        case "${1:-}" in dark) n=0 ;; light) n=1 ;; auto) n=2 ;; ""|toggle) n=9 ;; *) echo "usage: mooi mode [light|dark|auto]" >&2; exit 2 ;; esac
        exec "$pleamar" --say "$name" "emit set_mode $n" ;;
    shutter) exec "$pleamar" --say "$name" "emit open_shutter 0" ;;
    shutter-here) exec "$pleamar" --say "$name" "emit open_shutter 1" ;;
    say)  exec "$pleamar" --say "$name" "$@" ;;
    check)
        # The static/unit half is one script, run by CI as well: local and CI cannot drift
        # (audit 2026-11-06, G12).
        ( cd "$root" && sh tests/gate.sh ) || exit 1
        # Compile every scene by enumeration, not a hand-kept list: mooi-lock.plm used to be left
        # out while every document said `check` compiled every scene (audit 2026-11-06, G3).
        scenes=0
        for scene in "$root"/shell/*.plm "$root"/shell/bmo/*.plm; do
            "$pleamar" --check "$scene" || exit 1
            scenes=$((scenes + 1))
        done
        [ "$scenes" -gt 0 ] || { echo "no scenes found under $root/shell" >&2; exit 1; }
        echo "scenes: $scenes compile"
        # What this machine lacks: the scenes fall back quietly, so name it here rather than let a
        # visualizer or a store module look broken (audit 2026-10-29).
        missing=
        for tool in cava rembg playerctl mpc mpv mpvpaper ffmpeg yt-dlp magick wf-recorder grim slurp checkupdates flatpak; do
            command -v "$tool" >/dev/null 2>&1 || missing="$missing $tool"
        done
        [ -n "$missing" ] && echo "optional, not installed:$missing"
        # The scenes are written for language 0.9; another one may compile and still behave
        # differently, so it fails the gate rather than printing a warning and exiting 0
        # (audit 2026-11-06, G16).
        ver=$("$pleamar" --version 2>/dev/null | head -1)
        case "$ver" in
            *"language 0.9"*) echo "pleamar: $ver" ;;
            *) echo "error: $ver · the scenes are written for language 0.9" >&2; exit 1 ;;
        esac ;;
    theme-sync)
        theme_sync "$@" || { echo "theme-sync: failed" >&2; exit 1; }
        running && echo "mooi asked to read it" || echo "mooi is not running; it will read the palette when it starts"
        ;;
    theme)
        sub=${1:-}; [ $# -gt 0 ] && shift
        case "$sub" in
            save|list|apply) ;;
            *) echo "usage: mooi theme save <name> [description] [--force] | list | apply <name|file>" >&2; exit 2 ;;
        esac
        ( cd "$root" && exec lua5.4 shell/theme-cli.luau "$sub" "$@" ) ;;
    theme-watch) theme_watch ;;
    ws-fx) ws_fx ;;
    apps-sync) apps_sync ;;
    kitty-shaders) kitty_shaders_sync ;;
    *) sed -n '2,/^# --safe/p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac
