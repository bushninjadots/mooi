#!/bin/sh
# tidal — development launcher for Tidal Shell. Changes nothing outside this repo
# and Pleamar's per-scene folder (~/.local/share/pleamar/tidal).
#
#   tidal run [--safe] [pleamar options]   run in the foreground (Ctrl+C or `tidal stop` ends it)
#   tidal stop                             ask the running shell to quit
#   tidal open                             toggle the window island (bind this to a key)
#   tidal say CMD…                         pass a command to the running scene (pleamar --say)
#   tidal check                            compile the scene and run the unit tests
#
# --safe ignores settings.json and starts from built-in defaults.
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
scene="$root/shell/tidal.plm"
name=tidal
settings="${XDG_DATA_HOME:-$HOME/.local/share}/pleamar/$name/settings.json"

reduced_flag() {
    [ "${TIDAL_SAFE:-0}" = 1 ] && return 0
    [ -r "$settings" ] && command -v jq >/dev/null 2>&1 || return 0
    [ "$(jq -r '.motion.reduced // false' "$settings" 2>/dev/null)" = true ] && echo --reduced-motion
    return 0
}

cmd=${1:-run}; [ $# -gt 0 ] && shift
case "$cmd" in
    run)
        if [ "${1:-}" = --safe ]; then shift; export TIDAL_SAFE=1; fi
        # shellcheck disable=SC2046
        exec pleamar --scene "$scene" --no-hud --stall 0 $(reduced_flag) "$@" ;;
    stop) exec pleamar --say "$name" quit ;;
    open) exec pleamar --say "$name" "emit open_window" ;;
    say)  exec pleamar --say "$name" "$@" ;;
    check)
        pleamar --check "$scene"
        cd "$root" && lua5.4 tests/unit/run.lua ;;
    *) sed -n '2,11p' "$0" >&2; exit 2 ;;
esac
