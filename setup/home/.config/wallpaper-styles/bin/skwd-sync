#!/usr/bin/env bash
# Called by Skwd-wall's `postProcessing` hook with the wallpaper it just applied.
# Keeps the rest of the desktop on the one writer: qs-wallpaperpicker when it is
# running (it draws the same file and runs wallpaper-apply), otherwise
# wallpaper-apply alone (links + still + matugen). No second palette pipeline.
set -u
p=${1:-}
[ -n "$p" ] && [ -e "$p" ] || exit 0

qsbin=$(command -v qs 2>/dev/null || true)
if [ -n "$qsbin" ] && "$qsbin" -p "$HOME/.config/qs-wallpaperpicker" ipc call wallpaper set "$p" >/dev/null 2>&1; then
    exit 0
fi
exec "$HOME/.config/qs-wallpaperpicker/scripts/wallpaper-apply" "$p"
