#!/usr/bin/env bash
# wallpaper-picker: opens the wallpaper picker style chosen in ArchEclipse
# (left sidebar -> Settings -> Wallpaper Picker). SUPER+W runs `toggle`.
#
#   wallpaper-picker toggle          open/close the chosen picker
#   wallpaper-picker get             print the chosen style
#   wallpaper-picker set STYLE       choose: deck | slices | wall | hex | mosaic | hand | sandy | grid | skwd
#
# "deck" is qs-wallpaperpicker's swatch-card deck; the others are the
# wallpaper-styles layouts. Every style applies wallpapers through
# qs-wallpaperpicker, so drawing, transitions and matugen stay the same.
# "skwd" opens liixini/skwd-wall (installed in ~/.local): its postProcessing hook
# hands each choice back to qs-wallpaperpicker, and its engine is stopped when
# the picker closes, so it never becomes a second wallpaper writer.
set -euo pipefail
cfg="${XDG_CONFIG_HOME:-$HOME/.config}"
dir="$cfg/wallpaper-styles"
choice="$dir/picker-style"
deck="$cfg/qs-wallpaperpicker/bin/qs-wallpaperpicker"
styles="$dir/bin/wallpaper-styles"
valid="deck slices wall hex mosaic hand sandy grid skwd"

get() { local s; s=$(cat "$choice" 2>/dev/null || true); [[ " $valid " == *" $s "* ]] && echo "$s" || echo deck; }

case ${1-toggle} in
    get) get ;;
    set)
        s=${2-}
        [[ " $valid " == *" $s "* ]] || { echo "wallpaper-picker: unknown style '$s' ($valid)" >&2; exit 1; }
        printf '%s\n' "$s" > "$choice"
        # deck and skwd are whole pickers of their own; only the layouts live in config.json
        if [[ $s != deck && $s != skwd ]]; then
            # The picker watches config.json, so an open one switches live.
            python3 -I - "$dir/config.json" "$s" <<'PY'
import json, sys
p, s = sys.argv[1], sys.argv[2]
try: d = json.load(open(p))
except (OSError, ValueError): d = {}
ws = d.setdefault("components", {}).setdefault("wallpaperSelector", {})
ws["enabled"] = True
ws["displayMode"] = s
json.dump(d, open(p, "w"), indent=2); open(p, "a").write("\n")
PY
        fi ;;
    toggle)
        case $(get) in
            deck) exec "$deck" toggle ;;
            skwd) exec "$dir/bin/skwd-picker" ;;
            *)    exec "$styles" toggle ;;
        esac ;;
    *) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 1 ;;
esac
